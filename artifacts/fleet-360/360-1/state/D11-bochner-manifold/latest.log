```lean
theorem model_ricci_pairing_eq_ricciTerm (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) (r : ℝ) :
    Poincare.D7.Bochner.ricciPairing (modelRicMat n κ) (modelGradVec u r n) = modelRicciTerm n κ u r := by
  unfold Poincare.D7.Bochner.ricciPairing modelRicMat modelGradVec modelRicciTerm
  rw [sum_ricci_frame n (deriv u r) ((n : ℝ) * κ)]
  ring

theorem model_hessNormSq_eq_hessSq (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) (r : ℝ) :
    Poincare.D7.Bochner.hessNormSq (modelHessMat n κ u r) = modelHessSq n κ u r := by
  unfold Poincare.D7.Bochner.hessNormSq modelHessMat modelHessSq hessSq
  rw [sum_hess_frame n (deriv (deriv u) r) (jacobiMeanCurvature κ r * deriv u r)]
  ring

theorem model_gradLapDot_eq_gradDot (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) (r : ℝ) :
    Poincare.D7.Bochner.gradLaplacianDot (modelGradVec u r n) (modelGradLapVec n κ u r)
      = modelGradDot u (modelLap n κ u) r := by
  unfold Poincare.D7.Bochner.gradLaplacianDot modelGradVec modelGradLapVec modelGradDot gradDot
  rw [sum_gradlap_frame n (deriv u r) (deriv (modelLap n κ u) r)]
