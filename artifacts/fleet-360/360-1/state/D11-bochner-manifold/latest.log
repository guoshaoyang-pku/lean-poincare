noncomputable def modelBochnerCertificate (n : ℕ) (hκ : 0 ≤ κ) (hu2 : Differentiable ℝ (deriv u))
    (hu3 : DifferentiableAt ℝ (deriv (deriv u)) r) (hne : Poincare.D10.jacobiSol κ r ≠ 0) :
