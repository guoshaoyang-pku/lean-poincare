Definitions (namespace Poincare.D11.BochnerManifold):

```lean
def gradSq (u : ℝ → ℝ) : ℝ → ℝ := fun r => (deriv u r) ^ 2
def lapG (n : ℕ) (m : ℝ → ℝ) (u : ℝ → ℝ) : ℝ → ℝ :=
  fun r => deriv (deriv u) r + (n : ℝ) * m r * deriv u r
def hessSq (n : ℕ) (m : ℝ → ℝ) (u : ℝ → ℝ) : ℝ → ℝ :=
  fun r => (deriv (deriv u) r) ^ 2 + (n : ℝ) * (m r) ^ 2 * (deriv u r) ^ 2
def gradDot (u f : ℝ → ℝ) : ℝ → ℝ := fun r => deriv u r * deriv f r
def ricTerm (n : ℕ) (m : ℝ → ℝ) (u : ℝ → ℝ) : ℝ → ℝ :=
  fun r => -((n : ℝ) * (deriv m r + m r ^ 2) * (deriv u r) ^ 2)
```

Model (constant curvature):
```lean
def jacobiMeanCurvature (κ : ℝ) : ℝ → ℝ := fun r => jacobiDeriv κ r / jacobiSol κ r
def modelLap (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) : ℝ → ℝ := lapG n (jacobiMeanCurvature κ) u
def modelHessSq (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) : ℝ → ℝ := hessSq n (jacobiMeanCurvature κ) u
def modelGradSq (u : ℝ → ℝ) : ℝ → ℝ := gradSq u
def modelGradDot (u f : ℝ → ℝ) : ℝ → ℝ := gradDot u f
def modelRicciTerm (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) : ℝ → ℝ := fun r => (n : ℝ) * κ * (deriv u r) ^ 2
```

