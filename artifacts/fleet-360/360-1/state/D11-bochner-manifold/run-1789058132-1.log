    change D7.hessNormSq (modelBochnerCertificate n κ u r hκ).hess = modelHessSq n κ u r
    exact modelBochnerCertificate_hessNormSq n κ u r hκ
  have h2 : C.laplacianGradNormSq = modelLap n κ (modelGradSq u) r := rfl
  simpa [h1, h2] using h
