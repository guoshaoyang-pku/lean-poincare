lemma deriv_gradSq (hu2 : DifferentiableAt ℝ (deriv u) r) :
    deriv (gradSq u) r = 2 * deriv (deriv u) r * deriv u r := by
  unfold gradSq
  rw [deriv_pow hu2 2]  -- hmm deriv_pow: deriv (f ^ n) x = ↑n * f x ^ (n-1) * deriv f x — but f here is deriv u, and fun s => (deriv u s)^2 = (deriv u)^2 — good.
