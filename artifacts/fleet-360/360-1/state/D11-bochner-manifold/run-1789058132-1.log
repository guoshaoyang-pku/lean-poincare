```lean
theorem model_bochner_weitzenbock_harmonic (n : ℕ) {κ : ℝ} (hu2 : Differentiable ℝ (deriv u))
    (hu3 : DifferentiableAt ℝ (deriv (deriv u)) r) (hne : jacobiSol κ r ≠ 0)
    (hlap : deriv (modelLap n κ u) r = 0) :
    modelLap n κ (modelGradSq u) r = 2 * modelHessSq n κ u r + 2 * modelRicciTerm n κ u r := by
  have hmain := model_bochner_weitzenbock n hu2 hu3 hne
  rw [hmain]
  change 2 * modelHessSq n κ u r + 2 * (deriv u r * deriv (modelLap n κ u) r) + 2 * modelRicciTerm n κ u r
    = 2 * modelHessSq n κ u r + 2 * modelRicciTerm n κ u r
  rw [hlap]
  ring
```
(modelGradDot u (modelLap n κ u) r = deriv u r * deriv (modelLap n κ u) r ✓.)

```lean
theorem subharmonic_energy_density_of_nonneg_ricci (n : ℕ) {κ : ℝ}
    (hκ : 0 ≤ κ) (hu2 : Differentiable ℝ (deriv u))
    (hu3 : DifferentiableAt ℝ (deriv (deriv u)) r) (hne : jacobiSol κ r ≠ 0)
    (hlap : deriv (modelLap n κ u) r = 0) :
    0 ≤ modelLap n κ (modelGradSq u) r := by
  rw [model_bochner_weitzenbock_harmonic n hu2 hu3 hne hlap]
  have hh : 0 ≤ modelHessSq n κ u r := by
    unfold modelHessSq hessSq
    have h1 : 0 ≤ (deriv (deriv u) r) ^ 2 := sq_nonneg _
    have h2 : 0 ≤ (n : ℝ) * ((jacobiMeanCurvature κ r) ^ 2 * (deriv u r) ^ 2) := by
      positivity  -- n ≥ 0 via Nat.cast_nonneg, squares nonneg
    exact add_nonneg h1 h2
  have hr : 0 ≤ modelRicciTerm n κ u r := by
    unfold modelRicciTerm
    exact mul_nonneg (mul_nonneg (Nat.cast_nonneg n) hκ) (sq_nonneg _)
  nlinarith
```
Wait "0 ≤ κ" — need (n:ℝ)*κ ≥ 0: mul_nonneg (Nat.cast_nonneg n) hκ ✓.

