```lean
theorem modelBochnerCertificate_hessNormSq (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) (r : ℝ) (hκ) :
    D7.hessNormSq (modelBochnerCertificate n κ u r hκ).hess = modelHessSq n κ u r := by
  unfold modelBochnerCertificate
  change D7.hessNormSq (fun i j => if i = 0 then (if j = 0 then deriv (deriv u) r else 0)
      else if i = j then jacobiMeanCurvature κ r * deriv u r else 0) = modelHessSq n κ u r
  rw [D7.hessNormSq]
  rw [Fin.sum_univ_succ]
  -- Σ_i Σ_j (hess i j)² = Σ_j (hess 0 j)² + Σ_i Σ_j (hess i.succ j)²
  have h0 : (∑ j : Fin (n + 1), (if (0 : Fin (n+1)) = 0 then (if j = 0 then deriv (deriv u) r else 0)
      else if (0 : Fin (n+1)) = j then jacobiMeanCurvature κ r * deriv u r else 0) ^ 2)
    = (deriv (deriv u) r) ^ 2 := by
    rw [Fin.sum_univ_succ]
    simp only [↓reduceIte]
