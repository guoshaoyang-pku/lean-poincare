```lean
def gradSq (u : ℝ → ℝ) : ℝ → ℝ := fun r => (deriv u r) ^ 2
def lapG (n : ℕ) (m : ℝ → ℝ) (u : ℝ → ℝ) : ℝ → ℝ := fun r => deriv (deriv u) r + (n : ℝ) * m r * deriv u r
def hessSq (n : ℕ) (m : ℝ → ℝ) (u : ℝ → ℝ) : ℝ → ℝ := fun r => (deriv (deriv u) r) ^ 2 + (n : ℝ) * (m r) ^ 2 * (deriv u r) ^ 2
def gradDot (u f : ℝ → ℝ) : ℝ → ℝ := fun r => deriv u r * deriv f r
def ricTerm (n : ℕ) (m : ℝ → ℝ) (u : ℝ → ℝ) : ℝ → ℝ := fun r => -((n : ℝ) * (deriv m r + m r ^ 2) * (deriv u r) ^ 2)
def modelLap (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) : ℝ → ℝ := lapG n (jacobiMeanCurvature κ) u -- wait, jacobiMeanCurvature needs D10 Jacobi import; put in Basic or ModelSpace. Put model stuff in ModelSpace; Basic has generic profile m.
```
