```lean
noncomputable def modelGradientCertificate (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) (r : ℝ)
    (hκ : 0 ≤ (n : ℝ) * κ) (hu2 : Differentiable ℝ (deriv u))
    (hu3 : DifferentiableAt ℝ (deriv (deriv u)) r) (hne : jacobiSol κ r ≠ 0)
    (hlap : deriv (modelLap n κ u) r = 0) : D7.GradientCertificate where
  B := modelBochnerCertificate n κ u r hκ
  gradLap := fun i => if i = 0 then deriv (modelLap n κ u) r else 0
  laplacianGradNormSq := modelLap n κ (modelGradSq u) r
  rough_decomposition := by
    change (modelBochnerCertificate n κ u r hκ).roughLaplacian
      = D7.hessNormSq (modelBochnerCertificate n κ u r hκ).hess
        + D7.gradLaplacianDot (modelBochnerCertificate n κ u r hκ).grad
          (fun i => if i = 0 then deriv (modelLap n κ u) r else 0)
    rw [modelBochnerCertificate_hessNormSq n κ u r hκ]
    rw [modelBochnerCertificate_gradLaplacianDot n κ u r hκ (fun i => if i = 0 then deriv (modelLap n κ u) r else 0) rfl]
    change modelHessSq n κ u r + modelGradDot u (modelLap n κ u) r
      = modelHessSq n κ u r + modelGradDot u (modelLap n κ u) r
    rfl  -- roughLaplacian unfolds to modelHessSq + modelGradDot ✓
  product_rule := by
    change modelLap n κ (modelGradSq u) r = 2 * (modelBochnerCertificate n κ u r hκ).oneFormLaplacian
    exact modelBochnerCertificate_product_rule n κ u r hκ hu2 hu3 hne
  harmonic := by
    change D7.gradLaplacianDot (modelBochnerCertificate n κ u r hκ).grad
      (fun i => if i = 0 then deriv (modelLap n κ u) r else 0) = 0
    rw [modelBochnerCertificate_gradLaplacianDot n κ u r hκ _ rfl, hlap, mul_zero]
```
