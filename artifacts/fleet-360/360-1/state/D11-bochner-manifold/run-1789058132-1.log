lemma deriv_deriv_gradSq_eq (hu2 : Differentiable ℝ (deriv u))
    (hu3 : Differentiable ℝ (deriv (deriv u))) :
    deriv (deriv (gradSq u)) = fun r =>
      2 * (deriv (deriv u) r) ^ 2 + 2 * deriv u r * deriv (deriv (deriv u)) r := by
  funext r
  rw [deriv_gradSq_eq hu2]
  -- deriv (fun r => 2 * deriv (deriv u) r * deriv u r) r = ...
  change deriv (fun s => 2 * deriv (deriv u) s * deriv u s) r = _
  have h2 : DifferentiableAt ℝ (fun s => 2 * deriv (deriv u) s) r :=
    (hu3.differentiableAt r).const_mul 2
  rw [deriv_mul h2 (hu2.differentiableAt r)]
  rw [deriv_const_mul 2 (hu3.differentiableAt r)]
  ring
```

