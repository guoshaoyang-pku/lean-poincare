/-- The squared Euclidean norm `|k|²` of a lattice point `k : ℤⁿ`. -/
def normSq (k : Fin n → ℤ) : ℝ := ∑ i, ((k i : ℝ) ^ 2)

lemma normSq_nonneg (k) : 0 ≤ normSq k := Finset.sum_nonneg (fun i _ => sq_nonneg _)

/-- The Fourier mode `e_k`, as a function on ℝⁿ:
