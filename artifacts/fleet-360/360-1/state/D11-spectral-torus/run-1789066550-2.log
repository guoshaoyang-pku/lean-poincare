namespace Poincare.D11.SpectralTorus

/-- The integer lattice ℤⁿ embedded in ℝⁿ. -/
def intVec (n : ℕ) : (Fin n → ℤ) →+ (Fin n → ℝ) where
  toFun k := fun i => (k i : ℝ)
  map_zero' := by ext i; simp
  map_add' := by intro a b; ext i; simp

/-- The standard lattice ℤⁿ ≤ ℝⁿ. -/
def lattice (n : ℕ) : AddSubgroup (Fin n → ℝ) := (intVec n).range

/-- The flat n-torus ℝⁿ/ℤⁿ. -/
def Torus (n : ℕ) := (Fin n → ℝ) ⧸ lattice n
```

