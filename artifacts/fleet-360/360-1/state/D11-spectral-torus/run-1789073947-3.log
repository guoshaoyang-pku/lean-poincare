lemma summable_weight_int_ennreal {τ : ℝ} (hτ : 1 / 2 < τ) :
    (∑' m : ℤ, ((1 + (m : ℝ) ^ 2) ^ (-τ) : ℝ≥0∞)) ≠ ∞ := by
  let g : ℤ → ℝ := fun m => (1 + (m : ℝ) ^ 2) ^ (-τ)
  have hN : Summable (fun m : ℕ => g m) := summable_weight_nat hτ
  have hnonneg : ∀ m, 0 ≤ g m := fun m => Real.rpow_nonneg (by positivity) _
  let gN : ℕ → NNReal := fun m => ⟨g m, hnonneg m⟩
  have hNN : Summable gN := NNReal.summable_coe.mpr (by simpa [gN] using hN)
  have hEfin : (∑' m : ℕ, (gN m : ℝ≥0∞)) ≠ ∞ := ENNReal.tsum_coe_ne_top_iff_summable.mpr hNN
  have heven : ∀ m, g (-m) = g m := by intro m; dsimp [g]; congr 1; rw [neg_sq]
  have hZle : (∑' m : ℤ, (g m : ℝ≥0∞)) ≤ 2 * (∑' m : ℕ, (gN m : ℝ≥0∞)) := by
    calc
      (∑' m : ℤ, (g m : ℝ≥0∞))
          = ∑' n : ℕ, ((g n : ℝ≥0∞) + (g (-(n + 1)) : ℝ≥0∞)) := by
            rw [← tsum_nat_add_neg_add_one ENNReal.summable]
      _ = ∑' n : ℕ, ((g n : ℝ≥0∞) + (g (n + 1) : ℝ≥0∞)) := by
            refine tsum_congr (fun n => ?_)
            congr 1
            exact_mod_cast (heven (n + 1))
      _ = (∑' n : ℕ, (g n : ℝ≥0∞)) + ∑' n : ℕ, (g (n + 1) : ℝ≥0∞) := by
            rw [ENNReal.tsum_add]
      _ ≤ (∑' n : ℕ, (g n : ℝ≥0∞)) + ∑' n : ℕ, (g n : ℝ≥0∞) := by
            refine add_le_add_left ?_ _
            refine ENNReal.tsum_le_tsum (fun n => ?_)
            have hg : g (n + 1) ≤ g n := by
              dsimp [g]
              refine Real.rpow_le_rpow_of_nonpos (by positivity) ?_ ?_
              · nlinarith [sq_nonneg (n : ℝ)]
              · linarith
            exact_mod_cast hg
      _ = 2 * (∑' n : ℕ, (g n : ℝ≥0∞)) := by rw [two_mul]
  have hZle2 : (∑' m : ℤ, (g m : ℝ≥0∞)) ≤ 2 * (∑' m : ℕ, (gN m : ℝ≥0∞)) := by
    -- hZle's RHS: ∑' (g n : ℝ≥0∞) = ∑' (gN n : ℝ≥0∞)
    simpa [gN] using hZle
  have hZfin : (∑' m : ℤ, (g m : ℝ≥0∞)) ≠ ∞ :=
    (lt_of_le_of_lt hZle2 (ENNReal.mul_lt_top (by norm_num) (lt_top_iff_ne_top.mpr hEfin))).ne
  simpa [g] using hZfin

lemma summable_weight_int {τ : ℝ} (hτ : 1 / 2 < τ) :
    Summable (fun m : ℤ => (1 + (m : ℝ) ^ 2) ^ (-τ)) := by
  let g : ℤ → ℝ := fun m => (1 + (m : ℝ) ^ 2) ^ (-τ)
  have hnonneg : ∀ m, 0 ≤ g m := fun m => Real.rpow_nonneg (by positivity) _
  let gNN : ℤ → NNReal := fun m => ⟨g m, hnonneg m⟩
  have hZfin : (∑' m : ℤ, (gNN m : ℝ≥0∞)) ≠ ∞ := by
    simpa [gNN, g] using (summable_weight_int_ennreal hτ)
  have hZNN : Summable gNN := ENNReal.tsum_coe_ne_top_iff_summable.mpr hZfin
  simpa [gNN, g] using NNReal.summable_coe.mp hZNN
```

