def finConsEquiv (m : ℕ) : (Fin m → ℤ) × ℤ ≃ (Fin (m+1) → ℤ) where
  toFun p := Fin.cons p.2 p.1
  invFun k := (fun i => k (Fin.succ i), k 0)
  left_inv := by
    intro p
    ext i <;> simp [Fin.cons_zero, Fin.cons_succ]
  right_inv := by
    intro k
    ext i
    cases i using Fin.cases
    · simp [Fin.cons_zero]
    · simp [Fin.cons_succ]
