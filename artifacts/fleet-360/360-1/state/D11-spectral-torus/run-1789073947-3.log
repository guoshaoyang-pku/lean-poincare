lemma one_add_normSq_ge_geomMean (k : Fin (n+1) → ℤ) :
    (∏ i : Fin (n+1), (1 + (k i : ℝ) ^ 2) ^ ((n + 1 : ℝ)⁻¹)) ≤ 1 + normSq k := by
  have hgm := Real.geom_mean_le_arith_mean_weighted (s := Finset.univ) (w := fun _ => (n+1:ℝ)⁻¹)
    (z := fun i => 1 + (k i : ℝ) ^ 2) (by intro i hi; exact inv_nonneg.mpr (by positivity))
    (by simp) (by intro i hi; nlinarith [sq_nonneg (k i : ℝ)])
  -- hgm : ∏ i ∈ univ, z i ^ w i ≤ ∑ i ∈ univ, w i * z i
  calc
    (∏ i : Fin (n+1), z i ^ w) ≤ ∑ i : Fin (n+1), w * z i := by simpa using hgm
    _ = 1 + (n+1:ℝ)⁻¹ * normSq k := by
      simp only [Finset.mul_sum? ...]
      -- ∑ i, (n+1)⁻¹ * (1 + (k i)²) = (n+1)⁻¹ * ∑ (1 + k_i²) = (n+1)⁻¹ * ((n+1) + normSq k) = 1 + (n+1)⁻¹·normSq
      ring_nf? [Finset.sum_add_distrib, Finset.sum_const...]
    _ ≤ 1 + normSq k := by
      -- (n+1)⁻¹·normSq ≤ normSq (since (n+1)⁻¹ ≤ 1 and normSq ≥ 0)
      nlinarith [inv_le_one_of_one_le₀ (by norm_num : (1 : ℝ) ≤ n + 1), normSq_nonneg k]
