lemma one_add_normSq_inv_le_prod {σ : ℝ} (hσ : 0 ≤ σ) (k : Fin (n+1) → ℤ) :
    (1 + normSq k) ^ (-σ) ≤ ∏ i : Fin (n+1), (1 + (k i : ℝ) ^ 2) ^ (-σ / (n + 1)) := by
  have hpos₁ : 0 < 1 + normSq k := by positivity
  have hge := one_add_normSq_ge_geomMean k
  have hprod_pos : 0 < ∏ i : Fin (n+1), (1 + (k i : ℝ) ^ 2) ^ ((n + 1 : ℝ)⁻¹) := by
    exact Finset.prod_pos (fun i hi => Real.rpow_pos_of_pos (by positivity) _)
  calc
    (1 + normSq k) ^ (-σ) ≤ (∏ i : Fin (n+1), (1 + (k i : ℝ) ^ 2) ^ ((n + 1 : ℝ)⁻¹)) ^ (-σ) :=
      Real.rpow_le_rpow_of_nonpos hpos₁ hge (by linarith)
    _ = ∏ i : Fin (n+1), (1 + (k i : ℝ) ^ 2) ^ (-σ / (n + 1)) := by
      -- rpow of product = product of rpow [rpow_prod_univ], and (x^w)^(-σ) = x^(w·(-σ)) [rpow_mul], w·(-σ) = -σ/(n+1) [ring]
      rw [rpow_prod_univ ...]
