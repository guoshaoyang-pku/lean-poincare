```
theorem ricci_symm (d : LeviCivitaData m b) (X Y : V) :
    ricci d.toCurvatureOperator X Y = ricci d.toCurvatureOperator Y X := by
  let K := d.toCurvatureOperator
  have hskew : ∀ X Y Z W, m.form (K X Y Z) W = - m.form Z (K X Y W) := curvature_skew_adjoint ...
  have htr : ∀ X Y, LinearMap.trace ℝ V (curvEndo K X Y) = 0 := ... (from hskew + trace_skew_adjoint_eq_zero)
  have hb : ∀ X Y Z, K Z X Y = -K X Y Z + K Z Y X := ... 
  have hendo : ∀ X Y, endoRicci K X Y = -curvEndo K X Y + endoRicci K Y X := by ext Z; simpa [hb]
  calc ricci K X Y = trace(endoRicci K X Y) := rfl
    _ = trace(-curvEndo K X Y + endoRicci K Y X) := by rw [hendo X Y]
    _ = -trace(curvEndo K X Y) + trace(endoRicci K Y X) := by simp [map_add, map_neg]  -- trace linear
    _ = 0 + ricci K Y X := by rw [htr X Y]
    _ = ricci K Y X := by simp
