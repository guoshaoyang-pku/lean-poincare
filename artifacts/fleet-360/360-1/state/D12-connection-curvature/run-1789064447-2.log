      ∑ i : ι, ∑ j : ι, christoffel c k i j * X i * Y j := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j hj
    apply Finset.sum_congr rfl
    intro i hi
    rw [c.christoffel_symm k i j]
    ring
