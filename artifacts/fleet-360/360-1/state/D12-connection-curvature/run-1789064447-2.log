Better: just prove the reindexing lemma via the sum over the triple product with Equiv:
```
lemma sum_three_permute {α β γ : Type*} [Fintype α] [Fintype β] [Fintype γ]
    (f : α → β → γ → ℝ) :
    (∑ a : α, ∑ b : β, ∑ c : γ, f a b c) = ∑ c : γ, ∑ a : α, ∑ b : β, f c a b := by
  classical
  let e : (α × β × γ) ≃ (γ × α × β) :=
    { toFun := fun p => (p.2.2, p.1, p.2.1), invFun := fun p => (p.2.1, p.2.2, p.1),
      left_inv := by intro p; rfl, right_inv := by intro p; rfl }
  rw [Fintype.sum_prod_type, Fintype.sum_prod_type]
  rw [Equiv.sum_comp e]
```
