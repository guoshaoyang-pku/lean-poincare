noncomputable def curvatureEndo (K : CurvatureOperator ℝ V) (X Y : V) : V →ₗ[ℝ] V where
  toFun Z := K X Y Z
  map_add' Z₁ Z₂ := by
    change K.toTrilinear X Y (Z₁ + Z₂) = K.toTrilinear X Y Z₁ + K.toTrilinear X Y Z₂
