theorem nabla_smooth {X Y : VectorField ι} (hX : ContDiff ℝ ∞ X) (hY : ContDiff ℝ ∞ Y) :
    ContDiff ℝ ∞ (c.nabla X Y) := by
  rw [contDiff_pi]
