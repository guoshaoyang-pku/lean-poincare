```
lemma sum_three_cycle (f : ι → ι → ι → ℝ) :
    (∑ i : ι, ∑ j : ι, ∑ k : ι, f i j k) = ∑ k : ι, ∑ i : ι, ∑ j : ι, f k i j := by
  classical
  calc
    (∑ i : ι, ∑ j : ι, ∑ k : ι, f i j k)
        = ∑ q : ι × ι × ι, f q.1 q.2.1 q.2.2 := by
          calc
            (∑ i : ι, ∑ j : ι, ∑ k : ι, f i j k)
                = ∑ i : ι, ∑ p : ι × ι, f i p.1 p.2 := by
                  apply Finset.sum_congr rfl
                  intro i hi
                  simpa using (Finset.sum_product (s := (Finset.univ : Finset ι)) (t := (Finset.univ : Finset ι)) (f := fun j k => f i j k))
            _ = ∑ q : ι × ι × ι, f q.1 q.2.1 q.2.2 := by
                  simpa using (Finset.sum_product (s := (Finset.univ : Finset ι)) (t := (Finset.univ : Finset ι)) (f := fun i p => f i p.1 p.2))
    _ = ∑ k : ι, ∑ i : ι, ∑ j : ι, f k i j := by
          calc
            (∑ q : ι × ι × ι, f q.1 q.2.1 q.2.2)
                = ∑ k : ι, ∑ p : ι × ι, f k p.1 p.2 := by
                  simpa using (Finset.sum_product (s := (Finset.univ : Finset ι)) (t := (Finset.univ : Finset ι)) (f := fun k p => f k p.1 p.2)).symm
            _ = ∑ k : ι, ∑ i : ι, ∑ j : ι, f k i j := by
                  apply Finset.sum_congr rfl
                  intro k hk
                  simpa using (Finset.sum_product (s := (Finset.univ : Finset ι)) (t := (Finset.univ : Finset ι)) (f := fun i j => f k i j)).symm
```
