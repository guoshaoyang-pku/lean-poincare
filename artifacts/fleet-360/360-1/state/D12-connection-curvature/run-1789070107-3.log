/-- The directional derivative datum of the metric coefficients:
`dFamily x i j k = ∂_{eᵢ} G_{jk}(x) = fderiv G_{jk} x (eᵢ)`. -/
def dFamily (x : ChartPoint ι) (i j k : ι) : ℝ :=
  fderiv ℝ (fun y : ChartPoint ι => c.g y j k) x (Pi.single i 1)

/-- Smoothness of each component of the derivative datum. -/
theorem dFamily_smooth (i j k : ι) :
    ContDiff ℝ ⊤ (fun x : ChartPoint ι => c.dFamily x i j k) := by
  rw [contDiff_infty]
  intro n
  have hgn : ContDiff ℝ (n + 1) (fun y : ChartPoint ι => c.g y j k) := by
    exact ContDiff.of_le ((contDiff_pi.mp (contDiff_pi.mp c.g_smooth) j) k) le_top
```

