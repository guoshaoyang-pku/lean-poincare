```lean
import Mathlib.Tactic
import Mathlib.Analysis.Calculus.ContDiff.Basic
import Mathlib.Analysis.Calculus.FDeriv.Mul
import Mathlib.Analysis.Calculus.FDeriv.Add
import Poincare.D12.ConnectionCurvature.ChartLeviCivitaForm

/-! docstring -/

open scoped BigOperators
noncomputable section

namespace Poincare
namespace D12
namespace ConnectionCurvature

open Poincare.Longrun.Geometry
open Poincare.CurvatureAlgebra

universe w
variable {ι : Type w} [Fintype ι] [DecidableEq ι]

/-- The chart model space: `ι → ℝ`, coordinates of a real chart. -/
abbrev ChartPoint (ι : Type w) := ι → ℝ

/-- Smooth vector fields on the chart: smooth maps from the chart to the coordinate
vectors. -/
abbrev VectorField (ι : Type w) := ChartPoint ι → ι → ℝ

/-- **Smooth chart metric datum.** Smooth coefficient families `g`, `gInv` on the real
chart `ι → ℝ` satisfying the dual-metric identities pointwise. The derivative data is
*derived* (the Frechet derivative of the coefficients), not assumed. -/
structure SmoothChartData (ι : Type w) [Fintype ι] [DecidableEq ι] where
  g : ChartPoint ι → ι → ι → ℝ
  gInv : ChartPoint ι → ι → ι → ℝ
  g_smooth : ContDiff ℝ ⊤ g
  gInv_smooth : ContDiff ℝ ⊤ gInv
  g_symm : ∀ x i j, g x i j = g x j i
  gInv_symm : ∀ x i j, gInv x i j = gInv x j i
  inv_mul : ∀ x k j, (∑ l : ι, gInv x k l * g x l j) = if k = j then 1 else 0
```

Note: `ContDiff ℝ ⊤ g` for `g : ChartPoint ι → ι → ι → ℝ` — codomain is a Pi normed space. Fine.

