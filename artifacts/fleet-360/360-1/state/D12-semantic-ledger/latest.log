/-! documentation block: the observed D7 field, source hash etc. -/

/-- The standard 1D Euclidean heat kernel (centered): K(t, y) = (4πt)^(-1/2) exp(-y²/(4t)) -/
noncomputable def gaussianKernel1 (t : ℝ) (x y : ℝ) : ℝ :=
  (4 * Real.pi * t) ^ (-(1 : ℝ) / 2) * Real.exp (-(x - y) ^ 2 / (4 * t))

