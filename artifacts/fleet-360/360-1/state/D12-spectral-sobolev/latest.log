```lean
import Mathlib.Analysis.Fourier.AddCircle
import Mathlib.Analysis.Normed.Group.Tannery

/-!
# Spectral heat evolution on the circle

For T > 0 the additive circle AddCircle T = ℝ / ℤ•T carries the probability Haar measure
`haarAddCircle`. The characters `fourier n`, n : ℤ, form an orthonormal Hilbert basis
(`fourierBasis`) of `Lp ℂ 2 haarAddCircle`, with eigenvalues λₙ = (2πn/T)² of the Laplacian
(see `hasDerivAt_fourier`). We define the spectral heat operator

  H_t f = ∑' n, exp(-λₙ t) cₙ(f) eₙ

as an infinite series in L², prove that it converges for every f ∈ L² and every t ≥ 0,
and record the coefficient identity that makes it the Fourier representation of the heat flow.
-/

open scoped ENNReal ComplexConjugate Real lp
open MeasureTheory MeasureTheory.Measure TopologicalSpace Filter Complex

namespace Poincare.D12.SpectralSobolev

noncomputable section

variable {T : ℝ} [hT : Fact (0 < T)]

/-! ## The heat weights -/

/-- ... -/
def heatWeight (T t : ℝ) (n : ℤ) : ℝ := Real.exp (-(2 * π * (n : ℝ) / T) ^ 2 * t)

lemma heatWeight_nonneg (T t : ℝ) (n : ℤ) : 0 ≤ heatWeight T t n := (Real.exp_pos _).le

lemma heatWeight_le_one (T : ℝ) {t : ℝ} (ht : 0 ≤ t) (n : ℤ) : heatWeight T t n ≤ 1 := by
  unfold heatWeight
  rw [← Real.exp_zero]
  exact Real.exp_le_exp.mpr (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr (sq_nonneg _)) ht)

lemma heatWeight_abs_le_one (T : ℝ) {t : ℝ} (ht : 0 ≤ t) (n : ℤ) : |heatWeight T t n| ≤ 1 := by
  rw [abs_of_nonneg (heatWeight_nonneg T t n)]
  exact heatWeight_le_one T ht n

lemma heatWeight_tendsto_one (T : ℝ) (n : ℤ) :
    Tendsto (fun t : ℝ => heatWeight T t n) (𝓝[>] 0) (𝓝 1) := by
  have hlin : Tendsto (fun t : ℝ => -(2 * π * (n : ℝ) / T) ^ 2 * t) (𝓝[>] 0) (𝓝 0) := by
    simpa using (tendsto_const_nhds.mul tendsto_id :
      Tendsto (fun t : ℝ => -(2 * π * (n : ℝ) / T) ^ 2 * t) (𝓝[>] 0) (𝓝 (-(2 * π * (n : ℝ) / T) ^ 2 * 0)))
  unfold heatWeight
  rw [Real.exp_zero]
  exact Real.continuous_exp.continuousAt.tendsto.comp hlin
```

