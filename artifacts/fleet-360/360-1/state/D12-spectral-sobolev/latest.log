noncomputable section

variable {T : ℝ} [hT : Fact (0 < T)]

/-- The n-th heat eigenvalue weight on the circle of length T: exp(-(2πn/T)² t) -/
def heatWeight (T t : ℝ) (n : ℤ) : ℝ := Real.exp (-(2 * π * (n : ℝ) / T) ^ 2 * t)

-- maybe make heatWeight take T as explicit arg for readability; keep (T t n).

lemma heatWeight_nonneg (t : ℝ) (n : ℤ) : 0 ≤ heatWeight T t n := (Real.exp_pos _).le

lemma heatWeight_le_one (ht : 0 ≤ t) (n : ℤ) : heatWeight T t n ≤ 1 := by
  rw [heatWeight, ← Real.exp_zero]
  refine Real.exp_le_exp.mpr ?_
  -- show -(2πn/T)^2 * t ≤ 0
  exact mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr (sq_nonneg _)) ht

lemma heatWeight_abs_le_one (ht : 0 ≤ t) (n : ℤ) : |heatWeight T t n| ≤ 1 := by
  rw [abs_of_nonneg (heatWeight_nonneg T t n)]
  exact heatWeight_le_one T ht n

-- tendsto to 1 as t → 0+
lemma heatWeight_tendsto_one (n : ℤ) :
    Tendsto (fun t : ℝ => heatWeight T t n) (𝓝[>] 0) (𝓝 1) := by
  rw [heatWeight, ← Real.exp_zero]
  exact Real.continuous_exp.continuousAt.tendsto.comp ?_
  -- need Tendsto (fun t => -(2πn/T)^2 * t) (𝓝[>] 0) (𝓝 0)
```

