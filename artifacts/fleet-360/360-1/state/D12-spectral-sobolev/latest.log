/-! sharp Poincaré (Wirtinger) inequality on the circle -/

open scoped ENNReal ComplexConjugate Real NNReal lp Topology
open MeasureTheory MeasureTheory.Measure TopologicalSpace Filter Complex AddCircle
open scoped Interval

namespace Poincare.D12.SpectralSobolev

noncomputable section

variable {a b : ℝ}

/-- For a differentiable function with `f b = f a` (so that `f` descends to the circle
`ℝ / (b - a)ℤ`), the Fourier coefficient of the derivative is the eigenvalue multiple:
`cₙ(f') = (2π i n / (b - a)) · cₙ(f)`. This is the spectral form of integration by parts;
the boundary term vanishes by periodicity. -/
theorem fourierCoeffOn_deriv_periodic (hab : a < b) {f f' : ℝ → ℂ} {n : ℤ} (hn : n ≠ 0)
    (hf : ∀ x, x ∈ [[a, b]] → HasDerivAt f (f' x) x)
    (hper : f b = f a) (hf' : IntervalIntegrable f' volume a b) :
    fourierCoeffOn hab f' n = (2 * π * I * (n : ℂ) / (b - a)) * fourierCoeffOn hab f n := by
  have h := fourierCoeffOn_of_hasDerivAt hab hn hf hf'
  -- h : fourierCoeffOn hab f n = 1 / (-2 * π * I * n) * (fourier (-n) (a : AddCircle (b - a)) * (f b - f a) - (b - a) * fourierCoeffOn hab f' n)
  rw [hper, sub_self, mul_zero, sub_zero] at h
  -- h : fourierCoeffOn hab f n = 1 / (-2 * π * I * n) * (-(b - a) * fourierCoeffOn hab f' n)
  -- algebra: c_f = 1/(-2πin) · (-(b-a) · c_f') ⇒ c_f' = (2πin/(b-a)) · c_f
  -- let's do: c_f = (b-a)/(2πin) · c_f'
  field_simp [sub_ne_zero.mpr hab.ne', Complex.I_ne_zero, Real.pi_ne_zero, (by exact_mod_cast hn : (n : ℂ) ≠ 0)] at h ⊢
  ring at h ⊢  -- hmm
```

