theorem poincareAddCircle_sharp :
    ∃ f : Lp ℂ 2 (haarAddCircle (T := T)),
      (∫ t : AddCircle T, (f : AddCircle T → ℂ) t ∂haarAddCircle = 0) ∧
      (Summable (fun n : ℤ => (2 * π * (n : ℝ) / T) ^ 2 * ‖fourierCoeff (T := T) (f : AddCircle T → ℂ) n‖ ^ 2)) ∧
      ‖f‖ ^ 2 ≠ 0 ∧
      ‖f‖ ^ 2 = (T / (2 * π)) ^ 2 * ∑' n : ℤ, (2 * π * (n : ℝ) / T) ^ 2 * ‖fourierCoeff (T := T) (f : AddCircle T → ℂ) n‖ ^ 2 := by
  refine ⟨fourierLp (T := T) 2 1, ?_, ?_, ?_, ?_⟩
  · -- mean zero
    have := fourierCoeff_fourierLp_one 0
    ... hmean : ∫ t, f t ∂μ = 0 — need from fourierCoeff f 0 = 0 via fourierCoeff_zero_eq_integral:
    rw [← fourierCoeff_zero_eq_integral ((fourierLp (T := T) 2 1 : Lp ℂ 2 haarAddCircle) : AddCircle T → ℂ)]
    rw [fourierCoeff_fourierLp_one]; simp
  · -- summable
    exact (hasSum_energy_witness).summable
  · -- nonzero norm
    rw [(orthonormal_fourier (T := T)).1 1]; norm_num
  · -- equality
    rw [(orthonormal_fourier (T := T)).1 1, hasSum_energy_witness.tsum_eq]  -- ∑' = (2π/T)²
    have hfac : (T / (2 * π)) ^ 2 * (2 * π / T) ^ 2 = 1 := by
      field_simp [hT.out.ne', Real.pi_ne_zero]
      ring
    rw [hfac]
```
