      have h2 : Real.sqrt (t ^ 2 / 4) = t / 2 := by
        rw [Real.sqrt_div (sq_nonneg t)]  -- sqrt(t²/4) = sqrt(t²)/sqrt(4): Real.sqrt_div
        have : Real.sqrt (t ^ 2) = t := by
          rw [Real.sqrt_sq_eq_abs, abs_of_nonneg ht]
        rw [this]
        norm_num [Real.sqrt_eq_zero_of_nonneg?] -- sqrt 4 = 2: norm_num
      simpa [h1] using h2
    convert ((hasDerivAt_pow 2 t).const_mul (-1 : ℝ)).div_const 4 using 1
    · ring
    · rw [hs]
      ring
```

