```
theorem nonneg_of_nonneg_init_of_deriv_nonneg_on_nonpos {f : ℝ → ℝ}
    (hf₀ : 0 ≤ f 0)
    (hdiff : ∀ t, 0 ≤ t → DifferentiableAt ℝ f t)
    (hderiv : ∀ t, 0 ≤ t → f t ≤ 0 → 0 ≤ deriv f t) :
    ∀ t, 0 ≤ t → 0 ≤ f t := by
  intro t₀ ht₀
