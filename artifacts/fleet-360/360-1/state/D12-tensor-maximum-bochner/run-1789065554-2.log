/-- **Field form.** If `M` is a `C¹` path solving `deriv M t = P (M t)` where `P` satisfies
the strengthened tangent condition on all Hermitian matrices, and `M 0` is PSD, then `M t`
is PSD for all `t ≥ 0`. -/
theorem stays_posSemidef_of_field {n : Type u} [Fintype n] [DecidableEq n]
    {M : ℝ → Matrix n n ℝ} (P : Matrix n n ℝ → Matrix n n ℝ)
    (hdiff : ∀ t, 0 ≤ t → DifferentiableAt ℝ M t)
    (hHerm : ∀ t, (M t).IsHermitian)
    (hinit : (M 0).PosSemidef)
    (hode : ∀ t, 0 ≤ t → deriv M t = P (M t))
    (hC : ∀ A, A.IsHermitian → ∀ v : n → ℝ,
      star v ⬝ᵥ (A *ᵥ v) ≤ 0 → 0 ≤ star v ⬝ᵥ (P A *ᵥ v)) :
    ∀ t, 0 ≤ t → (M t).PosSemidef := by
  refine stays_nonneg hdiff hHerm hinit ?_
  intro t ht v hv
  rw [hode t ht]
  exact hC (M t) (hHerm t) v hv
```

