theorem quadSelfPath_solves (t : ℝ) :
    HasDerivAt (fun s => quadSelfPath s) (quadSelfPath t ^ 2 - quadSelfPath t) t := by
  have hd := diagonal_hasDerivAt (f := fun s i => lambdaInv (((i : ℕ) + 1 : ℝ)) s)
    (f' := fun i : Fin 2 => -((((i : ℕ) + 1 : ℝ) * Real.exp t) / (1 + ((i : ℕ) + 1 : ℝ) * Real.exp t) ^ 2))
    (t := t) (fun i => hasDerivAt_lambdaInv (((i : ℕ) + 1 : ℝ)) t)
  have hP : Matrix.diagonal (fun i : Fin 2 => -((((i : ℕ) + 1 : ℝ) * Real.exp t) / (1 + ((i : ℕ) + 1 : ℝ) * Real.exp t) ^ 2))
      = quadSelfPath t ^ 2 - quadSelfPath t := by
    rw [quadSelfPath]
    rw [Matrix.diagonal_pow, Matrix.diagonal_sub]
    congr 1
    funext i
    simpa using lambdaInv_sq_sub (((i : ℕ) + 1 : ℝ)) t
  simpa [quadSelfPath, hP] using hd
```
