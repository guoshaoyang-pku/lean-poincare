```
lemma nablaField_metric (X : V) (F G : VecField) :
    D X (fieldInner F G) = fieldInner (nablaField d X F) G + fieldInner F (nablaField d X G) := by
  unfold fieldInner nablaField
  rw [map_sum]
  simp only [LinearMap.sum_apply, LinearMap.smul_apply] — hmm D X of a sum: (D X) is linear ✓ map_sum
  -- D X (Σ_j F_j*G_j) = Σ_j ((D X F_j)*G_j + F_j*(D X G_j))
  have hleib' : ∀ j, D X (F j * G j) = D X (F j) * G j + F j * D X (G j) := by intro j; exact hleib X (F j) (G j)
  rw [map_sum]
  -- now: Σ_j [D X F_j * G_j + F_j * D X G_j] = Σ_j (D X F_j + Σ_k γX k j F_k)*G_j + Σ_j F_j*(D X G_j + Σ_k γX k j G_k)
  rw [← Finset.sum_add_distrib] — hmm — need to structure:
  calc
    D X (∑ j, F j * G j) = ∑ j, D X (F j) * G j + F j * D X (G j) := by rw [map_sum]; apply Finset.sum_congr rfl; intro j hj; exact hleib X (F j) (G j)
    _ = ∑ j, (D X (F j) + ∑ k, gammaX d X k j * F k) * G j + ∑ j, F j * (D X (G j) + ∑ k, gammaX d X k j * G k) := by
      rw [← Finset.sum_add_distrib]  -- combine into one sum: Σ_j [(DF_j)G_j + F_j(DG_j)]
      apply Finset.sum_congr rfl
      intro j hj
      -- need: DF_j*G_j + F_j*DG_j = (DF_j + Σ_k γXkj F_k)*G_j + F_j*(DG_j + Σ_k γXkj G_k)
      -- i.e. the cross terms vanish: Σ_k γXkj F_k*G_j + Σ_k F_j*γXkj*G_k = 0
      have hcross : (∑ k, gammaX d X k j * F k) * G j + F j * (∑ k, gammaX d X k j * G k) = 0 := by
