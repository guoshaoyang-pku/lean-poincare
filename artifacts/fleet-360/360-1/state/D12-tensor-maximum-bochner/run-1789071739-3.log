lemma cG_eq_torsion (i j l : ι) :
    cG d i j l = gA (m.form (b.bracket (e i) (e j)) (e l)) := by
  unfold cG gamma
  have h := d.torsion_free (e i) (e j)  -- ∇_ie_j - ∇_je_i = [e_i, e_j]
  -- apply m.form · (e l):
  have hf : m.form (d.nabla (e i) (e j)) (e l) - m.form (d.nabla (e j) (e i)) (e l)
      = m.form (b.bracket (e i) (e j)) (e l) := by
    have : m.form (d.nabla (e i) (e j) - d.nabla (e j) (e i)) (e l)
         = m.form (b.bracket (e i) (e j)) (e l) := by rw [h]
    rwa [map_sub, LinearMap.sub_apply] at this
  rw [← hf]  -- hmm — need the A-version: gA of LHS = gA of RHS...
  have hA : gA (m.form (d.nabla (e i) (e j)) (e l)) - gA (m.form (d.nabla (e j) (e i)) (e l))
      = gA (m.form (b.bracket (e i) (e j)) (e l)) := by
    rw [← RingHom.map_sub]
    exact congrArg gA hf
  simpa [gA] using hA
```
