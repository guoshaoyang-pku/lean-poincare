```
abbrev VecField : Type uA := ι → A
def fieldInner (F G : VecField) : A := ∑ j, F j * G j
def gammaX (X : V) (k j : ι) : A := gA (m.form (d.nabla X (e k)) (e j))
def nablaField (X : V) (F : VecField) : VecField := fun j => D X (F j) + ∑ k, gammaX d X k j * F k
def eField (j : ι) : VecField := fun k => if k = j then 1 else 0
def gradField (u : A) : VecField := fun j => D (e j) u
```

