  unfold gradSq fieldInner nablaField gradField
  calc
    D X (∑ j : ι, ui u j * ui u j)
        = ∑ j : ι, 2 * (ui u j * D X (ui u j)) := by
          rw [map_sum]
          apply Finset.sum_congr rfl
          intro j _
          have hleib' := hleib X (ui u j) (ui u j)
          rw [hleib']
          ring
    _ = 2 * (∑ j : ι, ui u j * D X (ui u j)) := by rw [Finset.mul_sum, two_mul]... 
          — 2*(Σ...) = Σ (2*...): Finset.mul_sum: (2 : A) * Σ = Σ 2*(·) ✓
    _ = 2 * (∑ j : ι, ui u j * (D X (ui u j) + ∑ k : ι, gammaX d X k j * ui u k)) := by
          congr 1 — need Σ uⱼD_Xuⱼ = Σ uⱼ(D_Xuⱼ + ΣₖγX(k,j)uₖ) — i.e. ΣⱼΣₖγX(k,j)uⱼuₖ = 0
          rw [Finset.sum_add_distrib]? — hmm: Σⱼ uⱼ·(D_Xuⱼ + Σₖ...) = Σⱼ uⱼD_Xuⱼ + Σⱼ uⱼ(ΣₖγX(k,j)uₖ) [mul_add + sum_add_distrib]
          rw [Finset.sum_add_distrib]  — no: Σⱼ uⱼ(D_Xuⱼ + Σₖ..) = Σⱼ(uⱼD_Xuⱼ + uⱼ(Σₖ..)) [mul_add per j] = ΣⱼuⱼD_Xuⱼ + Σⱼuⱼ(Σₖ..) [sum_add_distrib]
          — and Σⱼ uⱼ(ΣₖγX(k,j)uₖ) = ΣⱼΣₖγX(k,j)uⱼuₖ = 0 [mul_sum + sum_gammaX_quad]
          rw [← Finset.sum_add_distrib]
          apply Finset.sum_congr rfl; intro j _; rw [mul_add]
          rw [Finset.mul_sum, sum_gammaX_quad hleib d X u, add_zero]
```
