lemma fieldInner_fieldLaplacian_expand (dd) (d) (u) :
    fieldInner (gradField dd u) (fieldLaplacian dd d u)
      = ∑ j, ∑ i, ui dd u j * (dd.D (m.basis i) (H dd d u i j)
            + ∑ k, gamma d i k j * H dd d u i k - ∑ l, gamma d i i l * H dd d u l j) := by
  unfold fieldInner fieldLaplacian gradField
  rw [show (∑ j : ι, ui dd u j * (∑ i : ι, (nablaField dd d (m.basis i)
      (nablaField dd d (m.basis i) (gradField dd u)) j
    - nablaField dd d (d.nabla (m.basis i) (m.basis i)) (gradField dd u) j)))
    = ∑ j : ι, ∑ i : ι, ui dd u j * (nablaField dd d (m.basis i)
        (nablaField dd d (m.basis i) (gradField dd u)) j
      - nablaField dd d (d.nabla (m.basis i) (m.basis i)) (gradField dd u) j) by
    apply Finset.sum_congr rfl
    intro j _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [mul_sub]]
  rw [show (∑ j : ι, ∑ i : ι, ui dd u j * (nablaField dd d (m.basis i)
      (nablaField dd d (m.basis i) (gradField dd u)) j
    - nablaField dd d (d.nabla (m.basis i) (m.basis i)) (gradField dd u) j))
    = ∑ j : ι, ∑ i : ι, ui dd u j * (dd.D (m.basis i) (H dd d u i j)
        + ∑ k : ι, gamma d i k j * H dd d u i k - ∑ l : ι, gamma d i i l * H dd d u l j) by
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro i _
    congr 1
    rw [nablaField_nablaField_grad_H dd d i j u]
    rw [nablaField_nabla_grad_H dd d i j u]
    abel
```

