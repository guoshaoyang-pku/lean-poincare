Let me restructure the whole lemma more carefully with `calc`:

```
lemma nablaField_nabla_grad_H (dd) (d) (i j) (u) :
    nablaField dd d (d.nabla (m.basis i) (m.basis i)) (gradField dd u) j
      = ∑ l, gamma d i i l * H dd d u l j := by
  unfold nablaField
  calc
    dd.D (d.nabla (m.basis i) (m.basis i)) (ui dd u j)
        + ∑ l, gammaX d (d.nabla (m.basis i) (m.basis i)) l j * ui dd u l
        = (∑ l, gamma d i i l * dd.D (m.basis l) (ui dd u j))
            + ∑ l, gammaX d (d.nabla (m.basis i) (m.basis i)) l j * ui dd u l := by
            rw [D_expand dd (d.nabla (m.basis i) (m.basis i)) (ui dd u j)]
            apply Finset.sum_congr rfl
            intro l _
            rw [m.form_symm]
    _ = (∑ l, gamma d i i l * dd.D (m.basis l) (ui dd u j))
            + ∑ l, (∑ m, gamma d i i m * gamma d m l j) * ui dd u l := by
            congr 1
            apply Finset.sum_congr rfl
            intro l _
            rw [hterm' l]
    _ = (∑ l, gamma d i i l * dd.D (m.basis l) (ui dd u j))
            + ∑ l, ∑ m, gamma d i i l * gamma d l m j * ui dd u m := by
            -- reindex the second sum: ∑_l ∑_m γ(i,i,m)γ(m,l,j) u_l  →  ∑_l ∑_m γ(i,i,l)γ(l,m,j) u_m
            congr 1
            rw [sum_swap_apply (a := fun l m => gamma d i i m * gamma d m l j * ui dd u l)]
            -- hmm: sum_swap_apply: (∑ j, ∑ k, a j k) = ∑ j, ∑ k, a k j
            apply Finset.sum_congr rfl
            intro l _
            apply Finset.sum_congr rfl
            intro m _
            ring -- γ(i,i,m)γ(m,l,j) u_l = γ(i,i,l)γ(l,m,j) u_m  (rename m↔l)
    _ = ∑ l, gamma d i i l * (dd.D (m.basis l) (ui dd u j) + ∑ m, gamma d l m j * ui dd u m) := by
