      = ∑ b, ∑ a, (if a = j then ∑ i, gamma d i i b else 0) * dd.D (m.basis a) (ui dd u b) by rw [Finset.sum_comm]]
  apply Finset.sum_congr rfl
  intro b _
  rw [Finset.sum_eq_single j]
  · simp
  · intro a _ ha
    simp [ha]
  · intro h
    exfalso; exact h (Finset.mem_univ j)
```

