lemma weitzenboeck_expand (dd) (d) (u) :
    fieldInner (gradField dd u) (fieldLaplacian dd d u)
      - fieldInner (gradField dd u) (gradLapField dd d u)
    = (∑ j, ∑ i, ∑ mm, ui dd u j * (cG d i j mm * dd.D (m.basis i) (ui dd u mm)
            - cG d j i mm * dd.D (m.basis mm) (ui dd u i)
            - gamma d i j mm * dd.D (m.basis i) (ui dd u mm)
            + gamma d i i mm * dd.D (m.basis j) (ui dd u mm)))
      + (∑ j, ∑ i, ∑ k, ui dd u j * (gamma d i k j * dd.D (m.basis i) (ui dd u k)
            - gamma d i i k * dd.D (m.basis k) (ui dd u j)))
      - (∑ j, ∑ i, ∑ k, ∑ l, ui dd u j * (gamma d i k j * gamma d i k l
            - gamma d i i k * gamma d k j l) * ui dd u l) := by
  rw [fieldInner_fieldLaplacian_expand, fieldInner_gradLapField_expand]
  rw [show (∑ j : ι, ∑ i : ι, ui dd u j * (dd.D (m.basis i) (H dd d u i j)
          + ∑ k : ι, gamma d i k j * H dd d u i k - ∑ l : ι, gamma d i i l * H dd d u l j))
        - (∑ j : ι, ∑ i : ι, ui dd u j * dd.D (m.basis j) (H dd d u i i))
      = ∑ j : ι, ∑ i : ι, ui dd u j * (dd.D (m.basis i) (H dd d u i j)
          + ∑ k : ι, gamma d i k j * H dd d u i k - ∑ l : ι, gamma d i i l * H dd d u l j
          - dd.D (m.basis j) (H dd d u i i)) by
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro j _
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i _
    rw [mul_sub]]
  -- per (j,i): expand H's and commute
  rw [show (∑ j : ι, ∑ i : ι, ui dd u j * (dd.D (m.basis i) (H dd d u i j)
          + ∑ k : ι, gamma d i k j * H dd d u i k - ∑ l : ι, gamma d i i l * H dd d u l j
          - dd.D (m.basis j) (H dd d u i i)))
      = (∑ j : ι, ∑ i : ι, ∑ mm : ι, ui dd u j * (cG d i j mm * dd.D (m.basis i) (ui dd u mm)
            - cG d j i mm * dd.D (m.basis mm) (ui dd u i)
            - gamma d i j mm * dd.D (m.basis i) (ui dd u mm)
            + gamma d i i mm * dd.D (m.basis j) (ui dd u mm)))
        + (∑ j : ι, ∑ i : ι, ∑ k : ι, ui dd u j * (gamma d i k j * dd.D (m.basis i) (ui dd u k)
            - gamma d i i k * dd.D (m.basis k) (ui dd u j)))
        - (∑ j : ι, ∑ i : ι, ∑ k : ι, ∑ l : ι, ui dd u j * (gamma d i k j * gamma d i k l
            - gamma d i i k * gamma d k j l) * ui dd u l) by
    apply Finset.sum_congr rfl
    intro j _
    apply Finset.sum_congr rfl
    intro i _
    -- per (j,i) — the big calc
    calc
      ui dd u j * (dd.D (m.basis i) (H dd d u i j) + ∑ k, gamma d i k j * H dd d u i k
            - ∑ l, gamma d i i l * H dd d u l j - dd.D (m.basis j) (H dd d u i i))
          = ui dd u j * ((dd.D (m.basis i) (dd.D (m.basis i) (ui dd u j)) - ∑ l, gamma d i j l * dd.D (m.basis i) (ui dd u l))
              + (∑ k, gamma d i k j * dd.D (m.basis i) (ui dd u k) - ∑ k, ∑ l, gamma d i k j * gamma d i k l * ui dd u l)
              - (∑ l, gamma d i i l * dd.D (m.basis l) (ui dd u j) - ∑ l, ∑ k, gamma d i i l * gamma d l j k * ui dd u k)
              - (dd.D (m.basis j) (dd.D (m.basis i) (ui dd u i)) - ∑ l, gamma d i i l * dd.D (m.basis j) (ui dd u l))) := by
            rw [D_H_expand dd d u i j, D_H_expand dd d u i i]
            -- the ∑k γ(i,k,j) H_ik expansion
