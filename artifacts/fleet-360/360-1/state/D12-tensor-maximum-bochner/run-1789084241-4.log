```
lemma D_comm_u (dd) (d) (a b) (u) :
    dd.D (m.basis a) (ui dd u b) - dd.D (m.basis b) (ui dd u a)
      = ∑ m, cG d a b m * ui dd u m := by
  have h := dd.bracket_deriv (m.basis a) (m.basis b) u
  have hb := D_expand dd (b.bracket (m.basis a) (m.basis b)) u
  rw [h, hb]
  apply Finset.sum_congr rfl
  intro m _
  have hm : (gA (m.form (m.basis m) (b.bracket (m.basis a) (m.basis b))) : A) = cG d a b m := by
    rw [cG_eq_torsion, m.form_symm]
  exact congrArg (fun x => x * ui dd u m) hm
```

