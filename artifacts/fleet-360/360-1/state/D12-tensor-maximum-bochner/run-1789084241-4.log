calc
  fieldInner (gradField dd u) (fieldLaplacian dd d u) - fieldInner (gradField dd u) (gradLapField dd d u)
    = (∑ j, ∑ i, ui dd u j * (nablaField dd d (m.basis i) (nablaField dd d (m.basis i) (gradField dd u)) j
          - nablaField dd d (d.nabla (m.basis i) (m.basis i)) (gradField dd u) j))
        - (∑ j, ∑ i, ui dd u j * dd.D (m.basis j) (H dd d u i i)) := by
        unfold fieldInner fieldLaplacian gradLapField lap
        -- fieldLaplacian coeff: ∑_i (∇∇ - ∇'∇); gradLapField coeff: D_j (∑_i H_ii) = ∑_i D_j H_ii (map_sum)
        -- + sum reorg: fieldInner = ∑_j u_j * (∑_i ...) → ∑_j ∑_i u_j * ...
