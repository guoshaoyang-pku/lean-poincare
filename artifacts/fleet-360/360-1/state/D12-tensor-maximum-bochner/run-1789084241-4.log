have h2fix : ∀ j, (∑ a, ∑ b, K d j a b * dd.D (m.basis a) (ui dd u b))
      = (1/2 : ℝ) • (∑ a, ∑ b, ∑ m, K d j a b * cG d a b m * ui dd u m) := by
  intro j
  -- 2 * LHS = ∑_{a,b,m} K(j,a,b) c(a,b,m) u_m  then smul by 1/2
  have htwo : (2 : ℝ) • (∑ a, ∑ b, K d j a b * dd.D (m.basis a) (ui dd u b))
      = ∑ a, ∑ b, ∑ m, K d j a b * cG d a b m * ui dd u m := by
    calc (2 : ℝ) • (∑ a, ∑ b, K d j a b * dd.D (m.basis a) (ui dd u b))
        = (∑ a, ∑ b, K d j a b * dd.D (m.basis a) (ui dd u b))
            + (∑ a, ∑ b, K d j a b * dd.D (m.basis a) (ui dd u b)) := by
              rw [two_smul]  -- (2:ℝ)•x = x + x
      _ = (∑ a, ∑ b, K d j a b * dd.D (m.basis a) (ui dd u b))
            + (∑ a, ∑ b, K d j b a * dd.D (m.basis b) (ui dd u a)) := by
              congr 1
              rw [sum_swap_apply (a := fun a b => K d j a b * dd.D (m.basis a) (ui dd u b))]  -- swaps to K d j b a * D_b u_a? hmm
      _ = ∑ a, ∑ b, (K d j a b * dd.D (m.basis a) (ui dd u b) + K d j b a * dd.D (m.basis b) (ui dd u a)) := by rw [← Finset.sum_add_distrib]
      _ = ∑ a, ∑ b, K d j a b * (dd.D (m.basis a) (ui dd u b) - dd.D (m.basis b) (ui dd u a)) := by
            apply Finset.sum_congr rfl
            intro a _
            apply Finset.sum_congr rfl
            intro b _
            rw [K_antisym d j a b]  -- K(j,b,a) = -K(j,a,b)
            ring
      _ = ∑ a, ∑ b, K d j a b * (∑ m, cG d a b m * ui dd u m) := by
            apply Finset.sum_congr rfl
            intro a _
            apply Finset.sum_congr rfl
            intro b _
            congr 1
            -- D_a u_b - D_b u_a = ∑_m c(a,b,m) u_m
            have hc := dd.bracket_deriv (m.basis a) (m.basis b) u
            -- D_a u_b - D_b u_a = D_{b(a,b)} u = ∑_m c(a,b,m) u_m
            rw [show dd.D (b.bracket (m.basis a) (m.basis b)) u = ∑ m, cG d a b m * ui dd u m by
              rw [D_expand dd (b.bracket (m.basis a) (m.basis b)) u]
              apply Finset.sum_congr rfl
              intro m _
              have hm : (gA (m.form (m.basis m) (b.bracket (m.basis a) (m.basis b))) : A) = cG d a b m := by
                rw [cG_eq_torsion, m.form_symm]
              exact congrArg (fun x => x * ui dd u m) hm]
            exact hc.symm  -- hmm direction
      _ = ∑ a, ∑ b, ∑ m, K d j a b * cG d a b m * ui dd u m := by
            apply Finset.sum_congr rfl
            intro a _
            rw [Finset.mul_sum]
            -- K * (∑_m c(a,b,m) u_m) = ∑_m (K * c * u) — need assoc/comm
  -- now: (1/2)•(2•LHS) = LHS
  calc (∑ a, ∑ b, K d j a b * dd.D (m.basis a) (ui dd u b))
      = (1/2 : ℝ) • ((2 : ℝ) • (∑ a, ∑ b, K d j a b * dd.D (m.basis a) (ui dd u b))) := by
          rw [smul_smul]
          norm_num  -- (1/2)*2 = 1
          -- simp
    _ = (1/2 : ℝ) • (∑ a, ∑ b, ∑ m, K d j a b * cG d a b m * ui dd u m) := by rw [htwo]
