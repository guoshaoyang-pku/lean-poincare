import itertools, sympy as sp
from sympy import Symbol, expand
n = 3
# G with antisymmetry; c = G - G^T
Gfree = {(i,j,l): Symbol(f'G{i}{j}{l}') for i,j,l in product if j<l}
def G(i,j,l):
    if j==l: return 0
    if j<l: return Gfree[(i,j,l)]
    return -Gfree[(i,l,j)]
def c(i,j,l): return G(i,j,l)-G(j,i,l)
U = [Symbol(f'U{j}') for j in range(n)]
DU = {(i,j): Symbol(f'DU{i}{j}') for i,j in product}
# DU total
DUtot = expand(
  sum(U[j]*c(i,j,m)*DU[(i,m)] for j,i,m)
  - sum(U[j]*c(j,i,m)*DU[(m,i)] for ...)
  - sum(U[j]*G(i,j,l)*DU[(i,l)] ...)
  + sum(U[j]*G(i,i,l)*DU[(j,l)] ...)
  + sum(U[j]*G(i,k,j)*DU[(i,k)] ...)
  - sum(U[j]*G(i,i,l)*DU[(l,j)] ...))
# canonicalize DU[a,b] for a>b: DU[a,b] = DU[b,a] - c(a,b,m)U[m] summed
def canonDU(expr):
    new = expr
    for a in range(n):
        for b in range(a):
            new = expand(new.subs({DU[(a,b)]: DU[(b,a)] - sum(c(a,b,m)*U[m] for m in range(n))}))
    return new
D = canonDU(DUtot)
# split into DU-coeff part and UU part
...
```

