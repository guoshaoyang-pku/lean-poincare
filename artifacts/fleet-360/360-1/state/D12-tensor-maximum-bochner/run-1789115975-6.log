/-- The Gram matrix in the standard orthonormal basis of the metric family
`g(t) = (1-t)·g₀`, where `g₀ = So3.stdMetric` is the round metric of curvature 1/4. -/
def metricMatrix (t : ℝ) : Matrix (Fin 3) (Fin 3) ℝ := (1 - t) • 1

/-- The metric family itself: `g(t) = (1-t)•g₀` as a bilinear form. -/
def metricForm (t : ℝ) : Vec3 →ₗ[ℝ] Vec3 →ₗ[ℝ] ℝ := (1 - t) • stdMetric.form

lemma metricForm_apply (t : ℝ) (X Y : Vec3) : metricForm t X Y = (1 - t) * (X ⬝ᵥ Y) := by
  simp [metricForm, stdMetric_form]

/-- `metricMatrix` is the Gram matrix of `metricForm` in the orthonormal basis. -/
lemma gram_metricMatrix (t : ℝ) (i j : Fin 3) :
    metricForm t (Pi.basisFun ℝ (Fin 3) i) (Pi.basisFun ℝ (Fin 3) j) = metricMatrix t i j := by
  rw [metricForm_apply]
  simp [metricMatrix, Pi.basisFun_apply, dotProduct, Fin.sum_univ_three]
  -- goal: (1-t) * (if i = j then 1 else 0) = ((1-t) • 1) i j
  by_cases h : i = j <;> simp [h]
```

