    have h1 : HasDerivAt (fun s : ℝ => (1:ℝ) - s) (-1) t :=
      (hasDerivAt_const (c := (1:ℝ)) t).sub (hasDerivAt_id t)
    have h2 := h1.mul_const (X ⬝ᵥ Y)
    simpa using h2
  have hfun : (fun s : ℝ => metricForm s X Y) = fun s => (1 - s) * (X ⬝ᵥ Y) := by
    funext s; exact metricForm_apply s X Y
  rw [hfun, hderiv.deriv, ricci_eq_half_metric]
  ring
```

