```lean
namespace ChartMetric

variable {d : ℕ} (G : ChartMetric d)

/-- The `i`-th coordinate partial derivative of a scalar function (Euclidean chart gradient
component): `∂ᵢ f x = fderiv f x eᵢ`. -/
def partialDeriv (i : Fin d) (f : Vec d → ℝ) (x : Vec d) : ℝ :=
  fderiv ℝ f x (Pi.single i 1)

/-- The weighted divergence `∑ᵢ ∂ᵢ(ω · Xᵢ)` of a vector field `X` with weight `ω`. -/
def weightedDivergence (ω : Vec d → ℝ) (X : Vec d → Vec d) (x : Vec d) : ℝ :=
  ∑ i, fderiv ℝ (fun y => ω y * X y i) x (Pi.single i 1)

/-- The metric divergence `ρ⁻¹ · ∑ᵢ ∂ᵢ(ρ · Xᵢ)`, the divergence w.r.t. the metric measure. -/
def divergence (X : Vec d → Vec d) (x : Vec d) : ℝ :=
  G.weightedDivergence G.density X x / G.density x
```

