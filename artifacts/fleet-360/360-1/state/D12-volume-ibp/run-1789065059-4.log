```lean
import Poincare.D12.VolumeIBP.Regularity

open scoped BigOperators ENNReal NNReal
noncomputable section
open MeasureTheory Set Function

namespace Poincare.D12.VolumeIBP

namespace ChartMetric

variable {d : ℕ} (G : ChartMetric d)

/-- The Euclidean coordinate partial derivative of a scalar function: `∂_i f x = fderiv f x (e i)`. -/
def partial (i : Fin d) (f : Vec d → ℝ) (x : Vec d) : ℝ :=
  fderiv ℝ f x (Pi.single i 1)

/-- The weighted divergence of a vector field: `div_ρ X = ∑ i ∂_i (ρ X_i)`. -/
def weightedDivergence (ω : Vec d → ℝ) (X : Vec d → Vec d) (x : Vec d) : ℝ :=
  ∑ i, fderiv ℝ (fun y => ω y * X y i) x (Pi.single i 1)

/-- The metric divergence: `div_g X = ρ⁻¹ ∑ i ∂_i (ρ X_i)`. -/
def divergence (X : Vec d → Vec d) (x : Vec d) : ℝ :=
  G.weightedDivergence G.density X x / G.density x
```

