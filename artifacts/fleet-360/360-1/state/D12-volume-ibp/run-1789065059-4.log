variable {d : ℕ} (G : ChartMetric d)

/-- Propositional `if` preserves `ContDiff` (the two branches are constant choices). -/
private lemma contDiff_if_const {p : Prop} [Decidable p] {n : WithTop ℕ∞}
    {f g : Vec d → ℝ} (hf : ContDiff ℝ n f) (hg : ContDiff ℝ n g) :
    ContDiff ℝ n (fun x => if p then f x else g x) := by
  by_cases hp : p <;> simp [hp, hf, hg]
```

