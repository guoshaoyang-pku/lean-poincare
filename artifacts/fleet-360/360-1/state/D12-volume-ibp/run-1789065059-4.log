```lean
import Poincare.D12.VolumeIBP.Regularity

open scoped BigOperators ENNReal NNReal
noncomputable section
open MeasureTheory Set Function

namespace Poincare.D12.VolumeIBP

/-- Every compact subset of `Vec d` lies in some open box (product of open intervals). -/
lemma exists_pi_Ioo_supset_compact {d : ℕ} (K : Set (Vec d)) (hK : IsCompact K) :
    ∃ a b : Vec d, K ⊆ Set.pi Set.univ fun i => Ioo (a i) (b i) := by
  classical
  by_cases hne : K.Nonempty
  · choose m hmK hmin using fun i : Fin d =>
      hK.exists_isMinOn hne (continuous_apply i).continuousOn
    choose M hMK hmax using fun i : Fin d =>
      hK.exists_isMaxOn hne (continuous_apply i).continuousOn
    refine ⟨fun i => m i i - 1, fun i => M i i + 1, ?_⟩
    intro x hx
    rw [Set.mem_univ_pi]
    intro i
    have hminx : m i i ≤ x i := (hmin i).2 x hx
    have hmaxx : x i ≤ M i i := (hmax i).2 x hx
    exact ⟨by linarith, by linarith⟩
  · refine ⟨0, 1, ?_⟩
    intro x hx
    exact (hne ⟨x, hx⟩).elim
```
Check `Set.mem_univ_pi` — from t12 non-error ✓. hmin i : IsMinOn (fun x => x i) K (m i) — `(hmin i).2 x hx : (fun x => x i) (m i) ≤ (fun x => x i) x` = m i i ≤ x i ✓.

