lemma bochner_identity (u : Vec (n + 1) → ℝ) (hu : ContDiff ℝ 2 u)
    (hΔ : ContDiff ℝ 2 (G.laplacian u)) (hΔc : HasCompactSupport (G.laplacian u)) :
    ∫ x, G.laplacian u x * G.laplacian u x * G.density x =
      -∫ x, G.innerInverse x (grad u x) (grad (G.laplacian u) x) * G.density x := by
