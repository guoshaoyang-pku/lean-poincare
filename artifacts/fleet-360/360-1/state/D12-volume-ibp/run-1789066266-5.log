lemma hasCompactSupport_divSum (u : Vec (n + 1) → ℝ) (W : Vec (n + 1) → Vec (n + 1))
    (huc : HasCompactSupport u) :
    HasCompactSupport (fun y : Vec (n + 1) => ∑ i, partialDeriv i (fun z => u z * W z i) y) := by
  have hsupp : support (fun y : Vec (n + 1) => ∑ i, partialDeriv i (fun z => u z * W z i) y)
      ⊆ tsupport u := by
    intro y hy
    by_contra hyT
    have hu0 : u =ᶠ[𝓝 y] fun _ => (0 : ℝ) := eventuallyEq_zero_of_not_mem_tsupport u hyT
    have hpd : ∀ i, partialDeriv i (fun z : Vec (n + 1) => u z * W z i) y = 0 := by
      intro i
      have hmul : (fun z : Vec (n + 1) => u z * W z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
        filter_upwards [hu0] with z hz
        simp [hz]
      exact partialDeriv_eq_zero_of_eventuallyEq_zero i (fun z : Vec (n + 1) => u z * W z i) hmul
    have hval : (∑ i, partialDeriv i (fun z : Vec (n + 1) => u z * W z i) y) = 0 := by
      simp [hpd]
    exact (mem_support.mp hy) hval
  have hts : tsupport (fun y : Vec (n + 1) => ∑ i, partialDeriv i (fun z => u z * W z i) y)
      ⊆ tsupport u := by
    rw [← (isClosed_tsupport u).closure_eq]
    exact closure_mono hsupp
  simpa [HasCompactSupport] using huc.isCompact.of_isClosed_subset (isClosed_tsupport _) hts
```

