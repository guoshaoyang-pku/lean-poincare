lemma eventuallyEq_zero_of_not_mem_tsupport (f : Vec (n + 1) → ℝ) {x : Vec (n + 1)} (hx : x ∉ tsupport f) :
    f =ᶠ[𝓝 x] fun _ => (0 : ℝ) := by
  filter_upwards [IsOpen.mem_nhds (isClosed_tsupport f).isOpen_compl hx] with y hy
  have hy' : y ∉ support f := by
    intro hys
    exact hy (subset_tsupport f hys)
  by_contra hny
  exact hy' (mem_support.mpr hny)
```

