    (hu1 : ContDiff ℝ 1 u) (huc : HasCompactSupport u) :
    HasCompactSupport (fun y : Vec (n + 1) => ∑ i, partialDeriv i (fun z => u z * W z i) y) := by
  have hsupp : support (fun y : Vec (n + 1) => ∑ i, partialDeriv i (fun z => u z * W z i) y) ⊆ tsupport u := by
    intro y hy
    by_contra hyT
    have hu0 : u =ᶠ[𝓝 y] fun _ => (0 : ℝ) := eventuallyEq_zero_of_not_mem_tsupport u hyT
    have hpd : ∀ i, partialDeriv i (fun z => u z * W z i) y = 0 := by
      intro i
      have hmul : (fun z : Vec (n + 1) => u z * W z i) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
        filter_upwards [hu0] with z hz
        simp [hz]
      exact partialDeriv_eq_zero_of_eventuallyEq_zero i (fun z => u z * W z i) y hmul
    have hval : (∑ i, partialDeriv i (fun z => u z * W z i) y) = 0 := by simp [hpd]
