```lean
import Poincare.D12.VolumeIBP.Divergence

/-! header -/

open scoped BigOperators ENNReal NNReal
noncomputable section
open MeasureTheory Set Function
namespace Poincare.D12.VolumeIBP

namespace ChartMetric

variable {n : ℕ} (G : ChartMetric (n + 1))

/-- Coordinate gradient of a scalar function: `∇f x i = ∂ᵢf(x)`. -/
def grad (f : Vec (n + 1) → ℝ) (x : Vec (n + 1)) : Vec (n + 1) :=
  fun i => partialDeriv i f x

/-- Metric gradient `∇_g f = g⁻¹ ∇f`. -/
def gradG (f : Vec (n + 1) → ℝ) (x : Vec (n + 1)) : Vec (n + 1) :=
  fun i => ∑ j, (G.invMatrix x) i j * partialDeriv j f x

/-- The pairing on covectors induced by the inverse metric. -/
def innerInverse (x : Vec (n + 1)) (a b : Vec (n + 1)) : ℝ :=
  ∑ i, ∑ j, a i * (G.invMatrix x) i j * b j

/-- The Laplace-Beltrami operator `Δ_g f = ρ⁻¹ ∑ᵢ ∂ᵢ(ρ (∇_g f)ᵢ)`. -/
def laplacian (f : Vec (n + 1) → ℝ) (x : Vec (n + 1)) : ℝ :=
  (∑ i, partialDeriv i (fun y => G.density y * G.gradG f y i) x) / G.density x
```

