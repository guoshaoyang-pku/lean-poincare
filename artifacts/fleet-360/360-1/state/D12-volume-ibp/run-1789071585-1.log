  ∂_i(ρ A_i) = ∂ρ_i·A_i + ρ·∂A_i [fderiv_mul ρ A_i]
  ∂ω_i = ∂(h·ρ)_i = ∂h_i·ρ + h·∂ρ_i [fderiv_mul h ρ]
