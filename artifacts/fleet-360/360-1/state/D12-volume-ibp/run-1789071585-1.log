```
lemma laplacian_continuous (v : Vec (n+1) → ℝ) (hv : ContDiff ℝ 2 v) :
    Continuous (fun x : Vec (n+1) => G.laplacian v x) := by
  -- laplacian v = (∑ i, fderiv (ρ·grad v_i) x e_i) / ρ — numerator continuous, denominator continuous nonzero
  have hnum : Continuous (fun x : Vec (n+1) => ∑ i, fderiv ℝ (fun y => G.density y * G.grad v y i) x (Pi.single i 1)) := by
    refine continuous_finsetSum (Finset.univ : Finset (Fin (n+1))) fun i _ => ?_
    have hc : Continuous (fun x : Vec (n+1) => fderiv ℝ (fun y => G.density y * G.grad v y i) x) :=
      (ContDiff.continuous_fderiv (hρA1 i) (by norm_num : (1 : WithTop ℕ∞) ≠ 0))
    exact ((ContinuousLinearMap.apply ℝ ℝ (Pi.single i 1)).continuous.comp hc)
