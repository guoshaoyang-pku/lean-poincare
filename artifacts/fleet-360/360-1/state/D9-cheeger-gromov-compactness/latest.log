files=[]
for dirpath, dirnames, filenames in os.walk(WT):
    dirnames[:] = [d for d in dirnames if d not in (".lake",".git",".dshpkg")]
    for fn in filenames:
        if fn.endswith(".lean"):
            files.append(os.path.join(dirpath, fn))
files.sort()
detail=[]
ok=True
t0=time.time()
for f in files:
    r = subprocess.run(["lake","env","lean",f], cwd=WT, env=ENV, capture_output=True, text=True, timeout=1800)
    detail.append({"file": os.path.relpath(f,WT), "exit": r.returncode, "stderr_tail": r.stderr[-400:] if r.returncode else ""})
    if r.returncode != 0: ok=False
json.dump({"ok":ok,"files_total":len(files),"failures":[d for d in detail if d["exit"]!=0],"seconds_total":round(time.time()-t0,1),"files":detail}, open(WT+"/logs/20_D9_gate_replica.json","w"), indent=2)
print("ok",ok,"total",len(files),"failures",[d["file"] for d in detail if d["exit"]!=0])
```

