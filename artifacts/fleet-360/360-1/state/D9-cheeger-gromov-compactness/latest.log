import json, os, subprocess, time
WT = "/data/home/guoshaoyang/workdir/lean_poincare/longrun/worktrees/D9-cheeger-gromov-compactness"
ENV = dict(os.environ)
ENV["ELAN_HOME"] = "/data/home/guoshaoyang/workdir/lean_poincare/elan"
