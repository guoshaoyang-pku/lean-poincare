theorem integral_moment_two : ∫ x, x^2 * gaussianKernel 1 x = sqrt π / 2
theorem integral_moment_four : ∫ x, x^4 * gaussianKernel 1 x = 3 * sqrt π / 4
theorem integral_moment_six : ∫ x, x^6 * gaussianKernel 1 x = 15 * sqrt π / 8

