```lean
import Mathlib.Analysis.SpecialFunctions.Gaussian.GaussianIntegral
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.MeasureTheory.Integral.Bochner.Basic

noncomputable section
open MeasureTheory Real

namespace Poincare.GaussianToolbox

/-- The unnormalised Gaussian kernel with parameter `a`. -/
def gaussianKernel (a x : ℝ) : ℝ := exp (-a * x^2)

/-- The normalised 1D Gaussian density with variance parameter `a`. -/
def gaussianDensity (a x : ℝ) : ℝ := sqrt (a / π) * exp (-a * x^2)

/-- Scaling: ∫ exp(-a x²) = √(π/a) for a > 0. -/
theorem integral_gaussianKernel {a : ℝ} (ha : 0 < a) :
    ∫ x : ℝ, gaussianKernel a x = sqrt (π / a) := integral_gaussian a
```

