/-- Unnormalised Gaussian kernel `x ↦ exp (-(a x²))`. -/
def gaussianKernel (a x : ℝ) : ℝ := exp (-(a * x ^ 2))

/-- Normalised 1-D Gaussian density with variance parameter `a > 0`. -/
def gaussianDensity (a x : ℝ) : ℝ := sqrt (a / π) * gaussianKernel a x

/-- Variance of the normalised Gaussian density `gaussianDensity a`. -/
def gaussianVariance (a : ℝ) : ℝ := 1 / (2 * a)

lemma gaussianKernel_def ...
@[simp] lemma gaussianKernel_neg ...

-- scaling
