/-- The `n`-dimensional Gaussian weight `x ↦ ∏ i, exp (-(x i)²)`. -/
def gaussianVec (n : ℕ) (x : Fin n → ℝ) : ℝ := ∏ i, gaussianKernel 1 (x i)

/-- Normalised `n`-dimensional standard Gaussian density. -/
def gaussianVecNormalized (n : ℕ) (x : Fin n → ℝ) : ℝ := (sqrt π) ^ (-(n : ℝ)) * gaussianVec n x

/-- The standard Gaussian weight `x ↦ exp (-‖x‖²/2)` on `ℝⁿ`. -/
def standardGaussianVec (n : ℕ) (x : Fin n → ℝ) : ℝ := exp (-(‖x‖ ^ 2 / 2))

/-- Normalised standard Gaussian density `(2π)^{-n/2} exp (-‖x‖²/2)`. -/
def standardGaussianDensity (n : ℕ) (x : Fin n → ℝ) : ℝ :=
  (2 * π) ^ (-(n : ℝ) / 2) * standardGaussianVec n x
```

