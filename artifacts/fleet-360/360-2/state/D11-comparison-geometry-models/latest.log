      (jacobiSol_nonneg ht0 (fun hK2 => ...))  -- j₂ t ≥ 0: 0 < K₂ → t ≤ π/√K₂ ✓
    exact pow_le_pow_left₀ hnonneg hmul (n - 1)
  -- integrate both sides over 0..r:
