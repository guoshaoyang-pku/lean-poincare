def wronskian (K₁ K₂ : ℝ) : ℝ → ℝ := fun t => jacobiDeriv K₁ t * jacobiSol K₂ t - jacobiSol K₁ t * jacobiDeriv K₂ t

theorem wronskian_deriv (K₁ K₂ t : ℝ) :
    deriv (wronskian K₁ K₂) t = (K₂ - K₁) * jacobiSol K₁ t * jacobiSol K₂ t := by
  unfold wronskian
  -- deriv (fun t => jacobiDeriv K₁ t * jacobiSol K₂ t - jacobiSol K₁ t * jacobiDeriv K₂ t) t
  rw [deriv_sub]
  · rw [deriv_mul, deriv_mul]
    · -- LHS: deriv (jacobiDeriv K₁) t * jacobiSol K₂ t + jacobiDeriv K₁ t * deriv (jacobiSol K₂) t
    ...
```
The pieces: deriv (jacobiDeriv K₁) t = -(K₁ * jacobiSol K₁ t) from (hasDerivAt_jacobiDeriv K₁ t).deriv. deriv (jacobiSol K₂) t = jacobiDeriv K₂ t (jacobiSol_deriv). So:
deriv W t = (-(K₁*j₁))·j₂ + j₁'·j₂' - (j₁'·j₂' + j₁·(-(K₂·j₂))) = -K₁j₁j₂ + j₁'j₂' - j₁'j₂' + K₂j₁j₂ → ring. 
Differentiability needed: differentiability of the products — jacobiDeriv differentiable: deriv of jacobiDeriv = hasDerivAt_jacobiDeriv → DifferentiableAt ✓ (`(hasDerivAt_jacobiDeriv K₁ t).differentiableAt`). jacobiSol differentiable ✓.

deriv_sub requires DifferentiableAt of both: (fun t => jacobiDeriv K₁ t * jacobiSol K₂ t) — differentiableAt.mul of the two ✓; and similarly the other. Fine.

Then ring closes: goal (K₂-K₁)·j₁·j₂.

