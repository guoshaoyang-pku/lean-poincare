/-- **Laplacian comparison, model case.** ... Δr ≤ (n-1) j_K'(r)/j_K(r) holds with equality... -/
theorem laplacianComparison_model {n : ℕ} {K r : ℝ} (hj : Poincare.D10.jacobiSol K r ≠ 0) :
    radialLaplacian n (Poincare.D10.jacobiSol K) id r ≤
      (n - 1 : ℝ) * Poincare.D10.jacobiDeriv K r / Poincare.D10.jacobiSol K r :=
  le_of_eq (radialLaplacian_id_jacobiSol hj)

/-- with the natural domain hypotheses: -/
theorem laplacianComparison_model_domain {n : ℕ} {K r : ℝ} (hr : 0 < r)
    (hdom : 0 < K → r < Real.pi / Real.sqrt K) :
    radialLaplacian n (Poincare.D10.jacobiSol K) id r ≤
      (n - 1 : ℝ) * Poincare.D10.jacobiDeriv K r / Poincare.D10.jacobiSol K r :=
  laplacianComparison_model (ne_of_gt (jacobiSol_pos hr hdom))

/-- **Cross-model Laplacian comparison.** For K₂ ≤ K₁: Δ_{K₁} r ≤ Δ_{K₂} r ... -/
theorem radialLaplacian_id_le_of_le {n : ℕ} {K₁ K₂ : ℝ} (hK : K₂ ≤ K₁) {r : ℝ} (hr : 0 < r)
    (hdom : 0 < K₁ → r < Real.pi / Real.sqrt K₁) :
    radialLaplacian n (Poincare.D10.jacobiSol K₁) id r ≤ radialLaplacian n (Poincare.D10.jacobiSol K₂) id r := by
  have hj1 : Poincare.D10.jacobiSol K₁ r ≠ 0 := ne_of_gt (jacobiSol_pos hr hdom)
  have hj1pos : 0 < Poincare.D10.jacobiSol K₁ r := jacobiSol_pos hr hdom
  have hj2pos : 0 < Poincare.D10.jacobiSol K₂ r := jacobiSol_pos_of_le hK hr hdom
  have hj2 : Poincare.D10.jacobiSol K₂ r ≠ 0 := ne_of_gt hj2pos
  rw [radialLaplacian_id_jacobiSol hj1, radialLaplacian_id_jacobiSol hj2]
  have hW : wronskian K₁ K₂ r ≤ 0 := wronskian_le_zero hK hr.le (fun hK₁ => le_of_lt (hdom hK₁))
  unfold wronskian at hW
  have hmul : Poincare.D10.jacobiDeriv K₁ r * Poincare.D10.jacobiSol K₂ r ≤
      Poincare.D10.jacobiSol K₁ r * Poincare.D10.jacobiDeriv K₂ r := by linarith
  have hdiv : Poincare.D10.jacobiDeriv K₁ r / Poincare.D10.jacobiSol K₁ r ≤
      Poincare.D10.jacobiDeriv K₂ r / Poincare.D10.jacobiSol K₂ r := by
    rwa [div_le_div_iff₀ hj1pos hj2pos, mul_comm] -- hmm
