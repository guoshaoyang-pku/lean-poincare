      have hrmem : r ∈ Ioo 0 r₀ := ⟨lt_of_le_of_lt htpos htr, hrlt⟩
      have hq : jacobiSol K₁ r / jacobiSol K₂ r ≤ jacobiSol K₁ t / jacobiSol K₂ t := hanti htmem hrmem htr
