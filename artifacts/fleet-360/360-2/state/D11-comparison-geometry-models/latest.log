theorem radialLaplacian_id_le_of_le {n : ℕ} {K₁ K₂ : ℝ} (hK : K₂ ≤ K₁) {r : ℝ}
    (hr : 0 < r) (hdom : 0 < K₁ → r < π/√K₁) :
    radialLaplacian n (jacobiSol K₁) id r ≤ radialLaplacian n (jacobiSol K₂) id r := by
  have hj1 : jacobiSol K₁ r ≠ 0 := ne_of_gt (jacobiSol_pos_of_pos hr hdom)
  have hj2 : jacobiSol K₂ r ≠ 0 := ne_of_gt (jacobiSol_pos_of_pos hr (fun hK2 => lt_of_lt_of_le (hdom (lt_of_lt_of_le hK2 hK)) (firstZero_le_firstZero hK (lt_of_lt_of_le hK2 hK) hK2)))
  rw [radialLaplacian_id_jacobiSol hj1, radialLaplacian_id_jacobiSol hj2]
  -- (n-1) * j₁' / j₁ ≤ (n-1) * j₂' / j₂
  -- from W = j₁'j₂ - j₁j₂' ≤ 0: j₁'j₂ ≤ j₁j₂' → j₁'/j₁ ≤ j₂'/j₂ (divide by j₁j₂ > 0):
  have hW : wronskian K₁ K₂ r ≤ 0 := wronskian_le_zero hK hr.le (fun hK1 => le_of_lt (hdom hK1))
  -- wronskian K₁ K₂ r = jacobiDeriv K₁ r * jacobiSol K₂ r - jacobiSol K₁ r * jacobiDeriv K₂ r
  unfold wronskian at hW
  -- j₁' * j₂ - j₁ * j₂' ≤ 0 → j₁' * j₂ ≤ j₁ * j₂':
  have hmul : jacobiDeriv K₁ r * jacobiSol K₂ r ≤ jacobiSol K₁ r * jacobiDeriv K₂ r := by linarith
  -- divide: j₁'/j₁ ≤ j₂'/j₂:
  have hdiv : jacobiDeriv K₁ r / jacobiSol K₁ r ≤ jacobiDeriv K₂ r / jacobiSol K₂ r := by
    rwa [div_le_div_iff₀ hj1pos hj2pos]  -- (a/b ≤ c/d ↔ a*d ≤ c*b): j₁' * j₂ ≤ j₂' * j₁ — comm reorder
    -- hmul : j₁' * j₂ ≤ j₁ * j₂'; need j₁' * j₂ ≤ j₂' * j₁: rw [mul_comm] ✓
  -- multiply by (n-1) ≥ 0:
  have hn : 0 ≤ (n - 1 : ℝ) := by exact_mod_cast Nat.zero_le (n - 1)
  exact mul_le_mul_of_nonneg_left hdiv hn
```
