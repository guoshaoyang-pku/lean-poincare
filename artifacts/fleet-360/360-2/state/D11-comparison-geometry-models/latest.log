      exact mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonpos_of_nonneg hKneg hj1) hj2
  have h := hanti (Set.left_mem_Icc.mpr ht) (Set.right_mem_Icc.mpr ht) ht
