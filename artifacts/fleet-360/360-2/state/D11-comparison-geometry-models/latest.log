def radialLaplacian (n : ℕ) (j f : ℝ → ℝ) (r : ℝ) : ℝ :=
  deriv (deriv f) r + ((n - 1 : ℝ) * deriv j r / j r) * deriv f r

theorem radialLaplacian_id {n : ℕ} {j : ℝ → ℝ} {r : ℝ} (hj : j r ≠ 0) :
    radialLaplacian n j id r = (n - 1 : ℝ) * deriv j r / j r := by
  unfold radialLaplacian
  rw [deriv_id]
  -- deriv (deriv id) r = 0: deriv id = fun _ => 1 (funext deriv_id); then deriv of const 1 = 0:
  have h : deriv (deriv id) r = 0 := by
    have hfun : deriv id = fun _ : ℝ => (1 : ℝ) := funext deriv_id
    rw [hfun]
    exact deriv_const r 1  -- deriv_const : deriv (fun _ => c) x = 0 ✓
  rw [h]
  simp
```
