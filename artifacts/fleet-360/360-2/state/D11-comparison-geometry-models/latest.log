/-- **Bishop–Gromov volume comparison at the ODE level.** ... -/
theorem bishopGromov_volume_comparison {n : ℕ} {K₁ K₂ : ℝ} (hK : K₂ ≤ K₁) {r₁ r₂ : ℝ}
    (hr₁ : 0 < r₁) (hr₁₂ : r₁ ≤ r₂) (hdom : 0 < K₁ → r₂ ≤ Real.pi / Real.sqrt K₁) :
    ballVolume n K₁ r₂ / ballVolume n K₂ r₂ ≤ ballVolume n K₁ r₁ / ballVolume n K₂ r₁ := by
  have hanti : AntitoneOn (fun r : ℝ => ballVolume n K₁ r / ballVolume n K₂ r) (Icc r₁ r₂) := by
    refine antitoneOn_of_deriv_nonpos (convex_Icc r₁ r₂) ?_ ?_ ?_
    · -- continuity on Icc r₁ r₂
      refine (continuous_ballVolume K₁).continuousOn.div (continuous_ballVolume K₂).continuousOn ?_
      intro x hx
      exact ne_of_gt (ballVolume_pos (lt_of_lt_of_le hr₁ hx.1) (fun hK₂ =>
        le_trans hx.2 (firstZero_le_firstZero hK (lt_of_lt_of_le hK₂ hK) hK₂)))
    · -- differentiability on interior
      rw [interior_Icc]
      refine (differentiable_ballVolume K₁).differentiableOn.div (differentiable_ballVolume K₂).differentiableOn ?_
      intro x hx
      exact ne_of_gt (ballVolume_pos hx.1 (fun hK₂ =>
        le_trans hx.2.le (firstZero_le_firstZero hK (lt_of_lt_of_le hK₂ hK) hK₂)))
    · -- derivative ≤ 0 on interior
      intro x hx
      rw [interior_Icc] at hx
      have hxmem : x ∈ Ioo 0 r₂ := ⟨lt_of_lt_of_le hr₁ hx.1, hx.2⟩
      exact ballVolume_ratio_deriv_nonpos hK (lt_of_lt_of_le hr₁ hr₁₂) hdom hxmem
      -- hr₀pos : 0 < r₂ ✓ (from hr₁ ≤ r₂), hdom₀ : 0 < K₁ → r₂ ≤ π/√K₁ ✓
  exact hanti (Set.left_mem_Icc.mpr hr₁₂) (Set.right_mem_Icc.mpr hr₁₂) hr₁₂
```
