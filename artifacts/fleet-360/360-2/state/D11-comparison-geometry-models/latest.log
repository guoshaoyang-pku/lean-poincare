theorem bishopGromov_volume_comparison_of_nonpos {n : ℕ} {K₁ K₂ : ℝ} (hK : K₂ ≤ K₁) (hK₁ : K₁ ≤ 0)
    {r₁ r₂ : ℝ} (hr₁ : 0 < r₁) (hr₁₂ : r₁ ≤ r₂) :
    ballVolume n K₁ r₂ / ballVolume n K₂ r₂ ≤ ballVolume n K₁ r₁ / ballVolume n K₂ r₁ :=
  bishopGromov_volume_comparison hK hr₁ hr₁₂ fun h => absurd h (not_lt.mpr hK₁)

/-- BG with the first zero of the larger curvature spelled out (spherical comparison regime). -/
theorem bishopGromov_volume_comparison_sphere {n : ℕ} {K₁ K₂ : ℝ} (hK : K₂ ≤ K₁) (hK₁ : 0 < K₁)
    {r₁ r₂ : ℝ} (hr₁ : 0 < r₁) (hr₁₂ : r₁ ≤ r₂) (hr₂ : r₂ ≤ Real.pi / Real.sqrt K₁) :
    ballVolume n K₁ r₂ / ballVolume n K₂ r₂ ≤ ballVolume n K₁ r₁ / ballVolume n K₂ r₁ :=
  bishopGromov_volume_comparison hK hr₁ hr₁₂ fun _ => hr₂
```

