```lean
namespace Poincare.D11
open Poincare.D10
open MeasureTheory Set

/-- Positivity of the normalised Jacobi field up to its first zero. -/
theorem jacobiSol_pos {K t : ℝ} (ht : 0 < t)
    (hK : 0 < K → t < Real.pi / Real.sqrt K) : 0 < jacobiSol K t := by
  rcases lt_trichotomy K 0 with h | h | h
  · rw [jacobiSol_of_neg h, jacobiSolHyperbolic]
    apply div_pos
    · exact Real.sinh_pos_iff.mpr (mul_pos (Real.sqrt_pos_of_pos (neg_pos.mpr h)) ht)
    · exact Real.sqrt_pos_of_pos (neg_pos.mpr h)
  · rw [h, jacobiSol_of_zero]; simpa [jacobiSolFlat] using ht
  · rw [jacobiSol_of_pos h, jacobiSolSphere]
    apply div_pos
    · apply Real.sin_pos_of_pos_of_lt_pi
      · exact mul_pos (Real.sqrt_pos_of_pos h) ht
      · -- √K * t < π from t < π/√K
        have hsqrt : 0 < Real.sqrt K := Real.sqrt_pos_of_pos h
        have := (lt_div_iff₀ hsqrt).mp (hK h)  -- t < π/√K ↔ t*√K < π
        -- this gives t * √K < π; need √K * t < π
        linarith [this]  -- or rwa [mul_comm]
    · exact Real.sqrt_pos_of_pos h
```

