```lean
theorem bishopGromov {K₁ K₂ : ℝ} (hK : K₁ ≤ K₂) (n : ℕ) {s r : ℝ} (hs : 0 < s) (hsr : s ≤ r) {R : ℝ}
    (hrR : r ≤ R) (hR2 : 0 < K₂ → R < Real.pi / Real.sqrt K₂) :
    modelVolume n K₂ r / modelVolume n K₁ r ≤ modelVolume n K₂ s / modelVolume n K₁ s := by
  exact bishopGromov_ratio_antitone hK n ... ⟨s ∈ Ioc 0 R ...⟩ ⟨r ∈ Ioc 0 R ...⟩ hsr
```

