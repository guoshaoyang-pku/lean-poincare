theorem bishopGromov_volume_ratio {K₁ K₂ : ℝ} (hK : K₂ ≤ K₁) (m : ℕ) {r₁ r₂ : ℝ}
    (hr₁ : 0 < r₁) (hr₁₂ : r₁ ≤ r₂) (hdom : 0 < K₁ → r₂ ≤ Real.pi / Real.sqrt K₁) :
    modelBallVolume K₁ m r₂ / modelBallVolume K₂ m r₂ ≤
      modelBallVolume K₁ m r₁ / modelBallVolume K₂ m r₁ := by
  let F := fun u : ℝ => modelBallVolume K₁ m u / modelBallVolume K₂ m u
  have hV₂pos : ∀ u ∈ Set.Icc r₁ r₂, 0 < modelBallVolume K₂ m u := by
    intro u hu
    -- V₂(u) = ∫_0^u j₂^m; j₂^m > 0 on (0, u) since u ≥ r₁ > 0
    have hupos : 0 < u := lt_of_lt_of_le hr₁ hu.1
    -- integrand positivity on (0, u): for t ∈ Ioo 0 u: 0 < j₂ t ^ m
    have hpos_on : ∀ t ∈ Set.Ioo (0:ℝ) u, 0 < jacobiSol K₂ t ^ m := by
      intro t ht
      exact pow_pos (jacobiSol_pos_of_curvature_le hK ht.1 (ht.2.trans_le? ...) hdom) m
```

