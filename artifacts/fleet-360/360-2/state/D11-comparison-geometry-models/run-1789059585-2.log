/-- Spherical sectional curvature: sec(X,Y) = (1 - j'²)/j² for the unit sphere base. -/
noncomputable def sphericalSectionalCurvature (K r : ℝ) : ℝ :=
  (1 - jacobiDeriv K r ^ 2) / jacobiSol K r ^ 2

theorem sphericalSectionalCurvature_eq (K r : ℝ) (hr : jacobiSol K r ≠ 0) :
    sphericalSectionalCurvature K r = K := by
  have h := jacobiSol_wronskian K r  -- j'² + K j² = 1
  -- 1 - j'² = K j²
  have h' : 1 - jacobiDeriv K r ^ 2 = K * jacobiSol K r ^ 2 := by linarith
  unfold sphericalSectionalCurvature
  rw [h']
  field_simp [hr] -- (K * j²)/j² = K
```

