theorem crossWronskian_nonpos {K₁ K₂} (hK : K₂ ≤ K₁) {r} (hr : 0 ≤ r)
    (hdom : 0 < K₁ → r ≤ π/√K₁) :
    jacobiDeriv K₁ r * jacobiSol K₂ r - jacobiSol K₁ r * jacobiDeriv K₂ r ≤ 0 := by
  let P := fun u : ℝ => jacobiDeriv K₁ u * jacobiSol K₂ u - jacobiSol K₁ u * jacobiDeriv K₂ u
  have hcont : Continuous P := ((continuous_jacobiDeriv K₁).mul (continuous_jacobiSol K₂)).sub
    ((continuous_jacobiSol K₁).mul (continuous_jacobiDeriv K₂))
  have hdiff : Differentiable ℝ P := ...
  have hanti : AntitoneOn P (Set.Icc 0 r) := by
    refine antitoneOn_of_deriv_nonpos (convex_Icc 0 r) hcont.continuousOn hdiff.differentiableOn ?_
    intro u hu
    rw [interior_Icc] at hu
    have hu0 : 0 ≤ u := hu.1.le
    have hur : u ≤ r := hu.2.le
    rw [crossWronskian_deriv]
    -- (K₂ - K₁) * j₁ u * j₂ u ≤ 0
    have hKdiff : K₂ - K₁ ≤ 0 := sub_nonpos.mpr hK
    have hj₁ : 0 ≤ jacobiSol K₁ u := jacobiSol_nonneg hu0 (fun hK₁pos => le_trans hur (hdom hK₁pos))
    have hj₂ : 0 ≤ jacobiSol K₂ u := jacobiSol_nonneg_of_curvature_le hK hu0 hur hdom
    have hprod : 0 ≤ jacobiSol K₁ u * jacobiSol K₂ u := mul_nonneg hj₁ hj₂
    -- (K₂-K₁) ≤ 0 and 0 ≤ j₁j₂: product ≤ 0
    exact mul_nonpos_of_nonpos_of_nonneg hKdiff hprod
  have h0 : P 0 = 0 := by
    simp [P, jacobiSol_zero, jacobiDeriv_zero]
  -- P r ≤ P 0
  have h := hanti (Set.left_mem_Icc.mpr hr) (Set.right_mem_Icc.mpr hr) hr
  simpa [P, h0] using h  -- hmm: AntitoneOn P: for a ≤ b in s: P b ≤ P a ✓: h : P r ≤ P 0
