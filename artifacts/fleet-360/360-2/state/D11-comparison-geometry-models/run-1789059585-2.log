```
/-- The Laplacian of a radial function in the model space form M_K^n with metric
`dr² + j_K(r)² g_{S^{n-1}}`, given by the warped-product formula `Δf = f'' + (n-1) (j'/j) f'`. -/
noncomputable def modelRadialLaplacian (K : ℝ) (n : ℕ) (f : ℝ → ℝ) (r : ℝ) : ℝ :=
  deriv (deriv f) r + ((n : ℝ) - 1) * (jacobiDeriv K r / jacobiSol K r) * deriv f r

/-- Laplacian comparison in the model case: `Δ r = (n-1) j_K'(r)/j_K(r)` ... -/
theorem modelLaplacian_distance (K : ℝ) (n : ℕ) {r : ℝ} :
    modelRadialLaplacian K n (fun x => x) r = ((n : ℝ) - 1) * (jacobiDeriv K r / jacobiSol K r) := by
  unfold modelRadialLaplacian
  have h₁ : deriv (fun x : ℝ => x) r = 1 := (hasDerivAt_id r).deriv
  have h₂ : deriv (deriv (fun x : ℝ => x)) r = 0 := by
    rw [funext (fun y => (hasDerivAt_id y).deriv)]  -- deriv (fun x => x) = fun _ => 1
    exact (hasDerivAt_const (x := r) (c := (1:ℝ))).deriv
  rw [h₂, h₁]
  ring
```

