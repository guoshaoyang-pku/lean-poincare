/-- Radial sectional curvature of the warped product: sec(∂r, X) = -j''/j. -/
noncomputable def radialSectionalCurvature (K r : ℝ) : ℝ :=
  - deriv (deriv (jacobiSol K)) r / jacobiSol K r

theorem radialSectionalCurvature_eq (K r : ℝ) (hr : jacobiSol K r ≠ 0) :
    radialSectionalCurvature K r = K := by
  -- from jacobiSol_ode
  have h := jacobiSol_ode K r  -- j'' + K j = 0
  unfold radialSectionalCurvature
  -- j'' = -K*j : linarith
  have hj : deriv (deriv (jacobiSol K)) r = -K * jacobiSol K r := by linarith
  rw [hj, neg_neg? ...]
  field_simp [hr]
