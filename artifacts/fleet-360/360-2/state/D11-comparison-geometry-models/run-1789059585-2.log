- difference: h1.sub h2: deriv = [p₁' j₂ + p₁ j₂'] - [p₁ j₂' + j₁ p₂'] = p₁'j₂ - j₁p₂' where p₁' = deriv (jacobiDeriv K₁) u = j₁''(u), p₂' = j₂''(u).
