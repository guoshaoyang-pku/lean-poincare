Curvature axioms:

```
/-- Radial sectional curvature K(∂r, X) = -j''/j of the warped product. -/
noncomputable def radialSectionalCurvature (K r : ℝ) : ℝ :=
  -deriv (deriv (jacobiSol K)) r / jacobiSol K r

/-- The radial curvature axiom reduces to the Jacobi ODE proved in D10. -/
theorem radialSectionalCurvature_eq (K r : ℝ) (hr : jacobiSol K r ≠ 0) :
    radialSectionalCurvature K r = K := by
  unfold radialSectionalCurvature
  have h := jacobiSol_ode K r  -- deriv (deriv (jacobiSol K)) r + K * jacobiSol K r = 0
  have h' : deriv (deriv (jacobiSol K)) r = -(K * jacobiSol K r) := by linarith
  rw [h']
  -- -(-(K*j))/j = K
  have h'' : -(-(K * jacobiSol K r)) = K * jacobiSol K r := neg_neg _
  rw [h'']
  field_simp [hr]
```

-(K*j)/j = K: field_simp [hr]; ring — after rw h'': goal: (K * jacobiSol K r) / jacobiSol K r = K: exact (mul_div_cancel₀ _ hr) ✓ — K*j/j = K ✓. So: rw [h'', mul_div_cancel₀]. ✓.

```
/-- Spherical sectional curvature K(X,Y) = (1 - j'²)/j² for X,Y tangent to the unit sphere. -/
noncomputable def sphericalSectionalCurvature (K r : ℝ) : ℝ :=
  (1 - jacobiDeriv K r ^ 2) / jacobiSol K r ^ 2

/-- The spherical curvature axiom reduces to the Wronskian j'² + Kj² = 1 (which itself follows
from the Jacobi ODE and initial conditions). -/
theorem sphericalSectionalCurvature_eq (K r : ℝ) (hr : jacobiSol K r ≠ 0) :
    sphericalSectionalCurvature K r = K := by
  unfold sphericalSectionalCurvature
  have h := jacobiSol_wronskian K r  -- j'² + K j² = 1
  have h' : 1 - jacobiDeriv K r ^ 2 = K * jacobiSol K r ^ 2 := by linarith
  rw [h']
  have hj2 : jacobiSol K r ^ 2 ≠ 0 := pow_ne_zero 2 hr
  field_simp [hj2]
```

