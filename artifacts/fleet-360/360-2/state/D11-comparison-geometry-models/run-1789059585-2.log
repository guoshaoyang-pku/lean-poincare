theorem modelMetric_symm (K : ℝ) (n : ℕ) (r : ℝ) (X Y : ModelTangent n) :
    modelMetric K n r X Y = modelMetric K n r Y X := by
  unfold modelMetric
  rw [real_inner_comm]
  ring? -- X.1*Y.1 + j²*⟨Y.2,X.2⟩ = Y.1*X.1 + j²*⟨X.2,Y.2⟩: mul_comm X.1 Y.1 + inner comm ✓

theorem modelMetric_add_left ... : modelMetric K n r (X + Y) Z = modelMetric K n r X Z + modelMetric K n r Y Z := by
  unfold modelMetric
  -- (X+Y).1 = X.1 + Y.1: simp
  -- inner (X+Y).2 Z.2 = inner X.2 Z.2 + inner Y.2 Z.2
  simp [inner_add_left, add_mul, mul_add, mul_add]
```

