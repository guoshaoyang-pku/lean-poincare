  have hpow : (4 * π * τ) ^ ((n : ℝ) / 2) * (4 * π * τ) ^ (-(n : ℝ) / 2) = 1 := by
    rw [← Real.rpow_add hbase, show (n : ℝ) / 2 + (-(n : ℝ) / 2) = 0 by ring, Real.rpow_zero]
