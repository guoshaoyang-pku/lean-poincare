    (P : LPath (euclideanFlow n) 0 x τ) (hmin : IsLMinimizer P) :
    ∀ σ ∈ Set.Icc (0 : ℝ) τ, P.curve σ = straightRay x τ σ := by
  have hτne : Real.sqrt τ ≠ 0 := ne_of_gt (Real.sqrt_pos.2 hτ)
