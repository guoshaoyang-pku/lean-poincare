def heatKernelReducedDistance (n : ℕ) (τ : ℝ) (x : EuclideanSpace ℝ (Fin n)) : ℝ :=
  -Real.log ((4 * π * τ) ^ ((n : ℝ) / 2) * Poincare.D10.HeatKernelEuclidean.gaussianKernel n τ x)
