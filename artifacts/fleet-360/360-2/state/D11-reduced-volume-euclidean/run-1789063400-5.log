  -- (2) the completing-the-square integral identity
  have hf : ∫ σ in (0 : ℝ)..τ,
      (Real.sqrt σ * ⟪P.velocity σ, P.velocity σ⟫ - 2 * ⟪c, P.velocity σ⟫ + ⟪c, c⟫ / Real.sqrt σ)
      = P.length - ‖x‖ ^ 2 / (2 * Real.sqrt τ) := by
    -- same as D7: integral split + hcross + hcq + hcc
    ... (adapt D7's hfint/hInvMul/hcq/hcc/hgoal)
