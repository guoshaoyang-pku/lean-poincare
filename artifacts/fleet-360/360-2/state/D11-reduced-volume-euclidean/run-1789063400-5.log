  simp [euclideanFlow]

@[simp] theorem euclideanFlow_metric (τ : ℝ) (x y : EuclideanSpace ℝ (Fin n)) :
    (euclideanFlow n).metric τ x y = ⟪x, y⟫ := by
  simp [euclideanFlow]
