/-- The completing-the-square deficit integrand along an admissible path. -/
def flatDeficit (c : EuclideanSpace ℝ (Fin n)) (v : ℝ → EuclideanSpace ℝ (Fin n)) (σ : ℝ) : ℝ :=
  Real.sqrt σ * ⟪v σ, v σ⟫ - 2 * ⟪c, v σ⟫ + ⟪c, c⟫ / Real.sqrt σ
```
