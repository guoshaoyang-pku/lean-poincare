theorem componentsOf_grow (seed) (pairs) :
    ∀ C ∈ (seed.image fun a => ({a} : Finset α)), C ⊆ (componentsOf seed pairs).biUnion id := by
  induction pairs with
  | nil => intro C hC; simpa [componentsOf] using fun x hx => by
      rw [mem_biUnion]; exact ⟨C, hC, hx⟩
  | cons ab tl ih =>
      intro C hC
      -- C ⊆ (foldl tl P0).biUnion id by ih; and that ⊆ mergePair-result biUnion by mergePair_subset
      have h1 := ih C hC
      have h2 : ∀ D ∈ tl.foldl (fun P ab => mergePair P ab.1 ab.2) (seed.image fun a => ({a} : Finset α)),
          D ⊆ (mergePair (tl.foldl ... ) ab.1 ab.2).biUnion id := mergePair_subset
      -- chain: C ⊆ (foldl tl).biUnion ⊆ (mergePair ...).biUnion
      intro x hx
      rcases h1 hx with ⟨D, hD, hxD⟩
      rcases h2 D hD hxD with ⟨E, hE, hxE⟩
      rw [mem_biUnion]
      exact ⟨E, hE, hxE⟩
```

