theorem same_block_of_pair (seed : Finset α) (pairs : List (α × α)) {x y : α}
    (hxy : (x, y) ∈ pairs) (hx : x ∈ seed) (hy : y ∈ seed) :
    ∃ C ∈ componentsOf seed pairs, x ∈ C ∧ y ∈ C := by
  rcases mem_split pairs hxy with ⟨l1, l2, rfl⟩
  let P0 : Finset (Finset α) := seed.image fun a => ({a} : Finset α)
  let P' : Finset (Finset α) := l1.foldl (fun P ab => mergePair P ab.1 ab.2) P0
  rcases grow_foldl P0 l1 {x} (by rw [mem_image]; exact ⟨x, hx, rfl⟩) with ⟨A, hA, hsubA⟩
  rcases grow_foldl P0 l1 {y} (by rw [mem_image]; exact ⟨y, hy, rfl⟩) with ⟨B, hB, hsubB⟩
  have hmerge : ∃ C1 ∈ mergePair P' x y, x ∈ C1 ∧ y ∈ C1 := by
    refine ⟨(P'.biUnion (fun s => if x ∈ s then s else ∅)) ∪
        (P'.biUnion (fun s => if y ∈ s then s else ∅)), ?_, ?_, ?_⟩
    · rw [mergePair]
      rw [mem_union]
      right
      simp
    · rw [mem_union]
      left
      rw [mem_biUnion]
      exact ⟨A, hA, by
        by_cases hh : x ∈ A
        · simpa [hh]
        · exact False.elim (hh (hsubA (by simp)))⟩
    · rw [mem_union]
      right
      rw [mem_biUnion]
      exact ⟨B, hB, by
        by_cases hh : y ∈ B
        · simpa [hh]
        · exact False.elim (hh (hsubB (by simp)))⟩
  rcases hmerge with ⟨C1, hC1, hxC1, hyC1⟩
  rcases same_block_preserved (mergePair P' x y) l2 ⟨C1, hC1, hxC1, hyC1⟩ with ⟨C, hC, hxC, hyC⟩
  refine ⟨C, ?_, hxC, hyC⟩
  change C ∈ (l1 ++ (x, y) :: l2).foldl (fun P ab => mergePair P ab.1 ab.2) P0
  simpa [componentsOf, List.foldl_append] using hC
```

