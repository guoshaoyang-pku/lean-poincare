    ∀ C ∈ P, ∃ C' ∈ mergePair P a b, C ⊆ C' := by
  intro C hC
  by_cases ha : a ∈ C
  · refine ⟨(P.biUnion (fun s => if a ∈ s then s else ∅)) ∪ (P.biUnion (fun s => if b ∈ s then s else ∅)), ?_, ?_⟩
    · rw [mergePair]; simp only [mem_union, mem_singleton, mem_filter, not_true_eq_false, false_and, or_false]; right; rfl
      -- hmm: the filter condition for the new block: a ∉ (ca ∪ cb) ∧ b ∉ (ca ∪ cb)?? the new block contains a: so it's NOT in the filter: it's the {ca ∪ cb} member: right; rfl ✓: but simp needs to know: the new block ∉ the filter: irrelevant (the right disjunct ✓)
    · intro x hx
      rw [mem_union]; left
      rw [mem_biUnion]
      exact ⟨C, hC, by simpa [ha] using hx⟩
  · by_cases hb : b ∈ C
    · refine ⟨(P.biUnion (fun s => if a ∈ s then s else ∅)) ∪ (P.biUnion (fun s => if b ∈ s then s else ∅)), ?_, ?_⟩
      · rw [mergePair]; simp only [mem_union, mem_singleton, mem_filter, not_true_eq_false, false_and, or_false]; right; rfl
      · intro x hx
        rw [mem_union]; right
        rw [mem_biUnion]
        exact ⟨C, hC, by simpa [hb] using hx⟩
    · refine ⟨C, ?_, by intro x hx; exact hx⟩
      rw [mergePair]
      simp only [mem_union, mem_singleton, mem_filter, true_and]
      left
      exact ⟨hC, ha, hb⟩
