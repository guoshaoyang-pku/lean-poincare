```lean
theorem mem_split (l : List α) {x : α} (h : x ∈ l) : ∃ l1 l2, l = l1 ++ x :: l2 := by
  induction l with
  | nil => cases h
  | cons y tl ih =>
      rw [mem_cons] at h
      rcases h with h | h
      · subst h
        exact ⟨[], tl, rfl⟩
      · rcases ih h with ⟨l1, l2, rfl⟩
        exact ⟨y :: l1, l2, rfl⟩
```

