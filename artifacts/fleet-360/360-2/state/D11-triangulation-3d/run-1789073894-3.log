```lean
theorem componentsOf_blocks_connected (seed : Finset α) (pairs : List (α × α))
    (hseed : ∀ p ∈ pairs, p.1 ∈ seed ∧ p.2 ∈ seed) :
    ∀ C ∈ componentsOf seed pairs, ∀ x ∈ C, ∀ y ∈ C, PairConnected pairs x y := by
  induction pairs with
  | nil =>
      intro C hC x hx y hy
      simp [componentsOf] at hC
      rcases hC with ⟨z, hz, rfl⟩
      simp at hx hy
      rw [hx, hy]
      exact Relation.ReflTransGen.refl
  | cons ab tl ih =>
      intro C hC x hx y hy
      have hseeds : ∀ p ∈ tl, p.1 ∈ seed ∧ p.2 ∈ seed := fun p hp => hseed p (by simp [hp])
      have := mergePair_connected (pairs := tl)
        (P := tl.foldl (fun P ab => mergePair P ab.1 ab.2) (seed.image fun a => ({a} : Finset α)))
        (a := ab.1) (b := ab.2) (hP := ih hseeds)
      simpa [componentsOf] using this C hC x hx y hy
```

