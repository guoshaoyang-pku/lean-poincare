```lean
def boundaryVertexClassesList (T : FacePairing3 N) : List (Finset (Corner N)) :=
  ((finsetToList T.boundaryFaces) =>> fun f =>
    ((List.finRange 4).filter (fun a => a ≠ f.i)).map (fun a => T.vertexClassOf f.t a))

def boundaryEdgeClassesList (T : FacePairing3 N) : List (Finset (Corner N)) :=
  ((finsetToList T.boundaryFaces) =>> fun f =>
    ((List.finRange 4) =>> fun a =>
      ((List.finRange 4).filter (fun b => b ≠ f.i ∧ a ≠ b ∧ a < b)).map fun b =>
        T.edgeClassOf f.t a b))

def boundaryChi (T : FacePairing3 N) : ℤ :=
  ((boundaryVertexClassesList T).eraseDups).length -
    ((boundaryEdgeClassesList T).eraseDups).length + (T.boundaryFaces.card : ℤ)
```
