/-! ## Vertex links and edge links (pair-based, correct for generalized triangulations) -/

/-- A **link vertex** of a vertex class: a corner together with one of the three edges
through it (the edge `{corner.j, other}`). -/
structure CornerEdge (N : ℕ) where
  corner : Corner N
  other : Fin 4
  deriving DecidableEq, Fintype

def cornerEdgeFin (ce : CornerEdge N) : Fin (N * 16) :=
  ⟨cornerFin ce.corner * 4 + ce.other.val, by
    have h : cornerFin ce.corner * 4 + ce.other.val < N * 16 := by
      have hc : cornerFin ce.corner < N * 4 := Fin.isLt _
      have ho : ce.other.val < 4 := Fin.isLt _
      nlinarith
    exact h⟩
```

