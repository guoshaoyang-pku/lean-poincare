      omega⟩

@[simp]
theorem facetVertex_positionInFacet (i : Fin 5) (v : Fin 5) (h : v ≠ i) :
    facetVertex i (positionInFacet i v h) = v := by
  ext
  by_cases hv : v.val < i.val
  · simp [facetVertex, positionInFacet, hv]
  · have : i.val < v.val := by omega
    simp [facetVertex, positionInFacet, hv]
    omega

@[simp]
