def linkFaceIsTriangle (T : FacePairing3 N) (C : Finset (Corner N)) (c : Corner N) : Prop :=
  ((List.finRange 4).filter (fun i => i ≠ c.j) |>.map fun i =>
      T.vertexLinkEdgeClassOf C (⟨⟨c.t, i⟩, c.j⟩) |>.eraseDup).length = 3 ∧
  ((List.finRange 4).filter (fun k => k ≠ c.j) |>.map fun k =>
      T.vertexLinkVertexClassOf C (⟨⟨c.t, c.j⟩, k⟩) |>.eraseDup).length = 3
