/-! ## Links (pair-based) -/

structure CornerEdge (N : ℕ) where
  corner : Corner N
  other : Fin 4
  deriving DecidableEq, Fintype

structure FaceCorner (N : ℕ) where
  face : Face N
  corner : Fin 4
  deriving DecidableEq, Fintype

structure FaceOcc (N : ℕ) where
  face : Face N
  a : Fin 4
  b : Fin 4
  deriving DecidableEq, Fintype

structure ArcOcc (N : ℕ) where
  t : Fin N
  a : Fin 4
  b : Fin 4
  deriving DecidableEq, Fintype
```

