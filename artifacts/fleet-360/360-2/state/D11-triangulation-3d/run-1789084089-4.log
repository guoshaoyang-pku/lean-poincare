/-- The pairing is **orientable**: there is a choice of signs on the tetrahedra making every
gluing orientation-reversing between the induced boundary orientations. -/
def Orientable (T : FacePairing3 N) : Prop :=
  ∃ σ : Fin N → Bool, ∀ t i, match T.glue t i with
  | none => True
  | some (t', g) =>
      σ t = (if decide (facePermSign i g ≠ (-1 : ℤ) ^ (i.val + (g i).val + 1)) then !(σ t') else σ t')
```
