Edge incidence (for the sphere): the number of link faces adjacent to a link-edge class:
```lean
def linkEdgeIncidence (T : FacePairing3 N) (C : Finset (Corner N))
    (ec : Finset (FaceCorner N)) : ℕ :=
  (vertexLinkCorners T C).filter (fun c =>
    ((List.finRange 4).filter (fun i => i ≠ c.j) |>.map fun i =>
        (⟨⟨c.t, i⟩, c.j⟩ : FaceCorner N)).any (fun fc => fc ∈ ec)).length
```

Connectivity:
```lean
def linkConnected (T : FacePairing3 N) (C : Finset (Corner N)) : Prop :=
  let corners := vertexLinkCorners T C
  let pairs : List (Corner N × Corner N) :=
    corners =>> fun c1 =>
    corners =>> fun c2 =>
      if c1 ≠ c2 ∧ ((List.finRange 4).filter (fun i => i ≠ c1.j) |>.map fun i =>
          (⟨⟨c1.t, i⟩, c1.j⟩ : FaceCorner N)).any (fun fc =>
            ((List.finRange 4).filter (fun i2 => i2 ≠ c2.j) |>.map fun i2 =>
              (⟨⟨c2.t, i2⟩, c2.j⟩ : FaceCorner N)).any (fun fc2 =>
                T.vertexLinkEdgeClassOf C fc = T.vertexLinkEdgeClassOf C fc2)) then
        [(c1, c2)] else []
  (componentsOf corners.toFinset pairs).card = 1
```

VertexLinkIsSphere:
```lean
def VertexLinkIsSphere (T : FacePairing3 N) (C : Finset (Corner N)) : Prop :=
  (∀ c ∈ vertexLinkCorners T C, linkFaceIsTriangle T C c) ∧
  (∀ ec ∈ T.vertexLinkEdgeClasses C, linkEdgeIncidence T C ec = 2) ∧
  linkConnected T C ∧
  ((T.vertexLinkVertexClasses C).card : ℤ) - ((T.vertexLinkEdgeClasses C).card : ℤ)
    + ((vertexLinkCorners T C).length : ℤ) = 2
```

VertexLinkIsDisk:
```lean
def VertexLinkIsDisk (T : FacePairing3 N) (C : Finset (Corner N)) : Prop :=
  let ones := (T.vertexLinkEdgeClasses C).filter (fun ec => linkEdgeIncidence T C ec = 1)
  (∀ c ∈ vertexLinkCorners T C, linkFaceIsTriangle T C c) ∧
  (∀ ec ∈ T.vertexLinkEdgeClasses C, linkEdgeIncidence T C ec ≤ 2) ∧
  ones.Nonempty ∧
  (∀ vc ∈ T.vertexLinkVertexClasses C,
    (ones.filter (fun ec => (finsetToList ec).any (fun fc =>
      let e1 := linkEdgeEndpoint1 fc
      let e2 := linkEdgeEndpoint2 fc
      T.vertexLinkVertexClassOf C e1 = vc ∨ T.vertexLinkVertexClassOf C e2 = vc)).card = 0 ∨
    (ones.filter (fun ec => ...)).card = 2) ∧
  -- boundary cycle connectivity: the one-edges connect vertex classes; the graph on
  -- vertex classes with pairs (v1, v2) from one-edge endpoints: connected
  (let pairs : List (Finset (CornerEdge N) × Finset (CornerEdge N)) :=
    (finsetToList ones) =>> fun ec =>
      match finsetToList ec with
      | [fc] => [((T.vertexLinkVertexClassOf C (linkEdgeEndpoint1 fc)),
                  (T.vertexLinkVertexClassOf C (linkEdgeEndpoint2 fc)))]
      | _ => []
    (componentsOf (T.vertexLinkVertexClasses C).filter ... pairs).card = 1) ∧
  linkConnected T C ∧
  ((T.vertexLinkVertexClasses C).card : ℤ) - ((T.vertexLinkEdgeClasses C).card : ℤ)
    + ((vertexLinkCorners T C).length : ℤ) = 1
```

