```lean
/-- The face occurrences through the edge class E: (face (t,i), edge {a,b} ⊆ face). -/
def edgeLinkFaceOccs (T : FacePairing3 N) (E : Finset (Corner N)) : List (FaceOcc N) :=
  (List.finRange N) =>> fun t =>
  (List.finRange 4) =>> fun a =>
  (List.finRange 4).filter (fun b => b ≠ a) =>> fun b =>
    if ({⟨t, a⟩, ⟨t, b⟩} : Finset (Corner N)) ∈ E then
      (List.finRange 4).filter (fun i => i ≠ a ∧ i ≠ b) |>.map fun i =>
        (⟨⟨t, i⟩, a, b⟩ : FaceOcc N)
    else []

def edgeLinkFaceOccPairs (T : FacePairing3 N) : List (FaceOcc N × FaceOcc N) :=
  (List.finRange N) =>> fun t =>
  (List.finRange 4) =>> fun i =>
    match T.glue t i with
    | none => []
    | some (t', g) =>
      (List.finRange 4).filter (fun a => a ≠ i) =>> fun a =>
      (List.finRange 4).filter (fun b => b ≠ i ∧ b ≠ a) |>.map fun b =>
        ((⟨⟨t, i⟩, a, b⟩ : FaceOcc N), (⟨⟨t', g i⟩, g a, g b⟩ : FaceOcc N))

def edgeLinkFaceClasses (T : FacePairing3 N) (E : Finset (Corner N)) :
    Finset (Finset (FaceOcc N)) :=
  componentsOf (edgeLinkFaceOccs T E).toFinset (edgeLinkFaceOccPairs T)
```

