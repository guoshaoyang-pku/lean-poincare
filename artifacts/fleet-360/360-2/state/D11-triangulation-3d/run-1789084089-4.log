def facetVertex (i : Fin 5) (j : Fin 4) : Fin 5 :=
  ⟨if j.val < i.val then j.val else j.val + 1, by
    by_cases h : j.val < i.val
    · omega
    · omega⟩

theorem facetVertex_ne (i : Fin 5) (j : Fin 4) : facetVertex i j ≠ i := by
  apply Fin.ne_of_val_ne
  by_cases h : j.val < i.val
  · simp [facetVertex, h]; omega
  · simp [facetVertex, h]; have : i.val + 1 ≤ 5 := by omega; omega

theorem facetVertex_injective (i : Fin 5) :
    Function.Injective (facetVertex i) := by
  intro j1 j2 h
  apply Fin.ext
  apply congrArg Fin.val at h  -- hmm: h : facetVertex i j1 = facetVertex i j2: congrArg Fin.val h : vals equal
  ... by_cases on j1.val < i.val, j2.val < i.val ... omega

def positionInFacet (i : Fin 5) (v : Fin 5) (h : v ≠ i) : Fin 4 :=
  ⟨if v.val < i.val then v.val else v.val - 1, by
    by_cases hv : v.val < i.val
    · omega
