variable {N : ℕ}

/-- The corners of the vertex class C as a list. -/
def vertexLinkCorners (T : FacePairing3 N) (C : Finset (Corner N)) : List (Corner N) :=
  (List.finRange N) =>> fun t =>
  (List.finRange 4).map fun j => (⟨t, j⟩ : Corner N)
  |> List.filter (fun c => c ∈ C)
```
Hmm: no `|>` in Lean? There is `|>` in Lean 4 ✓ (Function pipeline). OK.

```lean
/-- The link vertices of C: pairs (corner c, edge {c.j, k}) with c ∈ C, k ≠ c.j. -/
def vertexLinkVertices (T : FacePairing3 N) (C : Finset (Corner N)) : List (CornerEdge N) :=
  (List.finRange N) =>> fun t =>
  (List.finRange 4) =>> fun j =>
  (List.finRange 4).filter (fun k => k ≠ j) |>.map fun k =>
    (⟨⟨t, j⟩, k⟩ : CornerEdge N)
  |> List.filter (fun ce => ce.corner ∈ C)
```
Careful: `=>>` is the local flatMap notation. The flatMap over `fun j => ...` then the filter: the filter applies to the whole list ✓.

```lean
/-- The identification pairs of link vertices coming from face gluings. -/
def vertexLinkVertexPairs (T : FacePairing3 N) : List (CornerEdge N × CornerEdge N) :=
  (List.finRange N) =>> fun t =>
  (List.finRange 4) =>> fun i =>
    match T.glue t i with
    | none => []
    | some (t', g) =>
      (List.finRange 4).filter (fun j => j ≠ i) =>> fun j =>
      (List.finRange 4).filter (fun k => k ≠ i ∧ k ≠ j) |>.map fun k =>
        ((⟨⟨t, j⟩, k⟩ : CornerEdge N), (⟨⟨t', g j⟩, g k⟩ : CornerEdge N))

def vertexLinkVertexClasses (T : FacePairing3 N) (C : Finset (Corner N)) :
    Finset (Finset (CornerEdge N)) :=
  componentsOf (vertexLinkVertices T C).toFinset (vertexLinkVertexPairs T)
```

Link edges:
```lean
def vertexLinkEdges (T : FacePairing3 N) (C : Finset (Corner N)) : List (FaceCorner N) :=
  (List.finRange N) =>> fun t =>
  (List.finRange 4) =>> fun i =>
  (List.finRange 4).filter (fun j => j ≠ i) |>.map fun j =>
    (⟨⟨t, i⟩, j⟩ : FaceCorner N)
  |> List.filter (fun fc => fc.corner ∈ C)

def vertexLinkEdgePairs (T : FacePairing3 N) : List (FaceCorner N × FaceCorner N) :=
  (List.finRange N) =>> fun t =>
  (List.finRange 4) =>> fun i =>
    match T.glue t i with
    | none => []
    | some (t', g) =>
      (List.finRange 4).filter (fun j => j ≠ i) |>.map fun j =>
        ((⟨⟨t, i⟩, j⟩ : FaceCorner N), (⟨⟨t', g i⟩, g j⟩ : FaceCorner N))

def vertexLinkEdgeClasses (T : FacePairing3 N) (C : Finset (Corner N)) :
    Finset (Finset (FaceCorner N)) :=
  componentsOf (vertexLinkEdges T C).toFinset (vertexLinkEdgePairs T)
```

