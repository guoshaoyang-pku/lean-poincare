def facetGlueFun (i : Fin 5) (j : Fin 4) (k : Fin 4) : Fin 4 :=
  if hk : k = j then
    positionInFacet (facetVertex i j) i (proof)
  else
    positionInFacet (facetVertex i j) (facetVertex i k) (proof)
```
Python: 
```
def position_in_facet(i5, v5): return v5 if v5 < i5 else v5-1  # for v != i
def facet_vertex(i, j): return j if j < i else j+1
def facet_glue_fun(i, j, k):
    i2 = facet_vertex(i, j)
    if k == j: v = i
    else: v = facet_vertex(i, k)
    return position_in_facet(i2, v)
```
