/-- The vertex of `Δ⁴` that the corner `k` of the facet opposite `i` is sent to by the gluing
of the face opposite corner `j`. -/
def facetGlueVertex (i : Fin 5) (j : Fin 4) (k : Fin 4) : Fin 5 :=
  if hk : k = j then i else facetVertex i k

theorem facetGlueVertex_ne (i : Fin 5) (j : Fin 4) (k : Fin 4) :
    facetGlueVertex i j k ≠ facetVertex i j := by
  by_cases hk : k = j
  · subst hk
    simp [facetGlueVertex]
    exact fun h => facetVertex_ne i j h.symm
  · simp [facetGlueVertex, hk]
    intro h
    exact hk (facetVertex_injective i h)
```

