          rcases ha with ⟨Ca, hCa, haCa⟩
          rcases grow_foldl P [⟨c,d⟩] Ca hCa with ⟨C', hC', hsub⟩   -- or use mergePair_grow directly
          exact ⟨C', by simpa using hC', hsub haCa⟩
        ...
        exact ih (mergePair P c d) ha' hb' hab
```
