```lean
import Poincare.D11.Triangulation3D.Models
import Poincare.D10.TriangulationLowDim.Complex

/-! # Bridge: a simplicial Δ-complex is a D10 finite abstract simplicial complex -/

namespace Poincare
namespace D11
namespace Triangulation3D

open FacePairing3
open Poincare.D10.TriangulationLowDim (FiniteAbstractSimplicialComplex)

variable {N : ℕ} {α : Type}

/-- The corners of a tetrahedron carry a labelling. -/
def IsSimplicialLabeling (T : FacePairing3 N) (lab : Corner N → α) : Prop :=
  (∀ p ∈ cornerPairs T, lab p.1 = lab p.2) ∧
  (∀ t : Fin N, Function.Injective fun j : Fin 4 => lab ⟨t, j⟩)

/-- The vertex set of a labelled tetrahedron: the images of its four corners. -/
def facetSet (lab : Corner N → α) (t : Fin N) : Finset α :=
  (Finset.univ : Finset (Fin 4)).image fun j => lab ⟨t, j⟩

/-- The faces of the simplicial complex induced by a labelling: the downward closure of the
labelled tetrahedra. -/
def inducedFaces (lab : Corner N → α) : Finset (Finset α) :=
  (Finset.univ : Finset (Fin N)).biUnion fun t => (facetSet lab t).powerset

theorem inducedFaces_downward_closed (lab : Corner N → α) :
    ∀ s ∈ inducedFaces lab, s.powerset ⊆ inducedFaces lab := by
  intro s hs
  rw [mem_biUnion] at hs
  rcases hs with ⟨t, _, hst⟩
  rw [mem_powerset] at hst
  intro u hu
  rw [mem_powerset] at hu
  rw [inducedFaces, mem_biUnion]
  exact ⟨t, mem_univ _, by rw [mem_powerset]; exact Subset.trans hu hst⟩

/-- The **induced finite abstract simplicial complex** (in the sense of D10) of a labelled
face pairing. -/
def inducedComplex (lab : Corner N → α) : FiniteAbstractSimplicialComplex α where
  faces := inducedFaces lab
  downward_closed := inducedFaces_downward_closed lab
```

