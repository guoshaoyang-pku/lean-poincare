```lean
/-
Copyright ...
-/
import Poincare.D11.Triangulation3D.Models
import Poincare.D10.TriangulationLowDim.Complex

/-!
# Bridge to the D10 finite abstract simplicial complex infrastructure

A labelled face pairing induces a finite abstract simplicial complex in the sense of
`Poincare.D10.TriangulationLowDim.FiniteAbstractSimplicialComplex`: the faces are the
downward closures of the vertex sets of the (labelled) tetrahedra.  For a *simplicial*
triangulation the two Euler characteristics agree; this file constructs the induced complex
and verifies the agreement for the two genuinely simplicial examples (`ball3`, `s3Simplex`).
-/

set_option maxRecDepth 1000000
set_option maxHeartbeats 2000000
set_option synthInstance.maxSize 4096

namespace Poincare
namespace D11
namespace Triangulation3D

open FacePairing3
open Poincare.D10.TriangulationLowDim (FiniteAbstractSimplicialComplex)

variable {N : ℕ} {α : Type}

/-- The corners of every tetrahedron are labelled, and the labelling is constant on the
corner identifications of the pairing. -/
def IsSimplicialLabeling [DecidableEq α] (T : FacePairing3 N) (lab : Corner N → α) : Prop :=
  (∀ p ∈ T.cornerPairs, lab p.1 = lab p.2) ∧
  (∀ t : Fin N, Function.Injective fun j : Fin 4 => lab ⟨t, j⟩)

/-- The vertex set of a labelled tetrahedron. -/
def facetSet [DecidableEq α] (lab : Corner N → α) (t : Fin N) : Finset α :=
  (Finset.univ : Finset (Fin 4)).image fun j => lab ⟨t, j⟩

/-- The faces of the induced complex: the downward closure of the labelled tetrahedra. -/
def inducedFaces [DecidableEq α] (lab : Corner N → α) : Finset (Finset α) :=
  (Finset.univ : Finset (Fin N)).biUnion fun t => (facetSet lab t).powerset

theorem inducedFaces_downward_closed [DecidableEq α] (lab : Corner N → α) :
    ∀ s ∈ inducedFaces lab, s.powerset ⊆ inducedFaces lab := by
  intro s hs
  rw [inducedFaces, Finset.mem_biUnion] at hs
  rcases hs with ⟨t, -, hst⟩
  rw [Finset.mem_powerset] at hst
  intro u hu
  rw [inducedFaces, Finset.mem_biUnion]
  exact ⟨t, Finset.mem_univ _, by rw [Finset.mem_powerset]; exact Subset.trans (Finset.mem_powerset.mp hu) hst⟩

/-- The **finite abstract simplicial complex induced by a labelled face pairing**. -/
def inducedComplex [DecidableEq α] (lab : Corner N → α) : FiniteAbstractSimplicialComplex α where
  faces := inducedFaces lab
  downward_closed := inducedFaces_downward_closed lab
```

Hmm, careful with `Finset.mem_powerset` naming: it's `Finset.mem_powerset : s ∈ t.powerset ↔ s ⊆ t` ✓ (used in D10's Complex.lean).

