/-! ## Executable checkers -/

/-- Executable checker: the pairing is consistent, orientation-reversing and closed. -/
def checkPairing (T : FacePairing3 N) : Bool :=
  decide (T.Consistent ∧ T.OrientationReversing ∧ T.Closed)

theorem checkPairing_eq_true_iff (T : FacePairing3 N) :
    checkPairing T = true ↔ T.Consistent ∧ T.OrientationReversing ∧ T.Closed := by
  simp [checkPairing]

/-- Executable checker for the closed combinatorial 3-manifold condition. -/
def checkClosedManifold (T : FacePairing3 N) : Bool := decide T.IsCombinatorialManifold

theorem checkClosedManifold_eq_true_iff (T : FacePairing3 N) :
    checkClosedManifold T = true ↔ T.IsCombinatorialManifold := by
  simp [checkClosedManifold]

/-- Executable checker for the combinatorial 3-manifold-with-boundary condition. -/
def checkManifoldWithBoundary (T : FacePairing3 N) : Bool :=
  decide T.IsCombinatorialManifoldWithBoundary

theorem checkManifoldWithBoundary_eq_true_iff (T : FacePairing3 N) :
    checkManifoldWithBoundary T = true ↔ T.IsCombinatorialManifoldWithBoundary := by
  simp [checkManifoldWithBoundary]
```

