    (ha : ∃ C ∈ P, a ∈ C) (hb : ∃ C ∈ P, b ∈ C) (hab : (a, b) ∈ l) :
    ∃ C ∈ l.foldl (fun P ab => mergePair P ab.1 ab.2) P, a ∈ C ∧ b ∈ C := by
  induction l generalizing P with
  | nil => exact absurd hab (List.not_mem_nil)
  | cons cd tl ih =>
      rcases cd with ⟨c, d⟩
      rw [List.mem_cons] at hab
      rcases hab with hab | hab
      · -- (a,b) = (c,d)
        subst hab
        have hmerge : ∃ C ∈ mergePair P c d, c ∈ C ∧ d ∈ C := by
          rcases ha with ⟨Ca, hCa, haCa⟩
          rcases hb with ⟨Cb, hCb, hbCb⟩
          refine ⟨(P.biUnion fun s => if c ∈ s then s else ∅) ∪ (P.biUnion fun s => if d ∈ s then s else ∅), ?_, ?_, ?_⟩
          · rw [mergePair]; exact mem_union_right _ (by simp)
          · rw [mem_union_left]; rw [mem_biUnion]; exact ⟨Ca, hCa, by simp [haCa]⟩
          · rw [mem_union_right]; rw [mem_biUnion]; exact ⟨Cb, hCb, by simp [hbCb]⟩
