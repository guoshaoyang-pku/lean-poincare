```lean
lemma nonneg_of_continuousOn_of_posOn_Ioo {u : ℝ → ℝ} {a b : ℝ} (hab : a < b)
    (hcont : ContinuousOn u (Icc a b)) (hpos : ∀ ⦃t : ℝ⦄, t ∈ Ioo a b → 0 < u t) :
    0 ≤ u b := by
  by_contra h
  have hbneg : u b < 0 := lt_of_not_ge h
  -- continuity at b within Icc a b: preimage of Iio 0 is a nhdsWithin; extract interval
  have hct : ContinuousWithinAt u (Icc a b) b := hcont (Set.right_mem_Icc.mpr hab.le)
  -- ContinuousWithinAt = Tendsto u (𝓝[Icc a b] b) (𝓝 (u b))
  have htend : Tendsto u (𝓝[Icc a b] b) (𝓝 (u b)) := hct
  -- Iio 0 is open, u b ∈ Iio 0
  have hev : ∀ᶠ t in 𝓝[Icc a b] b, u t < 0 := htend (isOpen_Iio.mem_nhds hbneg)
  rw [eventually_nhdsWithin_iff] at hev
  rcases hev with ⟨s, hsn, hs⟩
  -- s ∈ 𝓝 b: contains Icc (b−δ) (b+δ) for some δ>0... 
  rw [Metric.mem_nhds_iff] at hsn
  rcases hsn with ⟨δ, hδpos, hδsub⟩
  -- choose t := b − min δ/2 (b−a)/2 ∈ s ∩ Icc a b and t ∈ Ioo a b; contradiction
  let δ₀ := min (δ/2) ((b-a)/2)
  have hδ₀pos : 0 < δ₀ := lt_min (half_pos hδpos) (half_pos (sub_pos.mpr hab))
  let t := b - δ₀
  have htIoo : t ∈ Ioo a b := by
    have h₁ : t < b := sub_lt_self b hδ₀pos
    have h₂ : a < t := by
      have : δ₀ < b - a := lt_of_le_of_lt (min_le_right _ _) (half_lt_self (sub_pos.mpr hab))
      linarith
    exact ⟨h₂, h₁⟩
  have hts : t ∈ s := hδsub (by -- |t - b| < δ
      rw [abs_sub_comm]; -- |b - t| = δ₀ < δ
      ...)
  have htIcc : t ∈ Icc a b := Ioo_subset_Icc_self htIoo
  have hneg : u t < 0 := hs ⟨hts, htIcc⟩
  exact (not_lt.mpr (le_of_lt (hpos htIoo))) hneg
```
