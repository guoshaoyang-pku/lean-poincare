```lean
theorem riccati_le_of_initial {d k kbar m dm mbar dmbar : ℝ → ℝ} {a b : ℝ}
    (hab : a ≤ b) (hdpos : 0 < d)
    (hineq : ∀ ⦃t⦄, t ∈ Ioo a b → dm t + m t^2/d + k t ≤ 0)
    (heq : ∀ ⦃t⦄, t ∈ Ioo a b → dmbar t + mbar t^2/d + kbar t = 0)
    (hkk : ∀ ⦃t⦄, t ∈ Ioo a b → kbar t ≤ k t)
    (hm : ∀ ⦃t⦄, t ∈ Ioo a b → HasDerivAtR m (dm t) t)
    (hmbar : ∀ ⦃t⦄, t ∈ Ioo a b → HasDerivAtR mbar (dmbar t) t)
    (hmcont : ContinuousOn m (Icc a b)) (hmbarcont : ContinuousOn mbar (Icc a b))
    (hδa : m a ≤ mbar a) :
