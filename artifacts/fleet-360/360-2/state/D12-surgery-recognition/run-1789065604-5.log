-- versioned structure
structure ConnectedSumDecompositionV2 (X : Poincare.Longrun.Surgery.TopSpace.{0})
    (pieces : List (Poincare.Longrun.Surgery.TopSpace.{0})) where
  pieceSphere : ∀ P ∈ pieces, Nonempty (P.Carrier ≃ₜ S3)
  sumHomeo : Nonempty (X.Carrier ≃ₜ (iteratedSphereSum pieces pieceSphere).sum.Carrier)

-- the D7 constructor: closes sphere_of_spheres
def ConnectedSumDecomposition.mkV2 {X : TopSpace} {pieces : List TopSpace}
    (D : ConnectedSumDecompositionV2 X pieces)
    (relation : Prop) (relation_holds : relation)
    (simplyConnected_pieces : SimplyConnectedSpace X.Carrier → ∀ P ∈ pieces, SimplyConnectedSpace P.Carrier) :
    Poincare.D7.Recognition.ConnectedSumDecomposition X pieces where
  relation := relation
  relation_holds := relation_holds
  simplyConnected_pieces := simplyConnected_pieces
  sphere_of_spheres := by
    intro h
    -- pieces ≃ SphereThree (D7's SphereThree = S3 defeq)
    -- → iteratedSphereSum ≃ S3 (iteratedSphereSumHomeo)
    -- → X ≃ S3 via D.sumHomeo
```
