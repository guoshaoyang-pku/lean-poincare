```lean
import Poincare.D12.SurgeryRecognition.ConnectedSumTopology
import Poincare.D7.Recognition.Basic   -- the D7 target structures
import Poincare.Longrun.Topology.Basic -- SphereThree

-- The iterated sphere-sum: a List of TopSpaces each with a homeo to S³, glued by the
-- standard south disks transported through the homeos.
```

The recursion needs to carry: current sum space, a homeo sum ≃ S3, and the disk embedding into the current sum. Define:

```lean
structure SphericalPieceData (P : Poincare.Longrun.Surgery.TopSpace.{0}) where
  homeo : P.Carrier ≃ₜ S3

def transportedSouthDisk (h : P.Carrier ≃ₜ S3) : Ball3 → P.Carrier := fun x => h.symm (downS3 x)
```

Iterated sum:
```lean
def iteratedSphereSum : (pieces : List (Poincare.Longrun.Surgery.TopSpace.{0})) →
    (∀ P ∈ pieces, Nonempty (P.Carrier ≃ₜ S3)) → Poincare.Longrun.Surgery.TopSpace.{0}
  | [], _ => sphereSpace
  | P :: Ps, h =>
      let hs : ∀ Q ∈ Ps, Nonempty (Q.Carrier ≃ₜ S3) := fun Q hQ => h Q (by simp [hQ])
      let prev := iteratedSphereSum Ps hs
      let prevHomeo : Nonempty (prev.Carrier ≃ₜ S3) := iteratedSphereSumHomeo Ps hs
      connectedSum prev P (transportedSouthDisk prevHomeo.some) (transportedSouthDisk (h P (by simp)))
        (transportedSouthDisk_injective prevHomeo.some) (transportedSouthDisk_injective (h P (by simp)))
```
Hmm — mutually recursive def+theorem. In Lean, define a bundled version:

```lean
structure SphericalSum (pieces : List TopSpace) (h : ∀ P ∈ pieces, Nonempty (P.Carrier ≃ₜ S3)) where
  sum : TopSpace
  sumHomeo : Nonempty (sum.Carrier ≃ₜ S3)

def iteratedSphereSum : ... : SphericalSum pieces h
  | [], _ => ⟨sphereSpace, ⟨Homeomorph.refl _⟩⟩
  | P :: Ps, h =>
      let rec := iteratedSphereSum Ps (fun Q hQ => h Q (by simp [hQ]))
      let eP : Nonempty (P.Carrier ≃ₜ S3) := h P (by simp)
      ⟨connectedSum rec.sum P (transportedSouthDisk rec.sumHomeo.some)
          (transportedSouthDisk eP.some)
          (transportedSouthDisk_injective rec.sumHomeo.some)
          (transportedSouthDisk_injective eP.some),
        ⟨transportedHomeo ... ⟩⟩
```
