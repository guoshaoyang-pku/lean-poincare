```lean
def closedBallThree := Metric.closedBall (0 : ℝ³) 1  -- D³
def sphereTwoInR3 := Metric.sphere (0 : ℝ³) 1      -- S² = ∂D³

def glueRel : (closedBallThree ⊕ closedBallThree) → (closedBallThree ⊕ closedBallThree) → Prop
  | inl x, inl y => x = y
  | inl x, inr y => x = y ∧ x ∈ sphereTwoInR3   -- i.e. x.val ∈ sphere
  | inr x, inl y => x = y ∧ x ∈ sphereTwoInR3
  | inr x, inr y => x = y

theorem glueRel_equivalence : Equivalence glueRel

def DoubleBall := Quot glueRel

def upperHemisphereMap (x : closedBallThree) : 𝕊³ := ⟨(sqrt (1 - ‖x‖²), x.val), by ...⟩
def lowerHemisphereMap (x : closedBallThree) : 𝕊³ := ⟨(-sqrt (1 - ‖x‖²), x.val), by ...⟩
-- Both are ⟨(±√(1-‖x‖²), x)⟩ with ‖(±√(1-‖x‖²), x)‖² = (1-‖x‖²) + ‖x‖² = 1, need 1-‖x‖² ≥ 0 from x ∈ closedBall.

def doubleBallToSphere : DoubleBall → 𝕊³ := Quot.lift (fun z => match z with | inl x => upper x | inr x => lower x) well-defined
theorem doubleBallToSphere_continuous : Continuous doubleBallToSphere

def sphereToDoubleBall (y : 𝕊³) : DoubleBall :=
  Quot.mk glueRel (if 0 ≤ (y : ℝ⁴) 0 then inl ⟨y-proj, by membership⟩ else inr ⟨y-proj, ...⟩)
  -- y-proj : ℝ³ = the last 3 coords of y; need ‖y-proj‖ ≤ 1 from ‖y‖₄ = 1.
theorem sphereToDoubleBall_continuous : Continuous sphereToDoubleBall
-- via Continuous.if_le on (y : 𝕊³) ↦ (y : ℝ⁴) 0, both branches continuous, agreement when coord = 0 (i.e. y-proj ∈ S² → inl x = inr x by Quot.sound with rel... (x = y ∧ x ∈ S²) ✓)

theorem doubleBallToSphere_leftInverse : ... -- pointwise equality, case analysis
theorem sphereToDoubleBall_leftInverse : ... -- hmm, actually mutual inverses: need both composites = id

def doubleBallHomeoSphere : DoubleBall ≃ₜ 𝕊³
```

