```lean
def connectSumCongr {X Y X' Y' : Type} [TopologicalSpace X] ... 
    (eX : X ≃ₜ X') (eY : Y ≃ₜ Y')
    (fX : Ball3 → X) (fY : Ball3 → Y) (fX' : Ball3 → X') (fY' : Ball3 → Y')
    (hX' : fX' = eX ∘ fX) (hY' : fY' = eY ∘ fY)
    (hXinj : Function.Injective fX) (hYinj : Function.Injective fY) :
    Quot (connectSumRel fX fY) ≃ₜ Quot (connectSumRel fX' fY') :=
  quotientMapHomeo (e := puncturedHomeo eX ... .sumCongr (puncturedHomeo eY ...)) (h := ...)
```
