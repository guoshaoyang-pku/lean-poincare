/-- **A spherical space form model**: the unit `𝕊³` equipped with a free action of a finite
group `Γ` whose every element acts continuously; the orbit space is a spherical space form
candidate, recognized as a covering quotient of `𝕊³`. -/
structure SphericalSpaceFormModel where
  /-- The deck group. -/
  Γ : Type
  /-- Group structure on `Γ`. -/
  instGroup : Group Γ
  /-- `Γ` is finite. -/
  instFintype : Fintype Γ
  /-- The action of `Γ` on `𝕊³`. -/
  instMulAction : MulAction Γ S3
  /-- Each element of `Γ` acts continuously. -/
  instContinuous : ContinuousConstSMul Γ S3
  /-- The action is free: no nontrivial element has a fixed point. -/
  free : ∀ g (x : S3), g • x = x → g = 1

attribute [instance] SphericalSpaceFormModel.instGroup SphericalSpaceFormModel.instFintype
  SphericalSpaceFormModel.instMulAction SphericalSpaceFormModel.instContinuous
```
