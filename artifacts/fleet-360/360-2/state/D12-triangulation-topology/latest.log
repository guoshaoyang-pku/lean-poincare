```lean
/-- The gluing relation for two disks glued along their boundary by `h`. -/
def diskGlueRel (n : ℕ) (h : Sphere n ≃ₜ Sphere n) : DoubleDisk n → DoubleDisk n → Prop :=
  fun p q => p = q ∨
    (∃ x : Sphere n, p = Sum.inl (sphereToDisk n x) ∧ q = Sum.inr (sphereToDisk n (h x))) ∨
    (∃ x : Sphere n, p = Sum.inr (sphereToDisk n (h x)) ∧ q = Sum.inl (sphereToDisk n x))

abbrev DiskGlueQuot (n : ℕ) (h : Sphere n ≃ₜ Sphere n) : Type := Quot (diskGlueRel n h)
```

