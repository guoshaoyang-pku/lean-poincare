/-- Radial extension of a map of spheres to a map of disks: 0 ↦ 0, and
x ↦ ‖x‖ • φ(x/‖x‖) for x ≠ 0.  This is the "Alexander trick" extension along radii. -/
def radialExtend (φ : Sphere n → Sphere n) (x : Disk (n + 1)) : Disk (n + 1) :=
  if hx : (x : E) = 0 then ⟨0, by simp [mem_closedBall_iff_norm]⟩
  else
