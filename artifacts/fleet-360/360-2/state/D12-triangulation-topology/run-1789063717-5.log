lemma norm_sq_snoc (w : E (n+1)) (s : ℝ) : ‖Fin.snoc w s‖ ^ 2 = ‖w‖ ^ 2 + s ^ 2 := by
  rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
