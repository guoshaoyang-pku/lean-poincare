```lean
theorem simplexMin_lt_center_of_ne_center (n : ℕ) {x : SimplexFn n}
    (hx : (x : Fin (n + 2) → ℝ) ≠ fun _ => simplexCenter n) :
    (⨅ i : Fin (n + 2), (x : Fin (n + 2) → ℝ) i) < simplexCenter n := by
  have hm_le : (⨅ i : Fin (n + 2), (x : _) i) ≤ simplexCenter n := simplexMin_le_center n x
  have hm_ne : (⨅ i : Fin (n + 2), (x : _) i) ≠ simplexCenter n := by
    intro h
    -- m = c → all x_i = c → contradiction
    have hx' : (x : Fin (n + 2) → ℝ) = fun _ => simplexCenter n := by
      funext i
      have hle : simplexCenter n ≤ (x : _) i := h.symm.le.trans (ciInf_le (f := (x : _)) (Set.finite_range _ |>.bddBelow) i)
      have hsum : (∑ i : Fin (n + 2), ((x : _) i - simplexCenter n)) = 0 := by
        rw [Finset.sum_sub_distrib, x.2.2]
        rw [Finset.sum_const, Finset.card_fin, nsmul_eq_mul, simplexCenter_total n]
      have hnn : ∀ i : Fin (n + 2), 0 ≤ (x : _) i - simplexCenter n := fun i => sub_nonneg.mpr (hle i)
      have hzero := (Finset.sum_eq_zero_iff_of_nonneg (s := Finset.univ)
        (f := fun i : Fin (n + 2) => (x : _) i - simplexCenter n) hnn).1 hsum
      have hi : (x : _) i - simplexCenter n = 0 := hzero i (Finset.mem_univ i)
      exact sub_eq_zero.mp hi
    exact hx hx'
  exact lt_of_le_of_ne hm_le hm_ne
```
