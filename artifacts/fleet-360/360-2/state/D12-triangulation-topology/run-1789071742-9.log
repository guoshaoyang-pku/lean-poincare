    refine ⟨Quot.mk (simplexBoundaryConeRel n) (b, ⟨t, ht_mem⟩), ?_⟩
    apply Subtype.ext
    apply funext
    intro i
    dsimp [boundaryConeMapQuot, boundaryConeMap, b, t]
    -- goal: (1 - t) c + t (c + (x_i - c)/t) = x_i
    have htne : t ≠ 0 := ne_of_gt (simplexMaxTime_pos n x.2 hx)
    field_simp [htne]
    ring
