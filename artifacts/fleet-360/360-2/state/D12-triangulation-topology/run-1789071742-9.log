Right — the boundary-point formula involves t_max, so I need the time uniqueness first (or together). The t = t_max proof uses b ∈ boundary. So:

```lean
theorem simplexRadialTime_eq_of_radial_repr (n : ℕ) {x : SimplexFn n} {b : SimplexBoundaryFn n}
    {t : Set.Icc (0 : ℝ) 1} (ht : 0 < (t : ℝ))
    (hx : (x : Fin (n + 2) → ℝ) = simplexBoundaryConeMap n (b, t)) :
    (t : ℝ) = simplexRadialTime n x := by
  have hb_ge : ∀ i : Fin (n + 2), 0 ≤ (b : _) i := b.2.1
  rcases b.2.2.2 with ⟨i₀, hi₀⟩
  have hi₀' : 0 = (b : _) i₀ := hi₀.symm
  -- from hx: x_i = (1-t)c + t·b_i pointwise
  have hxi : ∀ i : Fin (n + 2), (x : _) i = (1 - (t : ℝ)) * simplexCenter n + (t : ℝ) * (b : _) i := fun i => congr_fun hx i
  -- derive t ≥ (c - x_i)/c for all i, i.e. c·t ≥ c - x_i:
  have hge : ∀ i : Fin (n + 2), simplexCenter n * (t : ℝ) ≥ simplexCenter n - (x : _) i := by
    intro i
    -- x_i = c - c·t + t·b_i; b_i ≥ 0 → x_i ≥ c - c·t → c·t ≥ c - x_i
    have hb_i : 0 ≤ (t : ℝ) * (b : _) i := mul_nonneg (le_of_lt ht) (hb_ge i)
    nlinarith [hxi i, hb_i]
  -- so c·t ≥ c - m (m the min):
  have hge_m : simplexCenter n * (t : ℝ) ≥ simplexCenter n - (⨅ i : Fin (n+2), (x : _) i) := by
    -- c - m ≤ c - x_i₀? m ≤ x_i₀ → c - x_i₀ ≤ c - m; and c·t ≥ c - x_i₀... need c·t ≥ c - m: m is the min: m ≤ x_i ∀i → c - x_i ≤ c - m ∀i; from hge i₀... no: need for the minimizer: hge at any i gives c·t ≥ c - x_i, and c - x_i ≥ c - m since x_i ≥ m ✓ (x_i ≥ m). So:
    have hm_le : (⨅ i : Fin (n+2), (x : _) i) ≤ (x : _) i₀ := ciInf_le (f := (x : _)) (Set.finite_range _ |>.bddBelow) i₀
    -- c·t ≥ c - x_i₀ ≥ c - m
    have hge_i₀ := hge i₀
    nlinarith [hge_i₀, hm_le]
  -- from b_i₀ = 0: x_i₀ = c - c·t → c·t = c - x_i₀ ≤ c - m → c·t ≤ c - m:
  have hle_m : simplexCenter n * (t : ℝ) ≤ simplexCenter n - (⨅ i : Fin (n+2), (x : _) i) := by
    -- x_i₀ = (1-t)c + t·0 = c - c·t
    have hx₀ : (x : _) i₀ = simplexCenter n - simplexCenter n * (t : ℝ) := by
      rw [hxi i₀, hi₀']
      ring
    have hm_le₀ : (⨅ i : Fin (n+2), (x : _) i) ≤ (x : _) i₀ := ciInf_le (f := (x : _)) (Set.finite_range _ |>.bddBelow) i₀
    nlinarith [hx₀, hm_le₀]
  have hct : simplexCenter n * (t : ℝ) = simplexCenter n - (⨅ i : Fin (n+2), (x : _) i) := le_antisymm hle_m hge_m
  -- divide by c > 0:
  have hc : 0 < simplexCenter n := simplexCenter_pos n
  calc
    (t : ℝ) = (simplexCenter n * (t : ℝ)) / simplexCenter n := by field_simp [ne_of_gt hc]
    _ = simplexRadialTime n x := by
      dsimp [simplexRadialTime]
      rw [hct]
```
Wait: `(simplexCenter n - m) / simplexCenter n` vs `(simplexCenter n * t) / simplexCenter n`: rw [hct] replaces `simplexCenter n * (t : ℝ)` with `c - m` ✓ giving `(c - m)/c` = rfl with simplexRadialTime ✓.

And boundary point equality:
```lean
theorem simplexBoundaryPoint_eq_of_radial_repr (n : ℕ) {x : SimplexFn n} {b : SimplexBoundaryFn n}
    {t : Set.Icc (0 : ℝ) 1} (ht : 0 < (t : ℝ))
    (hx : (x : Fin (n + 2) → ℝ) = simplexBoundaryConeMap n (b, t)) :
    (b : Fin (n + 2) → ℝ) = simplexBoundaryPoint n x := by
  have ht_eq := simplexRadialTime_eq_of_radial_repr n ht hx
  funext i
  have hxi : (x : _) i = (1 - (t : ℝ)) * simplexCenter n + (t : ℝ) * (b : _) i := congr_fun hx i
  calc
    (b : _) i = (simplexCenter n + ((x : _) i - simplexCenter n) / (t : ℝ)) := by
      -- from hxi: x_i = c - c·t + t·b_i → c + (x_i - c)/t = b_i
      nlinarith [hxi, ht, ... ] -- again division: prove t·b_i = c·t + x_i - c by nlinarith, then field_simp
      have hmul : (t : ℝ) * (b : _) i = simplexCenter n * (t : ℝ) + (x : _) i - simplexCenter n := by
        nlinarith [hxi]
      calc
        (b : _) i = ((t : ℝ) * (b : _) i) / (t : ℝ) := by field_simp [ne_of_gt ht]
        _ = (simplexCenter n * (t : ℝ) + (x : _) i - simplexCenter n) / (t : ℝ) := by rw [hmul]
        _ = simplexCenter n + ((x : _) i - simplexCenter n) / (t : ℝ) := by field_simp [ne_of_gt ht]; ring
    _ = simplexBoundaryPoint n x i := by
      dsimp [simplexBoundaryPoint]
      rw [ht_eq]
```

