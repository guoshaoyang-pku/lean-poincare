      funext j
      refine Fin.lastCases (n := n + 1) (motive := fun j => (x : Fin (n+2) → ℝ) j = simplexCenter n) ?_ ?_ j
      · -- last
        have hsum : (∑ i : Fin (n + 2), (x : Fin (n+2) → ℝ) i) = 1 := x.2.2
