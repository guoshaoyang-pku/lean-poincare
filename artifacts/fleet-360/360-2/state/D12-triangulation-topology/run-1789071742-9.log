Definitions:
```lean
def simplexRadialTime (n : ℕ) (x : SimplexFn n) : ℝ :=
  (simplexCenter n - ⨅ i : Fin (n + 2), (x : Fin (n + 2) → ℝ) i) / simplexCenter n

def simplexBoundaryPoint (n : ℕ) (x : SimplexFn n) : Fin (n + 2) → ℝ :=
  fun i => simplexCenter n + ((x : Fin (n + 2) → ℝ) i - simplexCenter n) / simplexRadialTime n x
```

Properties:
```lean
theorem simplexRadialTime_nonneg (n) (x) : 0 ≤ simplexRadialTime n x := by
  -- c - m ≥ 0 since m ≤ c
  have hm_le_c : (⨅ i : Fin (n+2), (x : _) i) ≤ simplexCenter n := by
    -- via average: (n+2) * m ≤ 1
    have hsum : (∑ i : Fin (n+2), (x : _) i) = 1 := x.2.2
    have hmul : ((n+2 : ℕ) : ℝ) * (⨅ i : Fin (n+2), (x : _) i) ≤ 1 := by
      calc
        ((n+2 : ℕ) : ℝ) * (⨅ i : Fin (n+2), (x : _) i)
            = ∑ i : Fin (n+2), (⨅ i : Fin (n+2), (x : _) i) := by
              rw [Finset.sum_const, Finset.card_fin, nsmul_eq_mul]
        _ ≤ ∑ i : Fin (n+2), (x : _) i := by
              exact Finset.sum_le_sum (fun i _ => ciInf_le (f := (x : Fin (n+2) → ℝ)) (Set.finite_range _ |>.bddBelow) i)
        _ = 1 := hsum
    calc
      (⨅ i : Fin (n+2), (x : _) i) ≤ ((n+2 : ℕ) : ℝ)⁻¹ := by
        -- multiply inequality by (n+2)⁻¹ ≥ 0
        have hc' : ((n+2 : ℕ) : ℝ)⁻¹ * (((n+2 : ℕ) : ℝ) * (⨅ i : Fin (n+2), (x : _) i)) ≤ ((n+2 : ℕ) : ℝ)⁻¹ * 1 :=
          mul_le_mul_of_nonneg_left hmul (inv_nonneg.mpr (Nat.cast_nonneg _))
        have hnz : ((n+2 : ℕ) : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by norm_num : n + 2 ≠ 0)
        rwa [← mul_assoc, inv_mul_cancel₀ hnz, one_mul, mul_one] at hc'
      _ = simplexCenter n := rfl
  exact div_nonneg (sub_nonneg.mpr hm_le_c) (le_of_lt (simplexCenter_pos n))

theorem simplexRadialTime_le_one (n) (x) : simplexRadialTime n x ≤ 1 := by
  -- m ≥ 0
  have hm_nonneg : 0 ≤ (⨅ i : Fin (n+2), (x : _) i) := le_ciInf (f := (x : Fin (n+2) → ℝ)) (fun i => x.2.1 i)
  -- (c - m)/c ≤ 1 ⇔ c - m ≤ c
  rw [div_le_iff₀ (simplexCenter_pos n)]
  exact sub_le_self _ (le_of_lt? no: c ≥ 0: sub_le_self (simplexCenter n) hm_nonneg — hmm: c - m ≤ c ⇔ -m ≤ 0 ⇔ m ≥ 0: exact sub_le_self (simplexCenter n) hm_nonneg
```
