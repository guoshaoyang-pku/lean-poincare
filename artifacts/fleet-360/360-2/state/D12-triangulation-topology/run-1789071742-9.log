theorem simplexFn_eq_center_of_trunc_eq_zero (n : ℕ) {x : Fin (n + 2) → ℝ}
    (hx : x ∈ simplexSet n) (hu : truncToCenter n x = 0) :
    x = fun _ => simplexCenter n := by
  have hf : (fun j : Fin (n + 1) => x j.castSucc - simplexCenter n) = 0 := by
    dsimp [truncToCenter] at hu
    exact congrArg (WithLp.equiv 2 (Fin (n + 1) → ℝ)) hu
  have hcast : ∀ j : Fin (n + 1), x j.castSucc = simplexCenter n := by
    intro j
    have hj : x j.castSucc - simplexCenter n = 0 := congr_fun hf j
    simpa [sub_eq_zero] using hj
  have hlast : x (Fin.last (n + 1)) = simplexCenter n := by
    have hsum : (∑ i : Fin (n + 2), x i) = 1 := hx.2
    rw [Fin.sum_univ_castSucc] at hsum
    have hsum' : (∑ j : Fin (n + 1), x j.castSucc) = ((n + 1 : ℕ) : ℝ) * simplexCenter n := by
      calc
        (∑ j : Fin (n + 1), x j.castSucc) = ∑ j : Fin (n + 1), simplexCenter n := by
          apply Finset.sum_congr rfl
          intro j hj
          exact hcast j
        _ = ((n + 1 : ℕ) : ℝ) * simplexCenter n := by
          simp [Finset.sum_const, nsmul_eq_mul]
    have hc : ((n + 2 : ℕ) : ℝ) * simplexCenter n = 1 := simplexCenter_total n
    have hsub : ((n + 2 : ℕ) : ℝ) * simplexCenter n - ((n + 1 : ℕ) : ℝ) * simplexCenter n = simplexCenter n := by
      have hnat : ((n + 2 : ℕ) : ℝ) - ((n + 1 : ℕ) : ℝ) = 1 := by norm_num [Nat.cast_add]
      nlinarith [hnat]
    calc
      x (Fin.last (n + 1)) = 1 - ((n + 1 : ℕ) : ℝ) * simplexCenter n := by linarith [hsum, hsum']
      _ = simplexCenter n := by linarith [hsub, hc]
  funext i
  refine Fin.lastCases (n := n + 1) (motive := fun i => x i = simplexCenter n) ?_ ?_ i
  · exact hlast
  · intro j
    exact hcast j
```
