```lean
theorem simplexBoundaryPoint_mem_of_ne_center (n : ℕ) {x : SimplexFn n}
    (hx : (x : Fin (n + 2) → ℝ) ≠ fun _ => simplexCenter n) :
    simplexBoundaryPoint n x ∈ simplexBoundarySet n := by
  change 0 ≤ simplexBoundaryPoint n x ∧ (∑ i, simplexBoundaryPoint n x i) = 1 ∧
    0 ∈ Set.range (simplexBoundaryPoint n x)
  have hc : 0 < simplexCenter n := simplexCenter_pos n
  have hm_lt : (⨅ i : Fin (n + 2), (x : _) i) < simplexCenter n :=
    simplexMin_lt_center_of_ne_center n hx
  have ht_pos : 0 < simplexRadialTime n x := by
    dsimp [simplexRadialTime]
    exact div_pos (sub_pos.mpr hm_lt) hc
  constructor
  · rw [Pi.le_def]
    intro i
    have hct : simplexCenter n * simplexRadialTime n x = simplexCenter n - (⨅ i : Fin (n + 2), (x : _) i) := by
      dsimp [simplexRadialTime]
      rw [mul_div_cancel₀ (ne_of_gt hc)]
    have hx_le : (⨅ i : Fin (n + 2), (x : _) i) ≤ (x : _) i :=
      ciInf_le (f := (x : _)) (Set.finite_range _ |>.bddBelow) i
    have hclear : 0 ≤ simplexCenter n * simplexRadialTime n x + ((x : _) i - simplexCenter n) := by
      rw [hct]
      exact sub_nonneg.mpr hx_le
    have hsumdiv : simplexCenter n + ((x : _) i - simplexCenter n) / simplexRadialTime n x =
        (simplexCenter n * simplexRadialTime n x + ((x : _) i - simplexCenter n)) /
          simplexRadialTime n x := by
      field_simp [ne_of_gt ht_pos]
      ring
    rw [hsumdiv]
    exact div_nonneg hclear (le_of_lt ht_pos)
  · constructor
    · -- sum = 1
      dsimp [simplexBoundaryPoint]
      rw [Finset.sum_add_distrib, Finset.sum_div]
      have hsumc : (∑ i : Fin (n + 2), simplexCenter n) = ((n + 2 : ℕ) : ℝ) * simplexCenter n := by
        rw [Finset.sum_const, Finset.card_fin, nsmul_eq_mul]
      have hsumd : (∑ i : Fin (n + 2), ((x : _) i - simplexCenter n)) =
          1 - ((n + 2 : ℕ) : ℝ) * simplexCenter n := by
        rw [Finset.sum_sub_distrib, x.2.2]
        rw [Finset.sum_const, Finset.card_fin, nsmul_eq_mul]
      rw [hsumc, hsumd, simplexCenter_total n]
      ring
    · -- 0 in range: at the min coordinate
      rcases exists_eq_ciInf_of_finite (f := (x : Fin (n + 2) → ℝ)) with ⟨i₀, hi₀⟩
      refine ⟨i₀, ?_⟩
      have htm : simplexRadialTime n x = (simplexCenter n - (x : _) i₀) / simplexCenter n := by
        dsimp [simplexRadialTime]
        rw [hi₀]
      have hct : simplexCenter n * simplexRadialTime n x = simplexCenter n - (x : _) i₀ := by
        rw [htm, mul_div_cancel₀ (ne_of_gt hc)]
      have hmul : simplexCenter n * simplexRadialTime n x + ((x : _) i₀ - simplexCenter n) = 0 := by
        rw [hct]
        ring
      calc
        simplexBoundaryPoint n x i₀ = (simplexCenter n * simplexRadialTime n x +
            ((x : _) i₀ - simplexCenter n)) / simplexRadialTime n x := by
          dsimp [simplexBoundaryPoint]
          field_simp [ne_of_gt ht_pos]
          ring
        _ = 0 := by rw [hmul, zero_div]
```
