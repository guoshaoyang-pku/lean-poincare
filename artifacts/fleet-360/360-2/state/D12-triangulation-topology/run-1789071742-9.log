    refine ⟨Quot.mk (simplexBoundaryConeRel n) (b₀, ⟨0, by norm_num⟩), ?_⟩
    apply Subtype.ext
    apply funext; intro i
    rw [hx]
    simp [boundaryConeMapQuot, boundaryConeMap]
  · -- non-center
    let b : SimplexBoundaryFn n := ⟨simplexBoundaryPoint n (x : Fin (n + 2) → ℝ), simplexBoundaryPoint_mem n x.2 hx⟩
    let t : ℝ := simplexMaxTime n (x : Fin (n + 2) → ℝ)
    have ht_mem : t ∈ Set.Icc (0 : ℝ) 1 := by
      constructor
      · exact le_of_lt (simplexMaxTime_pos n x.2 hx)
      · -- t ≤ 1: (c - m)/c ≤ 1 ⇔ c - m ≤ c ⇔ m ≥ 0 ✓ (x_i ≥ 0)
        dsimp [t, simplexMaxTime]
        rw [div_le_one (simplexCenter_pos n)]  -- a/b ≤ 1 ↔ a ≤ b when 0 < b ✓
