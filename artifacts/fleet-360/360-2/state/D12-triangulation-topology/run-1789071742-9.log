Injectivity:
```
theorem boundaryConeMapQuot_injective (n : ℕ) : Function.Injective (boundaryConeMapQuot n) := by
  intro a b h
  revert h b
  refine Quot.inductionOn a ?_
  intro p b h
  revert h
  refine Quot.inductionOn b ?_
  intro q hpq
  apply Quot.sound
  have hval' : boundaryConeMapQuot n (Quot.mk (simplexBoundaryConeRel n) p) = boundaryConeMapQuot n (Quot.mk (simplexBoundaryConeRel n) q) := hpq
  have hval : boundaryConeMap n p = boundaryConeMap n q := by
    simpa [boundaryConeMapQuot] using congrArg Subtype.val hval'
  by_cases ht0 : (p.2 : ℝ) = 0
  · right
    -- show q.2 = 0
    have hx : boundaryConeMap n p = fun _ => simplexCenter n := by
      apply funext; intro i; simp [boundaryConeMap, ht0]
    have hxq : boundaryConeMap n q = fun _ => simplexCenter n := by
      rw [← hval, hx]
    have ht' : (q.2 : ℝ) = 0 := by
      by_contra ht'
      have htpos : 0 < (q.2 : ℝ) := lt_of_le_of_ne q.2.2.1 (Ne.symm ht')
      -- b'_i = c for all i
      have hbc : ∀ i : Fin (n + 2), (q.1 : Fin (n + 2) → ℝ) i = simplexCenter n := by
        intro i
        have hi := congr_fun hxq i
        -- hi : (1 - q.2) c + q.2 (b' i) = c
