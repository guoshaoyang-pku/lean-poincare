have hy : (p.1 : EuclideanSpace ℝ (Fin (n+1))) = (q.1 : EuclideanSpace ℝ (Fin (n+1))) := by
  have htrunc : truncToCenter n (simplexConeMap n p) = truncToCenter n (simplexConeMap n q) := congrArg (truncToCenter n) hval
  rw [truncToCenter_simplexConeMap n p, truncToCenter_simplexConeMap n q] at htrunc
  -- htrunc : (tp * λp) • (p.1 : _) = (tq * λq) • (q.1 : _)
  have htp : (p.2 : ℝ) * simplexLambda n (p.1 : _) = (q.2 : ℝ) * simplexLambda n (q.1 : _) := by
    have hnp := norm_truncToCenter_simplexConeMap n p
    have hnq := norm_truncToCenter_simplexConeMap n q
    calc
      (p.2 : ℝ) * simplexLambda n (p.1 : _) = ‖truncToCenter n (simplexConeMap n p)‖ := hnp.symm
      _ = ‖truncToCenter n (simplexConeMap n q)‖ := by rw [htrunc]
      _ = (q.2 : ℝ) * simplexLambda n (q.1 : _) := hnq
  have htp_ne : (p.2 : ℝ) * simplexLambda n (p.1 : _) ≠ 0 := htp0  -- the by_cases assumption
  calc
    (p.1 : _) = ((p.2 : ℝ) * simplexLambda n (p.1 : _))⁻¹ • (((p.2 : ℝ) * simplexLambda n (p.1 : _)) • (p.1 : _)) := by
      rw [smul_smul, inv_mul_cancel₀ htp_ne, one_smul]
    _ = ((p.2 : ℝ) * simplexLambda n (p.1 : _))⁻¹ • (((q.2 : ℝ) * simplexLambda n (q.1 : _)) • (q.1 : _)) := by rw [htrunc]
    _ = (q.1 : _) := by rw [htp, smul_smul, inv_mul_cancel₀ (by simpa [htp] using htp_ne), one_smul]
```
