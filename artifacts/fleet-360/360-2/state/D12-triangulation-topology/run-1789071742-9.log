And simplexMin_le_center:
```lean
theorem simplexMin_le_center (n : ℕ) (x : SimplexFn n) :
    (⨅ i : Fin (n + 2), (x : Fin (n + 2) → ℝ) i) ≤ simplexCenter n := by
  have hsum : (∑ i : Fin (n + 2), (x : _) i) = 1 := x.2.2
  have hmul : ((n + 2 : ℕ) : ℝ) * (⨅ i : Fin (n + 2), (x : _) i) ≤ 1 := by
    calc
      ((n + 2 : ℕ) : ℝ) * (⨅ i : Fin (n + 2), (x : _) i)
          = ∑ i : Fin (n + 2), (⨅ i : Fin (n + 2), (x : _) i) := by
            rw [Finset.sum_const, Finset.card_fin, nsmul_eq_mul]
      _ ≤ ∑ i : Fin (n + 2), (x : _) i := by
            exact Finset.sum_le_sum (fun i _ =>
              ciInf_le (f := (x : Fin (n + 2) → ℝ)) (Set.finite_range _ |>.bddBelow) i)
      _ = 1 := hsum
  have hnz : ((n + 2 : ℕ) : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by norm_num : n + 2 ≠ 0)
  have hnonneg : 0 ≤ ((n + 2 : ℕ) : ℝ) := Nat.cast_nonneg _
  -- multiply: m ≤ 1 * (n+2)⁻¹ = c
  have hle : ((n + 2 : ℕ) : ℝ)⁻¹ * (((n + 2 : ℕ) : ℝ) * (⨅ i : Fin (n + 2), (x : _) i)) ≤
      ((n + 2 : ℕ) : ℝ)⁻¹ * 1 :=
    mul_le_mul_of_nonneg_left hmul (inv_nonneg.mpr hnonneg)
  rwa [← mul_assoc, inv_mul_cancel₀ hnz, one_mul, mul_one] at hle
```

