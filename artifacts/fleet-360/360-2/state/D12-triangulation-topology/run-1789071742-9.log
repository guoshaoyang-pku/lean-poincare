def simplexBoundaryConeRel (n : ℕ) : SimplexBoundaryFn n × Set.Icc (0 : ℝ) 1 → ... → Prop :=
  fun p q => p = q ∨ ((p.2 : ℝ) = 0 ∧ (q.2 : ℝ) = 0)
abbrev SimplexBoundaryConeQuot (n : ℕ) : Type := Quot (simplexBoundaryConeRel n)

def boundaryConeMap (n : ℕ) (p : SimplexBoundaryFn n × Set.Icc (0 : ℝ) 1) : Fin (n + 2) → ℝ :=
  fun i => (1 - (p.2 : ℝ)) * simplexCenter n + (p.2 : ℝ) * (p.1 : Fin (n + 2) → ℝ) i
```

