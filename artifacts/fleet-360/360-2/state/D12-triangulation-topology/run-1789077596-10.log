```
/-- **Uniform lower bound.** For unit a, b and s ∈ [0,1], `‖(1-s)•a + s•b‖² ≥ (4 - ‖a - b‖²)/4`. -/
theorem norm_segment_sq_lower_bound {a b : E} (ha : ‖a‖ = 1) (hb : ‖b‖ = 1) {s : ℝ}
    (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    (4 - ‖a - b‖ ^ 2) / 4 ≤ ‖(1 - s) • a + s • b‖ ^ 2 := by
  have hsq : ‖(1 - s) • a + s • b‖ ^ 2 = 1 - 2 * s * (1 - s) * (1 - ⟪a, b⟫_ℝ) := by
    calc ‖(1 - s) • a + s • b‖ ^ 2
        = (1 - s) ^ 2 + 2 * ((1 - s) * s) * ⟪a, b⟫_ℝ + s ^ 2 := by
            rw [norm_add_sq_real]; simp [norm_smul, inner_smul_left, inner_smul_right, ha, hb]
        _ = 1 - 2 * s * (1 - s) * (1 - ⟪a, b⟫_ℝ) := by ring
  have h1 : (1 - ⟪a, b⟫_ℝ) = ‖a - b‖ ^ 2 / 2 := by
    rw [norm_sub_sq_real, ha, hb]  -- norm_sub_sq_real: ‖x−y‖² = ‖x‖² − 2⟪x,y⟫ + ‖y‖² ✓
    ring
  have h2 : 2 * s * (1 - s) ≤ 1 / 2 := by
    nlinarith [mul_self_nonneg (2 * s - 1)]  -- 4s(1−s) ≤ 1 from (2s−1)² ≥ 0 ✓
  -- target: (4 - ‖a−b‖²)/4 ≤ 1 − 2s(1−s)(1−⟨a,b⟩)
  rw [hsq, h1]
  -- (4 - ‖a−b‖²)/4 = 1 − ‖a−b‖²/4 = 1 − (1−⟨a,b⟩)/2
  have : 2 * s * (1 - s) * (1 - ⟪a, b⟫_ℝ) ≤ (1 : ℝ) / 2 * (1 - ⟪a, b⟫_ℝ) := by
    -- 2s(1−s) ≤ 1/2 and (1−⟨a,b⟩) ≥ 0: (1−⟨a,b⟩) = ‖a−b‖²/2 ≥ 0 ✓
    have hnonneg : 0 ≤ 1 - ⟪a, b⟫_ℝ := by rw [h1]; positivity
    nlinarith
  nlinarith
```
