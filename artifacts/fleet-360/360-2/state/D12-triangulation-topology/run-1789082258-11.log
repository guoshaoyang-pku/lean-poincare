/-- Two unit vectors at distance `< 2` are never antipodal: the linear segment between them
avoids zero. -/
theorem convex_combo_ne_zero_of_lt_two {a b : E} (ha : ‖a‖ = 1) (hb : ‖b‖ = 1)
    (h : ‖a - b‖ < 2) {s : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) : (1 - s) • a + s • b ≠ 0 := by
  intro hz
  have hsmul : (1 - s) • a = -s • b := by
    exact eq_neg_of_add_eq_zero_left hz  -- hmm: (1-s)•a + s•b = 0 → (1-s)•a = -(s•b) ✓
  have hn : ‖(1 - s) • a‖ = ‖s • b‖ := by rw [hsmul, norm_neg]
  have hss : 1 - s = s := by
    rw [norm_smul, norm_smul, ha, hb, mul_one, mul_one] at hn
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (sub_nonneg.mpr hs1),
      abs_of_nonneg hs0] at hn
    linarith
  have hsum : a + b = 0 := by
    have hz' : (1 - s) • a + s • b = 0 := hz
    have : ((1 : ℝ) / 2) • a + ((1 : ℝ) / 2) • b = 0 := by
      -- from hss: 1−s = s and 1−s+s=1 ⟹ s = 1/2
      have hs : s = (1 : ℝ) / 2 := by linarith
      rw [hss, hs] at hz'  -- hz' : (1/2)•a + (1/2)•b = 0? rw [hss, hs] at hz' turns (1-s)•a into s•a → (1/2)•a ✓
      exact hz'
    have h2 : ((2 : ℝ) • ((1 / 2 : ℝ) • a + (1 / 2 : ℝ) • b)) = 0 := by rw [this]; simp
    have : a + b = ((2 : ℝ) • ((1 / 2 : ℝ) • a + (1 / 2 : ℝ) • b)) := by
      simp [smul_add]  -- 2•((1/2)•a) = (2*(1/2))•a = a — simp handles: 2 • ((1/2)•a) = a? smul_smul: (2:ℝ)•((1/2:ℝ)•a) = (2*(1/2))•a = 1•a = a — norm_num + smul_smul ✓
    rw [← this, h2]
  have hbneg : b = -a := eq_neg_of_add_eq_zero_left hsum
  have h2norm : ‖a - b‖ = 2 := by
    rw [hbneg, sub_neg_eq_add, ← two_smul ℝ a]
    -- a + a = 2 • a?  two_smul: 2 • a = a + a ✓
    simp [ha]  -- ‖2 • a‖ = 2 * ‖a‖ = 2 ✓ norm_smul: ‖(2:ℝ)•a‖ = |2|*‖a‖ = 2 ✓
  linarith
```
