```
theorem segChain_mem_spanUnion (γ : C(I, Sphere n)) (N : ℕ)
    (hseg : ∀ k : ℕ, ((clampedMap γ (k / N) : Sphere n) : E) ≠ -((clampedMap γ ((k + 1) / N) : Sphere n) : E))
    (m k : ℕ) (t : I) :
    ((segChain γ N hseg (m + 1) k t : Sphere n) : E) ∈
      ⋃ j ∈ Finset.range (m + 1), ((Submodule.span ℝ
        ({clampedMap γ ((k + j) / N), clampedMap γ ((k + j + 1) / N)} : Set E)) : Set E) := by
  induction m with
  | zero =>
      -- segChain γ N hseg 1 k = (segPiece γ N k (hseg k)).trans (refl cast)
