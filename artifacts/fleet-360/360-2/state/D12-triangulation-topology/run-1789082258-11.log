theorem trans_apply_extend {x y z : X} (p : Path x y) (q : Path y z) (t : I) :
    (p.trans q) t = if (t : ℝ) ≤ 1 / 2 then p.extend (2 * (t : ℝ)) else q.extend (2 * (t : ℝ) - 1) := by
  unfold Path.trans
  rfl
```
