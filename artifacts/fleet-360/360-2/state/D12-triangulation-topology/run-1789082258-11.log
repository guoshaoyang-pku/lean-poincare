/-- **C3. Piece homotopy.** The restriction piece is homotopic (rel endpoints) to the
straight segment piece: the normalized convex combination. -/
def pieceHomotopy (γ : C(I, Sphere n)) (N k : ℕ) (hN : N ≠ 0)
    (hseg : ∀ k : ℕ, ((clampedMap γ (k / N) : Sphere n) : E) ≠ -((clampedMap γ ((k + 1) / N) : Sphere n) : E))
    (hfine : ∀ t t' : I, dist t t' ≤ (1 / N : ℝ) → dist (γ t) (γ t') ≤ (1 / 4 : ℝ)) :
    Path.Homotopy (restrictionPiece γ N k) (segPiece γ N k (hseg k)) := by
  let a : C(I, Sphere n) := (restrictionPiece γ N k).toContinuousMap
  let b : C(I, Sphere n) := (segPiece γ N k (hseg k)).toContinuousMap
  let F : I × I → Sphere n := fun st =>
    ⟨((‖((1 - (st.1 : ℝ)) • (a st.2 : E) + (st.1 : ℝ) • (b st.2 : E)‖⁻¹)) •
      ((1 - (st.1 : ℝ)) • (a st.2 : E) + (st.1 : ℝ) • (b st.2 : E)),
      by
        -- norm = 1
        rw [mem_sphere_iff_norm, sub_zero, norm_smul, Real.norm_eq_abs]
        have hne : (1 - (st.1 : ℝ)) • (a st.2 : E) + (st.1 : ℝ) • (b st.2 : E) ≠ 0 := by
          exact convex_combo_ne_zero_of_lt_two (norm_eq_of_mem_sphere (a st.2))
            (norm_eq_of_mem_sphere (b st.2))
            (restrictionPiece_segPiece_dist_lt_two γ N k hN hseg hfine st.2) st.1.2.1 st.1.2.2
        have hpos : 0 < ‖...‖ := norm_pos_iff.mpr hne
        rw [abs_of_nonneg (le_of_lt (inv_pos.mpr hpos))]
        exact inv_mul_cancel₀ (ne_of_gt hpos)⟩
```
