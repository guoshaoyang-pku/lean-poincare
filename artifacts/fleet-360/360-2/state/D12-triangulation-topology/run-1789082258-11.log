```
def restrictionChain' (f : C(I, X)) (N : ℕ) : (m k : ℕ) → Path (clampedMap f (subdiv N k)) (clampedMap f (subdiv N (k + m)))
  | 0, k => (Path.refl (clampedMap f (subdiv N k))).cast rfl (by ...)
  | m + 1, k => { toContinuousMap := ⟨fun t : I =>
        if (t : ℝ) ≤ 1 / 2 then (restrictionPiece f N k).toContinuousMap ⟨2 * (t : ℝ), by ...⟩
