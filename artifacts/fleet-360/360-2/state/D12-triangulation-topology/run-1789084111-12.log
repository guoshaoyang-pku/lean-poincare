```lean
/-! ## C5: the per-piece homotopy between the restriction and the segment -/

section PieceHomotopy

variable {n : ℕ} {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- **C5 norm bound.** For unit `x`, `a` within `1/4` of `x` and `b` within `2/3` of `x`,
every convex combination `(1-s)•a + s•b` (`s ∈ [0,1]`) has norm at least `1/3`. -/
theorem norm_interp_ge_one_third {a b x : E} (hx : ‖x‖ = 1) (ha : ‖a - x‖ ≤ (1 / 4 : ℝ))
    (hb : ‖b - x‖ ≤ (2 / 3 : ℝ)) {s : ℝ} (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    (1 / 3 : ℝ) ≤ ‖(1 - s) • a + s • b‖ := by
  have hdecomp : (1 - s) • a + s • b = x + ((1 - s) • (a - x) + s • (b - x)) := by
    calc
      (1 - s) • a + s • b = (1 - s) • (x + (a - x)) + s • (x + (b - x)) := by
        congr 1 <;> simp [sub_add_cancel]
      _ = (1 - s) • x + s • x + ((1 - s) • (a - x) + s • (b - x)) := by
        rw [smul_add, smul_add]; abel
      _ = x + ((1 - s) • (a - x) + s • (b - x)) := by
        rw [← add_smul]; simp
  rw [hdecomp]
  have hw : ‖(1 - s) • (a - x) + s • (b - x)‖ ≤ 2 / 3 := by
