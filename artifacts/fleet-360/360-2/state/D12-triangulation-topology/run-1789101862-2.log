    Path.Homotopic (restrictionChain γ N m k₀) (segChain γ N hseg m k₀) := by
  induction m generalizing k₀ with
  | zero =>
      change Path.Homotopic (restrictionChain γ N 0 k₀) (segChain γ N hseg 0 k₀)
      -- both unfold to refl-casts; they're definitionally the same Path? restrictionChain 0 k₀ = (Path.refl (clampedMap γ (subdiv N k₀))).cast rfl (congrArg ... rfl)
