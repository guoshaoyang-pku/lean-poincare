      -- goal: Homotopic (restrictionChain γ N (m+1) k₀) (segChain γ N hseg (m+1) k₀)
      have hk₀ : k₀ + 1 ≤ N := by omega  -- from hN : k₀ + (m+1) ≤ N
      have htail : (k₀ + 1) + m ≤ N := by omega
      have H₀ := restrictionPieceHomotopicSegPiece γ N k₀ hk₀ hfine (hseg k₀)
      have H₁ := ih (k₀ + 1) htail
