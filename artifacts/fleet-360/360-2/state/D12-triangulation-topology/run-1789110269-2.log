/-! ## C5: the per-piece homotopy -/

section PerPiece

variable {n : ℕ}

/-- **Parameter distance.**  For `k + 1 ≤ N` and `N ≠ 0`, the restriction of a map to the
`k`-th piece stays within `1/N` of the `k`-th subdivision point. -/
theorem dist_restrictionPiece_left (γ : C(I, Sphere n)) (N k : ℕ) (hN : N ≠ 0) (hk : k + 1 ≤ N)
    (hsub : ∀ t t' : I, dist t t' ≤ (1 / N : ℝ) → dist (γ t) (γ t') ≤ (1 / 4 : ℝ)) (t : I) :
    dist (restrictionPiece γ N k t) (clampedMap γ (subdiv N k)) ≤ (1 / 4 : ℝ) := by
  have hNpos : (0 : ℝ) < N := by exact_mod_cast Nat.pos_of_ne_zero hN
  have hk' : (k : ℝ) + 1 ≤ (N : ℝ) := by exact_mod_cast hk
  have ht1 : (t : ℝ) ≤ 1 := t.2.2
  have ht0 : 0 ≤ (t : ℝ) := t.2.1
  have hmem1 : ((k : ℝ) + (t : ℝ)) / N ∈ Set.Icc (0 : ℝ) 1 := by
    constructor
    · positivity
    · rw [div_le_one hNpos]; linarith
  have hmem0 : (k : ℝ) / N ∈ Set.Icc (0 : ℝ) 1 := by
    constructor
    · positivity
    · rw [div_le_one hNpos]; linarith
  rw [restrictionPiece_apply, clampedMap_of_mem_Icc _ hmem1, clampedMap_of_mem_Icc _ hmem0,
    subdiv]
  refine le_trans (hsub _ _ ?_) le_rfl
  -- dist of the two interval points ≤ 1/N
  rw [Subtype.dist_eq, dist_eq_norm, Real.norm_eq_abs, div_sub_div_same, abs_of_nonneg (by positivity),
    div_le_div_iff_of_pos_right hNpos]
  linarith
```
