```lean
/-! ## C5: straight-line homotopies on the sphere -/

section SphereHomotopy

/-- Normalizing a nonzero vector gives a point of the unit sphere. -/
theorem normalize_mem_sphere {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {w : E} (hw : w ≠ 0) : (‖w‖⁻¹) • w ∈ Metric.sphere (0 : E) 1 := by
  rw [mem_sphere_iff_norm, sub_zero, norm_smul, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  exact inv_mul_cancel₀ (norm_ne_zero_iff.mpr hw)

/-- The straight interpolation between two unit vectors at distance at most `11/12` never
vanishes. -/
theorem interp_ne_zero {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    {a b : E} (ha : ‖a‖ = 1) (hd : ‖b - a‖ ≤ (11 / 12 : ℝ)) {s : ℝ} (hs0 : 0 ≤ s)
    (hs1 : s ≤ 1) : (1 - s) • a + s • b ≠ 0 := by
  intro h0
  have hrepr : (1 - s) • a + s • b = a + s • (b - a) := by module
  rw [hrepr] at h0
  have h1 : ‖a‖ ≤ ‖a + s • (b - a)‖ + ‖s • (b - a)‖ := by
    calc ‖a‖ = ‖(a + s • (b - a)) - s • (b - a)‖ := by rw [add_sub_cancel_right]
      _ ≤ ‖a + s • (b - a)‖ + ‖s • (b - a)‖ := norm_sub_le _ _
  rw [h0, norm_zero, zero_add, norm_smul, Real.norm_eq_abs, abs_of_nonneg hs0] at h1
  have h2 : s * ‖b - a‖ ≤ (11 / 12 : ℝ) := by
    calc s * ‖b - a‖ ≤ 1 * (11 / 12) := mul_le_mul hs1 hd (norm_nonneg _) (by norm_num)
      _ = 11 / 12 := by norm_num
  rw [ha] at h1
  linarith
```

