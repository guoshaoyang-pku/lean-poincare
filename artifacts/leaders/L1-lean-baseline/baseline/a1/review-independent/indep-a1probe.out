gibbsTerm_strictAnti : ∀ (c : ℝ), 1 ≤ c → StrictAnti (gibbsTerm c)
@gibbsTerm_step_lt : ∀ {c x u : ℝ}, 1 ≤ c → 0 < u → gibbsTerm c (x + u) < gibbsTerm c x
@perelmanF_step_lt : ∀ {ι : Type u_1} [inst : Fintype ι] (F : Poincare.Longrun.CurvatureODE.ReactionField ι)
  {c : ι → ℝ},
  (∀ (i : ι), 1 ≤ c i) →
    ∀ {h : ℝ},
      0 < h →
        ∀ {traj : ℕ → ι → ℝ},
          Poincare.Longrun.CurvatureODE.DiscreteEvolution F h traj →
            ∀ {n : ℕ} {i : ι}, 0 < F.eval (traj n) i → perelmanF c (traj (n + 1)) < perelmanF c (traj n)
'Poincare.Longrun.Evolution.gibbsTerm_strictAnti' depends on axioms: [propext, Classical.choice, Quot.sound]
'Poincare.Longrun.Evolution.gibbsTerm_step_lt' depends on axioms: [propext, Classical.choice, Quot.sound]
'Poincare.Longrun.Evolution.perelmanF_step_lt' depends on axioms: [propext, Classical.choice, Quot.sound]
