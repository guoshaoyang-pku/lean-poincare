  [patched] gibbsTerm_step_lt: theorem gibbsTerm_step_lt {c x u : ℝ} (hc : 1 ≤ c) (hu : 0 < u) : gibbsTerm c (x + u) < gibbsTerm c x :=

  [release] perelmanF_step_lt: theorem perelmanF_step_lt (F : ReactionField ι) {c : ι → ℝ} (hc : ∀ i, 1 < c i) {h : ℝ} (hh : 0 < h) {traj : ℕ → ι → ℝ} (ev : DiscreteEvolution F h traj) {n : ℕ} {i : ι} (hi : 0 < F.eval (traj n) i) : perelmanF c (traj (n + 1)) < perelmanF c (traj n) := by
