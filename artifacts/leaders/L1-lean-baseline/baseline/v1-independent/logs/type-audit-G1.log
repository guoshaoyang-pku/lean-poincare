  {inst : TopologicalSpace X} →
    {x₀ : X} →
      {ι : Type v} →
        {p q : HatcherLib.Loop x₀} →
          {cover : HatcherLib.PathConnectedOpenCover x₀ ι} →
            {F : HatcherLib.Path.Homotopy p q} →
              {P : Sort u_1} →
                {horizontalCells verticalCells : ℕ} →
                  {horizontalCut : Fin (horizontalCells + 1) → ↑unitInterval} →
                    {verticalCut : Fin (verticalCells + 1) → ↑unitInterval} →
                      {horizontalCut_zero : horizontalCut 0 = 0} →
                        {verticalCut_zero : verticalCut 0 = 0} →
                          {horizontalCut_one : horizontalCut (Fin.last horizontalCells) = 1} →
                            {verticalCut_one : verticalCut (Fin.last verticalCells) = 1} →
                              {horizontalCut_mono : Monotone horizontalCut} →
                                {verticalCut_mono : Monotone verticalCut} →
                                  {cellIndex : Fin horizontalCells → Fin verticalCells → ι} →
                                    {cell_subordinate :
                                        ∀ (i : Fin horizontalCells) (j : Fin verticalCells),
                                          Set.Icc (horizontalCut i.castSucc) (horizontalCut i.succ) ×ˢ
                                              Set.Icc (verticalCut j.castSucc) (verticalCut j.succ) ⊆
                                            ⇑F ⁻¹' cover.carrier (cellIndex i j)} →
                                      {vertexLabels : Fin (horizontalCells + 1) → Fin (verticalCells + 1) → Fin 3 → ι} →
                                        {vertex_image_mem :
                                            ∀ (i : Fin (horizontalCells + 1)) (j : Fin (verticalCells + 1)) (k : Fin 3),
                                              F (horizontalCut i, verticalCut j) ∈ cover.carrier (vertexLabels i j k)} →
                                          {incident_label :
                                              ∀ (i : Fin horizontalCells) (j : Fin verticalCells)
                                                (r : Fin (horizontalCells + 1)) (s : Fin (verticalCells + 1)),
                                                HatcherLib.VanKampenCellTouchesVertex i r →
                                                  HatcherLib.VanKampenCellTouchesVertex j s →
                                                    ∃ k, cellIndex i j = vertexLabels r s k} →
                                            {horizontalCells' verticalCells' : ℕ} →
                                              {horizontalCut' : Fin (horizontalCells' + 1) → ↑unitInterval} →
                                                {verticalCut' : Fin (verticalCells' + 1) → ↑unitInterval} →
                                                  {horizontalCut_zero' : horizontalCut' 0 = 0} →
                                                    {verticalCut_zero' : verticalCut' 0 = 0} →
                                                      {horizontalCut_one' :
                                                          horizontalCut' (Fin.last horizontalCells') = 1} →
                                                        {verticalCut_one' :
                                                            verticalCut' (Fin.last verticalCells') = 1} →
                                                          {horizontalCut_mono' : Monotone horizontalCut'} →
                                                            {verticalCut_mono' : Monotone verticalCut'} →
                                                              {cellIndex' :
                                                                  Fin horizontalCells' → Fin verticalCells' → ι} →
                                                                {cell_subordinate' :
                                                                    ∀ (i : Fin horizontalCells')
                                                                      (j : Fin verticalCells'),
                                                                      Set.Icc (horizontalCut' i.castSucc)
                                                                            (horizontalCut' i.succ) ×ˢ
                                                                          Set.Icc (verticalCut' j.castSucc)
                                                                            (verticalCut' j.succ) ⊆
                                                                        ⇑F ⁻¹' cover.carrier (cellIndex' i j)} →
                                                                  {vertexLabels' :
                                                                      Fin (horizontalCells' + 1) →
                                                                        Fin (verticalCells' + 1) → Fin 3 → ι} →
                                                                    {vertex_image_mem' :
                                                                        ∀ (i : Fin (horizontalCells' + 1))
                                                                          (j : Fin (verticalCells' + 1)) (k : Fin 3),
                                                                          F (horizontalCut' i, verticalCut' j) ∈
                                                                            cover.carrier (vertexLabels' i j k)} →
                                                                      {incident_label' :
                                                                          ∀ (i : Fin horizontalCells')
                                                                            (j : Fin verticalCells')
                                                                            (r : Fin (horizontalCells' + 1))
                                                                            (s : Fin (verticalCells' + 1)),
                                                                            HatcherLib.VanKampenCellTouchesVertex i r →
                                                                              HatcherLib.VanKampenCellTouchesVertex j
                                                                                  s →
                                                                                ∃ k,
                                                                                  cellIndex' i j =
                                                                                    vertexLabels' r s k} →
                                                                        { horizontalCells := horizontalCells,
                                                                              verticalCells := verticalCells,
                                                                              horizontalCut := horizontalCut,
                                                                              verticalCut := verticalCut,
                                                                              horizontalCut_zero := horizontalCut_zero,
                                                                              verticalCut_zero := verticalCut_zero,
                                                                              horizontalCut_one := horizontalCut_one,
                                                                              verticalCut_one := verticalCut_one,
                                                                              horizontalCut_mono := horizontalCut_mono,
                                                                              verticalCut_mono := verticalCut_mono,
                                                                              cellIndex := cellIndex,
                                                                              cell_subordinate := cell_subordinate,
                                                                              vertexLabels := vertexLabels,
                                                                              vertex_image_mem := vertex_image_mem,
                                                                              incident_label := incident_label } =
                                                                            { horizontalCells := horizontalCells',
                                                                              verticalCells := verticalCells',
                                                                              horizontalCut := horizontalCut',
                                                                              verticalCut := verticalCut',
                                                                              horizontalCut_zero := horizontalCut_zero',
                                                                              verticalCut_zero := verticalCut_zero',
                                                                              horizontalCut_one := horizontalCut_one',
                                                                              verticalCut_one := verticalCut_one',
                                                                              horizontalCut_mono := horizontalCut_mono',
                                                                              verticalCut_mono := verticalCut_mono',
                                                                              cellIndex := cellIndex',
                                                                              cell_subordinate := cell_subordinate',
                                                                              vertexLabels := vertexLabels',
                                                                              vertex_image_mem := vertex_image_mem',
                                                                              incident_label := incident_label' } →
                                                                          (horizontalCells = horizontalCells' →
                                                                              verticalCells = verticalCells' →
                                                                                horizontalCut ≍ horizontalCut' →
                                                                                  verticalCut ≍ verticalCut' →
                                                                                    cellIndex ≍ cellIndex' →
                                                                                      vertexLabels ≍ vertexLabels' →
                                                                                        P) →
                                                                            P
