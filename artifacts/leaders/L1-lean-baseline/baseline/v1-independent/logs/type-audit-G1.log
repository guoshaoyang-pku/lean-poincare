      ∀
        (hwell :
          ∀ (y : ↑(Poincare.D12.TriangulationTopology.Sphere n)),
            ↑(eA.symm (Poincare.D12.TriangulationTopology.sphereToDisk n y)) =
              ↑(eB.symm (Poincare.D12.TriangulationTopology.sphereToDisk n (h y))))
        (x : X),
        Quot.lift
            (fun p =>
              match p with
              | Sum.inl d => ↑(eA.symm d)
              | Sum.inr d => ↑(eB.symm d))
            ⋯
            (if hx : x ∈ A then Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inl (eA ⟨x, hx⟩))
            else Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inr (eB ⟨x, ⋯⟩))) =
          x
