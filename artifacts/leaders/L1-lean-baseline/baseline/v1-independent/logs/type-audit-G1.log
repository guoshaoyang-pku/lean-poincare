                                                                                            {contract_tensorProduct :
                                                                                                ∀
                                                                                                  (α β :
                                                                                                    TensorField 0 1),
                                                                                                  contract
                                                                                                      (tensorProduct α
                                                                                                        (sharp β)) =
                                                                                                    dualPairing α β} →
                                                                                              {metricTrace_metric :
                                                                                                  metricTrace metric =
