                      Poincare.D12.TensorMaximumBochner.Bochner.gamma d i j mm *
                    (dd.D (m.basis i)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u mm) +
                Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j *
                    Poincare.D12.TensorMaximumBochner.Bochner.gamma d i i mm *
