L1TYPE	Poincare.D7.HeatKernel.HeatKernelData.mk	{X : Type u_1} →
  [inst : TopologicalSpace X] →
    [inst_1 : MeasurableSpace X] →
      (volume : MeasureTheory.Measure X) →
        (dist : X → X → ℝ) →
          (dim C_up c_up C_lo c_lo : ℝ) →
            (kernel : X → X → ℝ → ℝ) →
              (laplacian : (X → ℝ) →ₗ[ℝ] X → ℝ) →
                (∀ (x : X), dist x x = 0) →
                  (∀ (x y : X), 0 ≤ dist x y) →
                    (∀ (x y : X), dist x y = dist y x) →
                      0 < c_up →
                        0 < c_lo →
                          0 ≤ C_up →
                            0 ≤ C_lo →
                              (∀ (x y : X) (t : ℝ), 0 ≤ kernel x y t) →
                                (∀ (x y : X) (t : ℝ),
                                    0 < t →
                                      kernel x y t ≤ C_up * t ^ (-(dim / 2)) * Real.exp (-dist x y ^ 2 / (c_up * t))) →
                                  (∀ (x y : X) (t : ℝ),
                                      0 < t →
                                        dist x y ≤ 1 →
                                          C_lo * t ^ (-(dim / 2)) * Real.exp (-dist x y ^ 2 / (c_lo * t)) ≤
                                            kernel x y t) →
                                    (∀ (x y : X) (t : ℝ), kernel x y t = kernel y x t) →
                                      (∀ (x y : X) (s t : ℝ),
                                          0 < s →
                                            0 < t →
                                              kernel x y (s + t) = ∫ (z : X), kernel x z s * kernel z y t ∂volume) →
                                        (∀ (x : X) (t : ℝ), 0 < t → ∫ (y : X), kernel x y t ∂volume = 1) →
                                          (∀ (x : X) (f : X → ℝ),
                                              Continuous f →
                                                Filter.Tendsto (fun t => ∫ (y : X), kernel x y t * f y ∂volume)
                                                  (nhdsWithin 0 (Set.Ioi 0)) (nhds (f x))) →
                                            (∀ (x y : X) (t : ℝ),
                                                0 < t →
                                                  HasDerivAt (fun s => kernel x y s)
                                                    (laplacian (fun z => kernel z y t) x) t) →
                                              Poincare.D7.HeatKernel.HeatKernelData X
