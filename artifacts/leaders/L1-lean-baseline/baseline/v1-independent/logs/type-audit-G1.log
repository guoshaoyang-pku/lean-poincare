                  (dd.D (m.basis i)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u mm) -
                Poincare.D12.TensorMaximumBochner.Bochner.cG d j i mm *
                  (dd.D (m.basis mm)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u i) -
              Poincare.D12.TensorMaximumBochner.Bochner.gamma d i j mm *
                (dd.D (m.basis i)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u mm) +
            Poincare.D12.TensorMaximumBochner.Bochner.gamma d i i mm *
              (dd.D (m.basis j)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u mm)) +
      ∑ i,
        ∑ k,
