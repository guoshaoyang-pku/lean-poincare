                      Poincare.D12.TensorMaximumBochner.Bochner.cG d i j mm *
                    (dd.D (m.basis i)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u mm) -
                  Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j *
                      Poincare.D12.TensorMaximumBochner.Bochner.cG d j i mm *
                    (dd.D (m.basis mm)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u i) -
                Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j *
                    Poincare.D12.TensorMaximumBochner.Bochner.gamma d i j mm *
                  (dd.D (m.basis i)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u mm) +
              Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j *
                  Poincare.D12.TensorMaximumBochner.Bochner.gamma d i i mm *
                (dd.D (m.basis j)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u mm)) +
          (∑ k,
              Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j *
                  Poincare.D12.TensorMaximumBochner.Bochner.gamma d i k j *
                (dd.D (m.basis i)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u k) -
            ∑ l,
              Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j *
                  Poincare.D12.TensorMaximumBochner.Bochner.gamma d i i l *
                (dd.D (m.basis l)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j)) -
        ∑ k,
          ∑ l,
            Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j *
                  Poincare.D12.TensorMaximumBochner.Bochner.gamma d i k j *
                Poincare.D12.TensorMaximumBochner.Bochner.gamma d i k l *
              Poincare.D12.TensorMaximumBochner.Bochner.ui dd u l +
      ∑ k,
        ∑ l,
          Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j *
                Poincare.D12.TensorMaximumBochner.Bochner.gamma d i i k *
              Poincare.D12.TensorMaximumBochner.Bochner.gamma d k j l *
            Poincare.D12.TensorMaximumBochner.Bochner.ui dd u l
