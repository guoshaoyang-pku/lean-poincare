                                                                            (A : TensorField r (s + 2)),
                                                                            metricTrace (a • A) = a • metricTrace A} →
                                                                        {flat_add :
                                                                            ∀ {r s : ℕ} (A B : TensorField (r + 1) s),
                                                                              flat (A + B) = flat A + flat B} →
                                                                          {flat_smul :
                                                                              ∀ {r s : ℕ} (a : ℝ)
                                                                                (A : TensorField (r + 1) s),
                                                                                flat (a • A) = a • flat A} →
                                                                            {sharp_add :
                                                                                ∀ {r s : ℕ}
                                                                                  (A B : TensorField r (s + 1)),
                                                                                  sharp (A + B) = sharp A + sharp B} →
                                                                              {sharp_smul :
                                                                                  ∀ {r s : ℕ} (a : ℝ)
