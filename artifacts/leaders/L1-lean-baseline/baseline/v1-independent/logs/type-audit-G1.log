          {cover : HatcherLib.PathConnectedOpenCover x₀ ι} →
            {F : HatcherLib.Path.Homotopy p q} →
              (horizontalCells verticalCells : ℕ) →
                (horizontalCut : Fin (horizontalCells + 1) → ↑unitInterval) →
