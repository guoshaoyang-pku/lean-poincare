  (verticalCut_mono : Monotone verticalCut) (cellLabel : Fin horizontalCells → Fin verticalCells → ι)
  (cell_subordinate :
    ∀ (i : Fin horizontalCells) (j : Fin verticalCells),
      Set.Icc (horizontalCut i.castSucc) (horizontalCut i.succ) ×ˢ
          Set.Icc (verticalCut j.castSucc) (verticalCut j.succ) ⊆
        ⇑F ⁻¹' cover.carrier (cellLabel i j))
  (horizontalCells_1 verticalCells_1 : ℕ) (horizontalCut_1 : Fin (horizontalCells_1 + 1) → ↑unitInterval)
  (verticalCut_1 : Fin (verticalCells_1 + 1) → ↑unitInterval) (horizontalCut_zero_1 : horizontalCut_1 0 = 0)
  (verticalCut_zero_1 : verticalCut_1 0 = 0) (horizontalCut_one_1 : horizontalCut_1 (Fin.last horizontalCells_1) = 1)
  (verticalCut_one_1 : verticalCut_1 (Fin.last verticalCells_1) = 1) (horizontalCut_mono_1 : Monotone horizontalCut_1)
  (verticalCut_mono_1 : Monotone verticalCut_1) (cellLabel_1 : Fin horizontalCells_1 → Fin verticalCells_1 → ι)
  (cell_subordinate_1 :
