                                                                                          a • dualPairing α β) →
                                                                                      (∀ {r s : ℕ}
                                                                                          (T : TensorField r (s + 1)),
                                                                                          flat (sharp T) = T) →
                                                                                        (∀ {r s : ℕ}
                                                                                            (T : TensorField (r + 1) s),
                                                                                            sharp (flat T) = T) →
                                                                                          (∀ (α β : TensorField 0 1),
                                                                                              contract
                                                                                                  (tensorProduct α
                                                                                                    (sharp β)) =
