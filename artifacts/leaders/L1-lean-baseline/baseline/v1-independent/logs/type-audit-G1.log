                                        HasDerivAt (fun s => (F.frame.repr (F.nabla s X Y)) i)
                                          ((F.frame.repr (connVel t X Y)) i) t) →
                                    (dirh : ℝ → V → V → V → ℝ) →
                                      (koszul :
                                          ∀ (t : ℝ) (X Y Z : V),
                                            2 * F.metricForm t (connVel t X Y) Z =
                                              dirh t X Y Z - h t (F.nabla t X Y) Z - h t Y (F.nabla t X Z) +
                                                          dirh t Y X Z -
                                                        h t (F.nabla t Y X) Z -
                                                      h t X (F.nabla t Y Z) -
                                                    dirh t Z X Y +
                                                  h t (F.nabla t Z X) Y +
                                                h t X (F.nabla t Z Y)) →
                                        motive
                                          { connVel := connVel, connVel_add₁ := connVel_add₁,
                                            connVel_smul₁ := connVel_smul₁, connVel_add₂ := connVel_add₂,
                                            connVel_smul₂ := connVel_smul₂, hasDeriv := hasDeriv, dirh := dirh,
                                            koszul := koszul }) →
                        motive t
