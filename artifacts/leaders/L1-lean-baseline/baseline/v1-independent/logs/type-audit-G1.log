          ∑ l,
            Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j *
                  Poincare.D12.TensorMaximumBochner.Bochner.gamma d i k j *
                Poincare.D12.TensorMaximumBochner.Bochner.gamma d i k l *
              Poincare.D12.TensorMaximumBochner.Bochner.ui dd u l +
      ∑ k,
        ∑ l,
          Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j *
                Poincare.D12.TensorMaximumBochner.Bochner.gamma d i i k *
