                                                            ∀ {r₁ s₁ r₂ s₂ : ℕ} (A A' : TensorField r₁ s₁)
                                                              (B : TensorField r₂ s₂),
                                                              tensorProduct (A + A') B =
                                                                tensorProduct A B + tensorProduct A' B} →
                                                          {tensorProduct_add_right :
                                                              ∀ {r₁ s₁ r₂ s₂ : ℕ} (A : TensorField r₁ s₁)
                                                                (B B' : TensorField r₂ s₂),
                                                                tensorProduct A (B + B') =
                                                                  tensorProduct A B + tensorProduct A B'} →
                                                            {tensorProduct_smul_left :
                                                                ∀ {r₁ s₁ r₂ s₂ : ℕ} (a : ℝ) (A : TensorField r₁ s₁)
                                                                  (B : TensorField r₂ s₂),
                                                                  tensorProduct (a • A) B = a • tensorProduct A B} →
                                                              {tensorProduct_smul_right :
                                                                  ∀ {r₁ s₁ r₂ s₂ : ℕ} (a : ℝ) (A : TensorField r₁ s₁)
                                                                    (B : TensorField r₂ s₂),
                                                                    tensorProduct A (a • B) = a • tensorProduct A B} →
                                                                {contract_add :
