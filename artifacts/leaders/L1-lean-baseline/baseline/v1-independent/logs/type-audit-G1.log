  (h : ↑(Poincare.D12.TriangulationTopology.Sphere n) ≃ₜ ↑(Poincare.D12.TriangulationTopology.Sphere n)),
  (∀ (x : X) (hx : x ∈ A),
      (fun x =>
            if hx : x ∈ A then Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inl (eA ⟨x, hx⟩))
            else Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inr (eB ⟨x, ⋯⟩)))
          x =
        Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inl (eA ⟨x, hx⟩))) →
    (∀ (x : X) (hxB : x ∈ B),
        x ∉ A →
          (fun x =>
                if hx : x ∈ A then Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inl (eA ⟨x, hx⟩))
                else Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inr (eB ⟨x, ⋯⟩)))
              x =
