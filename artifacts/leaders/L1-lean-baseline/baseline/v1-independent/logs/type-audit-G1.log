                                                                      contract (A + B) = contract A + contract B} →
                                                                  {contract_smul :
                                                                      ∀ {r s : ℕ} (a : ℝ)
                                                                        (A : TensorField (r + 1) (s + 1)),
                                                                        contract (a • A) = a • contract A} →
                                                                    {metricTrace_add :
