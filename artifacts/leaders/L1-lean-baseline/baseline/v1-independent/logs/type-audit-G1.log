      Set.Icc (horizontalCut_1 i.castSucc) (horizontalCut_1 i.succ) ×ˢ
          Set.Icc (verticalCut_1 j.castSucc) (verticalCut_1 j.succ) ⊆
        ⇑F ⁻¹' cover.carrier (cellLabel_1 i j)),
  ({ horizontalCells := horizontalCells, verticalCells := verticalCells, horizontalCut := horizontalCut,
        verticalCut := verticalCut, horizontalCut_zero := horizontalCut_zero, verticalCut_zero := verticalCut_zero,
        horizontalCut_one := horizontalCut_one, verticalCut_one := verticalCut_one,
        horizontalCut_mono := horizontalCut_mono, verticalCut_mono := verticalCut_mono, cellLabel := cellLabel,
        cell_subordinate := cell_subordinate } =
      { horizontalCells := horizontalCells_1, verticalCells := verticalCells_1, horizontalCut := horizontalCut_1,
        verticalCut := verticalCut_1, horizontalCut_zero := horizontalCut_zero_1,
        verticalCut_zero := verticalCut_zero_1, horizontalCut_one := horizontalCut_one_1,
        verticalCut_one := verticalCut_one_1, horizontalCut_mono := horizontalCut_mono_1,
        verticalCut_mono := verticalCut_mono_1, cellLabel := cellLabel_1, cell_subordinate := cell_subordinate_1 }) =
    (horizontalCells = horizontalCells_1 ∧
