                                                        (-dirichlet' (u' t) φ + ∫ (x : M), f' t x * φ x ∂μ') t} →
                                                {energy_identity' :
                                                    ∀ (t : ℝ),
                                                      HasDerivAt E'
                                                        (-2 * dirichlet' (u' t) (u' t) +
                                                          2 * ∫ (x : M), u' t x * f' t x ∂μ')
                                                        t} →
                                                  { μ := μ, u := u, f := f, E := E, dirichlet := dirichlet,
                                                        energy_eq := energy_eq, dirichlet_symm := dirichlet_symm,
                                                        dirichlet_nonneg := dirichlet_nonneg, testClass := testClass,
                                                        u_mem_testClass := u_mem_testClass,
                                                        weak_equation := weak_equation,
                                                        energy_identity := energy_identity } =
                                                      { μ := μ', u := u', f := f', E := E', dirichlet := dirichlet',
                                                        energy_eq := energy_eq', dirichlet_symm := dirichlet_symm',
                                                        dirichlet_nonneg := dirichlet_nonneg', testClass := testClass',
                                                        u_mem_testClass := u_mem_testClass',
                                                        weak_equation := weak_equation',
                                                        energy_identity := energy_identity' } →
                                                    (μ ≍ μ' →
                                                        u ≍ u' →
                                                          f ≍ f' →
                                                            E = E' →
                                                              dirichlet ≍ dirichlet' → testClass ≍ testClass' → P) →
                                                      P
