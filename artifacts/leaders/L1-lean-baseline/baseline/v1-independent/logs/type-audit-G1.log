      reason :=
        "no spectral theorem for the Laplace-Beltrami operator on a closed manifold, no eigenfunction expansion, and no Hille-Yosida generation of the heat semigroup" },
    { name := "B-D7-DIRAC-DELTA",
      reason :=
        "no Dirac delta distribution or distribution theory: the initial condition K -> δ_y cannot be stated as a distributional limit, only against continuous test functions" },
    { name := "B-D7-GAUSSIAN-BOUNDS",
      reason :=
        "no Gaussian upper/lower bounds, no Li-Yau differential Harnack inequality, and no heat kernel estimates on manifolds" },
    { name := "B-D7-MAXIMUM-PRINCIPLE",
