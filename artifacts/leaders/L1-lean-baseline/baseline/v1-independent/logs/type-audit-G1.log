                {h : ℝ → V → V → ℝ} →
                  {motive : F.LeviCivitaEvolution h → Sort u} →
                    (t : F.LeviCivitaEvolution h) →
                      ((connVel : ℝ → V → V → V) →
                          (connVel_add₁ :
                              ∀ (t : ℝ) (X X' Y : V), connVel t (X + X') Y = connVel t X Y + connVel t X' Y) →
                            (connVel_smul₁ : ∀ (t a : ℝ) (X Y : V), connVel t (a • X) Y = a • connVel t X Y) →
                              (connVel_add₂ :
                                  ∀ (t : ℝ) (X Y Y' : V), connVel t X (Y + Y') = connVel t X Y + connVel t X Y') →
