L1TYPE	Poincare.D12.TriangulationTopology.sphereOfTwoDisks._proof_10	∀ (n : ℕ) {X : Type u_1}
  [inst : TopologicalSpace X] (A B : Set X) (hcover : A ∪ B = Set.univ)
  (eA : ↑A ≃ₜ ↑(Poincare.D12.TriangulationTopology.Disk (n + 1)))
  (eB : ↑B ≃ₜ ↑(Poincare.D12.TriangulationTopology.Disk (n + 1)))
  (h : ↑(Poincare.D12.TriangulationTopology.Sphere n) ≃ₜ ↑(Poincare.D12.TriangulationTopology.Sphere n))
  (hbdA : ∀ (x : X) (hx : x ∈ A), ↑(eA ⟨x, hx⟩) ∈ Poincare.D12.TriangulationTopology.Sphere n ↔ x ∈ B),
  (∀ (x : X) (hxA : x ∈ A) (hxB : x ∈ B),
      eB ⟨x, hxB⟩ = Poincare.D12.TriangulationTopology.sphereToDisk n (h ⟨↑(eA ⟨x, hxA⟩), ⋯⟩)) →
    (∀ (x : X) (hx : x ∈ A),
        (fun x =>
              if hx : x ∈ A then Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inl (eA ⟨x, hx⟩))
              else Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inr (eB ⟨x, ⋯⟩)))
            x =
          Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inl (eA ⟨x, hx⟩))) →
      (∀ (x : X) (hxB : x ∈ B),
          x ∉ A →
            (fun x =>
                  if hx : x ∈ A then Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inl (eA ⟨x, hx⟩))
                  else Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inr (eB ⟨x, ⋯⟩)))
                x =
              Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h) (Sum.inr (eB ⟨x, hxB⟩))) →
        ∀
          (hwell :
            ∀ (y : ↑(Poincare.D12.TriangulationTopology.Sphere n)),
              ↑(eA.symm (Poincare.D12.TriangulationTopology.sphereToDisk n y)) =
                ↑(eB.symm (Poincare.D12.TriangulationTopology.sphereToDisk n (h y))))
          (z : Poincare.D12.TriangulationTopology.DiskGlueQuot n h),
          (if hx :
                Quot.lift
                    (fun p =>
                      match p with
                      | Sum.inl d => ↑(eA.symm d)
                      | Sum.inr d => ↑(eB.symm d))
                    ⋯ z ∈
                  A then
              Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h)
                (Sum.inl
                  (eA
                    ⟨Quot.lift
                        (fun p =>
                          match p with
                          | Sum.inl d => ↑(eA.symm d)
                          | Sum.inr d => ↑(eB.symm d))
                        ⋯ z,
                      hx⟩))
            else
              Quot.mk (Poincare.D12.TriangulationTopology.diskGlueRel n h)
                (Sum.inr
                  (eB
                    ⟨Quot.lift
                        (fun p =>
                          match p with
                          | Sum.inl d => ↑(eA.symm d)
                          | Sum.inr d => ↑(eB.symm d))
                        ⋯ z,
                      ⋯⟩))) =
            z
