  (pairing_symm_1 : ∀ (u v : F), (pairing_1 u) v = (pairing_1 v) u)
  (laplacian_ibp_1 : ∀ (u v : F), (pairing_1 (laplacian_1 u)) v - (pairing_1 u) (laplacian_1 v) = boundaryForm_1 u v)
  (scalarMul_selfAdjoint_1 : ∀ (u v : F), (pairing_1 (scalarMul_1 u)) v = (pairing_1 u) (scalarMul_1 v))
  (boundaryForm_antisymm_1 : ∀ (u v : F), boundaryForm_1 v u = -boundaryForm_1 u v),
  ({ pairing := pairing, laplacian := laplacian, scalarMul := scalarMul, boundaryForm := boundaryForm,
        volumeVariation := volumeVariation, volumeVariation_apply := volumeVariation_apply,
        pairing_symm := pairing_symm, laplacian_ibp := laplacian_ibp, scalarMul_selfAdjoint := scalarMul_selfAdjoint,
        boundaryForm_antisymm := boundaryForm_antisymm } =
      { pairing := pairing_1, laplacian := laplacian_1, scalarMul := scalarMul_1, boundaryForm := boundaryForm_1,
        volumeVariation := volumeVariation_1, volumeVariation_apply := volumeVariation_apply_1,
        pairing_symm := pairing_symm_1, laplacian_ibp := laplacian_ibp_1,
        scalarMul_selfAdjoint := scalarMul_selfAdjoint_1, boundaryForm_antisymm := boundaryForm_antisymm_1 }) =
