                                                      Continuous f →
                                                        Filter.Tendsto (fun t => ∫ (y : X), kernel x y t * f y ∂volume)
                                                          (nhdsWithin 0 (Set.Ioi 0)) (nhds (f x))) →
                                                  (heatEquation :
                                                      ∀ (x y : X) (t : ℝ),
                                                        0 < t →
                                                          HasDerivAt (fun s => kernel x y s)
                                                            (laplacian (fun z => kernel z y t) x) t) →
                                                    motive
                                                      { volume := volume, dist := dist, dim := dim, C_up := C_up,
                                                        c_up := c_up, C_lo := C_lo, c_lo := c_lo, kernel := kernel,
                                                        laplacian := laplacian, dist_self := dist_self,
                                                        dist_nonneg := dist_nonneg, dist_symm := dist_symm,
                                                        c_up_pos := c_up_pos, c_lo_pos := c_lo_pos,
                                                        C_up_nonneg := C_up_nonneg, C_lo_nonneg := C_lo_nonneg,
                                                        kernel_nonneg := kernel_nonneg,
                                                        gaussianUpperBound := gaussianUpperBound,
                                                        gaussianLowerBound := gaussianLowerBound, symmetry := symmetry,
                                                        semigroup := semigroup, normalization := normalization,
                                                        initialCondition := initialCondition,
                                                        heatEquation := heatEquation }) →
            motive t
