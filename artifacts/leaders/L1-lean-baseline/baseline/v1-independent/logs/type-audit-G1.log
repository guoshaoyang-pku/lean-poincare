                                  {volumeVariation_apply' :
                                      ∀ (j k : Poincare.D7.ConjugateHeat.Jet F),
                                        volumeVariation' j k =
                                          (pairing' j.2) k.1 + (pairing' j.1) k.2 - (pairing' (scalarMul' j.1)) k.1} →
                                    {pairing_symm' : ∀ (u v : F), (pairing' u) v = (pairing' v) u} →
                                      {laplacian_ibp' :
                                          ∀ (u v : F),
                                            (pairing' (laplacian' u)) v - (pairing' u) (laplacian' v) =
                                              boundaryForm' u v} →
                                        {scalarMul_selfAdjoint' :
                                            ∀ (u v : F), (pairing' (scalarMul' u)) v = (pairing' u) (scalarMul' v)} →
                                          {boundaryForm_antisymm' :
                                              ∀ (u v : F), boundaryForm' v u = -boundaryForm' u v} →
                                            { pairing := pairing, laplacian := laplacian, scalarMul := scalarMul,
                                                  boundaryForm := boundaryForm, volumeVariation := volumeVariation,
                                                  volumeVariation_apply := volumeVariation_apply,
                                                  pairing_symm := pairing_symm, laplacian_ibp := laplacian_ibp,
                                                  scalarMul_selfAdjoint := scalarMul_selfAdjoint,
                                                  boundaryForm_antisymm := boundaryForm_antisymm } =
                                                { pairing := pairing', laplacian := laplacian', scalarMul := scalarMul',
                                                  boundaryForm := boundaryForm', volumeVariation := volumeVariation',
                                                  volumeVariation_apply := volumeVariation_apply',
                                                  pairing_symm := pairing_symm', laplacian_ibp := laplacian_ibp',
                                                  scalarMul_selfAdjoint := scalarMul_selfAdjoint',
                                                  boundaryForm_antisymm := boundaryForm_antisymm' } →
                                              (pairing ≍ pairing' →
                                                  laplacian ≍ laplacian' →
                                                    scalarMul ≍ scalarMul' →
