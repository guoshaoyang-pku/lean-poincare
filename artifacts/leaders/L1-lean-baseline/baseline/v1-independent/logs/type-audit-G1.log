        HasDerivAt (fun s => ∫ (x : X), toEnergyFunctional_1.u s x * φ x ∂μ)
          (-D_1.form (toEnergyFunctional_1.u t) φ + ∫ (x : X), toEnergyFunctional_1.f t x * φ x ∂μ) t),
  ({ toEnergyFunctional := toEnergyFunctional, D := D, testClass := testClass, u_mem_testClass := u_mem_testClass,
        weak_equation := weak_equation } =
