            {dirichlet : (M → ℝ) → (M → ℝ) → ℝ} →
              {energy_eq : ∀ (t : ℝ), E t = ∫ (x : M), u t x ^ 2 ∂μ} →
                {dirichlet_symm : ∀ (w v : M → ℝ), dirichlet w v = dirichlet v w} →
                  {dirichlet_nonneg : ∀ (w : M → ℝ), 0 ≤ dirichlet w w} →
                    {testClass : Set (M → ℝ)} →
                      {u_mem_testClass : ∀ (t : ℝ), u t ∈ testClass} →
                        {weak_equation :
                            ∀ (t : ℝ),
                              ∀ φ ∈ testClass,
                                HasDerivAt (fun s => ∫ (x : M), u s x * φ x ∂μ)
                                  (-dirichlet (u t) φ + ∫ (x : M), f t x * φ x ∂μ) t} →
                          {energy_identity :
                              ∀ (t : ℝ),
                                HasDerivAt E (-2 * dirichlet (u t) (u t) + 2 * ∫ (x : M), u t x * f t x ∂μ) t} →
                            {μ' : MeasureTheory.Measure M} →
                              {u' f' : ℝ → M → ℝ} →
                                {E' : ℝ → ℝ} →
                                  {dirichlet' : (M → ℝ) → (M → ℝ) → ℝ} →
                                    {energy_eq' : ∀ (t : ℝ), E' t = ∫ (x : M), u' t x ^ 2 ∂μ'} →
                                      {dirichlet_symm' : ∀ (w v : M → ℝ), dirichlet' w v = dirichlet' v w} →
                                        {dirichlet_nonneg' : ∀ (w : M → ℝ), 0 ≤ dirichlet' w w} →
