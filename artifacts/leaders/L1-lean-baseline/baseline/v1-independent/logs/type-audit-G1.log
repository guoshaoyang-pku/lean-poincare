          ((volume : MeasureTheory.Measure X) →
              (dist : X → X → ℝ) →
                (dim C_up c_up C_lo c_lo : ℝ) →
                  (kernel : X → X → ℝ → ℝ) →
                    (laplacian : (X → ℝ) →ₗ[ℝ] X → ℝ) →
                      (dist_self : ∀ (x : X), dist x x = 0) →
                        (dist_nonneg : ∀ (x y : X), 0 ≤ dist x y) →
                          (dist_symm : ∀ (x y : X), dist x y = dist y x) →
                            (c_up_pos : 0 < c_up) →
                              (c_lo_pos : 0 < c_lo) →
                                (C_up_nonneg : 0 ≤ C_up) →
                                  (C_lo_nonneg : 0 ≤ C_lo) →
                                    (kernel_nonneg : ∀ (x y : X) (t : ℝ), 0 ≤ kernel x y t) →
                                      (gaussianUpperBound :
                                          ∀ (x y : X) (t : ℝ),
                                            0 < t →
                                              kernel x y t ≤
                                                C_up * t ^ (-(dim / 2)) * Real.exp (-dist x y ^ 2 / (c_up * t))) →
                                        (gaussianLowerBound :
                                            ∀ (x y : X) (t : ℝ),
                                              0 < t →
                                                dist x y ≤ 1 →
                                                  C_lo * t ^ (-(dim / 2)) * Real.exp (-dist x y ^ 2 / (c_lo * t)) ≤
                                                    kernel x y t) →
                                          (symmetry : ∀ (x y : X) (t : ℝ), kernel x y t = kernel y x t) →
                                            (semigroup :
                                                ∀ (x y : X) (s t : ℝ),
                                                  0 < s →
                                                    0 < t →
                                                      kernel x y (s + t) =
                                                        ∫ (z : X), kernel x z s * kernel z y t ∂volume) →
                                              (normalization :
                                                  ∀ (x : X) (t : ℝ), 0 < t → ∫ (y : X), kernel x y t ∂volume = 1) →
