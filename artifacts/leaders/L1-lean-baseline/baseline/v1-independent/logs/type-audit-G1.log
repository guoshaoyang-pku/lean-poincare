              (dd.D (m.basis i)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u k) -
            Poincare.D12.TensorMaximumBochner.Bochner.gamma d i i k *
              (dd.D (m.basis k)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u j)) =
    ∑ a,
      ∑ b_1,
        Poincare.D12.TensorMaximumBochner.Bochner.K d j a b_1 *
          (dd.D (m.basis a)) (Poincare.D12.TensorMaximumBochner.Bochner.ui dd u b_1)
