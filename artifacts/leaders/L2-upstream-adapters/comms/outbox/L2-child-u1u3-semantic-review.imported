{
  "id": "L2-child-u1u3-semantic-review",
  "group_id": "L2-upstream-adapters",
  "parent_node": "L2-upstream-adapters",
  "deps": [
    "L2-upstream-adapters"
  ],
  "lane": "reviewer",
  "objective": "Semantically review the U1/U3 constructed-input consumers and the 85-entry semantic classification, and decide whether the constructed-input + downstream-consumer leg for U1 and U3 is satisfied or what exact leg remains.",
  "acceptance": "For each of the 24 adapter-authored downstream declarations in adapters/UpstreamAdapters/DownstreamGeometry.lean, adapters/UpstreamAdapters/DownstreamUse.lean and adapters/UpstreamAdaptersPetersen/DownstreamUse.lean check and report with file:line: (i) the statement is not a restatement of an upstream theorem (compare against the upstream names and notes in evidence/claim-classification.json); (ii) no hypothesis is conclusion-equivalent; (iii) the upstream declarations claimed as consumed really occur in the proof (source inspection plus `#print axioms <name>` cone); (iv) the assigned class (proved/model/conditional/definition) matches the vocabulary, in particular that the Euclidean-plane statements are marked `model` and the two general U1 theorems `proved`; (v) independently test that `Riemannian.AffineConnection.curvatureOperatorAt_antisymm_left` and `curvatureOperatorAt_bianchi` do NOT already exist in the snapshot (grep + a `#check` that must fail); (vi) confirm the Petersen-family consumers compile only in UpstreamAdaptersPetersen (no cross-import with Shared/DoCarmoLib, because of the duplicate metric_simp attribute). Deliver a signed review report with a per-theorem verdict and an explicit statement of whether U1 and U3 may be marked closed, or the exact remaining leg (release-pin consumer / general-manifold consumer / other). No file outside the reviewer worktree is modified.",
  "host_pool": [
    "ophis-gpu"
  ],
  "requires_lean": true,
  "max_hours": 3
}
