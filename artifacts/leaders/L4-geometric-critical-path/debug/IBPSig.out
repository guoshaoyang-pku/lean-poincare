                                                MeasureTheory.volume).withDensity
                                            ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight f) =
                                        -∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                                            Guv
