@Poincare.D13.ManifoldIBP.exists_contDiff_bump : ∀ {d : ℕ} {K U : Set (Poincare.D12.VolumeIBP.Vec d)},
  IsCompact K →
    IsOpen U →
      K ⊆ U →
        ∃ χ,
          ContDiff ℝ (↑⊤) χ ∧
            (∀ (x : Poincare.D12.VolumeIBP.Vec d), 0 ≤ χ x ∧ χ x ≤ 1) ∧ (∀ x ∈ K, χ x = 1) ∧ tsupport χ ⊆ U
@Poincare.D13.ManifoldIBP.exists_smooth_partitionOfUnity_subordinate : ∀ {d : ℕ} {ι : Type u_1} [inst : Fintype ι]
  (U : ι → Set (Poincare.D12.VolumeIBP.Vec d)),
  (∀ (i : ι), IsOpen (U i)) →
    ∀ {K : Set (Poincare.D12.VolumeIBP.Vec d)},
      IsCompact K →
        K ⊆ ⋃ i, U i →
          ∃ ψ,
            (∀ (i : ι), ContDiff ℝ (↑⊤) (ψ i)) ∧
              (∀ (i : ι) (x : Poincare.D12.VolumeIBP.Vec d), 0 ≤ ψ i x) ∧
                (∀ (i : ι), tsupport (ψ i) ⊆ U i) ∧ ∀ x ∈ K, ∑ i, ψ i x = 1
@Poincare.D13.ManifoldIBP.manifoldWeightedIBP_of_atlasData : ∀ {n ι : ℕ} {M : Type u_1} [inst : MeasurableSpace M]
  (A : Poincare.D13.ManifoldIBP.ManifoldAtlasData M n ι) (u v : M → ℝ),
  (∀ (i : Fin ι), ContDiff ℝ 2 (A.drift i)) →
    (∀ (i : Fin ι), ContDiff ℝ 2 fun x => u (A.chart i x)) →
      (∀ (i : Fin ι), ContDiff ℝ 2 fun x => v (A.chart i x)) →
        (∀ (i : Fin ι), HasCompactSupport fun x => v (A.chart i x)) →
          MeasureTheory.Integrable (fun m => A.driftLaplacianM u m * v m) A.μ →
            MeasureTheory.Integrable (fun m => A.gradInnerM u v m) A.μ →
              ∫ (m : M), A.driftLaplacianM u m * v m ∂A.μ = -∫ (m : M), A.gradInnerM u v m ∂A.μ
@Poincare.D13.ManifoldIBP.laplacianIntegral_eq_chartSum : ∀ {n ι : ℕ} {M : Type u_1} [inst : MeasurableSpace M]
  (A : Poincare.D13.ManifoldIBP.ManifoldAtlasData M n ι) (u v : M → ℝ),
  MeasureTheory.Integrable (fun m => A.driftLaplacianM u m * v m) A.μ →
    ∫ (m : M), A.driftLaplacianM u m * v m ∂A.μ =
      { metric := A.metric }.globalIntegral A.drift fun i x =>
        { metric := A.metric }.driftLaplacian A.drift (fun i y => u (A.chart i y)) i x * v (A.chart i x)
@Poincare.D13.ManifoldIBP.gradInnerIntegral_eq_chartSum : ∀ {n ι : ℕ} {M : Type u_1} [inst : MeasurableSpace M]
  (A : Poincare.D13.ManifoldIBP.ManifoldAtlasData M n ι) (u v : M → ℝ),
  MeasureTheory.Integrable (fun m => A.gradInnerM u v m) A.μ →
    ∫ (m : M), A.gradInnerM u v m ∂A.μ =
      { metric := A.metric }.globalIntegral A.drift fun i x =>
        { metric := A.metric }.gradInnerInverse (fun i y => u (A.chart i y)) (fun i y => v (A.chart i y)) i x
