                                              (A.metric (chartOf j)).gradInnerInverse
                                                (fun z => u (A.chart (chartOf j) z))
                                                (fun z => vj j (A.chart (chartOf j) z)) y) →
                                      (∀ (m : M), Guv m = ∑ j, Guvj j m) →
