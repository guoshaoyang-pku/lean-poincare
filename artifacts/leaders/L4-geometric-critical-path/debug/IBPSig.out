@Poincare.D13.ManifoldIBP.ChartSumData.globalWeightedIBP : ∀ {n ι : ℕ} (D : Poincare.D13.ManifoldIBP.ChartSumData n ι)
  (f u v : Fin ι → Poincare.D13.ManifoldIBP.Vec (n + 1) → ℝ),
  (∀ (i : Fin ι), ContDiff ℝ 2 (f i)) →
    (∀ (i : Fin ι), ContDiff ℝ 2 (u i)) →
      (∀ (i : Fin ι), ContDiff ℝ 2 (v i)) →
        (∀ (i : Fin ι), HasCompactSupport (v i)) →
          (D.globalIntegral f fun i x => D.driftLaplacian f u i x * v i x) =
            -D.globalIntegral f fun i x => D.gradInnerInverse u v i x
@Poincare.D13.ManifoldIBP.ChartSumData.globalLaplacianIntegralZero : ∀ {n ι : ℕ}
  (D : Poincare.D13.ManifoldIBP.ChartSumData n ι) (v : Fin ι → Poincare.D13.ManifoldIBP.Vec (n + 1) → ℝ),
  (∀ (i : Fin ι), ContDiff ℝ 2 (v i)) →
    (∀ (i : Fin ι), HasCompactSupport (v i)) → (D.globalIntegralUnweighted fun i x => D.laplacian v i x) = 0
@Poincare.D13.ManifoldIBP.ChartSumData.globalDivergenceIntegralZero : ∀ {n ι : ℕ}
  (D : Poincare.D13.ManifoldIBP.ChartSumData n ι)
  (X : Fin ι → Poincare.D13.ManifoldIBP.Vec (n + 1) → Poincare.D13.ManifoldIBP.Vec (n + 1)),
  (∀ (i : Fin ι), ContDiff ℝ 1 (X i)) →
    (∀ (i : Fin ι), HasCompactSupport (X i)) → (D.globalIntegralUnweighted fun i x => D.divergence X i x) = 0
@Poincare.D13.ManifoldIBP.ChartSumData.globalUnweightedIBP : ∀ {n ι : ℕ} (D : Poincare.D13.ManifoldIBP.ChartSumData n ι)
  (u v : Fin ι → Poincare.D13.ManifoldIBP.Vec (n + 1) → ℝ),
  (∀ (i : Fin ι), ContDiff ℝ 2 (u i)) →
    (∀ (i : Fin ι), ContDiff ℝ 2 (v i)) →
      (∀ (i : Fin ι), HasCompactSupport (u i)) →
        (D.globalIntegralUnweighted fun i x => u i x * D.laplacian v i x) =
          -D.globalIntegralUnweighted fun i x => D.gradInnerInverse u v i x
@Poincare.D13.ManifoldIBP.ChartSumData.globalIntegral : {n ι : ℕ} →
  Poincare.D13.ManifoldIBP.ChartSumData n ι →
    (Fin ι → Poincare.D13.ManifoldIBP.Vec (n + 1) → ℝ) → (Fin ι → Poincare.D13.ManifoldIBP.Vec (n + 1) → ℝ) → ℝ
@Poincare.D13.ManifoldIBP.OverlapAtlas.globalWeightedIBP_finset : ∀ {M : Type u_1} [inst : MeasurableSpace M] {n : ℕ}
  (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1)) {ι : Type u_2} [inst_1 : Fintype ι] (chartOf : ι → ℕ)
  (f u v Du Guv : M → ℝ) (vj Guvj : ι → M → ℝ),
  Measurable f →
    Measurable Du →
      (∀ (j : ι), Measurable (vj j)) →
        (∀ (j : ι), Measurable (Guvj j)) →
          (∀ (j : ι) (m : M), vj j m ≠ 0 → m ∈ A.chart (chartOf j) '' A.source (chartOf j)) →
            (∀ (j : ι) (m : M), Guvj j m ≠ 0 → m ∈ A.chart (chartOf j) '' A.source (chartOf j)) →
              (∀ (j : ι) (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                  vj j (A.chart (chartOf j) y) ≠ 0 → y ∈ A.source (chartOf j)) →
                (∀ (j : ι) (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                    (A.metric (chartOf j)).gradInnerInverse (fun z => u (A.chart (chartOf j) z))
                          (fun z => vj j (A.chart (chartOf j) z)) y ≠
                        0 →
                      y ∈ A.source (chartOf j)) →
                  (∀ (j : ι), ContDiff ℝ 2 fun y => f (A.chart (chartOf j) y)) →
                    (∀ (j : ι), ContDiff ℝ 2 fun y => u (A.chart (chartOf j) y)) →
                      (∀ (j : ι), ContDiff ℝ 2 fun y => vj j (A.chart (chartOf j) y)) →
                        (∀ (j : ι), HasCompactSupport fun y => vj j (A.chart (chartOf j) y)) →
                          (∀ (j : ι),
                              ∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                                y ∈ A.source (chartOf j) →
                                  Du (A.chart (chartOf j) y) =
                                    (A.metric (chartOf j)).driftLaplacian (fun z => f (A.chart (chartOf j) z))
                                      (fun z => u (A.chart (chartOf j) z)) y) →
                            (∀ (j : ι),
                                ∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                                  y ∈ A.source (chartOf j) →
                                    Guvj j (A.chart (chartOf j) y) =
                                      (A.metric (chartOf j)).gradInnerInverse (fun z => u (A.chart (chartOf j) z))
                                        (fun z => vj j (A.chart (chartOf j) z)) y) →
                              (∀ (m : M), v m = ∑ j, vj j m) →
                                (∀ (m : M), Guv m = ∑ j, Guvj j m) →
                                  (∀ (j : ι),
                                      MeasureTheory.Integrable (fun m => Du m * vj j m)
                                        ((A.globalMeasure MeasureTheory.volume).withDensity (A.weight f))) →
                                    (∀ (j : ι),
                                        MeasureTheory.Integrable (fun m => Guvj j m)
                                          ((A.globalMeasure MeasureTheory.volume).withDensity (A.weight f))) →
                                      ∫ (m : M),
                                          Du m * v m ∂(A.globalMeasure MeasureTheory.volume).withDensity (A.weight f) =
                                        -∫ (m : M),
                                            Guv m ∂(A.globalMeasure MeasureTheory.volume).withDensity (A.weight f)
@Poincare.D13.ManifoldIBP.OverlapAtlas.globalIBP_finset : ∀ {M : Type u_1} [inst : MeasurableSpace M] {n : ℕ}
  (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1)) {ι : Type u_2} [inst_1 : Fintype ι] (chartOf : ι → ℕ)
  (u v Du Guv : M → ℝ) (vj Guvj : ι → M → ℝ),
  Measurable Du →
    (∀ (j : ι), Measurable (vj j)) →
      (∀ (j : ι), Measurable (Guvj j)) →
        (∀ (j : ι) (m : M), vj j m ≠ 0 → m ∈ A.chart (chartOf j) '' A.source (chartOf j)) →
          (∀ (j : ι) (m : M), Guvj j m ≠ 0 → m ∈ A.chart (chartOf j) '' A.source (chartOf j)) →
            (∀ (j : ι) (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                vj j (A.chart (chartOf j) y) ≠ 0 → y ∈ A.source (chartOf j)) →
              (∀ (j : ι) (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                  (A.metric (chartOf j)).gradInnerInverse (fun z => u (A.chart (chartOf j) z))
                        (fun z => vj j (A.chart (chartOf j) z)) y ≠
                      0 →
                    y ∈ A.source (chartOf j)) →
                (∀ (j : ι), ContDiff ℝ 2 fun y => u (A.chart (chartOf j) y)) →
                  (∀ (j : ι), ContDiff ℝ 2 fun y => vj j (A.chart (chartOf j) y)) →
                    (∀ (j : ι), HasCompactSupport fun y => vj j (A.chart (chartOf j) y)) →
                      (∀ (j : ι),
                          ∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                            y ∈ A.source (chartOf j) →
                              Du (A.chart (chartOf j) y) =
                                (A.metric (chartOf j)).laplacian (fun z => u (A.chart (chartOf j) z)) y) →
                        (∀ (j : ι),
                            ∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                              y ∈ A.source (chartOf j) →
                                Guvj j (A.chart (chartOf j) y) =
                                  (A.metric (chartOf j)).gradInnerInverse (fun z => u (A.chart (chartOf j) z))
                                    (fun z => vj j (A.chart (chartOf j) z)) y) →
                          (∀ (m : M), v m = ∑ j, vj j m) →
                            (∀ (m : M), Guv m = ∑ j, Guvj j m) →
                              (∀ (j : ι),
                                  MeasureTheory.Integrable (fun m => Du m * vj j m)
                                    (A.globalMeasure MeasureTheory.volume)) →
                                (∀ (j : ι),
                                    MeasureTheory.Integrable (fun m => Guvj j m)
                                      (A.globalMeasure MeasureTheory.volume)) →
                                  ∫ (m : M), Du m * v m ∂A.globalMeasure MeasureTheory.volume =
                                    -∫ (m : M), Guv m ∂A.globalMeasure MeasureTheory.volume
@Poincare.D13.ManifoldIBP.OverlapAtlas.chartMeasure_apply_eq : ∀ {M : Type u_1} [inst : MeasurableSpace M] {d : ℕ}
  (A : Poincare.D13.ManifoldIBP.OverlapAtlas M d) (μ : MeasureTheory.Measure (Poincare.D12.VolumeIBP.Vec d))
  [μ.IsAddHaarMeasure] (i j : ℕ) {s : Set M},
  MeasurableSet s →
    s ⊆ A.chart i '' A.source i → s ⊆ A.chart j '' A.source j → (A.chartMeasure μ i) s = (A.chartMeasure μ j) s
@Poincare.D13.ManifoldIBP.OverlapAtlas.globalMeasure_eq_chartMeasure_of_cover : ∀ {M : Type u_1}
  [inst : MeasurableSpace M] {d : ℕ} (A : Poincare.D13.ManifoldIBP.OverlapAtlas M d)
  (μ : MeasureTheory.Measure (Poincare.D12.VolumeIBP.Vec d)) [μ.IsAddHaarMeasure] (i : ℕ),
  A.chart i '' A.source i = Set.univ → A.globalMeasure μ = A.chartMeasure μ i
@Poincare.D13.ManifoldIBP.OverlapAtlas.density_transform : ∀ {M : Type u_1} [inst : MeasurableSpace M] {d : ℕ}
  (A : Poincare.D13.ManifoldIBP.OverlapAtlas M d) (i j : ℕ),
  ∀ y ∈ Poincare.D13.ManifoldIBP.overlapOf A.chart A.source i j,
    A.density j y =
      A.density i (A.transition i j y) *
        |(fderivWithin ℝ (A.transition i j) (Poincare.D13.ManifoldIBP.overlapOf A.chart A.source i j) y).det|
@Poincare.D13.ManifoldIBP.OverlapAtlas.chartMeasure_apply : ∀ {M : Type u_1} [inst : MeasurableSpace M] {d : ℕ}
  (A : Poincare.D13.ManifoldIBP.OverlapAtlas M d) (μ : MeasureTheory.Measure (Poincare.D12.VolumeIBP.Vec d)) (i : ℕ)
  {s : Set M},
  MeasurableSet s →
    (A.chartMeasure μ i) s =
      ∫⁻ (y : Poincare.D12.VolumeIBP.Vec d) in A.chartPreimage i s, ENNReal.ofReal (A.density i y) ∂μ
@Poincare.D13.ManifoldIBP.OverlapAtlas.globalMeasure : {M : Type u_1} →
  [inst : MeasurableSpace M] →
    {d : ℕ} →
      Poincare.D13.ManifoldIBP.OverlapAtlas M d →
        MeasureTheory.Measure (Poincare.D12.VolumeIBP.Vec d) → MeasureTheory.Measure M
@Poincare.D13.ManifoldIBP.OverlapAtlas.chartMeasure : {M : Type u_1} →
  [inst : MeasurableSpace M] →
    {d : ℕ} →
      Poincare.D13.ManifoldIBP.OverlapAtlas M d →
        MeasureTheory.Measure (Poincare.D12.VolumeIBP.Vec d) → ℕ → MeasureTheory.Measure M
@Poincare.D13.ManifoldIBP.OverlapAtlas.integrable_chartMeasure_iff : ∀ {M : Type u_1} [inst : MeasurableSpace M] {n : ℕ}
  (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1)) (μ : MeasureTheory.Measure (Poincare.D12.VolumeIBP.Vec (n + 1)))
  (i : ℕ) {g : M → ℝ},
  MeasureTheory.AEStronglyMeasurable g (A.chartMeasure μ i) →
    (MeasureTheory.Integrable g (A.chartMeasure μ i) ↔
      MeasureTheory.Integrable (fun y => g (A.chart i y) * A.density i y) (μ.restrict (A.source i)))
@Poincare.D13.ManifoldIBP.OverlapAtlas.integrable_globalMeasure_iff : ∀ {M : Type u_1} [inst : MeasurableSpace M]
  {n : ℕ} (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1))
  (μ : MeasureTheory.Measure (Poincare.D12.VolumeIBP.Vec (n + 1))) [μ.IsAddHaarMeasure] (i : ℕ) {g : M → ℝ},
  (∀ (m : M), g m ≠ 0 → m ∈ A.chart i '' A.source i) →
    (MeasureTheory.Integrable g (A.globalMeasure μ) ↔ MeasureTheory.Integrable g (A.chartMeasure μ i))
@Poincare.D13.ManifoldIBP.OverlapAtlas.integrable_globalMeasure_withDensity_of_supported : ∀ {M : Type u_1}
  [inst : MeasurableSpace M] {n : ℕ} (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1))
  (μ : MeasureTheory.Measure (Poincare.D12.VolumeIBP.Vec (n + 1))) [μ.IsAddHaarMeasure] (i : ℕ) {f g : M → ℝ},
  Measurable f →
    Measurable g →
      (∀ (m : M), g m ≠ 0 → m ∈ A.chart i '' A.source i) →
        MeasureTheory.Integrable (fun y => Real.exp (-f (A.chart i y)) * g (A.chart i y) * A.density i y) μ →
          MeasureTheory.Integrable g ((A.globalMeasure μ).withDensity (A.weight f))
@Poincare.D13.ManifoldIBP.OverlapAtlas.integral_globalMeasure_withDensity_of_supported : ∀ {M : Type u_1}
  [inst : MeasurableSpace M] {n : ℕ} (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1))
  (μ : MeasureTheory.Measure (Poincare.D12.VolumeIBP.Vec (n + 1))) [μ.IsAddHaarMeasure] (i : ℕ) {f g : M → ℝ},
  Measurable f →
    MeasureTheory.AEStronglyMeasurable g (A.chartMeasure μ i) →
      (∀ (m : M), g m ≠ 0 → m ∈ A.chart i '' A.source i) →
        ∫ (m : M), g m ∂(A.globalMeasure μ).withDensity (A.weight f) =
          ∫ (y : Poincare.D12.VolumeIBP.Vec (n + 1)) in A.source i,
            Real.exp (-f (A.chart i y)) * g (A.chart i y) * A.density i y ∂μ
@Poincare.D13.ManifoldIBP.OverlapAtlas.globalWeightedIBP_of_chartSupported : ∀ {M : Type u_1} [inst : MeasurableSpace M]
  {n : ℕ} (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1)) (i : ℕ) (f u v Du Guv : M → ℝ),
  Measurable f →
    Measurable v →
      Measurable Du →
        Measurable Guv →
          (∀ (m : M), v m ≠ 0 → m ∈ A.chart i '' A.source i) →
            (∀ (m : M), Guv m ≠ 0 → m ∈ A.chart i '' A.source i) →
              (∀ (y : Poincare.D12.VolumeIBP.Vec (n + 1)), v (A.chart i y) ≠ 0 → y ∈ A.source i) →
                (∀ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                    (A.metric i).gradInnerInverse (fun z => u (A.chart i z)) (fun z => v (A.chart i z)) y ≠ 0 →
                      y ∈ A.source i) →
                  (ContDiff ℝ 2 fun y => f (A.chart i y)) →
                    (ContDiff ℝ 2 fun y => u (A.chart i y)) →
                      (ContDiff ℝ 2 fun y => v (A.chart i y)) →
                        (HasCompactSupport fun y => v (A.chart i y)) →
                          (∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                              y ∈ A.source i →
                                Du (A.chart i y) =
                                  (A.metric i).driftLaplacian (fun z => f (A.chart i z)) (fun z => u (A.chart i z)) y) →
                            (∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                                y ∈ A.source i →
                                  Guv (A.chart i y) =
                                    (A.metric i).gradInnerInverse (fun z => u (A.chart i z)) (fun z => v (A.chart i z))
                                      y) →
                              ∫ (m : M), Du m * v m ∂(A.globalMeasure MeasureTheory.volume).withDensity (A.weight f) =
                                -∫ (m : M), Guv m ∂(A.globalMeasure MeasureTheory.volume).withDensity (A.weight f)
@Poincare.D13.ManifoldIBP.OverlapAtlas.globalWeightedIBP_of_chartSupported_smul : ∀ {M : Type u_1}
  [inst : MeasurableSpace M] {n : ℕ} (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1)) (c : ENNReal) (i : ℕ)
  (f u v Du Guv : M → ℝ),
