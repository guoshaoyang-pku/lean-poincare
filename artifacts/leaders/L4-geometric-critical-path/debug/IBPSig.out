  ContDiff ℝ 2 F →
    ContDiff ℝ 2 U →
      ContDiff ℝ 2 V →
        HasCompactSupport V →
          ∀ {R : ℝ} (ψ : Fin 2 → Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
            (∀ (i : Fin 2), ContDiff ℝ (↑⊤) (ψ i)) →
              (∀ (i : Fin 2), tsupport (ψ i) ⊆ Metric.ball 0 (R + 1)) →
                (∀ x ∈ tsupport V, ∑ i, ψ i x = 1) →
