                                      y) →
                              ∫ (m : M),
                                  Du m * v m ∂(A.globalMeasure (c • MeasureTheory.volume)).withDensity (A.weight f) =
                                -∫ (m : M), Guv m ∂(A.globalMeasure (c • MeasureTheory.volume)).withDensity (A.weight f)
@Poincare.D13.ManifoldIBP.OverlapAtlas.globalIBP_of_chartSupported : ∀ {M : Type u_1} [inst : MeasurableSpace M] {n : ℕ}
  (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1)) (i : ℕ) (u v Du Guv : M → ℝ),
  Measurable v →
    Measurable Du →
      Measurable Guv →
        (∀ (m : M), v m ≠ 0 → m ∈ A.chart i '' A.source i) →
          (∀ (m : M), Guv m ≠ 0 → m ∈ A.chart i '' A.source i) →
            (∀ (y : Poincare.D12.VolumeIBP.Vec (n + 1)), v (A.chart i y) ≠ 0 → y ∈ A.source i) →
              (∀ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                  (A.metric i).gradInnerInverse (fun z => u (A.chart i z)) (fun z => v (A.chart i z)) y ≠ 0 →
                    y ∈ A.source i) →
                (ContDiff ℝ 2 fun y => u (A.chart i y)) →
                  (ContDiff ℝ 2 fun y => v (A.chart i y)) →
                    (HasCompactSupport fun y => v (A.chart i y)) →
                      (∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                          y ∈ A.source i → Du (A.chart i y) = (A.metric i).laplacian (fun z => u (A.chart i z)) y) →
                        (∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                            y ∈ A.source i →
                              Guv (A.chart i y) =
                                (A.metric i).gradInnerInverse (fun z => u (A.chart i z)) (fun z => v (A.chart i z)) y) →
                          ∫ (m : M), Du m * v m ∂A.globalMeasure MeasureTheory.volume =
                            -∫ (m : M), Guv m ∂A.globalMeasure MeasureTheory.volume
@Poincare.D13.ManifoldIBP.OverlapAtlas.globalLaplacianIntegralZero_of_chartSupported : ∀ {M : Type u_1}
  [inst : MeasurableSpace M] {n : ℕ} (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1)) (i : ℕ) (Dw : M → ℝ)
  (V : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
  Measurable Dw →
    (∀ (m : M), Dw m ≠ 0 → m ∈ A.chart i '' A.source i) →
      ContDiff ℝ 2 V →
        HasCompactSupport V →
          (∀ (y : Poincare.D12.VolumeIBP.Vec (n + 1)), (A.metric i).laplacian V y ≠ 0 → y ∈ A.source i) →
            (∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                y ∈ A.source i → Dw (A.chart i y) = (A.metric i).laplacian V y) →
              ∫ (m : M), Dw m ∂A.globalMeasure MeasureTheory.volume = 0
@Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwoData_weightedIBP : ∀ {n : ℕ}
  (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (F u v : Poincare.D13.ManifoldIBP.Vec (n + 1) → ℝ)
  (hF : Measurable F),
  ContDiff ℝ 2 F →
    ContDiff ℝ 2 u →
      ContDiff ℝ 2 v →
        HasCompactSupport v →
          MeasureTheory.Integrable (fun m => G.driftLaplacian F u m * v m)
              (Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwoData n G F hF).μ →
            MeasureTheory.Integrable (fun m => G.gradInnerInverse u v m)
                (Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwoData n G F hF).μ →
              ∫ (m : Poincare.D13.ManifoldIBP.Vec (n + 1)),
                  G.driftLaplacian F u m *
                    v m ∂(Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwoData n G F hF).μ =
                -∫ (m : Poincare.D13.ManifoldIBP.Vec (n + 1)),
                    G.gradInnerInverse u v m ∂(Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwoData n G F hF).μ
@Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwo_weightedIBP : ∀ {n : ℕ}
  (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (F U V : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
  ContDiff ℝ 2 F →
    ContDiff ℝ 2 U →
      ContDiff ℝ 2 V →
        HasCompactSupport V →
          ∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
              G.driftLaplacian F U m *
                V
                  m ∂((Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwo n G).globalMeasure
                    MeasureTheory.volume).withDensity
                ((Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwo n G).weight F) =
            -∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                G.gradInnerInverse U V
                  m ∂((Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwo n G).globalMeasure
                      MeasureTheory.volume).withDensity
                  ((Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwo n G).weight F)
@Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwo_ibp : ∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1))
  (U V : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
