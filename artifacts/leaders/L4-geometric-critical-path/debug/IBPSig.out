                    MeasureTheory.volume).withDensity
                ((Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwo n G).weight F)
@Poincare.D13.ManifoldIBP.OverlapAtlas.eq_sum_of_pou : ∀ {M : Type u_1} [inst : MeasurableSpace M] {n : ℕ}
  (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1)) (b : ℕ) {ι : Type u_2} [inst_1 : Fintype ι]
  (ψ : ι → Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ) (v : M → ℝ) (vj : ι → M → ℝ),
  (∀ (j : ι), ∀ y ∈ A.source b, vj j (A.chart b y) = ψ j y * v (A.chart b y)) →
    (∀ (y : Poincare.D12.VolumeIBP.Vec (n + 1)), v (A.chart b y) ≠ 0 → ∑ j, ψ j y = 1) →
      (∀ (m : M), v m ≠ 0 → m ∈ A.chart b '' A.source b) →
        (∀ (j : ι) (m : M), vj j m ≠ 0 → m ∈ A.chart b '' A.source b) → ∀ (m : M), v m = ∑ j, vj j m
@Poincare.D13.ManifoldIBP.OverlapAtlas.globalWeightedIBP_of_pouData : ∀ {M : Type u_1} [inst : MeasurableSpace M]
  {n : ℕ} (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1)) (b : ℕ) {ι : Type u_2} [inst_1 : Fintype ι]
  (chartOf : ι → ℕ) (ψ : ι → Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ) (f u v Du Guv : M → ℝ) (vj Guvj : ι → M → ℝ),
  Measurable f →
    Measurable Du →
      (∀ (j : ι), Measurable (vj j)) →
        (∀ (j : ι), Measurable (Guvj j)) →
          (∀ (j : ι), ∀ y ∈ A.source b, vj j (A.chart b y) = ψ j y * v (A.chart b y)) →
            (∀ (y : Poincare.D12.VolumeIBP.Vec (n + 1)), v (A.chart b y) ≠ 0 → ∑ j, ψ j y = 1) →
              (∀ (m : M), v m ≠ 0 → m ∈ A.chart b '' A.source b) →
                (∀ (j : ι) (m : M), vj j m ≠ 0 → m ∈ A.chart b '' A.source b) →
                  (∀ (j : ι) (m : M), vj j m ≠ 0 → m ∈ A.chart (chartOf j) '' A.source (chartOf j)) →
                    (∀ (j : ι) (m : M), Guvj j m ≠ 0 → m ∈ A.chart (chartOf j) '' A.source (chartOf j)) →
                      (∀ (j : ι) (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                          vj j (A.chart (chartOf j) y) ≠ 0 → y ∈ A.source (chartOf j)) →
                        (∀ (j : ι) (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                            (A.metric (chartOf j)).gradInnerInverse (fun z => u (A.chart (chartOf j) z))
                                  (fun z => vj j (A.chart (chartOf j) z)) y ≠
                                0 →
                              y ∈ A.source (chartOf j)) →
                          (∀ (j : ι), ContDiff ℝ 2 fun y => f (A.chart (chartOf j) y)) →
                            (∀ (j : ι), ContDiff ℝ 2 fun y => u (A.chart (chartOf j) y)) →
                              (∀ (j : ι), ContDiff ℝ 2 fun y => vj j (A.chart (chartOf j) y)) →
                                (∀ (j : ι), HasCompactSupport fun y => vj j (A.chart (chartOf j) y)) →
                                  (∀ (j : ι),
                                      ∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                                        y ∈ A.source (chartOf j) →
                                          Du (A.chart (chartOf j) y) =
                                            (A.metric (chartOf j)).driftLaplacian (fun z => f (A.chart (chartOf j) z))
                                              (fun z => u (A.chart (chartOf j) z)) y) →
                                    (∀ (j : ι),
                                        ∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                                          y ∈ A.source (chartOf j) →
                                            Guvj j (A.chart (chartOf j) y) =
                                              (A.metric (chartOf j)).gradInnerInverse
                                                (fun z => u (A.chart (chartOf j) z))
                                                (fun z => vj j (A.chart (chartOf j) z)) y) →
                                      (∀ (m : M), Guv m = ∑ j, Guvj j m) →
                                        (∀ (j : ι),
                                            MeasureTheory.Integrable (fun m => Du m * vj j m)
                                              ((A.globalMeasure MeasureTheory.volume).withDensity (A.weight f))) →
                                          (∀ (j : ι),
                                              MeasureTheory.Integrable (fun m => Guvj j m)
                                                ((A.globalMeasure MeasureTheory.volume).withDensity (A.weight f))) →
                                            ∫ (m : M),
                                                Du m *
                                                  v m ∂(A.globalMeasure MeasureTheory.volume).withDensity (A.weight f) =
                                              -∫ (m : M),
