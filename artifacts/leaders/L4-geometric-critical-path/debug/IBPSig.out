@Poincare.D13.Riemannian.metric_transform_chartTransition : ∀ {d : ℕ}
  [NeZero (Module.finrank ℝ (Poincare.D12.VolumeIBP.Vec d))] {H : Type u_1} [inst : TopologicalSpace H]
  {I : ModelWithCorners ℝ (Poincare.D12.VolumeIBP.Vec d) H} {M : Type u_2} [inst_1 : TopologicalSpace M]
  [inst_2 : ChartedSpace H M] [inst_3 : IsManifold I (↑⊤) M] [inst_4 : Bundle.RiemannianBundle (TangentSpace I)]
  (α β : M) {x : M},
  x ∈ (chartAt H α).source →
    x ∈ (chartAt H β).source →
      Poincare.D13.Riemannian.chartGramMatrix (Pi.basisFun ℝ (Fin d)) β x =
        (Poincare.D13.ManifoldIBP.jacobianOf (Poincare.D13.Riemannian.chartTransition α β) (Set.range ↑I)
                (↑(extChartAt I β) x)).transpose *
            Poincare.D13.Riemannian.chartGramMatrix (Pi.basisFun ℝ (Fin d)) α x *
          Poincare.D13.ManifoldIBP.jacobianOf (Poincare.D13.Riemannian.chartTransition α β) (Set.range ↑I)
            (↑(extChartAt I β) x)
@Poincare.D13.Riemannian.fderivWithin_chartTransition_eq_of_isOpen : ∀ {d : ℕ}
  [NeZero (Module.finrank ℝ (Poincare.D12.VolumeIBP.Vec d))] {H : Type u_1} [inst : TopologicalSpace H]
  {I : ModelWithCorners ℝ (Poincare.D12.VolumeIBP.Vec d) H} {M : Type u_2} [inst_1 : TopologicalSpace M]
  [inst_2 : ChartedSpace H M] [IsManifold I (↑⊤) M] [Bundle.RiemannianBundle (TangentSpace I)] [I.Boundaryless]
  (α β : M) {s : Set (Poincare.D12.VolumeIBP.Vec d)},
  IsOpen s →
    ∀ {y : Poincare.D12.VolumeIBP.Vec d},
      y ∈ s →
        fderivWithin ℝ (Poincare.D13.Riemannian.chartTransition α β) s y =
          fderivWithin ℝ (Poincare.D13.Riemannian.chartTransition α β) (Set.range ↑I) y
@Poincare.D13.Riemannian.metric_transform_chartOverlap : ∀ {d : ℕ}
  [NeZero (Module.finrank ℝ (Poincare.D12.VolumeIBP.Vec d))] {H : Type u_1} [inst : TopologicalSpace H]
  {I : ModelWithCorners ℝ (Poincare.D12.VolumeIBP.Vec d) H} {M : Type u_2} [inst_1 : TopologicalSpace M]
  [inst_2 : ChartedSpace H M] [inst_3 : IsManifold I (↑⊤) M] [inst_4 : Bundle.RiemannianBundle (TangentSpace I)]
  [I.Boundaryless] (α β : M) {x : M},
  x ∈ (chartAt H α).source →
    x ∈ (chartAt H β).source →
      IsOpen (Poincare.D13.Riemannian.chartOverlap α β) →
        Poincare.D13.Riemannian.chartGramMatrix (Pi.basisFun ℝ (Fin d)) β x =
          (Poincare.D13.ManifoldIBP.jacobianOf (Poincare.D13.Riemannian.chartTransition α β)
                  (Poincare.D13.Riemannian.chartOverlap α β) (↑(extChartAt I β) x)).transpose *
              Poincare.D13.Riemannian.chartGramMatrix (Pi.basisFun ℝ (Fin d)) α x *
            Poincare.D13.ManifoldIBP.jacobianOf (Poincare.D13.Riemannian.chartTransition α β)
              (Poincare.D13.Riemannian.chartOverlap α β) (↑(extChartAt I β) x)
@Poincare.D13.Riemannian.chartOverlap_eq_overlapOf : ∀ {d : ℕ}
  [NeZero (Module.finrank ℝ (Poincare.D12.VolumeIBP.Vec d))] {H : Type u_1} [inst : TopologicalSpace H]
  {I : ModelWithCorners ℝ (Poincare.D12.VolumeIBP.Vec d) H} {M : Type u_2} [inst_1 : TopologicalSpace M]
  [inst_2 : ChartedSpace H M] [IsManifold I (↑⊤) M] [Bundle.RiemannianBundle (TangentSpace I)] (α β : M),
  Poincare.D13.Riemannian.chartOverlap α β =
    Poincare.D13.ManifoldIBP.overlapOf (fun n => if n = 0 then ↑(extChartAt I β).symm else ↑(extChartAt I α).symm)
      (fun n => if n = 0 then (extChartAt I β).target else (extChartAt I α).target) 1 0
@Poincare.D13.ManifoldIBP.OverlapAtlas.gradInnerInverse_chartTransition : ∀ {M : Type u_1} [inst : MeasurableSpace M]
  {n : ℕ} (A : Poincare.D13.ManifoldIBP.OverlapAtlas M (n + 1)),
  (∀ (i j : ℕ), IsOpen (Poincare.D13.ManifoldIBP.overlapOf A.chart A.source i j)) →
    ∀ (i j : ℕ),
      ∀ y ∈ Poincare.D13.ManifoldIBP.overlapOf A.chart A.source i j,
        ∀ (u v : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
          DifferentiableAt ℝ u (A.transition i j y) →
            DifferentiableAt ℝ v (A.transition i j y) →
