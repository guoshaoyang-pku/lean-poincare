      Measurable Du →
        Measurable Guv →
          (∀ (j : ι), ContDiff ℝ (↑⊤) (ψ j)) →
            (∀ (j : ι),
                tsupport (ψ j) ⊆
                  Poincare.D13.ManifoldIBP.overlapOf (Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart
                    (Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).source (chartOf j) b) →
              (∀ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                  v ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart b y) ≠ 0 → ∑ j, ψ j y = 1) →
                (∀ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                    v m ≠ 0 →
                      m ∈
                        (Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart b ''
                          (Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).source b) →
                  (∀ (i : ℕ), ContDiff ℝ 2 fun y => f ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart i y)) →
                    (∀ (i : ℕ), ContDiff ℝ 2 fun y => u ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart i y)) →
                      (∀ (i : ℕ),
                          ContDiff ℝ 2 fun y => v ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart i y)) →
                        (HasCompactSupport fun y => v ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart b y)) →
                          (∀ (i : ℕ),
                              ∀ y ∈ (Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).source i,
