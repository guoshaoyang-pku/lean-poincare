      ∀ y ∈ Poincare.D13.ManifoldIBP.overlapOf self.chart self.source i j,
        self.chart i (self.transition i j y) = self.chart j y
  Poincare.D13.ManifoldIBP.OverlapAtlas.transition_diff : ∀ (i j : ℕ),
