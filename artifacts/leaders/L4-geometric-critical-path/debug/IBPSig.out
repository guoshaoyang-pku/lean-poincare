@Poincare.D13.ManifoldIBP.SmoothOverlapAtlas.globalWeightedIBP_of_cover_partial_ae : ∀ {M : Type u_1}
  [inst : MeasurableSpace M] {n : ℕ} {A : Poincare.D13.ManifoldIBP.SmoothOverlapAtlas M (n + 1)},
  (∀ (i j : ℕ) (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
      A.chart j y ∈ A.chart i '' A.source i → A.transition i j y ∈ A.source i) →
    ∀ (b : ℕ) {ι : Type u_2} [Fintype ι] (chartOf : ι → ℕ) (f u v Du Guv : M → ℝ),
      Measurable f →
        Measurable v →
          Measurable Du →
            Measurable Guv →
              (∀ (m : M), v m ≠ 0 → m ∈ A.chart b '' A.source b) →
                (∀ (i : ℕ), ContDiff ℝ 2 fun y => f (A.chart i y)) →
                  (∀ (i : ℕ), ContDiff ℝ 2 fun y => u (A.chart i y)) →
                    (∀ (i : ℕ), ContDiff ℝ 2 fun y => v (A.chart i y)) →
                      (HasCompactSupport fun y => v (A.chart b y)) →
                        (tsupport fun y => v (A.chart b y)) ⊆ A.source b →
                          A.chart b '' A.source b ⊆ ⋃ j, A.chart (chartOf j) '' A.source (chartOf j) →
                            (∀ (i : ℕ),
                                ∀ y ∈ A.source i,
                                  Du (A.chart i y) =
                                    (A.metric i).driftLaplacian (fun z => f (A.chart i z)) (fun z => u (A.chart i z))
                                      y) →
                              (∀ (i : ℕ),
                                  ∀ y ∈ A.source i,
                                    Guv (A.chart i y) =
                                      (A.metric i).gradInnerInverse (fun z => u (A.chart i z))
                                        (fun z => v (A.chart i z)) y) →
                                (∀ (m : M), Guv m ≠ 0 → m ∈ A.chart b '' A.source b) →
                                  (∀ (i j : ℕ) (K : Set (Poincare.D12.VolumeIBP.Vec (n + 1))),
                                      IsCompact K → IsCompact (A.transition i j ⁻¹' K)) →
                                    (∀ (i : ℕ), MeasureTheory.volume (frontier (A.source i)) = 0) →
                                      ∫ (m : M),
                                          Du m * v m ∂(A.globalMeasure MeasureTheory.volume).withDensity (A.weight f) =
                                        -∫ (m : M),
                                            Guv m ∂(A.globalMeasure MeasureTheory.volume).withDensity (A.weight f)
