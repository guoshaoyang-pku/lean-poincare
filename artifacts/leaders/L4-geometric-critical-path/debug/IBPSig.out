                                  (∀ (j : ι),
                                      ∀ᵐ (y : Poincare.D12.VolumeIBP.Vec (n + 1)),
                                        y ∈ A.source (chartOf j) →
                                          Du (A.chart (chartOf j) y) =
                                            (A.metric (chartOf j)).driftLaplacian (fun z => f (A.chart (chartOf j) z))
                                              (fun z => u (A.chart (chartOf j) z)) y) →
