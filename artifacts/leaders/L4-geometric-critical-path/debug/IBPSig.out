                                  ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).metric i).driftLaplacian
                                    (fun z => f ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart i z))
                                    (fun z => u ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart i z)) y) →
                            (∀ (i : ℕ),
                                ∀ y ∈ (Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).source i,
                                  Guv ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart i y) =
                                    ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).metric i).gradInnerInverse
                                      (fun z => u ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart i z))
                                      (fun z => v ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart i z)) y) →
                              (∀ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                                  Guv m ≠ 0 →
                                    m ∈
                                      (Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).chart b ''
                                        (Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).source b) →
                                (∀ (j : ι), HasCompactSupport (ψ j)) →
                                  (∀ (j : ι),
                                      MeasureTheory.Integrable
                                        (fun m =>
                                          Du m * (Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).pouPiece b v (ψ j) m)
                                        (((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure
                                              MeasureTheory.volume).withDensity
                                          ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight f))) →
                                    (∀ (j : ι),
                                        MeasureTheory.Integrable
                                          (fun m =>
                                            (Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).pouPairing b (chartOf j) u
                                              v (ψ j) m)
                                          (((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure
                                                MeasureTheory.volume).withDensity
                                            ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight f))) →
                                      ∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                                          Du m *
                                            v
