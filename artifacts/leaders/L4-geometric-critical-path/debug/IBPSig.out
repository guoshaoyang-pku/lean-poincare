  A.IsTotal →
    ∀ (b : ℕ) {ι : Type u_2} [inst_1 : Fintype ι] (chartOf : ι → ℕ) (ψ : ι → Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ)
      (f u v Du Guv : M → ℝ),
      Measurable v →
        (∀ (j : ι), ContDiff ℝ (↑⊤) (ψ j)) →
          (∀ (y : Poincare.D12.VolumeIBP.Vec (n + 1)), v (A.chart b y) ≠ 0 → ∑ j, ψ j y = 1) →
            (∀ (i : ℕ), ContDiff ℝ 2 fun y => f (A.chart i y)) →
              (∀ (i : ℕ), ContDiff ℝ 2 fun y => u (A.chart i y)) →
                (∀ (i : ℕ), ContDiff ℝ 2 fun y => v (A.chart i y)) →
                  (HasCompactSupport fun y => v (A.chart b y)) →
                    (∀ (i : ℕ),
                        ∀ y ∈ A.source i,
                          Du (A.chart i y) =
                            (A.metric i).driftLaplacian (fun z => f (A.chart i z)) (fun z => u (A.chart i z)) y) →
                      (∀ (i : ℕ),
                          ∀ y ∈ A.source i,
                            Guv (A.chart i y) =
                              (A.metric i).gradInnerInverse (fun z => u (A.chart i z)) (fun z => v (A.chart i z)) y) →
                        (∀ (j : ι), HasCompactSupport fun y => A.pouPiece b v (ψ j) (A.chart (chartOf j) y)) →
                          (∀ (j : ι),
                              MeasureTheory.Integrable (fun m => Du m * A.pouPiece b v (ψ j) m)
                                ((A.globalMeasure MeasureTheory.volume).withDensity (A.weight f))) →
                            (∀ (j : ι),
                                MeasureTheory.Integrable (fun m => A.pouPairing b (chartOf j) u v (ψ j) m)
                                  ((A.globalMeasure MeasureTheory.volume).withDensity (A.weight f))) →
                              ∫ (m : M), Du m * v m ∂(A.globalMeasure MeasureTheory.volume).withDensity (A.weight f) =
                                -∫ (m : M), Guv m ∂(A.globalMeasure MeasureTheory.volume).withDensity (A.weight f)
