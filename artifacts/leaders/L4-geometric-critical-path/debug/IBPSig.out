                m ∂(Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwo n G).globalMeasure MeasureTheory.volume =
          -∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
              G.gradInnerInverse U V
                m ∂(Poincare.D13.ManifoldIBP.OverlapAtlas.dilationAtlasTwo n G).globalMeasure MeasureTheory.volume
