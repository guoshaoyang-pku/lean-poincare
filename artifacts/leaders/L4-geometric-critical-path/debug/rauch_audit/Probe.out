@abs_sub_le_of_deriv_bound : ∀ {f f' : ℝ → ℝ} {a b C : ℝ},
  a ≤ b →
    ContinuousOn f (Icc a b) →
      ContinuousOn f' (Icc a b) →
        (∀ t ∈ Ioo a b, HasDerivAtR f (f' t) t) → (∀ t ∈ Ioo a b, |f' t| ≤ C) → |f b - f a| ≤ C * (b - a)
@jacobi_linear_bounds : ∀ {k u du ddu : ℝ → ℝ} {T B : ℝ},
  JacobiSolutionOn k u du ddu 0 T →
    ContinuousOn ddu (Icc 0 T) →
      0 ≤ B →
        (∀ t ∈ Ioo 0 T, |ddu t| ≤ B) →
          u 0 = 0 → du 0 = 1 → (∀ t ∈ Ioo 0 T, |du t - 1| ≤ B * t) ∧ ∀ t ∈ Ioo 0 T, |u t - t| ≤ B * t ^ 2
@jacobi_pos_and_ratio_bound : ∀ {k u du ddu : ℝ → ℝ} {T B : ℝ},
  JacobiSolutionOn k u du ddu 0 T →
    ContinuousOn ddu (Icc 0 T) →
      0 ≤ B →
        (∀ t ∈ Ioo 0 T, |ddu t| ≤ B) →
          u 0 = 0 → du 0 = 1 → ∀ {t : ℝ}, t ∈ Ioo 0 T → B * t ≤ 1 / 2 → 0 < u t ∧ |du t / u t - 1 / t| ≤ 4 * B
@euclideanNormalizedOn_of_jacobi : ∀ {k u du ddu : ℝ → ℝ} {T B t₀ : ℝ},
  JacobiSolutionOn k u du ddu 0 T →
    ContinuousOn ddu (Icc 0 T) →
      0 ≤ B →
        (∀ t ∈ Ioo 0 T, |ddu t| ≤ B) →
          u 0 = 0 →
            du 0 = 1 → 0 < t₀ → t₀ ≤ T → B * t₀ ≤ 1 / 2 → EuclideanNormalizedOn (fun t => du t / u t) 1 (4 * B) t₀
@riccati_identity_of_jacobi : ∀ {k u du ddu : ℝ → ℝ} {T : ℝ},
  JacobiSolutionOn k u du ddu 0 T →
    (∀ t ∈ Ioc 0 T, 0 < u t) →
      (∀ t ∈ Ioo 0 T, HasDerivAtR (fun s => du s / u s) ((ddu t * u t - du t ^ 2) / u t ^ 2) t) ∧
        ∀ t ∈ Ioo 0 T, (ddu t * u t - du t ^ 2) / u t ^ 2 + (du t / u t) ^ 2 / 1 + k t = 0
@rauch_upper_of_jacobi : ∀ {k u du ddu : ℝ → ℝ} {T B t₀ : ℝ},
  0 < T →
    0 ≤ B →
      0 < t₀ →
        t₀ ≤ T →
          B * t₀ ≤ 1 / 2 →
            JacobiSolutionOn k u du ddu 0 T →
              ContinuousOn ddu (Icc 0 T) →
                (∀ t ∈ Ioo 0 T, |ddu t| ≤ B) →
                  u 0 = 0 →
                    du 0 = 1 → (∀ t ∈ Ioc 0 T, 0 < u t) → (∀ t ∈ Ioo 0 T, 0 ≤ k t) → ∀ t ∈ Ioo 0 T, du t / u t ≤ 1 / t
@jacobi_areaRatio_antitone : ∀ {k u du ddu : ℝ → ℝ} {T B t₀ : ℝ},
  0 < T →
    0 ≤ B →
      0 < t₀ →
        t₀ ≤ T →
          B * t₀ ≤ 1 / 2 →
            JacobiSolutionOn k u du ddu 0 T →
              ContinuousOn ddu (Icc 0 T) →
                (∀ t ∈ Ioo 0 T, |ddu t| ≤ B) →
                  u 0 = 0 →
                    du 0 = 1 →
                      (∀ t ∈ Ioc 0 T, 0 < u t) →
                        (∀ t ∈ Ioo 0 T, 0 ≤ k t) →
                          ∀ ⦃s : ℝ⦄, s ∈ Ioc 0 T → ∀ ⦃t : ℝ⦄, t ∈ Ioc 0 T → s ≤ t → u t / t ≤ u s / s
sin_jacobiSolution : JacobiSolutionOn (fun x => 1) Real.sin Real.cos (fun t => -Real.sin t) 0 (1 / 2)
sin_rauch_witness : ∀ t ∈ Ioo 0 (1 / 2), Real.cos t / Real.sin t ≤ 1 / t
sin_areaRatio_witness : ∀ ⦃s : ℝ⦄,
  s ∈ Ioc 0 (1 / 2) → ∀ ⦃t : ℝ⦄, t ∈ Ioc 0 (1 / 2) → s ≤ t → Real.sin t / t ≤ Real.sin s / s
