@Poincare.L4.Compactness.coveringNumber_le_of_ghDist_lt : ∀ {X : Type u_1} [inst : MetricSpace X]
  [inst_1 : CompactSpace X] [inst_2 : Nonempty X] {Y : Type u_1} [inst_3 : MetricSpace Y] [inst_4 : CompactSpace Y]
  [inst_5 : Nonempty Y] {r : ℝ},
  GromovHausdorff.ghDist X Y < r →
    ∀ (δ ε : NNReal), 2 * r + ↑δ < ↑ε → Metric.coveringNumber ε Set.univ ≤ Metric.coveringNumber δ Set.univ
@Poincare.L4.ManifoldIBP.metricInnerInverse_self_nonneg : ∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1))
  (x p : Poincare.D12.VolumeIBP.Vec (n + 1)), 0 ≤ G.metricInnerInverse x p p
@Poincare.L4.ManifoldIBP.gradInnerInverse_self_nonneg : ∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1))
  (u : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ) (x : Poincare.D12.VolumeIBP.Vec (n + 1)), 0 ≤ G.gradInnerInverse u u x
@Poincare.L4.ManifoldIBP.halfSpaceAtlas_dirichletEnergy_nonneg : ∀ {n : ℕ}
  (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (F V : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
  ContDiff ℝ 2 F →
    ContDiff ℝ 2 V →
      HasCompactSupport V →
        tsupport V ⊆ {y | y 0 < 1} →
          MeasureTheory.Integrable (fun m => G.gradInnerInverse V V m)
              (((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure MeasureTheory.volume).withDensity
                ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight F)) ∧
            0 ≤
              ∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                G.gradInnerInverse V V
                  m ∂((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure MeasureTheory.volume).withDensity
                  ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight F)
@Poincare.L4.ManifoldIBP.halfSpaceAtlas_weightedLaplacian_selfAdjoint : ∀ {n : ℕ}
  (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (F u v : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
  ContDiff ℝ 2 F →
    ContDiff ℝ 2 u →
      ContDiff ℝ 2 v →
        HasCompactSupport u →
          tsupport u ⊆ {y | y 0 < 1} →
            HasCompactSupport v →
              tsupport v ⊆ {y | y 0 < 1} →
                ∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                    G.driftLaplacian F u m *
                      v
                        m ∂((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure
                          MeasureTheory.volume).withDensity
                      ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight F) =
                  ∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                    G.driftLaplacian F v m *
                      u
                        m ∂((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure
                          MeasureTheory.volume).withDensity
                      ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight F)
@Poincare.D12.GeometricCompactness.cover_transfer_of_ghDist : ∀ {X : Type u_1} [inst : MetricSpace X]
  [inst_1 : CompactSpace X] [inst_2 : Nonempty X] {Y : Type u_1} [inst_3 : MetricSpace Y] [inst_4 : CompactSpace Y]
  [inst_5 : Nonempty Y] {ι : Type u_1} [Fintype ι] {c : ι → Y} {δ r ε : ℝ},
  GromovHausdorff.ghDist X Y < r →
    (∀ (y : Y), ∃ i, dist y (c i) < δ) →
      2 * r + δ < ε → ∃ s, Cardinal.mk ↑s ≤ Cardinal.mk ι ∧ Set.univ ⊆ ⋃ x ∈ s, Metric.ball x ε
@Poincare.D13.ManifoldIBP.OverlapAtlas.halfSpaceAtlas_greenIdentity : ∀ {n : ℕ}
  (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (F U V : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
  ContDiff ℝ 2 F →
    ContDiff ℝ 2 U →
      ContDiff ℝ 2 V →
        HasCompactSupport U →
          HasCompactSupport V →
            tsupport U ⊆ {y | y 0 < 1} →
              tsupport V ⊆ {y | y 0 < 1} →
                ∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                    G.driftLaplacian F U m *
                      V
                        m ∂((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure
                          MeasureTheory.volume).withDensity
                      ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight F) =
                  ∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                    U m *
                      G.driftLaplacian F V
                        m ∂((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure
                          MeasureTheory.volume).withDensity
                      ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight F)
@Poincare.D13.ManifoldIBP.OverlapAtlas.halfSpaceAtlas_integrable_dirichlet : ∀ {n : ℕ}
  (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (F V : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
  ContDiff ℝ 2 F →
    ContDiff ℝ 2 V →
      HasCompactSupport V →
        tsupport V ⊆ {y | y 0 < 1} →
          MeasureTheory.Integrable (fun m => G.driftLaplacian F V m * V m)
              (((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure MeasureTheory.volume).withDensity
                ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight F)) ∧
            MeasureTheory.Integrable (fun m => G.gradInnerInverse V V m)
              (((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure MeasureTheory.volume).withDensity
                ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight F))
@Poincare.D13.ManifoldIBP.OverlapAtlas.halfSpaceAtlas_dirichletEnergy : ∀ {n : ℕ}
  (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (F V : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
  ContDiff ℝ 2 F →
    ContDiff ℝ 2 V →
      HasCompactSupport V →
        tsupport V ⊆ {y | y 0 < 1} →
          ∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
              G.driftLaplacian F V m *
                V
                  m ∂((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure MeasureTheory.volume).withDensity
                ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight F) =
            -∫ (m : Poincare.D12.VolumeIBP.Vec (n + 1)),
                G.gradInnerInverse V V
                  m ∂((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).globalMeasure MeasureTheory.volume).withDensity
                  ((Poincare.D13.ManifoldIBP.OverlapAtlas.hsAtlas G).weight F)
@Metric.exists_set_encard_eq_coveringNumber : ∀ {X : Type u_1} [inst : PseudoEMetricSpace X] {A : Set X} {ε : NNReal},
  Metric.coveringNumber ε A ≠ ⊤ → ∃ C ⊆ A, C.Finite ∧ Metric.IsCover ε A C ∧ C.encard = Metric.coveringNumber ε A
@Metric.IsCover : {X : Type u_1} → [PseudoEMetricSpace X] → NNReal → Set X → Set X → Prop
@Metric.IsCover.coveringNumber_le_encard : ∀ {X : Type u_1} [inst : PseudoEMetricSpace X] {A C : Set X} {ε : NNReal},
  C ⊆ A → Metric.IsCover ε A C → Metric.coveringNumber ε A ≤ C.encard
@Metric.isCover_iff_subset_iUnion_closedBall : ∀ {X : Type u_1} [inst : PseudoMetricSpace X] {ε : NNReal} {s N : Set X},
  Metric.IsCover ε s N ↔ s ⊆ ⋃ y ∈ N, Metric.closedBall y ↑ε
@Metric.coveringNumber : {X : Type u_1} → [PseudoEMetricSpace X] → NNReal → Set X → ℕ∞
GromovHausdorff.ghDist : (X : Type u_1) →
  (Y : Type u_2) →
    [inst : MetricSpace X] →
      [Nonempty X] → [CompactSpace X] → [inst : MetricSpace Y] → [Nonempty Y] → [CompactSpace Y] → ℝ
