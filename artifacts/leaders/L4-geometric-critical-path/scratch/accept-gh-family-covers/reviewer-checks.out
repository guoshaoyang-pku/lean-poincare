'Poincare.L4.Compactness.uniformCovers_of_uniformDoubling' depends on axioms: [propext, Classical.choice, Quot.sound]
@Poincare.L4.Compactness.exists_finset_ball_cover_card_le_of_coveringNumber_le : ∀ {X : Type u_1}
  [inst : PseudoMetricSpace X] {A : Set X} {δ : NNReal} {ε : ℝ} {K : ℕ},
  ↑δ < ε → coveringNumber δ A ≤ ↑K → ∃ F, F.card ≤ K ∧ A ⊆ ⋃ x ∈ ↑F, ball x ε
@Poincare.L4.Compactness.exists_set_ball_cover_card_le_of_coveringNumber_le : ∀ {X : Type u_1}
  [inst : PseudoMetricSpace X] {A : Set X} {δ : NNReal} {ε : ℝ} {K : ℕ},
  ↑δ < ε → coveringNumber δ A ≤ ↑K → ∃ s, Cardinal.mk ↑s ≤ ↑K ∧ A ⊆ ⋃ x ∈ s, ball x ε
Poincare.L4.Compactness.exists_div_pow_two_le : ∀ (R δ : NNReal), 0 < δ → ∃ k, R / 2 ^ k ≤ δ
@Poincare.L4.Compactness.coveringNumber_univ_le_of_uniformDoubling : ∀ {t : Set GromovHausdorff.GHSpace} {n : ℕ},
  (∀ p ∈ t, ∀ (c : p.Rep) (r : NNReal), coveringNumber r (closedBall c (2 * ↑r)) ≤ ↑n) →
    ∀ {R : NNReal},
      (∀ p ∈ t, ∃ y, univ ⊆ closedBall y (2 * ↑R)) →
        ∀ {p : GromovHausdorff.GHSpace},
          p ∈ t → ∀ {δ : NNReal} {k : ℕ}, R / 2 ^ k ≤ δ → coveringNumber δ univ ≤ ↑n ^ (k + 2)
@Poincare.L4.Compactness.uniformCovers_of_uniformDoubling : ∀ {t : Set GromovHausdorff.GHSpace} {n : ℕ},
  (∀ p ∈ t, ∀ (c : p.Rep) (r : NNReal), coveringNumber r (closedBall c (2 * ↑r)) ≤ ↑n) →
    (∃ R, ∀ p ∈ t, ∃ y, univ ⊆ closedBall y (2 * ↑R)) →
      (∃ C, ∀ p ∈ t, diam univ ≤ C) ∧
        ∀ (ε : ℝ), 0 < ε → ∃ K, ∀ p ∈ t, ∃ s, Cardinal.mk ↑s ≤ ↑K ∧ univ ⊆ ⋃ x ∈ s, ball x ε
@Poincare.L4.Compactness.uniformCovers_of_uniformDoubling_familyScale : ∀ {t : Set GromovHausdorff.GHSpace} {n : ℕ},
  (∀ p ∈ t, ∀ (c : p.Rep) (r : NNReal), coveringNumber r (closedBall c (2 * ↑r)) ≤ ↑n) →
    ∀ (Rp : GromovHausdorff.GHSpace → NNReal) {R : NNReal},
      (∀ p ∈ t, Rp p ≤ R) →
        (∀ p ∈ t, ∃ y, univ ⊆ closedBall y (2 * ↑(Rp p))) →
          (∃ C, ∀ p ∈ t, diam univ ≤ C) ∧
            ∀ (ε : ℝ), 0 < ε → ∃ K, ∀ p ∈ t, ∃ s, Cardinal.mk ↑s ≤ ↑K ∧ univ ⊆ ⋃ x ∈ s, ball x ε
@Poincare.L4.Compactness.coveringNumber_univ_le_of_ghDist_lt_of_familyDoubling : ∀ {X : Type} [inst : MetricSpace X]
  [inst_1 : CompactSpace X] [inst_2 : Nonempty X] {t : Set GromovHausdorff.GHSpace} {n : ℕ},
  (∀ p ∈ t, ∀ (c : p.Rep) (r : NNReal), coveringNumber r (closedBall c (2 * ↑r)) ≤ ↑n) →
    ∀ {R : NNReal},
      (∀ p ∈ t, ∃ y, univ ⊆ closedBall y (2 * ↑R)) →
        ∀ {p : GromovHausdorff.GHSpace},
          p ∈ t →
            ∀ {r : ℝ},
              GromovHausdorff.ghDist X p.Rep < r →
                ∀ {δ ε : NNReal}, 2 * r + ↑δ < ↑ε → ∀ {k : ℕ}, R / 2 ^ k ≤ δ → coveringNumber ε univ ≤ ↑n ^ (k + 2)
@Poincare.L4.Compactness.totallyBounded_of_uniformDoubling : ∀ {t : Set GromovHausdorff.GHSpace} {n : ℕ},
  (∀ p ∈ t, ∀ (c : p.Rep) (r : NNReal), coveringNumber r (closedBall c (2 * ↑r)) ≤ ↑n) →
    (∃ R, ∀ p ∈ t, ∃ y, univ ⊆ closedBall y (2 * ↑R)) → TotallyBounded t
@Poincare.L4.Compactness.isCompact_of_uniformDoubling : ∀ {t : Set GromovHausdorff.GHSpace},
  IsClosed t →
    ∀ {n : ℕ},
      (∀ p ∈ t, ∀ (c : p.Rep) (r : NNReal), coveringNumber r (closedBall c (2 * ↑r)) ≤ ↑n) →
        (∃ R, ∀ p ∈ t, ∃ y, univ ⊆ closedBall y (2 * ↑R)) → IsCompact t
Poincare.L4.Compactness.finiteDiscFamily_hypotheses : ∀ (N : ℕ),
  (∀ p ∈ Poincare.L4.Compactness.finiteDiscFamily N,
      ∀ (c : p.Rep) (r : NNReal), coveringNumber r (closedBall c (2 * ↑r)) ≤ ↑(N + 1)) ∧
    ∃ R, ∀ p ∈ Poincare.L4.Compactness.finiteDiscFamily N, ∃ y, univ ⊆ closedBall y (2 * ↑R)
Poincare.L4.Compactness.finiteDiscFamily_coveringNumber_quarter : ∀ (N : ℕ) {p : GromovHausdorff.GHSpace},
  p ∈ Poincare.L4.Compactness.finiteDiscFamily N → coveringNumber (1 / 4) univ ≤ ↑((N + 1) ^ 5)
Poincare.L4.Compactness.finiteDiscFamily_uniformCovers_half_explicit : ∀ (N : ℕ),
  ∀ p ∈ Poincare.L4.Compactness.finiteDiscFamily N, ∃ s, Cardinal.mk ↑s ≤ ↑N + 1 ∧ univ ⊆ ⋃ x ∈ s, ball x (1 / 2)
Poincare.L4.Compactness.finiteDiscFamily_cover_half_card_ge : ∀ (N : ℕ)
  {s : Set (Poincare.L4.Compactness.discGH N).Rep}, univ ⊆ ⋃ x ∈ s, ball x (1 / 2) → ↑N + 1 ≤ Cardinal.mk ↑s
Poincare.L4.Compactness.not_uniformCovers_allDiscFamily : ¬∀ (ε : ℝ),
    0 < ε → ∃ K, ∀ p ∈ Poincare.L4.Compactness.allDiscFamily, ∃ s, Cardinal.mk ↑s ≤ ↑K ∧ univ ⊆ ⋃ x ∈ s, ball x ε
Poincare.L4.Compactness.not_uniformDoubling_allDiscFamily : ¬∃ n,
    ∀ p ∈ Poincare.L4.Compactness.allDiscFamily,
      ∀ (c : p.Rep) (r : NNReal), coveringNumber r (closedBall c (2 * ↑r)) ≤ ↑n
