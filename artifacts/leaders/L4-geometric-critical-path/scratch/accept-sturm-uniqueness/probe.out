sturmModel_first_zero_witness : ∃ k u du ddu K,
  0 < K ∧
    (∀ t ∈ Set.Icc 0 Real.pi, k t ≤ K) ∧
      Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu 0 (2 * Real.pi) ∧
        u 0 = 0 ∧
          u Real.pi = 0 ∧
            √K * (Real.pi - 0) ≤ Real.pi ∧ (∀ t ∈ Set.Ioo 0 Real.pi, u t ≠ 0) ∧ ∀ t ∈ Set.Ioo 0 Real.pi, k t = K
