@sturmModel_pos_at_right : ∀ {K a c : ℝ}, 0 < K → a < c → √K * (c - a) < Real.pi → 0 < sturmModel K a c
@sturmModel_eq_zero_at_pi_sqrt : ∀ {K a : ℝ}, 0 < K → sturmModel K a (a + Real.pi / √K) = 0
@wronskian_sturmModel_eq_zero_of_pos : ∀ {k : ℝ → ℝ} {K a b c : ℝ} {u du ddu : ℝ → ℝ},
  0 < K →
    √K * (c - a) < Real.pi →
      (∀ t ∈ Set.Ioo a c, k t = K) →
        Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu a b →
          c ∈ Set.Ioo a b →
            u a = 0 →
              u c = 0 →
                (∀ t ∈ Set.Ioo a c, 0 < u t) →
                  Poincare.D12.ComparisonGeodesics.HasDerivAtR u (du c) c →
                    ∀ t ∈ Set.Icc a c,
                      Poincare.D12.ComparisonGeodesics.wronskian (sturmModel K a) (sturmModelDeriv K a) u du t = 0
@exists_smul_sturmModel_of_wronskian_eq_zero : ∀ {K a c : ℝ} {u du : ℝ → ℝ},
  0 < K →
    √K * (c - a) ≤ Real.pi →
      (∀ t ∈ Set.Ioo a c, Poincare.D12.ComparisonGeodesics.HasDerivAtR u (du t) t) →
        (∀ t ∈ Set.Icc a c,
            Poincare.D12.ComparisonGeodesics.wronskian (sturmModel K a) (sturmModelDeriv K a) u du t = 0) →
          ∃ lam, ∀ t ∈ Set.Ioo a c, u t = lam * sturmModel K a t
@wronskian_sturmModel_eq_zero_of_curvature_eq : ∀ {k : ℝ → ℝ} {K a b c : ℝ} {u du ddu : ℝ → ℝ},
  0 < K →
    (∀ t ∈ Set.Ioo a c, k t = K) →
      Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu a b →
        c ∈ Set.Ioo a b →
          u a = 0 →
            ∀ t ∈ Set.Icc a c,
              Poincare.D12.ComparisonGeodesics.wronskian (sturmModel K a) (sturmModelDeriv K a) u du t = 0
@exists_smul_sturmModel_of_curvature_eq : ∀ {k : ℝ → ℝ} {K a b c : ℝ} {u du ddu : ℝ → ℝ},
  0 < K →
    √K * (c - a) ≤ Real.pi →
      (∀ t ∈ Set.Ioo a c, k t = K) →
        Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu a b →
          c ∈ Set.Ioo a b → u a = 0 → ∃ lam, ∀ t ∈ Set.Ioo a c, u t = lam * sturmModel K a t
@eq_zero_of_wronskian_sturmModel_eq_zero : ∀ {K a c : ℝ} {u du : ℝ → ℝ},
  0 < K →
    √K * (c - a) < Real.pi →
      a < c →
        ContinuousOn u (Set.Icc a c) →
          (∀ t ∈ Set.Ioo a c, Poincare.D12.ComparisonGeodesics.HasDerivAtR u (du t) t) →
            u c = 0 →
              (∀ t ∈ Set.Icc a c,
                  Poincare.D12.ComparisonGeodesics.wronskian (sturmModel K a) (sturmModelDeriv K a) u du t = 0) →
                ∀ t ∈ Set.Ioo a c, u t = 0
@no_first_zero_of_curvature_le_of_lt_pi : ∀ {k : ℝ → ℝ} {K a b c : ℝ} {u du ddu : ℝ → ℝ},
  0 < K →
    √K * (c - a) < Real.pi →
      (∀ t ∈ Set.Icc a c, k t ≤ K) →
        Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu a b →
          c ∈ Set.Ioo a b → u a = 0 → u c = 0 → (∀ t ∈ Set.Ioo a c, u t ≠ 0) → False
@no_first_zero_before_pi_sqrt_of_curvature_le : ∀ {k : ℝ → ℝ} {K b c : ℝ} {u du ddu : ℝ → ℝ},
  0 < K →
    √K * c < Real.pi →
      (∀ t ∈ Set.Icc 0 c, k t ≤ K) →
        Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu 0 b →
          c ∈ Set.Ioo 0 b → u 0 = 0 → u c = 0 → (∀ t ∈ Set.Ioo 0 c, u t ≠ 0) → False
@nonvanishing_near_left_of_deriv_ne : ∀ {u : ℝ → ℝ} {a m : ℝ},
  Poincare.D12.ComparisonGeodesics.HasDerivAtR u m a → m ≠ 0 → ∃ ε > 0, ∀ (t : ℝ), a < t → t < a + ε → u t ≠ u a
@no_zero_of_curvature_le_of_deriv_ne : ∀ {k : ℝ → ℝ} {K a b : ℝ} {u du ddu : ℝ → ℝ},
  0 < K →
    √K * (b - a) < Real.pi →
      (∀ t ∈ Set.Icc a b, k t ≤ K) →
        Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu a b →
          Poincare.D12.ComparisonGeodesics.HasDerivAtR u (du a) a → u a = 0 → du a ≠ 0 → ∀ c ∈ Set.Ioo a b, u c ≠ 0
strict_span_necessary : ∃ k u du ddu,
  (∀ t ∈ Set.Ioo 0 Real.pi, k t = 1) ∧
    Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu 0 (2 * Real.pi) ∧
      u 0 = 0 ∧ u Real.pi = 0 ∧ (∀ t ∈ Set.Ioo 0 Real.pi, u t ≠ 0) ∧ √1 * Real.pi = Real.pi
