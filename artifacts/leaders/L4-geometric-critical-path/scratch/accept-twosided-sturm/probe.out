@Poincare.L4.GeodesicComparison.jacobiSolutionOn_mono_Icc : ∀ {k u du ddu : ℝ → ℝ} {a b b' : ℝ},
  Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu a b →
    a ≤ b' → b' ≤ b → Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu a b'
@Poincare.L4.GeodesicComparison.sturmModel_pos_of_le : ∀ {K a c t : ℝ},
  0 < K → √K * (c - a) ≤ Real.pi → t ∈ Set.Ioo a c → 0 < Poincare.L4.GeodesicComparison.sturmModel K a t
@Poincare.L4.GeodesicComparison.eq_curvature_of_first_jacobi_zero_of_curvature_le : ∀ {k : ℝ → ℝ} {K a b c : ℝ}
  {u du ddu : ℝ → ℝ},
  0 < K →
    √K * (c - a) ≤ Real.pi →
      (∀ t ∈ Set.Icc a c, k t ≤ K) →
        Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu a b →
          c ∈ Set.Ioo a b → u a = 0 → u c = 0 → (∀ t ∈ Set.Ioo a c, u t ≠ 0) → ∀ t ∈ Set.Ioo a c, k t = K
@Poincare.L4.GeodesicComparison.eq_curvature_of_first_jacobi_zero_before_pi_sqrt : ∀ {k : ℝ → ℝ} {K b c : ℝ}
  {u du ddu : ℝ → ℝ},
  0 < K →
    √K * c ≤ Real.pi →
      (∀ t ∈ Set.Icc 0 c, k t ≤ K) →
        Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu 0 b →
          c ∈ Set.Ioo 0 b → u 0 = 0 → u c = 0 → (∀ t ∈ Set.Ioo 0 c, u t ≠ 0) → ∀ t ∈ Set.Ioo 0 c, k t = K
@Poincare.L4.GeodesicComparison.first_jacobi_zero_le_of_curvature_deficit : ∀ {k : ℝ → ℝ} {K a b c t₀ : ℝ}
  {u du ddu : ℝ → ℝ},
  0 < K →
    √K * (c - a) ≤ Real.pi →
      (∀ t ∈ Set.Icc a c, k t ≤ K) →
        Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu a b →
          c ∈ Set.Ioo a b → u a = 0 → u c = 0 → (∀ t ∈ Set.Ioo a c, u t ≠ 0) → t₀ ∈ Set.Ioo a c → k t₀ < K → c ≤ t₀
@Poincare.L4.GeodesicComparison.const_curvature_deficit_no_first_zero : ∀ {k : ℝ → ℝ} {K cst a b : ℝ}
  {u du ddu : ℝ → ℝ},
  0 < K →
    (∀ t ∈ Set.Icc a b, k t = cst) →
      cst < K →
        Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu a b →
          u a = 0 → ¬∃ c ∈ Set.Ioo a b, √K * (c - a) ≤ Real.pi ∧ u c = 0 ∧ ∀ t ∈ Set.Ioo a c, u t ≠ 0
Poincare.L4.GeodesicComparison.sturmModel_first_zero_witness : ∀ t ∈ Set.Ioo 0 Real.pi, (fun x => 1) t = 1
Poincare.L4.GeodesicComparison.sin_no_first_zero_before_pi_div_sqrt_two : ¬∃ c ∈ Set.Ioo 0 3,
    √2 * c ≤ Real.pi ∧ Real.sin c = 0 ∧ ∀ t ∈ Set.Ioo 0 c, Real.sin t ≠ 0
