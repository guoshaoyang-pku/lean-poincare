@GromovHausdorff.ghDist_le_hausdorffDist : ∀ {X : Type u_1} [inst : MetricSpace X] [inst_1 : CompactSpace X]
  [inst_2 : Nonempty X] {Y : Type u_2} [inst_3 : MetricSpace Y] [inst_4 : CompactSpace Y] [inst_5 : Nonempty Y]
  {γ : Type u_3} [inst_6 : MetricSpace γ] {Φ : X → γ} {Ψ : Y → γ},
  Isometry Φ → Isometry Ψ → GromovHausdorff.ghDist X Y ≤ Metric.hausdorffDist (Set.range Φ) (Set.range Ψ)
@Metric.exists_dist_lt_of_hausdorffDist_lt : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] {s t : Set α} {x : α}
  {r : ℝ}, x ∈ s → Metric.hausdorffDist s t < r → Metric.hausdorffEDist s t ≠ ⊤ → ∃ y ∈ t, dist x y < r
@Metric.exists_dist_lt_of_hausdorffDist_lt' : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] {s t : Set α} {y : α}
  {r : ℝ}, y ∈ t → Metric.hausdorffDist s t < r → Metric.hausdorffEDist s t ≠ ⊤ → ∃ x ∈ s, dist x y < r
@GromovHausdorff.hausdorffDist_optimal : ∀ {X : Type u_1} [inst : MetricSpace X] [inst_1 : CompactSpace X]
  [inst_2 : Nonempty X] {Y : Type u_2} [inst_3 : MetricSpace Y] [inst_4 : CompactSpace Y] [inst_5 : Nonempty Y],
  Metric.hausdorffDist (Set.range (GromovHausdorff.optimalGHInjl X Y)) (Set.range (GromovHausdorff.optimalGHInjr X Y)) =
    GromovHausdorff.ghDist X Y
@Metric.hausdorffDist_le_of_mem_dist : ∀ {α : Type u_1} [inst : PseudoMetricSpace α] {s t : Set α} {r : ℝ},
  0 ≤ r → (∀ x ∈ s, ∃ y ∈ t, dist x y ≤ r) → (∀ x ∈ t, ∃ y ∈ s, dist x y ≤ r) → Metric.hausdorffDist s t ≤ r
@IsCompact.tendsto_subseq : ∀ {X : Type u_1} [inst : TopologicalSpace X] [FirstCountableTopology X] {s : Set X}
  {x : ℕ → X},
  IsCompact s → (∀ (n : ℕ), x n ∈ s) → ∃ a ∈ s, ∃ φ, StrictMono φ ∧ Filter.Tendsto (x ∘ φ) Filter.atTop (nhds a)
GromovHausdorff.dist_ghDist : ∀ (p q : GromovHausdorff.GHSpace), dist p q = GromovHausdorff.ghDist p.Rep q.Rep
Poincare.D12.GeometricCompactness.toGHSpace_rep_isometryEquiv : ∀ (X : Type u_1) [inst : MetricSpace X]
  [inst_1 : CompactSpace X] [inst_2 : Nonempty X], Nonempty ((GromovHausdorff.toGHSpace X).Rep ≃ᵢ X)
@Poincare.D12.GeometricCompactness.ghDist_congr_left : ∀ {X X' : Type u_1} [inst : MetricSpace X]
  [inst_1 : CompactSpace X] [inst_2 : Nonempty X] [inst_3 : MetricSpace X'] [inst_4 : CompactSpace X']
  [inst_5 : Nonempty X'] {Y : Type u_1} [inst_6 : MetricSpace Y] [inst_7 : CompactSpace Y] [inst_8 : Nonempty Y]
  (e : X' ≃ᵢ X), GromovHausdorff.ghDist X' Y = GromovHausdorff.ghDist X Y
@GromovHausdorff.totallyBounded : ∀ {t : Set GromovHausdorff.GHSpace} {C : ℝ} {u : ℕ → ℝ} {K : ℕ → ℕ},
  Filter.Tendsto u Filter.atTop (nhds 0) →
    (∀ p ∈ t, Metric.diam Set.univ ≤ C) →
      (∀ p ∈ t, ∀ (n : ℕ), ∃ s, Cardinal.mk ↑s ≤ ↑(K n) ∧ Set.univ ⊆ ⋃ x ∈ s, Metric.ball x (u n)) → TotallyBounded t
