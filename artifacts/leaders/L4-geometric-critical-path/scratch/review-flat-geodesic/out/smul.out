theorem smul_eq_zero.{u_1, u_3} : ∀ {R : Type u_1} {M : Type u_3} [inst : Semiring R] [inst_1 : AddCommMonoid M]
  [inst_2 : Module R M] {r : R} {m : M} [Module.IsTorsionFree R M] [IsCancelMulZero R], r • m = 0 ↔ r = 0 ∨ m = 0 :=
fun {R} {M} [Semiring R] [AddCommMonoid M] [Module R M] {r} {m} [Module.IsTorsionFree R M] [IsCancelMulZero R] =>
  Or.casesOn (eq_or_ne r 0)
    (fun h =>
      Eq.symm h ▸
        of_eq_true
          (Eq.trans
            (congr (congrArg Iff (Eq.trans (congrFun' (congrArg Eq (zero_smul R m)) 0) (eq_self 0)))
              (Eq.trans (congrFun' (congrArg Or (eq_self 0)) (m = 0)) (true_or (m = 0))))
            (iff_self True)))
    fun hr =>
    of_eq_true
      (Eq.trans
        (congr
          (congrArg Iff
            (smul_eq_zero._simp_1_1✝ (of_eq_true (Eq.trans (congrArg Not (eq_false hr)) not_false_eq_true))))
          (Eq.trans (congrFun' (congrArg Or (eq_false hr)) (m = 0)) (false_or (m = 0))))
        (iff_self (m = 0)))
@smul_eq_zero : ∀ {R : Type u_1} {M : Type u_2} [inst : Semiring R] [inst_1 : AddCommMonoid M] [inst_2 : Module R M]
  {r : R} {m : M} [Module.IsTorsionFree R M] [IsCancelMulZero R], r • m = 0 ↔ r = 0 ∨ m = 0
