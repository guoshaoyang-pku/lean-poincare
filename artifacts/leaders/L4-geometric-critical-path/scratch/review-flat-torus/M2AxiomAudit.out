@Poincare.L4.Compactness.UniformRicciBallGrowth.A_saturate : ∀ {t : Set GromovHausdorff.GHSpace}
  (self : Poincare.L4.Compactness.UniformRicciBallGrowth t) (s : ℝ), self.T < s → self.A s = 0
@Poincare.L4.Compactness.UniformRicciBallGrowth.hRT : ∀ {t : Set GromovHausdorff.GHSpace}
  (self : Poincare.L4.Compactness.UniformRicciBallGrowth t), 2 * ↑self.R ≤ self.T
@Poincare.L4.Compactness.UniformRicciBallGrowth.exhaust : ∀ {t : Set GromovHausdorff.GHSpace}
  (self : Poincare.L4.Compactness.UniformRicciBallGrowth t), ∀ p ∈ t, ∃ y, Set.univ ⊆ Metric.closedBall y (2 * ↑self.R)
@Poincare.L4.Compactness.UniformRicciBallGrowth.realize : ∀ {t : Set GromovHausdorff.GHSpace}
  (self : Poincare.L4.Compactness.UniformRicciBallGrowth t),
  ∀ p ∈ t,
    ∀ (c : p.Rep) (s : ℝ),
      (self.μ p) (Metric.closedBall c s) = ENNReal.ofReal (Poincare.D12.ComparisonGeodesics.radialVolume self.A s)
@Poincare.L4.Compactness.UniformRicciBallGrowth.hineq : ∀ {t : Set GromovHausdorff.GHSpace}
  (self : Poincare.L4.Compactness.UniformRicciBallGrowth t) ⦃s : ℝ⦄,
  s ∈ Set.Ioo 0 self.T → self.dm s + self.m s ^ 2 / ↑self.d + self.k s ≤ 0
