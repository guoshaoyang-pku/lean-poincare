theorem Poincare.L4.Compactness.totallyBounded_torus : TotallyBounded {toGHSpace Poincare.L4.Compactness.FlatTorus} :=
Poincare.L4.Compactness.totallyBounded_of_uniformRicciBallGrowth Poincare.L4.Compactness.torusRicciBallGrowth
theorem Poincare.L4.Compactness.isCompact_torus : IsCompact {toGHSpace Poincare.L4.Compactness.FlatTorus} :=
Poincare.L4.Compactness.isCompact_of_uniformRicciBallGrowth Poincare.L4.Compactness.torusRicciBallGrowth
  isClosed_singleton
theorem Poincare.L4.Compactness.exists_pointed_subseq_torus : ∃ a xinf φ,
  a ∈ {toGHSpace Poincare.L4.Compactness.FlatTorus} ∧
    StrictMono φ ∧
      Nonempty
        (Poincare.L4.PointedGH.PointedGHCoupling (fun x => (toGHSpace Poincare.L4.Compactness.FlatTorus).Rep)
          (fun x => Poincare.L4.Compactness.torusZero) a.Rep xinf) :=
Poincare.L4.Compactness.exists_pointed_subseq_of_uniformRicciBallGrowth Poincare.L4.Compactness.torusRicciBallGrowth
  isClosed_singleton (fun x => toGHSpace Poincare.L4.Compactness.FlatTorus) (fun x => rfl) fun x =>
  Poincare.L4.Compactness.torusZero
theorem Poincare.L4.Compactness.totallyBounded_of_uniformRicciBallGrowth : ∀ {t : Set GHSpace}
  (G : Poincare.L4.Compactness.UniformRicciBallGrowth t), TotallyBounded t :=
fun {t} G => Poincare.L4.Compactness.totallyBounded_of_uniformMeasureGrowth G.toUniformMeasureGrowth
theorem Poincare.L4.Compactness.isCompact_of_uniformRicciBallGrowth : ∀ {t : Set GHSpace}
  (G : Poincare.L4.Compactness.UniformRicciBallGrowth t), IsClosed t → IsCompact t :=
fun {t} G ht => Poincare.L4.Compactness.isCompact_of_uniformMeasureGrowth G.toUniformMeasureGrowth ht
theorem Poincare.L4.Compactness.exists_pointed_subseq_of_uniformRicciBallGrowth : ∀ {t : Set GHSpace}
  (G : Poincare.L4.Compactness.UniformRicciBallGrowth t),
  IsClosed t →
    ∀ (p : ℕ → GHSpace),
      (∀ (n : ℕ), p n ∈ t) →
        ∀ (x : (n : ℕ) → (p n).Rep),
          ∃ a xinf φ,
            a ∈ t ∧
              StrictMono φ ∧
                Nonempty
                  (Poincare.L4.PointedGH.PointedGHCoupling (fun k => (p (φ k)).Rep) (fun k => x (φ k)) a.Rep xinf) :=
fun {t} G ht p hp x =>
  Poincare.L4.Compactness.exists_pointed_subseq_of_uniformMeasureGrowth G.toUniformMeasureGrowth ht p hp x
def Poincare.L4.Compactness.UniformRicciBallGrowth.toUniformMeasureGrowth : {t : Set GHSpace} →
  Poincare.L4.Compactness.UniformRicciBallGrowth t → Poincare.L4.Compactness.UniformMeasureGrowth t :=
fun {t} G =>
  { μ := G.μ, C := G.doublingNNReal, K := 1, m := fun s => (radialVolume G.A s).toNNReal, m_pos := ⋯, doubling := ⋯,
    noncollapse := ⋯, compare := ⋯, R := G.R, exhaust := ⋯ }
theorem Poincare.L4.Compactness.totallyBounded_of_uniformMeasureGrowth : ∀ {t : Set GHSpace}
  (G : Poincare.L4.Compactness.UniformMeasureGrowth t), TotallyBounded t :=
fun {t} G =>
  Poincare.L4.Compactness.totallyBounded_of_uniformDoubling
    (fun x hp c r => Poincare.L4.Compactness.UniformMeasureGrowth.coveringNumber_le_doublingConstant G hp c r)
    (Exists.intro G.R G.exhaust)
theorem Poincare.L4.Compactness.isCompact_of_uniformMeasureGrowth : ∀ {t : Set GHSpace}
  (G : Poincare.L4.Compactness.UniformMeasureGrowth t), IsClosed t → IsCompact t :=
fun {t} G ht =>
  Poincare.L4.Compactness.isCompact_of_uniformDoubling ht
    (fun x hp c r => Poincare.L4.Compactness.UniformMeasureGrowth.coveringNumber_le_doublingConstant G hp c r)
    (Exists.intro G.R G.exhaust)
theorem Poincare.L4.Compactness.exists_pointed_subseq_of_uniformMeasureGrowth : ∀ {t : Set GHSpace}
  (G : Poincare.L4.Compactness.UniformMeasureGrowth t),
  IsClosed t →
    ∀ (p : ℕ → GHSpace),
      (∀ (n : ℕ), p n ∈ t) →
        ∀ (x : (n : ℕ) → (p n).Rep),
          ∃ a xinf φ,
            a ∈ t ∧
              StrictMono φ ∧
                Nonempty
                  (Poincare.L4.PointedGH.PointedGHCoupling (fun k => (p (φ k)).Rep) (fun k => x (φ k)) a.Rep xinf) :=
fun {t} G ht p hp x =>
  Exists.casesOn
    (Poincare.L4.PointedGH.pointed_subseq_of_compact (Poincare.L4.Compactness.isCompact_of_uniformMeasureGrowth G ht) x
      fun n => Eq.mpr (id (congrArg (fun _a => _a ∈ t) (GHSpace.toGHSpace_rep (p n)))) (hp n))
    fun a h =>
    Exists.casesOn h fun xinf h =>
      Exists.casesOn h fun φ h =>
        And.casesOn h fun ha right =>
          And.casesOn right fun hφ hD => Exists.intro a (Exists.intro xinf (Exists.intro φ ⟨ha, ⟨hφ, hD⟩⟩))
