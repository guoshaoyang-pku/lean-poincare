  (G : Poincare.L4.Compactness.UniformMeasureGrowth t) {p : GHSpace},
  p ∈ t → ∀ (c : p.Rep) {s : ℝ≥0}, 0 < s → ↑(coveringNumber s (closedBall c (2 * ↑s))) ≤ ↑(G.C ^ 3 * G.K) :=
fun {t} G {p} hp c {s} hs =>
  have hs2 :=
    div_pos (Mathlib.Meta.Positivity.nnreal_coe_pos hs)
      (Mathlib.Meta.Positivity.pos_of_isNat (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2)) (Eq.refl (Nat.ble 1 2)));
  have hmain :=
    Poincare.L4.Compactness.coveringNumber_le_of_measure_doubling (G.doubling p hp) (G.m_pos (↑s / 2) hs2)
      (fun y x => G.noncollapse p hp y (↑s / 2) hs2) (G.compare p hp c (↑s / 2) hs2);
  Trans.trans hmain (of_eq_true (eq_self (↑G.C ^ 3 * ↑G.K)))
