@totallyBounded_of_uniformMeasureGrowth : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformMeasureGrowth t),
  TotallyBounded t
@isCompact_of_uniformMeasureGrowth : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformMeasureGrowth t),
  IsClosed t → IsCompact t
@exists_pointed_subseq_of_uniformMeasureGrowth : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformMeasureGrowth t),
  IsClosed t →
    ∀ (p : ℕ → GromovHausdorff.GHSpace),
      (∀ (n : ℕ), p n ∈ t) →
        ∀ (x : (n : ℕ) → (p n).Rep),
          ∃ a xinf φ,
            a ∈ t ∧
              StrictMono φ ∧
                Nonempty
                  (Poincare.L4.PointedGH.PointedGHCoupling (fun k => (p (φ k)).Rep) (fun k => x (φ k)) a.Rep xinf)
@totallyBounded_of_uniformRicciBallGrowth : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t),
  TotallyBounded t
@isCompact_of_uniformRicciBallGrowth : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t),
  IsClosed t → IsCompact t
@exists_pointed_subseq_of_uniformRicciBallGrowth : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t),
  IsClosed t →
    ∀ (p : ℕ → GromovHausdorff.GHSpace),
      (∀ (n : ℕ), p n ∈ t) →
        ∀ (x : (n : ℕ) → (p n).Rep),
          ∃ a xinf φ,
            a ∈ t ∧
              StrictMono φ ∧
                Nonempty
                  (Poincare.L4.PointedGH.PointedGHCoupling (fun k => (p (φ k)).Rep) (fun k => x (φ k)) a.Rep xinf)
theorem Poincare.L4.Compactness.totallyBounded_of_uniformRicciBallGrowth : ∀ {t : Set GromovHausdorff.GHSpace}
  (G : UniformRicciBallGrowth t), TotallyBounded t :=
fun {t} G => totallyBounded_of_uniformMeasureGrowth G.toUniformMeasureGrowth
theorem Poincare.L4.Compactness.isCompact_of_uniformRicciBallGrowth : ∀ {t : Set GromovHausdorff.GHSpace}
  (G : UniformRicciBallGrowth t), IsClosed t → IsCompact t :=
fun {t} G ht => isCompact_of_uniformMeasureGrowth G.toUniformMeasureGrowth ht
theorem Poincare.L4.Compactness.exists_pointed_subseq_of_uniformRicciBallGrowth : ∀ {t : Set GromovHausdorff.GHSpace}
  (G : UniformRicciBallGrowth t),
  IsClosed t →
    ∀ (p : ℕ → GromovHausdorff.GHSpace),
      (∀ (n : ℕ), p n ∈ t) →
        ∀ (x : (n : ℕ) → (p n).Rep),
          ∃ a xinf φ,
            a ∈ t ∧
              StrictMono φ ∧
                Nonempty
                  (Poincare.L4.PointedGH.PointedGHCoupling (fun k => (p (φ k)).Rep) (fun k => x (φ k)) a.Rep xinf) :=
fun {t} G ht p hp x => exists_pointed_subseq_of_uniformMeasureGrowth G.toUniformMeasureGrowth ht p hp x
