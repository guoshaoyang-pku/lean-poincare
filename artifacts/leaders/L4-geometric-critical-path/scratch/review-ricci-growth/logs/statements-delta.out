UniformRicciBallGrowth : Set GromovHausdorff.GHSpace → Type
@UniformRicciBallGrowth.A_nonneg : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t) (s : ℝ), 0 ≤ G.A s
@UniformRicciBallGrowth.intervalIntegrable_A : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t)
  (a b : ℝ), IntervalIntegrable G.A MeasureTheory.volume a b
@UniformRicciBallGrowth.radialVolume_eq_zero_of_nonpos : ∀ {t : Set GromovHausdorff.GHSpace}
  (G : UniformRicciBallGrowth t) {s : ℝ}, s ≤ 0 → Poincare.D12.ComparisonGeodesics.radialVolume G.A s = 0
@UniformRicciBallGrowth.radialVolume_nonneg : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t)
  (s : ℝ), 0 ≤ Poincare.D12.ComparisonGeodesics.radialVolume G.A s
@UniformRicciBallGrowth.radialVolume_mono : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t),
  Monotone (Poincare.D12.ComparisonGeodesics.radialVolume G.A)
@UniformRicciBallGrowth.radialVolume_eq_of_ge : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t)
  {s : ℝ},
  G.T ≤ s → Poincare.D12.ComparisonGeodesics.radialVolume G.A s = Poincare.D12.ComparisonGeodesics.radialVolume G.A G.T
@UniformRicciBallGrowth.radialVolume_pos : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t) {s : ℝ},
  0 < s → 0 < Poincare.D12.ComparisonGeodesics.radialVolume G.A s
@UniformRicciBallGrowth.radialVolume_halving : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t)
  (s : ℝ),
  Poincare.D12.ComparisonGeodesics.radialVolume G.A s ≤
    2 ^ (G.d + 1) * Poincare.D12.ComparisonGeodesics.radialVolume G.A (s / 2)
@UniformRicciBallGrowth.doublingNNReal : {t : Set GromovHausdorff.GHSpace} → UniformRicciBallGrowth t → NNReal
@UniformRicciBallGrowth.toUniformMeasureGrowth : {t : Set GromovHausdorff.GHSpace} →
  UniformRicciBallGrowth t → UniformMeasureGrowth t
@totallyBounded_of_uniformRicciBallGrowth : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t),
  TotallyBounded t
@isCompact_of_uniformRicciBallGrowth : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t),
  IsClosed t → IsCompact t
@exists_pointed_subseq_of_uniformRicciBallGrowth : ∀ {t : Set GromovHausdorff.GHSpace} (G : UniformRicciBallGrowth t),
  IsClosed t →
    ∀ (p : ℕ → GromovHausdorff.GHSpace),
      (∀ (n : ℕ), p n ∈ t) →
        ∀ (x : (n : ℕ) → (p n).Rep),
          ∃ a xinf φ,
            a ∈ t ∧
              StrictMono φ ∧
                Nonempty
                  (Poincare.L4.PointedGH.PointedGHCoupling (fun k => (p (φ k)).Rep) (fun k => x (φ k)) a.Rep xinf)
