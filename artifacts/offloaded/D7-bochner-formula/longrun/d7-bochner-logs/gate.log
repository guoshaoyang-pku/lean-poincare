CovariantDerivative.IsLeviCivitaConnection.apply_eq.{u_1, u_2, u_3} {E : Type u_1} [NormedAddCommGroup E]
  [NormedSpace ℝ E] {H : Type u_2} [TopologicalSpace H] (I : ModelWithCorners ℝ E H) {M : Type u_3} [TopologicalSpace M]
  [ChartedSpace H M] [IsManifold I 2 M] [RiemannianBundle fun x => TangentSpace I x]
  {X Y Z : (x : M) → TangentSpace I x} {cov : CovariantDerivative I E (TangentSpace I)}
  [IsContMDiffRiemannianBundle I 1 E fun x => TangentSpace I x] {x : M} [FiniteDimensional ℝ E]
  (h : CovariantDerivative.IsLeviCivitaConnection I cov) (hX : MDiffAt (T% X) x) (hY : MDiffAt (T% Y) x)
  (hZ : MDiffAt (T% Z) x) :
  (fun x => inner ℝ ((fun x => (↑cov Y x) (X x)) x) (Z x)) x =
    (((d% fun x => inner ℝ (Y x) (Z x)) x) (X x) + ((d% fun x => inner ℝ (Z x) (X x)) x) (Y x) -
              ((d% fun x => inner ℝ (X x) (Y x)) x) (Z x) -
            (fun x => inner ℝ (Y x) (VectorField.mlieBracket I X Z x)) x -
          (fun x => inner ℝ (Z x) (VectorField.mlieBracket I Y X x)) x +
        (fun x => inner ℝ (X x) (VectorField.mlieBracket I Z Y x)) x) /
      2
CovariantDerivative.IsLeviCivitaConnection.uniqueness.{u_1, u_2, u_3} {E : Type u_1} [NormedAddCommGroup E]
  [NormedSpace ℝ E] {H : Type u_2} [TopologicalSpace H] (I : ModelWithCorners ℝ E H) {M : Type u_3} [TopologicalSpace M]
