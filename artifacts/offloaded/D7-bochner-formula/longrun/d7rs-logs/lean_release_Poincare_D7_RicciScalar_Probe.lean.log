  (h : ∀ i ∈ u, HasDerivAt (A i) (A' i) x) : HasDerivAt (∑ i ∈ u, A i) (∑ i ∈ u, A' i) x
hasDerivAt_const.{u, v} {𝕜 : Type u} [NontriviallyNormedField 𝕜] {F : Type v} [NormedAddCommGroup F] [NormedSpace 𝕜 F]
  (x : 𝕜) (c : F) : HasDerivAt (fun x => c) 0 x
crossProduct.{u_1} {R : Type u_1} [CommRing R] : (Fin 3 → R) →ₗ[R] (Fin 3 → R) →ₗ[R] Fin 3 → R
cross_dot_cross.{u_1} {R : Type u_1} [CommRing R] (u v w x : Fin 3 → R) :
  (crossProduct u) v ⬝ᵥ (crossProduct w) x = u ⬝ᵥ w * v ⬝ᵥ x - u ⬝ᵥ x * v ⬝ᵥ w
cross_cross_eq_smul_sub_smul'.{u_1} {R : Type u_1} [CommRing R] (u v w : Fin 3 → R) :
  (crossProduct u) ((crossProduct v) w) = (u ⬝ᵥ w) • v - (v ⬝ᵥ u) • w
