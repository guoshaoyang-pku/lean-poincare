Module.Basis.prod_apply_inl_fst.{u_1, u_2, u_3, u_4, u_5} {ι : Type u_1} {ι' : Type u_2} {R : Type u_3} {M : Type u_4}
  {M' : Type u_5} [Semiring R] [AddCommMonoid M] [Module R M] [AddCommMonoid M'] [Module R M'] (b : Module.Basis ι R M)
  (b' : Module.Basis ι' R M') (i : ι) : ((b.prod b') (Sum.inl i)).1 = b i
Module.Basis.prod_apply_inr_snd.{u_1, u_2, u_3, u_4, u_5} {ι : Type u_1} {ι' : Type u_2} {R : Type u_3} {M : Type u_4}
  {M' : Type u_5} [Semiring R] [AddCommMonoid M] [Module R M] [AddCommMonoid M'] [Module R M'] (b : Module.Basis ι R M)
  (b' : Module.Basis ι' R M') (i : ι') : ((b.prod b') (Sum.inr i)).2 = b' i
Module.Basis.prod_repr_inl.{u_1, u_2, u_3, u_4, u_5} {ι : Type u_1} {ι' : Type u_2} {R : Type u_3} {M : Type u_4}
  {M' : Type u_5} [Semiring R] [AddCommMonoid M] [Module R M] [AddCommMonoid M'] [Module R M'] (b : Module.Basis ι R M)
  (b' : Module.Basis ι' R M') (x : M × M') (i : ι) : ((b.prod b').repr x) (Sum.inl i) = (b.repr x.1) i
