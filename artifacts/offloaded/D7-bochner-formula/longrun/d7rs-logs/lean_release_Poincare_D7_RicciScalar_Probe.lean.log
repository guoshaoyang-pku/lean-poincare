Poincare.D7.RicciScalar.ricciTrace_basis_independent.{v, w, w'} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] {ι' : Type w'} [Fintype ι'] [DecidableEq ι']
  (D : Curvature.RiemannCurvatureData V ι) (e : Module.Basis ι ℝ V) (e' : Module.Basis ι' ℝ V) (X Y : V) :
  ricciTrace D e X Y = ricciTrace D e' X Y
