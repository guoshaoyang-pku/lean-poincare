Poincare.D7.RicciScalar.prodData_ricciForm.{v₁, v₂, w₁, w₂} {V₁ : Type v₁} [AddCommGroup V₁] [Module ℝ V₁]
  [FiniteDimensional ℝ V₁] {V₂ : Type v₂} [AddCommGroup V₂] [Module ℝ V₂] [FiniteDimensional ℝ V₂] {ι₁ : Type w₁}
  [Fintype ι₁] [DecidableEq ι₁] {ι₂ : Type w₂} [Fintype ι₂] [DecidableEq ι₂] (D₁ : Curvature.RiemannCurvatureData V₁ ι₁)
  (D₂ : Curvature.RiemannCurvatureData V₂ ι₂) (X Y : V₁ × V₂) :
  ((prodData D₁ D₂).ricciForm X) Y = (D₁.ricciForm X.1) Y.1 + (D₂.ricciForm X.2) Y.2
Poincare.D7.RicciScalar.prodData_scalarCurvature.{v₁, v₂, w₁, w₂} {V₁ : Type v₁} [AddCommGroup V₁] [Module ℝ V₁]
  [FiniteDimensional ℝ V₁] {V₂ : Type v₂} [AddCommGroup V₂] [Module ℝ V₂] [FiniteDimensional ℝ V₂] {ι₁ : Type w₁}
  [Fintype ι₁] [DecidableEq ι₁] {ι₂ : Type w₂} [Fintype ι₂] [DecidableEq ι₂] (D₁ : Curvature.RiemannCurvatureData V₁ ι₁)
  (D₂ : Curvature.RiemannCurvatureData V₂ ι₂) :
