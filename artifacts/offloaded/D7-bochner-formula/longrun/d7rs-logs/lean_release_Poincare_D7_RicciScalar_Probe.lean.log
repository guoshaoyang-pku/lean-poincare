  ricciTensor D = D.toCurvatureOperator.ricci
Poincare.D7.RicciScalar.ricciTensor_eq_basisTrace.{v, w, w'} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] {ι' : Type w'} [Fintype ι'] [DecidableEq ι']
