  [AddCommMonoid M] [Module R M] (b : Module.Basis ι R M) (e : ι ≃ ι') : Module.Basis ι' R M
Fintype.sum_sum_type.{u_4, u_5, u_6} {α₁ : Type u_4} {α₂ : Type u_5} {M : Type u_6} [Fintype α₁] [Fintype α₂]
  [AddCommMonoid M] (f : α₁ ⊕ α₂ → M) : ∑ x, f x = ∑ a₁, f (Sum.inl a₁) + ∑ a₂, f (Sum.inr a₂)
HasDerivAt.sum.{u, v, u_1} {𝕜 : Type u} [NontriviallyNormedField 𝕜] {F : Type v} [NormedAddCommGroup F]
