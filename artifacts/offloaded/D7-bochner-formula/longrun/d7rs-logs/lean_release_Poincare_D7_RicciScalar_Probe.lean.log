LinearMap.trace.{u, v} (R : Type u) [CommSemiring R] (M : Type v) [AddCommMonoid M] [Module R M] : (M →ₗ[R] M) →ₗ[R] R
LinearMap.trace_eq_matrix_trace.{u, v, w} (R : Type u) [CommSemiring R] {M : Type v} [AddCommMonoid M] [Module R M]
  {ι : Type w} [DecidableEq ι] [Fintype ι] (b : Module.Basis ι R M) (f : M →ₗ[R] M) :
  (LinearMap.trace R M) f = ((LinearMap.toMatrix b b) f).trace
LinearMap.trace_smulRight.{u_1, u_2} {R : Type u_1} [CommRing R] {M : Type u_2} [AddCommGroup M] [Module R M]
  [Module.Free R M] [Module.Finite R M] (f : M →ₗ[R] R) (x : M) : (LinearMap.trace R M) (f.smulRight x) = f x
LinearMap.trace_id.{u_1, u_2} (R : Type u_1) [CommRing R] (M : Type u_2) [AddCommGroup M] [Module R M] [Module.Free R M]
  [Module.Finite R M] : (LinearMap.trace R M) LinearMap.id = ↑(Module.finrank R M)
LinearMap.trace_prodMap'.{u_1, u_2, u_3} {R : Type u_1} [CommRing R] {M : Type u_2} [AddCommGroup M] [Module R M]
  {N : Type u_3} [AddCommGroup N] [Module R N] [Module.Free R M] [Module.Finite R M] [Module.Free R N]
  [Module.Finite R N] (f : M →ₗ[R] M) (g : N →ₗ[R] N) :
  (LinearMap.trace R (M × N)) (f.prodMap g) = (LinearMap.trace R M) f + (LinearMap.trace R N) g
