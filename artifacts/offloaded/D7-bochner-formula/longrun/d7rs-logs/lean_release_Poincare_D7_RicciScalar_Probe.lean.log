Poincare.D7.RicciScalar.scalarMetricTrace_basis_independent.{v, w, w'} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] {ι' : Type w'} [Fintype ι'] [DecidableEq ι']
  (D : Curvature.RiemannCurvatureData V ι) (e : Module.Basis ι ℝ V) (e' : Module.Basis ι' ℝ V) :
  ∑ i, (e.repr ((D.metric.raiseIndex D.ricciForm) (e i))) i =
    ∑ i, (e'.repr ((D.metric.raiseIndex D.ricciForm) (e' i))) i
Poincare.D7.RicciScalar.scalarBasisSum_congr_orthonormal.{v, w, w'} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] {ι' : Type w'} [Fintype ι'] [DecidableEq ι']
  (D : Curvature.RiemannCurvatureData V ι) (m' : Longrun.Geometry.MetricData V ι')
  (hm : ∀ (X Y : V), (m'.form X) Y = (D.metric.form X) Y) :
  ∑ i, (D.ricciForm (m'.basis i)) (m'.basis i) = D.scalarCurvature
Poincare.D7.RicciScalar.scalarCurvature_eq_basisTrace.{v, w} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] (D : Curvature.RiemannCurvatureData V ι) :
  D.scalarCurvature = ∑ i, ((ricciTensor D) (D.metric.basis i)) (D.metric.basis i)
