  ∑ i, u i.castSucc * (v i.succ - v i.castSucc) + ∑ i, (u i.succ - u i.castSucc) * v i.succ =
    u (Fin.last n) * v (Fin.last n) - u 0 * v 0
Poincare.D7.Divergence.slab_ibp.{u_1} {α : Type u_1} [Fintype α] {n : ℕ} (u v : α → Fin (n + 1) → ℝ) :
  ∑ a, ∑ i, u a i.castSucc * (v a i.succ - v a i.castSucc) + ∑ a, ∑ i, (u a i.succ - u a i.castSucc) * v a i.succ =
    ∑ a, u a (Fin.last n) * v a (Fin.last n) - ∑ a, u a 0 * v a 0
Poincare.D7.Divergence.slab_ibp_vanishing.{u_1} {α : Type u_1} [Fintype α] {n : ℕ} (u v : α → Fin (n + 1) → ℝ)
  (hu0 : ∀ (a : α), u a 0 = 0) (hvN : ∀ (a : α), v a (Fin.last n) = 0) :
  ∑ a, ∑ i, u a i.castSucc * (v a i.succ - v a i.castSucc) + ∑ a, ∑ i, (u a i.succ - u a i.castSucc) * v a i.succ = 0
Poincare.D7.Divergence.slab_ibp_vanishing'.{u_1} {α : Type u_1} [Fintype α] {n : ℕ} (u v : α → Fin (n + 1) → ℝ)
  (hu0 : ∀ (a : α), u a 0 = 0) (hvN : ∀ (a : α), v a (Fin.last n) = 0) :
  ∑ a, ∑ i, u a i.castSucc * (v a i.succ - v a i.castSucc) = -∑ a, ∑ i, (u a i.succ - u a i.castSucc) * v a i.succ
Poincare.D7.Divergence.slab_ibp_divergence_form.{u_1} {α : Type u_1} [Fintype α] {n : ℕ} (φ F : α → Fin (n + 1) → ℝ)
  (hφ0 : ∀ (a : α), φ a 0 = 0) (hFN : ∀ (a : α), F a (Fin.last n) = 0) :
  ∑ a, ∑ i, φ a i.castSucc * slabDivergence F a i + ∑ a, ∑ i, slabForwardDiff φ a i * F a i.succ = 0
Poincare.D7.Divergence.slabIBPCertificate.{u_1} {α : Type u_1} [Fintype α] {n : ℕ} (u v : α → Fin (n + 1) → ℝ) :
  IBPCertificate
Poincare.D7.Divergence.slabIBPCertificate_boundaryTerm.{u_1} {α : Type u_1} [Fintype α] {n : ℕ}
  (u v : α → Fin (n + 1) → ℝ) :
  (slabIBPCertificate u v).boundaryTerm = ∑ a, u a (Fin.last n) * v a (Fin.last n) - ∑ a, u a 0 * v a 0
Poincare.D7.Divergence.slabIBPCertificate_boundaryTerm_eq_zero.{u_1} {α : Type u_1} [Fintype α] {n : ℕ}
  (u v : α → Fin (n + 1) → ℝ) (hu0 : ∀ (a : α), u a 0 = 0) (hvN : ∀ (a : α), v a (Fin.last n) = 0) :
  (slabIBPCertificate u v).boundaryTerm = 0
Poincare.D7.Divergence.slabIBPCertificate_eq_zero.{u_1} {α : Type u_1} [Fintype α] {n : ℕ} (u v : α → Fin (n + 1) → ℝ)
  (hu0 : ∀ (a : α), u a 0 = 0) (hvN : ∀ (a : α), v a (Fin.last n) = 0) :
  (slabIBPCertificate u v).interiorTerm + (slabIBPCertificate u v).fluxTerm = 0
