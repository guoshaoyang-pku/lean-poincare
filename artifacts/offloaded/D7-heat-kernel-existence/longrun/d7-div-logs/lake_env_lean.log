MeasureTheory.integral_divergence_of_hasFDerivAt_off_countable.{u} {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {n : ℕ} (a b : Fin (n + 1) → ℝ) (hle : a ≤ b) (f : (Fin (n + 1) → ℝ) → Fin (n + 1) → E)
  (f' : (Fin (n + 1) → ℝ) → (Fin (n + 1) → ℝ) →L[ℝ] Fin (n + 1) → E) (s : Set (Fin (n + 1) → ℝ)) (hs : s.Countable)
  (Hc : ContinuousOn f (Set.Icc a b))
  (Hd : ∀ x ∈ (Set.univ.pi fun i => Set.Ioo (a i) (b i)) \ s, HasFDerivAt f (f' x) x)
  (Hi : IntegrableOn (fun x => ∑ i, (f' x) (Pi.single i 1) i) (Set.Icc a b) volume) :
  ∫ (x : Fin (n + 1) → ℝ) in Set.Icc a b, ∑ i, (f' x) (Pi.single i 1) i =
    ∑ i,
      ((∫ (x : Fin n → ℝ) in Set.Icc (a ∘ i.succAbove) (b ∘ i.succAbove), f (i.insertNth (b i) x) i) -
        ∫ (x : Fin n → ℝ) in Set.Icc (a ∘ i.succAbove) (b ∘ i.succAbove), f (i.insertNth (a i) x) i)
MeasureTheory.integral_divergence_prod_Icc_of_hasFDerivAt_of_le.{u} {E : Type u} [NormedAddCommGroup E]
  [NormedSpace ℝ E] (f g : ℝ × ℝ → E) (f' g' : ℝ × ℝ → ℝ × ℝ →L[ℝ] E) (a b : ℝ × ℝ) (hle : a ≤ b)
  (Hcf : ContinuousOn f (Set.Icc a b)) (Hcg : ContinuousOn g (Set.Icc a b))
  (Hdf : ∀ x ∈ Set.Ioo a.1 b.1 ×ˢ Set.Ioo a.2 b.2, HasFDerivAt f (f' x) x)
  (Hdg : ∀ x ∈ Set.Ioo a.1 b.1 ×ˢ Set.Ioo a.2 b.2, HasFDerivAt g (g' x) x)
  (Hi : IntegrableOn (fun x => (f' x) (1, 0) + (g' x) (0, 1)) (Set.Icc a b) volume) :
  ∫ (x : ℝ × ℝ) in Set.Icc a b, (f' x) (1, 0) + (g' x) (0, 1) =
    (((∫ (x : ℝ) in a.1..b.1, g (x, b.2)) - ∫ (x : ℝ) in a.1..b.1, g (x, a.2)) + ∫ (y : ℝ) in a.2..b.2, f (b.1, y)) -
      ∫ (y : ℝ) in a.2..b.2, f (a.1, y)
