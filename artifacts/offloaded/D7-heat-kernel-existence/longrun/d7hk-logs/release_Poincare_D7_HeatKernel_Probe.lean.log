HeatKernelData : (X : Type u_1) → [TopologicalSpace X] → [MeasurableSpace X] → Type u_1
@HeatKernelData.gaussianUpperBound : ∀ {X : Type u_1} [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X]
  (self : HeatKernelData X) (x y : X) (t : ℝ),
  0 < t → self.kernel x y t ≤ self.C_up * t ^ (-(self.dim / 2)) * Real.exp (-self.dist x y ^ 2 / (self.c_up * t))
@HeatKernelData.gaussianLowerBound : ∀ {X : Type u_1} [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X]
  (self : HeatKernelData X) (x y : X) (t : ℝ),
  0 < t →
    self.dist x y ≤ 1 →
      self.C_lo * t ^ (-(self.dim / 2)) * Real.exp (-self.dist x y ^ 2 / (self.c_lo * t)) ≤ self.kernel x y t
@HeatKernelData.semigroup : ∀ {X : Type u_1} [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X]
  (self : HeatKernelData X) (x y : X) (s t : ℝ),
  0 < s → 0 < t → self.kernel x y (s + t) = ∫ (z : X), self.kernel x z s * self.kernel z y t ∂self.volume
@HeatKernelData.normalization : ∀ {X : Type u_1} [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X]
  (self : HeatKernelData X) (x : X) (t : ℝ), 0 < t → ∫ (y : X), self.kernel x y t ∂self.volume = 1
@HeatKernelData.symmetry : ∀ {X : Type u_1} [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X]
  (self : HeatKernelData X) (x y : X) (t : ℝ), self.kernel x y t = self.kernel y x t
@HeatKernelData.initialCondition : ∀ {X : Type u_1} [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X]
  (self : HeatKernelData X) (x : X) (f : X → ℝ),
  Continuous f → Tendsto (fun t => ∫ (y : X), self.kernel x y t * f y ∂self.volume) (𝓝[>] 0) (𝓝 (f x))
@HeatKernelData.heatEquation : ∀ {X : Type u_1} [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X]
  (self : HeatKernelData X) (x y : X) (t : ℝ),
  0 < t → HasDerivAt (fun s => self.kernel x y s) (self.laplacian (fun z => self.kernel z y t) x) t
@HeatKernelData.kernel_pos_of_lowerBound : ∀ {X : Type u_1} [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X]
  (D : HeatKernelData X) {x y : X} {t : ℝ}, 0 < D.C_lo → 0 < t → D.dist x y ≤ 1 → 0 < D.kernel x y t
@HeatKernelData.upperBound_self : ∀ {X : Type u_1} [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X]
  (D : HeatKernelData X) {x : X} {t : ℝ}, 0 < t → D.kernel x x t ≤ D.C_up * t ^ (-(D.dim / 2))
@HeatKernelData.semigroup_symm : ∀ {X : Type u_1} [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X]
  (D : HeatKernelData X) (x y : X) {s t : ℝ},
  0 < s → 0 < t → D.kernel x y (s + t) = ∫ (z : X), D.kernel x z s * D.kernel y z t ∂D.volume
@heatStep : {X : Type u_1} → [Fintype X] → Matrix X X ℝ → (X → ℝ) → X → ℝ
@heatStep_one : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X] (u : X → ℝ), heatStep 1 u = u
@heatStep_mul : ∀ {X : Type u_1} [inst : Fintype X] [DecidableEq X] (P Q : Matrix X X ℝ) (u : X → ℝ),
  heatStep (P * Q) u = heatStep P (heatStep Q u)
@FiniteGridHeatKernel : {X : Type u_1} →
  [Fintype X] → [DecidableEq X] → Matrix X X ℝ → (X → X → ℝ) → ℝ → ℝ → ℝ → ℝ → ℝ → Type u_1
@FiniteGridHeatKernel.eq_pow_of : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X] {step : Matrix X X ℝ}
  (K : ℕ → Matrix X X ℝ), K 0 = 1 → K 1 = step → (∀ (m n : ℕ), K (m + n) = K m * K n) → K = fun n => step ^ n
@FiniteGridHeatKernel.eq_pow : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X] {step : Matrix X X ℝ}
  {d : X → X → ℝ} {dim C_up c_up C_lo c_lo : ℝ} (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo),
  K.K = fun n => step ^ n
@FiniteGridHeatKernel.unique : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X] {step : Matrix X X ℝ}
  {d : X → X → ℝ} {dim C_up c_up C_lo c_lo : ℝ} (K₁ K₂ : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo),
  K₁.K = K₂.K
@IsFiniteGridHeatKernel : {X : Type u_1} →
  [Fintype X] → [DecidableEq X] → Matrix X X ℝ → (X → X → ℝ) → ℝ → ℝ → ℝ → ℝ → ℝ → (ℕ → Matrix X X ℝ) → Prop
@finiteGrid_heatKernel_unique : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X] {step : Matrix X X ℝ}
  {d : X → X → ℝ} {dim C_up c_up C_lo c_lo : ℝ} {K₁ K₂ : ℕ → Matrix X X ℝ},
  IsFiniteGridHeatKernel step d dim C_up c_up C_lo c_lo K₁ →
    IsFiniteGridHeatKernel step d dim C_up c_up C_lo c_lo K₂ → K₁ = K₂
@gridKernel : {X : Type u_1} →
  [inst : Fintype X] →
    [inst_1 : DecidableEq X] →
      (step : Matrix X X ℝ) →
        (d : X → X → ℝ) →
          (dim C_up c_up C_lo c_lo : ℝ) →
            (∀ (n : ℕ),
                0 < n → ∀ (x y : X), (step ^ n) x y ≤ C_up * ↑n ^ (-(dim / 2)) * Real.exp (-d x y ^ 2 / (c_up * ↑n))) →
              (∀ (n : ℕ),
                  0 < n →
                    ∀ (x y : X),
                      d x y ≤ 1 → C_lo * ↑n ^ (-(dim / 2)) * Real.exp (-d x y ^ 2 / (c_lo * ↑n)) ≤ (step ^ n) x y) →
                FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo
@GridHeatSolution : {X : Type u_1} → [Fintype X] → Matrix X X ℝ → (X → ℝ) → (ℕ → X → ℝ) → Type u_1
@GridHeatSolution.unique : ∀ {X : Type u_1} [inst : Fintype X] [DecidableEq X] {step : Matrix X X ℝ} {f : X → ℝ}
  {B : ℕ → X → ℝ} (u v : GridHeatSolution step f B), u.u = v.u
@gridFlow : {X : Type u_1} →
  [inst : Fintype X] →
    [inst_1 : DecidableEq X] →
      {step : Matrix X X ℝ} →
        {d : X → X → ℝ} →
          {dim C_up c_up C_lo c_lo : ℝ} → FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo → (X → ℝ) → ℕ → X → ℝ
@gridFlow_succ : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X] {step : Matrix X X ℝ} {d : X → X → ℝ}
  {dim C_up c_up C_lo c_lo : ℝ} (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) (f : X → ℝ) (n : ℕ),
  gridFlow K f (n + 1) = heatStep step (gridFlow K f n)
@gridFlow_nonneg : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X] {step : Matrix X X ℝ} {d : X → X → ℝ}
  {dim C_up c_up C_lo c_lo : ℝ} (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) (f : X → ℝ),
  (∀ (x : X), 0 ≤ f x) → (∀ (x y : X), 0 ≤ step x y) → ∀ (n : ℕ) (x : X), 0 ≤ gridFlow K f n x
@heatContent : {X : Type u_1} → [Fintype X] → (X → ℝ) → (X → ℝ) → ℝ
@l2Energy : {X : Type u_1} → [Fintype X] → (X → ℝ) → ℝ
@weighted_cauchy_schwarz : ∀ {X : Type u_1} [inst : Fintype X] (a b : X → ℝ),
  (∀ (x : X), 0 ≤ a x) → (∑ x, a x * b x) ^ 2 ≤ (∑ x, a x) * ∑ x, a x * b x ^ 2
@heatContent_heatStep_le : ∀ {X : Type u_1} [inst : Fintype X] (P : Matrix X X ℝ) (μ u : X → ℝ),
  (∀ (x y : X), 0 ≤ P x y) →
    (∀ (x : X), 0 ≤ μ x) →
      (∀ (x : X), 0 ≤ u x) → (∀ (y : X), ∑ x, μ x * P x y ≤ μ y) → heatContent μ (heatStep P u) ≤ heatContent μ u
@heatContent_antitone : ∀ {X : Type u_1} [inst : Fintype X] (P : Matrix X X ℝ) (μ : X → ℝ) (u : ℕ → X → ℝ),
  (∀ (x y : X), 0 ≤ P x y) →
    (∀ (x : X), 0 ≤ μ x) →
      (∀ (n : ℕ) (x : X), 0 ≤ u n x) →
        (∀ (y : X), ∑ x, μ x * P x y ≤ μ y) →
          (∀ (n : ℕ), u (n + 1) = heatStep P (u n)) → Antitone fun n => heatContent μ (u n)
@l2Energy_heatStep_le : ∀ {X : Type u_1} [inst : Fintype X] (P : Matrix X X ℝ) (u : X → ℝ),
  (∀ (x y : X), 0 ≤ P x y) →
    (∀ (x : X), ∑ y, P x y ≤ 1) → (∀ (y : X), ∑ x, P x y ≤ 1) → l2Energy (heatStep P u) ≤ l2Energy u
@l2Energy_antitone : ∀ {X : Type u_1} [inst : Fintype X] (P : Matrix X X ℝ) (u : ℕ → X → ℝ),
  (∀ (x y : X), 0 ≤ P x y) →
    (∀ (x : X), ∑ y, P x y ≤ 1) →
      (∀ (y : X), ∑ x, P x y ≤ 1) → (∀ (n : ℕ), u (n + 1) = heatStep P (u n)) → Antitone fun n => l2Energy (u n)
@heatContent_gridFlow_antitone : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X] {step : Matrix X X ℝ}
  {d : X → X → ℝ} {dim C_up c_up C_lo c_lo : ℝ} (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) (f μ : X → ℝ),
  (∀ (x y : X), 0 ≤ step x y) →
    (∀ (x : X), 0 ≤ f x) →
      (∀ (x : X), 0 ≤ μ x) → (∀ (y : X), ∑ x, μ x * step x y ≤ μ y) → Antitone fun n => heatContent μ (gridFlow K f n)
@l2Energy_gridFlow_antitone : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X] {step : Matrix X X ℝ}
  {d : X → X → ℝ} {dim C_up c_up C_lo c_lo : ℝ} (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) (f : X → ℝ),
  (∀ (x y : X), 0 ≤ step x y) →
    (∀ (x : X), ∑ y, step x y ≤ 1) → (∀ (y : X), ∑ x, step x y ≤ 1) → Antitone fun n => l2Energy (gridFlow K f n)
