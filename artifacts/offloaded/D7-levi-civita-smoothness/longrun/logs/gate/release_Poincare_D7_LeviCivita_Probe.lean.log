  (i j k : ι) :
  LeviCivita.connectionCoefficient m (LeviCivita.affineConnection a nabla₁ nabla₂) i j k +
      LeviCivita.connectionCoefficient m (LeviCivita.affineConnection a nabla₁ nabla₂) i k j =
    0
Poincare.D7.LeviCivita.isTorsionFree_coefficient_relation_affine.{v, w} {V : Type v} [NormedAddCommGroup V]
  [NormedSpace ℝ V] [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι]
  (m : Longrun.Geometry.MetricData V ι) (b : Longrun.Geometry.LieBracketData ℝ V) (a : ℝ)
  {nabla₁ nabla₂ : V →ₗ[ℝ] V →ₗ[ℝ] V}
  (h₁ :
    ∀ (i j k : ι),
      LeviCivita.connectionCoefficient m nabla₁ i j k - LeviCivita.connectionCoefficient m nabla₁ j i k =
        LeviCivita.bracketCoefficient m b i j k)
  (h₂ :
    ∀ (i j k : ι),
      LeviCivita.connectionCoefficient m nabla₂ i j k - LeviCivita.connectionCoefficient m nabla₂ j i k =
        LeviCivita.bracketCoefficient m b i j k)
  (i j k : ι) :
  LeviCivita.connectionCoefficient m (LeviCivita.affineConnection a nabla₁ nabla₂) i j k -
      LeviCivita.connectionCoefficient m (LeviCivita.affineConnection a nabla₁ nabla₂) j i k =
    LeviCivita.bracketCoefficient m b i j k
