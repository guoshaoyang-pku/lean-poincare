Poincare.D7.LeviCivita.isMetricCompatible_coefficient_relation_affine.{v, w} {V : Type v} [NormedAddCommGroup V]
  [NormedSpace ℝ V] [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι]
  (m : Longrun.Geometry.MetricData V ι) (a : ℝ) {nabla₁ nabla₂ : V →ₗ[ℝ] V →ₗ[ℝ] V}
  (h₁ :
    ∀ (i j k : ι),
      LeviCivita.connectionCoefficient m nabla₁ i j k + LeviCivita.connectionCoefficient m nabla₁ i k j = 0)
  (h₂ :
    ∀ (i j k : ι),
