Poincare.D7.LeviCivita.coefficientField_affineField.{v, w, u} {V : Type v} [NormedAddCommGroup V] [NormedSpace ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] {P : Type u} [NormedAddCommGroup P] [NormedSpace ℝ P]
  {e : ι → V} {ℓ : V →L[ℝ] ℝ} (a : ℝ) (nabla₁ nabla₂ : P → V →L[ℝ] V →L[ℝ] V) (i j : ι) (x : P) :
  LeviCivita.coefficientField e ℓ (LeviCivita.affineField a nabla₁ nabla₂) i j x =
    a * LeviCivita.coefficientField e ℓ nabla₁ i j x + (1 - a) * LeviCivita.coefficientField e ℓ nabla₂ i j x
