Poincare.D7.Reduced.gaussian_integrand {n : ℕ} (q : EuclideanSpace ℝ (Fin n)) {τ σ : ℝ} (hτ : 0 < τ) (hσ : 0 < σ) :
  √σ * ⟪gaussianVelocity q τ σ, gaussianVelocity q τ σ⟫ = ‖q‖ ^ 2 / (4 * τ * √σ)
