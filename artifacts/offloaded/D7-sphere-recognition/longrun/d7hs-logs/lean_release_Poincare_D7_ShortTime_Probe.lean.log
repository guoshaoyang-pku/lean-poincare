RicciFlowData : ℕ → Type
@RicciFlowData.ricci : {n : ℕ} → RicciFlowData n → Matrix (Fin n) (Fin n) ℝ → Matrix (Fin n) (Fin n) ℝ
@RicciFlowData.ricci_symm : ∀ {n : ℕ} (self : RicciFlowData n) (G : Matrix (Fin n) (Fin n) ℝ),
  Gᵀ = G → (self.ricci G)ᵀ = self.ricci G
@RicciFlowData.ricci_congruence : ∀ {n : ℕ} (self : RicciFlowData n) (G A : Matrix (Fin n) (Fin n) ℝ),
  IsUnit A.det → self.ricci (Aᵀ * G * A) = Aᵀ * self.ricci G * A
@RicciFlowData.metric : {n : ℕ} → RicciFlowData n → ℝ → Matrix (Fin n) (Fin n) ℝ
@RicciFlowData.metric_symm : ∀ {n : ℕ} (self : RicciFlowData n) (t : ℝ), (self.metric t)ᵀ = self.metric t
@RicciFlowData.ricci_flow : ∀ {n : ℕ} (self : RicciFlowData n) (t : ℝ),
  HasDerivAt self.metric (-2 • self.ricci (self.metric t)) t
@RicciFlowData.ricciVectorField : {n : ℕ} → RicciFlowData n → ℝ → Matrix (Fin n) (Fin n) ℝ → Matrix (Fin n) (Fin n) ℝ
@RicciFlowData.ricci_flow_eq_vectorField : ∀ {n : ℕ} (D : RicciFlowData n) (t : ℝ),
  HasDerivAt D.metric (D.ricciVectorField t (D.metric t)) t
@deTurckRHS : {n : ℕ} → RicciFlowData n → Matrix (Fin n) (Fin n) ℝ → Matrix (Fin n) (Fin n) ℝ → Matrix (Fin n) (Fin n) ℝ
@deTurckRHS_def : ∀ {n : ℕ} (D : RicciFlowData n) (B G : Matrix (Fin n) (Fin n) ℝ),
  deTurckRHS D B G = -2 • D.ricci G - Bᵀ * G - G * B
@deTurckRHS_eq_ricciVectorField_sub : ∀ {n : ℕ} (D : RicciFlowData n) (B G : Matrix (Fin n) (Fin n) ℝ),
  deTurckRHS D B G = D.ricciVectorField 0 G - (Bᵀ * G + G * B)
@DeTurckCertificate : {n : ℕ} → RicciFlowData n → Type
@DeTurckCertificate.gauge : {n : ℕ} → {D : RicciFlowData n} → DeTurckCertificate D → ℝ → Matrix (Fin n) (Fin n) ℝ
@DeTurckCertificate.gaugeInv : {n : ℕ} → {D : RicciFlowData n} → DeTurckCertificate D → ℝ → Matrix (Fin n) (Fin n) ℝ
@DeTurckCertificate.gaugeField : {n : ℕ} → {D : RicciFlowData n} → DeTurckCertificate D → ℝ → Matrix (Fin n) (Fin n) ℝ
@DeTurckCertificate.gauge_ode : ∀ {n : ℕ} {D : RicciFlowData n} (self : DeTurckCertificate D) (t : ℝ),
  HasDerivAt self.gauge (self.gaugeField t * self.gauge t) t
@DeTurckCertificate.gaugeInvDeriv : {n : ℕ} →
  {D : RicciFlowData n} → DeTurckCertificate D → ℝ → Matrix (Fin n) (Fin n) ℝ
@DeTurckCertificate.gaugeInv_ode : ∀ {n : ℕ} {D : RicciFlowData n} (self : DeTurckCertificate D) (t : ℝ),
  HasDerivAt self.gaugeInv (self.gaugeInvDeriv t) t
@DeTurckCertificate.gauge_zero : ∀ {n : ℕ} {D : RicciFlowData n} (self : DeTurckCertificate D), self.gauge 0 = 1
@DeTurckCertificate.gaugeInv_zero : ∀ {n : ℕ} {D : RicciFlowData n} (self : DeTurckCertificate D), self.gaugeInv 0 = 1
@DeTurckCertificate.inv_mul : ∀ {n : ℕ} {D : RicciFlowData n} (self : DeTurckCertificate D) (t : ℝ),
  self.gaugeInv t * self.gauge t = 1
@DeTurckCertificate.mul_inv : ∀ {n : ℕ} {D : RicciFlowData n} (self : DeTurckCertificate D) (t : ℝ),
  self.gauge t * self.gaugeInv t = 1
@DeTurckCertificate.deturckMetric : {n : ℕ} →
  {D : RicciFlowData n} → DeTurckCertificate D → ℝ → Matrix (Fin n) (Fin n) ℝ
@DeTurckCertificate.deturck_symm : ∀ {n : ℕ} {D : RicciFlowData n} (self : DeTurckCertificate D) (t : ℝ),
  (self.deturckMetric t)ᵀ = self.deturckMetric t
@DeTurckCertificate.deturck_flow : ∀ {n : ℕ} {D : RicciFlowData n} (self : DeTurckCertificate D) (t : ℝ),
  HasDerivAt self.deturckMetric (deTurckRHS D (self.gaugeField t) (self.deturckMetric t)) t
@DeTurckCertificate.deturck_zero : ∀ {n : ℕ} {D : RicciFlowData n} (self : DeTurckCertificate D),
  self.deturckMetric 0 = D.metric 0
@DeTurckCertificate.isUnit_det_gauge : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D) (t : ℝ),
  IsUnit (C.gauge t).det
@DeTurckCertificate.pullback : {n : ℕ} → {D : RicciFlowData n} → DeTurckCertificate D → ℝ → Matrix (Fin n) (Fin n) ℝ
@DeTurckCertificate.pullback_symm : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D) (t : ℝ),
  (C.pullback t)ᵀ = C.pullback t
@DeTurckCertificate.pullback_zero : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D),
  C.pullback 0 = D.metric 0
LipschitzVectorField : (E : Type u_1) → [inst : NormedAddCommGroup E] → [NormedSpace ℝ E] → Type u_1
@LipschitzVectorField.solution_unique : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  (V : LipschitzVectorField E) {f g : ℝ → E},
  (∀ (t : ℝ), HasDerivAt f (V.toFun t (f t)) t) → (∀ (t : ℝ), HasDerivAt g (V.toFun t (g t)) t) → f 0 = g 0 → f = g
@LipschitzVectorField.solution_eq : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  (V : LipschitzVectorField E) {f g : ℝ → E},
  (∀ (t : ℝ), HasDerivAt f (V.toFun t (f t)) t) →
    (∀ (t : ℝ), HasDerivAt g (V.toFun t (g t)) t) → f 0 = g 0 → ∀ (t : ℝ), f t = g t
@RicciLipschitzInterface : {n : ℕ} → RicciFlowData n → Type
@RicciLipschitzInterface.toLipschitzVectorField : {n : ℕ} →
  {D : RicciFlowData n} → RicciLipschitzInterface D → LipschitzVectorField (Matrix (Fin n) (Fin n) ℝ)
@RicciLipschitzInterface.solution_unique : ∀ {n : ℕ} {D : RicciFlowData n} (L : RicciLipschitzInterface D)
  {f g : ℝ → Matrix (Fin n) (Fin n) ℝ},
  (∀ (t : ℝ), HasDerivAt f (-2 • D.ricci (f t)) t) →
    (∀ (t : ℝ), HasDerivAt g (-2 • D.ricci (g t)) t) → f 0 = g 0 → f = g
@RicciLipschitzInterface.solution_eq : ∀ {n : ℕ} {D : RicciFlowData n} (L : RicciLipschitzInterface D)
  {f g : ℝ → Matrix (Fin n) (Fin n) ℝ},
  (∀ (t : ℝ), HasDerivAt f (-2 • D.ricci (f t)) t) →
    (∀ (t : ℝ), HasDerivAt g (-2 • D.ricci (g t)) t) → f 0 = g 0 → ∀ (t : ℝ), f t = g t
@hasDerivAt_transpose : ∀ {n : ℕ} {f : ℝ → Matrix (Fin n) (Fin n) ℝ} {f' : Matrix (Fin n) (Fin n) ℝ} {t : ℝ},
  HasDerivAt f f' t → HasDerivAt (fun s => (f s)ᵀ) f'ᵀ t
@hasDerivAt_mul : ∀ {n : ℕ} {f g : ℝ → Matrix (Fin n) (Fin n) ℝ} {f' g' : Matrix (Fin n) (Fin n) ℝ} {t : ℝ},
  HasDerivAt f f' t → HasDerivAt g g' t → HasDerivAt (fun s => f s * g s) (f' * g t + f t * g') t
@hasDerivAt_mul_three : ∀ {n : ℕ} {f g h : ℝ → Matrix (Fin n) (Fin n) ℝ} {f' g' h' : Matrix (Fin n) (Fin n) ℝ} {t : ℝ},
  HasDerivAt f f' t →
    HasDerivAt g g' t →
      HasDerivAt h h' t → HasDerivAt (fun s => f s * g s * h s) (f' * g t * h t + f t * g' * h t + f t * g t * h') t
@hasDerivAt_const_matrix : ∀ {n : ℕ} (c : Matrix (Fin n) (Fin n) ℝ) (t : ℝ), HasDerivAt (fun x => c) 0 t
@hasDerivAt_add_matrix : ∀ {n : ℕ} {f g : ℝ → Matrix (Fin n) (Fin n) ℝ} {f' g' : Matrix (Fin n) (Fin n) ℝ} {t : ℝ},
  HasDerivAt f f' t → HasDerivAt g g' t → HasDerivAt (fun s => f s + g s) (f' + g') t
@hasDerivAt_sub_matrix : ∀ {n : ℕ} {f g : ℝ → Matrix (Fin n) (Fin n) ℝ} {f' g' : Matrix (Fin n) (Fin n) ℝ} {t : ℝ},
  HasDerivAt f f' t → HasDerivAt g g' t → HasDerivAt (fun s => f s - g s) (f' - g') t
@hasDerivAt_neg_matrix : ∀ {n : ℕ} {f : ℝ → Matrix (Fin n) (Fin n) ℝ} {f' : Matrix (Fin n) (Fin n) ℝ} {t : ℝ},
  HasDerivAt f f' t → HasDerivAt (fun s => -f s) (-f') t
@hasDerivAt_const_smul_matrix : ∀ {n : ℕ} {f : ℝ → Matrix (Fin n) (Fin n) ℝ} {f' : Matrix (Fin n) (Fin n) ℝ} {t : ℝ}
  (c : ℝ), HasDerivAt f f' t → HasDerivAt (fun s => c • f s) (c • f') t
@hasDerivAt_smul_const_matrix : ∀ {n : ℕ} {c : ℝ → ℝ} {c' : ℝ} {G : Matrix (Fin n) (Fin n) ℝ} {t : ℝ},
  HasDerivAt c c' t → HasDerivAt (fun s => c s • G) (c' • G) t
@hasDerivAt_id_smul_matrix : ∀ {n : ℕ} (G : Matrix (Fin n) (Fin n) ℝ) (t : ℝ), HasDerivAt (fun s => s • G) (1 • G) t
@gaugeAction : {n : ℕ} → Matrix (Fin n) (Fin n) ℝ → Matrix (Fin n) (Fin n) ℝ → Matrix (Fin n) (Fin n) ℝ
@gaugeAction_transpose : ∀ {n : ℕ} (A G : Matrix (Fin n) (Fin n) ℝ), Gᵀ = G → (gaugeAction A G)ᵀ = gaugeAction A G
@gaugeAction_inv : ∀ {n : ℕ} (A Ainv G : Matrix (Fin n) (Fin n) ℝ),
  Ainv * A = 1 → gaugeAction A (gaugeAction Ainv G) = G
@gauge_pullback_algebra : ∀ {n : ℕ} (A B G G' : Matrix (Fin n) (Fin n) ℝ),
  (B * A)ᵀ * G * A + Aᵀ * G' * A + Aᵀ * G * (B * A) = Aᵀ * (Bᵀ * G + G' + G * B) * A
@deTurckRHS_add_gauge : ∀ {n : ℕ} (D : RicciFlowData n) (B G : Matrix (Fin n) (Fin n) ℝ),
  Bᵀ * G + deTurckRHS D B G + G * B = -2 • D.ricci G
@gauge_pullback_deTurckRHS : ∀ {n : ℕ} (D : RicciFlowData n) (A B G : Matrix (Fin n) (Fin n) ℝ),
  IsUnit A.det → (B * A)ᵀ * G * A + Aᵀ * deTurckRHS D B G * A + Aᵀ * G * (B * A) = -2 • D.ricci (Aᵀ * G * A)
@gaugeInv_ricci_congruence : ∀ {n : ℕ} (D : RicciFlowData n) (A Ainv G : Matrix (Fin n) (Fin n) ℝ),
  IsUnit A.det → A * Ainv = 1 → Ainvᵀ * D.ricci (Aᵀ * G * A) * Ainv = D.ricci G
@DeTurckCertificate.gaugeInvDeriv_eq : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D) (t : ℝ),
  C.gaugeInvDeriv t = -(C.gaugeInv t * C.gaugeField t)
@DeTurckCertificate.gauge_conj_inv : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D) (t : ℝ)
  (H : Matrix (Fin n) (Fin n) ℝ), (C.gauge t)ᵀ * ((C.gaugeInv t)ᵀ * H * C.gaugeInv t) * C.gauge t = H
@DeTurckCertificate.pullback_hasDerivAt_at : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D)
  (G : ℝ → Matrix (Fin n) (Fin n) ℝ) {t : ℝ},
  HasDerivAt G (deTurckRHS D (C.gaugeField t) (G t)) t →
    HasDerivAt (fun s => (C.gauge s)ᵀ * G s * C.gauge s) (-2 • D.ricci ((C.gauge t)ᵀ * G t * C.gauge t)) t
@DeTurckCertificate.pullback_hasDerivAt_of : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D)
  (G : ℝ → Matrix (Fin n) (Fin n) ℝ),
  (∀ (s : ℝ), HasDerivAt G (deTurckRHS D (C.gaugeField s) (G s)) s) →
    ∀ (t : ℝ), HasDerivAt (fun s => (C.gauge s)ᵀ * G s * C.gauge s) (-2 • D.ricci ((C.gauge t)ᵀ * G t * C.gauge t)) t
@DeTurckCertificate.pullback_hasDerivAt_of_Ioo : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D)
  (G : ℝ → Matrix (Fin n) (Fin n) ℝ) (T : ℝ),
  (∀ s ∈ Set.Ioo 0 T, HasDerivAt G (deTurckRHS D (C.gaugeField s) (G s)) s) →
    ∀ {t : ℝ},
      t ∈ Set.Ioo 0 T →
        HasDerivAt (fun s => (C.gauge s)ᵀ * G s * C.gauge s) (-2 • D.ricci ((C.gauge t)ᵀ * G t * C.gauge t)) t
@DeTurckCertificate.pullback_hasDerivAt : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D) (t : ℝ),
  HasDerivAt (fun s => (C.gauge s)ᵀ * C.deturckMetric s * C.gauge s)
    (-2 • D.ricci ((C.gauge t)ᵀ * C.deturckMetric t * C.gauge t)) t
@DeTurckCertificate.pullback_solves_ricciFlow : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D) (t : ℝ),
  HasDerivAt (fun s => (C.gauge s)ᵀ * C.deturckMetric s * C.gauge s)
    (-2 • D.ricci ((C.gauge t)ᵀ * C.deturckMetric t * C.gauge t)) t
@DeTurckCertificate.pullback_eq_metric : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D)
  (L : RicciLipschitzInterface D) (t : ℝ), (C.gauge t)ᵀ * C.deturckMetric t * C.gauge t = D.metric t
@DeTurckCertificate.gaugeInv_hasDerivAt : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D)
  (H : ℝ → Matrix (Fin n) (Fin n) ℝ),
  (∀ (t : ℝ), HasDerivAt H (-2 • D.ricci (H t)) t) →
    ∀ (t : ℝ),
      HasDerivAt (fun s => (C.gaugeInv s)ᵀ * H s * C.gaugeInv s)
        (deTurckRHS D (C.gaugeField t) ((C.gaugeInv t)ᵀ * H t * C.gaugeInv t)) t
@DeTurckCertificate.ricciFlow_gauge_recover : ∀ {n : ℕ} {D : RicciFlowData n} (C : DeTurckCertificate D)
  (H : ℝ → Matrix (Fin n) (Fin n) ℝ),
  (∀ (t : ℝ), HasDerivAt H (-2 • D.ricci (H t)) t) →
    ∀ (t : ℝ),
      HasDerivAt (fun s => (C.gaugeInv s)ᵀ * H s * C.gaugeInv s)
        (deTurckRHS D (C.gaugeField t) ((C.gaugeInv t)ᵀ * H t * C.gaugeInv t)) t
DeTurckParabolicProblem : Type 1
DeTurckShortTimeExistence : DeTurckParabolicProblem → Prop
DeTurckToRicciConversion : DeTurckParabolicProblem → Prop
@matrixProblem : {n : ℕ} → (D : RicciFlowData n) → DeTurckCertificate D → DeTurckParabolicProblem
@matrixProblem_deTurckToRicciConversion : ∀ {n : ℕ} (D : RicciFlowData n) (C : DeTurckCertificate D),
  DeTurckToRicciConversion (matrixProblem D C)
MissingDependency : Type
BlockerDeTurckShortTime : String
BlockerDeTurckConversion : String
BlockerDeTurckShortTime_ne_nil : BlockerDeTurckShortTime ≠ ""
BlockerDeTurckConversion_ne_nil : BlockerDeTurckConversion ≠ ""
quasilinearParabolicDependencies : List MissingDependency
quasilinearParabolicDependencies_length : quasilinearParabolicDependencies.length = 8
quasilinearParabolicDependencies_ne_nil : quasilinearParabolicDependencies ≠ []
quasilinearParabolicDependencies_all_named : ∀ d ∈ quasilinearParabolicDependencies, d.name ≠ "" ∧ d.reason ≠ ""
@einsteinRicci : {n : ℕ} → ℝ → Matrix (Fin n) (Fin n) ℝ → Matrix (Fin n) (Fin n) ℝ
@einsteinRicci_symm : ∀ {n : ℕ} (c : ℝ) (G : Matrix (Fin n) (Fin n) ℝ),
  Gᵀ = G → (einsteinRicci c G)ᵀ = einsteinRicci c G
@einsteinRicci_congruence : ∀ {n : ℕ} (c : ℝ) (G A : Matrix (Fin n) (Fin n) ℝ),
  einsteinRicci c (Aᵀ * G * A) = Aᵀ * einsteinRicci c G * A
@hasDerivAt_exp_smul : ∀ {n : ℕ} (c : ℝ) (G₀ : Matrix (Fin n) (Fin n) ℝ) (t : ℝ),
  HasDerivAt (fun s => Real.exp (-2 * c * s) • G₀) (-2 • c • Real.exp (-2 * c * t) • G₀) t
@einsteinRicciFlowData : {n : ℕ} → ℝ → (G₀ : Matrix (Fin n) (Fin n) ℝ) → G₀ᵀ = G₀ → RicciFlowData n
@flatRicciFlowData : {n : ℕ} → (G₀ : Matrix (Fin n) (Fin n) ℝ) → G₀ᵀ = G₀ → RicciFlowData n
@trivialDeTurckCertificate : {n : ℕ} → (D : RicciFlowData n) → DeTurckCertificate D
@nilpotent_gauge_correction : ∀ {n : ℕ} (H₀ B : Matrix (Fin n) (Fin n) ℝ),
  B * B = 0 → Bᵀ * H₀ * B = 0 → Bᵀ * (Bᵀ * H₀ + H₀ * B) + (Bᵀ * H₀ + H₀ * B) * B = 0
@nilpotent_deTurckRHS : ∀ {n : ℕ} (H₀ B : Matrix (Fin n) (Fin n) ℝ),
  B * B = 0 →
    Bᵀ * H₀ * B = 0 →
      ∀ (t : ℝ), Bᵀ * (H₀ - t • (Bᵀ * H₀ + H₀ * B)) + (H₀ - t • (Bᵀ * H₀ + H₀ * B)) * B = Bᵀ * H₀ + H₀ * B
@nilpotentDeTurckCertificate : {n : ℕ} →
  (H₀ B : Matrix (Fin n) (Fin n) ℝ) →
    (hH₀ : H₀ᵀ = H₀) → B * B = 0 → Bᵀ * H₀ * B = 0 → DeTurckCertificate (flatRicciFlowData H₀ hH₀)
nilpotentB : Matrix (Fin 3) (Fin 3) ℝ
nilpotentH : Matrix (Fin 3) (Fin 3) ℝ
nilpotentH_transpose : nilpotentHᵀ = nilpotentH
nilpotentB_sq : nilpotentB * nilpotentB = 0
nilpotentB_H_B : nilpotentBᵀ * nilpotentH * nilpotentB = 0
nilpotentB_H_add_ne_zero : nilpotentBᵀ * nilpotentH + nilpotentH * nilpotentB ≠ 0
concreteDeTurckCertificate : DeTurckCertificate (flatRicciFlowData nilpotentH nilpotentH_transpose)
concreteDeTurck_metric_deriv_ne_zero : -(1 • (nilpotentBᵀ * nilpotentH + nilpotentH * nilpotentB)) ≠ 0
@trivial_pullback_eq : ∀ {n : ℕ} (D : RicciFlowData n) (t : ℝ),
  ((trivialDeTurckCertificate D).gauge t)ᵀ * (trivialDeTurckCertificate D).deturckMetric t *
      (trivialDeTurckCertificate D).gauge t =
    D.metric t
