@TensorConnectionData.roughLaplacian_apply : ∀ {V : Type u_1} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (TD : TensorConnectionData D T) (s : T),
  TD.roughLaplacian s = ∑ i, (TD.nabla (D.metric.basis i)) ((TD.nabla (D.metric.basis i)) s)
@TensorConnectionData.roughLaplacian_add : ∀ {V : Type u_1} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (TD : TensorConnectionData D T) (s u : T), TD.roughLaplacian (s + u) = TD.roughLaplacian s + TD.roughLaplacian u
@TensorConnectionData.roughLaplacian_smul : ∀ {V : Type u_1} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (TD : TensorConnectionData D T) (a : ℝ) (s : T), TD.roughLaplacian (a • s) = a • TD.roughLaplacian s
@TensorConnectionData.commutator_term : ∀ {V : Type u_1} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (TD : TensorConnectionData D T) (i : ι) (X : V) (s : T),
  (TD.nabla (D.metric.basis i)) ((TD.nabla (D.metric.basis i)) ((TD.nabla X) s)) -
      (TD.nabla X) ((TD.nabla (D.metric.basis i)) ((TD.nabla (D.metric.basis i)) s)) =
    ((TD.curvature (D.metric.basis i)) X) ((TD.nabla (D.metric.basis i)) s) +
          (TD.nabla ((D.conn.lie.bracket (D.metric.basis i)) X)) ((TD.nabla (D.metric.basis i)) s) +
        (TD.nabla (D.metric.basis i)) ((TD.nabla ((D.conn.lie.bracket (D.metric.basis i)) X)) s) +
      (TD.nabla (D.metric.basis i)) (((TD.curvature (D.metric.basis i)) X) s)
@TensorConnectionData.roughLaplacian_commutator_general : ∀ {V : Type u_1} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (TD : TensorConnectionData D T) (X : V) (s : T),
  TD.roughLaplacian ((TD.nabla X) s) - (TD.nabla X) (TD.roughLaplacian s) =
    ∑ i,
      (((TD.curvature (D.metric.basis i)) X) ((TD.nabla (D.metric.basis i)) s) +
            (TD.nabla ((D.conn.lie.bracket (D.metric.basis i)) X)) ((TD.nabla (D.metric.basis i)) s) +
          (TD.nabla (D.metric.basis i)) ((TD.nabla ((D.conn.lie.bracket (D.metric.basis i)) X)) s) +
        (TD.nabla (D.metric.basis i)) (((TD.curvature (D.metric.basis i)) X) s))
@TensorConnectionData.roughLaplacian_commutator_of_bracket_zero : ∀ {V : Type u_1} [inst : AddCommGroup V]
  [inst_1 : Module ℝ V] [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (TD : TensorConnectionData D T) (X : V) (s : T),
  (∀ (i : ι), (D.conn.lie.bracket (D.metric.basis i)) X = 0) →
    TD.roughLaplacian ((TD.nabla X) s) - (TD.nabla X) (TD.roughLaplacian s) =
      ∑ i,
        (((TD.curvature (D.metric.basis i)) X) ((TD.nabla (D.metric.basis i)) s) +
          (TD.nabla (D.metric.basis i)) (((TD.curvature (D.metric.basis i)) X) s))
