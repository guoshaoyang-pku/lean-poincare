@TensorConnectionData.roughLaplacian_commutator_frame_trace : ∀ {V : Type u_1} [inst : AddCommGroup V]
  [inst_1 : Module ℝ V] [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (TD : TensorConnectionData D T) (C : TD.ScalarCurvatureCommutationCertificate) (s : T),
  (∀ (i j : ι), (D.conn.lie.bracket (D.metric.basis i)) (D.metric.basis j) = 0) →
    TD.HasParallelCurvature →
      ∑ j, (TD.roughLaplacian ((TD.nabla (D.metric.basis j)) s) - (TD.nabla (D.metric.basis j)) (TD.roughLaplacian s)) =
        (2 * D.scalarCurvature) • s
@TensorConnectionData.roughLaplacian_commutator_eq_zero_of_flat : ∀ {V : Type u_1} [inst : AddCommGroup V]
  [inst_1 : Module ℝ V] [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
