@TensorConnectionData.roughLaplacian_commutator_ricci : ∀ {V : Type u_1} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (TD : TensorConnectionData D T) (C : TD.RicciCommutationCertificate) (X : V) (s : T),
  (∀ (i : ι), (D.conn.lie.bracket (D.metric.basis i)) X = 0) →
    TD.HasParallelCurvature →
      TD.roughLaplacian ((TD.nabla X) s) - (TD.nabla X) (TD.roughLaplacian s) = 2 • (C.ricciEndo X) s
@TensorConnectionData.ScalarCurvatureCommutationCertificate : {V : Type u_1} →
  [inst : AddCommGroup V] →
    [inst_1 : Module ℝ V] →
      [inst_2 : FiniteDimensional ℝ V] →
