  (TD : TensorConnectionData D T) (X : V) (s : T),
  (∀ (i : ι), (D.conn.lie.bracket (D.metric.basis i)) X = 0) →
    (∀ (i : ι) (Y : V) (u : T), ((TD.curvature (D.metric.basis i)) Y) u = 0) →
      TD.roughLaplacian ((TD.nabla X) s) - (TD.nabla X) (TD.roughLaplacian s) = 0
