        {ι : Type u_2} →
          [inst_3 : Fintype ι] →
            [inst_4 : DecidableEq ι] →
              Curvature.RiemannCurvatureData V ι →
                (T : Type u_3) → [inst : AddCommGroup T] → [Module ℝ T] → Type (max u_3 u_1)
@TensorConnectionData.nabla : {V : Type u_1} →
  [inst : AddCommGroup V] →
    [inst_1 : Module ℝ V] →
      [inst_2 : FiniteDimensional ℝ V] →
        {ι : Type u_2} →
          [inst_3 : Fintype ι] →
            [inst_4 : DecidableEq ι] →
              {D : Curvature.RiemannCurvatureData V ι} →
                {T : Type u_3} →
                  [inst_5 : AddCommGroup T] → [inst_6 : Module ℝ T] → TensorConnectionData D T → V →ₗ[ℝ] T →ₗ[ℝ] T
@TensorConnectionData.curvature : {V : Type u_1} →
  [inst : AddCommGroup V] →
    [inst_1 : Module ℝ V] →
      [inst_2 : FiniteDimensional ℝ V] →
        {ι : Type u_2} →
          [inst_3 : Fintype ι] →
            [inst_4 : DecidableEq ι] →
              {D : Curvature.RiemannCurvatureData V ι} →
                {T : Type u_3} →
                  [inst_5 : AddCommGroup T] →
                    [inst_6 : Module ℝ T] → TensorConnectionData D T → V →ₗ[ℝ] V →ₗ[ℝ] T →ₗ[ℝ] T
@TensorConnectionData.curvature_certificate : ∀ {V : Type u_1} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (self : TensorConnectionData D T) (X Y : V) (s : T),
  (self.nabla X) ((self.nabla Y) s) - (self.nabla Y) ((self.nabla X) s) - (self.nabla ((D.conn.lie.bracket X) Y)) s =
    ((self.curvature X) Y) s
@TensorConnectionData.curvature_skew : ∀ {V : Type u_1} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (TD : TensorConnectionData D T) (X Y : V) (s : T), ((TD.curvature X) Y) s = -((TD.curvature Y) X) s
@TensorConnectionData.second_covariant_derivative_commutation : ∀ {V : Type u_1} [inst : AddCommGroup V]
  [inst_1 : Module ℝ V] [inst_2 : FiniteDimensional ℝ V] {ι : Type u_2} [inst_3 : Fintype ι] [inst_4 : DecidableEq ι]
  {D : Curvature.RiemannCurvatureData V ι} {T : Type u_3} [inst_5 : AddCommGroup T] [inst_6 : Module ℝ T]
  (TD : TensorConnectionData D T) (X Y : V) (s : T),
  (TD.nabla X) ((TD.nabla Y) s) - (TD.nabla Y) ((TD.nabla X) s) =
    (TD.nabla ((D.conn.lie.bracket X) Y)) s + ((TD.curvature X) Y) s
