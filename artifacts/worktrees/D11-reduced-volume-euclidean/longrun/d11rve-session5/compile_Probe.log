  D7.Reduced.LPath (euclideanFlow n) 0 x τ
Poincare.D11.ReducedVolume.straightRay_length {n : ℕ} (x : EuclideanSpace ℝ (Fin n)) {τ : ℝ} (hτ : 0 < τ) :
  (euclideanFlow n).LlengthAlong (straightRay x τ) (straightRayVelocity x τ) 0 τ = ‖x‖ ^ 2 / (2 * √τ)
Poincare.D11.ReducedVolume.straightRay_reducedLength {n : ℕ} (x : EuclideanSpace ℝ (Fin n)) {τ : ℝ} (hτ : 0 < τ) :
  (euclideanFlow n).reducedLengthAlong (straightRay x τ) (straightRayVelocity x τ) τ = ‖x‖ ^ 2 / (4 * τ)
