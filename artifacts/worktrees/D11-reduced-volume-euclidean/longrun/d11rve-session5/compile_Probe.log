Poincare.D11.ReducedVolume.euclidean_LMinimizerExistence (n : ℕ) : D7.Reduced.LMinimizerExistence (euclideanFlow n) 0
Poincare.D11.ReducedVolume.flatDeficit {n : ℕ} (c v : EuclideanSpace ℝ (Fin n)) (σ : ℝ) : ℝ
Poincare.D11.ReducedVolume.flatDeficit_eq_normSq {n : ℕ} (c v : EuclideanSpace ℝ (Fin n)) {σ : ℝ} (hσ : 0 < σ) :
  flatDeficit c v σ = √σ * ‖v - (1 / √σ) • c‖ ^ 2
Poincare.D11.ReducedVolume.flatDeficit_nonneg {n : ℕ} (c v : EuclideanSpace ℝ (Fin n)) {σ : ℝ} (hσ : 0 < σ) :
  0 ≤ flatDeficit c v σ
Poincare.D11.ReducedVolume.flatDeficit_integral {n : ℕ} (c x : EuclideanSpace ℝ (Fin n)) {τ : ℝ} (hτ : 0 < τ)
  (hc : c = (1 / (2 * √τ)) • x) (P : D7.Reduced.LPath (euclideanFlow n) 0 x τ) :
  ∫ (σ : ℝ) in 0..τ, flatDeficit c (P.velocity σ) σ = P.length - ‖x‖ ^ 2 / (2 * √τ)
Poincare.D11.ReducedVolume.ae_velocity_eq_of_deficit_integral_zero {n : ℕ} (c : EuclideanSpace ℝ (Fin n))
  {x : EuclideanSpace ℝ (Fin n)} {τ : ℝ} (hτ : 0 < τ) (P : D7.Reduced.LPath (euclideanFlow n) 0 x τ)
  (hz : ∫ (σ : ℝ) in 0..τ, flatDeficit c (P.velocity σ) σ = 0) :
  ∀ᵐ (σ : ℝ) ∂MeasureTheory.volume.restrict (Set.Ioc 0 τ), P.velocity σ = (1 / √σ) • c
Poincare.D11.ReducedVolume.LMinimizer_eq_straightRay {n : ℕ} (x : EuclideanSpace ℝ (Fin n)) {τ : ℝ} (hτ : 0 < τ)
  (P : D7.Reduced.LPath (euclideanFlow n) 0 x τ) (hmin : D7.Reduced.IsLMinimizer P) (σ : ℝ) :
  σ ∈ Set.Icc 0 τ → P.curve σ = straightRay x τ σ
Poincare.D11.ReducedVolume.IsLMinimizer_of_eq_straightRay {n : ℕ} (x : EuclideanSpace ℝ (Fin n)) {τ : ℝ} (hτ : 0 < τ)
  (P : D7.Reduced.LPath (euclideanFlow n) 0 x τ) (hEq : ∀ σ ∈ Set.Icc 0 τ, P.curve σ = straightRay x τ σ) :
  D7.Reduced.IsLMinimizer P
Poincare.D11.ReducedVolume.minimizer_iff_eq_straightRay {n : ℕ} (x : EuclideanSpace ℝ (Fin n)) {τ : ℝ} (hτ : 0 < τ)
  (P : D7.Reduced.LPath (euclideanFlow n) 0 x τ) :
  D7.Reduced.IsLMinimizer P ↔ ∀ σ ∈ Set.Icc 0 τ, P.curve σ = straightRay x τ σ
