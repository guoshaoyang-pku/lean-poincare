  (hτ : 0 < τ) : heatKernelReducedDistance n τ q = (D7.Reduced.gaussianReducedLengthData q hτ).reducedLength
Poincare.D11.ReducedVolume.heatKernelReducedDistance_zero {n : ℕ} {τ : ℝ} (hτ : 0 < τ) :
  heatKernelReducedDistance n τ 0 = 0
