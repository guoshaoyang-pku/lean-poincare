Poincare.D12.SpectralSobolev.fourierCoeffOn_deriv_periodic {a b : ℝ} (hab : a < b) {f f' : ℝ → ℂ} {n : ℤ} (hn : n ≠ 0)
  (hf : ∀ x ∈ Set.uIcc a b, HasDerivAt f (f' x) x) (hper : f b = f a)
  (hf' : IntervalIntegrable f' MeasureTheory.volume a b) :
  fourierCoeffOn hab f' n = 2 * ↑Real.pi * Complex.I * ↑n / (↑b - ↑a) * fourierCoeffOn hab f n
Poincare.D12.SpectralSobolev.sq_norm_eigenvalue {a b : ℝ} (hab : a < b) (n : ℤ) :
  ‖2 * ↑Real.pi * Complex.I * ↑n / (↑b - ↑a)‖ ^ 2 = (2 * Real.pi * ↑n / (b - a)) ^ 2
Poincare.D12.SpectralSobolev.sq_norm_fourierCoeffOn_deriv_periodic {a b : ℝ} (hab : a < b) {f f' : ℝ → ℂ} {n : ℤ}
  (hn : n ≠ 0) (hf : ∀ x ∈ Set.uIcc a b, HasDerivAt f (f' x) x) (hper : f b = f a)
  (hf' : IntervalIntegrable f' MeasureTheory.volume a b) :
  ‖fourierCoeffOn hab f' n‖ ^ 2 = (2 * Real.pi * ↑n / (b - a)) ^ 2 * ‖fourierCoeffOn hab f n‖ ^ 2
Poincare.D12.SpectralSobolev.fourierCoeffOn_zero_eq_mean {a b : ℝ} (hab : a < b) (f : ℝ → ℂ) :
  fourierCoeffOn hab f 0 = (1 / (b - a)) • ∫ (x : ℝ) in a..b, f x
Poincare.D12.SpectralSobolev.poincare_wirtinger {a b : ℝ} (hab : a < b) {f f' : ℝ → ℂ}
  (hderiv : ∀ x ∈ Set.uIcc a b, HasDerivAt f (f' x) x) (hper : f b = f a) (hmean : fourierCoeffOn hab f 0 = 0)
  (hintf' : IntervalIntegrable f' MeasureTheory.volume a b)
  (hL2f : MeasureTheory.MemLp f 2 (MeasureTheory.volume.restrict (Set.Ioc a b)))
  (hL2f' : MeasureTheory.MemLp f' 2 (MeasureTheory.volume.restrict (Set.Ioc a b))) :
  ∫ (x : ℝ) in a..b, ‖f x‖ ^ 2 ≤ ((b - a) / (2 * Real.pi)) ^ 2 * ∫ (x : ℝ) in a..b, ‖f' x‖ ^ 2
Poincare.D12.SpectralSobolev.norm_sin_le_one (x : ℝ) : ‖↑(Real.sin x)‖ ≤ 1
Poincare.D12.SpectralSobolev.norm_cos_le_one (x : ℝ) : ‖↑(Real.cos x)‖ ≤ 1
Poincare.D12.SpectralSobolev.sine_wave_hypotheses :
  (∀ x ∈ Set.uIcc 0 (2 * Real.pi), HasDerivAt (fun x => ↑(Real.sin x)) (↑(Real.cos x)) x) ∧
    ↑(Real.sin (2 * Real.pi)) = ↑(Real.sin 0) ∧
      fourierCoeffOn ⋯ (fun x => ↑(Real.sin x)) 0 = 0 ∧
        IntervalIntegrable (fun x => ↑(Real.cos x)) MeasureTheory.volume 0 (2 * Real.pi) ∧
          MeasureTheory.MemLp (fun x => ↑(Real.sin x)) 2 (MeasureTheory.volume.restrict (Set.Ioc 0 (2 * Real.pi))) ∧
            MeasureTheory.MemLp (fun x => ↑(Real.cos x)) 2 (MeasureTheory.volume.restrict (Set.Ioc 0 (2 * Real.pi)))
Poincare.D12.SpectralSobolev.integral_sin_sq_period : ∫ (x : ℝ) in 0..2 * Real.pi, ‖↑(Real.sin x)‖ ^ 2 = Real.pi
Poincare.D12.SpectralSobolev.integral_cos_sq_period : ∫ (x : ℝ) in 0..2 * Real.pi, ‖↑(Real.cos x)‖ ^ 2 = Real.pi
Poincare.D12.SpectralSobolev.poincare_wirtinger_sine :
  ∫ (x : ℝ) in 0..2 * Real.pi, ‖↑(Real.sin x)‖ ^ 2 ≤ ∫ (x : ℝ) in 0..2 * Real.pi, ‖↑(Real.cos x)‖ ^ 2
Poincare.D12.SpectralSobolev.poincare_wirtinger_sine_saturates :
  ∫ (x : ℝ) in 0..2 * Real.pi, ‖↑(Real.sin x)‖ ^ 2 =
    ((2 * Real.pi - 0) / (2 * Real.pi)) ^ 2 * ∫ (x : ℝ) in 0..2 * Real.pi, ‖↑(Real.cos x)‖ ^ 2
Poincare.D12.SpectralSobolev.poincare_constant_sharp {C : ℝ}
  (hC :
    ∀ (f f' : ℝ → ℂ),
      (∀ x ∈ Set.uIcc 0 (2 * Real.pi), HasDerivAt f (f' x) x) →
        f (2 * Real.pi) = f 0 →
          fourierCoeffOn ⋯ f 0 = 0 →
            IntervalIntegrable f' MeasureTheory.volume 0 (2 * Real.pi) →
              MeasureTheory.MemLp f 2 (MeasureTheory.volume.restrict (Set.Ioc 0 (2 * Real.pi))) →
                MeasureTheory.MemLp f' 2 (MeasureTheory.volume.restrict (Set.Ioc 0 (2 * Real.pi))) →
                  ∫ (x : ℝ) in 0..2 * Real.pi, ‖f x‖ ^ 2 ≤ C * ∫ (x : ℝ) in 0..2 * Real.pi, ‖f' x‖ ^ 2) :
  ((2 * Real.pi - 0) / (2 * Real.pi)) ^ 2 ≤ C
Poincare.D12.SpectralSobolev.heat_evolution_first_mode_nontrivial (t : NNReal) (ht : 0 < t) :
  ‖Poincare.D12.SpectralSobolev.heatEvolve 1 t (fourierLp 2 1)‖ = Poincare.D12.SpectralSobolev.heatWeight 1 t 1 ∧
