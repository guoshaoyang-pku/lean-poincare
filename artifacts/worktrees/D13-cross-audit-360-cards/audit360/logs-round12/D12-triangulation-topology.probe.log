  (x : ↑(Poincare.D12.TriangulationTopology.Sphere (n + 1))) (hx : (↑x).ofLp (Fin.last (n + 1)) ≤ 0) :
  ↑((Poincare.D12.TriangulationTopology.lowerHemisphereHomeoDisk (n + 1)) ⟨x, hx⟩) ∈
