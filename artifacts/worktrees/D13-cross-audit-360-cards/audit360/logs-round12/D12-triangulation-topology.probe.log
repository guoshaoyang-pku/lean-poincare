  (x : ↑(Poincare.D12.TriangulationTopology.Sphere (n + 1))) (hxA : (↑x).ofLp (Fin.last (n + 1)) ≤ 0)
  (hxB : 0 ≤ (↑x).ofLp (Fin.last (n + 1))) :
