Poincare.D12.ConnectionCurvature.curvature_skew_adjoint.{v, w} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] (m : Poincare.Longrun.Geometry.MetricData V ι)
  (b : Poincare.Longrun.Geometry.LieBracketData ℝ V) (d : Poincare.Longrun.Geometry.LeviCivitaData m b) (X Y Z W : V) :
  (m.form ((fun X Y Z => ((d.toCurvatureOperator.toTrilinear X) Y) Z) X Y Z)) W =
    -(m.form Z) ((fun X Y Z => ((d.toCurvatureOperator.toTrilinear X) Y) Z) X Y W)
Poincare.D12.ConnectionCurvature.form_basis_apply_of_orthonormal.{v, w} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] (m : Poincare.Longrun.Geometry.MetricData V ι)
  (f : Module.Basis ι ℝ V) (hf : ∀ (i j : ι), (m.form (f i)) (f j) = if i = j then 1 else 0) (i : ι) (Y : V) :
  (m.form (f i)) Y = (f.repr Y) i
Poincare.D12.ConnectionCurvature.milnor_ricci_symm.{v, w} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] (m : Poincare.Longrun.Geometry.MetricData V ι)
  (b : Poincare.Longrun.Geometry.LieBracketData ℝ V) (X Y : V) :
  ((Poincare.D12.ConnectionCurvature.milnorLeviCivitaData m b).toCurvatureOperator.ricci X) Y =
    ((Poincare.D12.ConnectionCurvature.milnorLeviCivitaData m b).toCurvatureOperator.ricci Y) X
Poincare.D12.ConnectionCurvature.ricci_contraction_eq_sum_basis.{v, w} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] (m : Poincare.Longrun.Geometry.MetricData V ι)
  (K : Poincare.CurvatureAlgebra.CurvatureOperator ℝ V) (f : Module.Basis ι ℝ V)
  (hf : ∀ (i j : ι), (m.form (f i)) (f j) = if i = j then 1 else 0) (X Y : V) :
  (K.ricci X) Y = ∑ i, (m.form ((fun X Y Z => ((K.toTrilinear X) Y) Z) (f i) X Y)) (f i)
