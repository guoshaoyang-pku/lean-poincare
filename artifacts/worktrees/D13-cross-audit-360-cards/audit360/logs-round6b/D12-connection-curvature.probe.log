  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) (i j k : ι) : ContDiff ℝ ↑⊤ fun x => c.dFamily x i j k
Poincare.D12.ConnectionCurvature.SmoothChartData.dFamily_symm.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
