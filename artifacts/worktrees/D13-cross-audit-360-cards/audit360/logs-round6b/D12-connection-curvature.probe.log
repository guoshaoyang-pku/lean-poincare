Poincare.D12.ConnectionCurvature.chartCurvatureOperator.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) :
  Poincare.CurvatureAlgebra.CurvatureOperator ℝ (ι → ℝ)
Poincare.D12.ConnectionCurvature.chartCurvatureOperator_apply.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X Y Z : ι → ℝ) :
  (fun X Y Z => (((Poincare.D12.ConnectionCurvature.chartCurvatureOperator c).toTrilinear X) Y) Z) X Y Z =
    ((Poincare.D12.ConnectionCurvature.nablaOf c) X) (((Poincare.D12.ConnectionCurvature.nablaOf c) Y) Z) -
      ((Poincare.D12.ConnectionCurvature.nablaOf c) Y) (((Poincare.D12.ConnectionCurvature.nablaOf c) X) Z)
