Poincare.D12.ConnectionCurvature.ChartMetricCoefficients.christoffel_raised_contraction_first.{w} {ι : Type w}
  [Fintype ι] [DecidableEq ι] (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (a k j : ι) :
