Poincare.D12.ConnectionCurvature.ChartMetricCoefficients.christoffel_symm.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (k i j : ι) :
  c.christoffel k i j = c.christoffel k j i
Poincare.D12.ConnectionCurvature.ChartMetricCoefficients.gram_christoffel_contraction.{w} {ι : Type w} [Fintype ι]
  [DecidableEq ι] (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (a k i : ι) :
  ∑ m, c.g a m * c.christoffel m k i = c.christoffelLower a k i
Poincare.D12.ConnectionCurvature.ChartMetricCoefficients.gram_mul_gInv_delta.{w} {ι : Type w} [Fintype ι]
  [DecidableEq ι] (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (a l : ι) :
  ∑ m, c.g a m * c.gInv m l = if a = l then 1 else 0
Poincare.D12.ConnectionCurvature.ChartMetricCoefficients.gram_mul_gInv_delta_first.{w} {ι : Type w} [Fintype ι]
  [DecidableEq ι] (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (j m : ι) :
  ∑ i, c.g i j * c.gInv i m = if j = m then 1 else 0
Poincare.D12.ConnectionCurvature.ChartMetricCoefficients.metricDerivative_christoffel.{w} {ι : Type w} [Fintype ι]
  [DecidableEq ι] (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (i j k : ι) :
  c.d k i j = ∑ m, (c.g m j * c.christoffel m k i + c.g i m * c.christoffel m k j)
Poincare.D12.ConnectionCurvature.ChartMetricCoefficients.metricDerivative_christoffel'.{w} {ι : Type w} [Fintype ι]
  [DecidableEq ι] (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (k l j : ι) :
  c.d k l j = ∑ i, c.g i j * c.christoffel i k l + ∑ i, c.g l i * c.christoffel i k j
Poincare.D12.ConnectionCurvature.chartAbstractConnection.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) :
