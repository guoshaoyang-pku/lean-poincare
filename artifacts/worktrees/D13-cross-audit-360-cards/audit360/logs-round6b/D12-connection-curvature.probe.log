  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X Y Z : ι → ℝ) :
  ((Poincare.D12.ConnectionCurvature.formOf c) (((Poincare.D12.ConnectionCurvature.nablaOf c) X) Y)) Z +
      ((Poincare.D12.ConnectionCurvature.formOf c) Y) (((Poincare.D12.ConnectionCurvature.nablaOf c) X) Z) =
    Poincare.D12.ConnectionCurvature.dFormOf c X Y Z
Poincare.D12.ConnectionCurvature.chartTorsionFree_form.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X Y : ι → ℝ) :
  ((Poincare.D12.ConnectionCurvature.nablaOf c) X) Y - ((Poincare.D12.ConnectionCurvature.nablaOf c) Y) X = 0
Poincare.D12.ConnectionCurvature.dFormOf.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X Y Z : ι → ℝ) : ℝ
Poincare.D12.ConnectionCurvature.formOf.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) : (ι → ℝ) →ₗ[ℝ] (ι → ℝ) →ₗ[ℝ] ℝ
Poincare.D12.ConnectionCurvature.formOf_apply.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X Y : ι → ℝ) :
  ((Poincare.D12.ConnectionCurvature.formOf c) X) Y = ∑ i, ∑ j, c.g i j * X i * Y j
Poincare.D12.ConnectionCurvature.form_nabla_eq_sum.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X Y Z : ι → ℝ) :
  ((Poincare.D12.ConnectionCurvature.formOf c) (((Poincare.D12.ConnectionCurvature.nablaOf c) X) Y)) Z =
    ∑ k, ∑ l, ∑ j, c.christoffelLower j k l * (X k * Y l * Z j)
Poincare.D12.ConnectionCurvature.form_nabla_second_eq_sum.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X Y Z : ι → ℝ) :
  ((Poincare.D12.ConnectionCurvature.formOf c) Y) (((Poincare.D12.ConnectionCurvature.nablaOf c) X) Z) =
    ∑ k, ∑ l, ∑ i, c.christoffelLower i k l * (Y i * (X k * Z l))
Poincare.D12.ConnectionCurvature.nablaOf.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) : (ι → ℝ) →ₗ[ℝ] (ι → ℝ) →ₗ[ℝ] ι → ℝ
Poincare.D12.ConnectionCurvature.nablaOf_apply.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X Y : ι → ℝ) (k : ι) :
  ((Poincare.D12.ConnectionCurvature.nablaOf c) X) Y k = ∑ i, ∑ j, c.christoffel k i j * X i * Y j
Poincare.D12.ConnectionCurvature.sum_four_reorder.{u_1, u_2, u_3, u_4} {α : Type u_1} {β : Type u_2} {γ : Type u_3}
  {δ : Type u_4} [Fintype α] [Fintype β] [Fintype γ] [Fintype δ] (f : α → β → γ → δ → ℝ) :
