Poincare.D12.ConnectionCurvature.milnorConnection_apply.{v, w} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] (m : Poincare.Longrun.Geometry.MetricData V ι)
  (b : Poincare.Longrun.Geometry.LieBracketData ℝ V) (X Y : V) :
  ((Poincare.D12.ConnectionCurvature.milnorConnection m b) X) Y =
    (1 / 2) •
      ((b.bracket X) Y - ((Poincare.D12.ConnectionCurvature.adTranspose m b) X) Y -
        ((Poincare.D12.ConnectionCurvature.adTranspose m b) Y) X)
Poincare.D12.ConnectionCurvature.milnorConnection_eq_mean_iff.{v, w} {V : Type v} [AddCommGroup V] [Module ℝ V]
  [FiniteDimensional ℝ V] {ι : Type w} [Fintype ι] [DecidableEq ι] (m : Poincare.Longrun.Geometry.MetricData V ι)
  (b : Poincare.Longrun.Geometry.LieBracketData ℝ V) :
  Poincare.D12.ConnectionCurvature.milnorConnection m b = (Poincare.Longrun.Geometry.meanConnection b).nabla ↔
    Poincare.D12.ConnectionCurvature.bracketInvariant m b
