Poincare.D12.ConnectionCurvature.SmoothChartData.christoffelFamily.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) (x : Poincare.D12.ConnectionCurvature.ChartPoint ι)
  (k i j : ι) : ℝ
Poincare.D12.ConnectionCurvature.SmoothChartData.christoffelFamily_metricDerivative.{w} {ι : Type w} [Fintype ι]
  [DecidableEq ι] (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι)
  (x : Poincare.D12.ConnectionCurvature.ChartPoint ι) (i j k : ι) :
  c.dFamily x k i j = ∑ m, (c.g x m j * c.christoffelFamily x m k i + c.g x i m * c.christoffelFamily x m k j)
Poincare.D12.ConnectionCurvature.SmoothChartData.christoffelFamily_smooth.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) (k i j : ι) :
  ContDiff ℝ ↑⊤ fun x => c.christoffelFamily x k i j
Poincare.D12.ConnectionCurvature.SmoothChartData.christoffelFamily_symm.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) (x : Poincare.D12.ConnectionCurvature.ChartPoint ι)
  (k i j : ι) : c.christoffelFamily x k i j = c.christoffelFamily x k j i
