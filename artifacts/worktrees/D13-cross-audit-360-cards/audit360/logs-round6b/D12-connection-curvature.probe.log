  Poincare.D12.ConnectionCurvature.VectorField ι
Poincare.D12.ConnectionCurvature.SmoothChartData.lieBracket_smooth.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) {X Y : Poincare.D12.ConnectionCurvature.VectorField ι}
  (hX : ContDiff ℝ (↑⊤) X) (hY : ContDiff ℝ (↑⊤) Y) : ContDiff ℝ (↑⊤) (c.lieBracket X Y)
Poincare.D12.ConnectionCurvature.SmoothChartData.nabla.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) (X Y : Poincare.D12.ConnectionCurvature.VectorField ι) :
  Poincare.D12.ConnectionCurvature.VectorField ι
Poincare.D12.ConnectionCurvature.SmoothChartData.nabla_apply.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) (X Y : Poincare.D12.ConnectionCurvature.VectorField ι)
  (x : Poincare.D12.ConnectionCurvature.ChartPoint ι) (k : ι) :
  c.nabla X Y x k = (fderiv ℝ (fun z => Y z k) x) (X x) + ∑ i, ∑ j, c.christoffelFamily x k i j * X x i * Y x j
Poincare.D12.ConnectionCurvature.SmoothChartData.nabla_const_apply.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) (X0 Y0 x : Poincare.D12.ConnectionCurvature.ChartPoint ι)
  (k : ι) :
  c.nabla (fun x => X0) (fun x => Y0) x k = ((Poincare.D12.ConnectionCurvature.nablaOf (c.chartCoefficients x)) X0) Y0 k
Poincare.D12.ConnectionCurvature.SmoothChartData.nabla_metricCompatible.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) (X Y Z : Poincare.D12.ConnectionCurvature.VectorField ι)
  (hY : ContDiff ℝ (↑⊤) Y) (hZ : ContDiff ℝ (↑⊤) Z) (x : Poincare.D12.ConnectionCurvature.ChartPoint ι) :
  (fderiv ℝ (fun z => c.formField z (Y z) (Z z)) x) (X x) =
    c.formField x (c.nabla X Y x) (Z x) + c.formField x (Y x) (c.nabla X Z x)
Poincare.D12.ConnectionCurvature.SmoothChartData.nabla_smooth.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) {X Y : Poincare.D12.ConnectionCurvature.VectorField ι}
  (hX : ContDiff ℝ (↑⊤) X) (hY : ContDiff ℝ (↑⊤) Y) : ContDiff ℝ (↑⊤) (c.nabla X Y)
Poincare.D12.ConnectionCurvature.SmoothChartData.nabla_smul.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) (f : Poincare.D12.ConnectionCurvature.ChartPoint ι → ℝ)
  (hf : ContDiff ℝ 1 f) (X Y : Poincare.D12.ConnectionCurvature.VectorField ι) (hY : ContDiff ℝ 1 Y)
  (x : Poincare.D12.ConnectionCurvature.ChartPoint ι) :
  c.nabla X (f • Y) x = f x • c.nabla X Y x + (fderiv ℝ f x) (X x) • Y x
Poincare.D12.ConnectionCurvature.SmoothChartData.nabla_torsionFree.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι) (X Y : Poincare.D12.ConnectionCurvature.VectorField ι)
  (x : Poincare.D12.ConnectionCurvature.ChartPoint ι) (k : ι) : c.nabla X Y x k - c.nabla Y X x k = c.lieBracket X Y x k
Poincare.D12.ConnectionCurvature.fderiv_apply_eq_sum_single.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (f : Poincare.D12.ConnectionCurvature.ChartPoint ι → ℝ) (x v : Poincare.D12.ConnectionCurvature.ChartPoint ι) :
  (fderiv ℝ f x) v = ∑ k, v k * (fderiv ℝ f x) (Pi.single k 1)
Poincare.D12.ConnectionCurvature.fderiv_mul_mul_apply.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (f g h : Poincare.D12.ConnectionCurvature.ChartPoint ι → ℝ) (x v : Poincare.D12.ConnectionCurvature.ChartPoint ι)
  (hf : DifferentiableAt ℝ f x) (hg : DifferentiableAt ℝ g x) (hh : DifferentiableAt ℝ h x) :
  (fderiv ℝ (fun y => f y * g y * h y) x) v =
    f x * g x * (fderiv ℝ h x) v + f x * h x * (fderiv ℝ g x) v + g x * h x * (fderiv ℝ f x) v
Poincare.D12.ConnectionCurvature.linMap_apply_eq_sum_single.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (L : Poincare.D12.ConnectionCurvature.ChartPoint ι →ₗ[ℝ] ℝ) (v : Poincare.D12.ConnectionCurvature.ChartPoint ι) :
  L v = ∑ k, v k * L (Pi.single k 1)
Poincare.D12.ConnectionCurvature.sum_add_split.{w} {ι : Type w} [Fintype ι] [DecidableEq ι] (f g : ι → ι → ℝ) :
  ∑ i, ∑ j, (f i j + g i j) = ∑ i, ∑ j, f i j + ∑ i, ∑ j, g i j
Poincare.D12.ConnectionCurvature.sum_cycle_first_to_last.{w} {ι : Type w} [Fintype ι] [DecidableEq ι]
  (f : ι → ι → ι → ℝ) : ∑ k, ∑ i, ∑ j, f k i j = ∑ i, ∑ j, ∑ k, f k i j
Poincare.D12.ConnectionCurvature.sum_three_cycle.{w} {ι : Type w} [Fintype ι] [DecidableEq ι] (f : ι → ι → ι → ℝ) :
