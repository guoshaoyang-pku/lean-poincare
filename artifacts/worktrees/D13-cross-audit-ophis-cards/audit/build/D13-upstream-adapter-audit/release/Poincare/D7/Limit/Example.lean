import Poincare.D7.Limit.Blocked

/-!
# Poincare.D7.Limit.Example

**D7 discrete-to-continuous limit, part 7: a non-vacuous consistency
certificate and negative controls.**

The continuous solution `u x t = -x² - 2t` on `[-1,1] × [0,T]` is a genuine
non-steady heat solution (`u_t = -2 = u_xx`).  On the uniform mesh
`x i = -1 + i h`, `(N+1) h = 2`, and the time mesh `t n = n Δt`, the
forward-Euler/centered-difference scheme reproduces it **exactly** whenever
`α h² = Δt`: the centered second difference of a quadratic is exactly `-2h²`
and the forward time step of a linear-in-time function is exactly `-2Δt`.
Hence the consistency certificate is inhabited with `ε₀ = τ = 0`, the local
truncation error vanishes identically, and the global error bound
`error_le_of_certificate` gives error `0` at every node.  This shows that the
error-recursion bound is attained, not vacuous.

Two negative controls show that the hypotheses are essential:

* `quad_truncation_abs_pos` — if `α = 0` while `Δt > 0` (so `α h² ≠ Δt`), the
  local truncation error is exactly `-2Δt ≠ 0`, so no certificate with `τ = 0`
  exists;
* `cfl_essential` — with `α = 1` (violating `α ≤ 1/2`) the stability bound of
  `perturbed_recursion_stable` fails for an explicit signed recursion.

All proofs are complete: no `sorry`, `axiom`, `unsafe`, `native_decide`, or
`proof_wanted`.
-/

open Filter Set
open Poincare.Longrun.PDE
open scoped BigOperators Topology

namespace Poincare.D7.Limit

/-! ## The quadratic heat solution -/

/-- The non-steady heat solution `u x t = -x² - 2t` on `[-1,1]`. -/
def quadSolution (x t : ℝ) : ℝ := -x ^ 2 - 2 * t

/-- The quadratic solution satisfies the D2 continuous heat interface. -/
theorem quadSolution_continuousHeatHypotheses (T : ℝ) :
    ContinuousHeatHypotheses quadSolution (-1) 1 T :=
  continuousHeatHypotheses_quadratic T

/-! ## The uniform mesh and the time mesh -/

/-- The uniform mesh on `[-1,1]` with `N+1` cells and step `h`. -/
def quadMesh (N : ℕ) (h : ℝ) (hh : 0 < h) (hN : ((N + 1 : ℕ) : ℝ) * h = 2) :
    GridMesh (-1) 1 N :=
  GridMesh.uniform (-1) 1 h N hh (by
    have hN' := hN
    push_cast at hN'
    norm_num
    exact hN')

@[simp]
theorem quadMesh_x (N : ℕ) (h : ℝ) (hh : 0 < h) (hN : ((N + 1 : ℕ) : ℝ) * h = 2)
    (i : ℕ) : (quadMesh N h hh hN).x i = -1 + (i : ℝ) * h :=
  GridMesh.uniform_x (-1) 1 h N hh _ i

/-- The uniform time mesh `t n = n Δt`. -/
def quadTime (Δt : ℝ) : TimeMesh Δt where
  time n := (n : ℝ) * Δt
  time_zero := by simp
  time_step n := by push_cast; ring

@[simp]
theorem quadTime_time (Δt : ℝ) (n : ℕ) : (quadTime Δt).time n = (n : ℝ) * Δt := rfl

/-! ## Exact consistency of the quadratic solution -/

/-- **The scheme is exact on the quadratic solution.**  If `α h² = Δt`, the
forward-Euler/centered-difference step maps the sampled quadratic solution to
the sampled quadratic solution at the next time step. -/
theorem quad_step {N : ℕ} {h Δt α : ℝ} (hh : 0 < h)
    (hN : ((N + 1 : ℕ) : ℝ) * h = 2) (hα : α * h ^ 2 = Δt) (n i : ℕ) (hi0 : 0 < i) :
    quadSolution ((quadMesh N h hh hN).x i) ((quadTime Δt).time (n + 1))
      = heatStep α (fun j => quadSolution ((quadMesh N h hh hN).x j) ((quadTime Δt).time n)) i := by
  have hx_pred : (quadMesh N h hh hN).x (i - 1) = (quadMesh N h hh hN).x i - h := by
    rw [quadMesh_x, quadMesh_x, Nat.cast_sub (by omega : 1 ≤ i)]
    ring
  have hx_succ : (quadMesh N h hh hN).x (i + 1) = (quadMesh N h hh hN).x i + h := by
    rw [quadMesh_x, quadMesh_x]
    push_cast
    ring
  simp only [quadSolution, heatStep]
  rw [hx_pred, hx_succ, (quadTime Δt).time_step n]
  nlinarith [hα]

/-- The discrete slab generated by the quadratic solution. -/
def quadSlab (N : ℕ) (h Δt α : ℝ) (hh : 0 < h)
    (hN : ((N + 1 : ℕ) : ℝ) * h = 2) (hα : α * h ^ 2 = Δt) : SlabGrid N α where
  v n i := quadSolution ((quadMesh N h hh hN).x i) ((quadTime Δt).time n)
  step := fun t i hi0 _ => quad_step hh hN hα t i hi0

@[simp]
theorem quadSlab_v (N : ℕ) (h Δt α : ℝ) (hh : 0 < h)
    (hN : ((N + 1 : ℕ) : ℝ) * h = 2) (hα : α * h ^ 2 = Δt) (n i : ℕ) :
    (quadSlab N h Δt α hh hN hα).v n i
      = quadSolution ((quadMesh N h hh hN).x i) ((quadTime Δt).time n) := rfl

/-! ## The inhabited consistency certificate -/

/-- **The quadratic consistency certificate.**  The continuous quadratic
solution, the uniform mesh, the exact scheme and the zero initial/truncation
error bounds form a consistency certificate.  This certifies that the
certificate structure is inhabited by a genuine non-steady heat solution. -/
def quadCertificate (N : ℕ) (h Δt α T : ℝ) (hh : 0 < h)
    (hN : ((N + 1 : ℕ) : ℝ) * h = 2) (hΔt : 0 < Δt) (hα0 : 0 ≤ α) (hα1 : α ≤ 1 / 2)
    (hα : α * h ^ 2 = Δt) : ConsistencyCertificate quadSolution (-1) 1 T N α where
  mesh := quadMesh N h hh hN
  h := h
  h_pos := hh
  Δt := Δt
  Δt_pos := hΔt
  timeMesh := quadTime Δt
  alpha_eq := by
    rw [eq_div_iff (by positivity : h ^ 2 ≠ 0)]
    exact hα
  cfl_nonneg := hα0
  cfl_le_half := hα1
  grid := quadSlab N h Δt α hh hN hα
  boundary_left := by
    intro n
    show quadSolution ((quadMesh N h hh hN).x 0) ((quadTime Δt).time n) = quadSolution (-1) _
    rw [(quadMesh N h hh hN).x_zero]
  boundary_right := by
    intro n
    show quadSolution ((quadMesh N h hh hN).x (N + 1)) ((quadTime Δt).time n) = quadSolution 1 _
    rw [(quadMesh N h hh hN).x_last]
  ε₀ := 0
  ε₀_nonneg := le_rfl
  initial_error := by
    intro i _
    simp
  τ := fun _ => 0
  τ_nonneg := fun _ => le_rfl
  truncation := by
    intro n i hi0 hiN
    rw [quad_step hh hN hα n i hi0]
    simp
  continuous := quadSolution_continuousHeatHypotheses T

/-- **Exactness of the discrete quadratic slab.**  The consistency certificate
with `ε₀ = τ = 0` makes the error-recursion bound exact: the discrete values
equal the sampled continuous solution at every node and time. -/
theorem quad_error_zero (N : ℕ) (h Δt α T : ℝ) (hh : 0 < h)
    (hN : ((N + 1 : ℕ) : ℝ) * h = 2) (hΔt : 0 < Δt) (hα0 : 0 ≤ α) (hα1 : α ≤ 1 / 2)
    (hα : α * h ^ 2 = Δt) (n : ℕ) {i : ℕ} (hi : i ≤ N + 1) :
    quadSolution ((quadMesh N h hh hN).x i) ((quadTime Δt).time n)
      = (quadSlab N h Δt α hh hN hα).v n i := by
  have herr := ConsistencyCertificate.error_eq_zero_of_exact
    (quadCertificate N h Δt α T hh hN hΔt hα0 hα1 hα) rfl (fun _ => rfl) n hi
  have herr' : |quadSolution ((quadMesh N h hh hN).x i) ((quadTime Δt).time n)
      - (quadSlab N h Δt α hh hN hα).v n i| = 0 := herr
  exact sub_eq_zero.mp (abs_eq_zero.mp herr')

/-! ## Negative controls -/

/-- **Inconsistency when `α h² ≠ Δt`.**  With `α = 0` the scheme keeps the
value unchanged, while the quadratic solution drops by `2Δt` per step: the
local truncation error is exactly `-2Δt`, independent of the node. -/
theorem quad_truncation_eq_of_alpha_zero {N : ℕ} {h Δt : ℝ} (hh : 0 < h)
    (hN : ((N + 1 : ℕ) : ℝ) * h = 2) (n i : ℕ) :
    quadSolution ((quadMesh N h hh hN).x i) ((quadTime Δt).time (n + 1))
        - heatStep 0 (fun j => quadSolution ((quadMesh N h hh hN).x j) ((quadTime Δt).time n)) i
      = -2 * Δt := by
  rw [(quadTime Δt).time_step n]
  simp only [quadSolution, heatStep]
  ring

/-- The absolute local truncation error at `α = 0` is exactly `2Δt > 0`, so no
consistency certificate with `τ = 0` can exist for the wrong CFL ratio. -/
theorem quad_truncation_abs_pos {N : ℕ} {h Δt : ℝ} (hh : 0 < h)
    (hN : ((N + 1 : ℕ) : ℝ) * h = 2) (hΔt : 0 < Δt) (n i : ℕ) :
    |quadSolution ((quadMesh N h hh hN).x i) ((quadTime Δt).time (n + 1))
        - heatStep 0 (fun j => quadSolution ((quadMesh N h hh hN).x j) ((quadTime Δt).time n)) i|
      = 2 * Δt := by
  rw [quad_truncation_eq_of_alpha_zero hh hN n i, abs_of_neg (by linarith)]
  ring

/-- **The CFL condition is essential.**  With `α = 1` (violating `α ≤ 1/2`) the
stability bound of `perturbed_recursion_stable` fails: the signed recursion
`e n 1 = (-1)^(n+1)` satisfies the perturbed inequality at the only interior
node of a two-cell grid, but the bound `max 0 (sup e 0) + Σ τ` is violated at
`n = 1`.  The failure is caused by `1 - 2α = -1 < 0`, which breaks the
convex-combination argument. -/
theorem cfl_essential :
    ∃ e : ℕ → ℕ → ℝ,
      (∀ n i, 0 < i → i < 2 →
        e (n + 1) i ≤ 1 * e n (i - 1) + (1 - 2 * 1) * e n i + 1 * e n (i + 1) + 0) ∧
      ¬ (∀ n i, i ≤ 2 →
        e n i ≤ max 0 (Finset.sup' (Finset.range 4) ⟨0, by norm_num⟩ (fun j => e 0 j))
          + ∑ k ∈ Finset.range n, (0 : ℝ)) := by
  refine ⟨fun n i => match i with
    | 1 => (-1 : ℝ) ^ (n + 1)
    | _ => 0, ?_, ?_⟩
  · intro n i hi0 hiN
    interval_cases i
    have hpow : (-1 : ℝ) ^ (n + 1 + 1) = -((-1) ^ (n + 1)) := by
      rw [pow_succ]
      ring
    simp only [hpow, one_mul, mul_zero]
    ring_nf
    linarith
  · intro h
    have h1 := h 1 1 (by norm_num)
    have hval : (fun n i => match i with
      | 1 => (-1 : ℝ) ^ (n + 1)
      | _ => 0) 1 1 = 1 := by norm_num
    rw [hval] at h1
    have hsup_le : Finset.sup' (Finset.range 4) ⟨0, by norm_num⟩
        (fun j => match j with | 1 => (-1 : ℝ) ^ (0 + 1) | _ => 0) ≤ 0 := by
      refine Finset.sup'_le _ _ (fun j hj => ?_)
      have hj' : j < 4 := Finset.mem_range.mp hj
      interval_cases j <;> norm_num
    have hsup_ge : 0 ≤ Finset.sup' (Finset.range 4) ⟨0, by norm_num⟩
        (fun j => match j with | 1 => (-1 : ℝ) ^ (0 + 1) | _ => 0) :=
      Finset.le_sup' (fun j => match j with | 1 => (-1 : ℝ) ^ (0 + 1) | _ => 0)
        (Finset.mem_range.mpr (by norm_num : 0 < 4))
    have hsup : Finset.sup' (Finset.range 4) ⟨0, by norm_num⟩
        (fun j => match j with | 1 => (-1 : ℝ) ^ (0 + 1) | _ => 0) = 0 :=
      le_antisymm hsup_le hsup_ge
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add] at h1
    rw [hsup] at h1
    have h1' : (1 : ℝ) ≤ 0 := by simpa using h1
    norm_num at h1'

end Poincare.D7.Limit
