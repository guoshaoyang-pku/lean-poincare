  [ChartedSpace H M] [IsManifold I 2 M] [RiemannianBundle fun x => TangentSpace I x] {Y : (x : M) → TangentSpace I x}
  {cov cov' : CovariantDerivative I E (TangentSpace I)} [IsContMDiffRiemannianBundle I 1 E fun x => TangentSpace I x]
  {x : M} [FiniteDimensional ℝ E] (hcov : CovariantDerivative.IsLeviCivitaConnection I cov)
  (hcov' : CovariantDerivative.IsLeviCivitaConnection I cov') (hY : MDiffAt (T% Y) x) (X₀ : TangentSpace I x) :
  (↑cov Y x) X₀ = (↑cov' Y x) X₀
