Poincare.D7.Bochner.BochnerCertificate : Type
Poincare.D7.Bochner.BochnerCertificate.bochner (self : BochnerCertificate) :
  self.oneFormLaplacian = self.roughLaplacian + self.ricciContraction
Poincare.D7.Bochner.BochnerCertificate.oneFormLaplacian_eq_roughLaplacian_of_ricci_zero (C : BochnerCertificate)
  (h : C.ricciContraction = 0) : C.oneFormLaplacian = C.roughLaplacian
Poincare.D7.Bochner.GradientCertificate : Type
Poincare.D7.Bochner.GradientCertificate.gradient_estimate (C : GradientCertificate) :
  2 * hessNormSq C.B.hess ≤ C.laplacianGradNormSq
Poincare.D7.Bochner.GradientCertificate.bochner_inequality (C : GradientCertificate) :
  2 * hessNormSq C.B.hess ≤ C.laplacianGradNormSq - 2 * gradLaplacianDot C.B.grad C.gradLap
Poincare.D7.Bochner.GradientCertificate.gradient_estimate_eq_iff_ricci_zero (C : GradientCertificate) :
  C.laplacianGradNormSq = 2 * hessNormSq C.B.hess ↔ C.B.ricciContraction = 0
