Poincare.D7.Canonical.CanonicalNeighborhoodHypotheses.{u} (X : PointedMetricSpace) : Type
Poincare.D7.Canonical.missingPerelmanCanonicalNeighborhood.{u} (X : PointedMetricSpace)
  (H : CanonicalNeighborhoodHypotheses X) (ε : ℝ) : Prop
Poincare.D7.Canonical.missingPerelmanCanonicalNeighborhood_iff.{u} (X : PointedMetricSpace)
  (H : CanonicalNeighborhoodHypotheses X) (ε : ℝ) :
  missingPerelmanCanonicalNeighborhood X H ε ↔
    0 < ε →
      H.curvatureLowerBound →
        H.scalarCurvatureLarge →
          H.noncollapsed →
            ∃ r, 0 < r ∧ r ≤ H.curvatureRadius ∧ ∃ curvature, Nonempty (CanonicalNeighborhoodCertificate ε H.kappa r X)
Poincare.D7.Canonical.certificate_of_missingPerelmanCanonicalNeighborhood.{u} {X : PointedMetricSpace}
  {H : CanonicalNeighborhoodHypotheses X} {ε : ℝ} (h : missingPerelmanCanonicalNeighborhood X H ε) (hε : 0 < ε)
  (hcurv : H.curvatureLowerBound) (hscalar : H.scalarCurvatureLarge) (hnc : H.noncollapsed) :
  ∃ r, 0 < r ∧ r ≤ H.curvatureRadius ∧ ∃ curvature, Nonempty (CanonicalNeighborhoodCertificate ε H.kappa r X)
Poincare.D7.Canonical.exists_admissible_scale_of_missingPerelmanCanonicalNeighborhood.{u} {X : PointedMetricSpace}
  {H : CanonicalNeighborhoodHypotheses X} {ε : ℝ} (h : missingPerelmanCanonicalNeighborhood X H ε) (hε : 0 < ε)
  (hcurv : H.curvatureLowerBound) (hscalar : H.scalarCurvatureLarge) (hnc : H.noncollapsed) :
  ∃ r, 0 < r ∧ r ≤ H.curvatureRadius
Poincare.D7.Canonical.exists_scale_below_curvatureRadius.{u} {X : PointedMetricSpace}
  (H : CanonicalNeighborhoodHypotheses X) : ∃ r, 0 < r ∧ r ≤ H.curvatureRadius
Poincare.D7.Canonical.missingPerelmanCanonicalNeighborhood_of_certificate.{u} {X : PointedMetricSpace}
  {H : CanonicalNeighborhoodHypotheses X} {ε : ℝ}
  (hcert :
    ∀ (r : ℝ), 0 < r → r ≤ H.curvatureRadius → ∃ curvature, Nonempty (CanonicalNeighborhoodCertificate ε H.kappa r X)) :
  missingPerelmanCanonicalNeighborhood X H ε
