PointedMetricSpace : Type (u_1 + 1)
@GHConvergenceData : {ι : Type u_1} →
  Filter ι → (ι → PointedMetricSpace) → PointedMetricSpace → Type (max (max u_2 u_3) u_1)
@GHPrecompactCertificate : {ι : Type u_1} → (ι → PointedMetricSpace) → Type (max u_2 u_1)
RiemannCurvatureData : (V : Type u_1) →
  [inst : AddCommGroup V] →
    [inst_1 : Module ℝ V] →
      [FiniteDimensional ℝ V] → (ι : Type u_2) → [Fintype ι] → [DecidableEq ι] → Type (max u_1 u_2)
@RiemannCurvatureData.sectionalCurvature : {V : Type u_1} →
  [inst : AddCommGroup V] →
    [inst_1 : Module ℝ V] →
      [inst_2 : FiniteDimensional ℝ V] →
        {ι : Type u_2} → [inst_3 : Fintype ι] → [inst_4 : DecidableEq ι] → RiemannCurvatureData V ι → V → V → ℝ
@RiemannCurvatureData.IsNondegenerate2Plane : {V : Type u_1} →
  [inst : AddCommGroup V] →
    [inst_1 : Module ℝ V] →
      [inst_2 : FiniteDimensional ℝ V] →
        {ι : Type u_2} → [inst_3 : Fintype ι] → [inst_4 : DecidableEq ι] → RiemannCurvatureData V ι → V → V → Prop
