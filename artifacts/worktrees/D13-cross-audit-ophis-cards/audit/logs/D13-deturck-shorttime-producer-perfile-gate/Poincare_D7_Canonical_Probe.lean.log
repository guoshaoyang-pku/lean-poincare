  {X : ι → PointedMetricSpace} {Y : PointedMetricSpace} (D : GHConvergenceData l X Y) (i : ι) :
  EpsilonApproximation (D.ε i) (X i) Y
Poincare.D7.Canonical.EpsilonApproximation.toGHConvergenceData.{u} {X : ℕ → PointedMetricSpace} {Y : PointedMetricSpace}
  (ε : ℕ → ℝ) (hε : ∀ (n : ℕ), 0 ≤ ε n) (h0 : Filter.Tendsto ε Filter.atTop (nhds 0))
