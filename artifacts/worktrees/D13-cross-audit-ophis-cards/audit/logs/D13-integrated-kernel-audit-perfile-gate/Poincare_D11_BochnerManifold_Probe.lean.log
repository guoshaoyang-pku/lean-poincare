  {f : X → Y} {x : X} {t : Set Y} (h : ContinuousAt f x) (ht : t ∈ nhds (f x)) : f ⁻¹' t ∈ nhds x
deriv_neg.{u} {𝕜 : Type u} [NontriviallyNormedField 𝕜] (x : 𝕜) : deriv Neg.neg x = -1
