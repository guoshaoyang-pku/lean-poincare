  {f : 𝕜 → F} {f' : F} {x : 𝕜} (h : HasDerivAt f f' x) : HasDerivAt (-f) (-f') x
Poincare.D10.BochnerEuclidean.bochner_identity {n : ℕ} {u : Poincare.D10.BochnerEuclidean.E n → ℝ} (hu : ContDiff ℝ 3 u)
  (x : Poincare.D10.BochnerEuclidean.E n) :
  Poincare.D10.BochnerEuclidean.lap (fun y => ‖Poincare.D10.BochnerEuclidean.grad u y‖ ^ 2) x =
    2 * Poincare.D10.BochnerEuclidean.hessNormSq u x +
      2 *
        inner ℝ (Poincare.D10.BochnerEuclidean.grad u x)
          (Poincare.D10.BochnerEuclidean.grad (Poincare.D10.BochnerEuclidean.lap u) x)
Poincare.D10.BochnerEuclidean.bochner_identity_components {n : ℕ} {u : Poincare.D10.BochnerEuclidean.E n → ℝ}
  (hu : ContDiff ℝ 3 u) (x : Poincare.D10.BochnerEuclidean.E n) :
  Poincare.D10.BochnerEuclidean.lap (Poincare.D10.BochnerEuclidean.gradNormSq u) x =
    2 * Poincare.D10.BochnerEuclidean.hessNormSq u x + 2 * Poincare.D10.BochnerEuclidean.gradLapDot u x
Poincare.D10.BochnerEuclidean.harmonic_energy_density_subharmonic {n : ℕ} {u : Poincare.D10.BochnerEuclidean.E n → ℝ}
  (hu : ContDiff ℝ 3 u) (hh : Poincare.D10.BochnerEuclidean.Harmonic u) (x : Poincare.D10.BochnerEuclidean.E n) :
  Poincare.D10.BochnerEuclidean.lap (fun y => ‖Poincare.D10.BochnerEuclidean.grad u y‖ ^ 2) x =
      2 * Poincare.D10.BochnerEuclidean.hessNormSq u x ∧
    0 ≤ Poincare.D10.BochnerEuclidean.lap (fun y => ‖Poincare.D10.BochnerEuclidean.grad u y‖ ^ 2) x
Poincare.D10.BochnerEuclidean.harmonic_lap_gradNormSq {n : ℕ} {u : Poincare.D10.BochnerEuclidean.E n → ℝ}
  (hu : ContDiff ℝ 3 u) (hh : Poincare.D10.BochnerEuclidean.Harmonic u) (x : Poincare.D10.BochnerEuclidean.E n) :
  Poincare.D10.BochnerEuclidean.lap (fun y => ‖Poincare.D10.BochnerEuclidean.grad u y‖ ^ 2) x =
    2 * Poincare.D10.BochnerEuclidean.hessNormSq u x
Poincare.D10.BochnerEuclidean.hessNormSq_nonneg {n : ℕ} (u : Poincare.D10.BochnerEuclidean.E n → ℝ)
  (x : Poincare.D10.BochnerEuclidean.E n) : 0 ≤ Poincare.D10.BochnerEuclidean.hessNormSq u x
Poincare.D10.jacobiSol (K t : ℝ) : ℝ
Poincare.D10.jacobiDeriv (K t : ℝ) : ℝ
Poincare.D10.jacobiSol_ode (K t : ℝ) : deriv (deriv (Poincare.D10.jacobiSol K)) t + K * Poincare.D10.jacobiSol K t = 0
Poincare.D10.jacobiSol_deriv (K t : ℝ) : deriv (Poincare.D10.jacobiSol K) t = Poincare.D10.jacobiDeriv K t
Poincare.D10.hasDerivAt_jacobiSol (K t : ℝ) : HasDerivAt (Poincare.D10.jacobiSol K) (Poincare.D10.jacobiDeriv K t) t
Poincare.D10.hasDerivAt_jacobiDeriv (K t : ℝ) :
  HasDerivAt (Poincare.D10.jacobiDeriv K) (-(K * Poincare.D10.jacobiSol K t)) t
Poincare.D7.Bochner.BochnerCertificate : Type
Poincare.D7.Bochner.GradientCertificate : Type
Poincare.D7.Bochner.hessNormSq.{u_1} {ι : Type u_1} [Fintype ι] (hess : Matrix ι ι ℝ) : ℝ
Poincare.D7.Bochner.gradLaplacianDot.{u_1} {ι : Type u_1} [Fintype ι] (grad gradLap : ι → ℝ) : ℝ
Poincare.D7.Bochner.ricciPairing.{u_1} {ι : Type u_1} [Fintype ι] (ric : Matrix ι ι ℝ) (grad : ι → ℝ) : ℝ
Poincare.D7.Bochner.gradientCertificateOfData (dim : ℕ) (grad gradLap : Fin dim → ℝ)
  (hess ric : Matrix (Fin dim) (Fin dim) ℝ) (hric : 0 ≤ Poincare.D7.Bochner.ricciPairing ric grad)
  (hharmonic : Poincare.D7.Bochner.gradLaplacianDot grad gradLap = 0) : Poincare.D7.Bochner.GradientCertificate
Poincare.D7.Bochner.GradientCertificate.gradient_estimate (C : Poincare.D7.Bochner.GradientCertificate) :
  2 * Poincare.D7.Bochner.hessNormSq C.B.hess ≤ C.laplacianGradNormSq
Poincare.D7.Bochner.GradientCertificate.bochner_inequality (C : Poincare.D7.Bochner.GradientCertificate) :
  2 * Poincare.D7.Bochner.hessNormSq C.B.hess ≤
    C.laplacianGradNormSq - 2 * Poincare.D7.Bochner.gradLaplacianDot C.B.grad C.gradLap
Poincare.D7.Bochner.BochnerCertificate.roughLaplacian_le_oneFormLaplacian (C : Poincare.D7.Bochner.BochnerCertificate) :
  C.roughLaplacian ≤ C.oneFormLaplacian
