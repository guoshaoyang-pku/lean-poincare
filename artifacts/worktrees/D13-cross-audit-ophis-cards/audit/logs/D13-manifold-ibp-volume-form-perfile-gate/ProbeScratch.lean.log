  (f' : Fin (n + 1) → (Fin (n + 1) → ℝ) → (Fin (n + 1) → ℝ) →L[ℝ] E) (s : Set (Fin (n + 1) → ℝ)) (hs : s.Countable)
  (Hc : ∀ (i : Fin (n + 1)), ContinuousOn (f i) (Set.Icc a b))
  (Hd : ∀ x ∈ (Set.univ.pi fun i => Set.Ioo (a i) (b i)) \ s, ∀ (i : Fin (n + 1)), HasFDerivAt (f i) (f' i x) x)
  (Hi : IntegrableOn (fun x => ∑ i, (f' i x) (Pi.single i 1)) (Set.Icc a b) volume) :
  ∫ (x : Fin (n + 1) → ℝ) in Set.Icc a b, ∑ i, (f' i x) (Pi.single i 1) =
    ∑ i,
      ((∫ (x : Fin n → ℝ) in Set.Icc (a ∘ i.succAbove) (b ∘ i.succAbove), f i (i.insertNth (b i) x)) -
        ∫ (x : Fin n → ℝ) in Set.Icc (a ∘ i.succAbove) (b ∘ i.succAbove), f i (i.insertNth (a i) x))
