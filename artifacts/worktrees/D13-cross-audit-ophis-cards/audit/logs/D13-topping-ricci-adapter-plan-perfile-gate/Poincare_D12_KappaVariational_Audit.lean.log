  (q : EuclideanSpace ℝ (Fin n)) : Poincare.D12.KappaVariational.gaussianReducedVolumeDensity n τ q ≠ 0
Poincare.D12.KappaVariational.gaussianReducedVolumeDensity_two_half_zero :
