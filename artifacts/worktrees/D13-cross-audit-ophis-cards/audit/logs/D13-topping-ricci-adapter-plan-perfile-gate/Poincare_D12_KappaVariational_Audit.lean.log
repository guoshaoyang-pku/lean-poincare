  Poincare.D7.Reduced.MetricFlowInterface (EuclideanSpace ℝ (Fin n))
Poincare.D12.KappaVariational.constantCurvatureFlow_scalarCurvature (n : ℕ) (R0 τ : ℝ) (x : EuclideanSpace ℝ (Fin n)) :
  (Poincare.D12.KappaVariational.constantCurvatureFlow n R0).scalarCurvature τ x = R0
Poincare.D12.KappaVariational.constantCurvatureFlow_metric (n : ℕ) (R0 τ : ℝ) (x y : EuclideanSpace ℝ (Fin n)) :
  (Poincare.D12.KappaVariational.constantCurvatureFlow n R0).metric τ x y = inner ℝ x y
Poincare.D12.KappaVariational.intervalIntegrable_sqrt (τ : ℝ) :
  IntervalIntegrable (fun σ => √σ) MeasureTheory.volume 0 τ
Poincare.D12.KappaVariational.integral_sqrt (τ : ℝ) : ∫ (σ : ℝ) in 0..τ, √σ = 2 / 3 * τ ^ (3 / 2)
Poincare.D12.KappaVariational.toGaussianPath {n : ℕ} (R0 : ℝ) (q : EuclideanSpace ℝ (Fin n)) {τ : ℝ}
