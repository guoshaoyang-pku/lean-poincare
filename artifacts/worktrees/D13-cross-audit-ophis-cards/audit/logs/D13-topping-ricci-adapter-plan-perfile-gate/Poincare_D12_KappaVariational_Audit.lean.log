Poincare.D12.KappaVariational.gaussianVecTau (n : ℕ) (τ : ℝ) (x : Fin n → ℝ) : ℝ
Poincare.D12.KappaVariational.gaussianVecTauNormalized (n : ℕ) (τ : ℝ) (x : Fin n → ℝ) : ℝ
Poincare.D12.KappaVariational.gaussianVecTau_def (n : ℕ) (τ : ℝ) (x : Fin n → ℝ) :
  Poincare.D12.KappaVariational.gaussianVecTau n τ x = ∏ i, Poincare.GaussianToolbox.gaussianKernel (1 / (4 * τ)) (x i)
Poincare.D12.KappaVariational.gaussianVecTauNormalized_def (n : ℕ) (τ : ℝ) (x : Fin n → ℝ) :
  Poincare.D12.KappaVariational.gaussianVecTauNormalized n τ x =
    (4 * Real.pi * τ) ^ (-↑n / 2) * Poincare.D12.KappaVariational.gaussianVecTau n τ x
Poincare.D12.KappaVariational.integral_gaussianKernel_tau {τ : ℝ} (hτ : 0 < τ) :
  ∫ (t : ℝ), Poincare.GaussianToolbox.gaussianKernel (1 / (4 * τ)) t = √(4 * Real.pi * τ)
Poincare.D12.KappaVariational.gaussianKernel_tau_eq (τ t : ℝ) :
  Poincare.GaussianToolbox.gaussianKernel (1 / (4 * τ)) t = Real.exp (-(t ^ 2 / (4 * τ)))
Poincare.D12.KappaVariational.integral_gaussianVecTau_fubini (n : ℕ) (τ : ℝ) :
  ∫ (x : Fin n → ℝ), Poincare.D12.KappaVariational.gaussianVecTau n τ x =
    ∏ _i, ∫ (t : ℝ), Poincare.GaussianToolbox.gaussianKernel (1 / (4 * τ)) t
Poincare.D12.KappaVariational.integral_gaussianVecTau (n : ℕ) {τ : ℝ} (hτ : 0 < τ) :
  ∫ (x : Fin n → ℝ), Poincare.D12.KappaVariational.gaussianVecTau n τ x = √(4 * Real.pi * τ) ^ n
Poincare.D12.KappaVariational.integral_gaussianVecTau_eq_rpow (n : ℕ) {τ : ℝ} (hτ : 0 < τ) :
  ∫ (x : Fin n → ℝ), Poincare.D12.KappaVariational.gaussianVecTau n τ x = (4 * Real.pi * τ) ^ (↑n / 2)
Poincare.D12.KappaVariational.integral_gaussianVecTauNormalized (n : ℕ) {τ : ℝ} (hτ : 0 < τ) :
  ∫ (x : Fin n → ℝ), Poincare.D12.KappaVariational.gaussianVecTauNormalized n τ x = 1
Poincare.D12.KappaVariational.gaussianVecTau_eq_exp_neg_sum_sq (n : ℕ) (τ : ℝ) (x : Fin n → ℝ) :
  Poincare.D12.KappaVariational.gaussianVecTau n τ x = Real.exp ((-∑ i, x i ^ 2) / (4 * τ))
Poincare.D12.KappaVariational.gaussianVecTau_eq_exp_neg_normSq_div (n : ℕ) (τ : ℝ) (x : EuclideanSpace ℝ (Fin n)) :
  ∏ i, Poincare.GaussianToolbox.gaussianKernel (1 / (4 * τ)) (x.ofLp i) = Real.exp (-‖x‖ ^ 2 / (4 * τ))
Poincare.D12.KappaVariational.integral_exp_neg_normSq_div (n : ℕ) {τ : ℝ} (hτ : 0 < τ) :
  ∫ (x : EuclideanSpace ℝ (Fin n)), Real.exp (-‖x‖ ^ 2 / (4 * τ)) = (4 * Real.pi * τ) ^ (↑n / 2)
Poincare.D12.KappaVariational.gaussianReducedVolumeDensity (n : ℕ) (τ : ℝ) (q : EuclideanSpace ℝ (Fin n)) : ℝ
Poincare.D12.KappaVariational.gaussianReducedVolume (n : ℕ) (τ : ℝ) : ℝ
Poincare.D12.KappaVariational.gaussianReducedVolumeDensity_def (n : ℕ) (τ : ℝ) (q : EuclideanSpace ℝ (Fin n)) :
  Poincare.D12.KappaVariational.gaussianReducedVolumeDensity n τ q =
    (4 * Real.pi * τ) ^ (-↑n / 2) * Real.exp (-‖q‖ ^ 2 / (4 * τ))
Poincare.D12.KappaVariational.gaussianReducedVolume_def (n : ℕ) (τ : ℝ) :
  Poincare.D12.KappaVariational.gaussianReducedVolume n τ =
    ∫ (q : EuclideanSpace ℝ (Fin n)), Poincare.D12.KappaVariational.gaussianReducedVolumeDensity n τ q
Poincare.D12.KappaVariational.integral_gaussianReducedVolumeDensity (n : ℕ) {τ : ℝ} (hτ : 0 < τ) :
  ∫ (q : EuclideanSpace ℝ (Fin n)), Poincare.D12.KappaVariational.gaussianReducedVolumeDensity n τ q = 1
Poincare.D12.KappaVariational.gaussianReducedVolume_eq_one (n : ℕ) {τ : ℝ} (hτ : 0 < τ) :
  Poincare.D12.KappaVariational.gaussianReducedVolume n τ = 1
Poincare.D12.KappaVariational.gaussianReducedVolumeViaL (n : ℕ) (τ : ℝ) : ℝ
Poincare.D12.KappaVariational.gaussianReducedVolumeViaL_eq_gaussianReducedVolume (n : ℕ) {τ : ℝ} (hτ : 0 < τ) :
  Poincare.D12.KappaVariational.gaussianReducedVolumeViaL n τ = Poincare.D12.KappaVariational.gaussianReducedVolume n τ
Poincare.D12.KappaVariational.gaussianReducedVolumeViaL_eq_one (n : ℕ) {τ : ℝ} (hτ : 0 < τ) :
  Poincare.D12.KappaVariational.gaussianReducedVolumeViaL n τ = 1
