  Poincare.D7.Reduced.LPath (Poincare.D7.Reduced.gaussianFlow n) 0 q τ
Poincare.D12.KappaVariational.constantCurvature_length_le (n : ℕ) (R0 : ℝ) (hR0 : 0 ≤ R0) (q : EuclideanSpace ℝ (Fin n))
  {τ : ℝ} (hτ : 0 < τ)
  (P : Poincare.D7.Reduced.LPath (Poincare.D12.KappaVariational.constantCurvatureFlow n R0) 0 q τ) :
  ‖q‖ ^ 2 / (2 * √τ) + 2 / 3 * R0 * τ ^ (3 / 2) ≤ P.length
Poincare.D12.KappaVariational.constantCurvatureLPath (n : ℕ) (R0 : ℝ) (q : EuclideanSpace ℝ (Fin n)) {τ : ℝ}
  (hτ : 0 < τ) : Poincare.D7.Reduced.LPath (Poincare.D12.KappaVariational.constantCurvatureFlow n R0) 0 q τ
Poincare.D12.KappaVariational.constantCurvature_LlengthAlong (n : ℕ) (R0 : ℝ) (q : EuclideanSpace ℝ (Fin n)) {τ : ℝ}
  (hτ : 0 < τ) :
  (Poincare.D12.KappaVariational.constantCurvatureFlow n R0).LlengthAlong (Poincare.D7.Reduced.gaussianPath q τ)
      (Poincare.D7.Reduced.gaussianVelocity q τ) 0 τ =
    ‖q‖ ^ 2 / (2 * √τ) + 2 / 3 * R0 * τ ^ (3 / 2)
Poincare.D12.KappaVariational.constantCurvature_isLMinimizer (n : ℕ) (R0 : ℝ) (hR0 : 0 ≤ R0)
  (q : EuclideanSpace ℝ (Fin n)) {τ : ℝ} (hτ : 0 < τ) :
  Poincare.D7.Reduced.IsLMinimizer (Poincare.D12.KappaVariational.constantCurvatureLPath n R0 q hτ)
Poincare.D12.KappaVariational.rpow_three_halves_eq_mul_sqrt {τ : ℝ} (hτ : 0 < τ) : τ ^ (3 / 2) = τ * √τ
Poincare.D12.KappaVariational.constantCurvature_reducedLength (n : ℕ) (R0 : ℝ) (q : EuclideanSpace ℝ (Fin n)) {τ : ℝ}
  (hτ : 0 < τ) :
  (Poincare.D12.KappaVariational.constantCurvatureLPath n R0 q hτ).reducedLength = ‖q‖ ^ 2 / (4 * τ) + R0 / 3 * τ
Poincare.D12.KappaVariational.constantCurvature_reducedLength_le (n : ℕ) (R0 : ℝ) (hR0 : 0 ≤ R0)
  (q : EuclideanSpace ℝ (Fin n)) {τ : ℝ} (hτ : 0 < τ)
