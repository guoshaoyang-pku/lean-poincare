missingMoiseSmoothingBridge : Prop
missingGeometrizationOutput : (Longrun.Surgery.TopSpace → Prop) → Prop
missingFinalHomeomorphismConstruction : Prop
missingMoiseSmoothingBridge_iff : missingMoiseSmoothingBridge ↔
  ∀ (M : Type) [inst : TopologicalSpace M] [inst_1 : T2Space M]
    [inst_2 : ChartedSpace Longrun.Topology.EuclideanThree M]
    [inst_3 : IsManifold Longrun.Topology.ThreeManifoldModel ∞ M] [inst_4 : SimplyConnectedSpace M]
    [inst_5 : CompactSpace M], Nonempty (M ≃ₜ Longrun.Topology.SphereThree) → Stage6.poincareConjectureSmoothThree M
missingGeometrizationOutput_iff : ∀ (Geometric : Longrun.Surgery.TopSpace → Prop),
  missingGeometrizationOutput Geometric ↔
    ∀ (M : Longrun.Surgery.TopSpace),
      CompactSpace M.Carrier → T2Space M.Carrier → ∃ pieces, pieces ≠ [] ∧ ∀ P ∈ pieces, Geometric P
missingFinalHomeomorphismConstruction_iff : missingFinalHomeomorphismConstruction ↔
  ∀ (X : Longrun.Surgery.TopSpace),
    SimplyConnectedSpace X.Carrier →
      CompactSpace X.Carrier →
        T2Space X.Carrier →
          ∀ (a : ChartedSpace Longrun.Topology.EuclideanThree X.Carrier),
            Nonempty (X.Carrier ≃ₜ Longrun.Topology.SphereThree)
missingFinalHomeomorphismConstruction_iff_missingPoincareConjectureTopologicalThree : missingFinalHomeomorphismConstruction ↔
  Longrun.Topology.missingPoincareConjectureTopologicalThree
stage6Target_of_missingFinalHomeomorphismConstruction : missingFinalHomeomorphismConstruction →
  ∀ {M : Type} [inst : TopologicalSpace M] [inst_1 : T2Space M]
    [inst_2 : ChartedSpace Longrun.Topology.EuclideanThree M] [inst_3 : SimplyConnectedSpace M]
    [inst_4 : CompactSpace M], Stage6.poincareConjectureTopologicalThree M
missingFinalHomeomorphismConstruction_of_missingPoincare : Longrun.Topology.missingPoincareConjectureTopologicalThree →
  missingFinalHomeomorphismConstruction
smoothTarget_of_topologicalTarget_and_moise : missingMoiseSmoothingBridge →
  ∀ {M : Type} [inst : TopologicalSpace M] [inst_1 : T2Space M]
    [inst_2 : ChartedSpace Longrun.Topology.EuclideanThree M]
    [inst_3 : IsManifold Longrun.Topology.ThreeManifoldModel ∞ M] [inst_4 : SimplyConnectedSpace M]
    [inst_5 : CompactSpace M], Nonempty (M ≃ₜ Longrun.Topology.SphereThree) → Stage6.poincareConjectureSmoothThree M
sphericalPieces_of_geometrization : (missingGeometrizationOutput fun P => IsSphericalPiece P) →
  ∀ {X : Longrun.Surgery.TopSpace},
    CompactSpace X.Carrier → T2Space X.Carrier → ∃ pieces, pieces ≠ [] ∧ ∀ P ∈ pieces, IsSphericalPiece P
finalHomeomorphismConstruction_of_certificateFamily : ∀ (hrec : SphericalPieceRecognition),
  (∀ (X : Longrun.Surgery.TopSpace),
      CompactSpace X.Carrier →
        T2Space X.Carrier →
          ∀ (a : ChartedSpace Longrun.Topology.EuclideanThree X.Carrier),
            SimplyConnectedSpace X.Carrier → ∃ E, Nonempty (CanonicalNeighborhoodInput X E)) →
    missingFinalHomeomorphismConstruction
