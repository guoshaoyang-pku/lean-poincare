  (H : Poincare.D7.Compactness.ManifoldFamilyHypotheses ℕ)
  (CGConvergesTo :
    (ℕ → Poincare.D7.Compactness.PointedMetricSpace) → Poincare.D7.Compactness.PointedMetricSpace → Prop) :
  Prop
Poincare.D7.Compactness.missingCheegerGromovCompactness_iff.{u} (X : ℕ → Poincare.D7.Compactness.PointedMetricSpace)
  (H : Poincare.D7.Compactness.ManifoldFamilyHypotheses ℕ)
  (CGConvergesTo :
    (ℕ → Poincare.D7.Compactness.PointedMetricSpace) → Poincare.D7.Compactness.PointedMetricSpace → Prop) :
  Poincare.D7.Compactness.missingCheegerGromovCompactness X H CGConvergesTo ↔
    H.noncollapsed →
      H.harmonicBounds →
        ∃ φ,
          StrictMono φ ∧
            ∃ Y,
              Nonempty (Poincare.D7.Compactness.GHConvergenceData Filter.atTop (fun k => X (φ k)) Y) ∧
                CGConvergesTo (fun k => X (φ k)) Y
