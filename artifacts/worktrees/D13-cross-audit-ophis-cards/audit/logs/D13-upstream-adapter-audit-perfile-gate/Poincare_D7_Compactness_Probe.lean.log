Poincare.D7.Compactness.unitFinFamily_toyCompactness (n : ℕ) (u : ℕ → Fin n) :
  ∃ i φ,
    StrictMono φ ∧
      Nonempty
        (Poincare.D7.Compactness.GHConvergenceData Filter.atTop
          (fun k => Poincare.D7.Compactness.unitFinFamily n (u (φ k))) (Poincare.D7.Compactness.unitFinFamily n i))
Poincare.D7.Compactness.unitFinFamily_cheegerGromov (n : ℕ) (u : ℕ → Fin n) :
  ∃ φ,
    StrictMono φ ∧
      ∃ Y,
        Nonempty
            (Poincare.D7.Compactness.GHConvergenceData Filter.atTop
              (fun k => Poincare.D7.Compactness.unitFinFamily n (u (φ k))) Y) ∧
          (fun x x_1 => True) (fun k => Poincare.D7.Compactness.unitFinFamily n (u (φ k))) Y
Poincare.D7.Compactness.unitFinFamily_witness_strictMono {n : ℕ} (u : ℕ → Fin n) :
  StrictMono (Poincare.D7.Compactness.constSubsequence u).subseq
Poincare.D7.Compactness.unitFinFamily_witness_const {n : ℕ} (u : ℕ → Fin n) (k : ℕ) :
  u ((Poincare.D7.Compactness.constSubsequence u).subseq k) = (Poincare.D7.Compactness.constSubsequence u).index
