@exists_isMIntegralCurveAt_of_contMDiffAt : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  {H : Type u_2} [inst_2 : TopologicalSpace H] {I : ModelWithCorners ℝ E H} {M : Type u_3} [inst_3 : TopologicalSpace M]
  [inst_4 : ChartedSpace H M] [inst_5 : IsManifold I 1 M] {v : (x : M) → TangentSpace I x} (t₀ : ℝ) {x₀ : M}
  [CompleteSpace E],
  ContMDiffAt I I.tangent 1 (fun x => ⟨x, v x⟩) x₀ → I.IsInteriorPoint x₀ → ∃ γ, γ t₀ = x₀ ∧ IsMIntegralCurveAt γ v t₀
@isMIntegralCurveOn_Ioo_eqOn_of_contMDiff : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  {H : Type u_2} [inst_2 : TopologicalSpace H] {I : ModelWithCorners ℝ E H} {M : Type u_3} [inst_3 : TopologicalSpace M]
  [inst_4 : ChartedSpace H M] [inst_5 : IsManifold I 1 M] {γ γ' : ℝ → M} {v : (x : M) → TangentSpace I x} {t₀ : ℝ}
  [T2Space M] {a b : ℝ},
  t₀ ∈ Set.Ioo a b →
    (∀ t ∈ Set.Ioo a b, I.IsInteriorPoint (γ t)) →
      (ContMDiff I I.tangent 1 fun x => ⟨x, v x⟩) →
        IsMIntegralCurveOn γ v (Set.Ioo a b) →
          IsMIntegralCurveOn γ' v (Set.Ioo a b) → γ t₀ = γ' t₀ → Set.EqOn γ γ' (Set.Ioo a b)
