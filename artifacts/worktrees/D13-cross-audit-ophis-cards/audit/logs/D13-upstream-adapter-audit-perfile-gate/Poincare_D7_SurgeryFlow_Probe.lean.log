  Poincare.D7.SurgeryFlow.missingExtinctionTheorem E ↔ E.extinct ∧ E.terminalSphere
Poincare.D7.SurgeryFlow.extinct_of_missingExtinctionTheorem : ∀ (E : Poincare.D7.SurgeryFlow.ExtinctionData),
  Poincare.D7.SurgeryFlow.missingExtinctionTheorem E → E.extinct
Poincare.D7.SurgeryFlow.terminalSphere_of_missingExtinctionTheorem : ∀ (E : Poincare.D7.SurgeryFlow.ExtinctionData),
  Poincare.D7.SurgeryFlow.missingExtinctionTheorem E → E.terminalSphere
Poincare.D7.SurgeryFlow.toy_extinction_skeleton : ∀ (m : ℕ),
  0 < m → ∃ k, Poincare.Longrun.Surgery.ToyChain m 1 k ∧ k = m - 1
@Poincare.D7.SurgeryFlow.missingSurgeryFlowTheorem : {P : Poincare.Longrun.Surgery.LedgerPredicates} →
  {X Y : Poincare.Longrun.Surgery.TopSpace} →
    {D : Poincare.Longrun.Surgery.SurgeryDatum X Y} →
      Poincare.D7.SurgeryFlow.SurgeryProcedureData P D →
        {T : ℕ → ℝ} → Poincare.D7.SurgeryFlow.CurvatureBoundInterface T → Poincare.D7.SurgeryFlow.ExtinctionData → Prop
@Poincare.D7.SurgeryFlow.missingSurgeryFlowTheorem_iff : ∀ {P : Poincare.Longrun.Surgery.LedgerPredicates}
  {X Y : Poincare.Longrun.Surgery.TopSpace} {D : Poincare.Longrun.Surgery.SurgeryDatum X Y}
  (S : Poincare.D7.SurgeryFlow.SurgeryProcedureData P D) {T : ℕ → ℝ}
  (H : Poincare.D7.SurgeryFlow.CurvatureBoundInterface T) (E : Poincare.D7.SurgeryFlow.ExtinctionData),
  Poincare.D7.SurgeryFlow.missingSurgeryFlowTheorem S H E ↔
    Poincare.D7.SurgeryFlow.missingFullNeckAnalysis P D S ∧
      Poincare.D7.SurgeryFlow.missingAPrioriCurvatureEstimates H ∧ Poincare.D7.SurgeryFlow.missingExtinctionTheorem E
@Poincare.D7.SurgeryFlow.surgeryFlow_consequences : ∀ {P : Poincare.Longrun.Surgery.LedgerPredicates}
  {X Y : Poincare.Longrun.Surgery.TopSpace} {D : Poincare.Longrun.Surgery.SurgeryDatum X Y}
  (S : Poincare.D7.SurgeryFlow.SurgeryProcedureData P D) (N : Poincare.D7.SurgeryFlow.NeckAnalysisHypotheses P D S),
  N.d3.highCurvatureRegion →
    ∀ {T : ℕ → ℝ} (H : Poincare.D7.SurgeryFlow.CurvatureBoundInterface T),
      Poincare.D7.SurgeryFlow.missingAPrioriCurvatureEstimates H →
        ∀ (E : Poincare.D7.SurgeryFlow.ExtinctionData),
          Poincare.D7.SurgeryFlow.missingExtinctionTheorem E →
            derivedSet (Set.range T) = ∅ ∧ (P.SimplyConnected X → P.SimplyConnected Y) ∧ E.extinct ∧ E.terminalSphere
@Poincare.D7.SurgeryFlow.surgeryFlow_consequences_of_missing : ∀ {P : Poincare.Longrun.Surgery.LedgerPredicates}
  {X Y : Poincare.Longrun.Surgery.TopSpace} {D : Poincare.Longrun.Surgery.SurgeryDatum X Y}
  {S : Poincare.D7.SurgeryFlow.SurgeryProcedureData P D} {T : ℕ → ℝ}
  {H : Poincare.D7.SurgeryFlow.CurvatureBoundInterface T} {E : Poincare.D7.SurgeryFlow.ExtinctionData},
  Poincare.D7.SurgeryFlow.missingSurgeryFlowTheorem S H E →
    ∀ {N : Poincare.D7.SurgeryFlow.NeckAnalysisHypotheses P D S},
      N.d3.highCurvatureRegion →
        derivedSet (Set.range T) = ∅ ∧ (P.SimplyConnected X → P.SimplyConnected Y) ∧ E.extinct ∧ E.terminalSphere
