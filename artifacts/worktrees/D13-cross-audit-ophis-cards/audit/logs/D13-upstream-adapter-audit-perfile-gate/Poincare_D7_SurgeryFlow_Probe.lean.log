Poincare.D7.SurgeryFlow.surgeryFlowDependencies : List Poincare.D7.ShortTime.MissingDependency
Poincare.D7.SurgeryFlow.surgeryFlowDependencies_length : Poincare.D7.SurgeryFlow.surgeryFlowDependencies.length = 12
Poincare.D7.SurgeryFlow.surgeryFlowDependencies_ne_nil : Poincare.D7.SurgeryFlow.surgeryFlowDependencies ≠ []
Poincare.D7.SurgeryFlow.surgeryFlowDependencies_all_named : ∀ d ∈ Poincare.D7.SurgeryFlow.surgeryFlowDependencies,
  d.name ≠ "" ∧ d.reason ≠ ""
Poincare.D7.SurgeryFlow.surgeryFlowBlockers : List String
Poincare.D7.SurgeryFlow.surgeryFlowBlockers_length : Poincare.D7.SurgeryFlow.surgeryFlowBlockers.length = 6
Poincare.D7.SurgeryFlow.surgeryFlowBlockers_ne_nil : Poincare.D7.SurgeryFlow.surgeryFlowBlockers ≠ []
Poincare.D7.SurgeryFlow.surgeryFlowBlockers_all_named : ∀ b ∈ Poincare.D7.SurgeryFlow.surgeryFlowBlockers, b ≠ ""
