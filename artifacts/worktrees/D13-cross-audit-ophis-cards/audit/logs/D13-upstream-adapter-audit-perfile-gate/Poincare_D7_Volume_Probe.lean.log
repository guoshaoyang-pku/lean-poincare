Poincare.D7.Volume.euclideanVolumeFormData (n : ℕ) : VolumeFormData (EuclideanSpace ℝ (Fin n))
Poincare.D7.Volume.euclideanVolumeFormData_two_apply (v : Fin 2 → EuclideanSpace ℝ (Fin 2)) :
  (euclideanVolumeFormData 2).volumeForm v = (v 0).ofLp 0 * (v 1).ofLp 1 - (v 0).ofLp 1 * (v 1).ofLp 0
Poincare.D7.Volume.euclideanVolumeFormData_scaling_witness (v : Fin 2 → EuclideanSpace ℝ (Fin 2)) :
  ((euclideanVolumeFormData 2).scaledVolumeForm (EuclideanSpace.basisFun (Fin 2) ℝ) 4 ⋯) v =
    4 * (euclideanVolumeFormData 2).volumeForm v
