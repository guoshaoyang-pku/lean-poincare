          DifferentiableAt ℝ (deriv (deriv u)) r →
            Poincare.D10.jacobiSol κ r ≠ 0 →
              deriv (Poincare.D11.BochnerManifold.modelLap n κ u) r = 0 → Poincare.D7.Bochner.GradientCertificate
D13TYPE	Poincare.D11.BochnerManifold.modelGradientCertificate._proof_1	theorem	Poincare.D11.BochnerManifold.D7Bridge	∀ {u : ℝ → ℝ} {r κ : ℝ} (n : ℕ),
  0 ≤ κ →
    0 ≤
      Poincare.D7.Bochner.ricciPairing (Poincare.D11.BochnerManifold.modelRicMat n κ)
