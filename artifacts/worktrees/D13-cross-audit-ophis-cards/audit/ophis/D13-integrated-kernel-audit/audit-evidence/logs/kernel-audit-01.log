    Poincare.D12.TensorMaximumBochner.So3Polynomial.rotVec (Poincare.D12.TensorMaximumBochner.So3.stdMetric.basis j) 0 *
      Poincare.D12.TensorMaximumBochner.So3Polynomial.rotVec (Poincare.D12.TensorMaximumBochner.So3.stdMetric.basis j) 0
