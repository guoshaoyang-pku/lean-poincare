D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.weighted_divergence_mul_exp_grad	theorem	Poincare.D12.VolumeIBP.IBP	∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (f u v : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
  ContDiff ℝ 2 f →
    ContDiff ℝ 2 u →
      ContDiff ℝ 2 v →
        ∀ (x : Poincare.D12.VolumeIBP.Vec (n + 1)),
          Poincare.D12.VolumeIBP.ChartMetric.weightedDivergence (fun y => Real.exp (-f y) * G.density y)
              (fun y i => v y * G.grad u y i) x =
            Real.exp (-f x) * G.density x * (v x * G.driftLaplacian f u x + G.gradInnerInverse v u x)
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.weighted_divergence_mul_grad	theorem	Poincare.D12.VolumeIBP.IBP	∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (u v : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),
  ContDiff ℝ 2 u →
    ContDiff ℝ 2 v →
      ∀ (x : Poincare.D12.VolumeIBP.Vec (n + 1)),
        Poincare.D12.VolumeIBP.ChartMetric.weightedDivergence G.density (fun y i => u y * G.grad v y i) x =
          G.density x * (u x * G.laplacian v x + G.gradInnerInverse u v x)
