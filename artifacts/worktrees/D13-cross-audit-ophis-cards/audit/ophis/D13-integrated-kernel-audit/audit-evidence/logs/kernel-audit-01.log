D13TYPE	Poincare.D11.BochnerManifold.model_flat_certificate_identity	theorem	Poincare.D11.BochnerManifold.D7Bridge	∀ {u : ℝ → ℝ} {r : ℝ} (n : ℕ) (hu2 : Differentiable ℝ (deriv u)) (hu3 : DifferentiableAt ℝ (deriv (deriv u)) r)
