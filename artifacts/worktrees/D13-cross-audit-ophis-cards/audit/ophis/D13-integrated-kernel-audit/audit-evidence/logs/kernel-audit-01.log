D13TYPE	Poincare.D11.BochnerManifold.euclidean_bochner_identity_components_restated	theorem	Poincare.D11.BochnerManifold.Basic	∀ {n : ℕ} {u : Poincare.D10.BochnerEuclidean.E n → ℝ},
