D13TYPE	Poincare.D12.ParabolicLocal.heatMildSolution	def	Poincare.D12.ParabolicLocal.GaussianSetup	(n : ℕ) →
  {L : NNReal} →
    (F : Poincare.D12.ParabolicLocal.BUCn n → Poincare.D12.ParabolicLocal.BUCn n) →
      LipschitzWith L F →
        Poincare.D12.ParabolicLocal.BUCn n →
          {T : ℝ} →
            0 ≤ T →
              1 * ↑L * T < 1 →
                Poincare.D12.ParabolicLocal.DuhamelSetup.SolutionSpace (Poincare.D12.ParabolicLocal.BUCn n) T
D13TYPE	Poincare.D12.ParabolicLocal.heatMildSolution.eq_1	theorem	Poincare.D12.ParabolicLocal.GaussianSetup	∀ (n : ℕ) {L : NNReal} (F : Poincare.D12.ParabolicLocal.BUCn n → Poincare.D12.ParabolicLocal.BUCn n)
  (hF : LipschitzWith L F) (u₀ : Poincare.D12.ParabolicLocal.BUCn n) {T : ℝ} (hT : 0 ≤ T) (hK : 1 * ↑L * T < 1),
  Poincare.D12.ParabolicLocal.heatMildSolution n F hF u₀ hT hK =
    (Poincare.D12.ParabolicLocal.gaussianSetup n F hF u₀).mildSolution hT hK
D13TYPE	Poincare.D12.ParabolicLocal.heatMildSolution_duhamel_eq	theorem	Poincare.D12.ParabolicLocal.GaussianSetup	∀ (n : ℕ) {L : NNReal} (F : Poincare.D12.ParabolicLocal.BUCn n → Poincare.D12.ParabolicLocal.BUCn n)
  (hF : LipschitzWith L F) (u₀ : Poincare.D12.ParabolicLocal.BUCn n) {T : ℝ} (hT : 0 ≤ T) (hK : 1 * ↑L * T < 1)
  (t : ↑(Set.Icc 0 T)),
  (Poincare.D12.ParabolicLocal.heatMildSolution n F hF u₀ hT hK) t =
    (Poincare.D12.ParabolicLocal.gaussianS n ↑t) u₀ +
      ∫ (s : ℝ) in 0..↑t,
        (Poincare.D12.ParabolicLocal.gaussianS n (↑t - s))
          (F
            ((Poincare.D12.ParabolicLocal.DuhamelSetup.extendToInterval T hT
                (Poincare.D12.ParabolicLocal.heatMildSolution n F hF u₀ hT hK))
              s))
D13TYPE	Poincare.D12.ParabolicLocal.heatMildSolution_duhamel_eq_kernel	theorem	Poincare.D12.ParabolicLocal.GaussianSetup	∀ (n : ℕ) {L : NNReal} (F : Poincare.D12.ParabolicLocal.BUCn n → Poincare.D12.ParabolicLocal.BUCn n)
  (hF : LipschitzWith L F) (u₀ : Poincare.D12.ParabolicLocal.BUCn n) {T : ℝ} (hT : 0 ≤ T) (hK : 1 * ↑L * T < 1) {t : ℝ}
  (ht : 0 < t) (htT : t ≤ T),
  ((Poincare.D12.ParabolicLocal.heatMildSolution n F hF u₀ hT hK) ⟨t, ⋯⟩).val =
    Poincare.D12.ParabolicLocal.heatConv n t u₀.val +
      ∫ (s : ℝ) in 0..t,
        Poincare.D12.ParabolicLocal.heatConv n (t - s)
          (F
              ((Poincare.D12.ParabolicLocal.DuhamelSetup.extendToInterval T hT
                  (Poincare.D12.ParabolicLocal.heatMildSolution n F hF u₀ hT hK))
                s)).val
