  ε ∈ Set.Ioo 0 t₀ →
    Poincare.D12.ComparisonGeodesics.EuclideanNormalizedOn m d C t₀ →
      Poincare.D12.ComparisonGeodesics.EuclideanNormalizedOn mbar d C t₀ → |m ε - mbar ε| ≤ 2 * C
