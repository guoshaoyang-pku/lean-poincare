    DifferentiableAt ℝ (deriv (deriv u)) r →
      Poincare.D10.jacobiSol κ r ≠ 0 →
        Poincare.D11.BochnerManifold.modelLap n κ (Poincare.D11.BochnerManifold.modelGradSq u) r / 2 =
          Poincare.D11.BochnerManifold.modelHessSq n κ u r +
              Poincare.D11.BochnerManifold.modelGradDot u (Poincare.D11.BochnerManifold.modelLap n κ u) r +
            Poincare.D11.BochnerManifold.modelRicciTerm n κ u r
D13TYPE	Poincare.D11.BochnerManifold.modelBochnerCertificate._proof_3	theorem	Poincare.D11.BochnerManifold.D7Bridge	∀ {u : ℝ → ℝ} {r κ : ℝ} (n : ℕ),
