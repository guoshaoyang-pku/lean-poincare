    ∀ {ι : Type u_1} [inst : Fintype ι] (F : Poincare.Longrun.CurvatureODE.ReactionField ι) {c : ι → ℝ},
      (∀ (i : ι), 1 ≤ c i) →
        ∀ {T : ℝ} {traj : ℝ → ι → ℝ},
          Poincare.Longrun.CurvatureODE.EvolutionRelation F T traj →
            ∀ {t : ℝ},
              t < τ₀ →
                t ∈ Set.Ico 0 T →
                  HasDerivAt (fun u => (Poincare.D12.EntropyVariation.fflowEntropyData n τ₀ hτ₀ u).F)
                      (↑n / (2 * (τ₀ - t) ^ 2)) t ∧
                    0 < ↑n / (2 * (τ₀ - t) ^ 2) ∧
                      HasDerivWithinAt (fun s => Poincare.Longrun.Evolution.perelmanF c (traj s))
                          (-∑ i, F.eval (traj t) i * ((traj t i - 1) ^ 2 + (c i - 1)) * Real.exp (-traj t i))
                          (Set.Ici t) t ∧
                        -∑ i, F.eval (traj t) i * ((traj t i - 1) ^ 2 + (c i - 1)) * Real.exp (-traj t i) ≤ 0
