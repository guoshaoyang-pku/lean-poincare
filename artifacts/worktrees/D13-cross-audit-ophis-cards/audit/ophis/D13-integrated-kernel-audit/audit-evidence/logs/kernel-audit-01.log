D13TYPE	Poincare.D12.ConnectionCurvature.fderiv_mul_mul_apply	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaSmooth	∀ {ι : Type w} [Fintype ι] [DecidableEq ι] (f g h : Poincare.D12.ConnectionCurvature.ChartPoint ι → ℝ)
  (x v : Poincare.D12.ConnectionCurvature.ChartPoint ι),
  DifferentiableAt ℝ f x →
    DifferentiableAt ℝ g x →
      DifferentiableAt ℝ h x →
        (fderiv ℝ (fun y => f y * g y * h y) x) v =
          f x * g x * (fderiv ℝ h x) v + f x * h x * (fderiv ℝ g x) v + g x * h x * (fderiv ℝ f x) v
