D13TYPE	Poincare.D12.ConnectionCurvature.SmoothChartData.nabla_metricCompatible	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaSmooth	∀ {ι : Type w} [inst : Fintype ι] [inst_1 : DecidableEq ι] (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι)
  (X Y Z : Poincare.D12.ConnectionCurvature.VectorField ι),
  ContDiff ℝ (↑⊤) Y →
    ContDiff ℝ (↑⊤) Z →
      ∀ (x : Poincare.D12.ConnectionCurvature.ChartPoint ι),
        (fderiv ℝ (fun z => c.formField z (Y z) (Z z)) x) (X x) =
          c.formField x (c.nabla X Y x) (Z x) + c.formField x (Y x) (c.nabla X Z x)
