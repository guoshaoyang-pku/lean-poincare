D13TYPE	Poincare.D11.BochnerManifold.model_ricci_pairing_eq_ricciTerm	theorem	Poincare.D11.BochnerManifold.D7Bridge	∀ (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) (r : ℝ),
  Poincare.D7.Bochner.ricciPairing (Poincare.D11.BochnerManifold.modelRicMat n κ)
