D13TYPE	Poincare.D12.TensorMaximumBochner.So3Polynomial.so3e1_one	theorem	Poincare.D12.TensorMaximumBochner.So3Polynomial	Poincare.D12.TensorMaximumBochner.So3Polynomial.so3e1 1 = 1
D13TYPE	Poincare.D12.TensorMaximumBochner.So3Polynomial.so3e1_two	theorem	Poincare.D12.TensorMaximumBochner.So3Polynomial	Poincare.D12.TensorMaximumBochner.So3Polynomial.so3e1 2 = 0
D13TYPE	Poincare.D12.TensorMaximumBochner.So3Polynomial.so3e1_zero	theorem	Poincare.D12.TensorMaximumBochner.So3Polynomial	Poincare.D12.TensorMaximumBochner.So3Polynomial.so3e1 0 = 0
D13TYPE	Poincare.D12.TensorMaximumBochner.So3Polynomial.stdMetric_basis_apply	theorem	Poincare.D12.TensorMaximumBochner.So3Polynomial	∀ (i j : Fin 3), Poincare.D12.TensorMaximumBochner.So3.stdMetric.basis i j = if i = j then 1 else 0
