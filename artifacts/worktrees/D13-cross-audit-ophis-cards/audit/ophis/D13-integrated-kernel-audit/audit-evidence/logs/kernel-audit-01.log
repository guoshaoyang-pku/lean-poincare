  deriv (Poincare.D11.BochnerManifold.modelLap n κ u) r = 0 →
    Poincare.D7.Bochner.gradLaplacianDot (Poincare.D11.BochnerManifold.modelGradVec u r n)
        (Poincare.D11.BochnerManifold.modelGradLapVec n κ u r) =
      0
