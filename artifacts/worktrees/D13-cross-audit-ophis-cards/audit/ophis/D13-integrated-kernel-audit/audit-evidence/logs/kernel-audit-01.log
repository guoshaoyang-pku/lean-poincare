  Poincare.Longrun.Entropy.BochnerStatement C =
    ∀ (u : X → ℝ) (x : X),
      C.laplacian (fun y => Poincare.Longrun.Entropy.gradInner C u u y) x =
        2 * C.hessSq u x + 2 * C.ricci (C.grad u x) (C.grad u x) +
          2 * Poincare.Longrun.Entropy.gradInner C u (fun y => C.laplacian u y) x
