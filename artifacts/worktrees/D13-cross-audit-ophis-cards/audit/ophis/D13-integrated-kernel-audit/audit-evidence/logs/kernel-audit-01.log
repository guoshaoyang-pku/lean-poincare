D13TYPE	Poincare.D12.ConnectionCurvature.SmoothChartData.nabla_const_apply	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaSmooth	∀ {ι : Type w} [inst : Fintype ι] [inst_1 : DecidableEq ι] (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι)
