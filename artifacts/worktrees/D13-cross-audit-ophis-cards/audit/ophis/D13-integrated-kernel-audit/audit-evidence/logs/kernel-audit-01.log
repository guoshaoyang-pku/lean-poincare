D13TYPE	Poincare.D12.TensorMaximumBochner.staysPosSemidef_of_field	theorem	Poincare.D12.TensorMaximumBochner.PositivityPreservation	∀ {n : Type u} [inst : Fintype n] {M : ℝ → n → n → ℝ} (P : Matrix n n ℝ → Matrix n n ℝ),
  (∀ (t : ℝ), 0 ≤ t → DifferentiableAt ℝ M t) →
    (∀ (t : ℝ), Matrix.IsHermitian (M t)) →
      Matrix.PosSemidef (M 0) →
        (∀ (t : ℝ), 0 ≤ t → deriv M t = P (M t)) →
          (∀ (A : Matrix n n ℝ),
              A.IsHermitian → ∀ (v : n → ℝ), star v ⬝ᵥ A.mulVec v ≤ 0 → 0 ≤ star v ⬝ᵥ (P A).mulVec v) →
            ∀ (t : ℝ), 0 ≤ t → Matrix.PosSemidef (M t)
D13TYPE	Poincare.D12.TensorMaximumBochner.staysPosSemidef_of_tangent	theorem	Poincare.D12.TensorMaximumBochner.PositivityPreservation	∀ {n : Type u} [inst : Fintype n] {M : ℝ → n → n → ℝ},
  (∀ (t : ℝ), 0 ≤ t → DifferentiableAt ℝ M t) →
    (∀ (t : ℝ), Matrix.IsHermitian (M t)) →
      Matrix.PosSemidef (M 0) →
        (∀ (t : ℝ),
            0 ≤ t →
              ∀ (v : n → ℝ),
                star v ⬝ᵥ Matrix.mulVec (M t) v ≤ 0 →
                  0 ≤
                    star v ⬝ᵥ
                      Matrix.mulVec
                        (have this := deriv M t;
                        this)
                        v) →
          ∀ (t : ℝ), 0 ≤ t → Matrix.PosSemidef (M t)
D13TYPE	Poincare.D12.TensorMaximumBochner.staysPosSemidef_of_tangent_Icc	theorem	Poincare.D12.TensorMaximumBochner.PositivityPreservation	∀ {n : Type u} [inst : Fintype n] {M : ℝ → n → n → ℝ} {T : ℝ},
  (∀ t ∈ Set.Icc 0 T, DifferentiableAt ℝ M t) →
    (∀ t ∈ Set.Icc 0 T, Matrix.IsHermitian (M t)) →
      Matrix.PosSemidef (M 0) →
        (∀ t ∈ Set.Ioo 0 T,
            ∀ (v : n → ℝ),
              star v ⬝ᵥ Matrix.mulVec (M t) v ≤ 0 →
                0 ≤
                  star v ⬝ᵥ
                    Matrix.mulVec
                      (have this := deriv M t;
                      this)
                      v) →
          ∀ t ∈ Set.Icc 0 T, Matrix.PosSemidef (M t)
D13TYPE	Poincare.D12.TensorMaximumBochner.tangentCondition_selfSq_sub_self	theorem	Poincare.D12.TensorMaximumBochner.PositivityPreservation	∀ {n : Type u} [inst : Fintype n] [inst_1 : DecidableEq n] (A : Matrix n n ℝ),
