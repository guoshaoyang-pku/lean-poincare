  0 < d →
    0 ≤ C →
      0 < u →
        u ≤ t₀ →
          Poincare.D12.ComparisonGeodesics.EuclideanNormalizedOn m d C t₀ →
            Poincare.D12.ComparisonGeodesics.EuclideanNormalizedOn mbar d C t₀ →
              ContinuousOn (fun t => (m t + mbar t) / d) (Set.Ioc 0 u) →
                ∀ ε ∈ Set.Ioo 0 u,
                  Real.exp (-∫ (x : ℝ) in ε..u, (m x + mbar x) / d) ≤ (ε / u) ^ 2 * Real.exp (2 * C * (u - ε) / d)
