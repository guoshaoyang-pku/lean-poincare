    Poincare.D11.BochnerManifold.modelHessSq n κ u r
D13TYPE	Poincare.D11.BochnerManifold.model_gradient_certificate_laplacian_grad_norm_sq	theorem	Poincare.D11.BochnerManifold.D7Bridge	∀ {u : ℝ → ℝ} {r κ : ℝ} (n : ℕ) (hκ : 0 ≤ κ) (hu2 : Differentiable ℝ (deriv u))
  (hu3 : DifferentiableAt ℝ (deriv (deriv u)) r) (hne : Poincare.D10.jacobiSol κ r ≠ 0)
