            2 * deriv (fun s => |deriv u s|) r ^ 2
D13TYPE	Poincare.D11.BochnerManifold.modelBochnerCertificate	def	Poincare.D11.BochnerManifold.D7Bridge	{u : ℝ → ℝ} →
  {r κ : ℝ} →
    ℕ →
      0 ≤ κ →
        Differentiable ℝ (deriv u) →
          DifferentiableAt ℝ (deriv (deriv u)) r →
            Poincare.D10.jacobiSol κ r ≠ 0 → Poincare.D7.Bochner.BochnerCertificate
D13TYPE	Poincare.D11.BochnerManifold.modelBochnerCertificate._proof_1	theorem	Poincare.D11.BochnerManifold.D7Bridge	(1 + 1).AtLeastTwo
D13TYPE	Poincare.D11.BochnerManifold.modelBochnerCertificate._proof_2	theorem	Poincare.D11.BochnerManifold.D7Bridge	∀ {u : ℝ → ℝ} {r κ : ℝ} (n : ℕ),
