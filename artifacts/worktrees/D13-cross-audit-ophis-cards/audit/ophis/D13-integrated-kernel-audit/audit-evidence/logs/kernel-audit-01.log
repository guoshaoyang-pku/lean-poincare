  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X Y₁ Y₂ : ι → ℝ),
  ∑ i, ∑ j, c.g i j * X i * (Y₁ + Y₂) j = ∑ x, ∑ x_1, c.g x x_1 * X x * Y₁ x_1 + ∑ x, ∑ x_1, c.g x x_1 * X x * Y₂ x_1
D13TYPE	Poincare.D12.ConnectionCurvature.formOf._proof_3	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaForm	∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι]
