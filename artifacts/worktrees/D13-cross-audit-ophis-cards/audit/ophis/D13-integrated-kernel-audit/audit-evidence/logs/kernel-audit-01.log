D13TYPE	Poincare.D12.ConnectionCurvature.dFormOf.eq_1	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaForm	∀ {ι : Type w} [inst : Fintype ι] [inst_1 : DecidableEq ι]
