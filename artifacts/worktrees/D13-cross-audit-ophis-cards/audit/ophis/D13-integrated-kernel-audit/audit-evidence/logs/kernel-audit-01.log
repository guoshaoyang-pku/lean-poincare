D13TYPE	Poincare.D12.EntropyVariation.fDerivativeCorrected_at_of_pointwise	theorem	Poincare.D12.EntropyVariation.EntropyDerivative	∀ {X : Type u} [inst : MeasurableSpace X] {μ : MeasureTheory.Measure X}
  (E : ℝ → Poincare.Longrun.Entropy.EntropyData X μ) {bound : X → ℝ} {t₀ : ℝ} {s : Set ℝ},
  s ∈ nhds t₀ →
    (∀ᶠ (t : ℝ) in nhds t₀, MeasureTheory.AEStronglyMeasurable (fun x => ((E t).R x + (E t).gradSq x) * (E t).ρ x) μ) →
      MeasureTheory.Integrable (fun x => ((E t₀).R x + (E t₀).gradSq x) * (E t₀).ρ x) μ →
        MeasureTheory.AEStronglyMeasurable (fun x => 2 * (E t₀).riccHess x * (E t₀).ρ x) μ →
          (∀ᵐ (x : X) ∂μ, ∀ t ∈ s, HasDerivAt (fun u => (E u).R x + (E u).gradSq x) (2 * (E t).riccHess x) t) →
            (∀ᵐ (x : X) ∂μ, ∀ t ∈ s, HasDerivAt (fun u => (E u).ρ x) 0 t) →
              (∀ᵐ (x : X) ∂μ, ∀ t ∈ s, ‖2 * (E t).riccHess x * (E t).ρ x‖ ≤ bound x) →
                MeasureTheory.Integrable bound μ →
                  HasDerivAt (fun t => (E t).F) (Poincare.D12.EntropyVariation.FDissipationCorrected (E t₀)) t₀
D13TYPE	Poincare.D12.EntropyVariation.fDerivativeCorrected_of_pointwise	theorem	Poincare.D12.EntropyVariation.EntropyDerivative	∀ {X : Type u} [inst : MeasurableSpace X] {μ : MeasureTheory.Measure X}
  (E : ℝ → Poincare.Longrun.Entropy.EntropyData X μ) (bound : ℝ → X → ℝ) (s : ℝ → Set ℝ),
  (∀ (t : ℝ), 0 < t → s t ∈ nhds t) →
    (∀ (t : ℝ),
        0 < t →
          ∀ᶠ (u : ℝ) in nhds t,
            MeasureTheory.AEStronglyMeasurable (fun x => ((E u).R x + (E u).gradSq x) * (E u).ρ x) μ) →
      (∀ (t : ℝ), 0 < t → MeasureTheory.Integrable (fun x => ((E t).R x + (E t).gradSq x) * (E t).ρ x) μ) →
        (∀ (t : ℝ), 0 < t → MeasureTheory.AEStronglyMeasurable (fun x => 2 * (E t).riccHess x * (E t).ρ x) μ) →
          (∀ (t : ℝ),
              0 < t →
                ∀ᵐ (x : X) ∂μ, ∀ u ∈ s t, HasDerivAt (fun v => (E v).R x + (E v).gradSq x) (2 * (E u).riccHess x) u) →
            (∀ (t : ℝ), 0 < t → ∀ᵐ (x : X) ∂μ, ∀ u ∈ s t, HasDerivAt (fun v => (E v).ρ x) 0 u) →
              (∀ (t : ℝ), 0 < t → ∀ᵐ (x : X) ∂μ, ∀ u ∈ s t, ‖2 * (E u).riccHess x * (E u).ρ x‖ ≤ bound t x) →
                (∀ (t : ℝ), 0 < t → MeasureTheory.Integrable (bound t) μ) →
                  ∀ (t : ℝ),
                    0 < t → HasDerivAt (fun s => (E s).F) (Poincare.D12.EntropyVariation.FDissipationCorrected (E t)) t
