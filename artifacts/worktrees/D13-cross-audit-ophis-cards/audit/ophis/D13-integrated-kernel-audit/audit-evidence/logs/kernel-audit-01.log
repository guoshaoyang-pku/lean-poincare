D13TYPE	Poincare.D11.BochnerManifold.lapG	def	Poincare.D11.BochnerManifold.Basic	ℕ → (ℝ → ℝ) → (ℝ → ℝ) → ℝ → ℝ
D13TYPE	Poincare.D11.BochnerManifold.lapG.eq_1	theorem	Poincare.D11.BochnerManifold.RadialBochner	∀ (n : ℕ) (m u : ℝ → ℝ) (r : ℝ), Poincare.D11.BochnerManifold.lapG n m u r = deriv (deriv u) r + ↑n * (m r * deriv u r)
D13TYPE	Poincare.D11.BochnerManifold.lap_gradSq_split	theorem	Poincare.D11.BochnerManifold.Basic	∀ {u m : ℝ → ℝ} {r : ℝ} (n : ℕ),
  Differentiable ℝ (deriv u) →
    DifferentiableAt ℝ (deriv (deriv u)) r →
      deriv u r ≠ 0 →
        Poincare.D11.BochnerManifold.lapG n m (Poincare.D11.BochnerManifold.gradSq u) r =
