D13TYPE	Poincare.D12.ConnectionCurvature.SmoothChartData.nabla	def	Poincare.D12.ConnectionCurvature.ChartLeviCivitaSmooth	{ι : Type w} →
  [inst : Fintype ι] →
    [inst_1 : DecidableEq ι] →
      Poincare.D12.ConnectionCurvature.SmoothChartData ι →
