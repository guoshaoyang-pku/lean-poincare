          2 * Poincare.D11.BochnerManifold.ricTerm n m u r
D13TYPE	Poincare.D11.BochnerManifold.radial_bochner_identity	theorem	Poincare.D11.BochnerManifold.RadialBochner	∀ {u m : ℝ → ℝ} {r : ℝ} (n : ℕ),
