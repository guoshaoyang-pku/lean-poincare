D13TYPE	Poincare.D11.BochnerManifold.modelRicciTerm_nonneg_of_nonneg	theorem	Poincare.D11.BochnerManifold.Corollaries	∀ (n : ℕ) (κ : ℝ), 0 ≤ κ → ∀ (u : ℝ → ℝ) (r : ℝ), 0 ≤ Poincare.D11.BochnerManifold.modelRicciTerm n κ u r
D13TYPE	Poincare.D11.BochnerManifold.model_bochner_certificate_bochner	theorem	Poincare.D11.BochnerManifold.D7Bridge	∀ {u : ℝ → ℝ} {r κ : ℝ} (n : ℕ) (hκ : 0 ≤ κ) (hu2 : Differentiable ℝ (deriv u))
  (hu3 : DifferentiableAt ℝ (deriv (deriv u)) r) (hne : Poincare.D10.jacobiSol κ r ≠ 0),
  (Poincare.D11.BochnerManifold.modelBochnerCertificate n hκ hu2 hu3 hne).oneFormLaplacian =
    (Poincare.D11.BochnerManifold.modelBochnerCertificate n hκ hu2 hu3 hne).roughLaplacian +
      (Poincare.D11.BochnerManifold.modelBochnerCertificate n hκ hu2 hu3 hne).ricciContraction
D13TYPE	Poincare.D11.BochnerManifold.model_bochner_inequality_of_nonneg_ricci	theorem	Poincare.D11.BochnerManifold.Corollaries	∀ {u : ℝ → ℝ} {r κ : ℝ} (n : ℕ),
  0 ≤ κ →
    Differentiable ℝ (deriv u) →
      DifferentiableAt ℝ (deriv (deriv u)) r →
        Poincare.D10.jacobiSol κ r ≠ 0 →
          2 * Poincare.D11.BochnerManifold.modelHessSq n κ u r ≤
            Poincare.D11.BochnerManifold.modelLap n κ (Poincare.D11.BochnerManifold.modelGradSq u) r -
              2 * Poincare.D11.BochnerManifold.modelGradDot u (Poincare.D11.BochnerManifold.modelLap n κ u) r
D13TYPE	Poincare.D11.BochnerManifold.model_bochner_weitzenbock	theorem	Poincare.D11.BochnerManifold.ModelSpace	∀ {u : ℝ → ℝ} {r κ : ℝ} (n : ℕ),
  Differentiable ℝ (deriv u) →
    DifferentiableAt ℝ (deriv (deriv u)) r →
      Poincare.D10.jacobiSol κ r ≠ 0 →
        Poincare.D11.BochnerManifold.modelLap n κ (Poincare.D11.BochnerManifold.modelGradSq u) r =
          2 * Poincare.D11.BochnerManifold.modelHessSq n κ u r +
              2 * Poincare.D11.BochnerManifold.modelGradDot u (Poincare.D11.BochnerManifold.modelLap n κ u) r +
            2 * Poincare.D11.BochnerManifold.modelRicciTerm n κ u r
D13TYPE	Poincare.D11.BochnerManifold.model_bochner_weitzenbock_harmonic	theorem	Poincare.D11.BochnerManifold.Corollaries	∀ {u : ℝ → ℝ} {r κ : ℝ} (n : ℕ),
  Differentiable ℝ (deriv u) →
    DifferentiableAt ℝ (deriv (deriv u)) r →
      Poincare.D10.jacobiSol κ r ≠ 0 →
        deriv (Poincare.D11.BochnerManifold.modelLap n κ u) r = 0 →
          Poincare.D11.BochnerManifold.modelLap n κ (Poincare.D11.BochnerManifold.modelGradSq u) r =
            2 * Poincare.D11.BochnerManifold.modelHessSq n κ u r +
              2 * Poincare.D11.BochnerManifold.modelRicciTerm n κ u r
D13TYPE	Poincare.D11.BochnerManifold.model_bochner_weitzenbock_unfolded	theorem	Poincare.D11.BochnerManifold.ModelSpace	∀ {u : ℝ → ℝ} {r κ : ℝ} (n : ℕ),
