  (f : Poincare.D12.ConnectionCurvature.ChartPoint ι → ℝ),
  ContDiff ℝ 1 f →
    ∀ (X Y : Poincare.D12.ConnectionCurvature.VectorField ι),
      ContDiff ℝ 1 Y →
        ∀ (x : Poincare.D12.ConnectionCurvature.ChartPoint ι),
