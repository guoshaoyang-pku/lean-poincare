    DifferentiableAt ℝ (deriv (deriv u)) r →
      Poincare.D10.jacobiSol κ r ≠ 0 →
        Poincare.D11.BochnerManifold.lapG n (Poincare.D11.BochnerManifold.jacobiMeanCurvature κ)
            (Poincare.D11.BochnerManifold.gradSq u) r =
          2 *
            (Poincare.D11.BochnerManifold.hessSq n (Poincare.D11.BochnerManifold.jacobiMeanCurvature κ) u r +
                Poincare.D11.BochnerManifold.gradDot u
                  (Poincare.D11.BochnerManifold.lapG n (Poincare.D11.BochnerManifold.jacobiMeanCurvature κ) u) r +
              ↑n * κ * Poincare.D11.BochnerManifold.gradSq u r)
D13TYPE	Poincare.D11.BochnerManifold.model_flat_bochner	theorem	Poincare.D11.BochnerManifold.ModelSpace	∀ {u : ℝ → ℝ} {r : ℝ} (n : ℕ),
  Differentiable ℝ (deriv u) →
    DifferentiableAt ℝ (deriv (deriv u)) r →
