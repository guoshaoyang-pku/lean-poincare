          Poincare.D12.TensorMaximumBochner.So3.crossLeviCivita
          (Poincare.D12.TensorMaximumBochner.Bochner.gradSq
            Poincare.D12.TensorMaximumBochner.So3Polynomial.crossDerivation u))
