D13TYPE	Poincare.D11.BochnerManifold.model_grad_lap_dot_eq_gradDot	theorem	Poincare.D11.BochnerManifold.D7Bridge	∀ (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) (r : ℝ),
  Poincare.D7.Bochner.gradLaplacianDot (Poincare.D11.BochnerManifold.modelGradVec u r n)
