D13TYPE	Poincare.D11.BochnerManifold.model_hess_norm_sq_eq_hessSq	theorem	Poincare.D11.BochnerManifold.D7Bridge	∀ (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) (r : ℝ),
