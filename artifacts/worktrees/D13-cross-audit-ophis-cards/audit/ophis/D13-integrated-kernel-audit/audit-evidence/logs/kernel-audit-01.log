    2 *
        (Poincare.D12.TensorMaximumBochner.So3Polynomial.evalAt x)
          (Poincare.D12.TensorMaximumBochner.Bochner.gradInner
            Poincare.D12.TensorMaximumBochner.So3Polynomial.crossDerivation u
            (Poincare.D12.TensorMaximumBochner.Bochner.lap
