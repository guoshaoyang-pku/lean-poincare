D13TYPE	Poincare.D12.TensorMaximumBochner.So3Polynomial.polyVec.eq_1	theorem	Poincare.D12.TensorMaximumBochner.So3Polynomial	Poincare.D12.TensorMaximumBochner.So3Polynomial.polyVec =
  { toFun := fun X i => MvPolynomial.C (X i),
    map_add' := Poincare.D12.TensorMaximumBochner.So3Polynomial.polyVec._proof_1,
    map_smul' := Poincare.D12.TensorMaximumBochner.So3Polynomial.polyVec._proof_2 }
D13TYPE	Poincare.D12.TensorMaximumBochner.So3Polynomial.ricciContraction_so3	theorem	Poincare.D12.TensorMaximumBochner.So3Polynomial	∀ (u : Poincare.D12.TensorMaximumBochner.So3Polynomial.Poly3),
