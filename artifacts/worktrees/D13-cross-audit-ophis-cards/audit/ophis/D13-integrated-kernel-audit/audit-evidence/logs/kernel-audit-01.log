    Poincare.D11.BochnerManifold.modelGradDot u (Poincare.D11.BochnerManifold.modelLap n κ u) r
D13TYPE	Poincare.D11.BochnerManifold.model_gradient_certificate_hess_norm_sq	theorem	Poincare.D11.BochnerManifold.D7Bridge	∀ {u : ℝ → ℝ} {r κ : ℝ} (n : ℕ) (hκ : 0 ≤ κ) (hu2 : Differentiable ℝ (deriv u))
  (hu3 : DifferentiableAt ℝ (deriv (deriv u)) r) (hne : Poincare.D10.jacobiSol κ r ≠ 0)
  (hlap : deriv (Poincare.D11.BochnerManifold.modelLap n κ u) r = 0),
