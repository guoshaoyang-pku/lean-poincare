D13TYPE	Poincare.D11.BochnerManifold.modelRicciTerm.eq_1	theorem	Poincare.D11.BochnerManifold.ModelSpace	∀ (n : ℕ) (κ : ℝ) (u : ℝ → ℝ) (r : ℝ), Poincare.D11.BochnerManifold.modelRicciTerm n κ u r = ↑n * κ * deriv u r ^ 2
D13TYPE	Poincare.D11.BochnerManifold.modelRicciTerm_eq	theorem	Poincare.D11.BochnerManifold.ModelSpace	∀ (n : ℕ) {κ : ℝ} (u : ℝ → ℝ) (r : ℝ),
