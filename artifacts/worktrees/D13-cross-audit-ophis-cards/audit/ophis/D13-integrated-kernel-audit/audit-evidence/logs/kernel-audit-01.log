D13TYPE	Poincare.D12.ConnectionCurvature.formOf._proof_4	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaForm	∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι]
  (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X₁ X₂ Y₁ Y₂ : ι → ℝ),
