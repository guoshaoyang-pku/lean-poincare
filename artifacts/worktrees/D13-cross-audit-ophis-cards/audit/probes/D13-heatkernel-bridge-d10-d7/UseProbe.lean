/-
Independent reverse-use probe for D13-heatkernel-bridge-d10-d7 (generated by gen_useprobe.py).
Reports direct users of each constructor in the elaborated environment and whether
each declared downstream pair mentions the constructor in type and/or value.
-/
import Poincare.D7.HeatKernel.V1Interface
import Poincare.D7.HeatKernel.StatementStatus
import Poincare.D7.HeatKernel.RepairStatus
import Poincare.D7.HeatKernel.DataStatus
import Poincare.D7.HeatKernel.FiniteStatus
import Poincare.D7.HeatKernel.UniquenessStatus
import Lean.Util.CollectAxioms

open Lean Elab Command

namespace D13XUse_D13_heatkernel_bridge_d10_d7

def constructors : List Name := [
  "Poincare.D13.HeatKernelBridge.exists_v1_iff_exists_legacy".toName,
  "Poincare.D13.HeatKernelBridge.HeatKernelDataV1".toName,
  "Poincare.D7.HeatKernel.heatKernelExistenceStatement_iff_v1".toName,
  "Poincare.D7.HeatKernel.not_heatKernelExistenceStatementV1".toName,
  "Poincare.D7.HeatKernel.data_level_target_refuted".toName]

def pairs : List (Name × Name) := [
  ("Poincare.D13.HeatKernelBridge.exists_v1_iff_exists_legacy".toName, "Poincare.D7.HeatKernel.heatKernelExistenceStatement_iff_v1".toName),
  ("Poincare.D7.HeatKernel.heatKernelExistenceStatement_iff_v1".toName, "Poincare.D7.HeatKernel.not_heatKernelExistenceStatementV1".toName),
  ("Poincare.D13.HeatKernelBridge.HeatKernelDataV1".toName, "Poincare.D7.HeatKernel.heatKernelExistenceStatement_iff_v1".toName)]

end D13XUse_D13_heatkernel_bridge_d10_d7

open D13XUse_D13_heatkernel_bridge_d10_d7 in
run_cmd do
  let env ← getEnv
  let mods := env.header.moduleNames
  let mut rows : Array (Name × Name × Bool × Bool) := #[]
  for (ctor, down) in pairs do
    let inType := match env.find? down with
      | some ci => ci.type.getUsedConstants.contains ctor
      | none => false
    let inValue := match env.find? down with
      | some ci => (match ci.value? true with
          | some v => v.getUsedConstants.contains ctor
          | none => false)
      | none => false
    rows := rows.push (ctor, down, inType, inValue)
  -- reverse direct-use census: declarations whose type or value mentions the constructor
  let scanPrefixes : List Name := ["Poincare.D13.HeatKernelBridge".toName,
    "Poincare.D7.HeatKernel".toName,
    "Poincare.D7.ConjugateHeat".toName]
  let inScan (n : Name) : Bool :=
    match env.getModuleIdxFor? n with
    | some midx =>
        let m := mods.getD midx .anonymous
        scanPrefixes.isEmpty || scanPrefixes.any (fun r => r.isPrefixOf m)
    | none => scanPrefixes.isEmpty
  let decls := env.constants.fold (fun acc n _ => if inScan n then acc.push n else acc) #[]
  for ctor in constructors do
    IO.println s!"D13XEXISTS	{ctor}	{(env.find? ctor).isSome}"
    let mut direct : Array Name := #[]
    for d in decls do
      if d == ctor then continue
      match env.find? d with
      | some ci =>
          let inT := ci.type.getUsedConstants.contains ctor
          let inV := match ci.value? true with
            | some v => v.getUsedConstants.contains ctor
            | none => false
          if inT || inV then direct := direct.push d
      | none => pure ()
    IO.println s!"D13XUSE\t{ctor}\tdirect_users\t{direct.size}"
    for d in direct.qsort (fun a b => a.toString < b.toString) do
      IO.println s!"D13XUSER\t{ctor}\t{d}"
  for (ctor, down, inT, inV) in rows do
    IO.println s!"D13XPAIR\t{ctor}\t{down}\ttype={inT}\tvalue={inV}\tdown_exists={(env.find? down).isSome}"
  IO.println s!"D13XUSE_DONE\tD13-heatkernel-bridge-d10-d7"
