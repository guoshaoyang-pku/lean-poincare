  [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X] (D : Poincare.D13.HeatKernelBridge.HeatKernelDataV1 X),
  D.toConjugateHeatSpacetime.volume = D.volume
@Poincare.D13.HeatKernelBridge.HeatKernelDataV1.toConjugateHeatSpacetime_laplacian : ∀ {X : Type u_1}
  [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X] (D : Poincare.D13.HeatKernelBridge.HeatKernelDataV1 X),
  D.toConjugateHeatSpacetime.laplacian = D.laplacian
