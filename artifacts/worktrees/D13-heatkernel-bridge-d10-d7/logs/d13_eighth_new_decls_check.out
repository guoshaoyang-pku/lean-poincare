        ¬Poincare.D7.ConjugateHeat.IsConjugateHeatKernel (Poincare.D13.HeatKernelBridge.flatConjugateHeatSpacetime n) t₀
            (Poincare.D13.HeatKernelBridge.flatConjugateKernel n t₀)
Poincare.D13.HeatKernelBridge.flatConjugateKernel_symm : ∀ (n : ℕ) (t₀ : ℝ) (x y : EuclideanSpace ℝ (Fin n)) (t : ℝ),
  Poincare.D13.HeatKernelBridge.flatConjugateKernel n t₀ x y t =
    Poincare.D13.HeatKernelBridge.flatConjugateKernel n t₀ y x t
Poincare.D13.HeatKernelBridge.flatConjugateKernel_mass : ∀ (n : ℕ) (t₀ : ℝ) (y : EuclideanSpace ℝ (Fin n)) {t : ℝ},
  t < t₀ →
    ∫ (x : EuclideanSpace ℝ (Fin n)),
        Poincare.D13.HeatKernelBridge.flatConjugateKernel n t₀ x y
          t ∂(Poincare.D13.HeatKernelBridge.flatConjugateHeatSpacetime n).volume =
      1
Poincare.D13.HeatKernelBridge.flatConjugateKernel_mass_eq : ∀ (n : ℕ) (t₀ : ℝ) (y : EuclideanSpace ℝ (Fin n)) {s t : ℝ},
  s < t₀ →
    t < t₀ →
      ∫ (x : EuclideanSpace ℝ (Fin n)),
          Poincare.D13.HeatKernelBridge.flatConjugateKernel n t₀ x y
            s ∂(Poincare.D13.HeatKernelBridge.flatConjugateHeatSpacetime n).volume =
        ∫ (x : EuclideanSpace ℝ (Fin n)),
          Poincare.D13.HeatKernelBridge.flatConjugateKernel n t₀ x y
            t ∂(Poincare.D13.HeatKernelBridge.flatConjugateHeatSpacetime n).volume
Poincare.D13.HeatKernelBridge.flatConjugateKernel_semigroup : ∀ (n : ℕ) (t₀ : ℝ) (x y : EuclideanSpace ℝ (Fin n))
  {s t : ℝ},
  s < t₀ →
    t < t₀ →
      t₀ < s + t →
        s + t < 2 * t₀ →
          Poincare.D13.HeatKernelBridge.flatConjugateKernel n t₀ x y (s + t - t₀) =
            ∫ (z : EuclideanSpace ℝ (Fin n)),
              Poincare.D13.HeatKernelBridge.flatConjugateKernel n t₀ x z s *
                Poincare.D13.HeatKernelBridge.flatConjugateKernel n t₀ z y
                  t ∂(Poincare.D13.HeatKernelBridge.flatConjugateHeatSpacetime n).volume
