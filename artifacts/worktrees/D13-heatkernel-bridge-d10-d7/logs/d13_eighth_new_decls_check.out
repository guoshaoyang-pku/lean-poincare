@Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDE : {M : Type u_1} →
  [inst : TopologicalSpace M] →
    [inst_1 : MeasurableSpace M] →
      (S : Poincare.D7.ConjugateHeat.ConjugateHeatSpacetime M) →
        ℝ → Poincare.D12.HeatDomain.AdmissibleTestClass M S.volume → (M → M → ℝ → ℝ) → Prop
@Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDE.solvesPDE_hasDerivAt : ∀ {M : Type u_1}
  [inst : TopologicalSpace M] [inst_1 : MeasurableSpace M] {S : Poincare.D7.ConjugateHeat.ConjugateHeatSpacetime M}
  {t₀ : ℝ} {C : Poincare.D12.HeatDomain.AdmissibleTestClass M S.volume} {K : M → M → ℝ → ℝ},
  Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDE S t₀ C K →
    ∀ (x y : M) {t : ℝ},
      t < t₀ → HasDerivAt (fun s => K x y s) (-S.laplacian (fun z => K z y t) x + S.scalarMul (fun z => K z y t) x) t
