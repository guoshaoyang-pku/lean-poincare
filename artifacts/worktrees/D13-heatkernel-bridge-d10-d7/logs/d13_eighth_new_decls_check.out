  D.toConjugateHeatSpacetime.backwardTimeDerivative = 0
@Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDE.of_dataV1 : ∀ {X : Type u_1} [inst : TopologicalSpace X]
  [inst_1 : MeasurableSpace X] (D : Poincare.D13.HeatKernelBridge.HeatKernelDataV1 X) (t₀ : ℝ)
  (C : Poincare.D12.HeatDomain.AdmissibleTestClass X D.volume),
  (∀ (f : X → ℝ), C.cls f → D.testClass.cls f) →
    (∀ (x y : X) (t : ℝ), 0 < t → 0 < D.kernel x y t) →
      Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDE D.toConjugateHeatSpacetime t₀ C fun x y t =>
        D.kernel x y (t₀ - t)
@Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDE.of_dataV1_integrableClass : ∀ {X : Type u_1}
  [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X] (D : Poincare.D13.HeatKernelBridge.HeatKernelDataV1 X)
  (t₀ : ℝ),
  (∀ (x y : X) (t : ℝ), 0 < t → 0 < D.kernel x y t) →
    D.IsIntegrableClassVariant →
      Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDE D.toConjugateHeatSpacetime t₀
        (Poincare.D12.HeatDomain.AdmissibleTestClass.continuousIntegrableClass D.volume) fun x y t =>
        D.kernel x y (t₀ - t)
@Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDE.of_dataV1_ccClass : ∀ {X : Type u_1} [inst : TopologicalSpace X]
  [inst_1 : MeasurableSpace X] [inst_2 : OpensMeasurableSpace X] (D : Poincare.D13.HeatKernelBridge.HeatKernelDataV1 X)
  (t₀ : ℝ),
  (∀ (x y : X) (t : ℝ), 0 < t → 0 < D.kernel x y t) →
    D.IsIntegrableClassVariant →
      ∀ [inst_3 : MeasureTheory.IsFiniteMeasureOnCompacts D.volume],
        Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDE D.toConjugateHeatSpacetime t₀
          (Poincare.D12.HeatDomain.AdmissibleTestClass.continuousCompactSupportClass D.volume) fun x y t =>
          D.kernel x y (t₀ - t)
