  [inst : TopologicalSpace X] →
    [inst_1 : MeasurableSpace X] →
      Poincare.D13.HeatKernelBridge.HeatKernelDataV1 X → Poincare.D7.ConjugateHeat.ConjugateHeatSpacetime X
