  [inst : TopologicalSpace X] [inst_1 : MeasurableSpace X] (D : Poincare.D13.HeatKernelBridge.HeatKernelDataV1 X),
  D.toConjugateHeatSpacetime.scalarMul = 0
@Poincare.D13.HeatKernelBridge.HeatKernelDataV1.toConjugateHeatSpacetime_backwardTimeDerivative : ∀ {X : Type u_1}
