refutingSpacetime : HeatSpacetime PUnit.{u_1 + 1}
refutingSpacetime_volume : refutingSpacetime.volume = Measure.dirac PUnit.unit
refutingSpacetime_laplacian : refutingSpacetime.laplacian = LinearMap.id
refutingSpacetime_laplacian_apply : ∀ (u : PUnit.{u_1 + 1} → ℝ), refutingSpacetime.laplacian u = u
refutingSpacetime_timeDerivative : refutingSpacetime.timeDerivative = 0
refutingSpacetime_timeDerivative_apply : ∀ (u : PUnit.{u_1 + 1} → ℝ), refutingSpacetime.timeDerivative u = 0
refutingSpacetime_heatOperator : ∀ (u : PUnit.{u_1 + 1} → ℝ), refutingSpacetime.heatOperator u = -u
refutingSpacetime_isClosedRiemannianManifold : IsClosedRiemannianManifold refutingSpacetime
subsingleton_measurableSpace_punit : Subsingleton (MeasurableSpace PUnit.{u_1 + 1})
@not_isHeatKernel_of_laplacian_id_timeDerivative_zero : ∀ {M : Type u_1} [inst : TopologicalSpace M]
  [inst_1 : MeasurableSpace M] [Nonempty M] (S : HeatSpacetime M),
  S.laplacian = LinearMap.id → S.timeDerivative = 0 → ∀ (K : M → M → ℝ → ℝ), ¬IsHeatKernel S K
@not_isHeatKernelV1_of_laplacian_id_timeDerivative_zero : ∀ {M : Type u_1} [inst : TopologicalSpace M]
  [inst_1 : MeasurableSpace M] [Nonempty M] (S : HeatSpacetime M),
  S.laplacian = LinearMap.id →
    S.timeDerivative = 0 →
      ∀ (C : Poincare.D12.HeatDomain.AdmissibleTestClass M S.volume) (K : M → M → ℝ → ℝ), ¬IsHeatKernelV1 S C K
@not_heatKernelExistenceStatement_of_refuting : ∀ {M : Type u_1} [inst : TopologicalSpace M]
  [inst_1 : MeasurableSpace M] [BorelSpace M] [Nonempty M] (S : HeatSpacetime M),
  IsClosedRiemannianManifold S → S.laplacian = LinearMap.id → S.timeDerivative = 0 → ¬HeatKernelExistenceStatement
@not_heatKernelExistenceStatementV1_of_refuting : ∀ {M : Type u_1} [inst : TopologicalSpace M]
  [inst_1 : MeasurableSpace M] [BorelSpace M] [Nonempty M] (S : HeatSpacetime M),
  IsClosedRiemannianManifold S → S.laplacian = LinearMap.id → S.timeDerivative = 0 → ¬HeatKernelExistenceStatementV1
not_heatKernelExistenceStatement : ¬HeatKernelExistenceStatement
Poincare.D13.HeatKernelBridge.not_heatKernelExistenceStatementV1 : ¬HeatKernelExistenceStatementV1
not_heatKernelExistenceStatementV1_of_legacy_refutation : ¬HeatKernelExistenceStatement →
  ¬HeatKernelExistenceStatementV1
Poincare.D7.HeatKernel.not_heatKernelExistenceStatementV1 : ¬HeatKernelExistenceStatementV1
def Poincare.D7.HeatKernel.HeatKernelExistenceStatement.{u_1} : Prop :=
∀ (M : Type u_1) [inst : TopologicalSpace M] [inst_1 : MeasurableSpace M] [BorelSpace M] (S : HeatSpacetime M),
  IsClosedRiemannianManifold S → ∀ (y₀ : M), ∃ K, IsHeatKernel S K
def Poincare.D7.HeatKernel.HeatKernelExistenceStatementV1.{u_1} : Prop :=
∀ (M : Type u_1) [inst : TopologicalSpace M] [inst_1 : MeasurableSpace M] [BorelSpace M] (S : HeatSpacetime M),
  IsClosedRiemannianManifold S →
    ∀ (y₀ : M), ∃ K, IsHeatKernelV1 S (Poincare.D12.HeatDomain.AdmissibleTestClass.continuousIntegrableClass S.volume) K
