Poincare.D13.HeatKernelBridge.rpow_neg_half_le_of_le : ∀ (n : ℕ) {a t : ℝ},
  0 < a → a ≤ t → (4 * Real.pi * t) ^ (-↑n / 2) ≤ (4 * Real.pi * a) ^ (-↑n / 2)
Poincare.D13.HeatKernelBridge.mul_exp_neg_le_inv_e : ∀ (u : ℝ), 0 ≤ u → u * Real.exp (-u) ≤ Real.exp (-1)
Poincare.D13.HeatKernelBridge.gaussianKernel_le_prefactor : ∀ (n : ℕ) (z : EuclideanSpace ℝ (Fin n)) {t : ℝ},
  0 < t → Poincare.D10.HeatKernelEuclidean.gaussianKernel n t z ≤ (4 * Real.pi * t) ^ (-↑n / 2)
Poincare.D13.HeatKernelBridge.gaussianKernel_abs_le_prefactor : ∀ (n : ℕ) (z : EuclideanSpace ℝ (Fin n)) {t : ℝ},
  0 < t → |Poincare.D10.HeatKernelEuclidean.gaussianKernel n t z| ≤ (4 * Real.pi * t) ^ (-↑n / 2)
Poincare.D13.HeatKernelBridge.flatKernel_abs_le_prefactor : ∀ (n : ℕ) (x y : EuclideanSpace ℝ (Fin n)) {t : ℝ},
  0 < t → |Poincare.D11.HeatKernelBridge.flatKernel n x y t| ≤ (4 * Real.pi * t) ^ (-↑n / 2)
Poincare.D13.HeatKernelBridge.flatLaplacianBound : ℕ → ℝ → ℝ
Poincare.D13.HeatKernelBridge.flatHeatSpacetime_laplacian_apply : ∀ (n : ℕ) (y : EuclideanSpace ℝ (Fin n)) {t : ℝ},
  0 < t →
    ∀ (x : EuclideanSpace ℝ (Fin n)),
      (Poincare.D13.HeatKernelBridge.flatHeatSpacetime n).laplacian
          (fun z => Poincare.D11.HeatKernelBridge.flatKernel n z y t) x =
        Poincare.D10.HeatKernelEuclidean.gaussianKernel n t (x - y) * (‖x - y‖ ^ 2 / (4 * t ^ 2) - ↑n / (2 * t))
Poincare.D13.HeatKernelBridge.flatKernel_continuous_snapshot : ∀ (n : ℕ) (y : EuclideanSpace ℝ (Fin n)) {t : ℝ},
  0 < t → Continuous fun x => Poincare.D11.HeatKernelBridge.flatKernel n x y t
