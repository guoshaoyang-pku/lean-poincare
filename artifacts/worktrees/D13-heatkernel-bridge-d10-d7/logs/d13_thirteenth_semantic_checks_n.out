Poincare.D13.HeatKernelBridge.gaussianKernel_mul_sq_div_le : ∀ (n : ℕ) {t : ℝ},
  0 < t →
    ∀ (z : EuclideanSpace ℝ (Fin n)),
      Poincare.D10.HeatKernelEuclidean.gaussianKernel n t z * (‖z‖ ^ 2 / (4 * t ^ 2)) ≤
        (4 * Real.pi * t) ^ (-↑n / 2) * (1 / (Real.exp 1 * t))
Poincare.D13.HeatKernelBridge.flatKernel_laplacian_abs_le : ∀ (n : ℕ) (y : EuclideanSpace ℝ (Fin n)) {a b t : ℝ},
  0 < a →
    t ∈ Set.Icc a b →
      ∀ (x : EuclideanSpace ℝ (Fin n)),
        |(Poincare.D13.HeatKernelBridge.flatHeatSpacetime n).laplacian
              (fun z => Poincare.D11.HeatKernelBridge.flatKernel n z y t) x| ≤
          Poincare.D13.HeatKernelBridge.flatLaplacianBound n a
