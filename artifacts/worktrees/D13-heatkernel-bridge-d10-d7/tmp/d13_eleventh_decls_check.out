        Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDEMassLaw
            (Poincare.D13.HeatKernelBridge.finiteConjugateSpacetimeWith G R) t₀
            (Poincare.D12.HeatDomain.AdmissibleTestClass.continuousIntegrableClass MeasureTheory.Measure.count) K →
          ∀ (z y : X), ∀ t < t₀, K z y t = Poincare.D13.HeatKernelBridge.finiteConjKernelWith G R t₀ z y t) ∧
      (∃! K,
          (∀ (x y : X) (t : ℝ), t₀ ≤ t → K x y t = 0) ∧
            (∀ (x y : X),
                ∀ t < t₀, HasDerivAt (fun s => K x y s) (-G.laplacian (fun z => K z y t) x + R x * K x y t) t) ∧
              ∀ (z y : X),
                Filter.Tendsto (fun t => K z y t) (nhdsWithin t₀ (Set.Iio t₀)) (nhds (if z = y then 1 else 0))) ∧
        ((∀ (x : X), 0 ≤ R x) →
          (∃ x, 0 < R x) →
            ¬∃ K,
                Poincare.D13.HeatKernelBridge.IsConjugateHeatKernelPDE
                  (Poincare.D13.HeatKernelBridge.finiteConjugateSpacetimeWith G R) t₀
                  (Poincare.D12.HeatDomain.AdmissibleTestClass.continuousIntegrableClass MeasureTheory.Measure.count) K)
