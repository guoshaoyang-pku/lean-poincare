  [Fintype X] → [DecidableEq X] → Matrix X X ℝ →ₗ[ℝ] X → ℝ
@Poincare.D13.HeatKernelBridge.mulVecOnesCLM : {X : Type u_1} → [Fintype X] → [DecidableEq X] → Matrix X X ℝ →L[ℝ] X → ℝ
