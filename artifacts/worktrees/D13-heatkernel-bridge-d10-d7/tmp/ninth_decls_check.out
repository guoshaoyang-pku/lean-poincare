  [inst : Fintype X] → [inst_1 : DecidableEq X] → Poincare.D13.HeatKernelBridge.FiniteHeatOperator X → ℝ
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.shifted : {X : Type u_1} →
  [inst : Fintype X] → [inst_1 : DecidableEq X] → Poincare.D13.HeatKernelBridge.FiniteHeatOperator X → Matrix X X ℝ
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.shift_pos : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X), 0 < G.shift
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.shifted_apply_self : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (x : X),
  G.shifted x x = G.L x x + G.shift
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.shifted_apply_of_ne : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {x y : X},
  x ≠ y → G.shifted x y = G.L x y
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.shifted_pos : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (x y : X), 0 < G.shifted x y
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.shifted_nonneg : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (x y : X), 0 ≤ G.shifted x y
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.pow_apply_nonneg : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] {M : Matrix X X ℝ}, (∀ (x y : X), 0 ≤ M x y) → ∀ (n : ℕ) (x y : X), 0 ≤ (M ^ n) x y
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_smul_eq : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (t : ℝ),
  NormedSpace.exp (t • G.L) = NormedSpace.exp (-(t * G.shift)) • NormedSpace.exp (t • G.shifted)
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_neg_mul_shift_pos : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (t : ℝ),
  0 < NormedSpace.exp (-(t * G.shift))
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_shifted_nonneg : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 ≤ t → ∀ (x y : X), 0 ≤ NormedSpace.exp (t • G.shifted) x y
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_shifted_pos : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 < t → ∀ (x y : X), 0 < NormedSpace.exp (t • G.shifted) x y
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.kernel_pos : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 < t → ∀ (x y : X), 0 < NormedSpace.exp (t • G.L) x y
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.kernel_nonneg_of_nonneg : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 ≤ t → ∀ (x y : X), 0 ≤ NormedSpace.exp (t • G.L) x y
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_smul_symm : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (t : ℝ) (x y : X),
  NormedSpace.exp (t • G.L) x y = NormedSpace.exp (t • G.L) y x
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_smul_mulVec_ones : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (t : ℝ),
  (NormedSpace.exp (t • G.L)).mulVec 1 = 1
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_smul_row_sum : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (t : ℝ) (x : X),
  ∑ y, NormedSpace.exp (t • G.L) x y = 1
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_smul_column_sum : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (t : ℝ) (y : X),
  ∑ x, NormedSpace.exp (t • G.L) x y = 1
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_smul_mulVec_sum : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (t : ℝ) (u : X → ℝ),
  ∑ x, (NormedSpace.exp (t • G.L)).mulVec u x = ∑ x, u x
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_smul_mulVec_nonneg : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 ≤ t → ∀ {u : X → ℝ}, (∀ (x : X), 0 ≤ u x) → ∀ (x : X), 0 ≤ (NormedSpace.exp (t • G.L)).mulVec u x
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_smul_mulVec_abs_sum_le : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 ≤ t → ∀ (u : X → ℝ), ∑ x, |(NormedSpace.exp (t • G.L)).mulVec u x| ≤ ∑ x, |u x|
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_smul_le_one : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 < t → ∀ (x y : X), NormedSpace.exp (t • G.L) x y ≤ 1
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.exp_smul_add : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (s t : ℝ),
