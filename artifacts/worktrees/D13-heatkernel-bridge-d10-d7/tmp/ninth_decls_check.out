@Poincare.D13.HeatKernelBridge.finiteHeatSpacetime_isClosedRiemannian : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] [inst_2 : TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
