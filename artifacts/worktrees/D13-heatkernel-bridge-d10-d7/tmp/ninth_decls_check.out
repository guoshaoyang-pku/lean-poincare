  Poincare.D13.HeatKernelBridge.IsHeatKernelPDE (Poincare.D13.HeatKernelBridge.finiteHeatSpacetime G)
    (Poincare.D12.HeatDomain.AdmissibleTestClass.continuousIntegrableClass MeasureTheory.Measure.count)
    (Poincare.D13.HeatKernelBridge.finiteHeatKernel G)
Poincare.D13.HeatKernelBridge.FinitePinnedHeatExistenceStatement : Prop
Poincare.D13.HeatKernelBridge.finitePinnedHeatExistenceStatement_proved : Poincare.D13.HeatKernelBridge.FinitePinnedHeatExistenceStatement
@Poincare.D13.HeatKernelBridge.finiteHeatKernel_ne_dirac : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {x y : X},
  x ≠ y → Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y 1 ≠ if x = y then 1 else 0
@Poincare.D13.HeatKernelBridge.finite_pinned_scope : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [inst_2 : TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X),
  (∃ x y, x ≠ y) →
    (∃ K,
        Poincare.D13.HeatKernelBridge.IsHeatKernelPDE (Poincare.D13.HeatKernelBridge.finiteHeatSpacetime G)
          (Poincare.D12.HeatDomain.AdmissibleTestClass.continuousIntegrableClass MeasureTheory.Measure.count) K) ∧
      (∀ (x y : X) (t : ℝ), 0 < t → 0 < Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y t) ∧
        (∃ x y, x ≠ y ∧ Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y 1 ≠ 0) ∧
          G.laplacian ≠ 0 ∧ (G.laplacian fun x => 1) = 0
