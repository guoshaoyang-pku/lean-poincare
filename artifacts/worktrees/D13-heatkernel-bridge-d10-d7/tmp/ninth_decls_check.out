  ¬0 < t → ∀ (x y : X), Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y t = 0
@Poincare.D13.HeatKernelBridge.finiteHeatKernel_nonneg : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (x y : X) (t : ℝ),
  0 ≤ Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y t
@Poincare.D13.HeatKernelBridge.finiteHeatKernel_pos : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 < t → ∀ (x y : X), 0 < Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y t
@Poincare.D13.HeatKernelBridge.finiteHeatKernel_symm : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (x y : X) (t : ℝ),
  Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y t = Poincare.D13.HeatKernelBridge.finiteHeatKernel G y x t
@Poincare.D13.HeatKernelBridge.finiteHeatKernel_le_one : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 < t → ∀ (x y : X), Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y t ≤ 1
@Poincare.D13.HeatKernelBridge.finiteHeatKernel_row_sum : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 < t → ∀ (x : X), ∑ y, Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y t = 1
@Poincare.D13.HeatKernelBridge.finiteHeatKernel_normalization : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 < t → ∀ (x : X), ∫ (y : X), Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y t ∂MeasureTheory.Measure.count = 1
@Poincare.D13.HeatKernelBridge.finiteHeatKernel_semigroup : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {s t : ℝ},
  0 < s →
    0 < t →
      ∀ (x y : X),
        Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y (s + t) =
          ∫ (z : X),
            Poincare.D13.HeatKernelBridge.finiteHeatKernel G x z s *
              Poincare.D13.HeatKernelBridge.finiteHeatKernel G z y t ∂MeasureTheory.Measure.count
@Poincare.D13.HeatKernelBridge.finiteHeatKernel_hasDerivAt : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (x y : X) {t : ℝ},
  0 < t →
    HasDerivAt (fun s => Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y s)
      (G.laplacian (fun z => Poincare.D13.HeatKernelBridge.finiteHeatKernel G z y t) x) t
@Poincare.D13.HeatKernelBridge.finiteHeatKernel_dirac : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (x : X) (f : X → ℝ),
  Filter.Tendsto
    (fun t => ∫ (y : X), Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y t * f y ∂MeasureTheory.Measure.count)
    (nhdsWithin 0 (Set.Ioi 0)) (nhds (f x))
