Poincare.D13.HeatKernelBridge.FiniteHeatOperator : (X : Type u_1) → [Fintype X] → [DecidableEq X] → Type u_1
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.laplacian : {X : Type u_1} →
  [inst : Fintype X] →
    [inst_1 : DecidableEq X] → Poincare.D13.HeatKernelBridge.FiniteHeatOperator X → (X → ℝ) →ₗ[ℝ] X → ℝ
