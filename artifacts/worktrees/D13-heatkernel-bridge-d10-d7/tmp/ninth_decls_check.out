  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X), G.L.mulVec 1 = 0
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.laplacian_one : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X), (G.laplacian fun x => 1) = 0
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.symmetric_apply : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (x y : X), G.L y x = G.L x y
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.diag_nonpos : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (x : X), G.L x x ≤ 0
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.laplacian_selfAdjoint : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (u v : X → ℝ),
  ∑ x, u x * G.laplacian v x = ∑ x, G.laplacian u x * v x
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.laplacian_dirichlet_identity : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (u : X → ℝ),
  ∑ x, u x * G.laplacian u x = -(1 / 2) * ∑ x, ∑ y, G.L x y * (u x - u y) ^ 2
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.laplacian_dirichlet_nonneg : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (u : X → ℝ),
  0 ≤ ∑ x, ∑ y, G.L x y * (u x - u y) ^ 2
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.laplacian_quadraticForm_nonpos : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (u : X → ℝ),
  ∑ x, u x * G.laplacian u x ≤ 0
@Poincare.D13.HeatKernelBridge.FiniteHeatOperator.laplacian_ne_zero : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X), (∃ x y, x ≠ y) → G.laplacian ≠ 0
