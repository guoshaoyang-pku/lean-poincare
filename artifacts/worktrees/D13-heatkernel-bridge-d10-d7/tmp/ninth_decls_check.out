  [Fintype X] → [DecidableEq X] → X → X → Matrix X X ℝ →ₗ[ℝ] ℝ
@Poincare.D13.HeatKernelBridge.entryCLM : {X : Type u_1} → [Fintype X] → [DecidableEq X] → X → X → Matrix X X ℝ →L[ℝ] ℝ
