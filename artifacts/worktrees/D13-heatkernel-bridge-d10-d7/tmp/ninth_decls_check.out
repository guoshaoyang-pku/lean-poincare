  [inst_1 : DecidableEq X] [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X],
  (∃ x y, x ≠ y) → (Poincare.D13.HeatKernelBridge.completeGraphOperator X).laplacian ≠ 0
@Poincare.D7.HeatKernel.finite_pinned_kernel_exists : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [inst_2 : TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X),
  ∃ K,
    Poincare.D13.HeatKernelBridge.IsHeatKernelPDE (Poincare.D13.HeatKernelBridge.finiteHeatSpacetime G)
      (Poincare.D12.HeatDomain.AdmissibleTestClass.continuousIntegrableClass MeasureTheory.Measure.count) K
@Poincare.D7.HeatKernel.finite_pinned_operator_structure : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X),
  (∃ x y, x ≠ y) → G.laplacian ≠ 0 ∧ (G.laplacian fun x => 1) = 0
@Poincare.D7.HeatKernel.finite_pinned_legacy_datum : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [inst_2 : TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X),
  ∃ D,
    D.kernel = Poincare.D13.HeatKernelBridge.finiteHeatKernel G ∧
      D.laplacian = G.laplacian ∧ D.volume = MeasureTheory.Measure.count
@Poincare.D7.HeatKernel.finite_pinned_dataV1 : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [inst_2 : TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X),
  ∃ D, D.kernel = Poincare.D13.HeatKernelBridge.finiteHeatKernel G
@Poincare.D7.HeatKernel.finite_pinned_operator_dissipative : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) (u : X → ℝ),
  ∑ x, u x * G.laplacian u x ≤ 0 ∧ 0 ≤ ∑ x, ∑ y, G.L x y * (u x - u y) ^ 2
@Poincare.D7.HeatKernel.finite_pinned_max_principle : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {t : ℝ},
  0 ≤ t →
    ∀ {u : X → ℝ},
      (∀ (x : X), 0 ≤ u x) →
        (∀ (x : X), 0 ≤ (NormedSpace.exp (t • G.L)).mulVec u x) ∧
          ∑ x, (NormedSpace.exp (t • G.L)).mulVec u x = ∑ x, u x ∧
            ∑ x, |(NormedSpace.exp (t • G.L)).mulVec u x| ≤ ∑ x, |u x|
@Poincare.D7.HeatKernel.finite_pinned_spacetime_closed : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [inst_2 : TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X),
  Poincare.D7.HeatKernel.IsClosedRiemannianManifold (Poincare.D13.HeatKernelBridge.finiteHeatSpacetime G)
@Poincare.D7.HeatKernel.finite_pinned_kernel_nondegenerate : ∀ {X : Type u_1} [inst : Fintype X]
  [inst_1 : DecidableEq X] [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X) {x y : X},
  x ≠ y →
    0 < Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y 1 ∧
      Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y 1 ≠ 0
@Poincare.D7.HeatKernel.finite_heat_status_summary : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [inst_2 : TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
  (G : Poincare.D13.HeatKernelBridge.FiniteHeatOperator X),
  (∃ x y, x ≠ y) →
    (∃ K,
        Poincare.D13.HeatKernelBridge.IsHeatKernelPDE (Poincare.D13.HeatKernelBridge.finiteHeatSpacetime G)
          (Poincare.D12.HeatDomain.AdmissibleTestClass.continuousIntegrableClass MeasureTheory.Measure.count) K) ∧
      (∀ (x y : X) (t : ℝ), 0 < t → 0 < Poincare.D13.HeatKernelBridge.finiteHeatKernel G x y t) ∧
        G.laplacian ≠ 0 ∧
          (G.laplacian fun x => 1) = 0 ∧
            Poincare.D7.HeatKernel.IsClosedRiemannianManifold (Poincare.D13.HeatKernelBridge.finiteHeatSpacetime G)
