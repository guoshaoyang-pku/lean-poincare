@Poincare.D13.HeatKernelBridge.finiteHeatKernel_of_nonpos : ∀ {X : Type u_1} [inst : Fintype X] [inst_1 : DecidableEq X]
  [TopologicalSpace X] [inst_3 : MeasurableSpace X] [MeasurableSingletonClass X]
