            Filter.Tendsto (fun p => heatSolution n g p.1 p.2) (nhds x₀ ×ˢ nhdsWithin 0 (Set.Ioi 0)) (nhds (g x₀))
info: D13Probes/HeatProbe.lean:34:0: @exists_parabolicBoundary_isMaxOn : ∀ {n : ℕ} {U : Set (EuclideanSpace ℝ (Fin n))} {T : ℝ} {u : SpaceTime n → ℝ},
  IsOpen U →
    Bornology.IsBounded U →
      U.Nonempty →
        0 < T →
          ContinuousOn u (closure (parabolicCylinder U T)) →
            (∀ (p : SpaceTime n), spacePart p ∈ U → p.ofLp 0 ∈ Set.Ioo 0 T → ContDiffAt ℝ 2 u p) →
              (∀ (p : SpaceTime n),
                  spacePart p ∈ U → p.ofLp 0 ∈ Set.Ioo 0 T → partialDeriv 0 u p = ∑ j, (partialDeriv j.succ)^[2] u p) →
                ∃ z ∈ parabolicBoundary U T, ∀ p ∈ closure (parabolicCylinder U T), u p ≤ u z
info: D13Probes/HeatProbe.lean:35:0: @heat_cauchy_maxPrinciple_smallTime : ∀ {n : ℕ} {u : SpaceTime n → ℝ} {T A a : ℝ},
  0 < T →
    0 < a →
      0 < A →
        4 * a * T < 1 →
          Continuous u →
            (∀ (p : SpaceTime n), p.ofLp 0 ∈ Set.Ioo 0 T → ContDiffAt ℝ 2 u p) →
              (∀ (p : SpaceTime n), p.ofLp 0 ∈ Set.Ioo 0 T → partialDeriv 0 u p = ∑ j, (partialDeriv j.succ)^[2] u p) →
                (∀ (p : SpaceTime n), p.ofLp 0 ∈ Set.Icc 0 T → u p ≤ A * Real.exp (a * ‖spacePart p‖ ^ 2)) →
                  ∀ {M : ℝ},
                    (∀ (x : EuclideanSpace ℝ (Fin n)), u (toSpaceTime 0 x) ≤ M) →
                      ∀ (p : SpaceTime n), p.ofLp 0 ∈ Set.Icc 0 T → u p ≤ M
info: D13Probes/HeatProbe.lean:36:0: @heat_cauchy_uniqueness_smallTime : ∀ {n : ℕ} {u v : SpaceTime n → ℝ} {T A a : ℝ},
  0 < T →
    0 < a →
      0 < A →
        4 * a * T < 1 →
          Continuous u →
            Continuous v →
              (∀ (p : SpaceTime n), p.ofLp 0 ∈ Set.Ioo 0 T → ContDiffAt ℝ 2 u p) →
                (∀ (p : SpaceTime n), p.ofLp 0 ∈ Set.Ioo 0 T → ContDiffAt ℝ 2 v p) →
                  (∀ (p : SpaceTime n),
                      p.ofLp 0 ∈ Set.Ioo 0 T →
                        partialDeriv 0 (fun q => u q - v q) p = ∑ j, (partialDeriv j.succ)^[2] (fun q => u q - v q) p) →
                    (∀ (x : EuclideanSpace ℝ (Fin n)), u (toSpaceTime 0 x) = v (toSpaceTime 0 x)) →
                      (∀ (p : SpaceTime n), p.ofLp 0 ∈ Set.Icc 0 T → |u p| ≤ A * Real.exp (a * ‖spacePart p‖ ^ 2)) →
                        (∀ (p : SpaceTime n), p.ofLp 0 ∈ Set.Icc 0 T → |v p| ≤ A * Real.exp (a * ‖spacePart p‖ ^ 2)) →
                          ∀ (p : SpaceTime n), p.ofLp 0 ∈ Set.Icc 0 T → u p = v p
