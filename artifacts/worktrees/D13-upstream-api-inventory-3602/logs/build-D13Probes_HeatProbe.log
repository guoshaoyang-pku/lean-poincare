            0 < t →
              ∀ (x : EuclideanSpace ℝ (Fin n)),
                deriv (fun s => heatSolution n g x s) t =
                  ∑ j, iteratedDeriv 2 (fun s => heatSolution n g (x + s • EuclideanSpace.single j 1) t) 0) ∧
