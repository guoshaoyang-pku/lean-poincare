      ],
      "next_tasks": ["D3-surgery-ledger"]
    },
    {
      "id": "P-LONG",
      "name": "Long-time behavior: thick-thin decomposition and hyperbolic limits",
      "source": "Perelman 2003, Section 2; Morgan-Tian, Part III",
      "lean_interface": "not yet represented",
      "depends_on": ["P-CANON", "P-NLC"],
      "status": "planned",
      "blockers": [
        "needs collapsing theory, hyperbolic 3-manifold geometry and a compactness argument"
      ],
      "next_tasks": ["D3-surgery-ledger"]
    },
    {
      "id": "P-SURG",
      "name": "Ricci flow with surgery",
      "source": "Perelman 2003, Section 4; Morgan-Tian, Chapters 13-18",
      "lean_interface": "not yet represented",
      "depends_on": ["P-CANON", "P-LONG"],
      "status": "planned",
      "blockers": [
        "requires the surgery algorithm, canonical neighborhood input, a priori curvature estimates, and a discrete flow construction"
      ],
      "next_tasks": ["D3-surgery-ledger"]
    },
    {
      "id": "P-EXT",
      "name": "Finite extinction for simply connected 3-manifolds and the Poincare conclusion",
      "source": "Perelman 2003, Sections 3-4; Morgan-Tian, Chapters 18-19",
      "lean_interface": "not yet represented",
      "depends_on": ["P-SURG"],
      "status": "planned",
      "blockers": [
        "needs the topological classification of 3-manifolds produced by the surgery decomposition",
        "the topological conclusion is out of scope for the D1 interface layer"
      ],
      "next_tasks": ["D3-surgery-ledger", "D6-weekly-release"]
    }
  ],
  "blockers_summary": [
    "mathlib v4.34.0-rc2 has no Ricci or Riemann curvature tensor, no scalar curvature, and no Riemannian volume form; all three are carried as data with explicit hypotheses",
    "no smooth manifold of Riemannian metrics or short-time existence theorem for the Ricci flow is available",
    "no backward/conjugate heat equation, heat kernel, or integration-by-parts infrastructure on manifolds",
    "no reduced length/reduced volume, no Gromov-Hausdorff compactness, no canonical-neighborhood or surgery machinery",
    "the F and W monotonicity theorems and kappa-noncollapsing are therefore recorded as hypothesis structures, never as proved theorems"
  ]
}
