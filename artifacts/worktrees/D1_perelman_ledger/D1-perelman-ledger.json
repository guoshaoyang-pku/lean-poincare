  "perelman_steps": [
    {
      "id": "P-F-MONO",
      "name": "F-functional is non-increasing under Ricci flow coupled to the backward heat equation",
      "source": "Perelman 2002, Section 1, Theorem 1.1; Morgan-Tian, Chapter 5",
      "lean_interface": "Perelman.FMonotonicity (hypothesis) over Perelman.FProfile using Perelman.perelmanF",
      "depends_on": ["iface.metric_flow_data", "iface.scalar_curvature_data", "iface.gradient_norm_sq", "iface.perelman_F", "iface.F_profile"],
      "status": "blocked",
      "blockers": [
        "no formal backward heat equation or conjugate heat kernel in mathlib",
        "integration by parts on a Riemannian manifold is not available",
        "integrability and finiteness of perelmanF are not established",
        "the scalar curvature is data satisfying a trace formula rather than the trace of a constructed Ricci tensor"
      ],
      "next_tasks": ["D3-entropy-interface", "D4-evolution-theorem"]
    },
    {
      "id": "P-W-MONO",
      "name": "W-functional is non-increasing under Ricci flow coupled to the conjugate heat equation",
      "source": "Perelman 2002, Section 3, Theorem 1.1; Morgan-Tian, Chapters 5-6",
      "lean_interface": "Perelman.WMonotonicity (hypothesis) over Perelman.WProfile using Perelman.perelmanW",
      "depends_on": ["P-F-MONO", "iface.perelman_W", "iface.has_unit_mass", "iface.W_profile"],
      "status": "blocked",
      "blockers": [
        "all blockers of P-F-MONO",
        "tau-differentiation and the Gaussian normalization (4 pi tau)^{-n/2} require a measure-theoretic change-of-variables argument"
      ],
      "next_tasks": ["D3-entropy-interface"]
    },
    {
      "id": "P-MU-MONO",
      "name": "mu(g, tau) is non-decreasing in tau",
      "source": "Perelman 2002, Section 6; Morgan-Tian, Chapter 6",
      "lean_interface": "Perelman.MuMonotonicity (hypothesis) and Perelman.perelmanMu",
      "depends_on": ["P-W-MONO", "iface.perelman_mu", "iface.has_unit_mass"],
      "status": "blocked",
      "blockers": [
        "attainment of the infimum defining mu is not proved",
        "the admissible class (unit mass) is a predicate without a constructed minimizer"
      ],
      "next_tasks": ["D3-entropy-interface"]
    },
    {
      "id": "P-NLC",
      "name": "No local collapsing theorem (kappa-noncollapsing)",
      "source": "Perelman 2002, Section 4, Theorem 4.1; Morgan-Tian, Chapter 8",
      "lean_interface": "Perelman.KappaNoncollapsing (hypothesis structure)",
      "depends_on": ["P-W-MONO", "P-MU-MONO", "iface.kappa_noncollapsing", "iface.curvature_bounded_on", "iface.volume_form_data"],
      "status": "blocked",
      "blockers": [
        "reduced length and reduced volume are not formalized",
        "the full Riemann curvature tensor norm is not available; only a scalar stand-in is used",
        "comparison-geometry volume estimates for balls are not in mathlib"
      ],
      "next_tasks": ["D3-kappa-ledger"]
    },
    {
      "id": "P-REDUCED-VOL",
      "name": "Reduced length and reduced volume; monotonicity of reduced volume",
      "source": "Perelman 2002, Section 7",
      "lean_interface": "not yet represented; would extend PerelmanDefinitions with an L-length structure",
      "depends_on": ["P-F-MONO", "iface.metric_flow_data"],
      "status": "planned",
      "blockers": [
        "needs path spaces, minimizers of the reduced length functional, and a Jacobian comparison theory"
      ],
      "next_tasks": ["D3-kappa-ledger", "D3-surgery-ledger"]
    },
    {
      "id": "P-HARNACK",
      "name": "Harnack inequality for the conjugate heat equation",
      "source": "Perelman 2002, Section 9",
      "lean_interface": "not yet represented",
      "depends_on": ["P-W-MONO", "P-REDUCED-VOL"],
      "status": "planned",
      "blockers": [
        "requires the conjugate heat kernel and a Li-Yau-type differential Harnack argument"
      ],
      "next_tasks": ["D3-entropy-interface"]
    },
    {
      "id": "P-KAPPA-SOL",
      "name": "Classification of 3D kappa-solutions",
      "source": "Perelman 2003, Section 1; Morgan-Tian, Chapter 9",
      "lean_interface": "not yet represented",
      "depends_on": ["P-NLC"],
      "status": "planned",
      "blockers": [
        "needs the full curvature operator, non-collapsing, and the classification of 3D ancient solutions",
        "mathlib has no Riemann curvature tensor or Ricci flow ancient-solution theory"
      ],
      "next_tasks": ["D3-surgery-ledger"]
    },
    {
      "id": "P-CANON",
      "name": "Canonical neighborhood theorem",
      "source": "Perelman 2003, Section 3; Morgan-Tian, Chapters 12-13",
      "lean_interface": "not yet represented; would use Perelman.KappaNoncollapsing and a pointed-Gromov-Hausdorff structure",
      "depends_on": ["P-KAPPA-SOL", "P-NLC"],
      "status": "planned",
      "blockers": [
        "pointed Gromov-Hausdorff convergence and compactness are not in mathlib",
