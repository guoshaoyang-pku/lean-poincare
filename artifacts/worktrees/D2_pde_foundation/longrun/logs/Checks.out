Poincare.Longrun.PDE.HeatGridEvolution : ℕ → ℝ → Type
@Poincare.Longrun.PDE.HeatGridEvolution.step_eq_convex : ∀ {N : ℕ} {α : ℝ}
  (ev : Poincare.Longrun.PDE.HeatGridEvolution N α) {t i : ℕ},
  0 < i → i < N + 1 → ev.u (t + 1) i = α * ev.u t (i - 1) + (1 - 2 * α) * ev.u t i + α * ev.u t (i + 1)
@Poincare.Longrun.PDE.HeatGridEvolution.le_of_initial_le : ∀ {N : ℕ} {α M : ℝ}
  (ev : Poincare.Longrun.PDE.HeatGridEvolution N α),
  0 ≤ α → α ≤ 1 / 2 → 0 ≤ M → (∀ i ≤ N + 1, ev.u 0 i ≤ M) → ∀ (t i : ℕ), i ≤ N + 1 → ev.u t i ≤ M
@Poincare.Longrun.PDE.HeatGridEvolution.le_sup'_initial : ∀ {N : ℕ} {α : ℝ}
  (ev : Poincare.Longrun.PDE.HeatGridEvolution N α),
  0 ≤ α → α ≤ 1 / 2 → ∀ (t : ℕ) {i : ℕ}, i ≤ N + 1 → ev.u t i ≤ max ((Finset.range (N + 2)).sup' ⋯ fun j => ev.u 0 j) 0
@Poincare.Longrun.PDE.strict_grid_max_principle : ∀ {N : ℕ} (u : ℕ → ℝ),
  (∀ (i : ℕ), 0 < i → i < N → u i < (u (i - 1) + u (i + 1)) / 2) → ∀ (i : ℕ), 0 < i → i < N → u i < max (u 0) (u N)
Poincare.Longrun.PDE.energy : (ℕ → ℝ) → ℕ → ℝ
@Poincare.Longrun.PDE.HeatGridEvolution.energy_nonincreasing : ∀ {N : ℕ} {α : ℝ}
  (ev : Poincare.Longrun.PDE.HeatGridEvolution N α),
  0 ≤ α → α ≤ 1 / 2 → ∀ (t : ℕ), Poincare.Longrun.PDE.energy (ev.u t) N ≤ Poincare.Longrun.PDE.energy (ev.u 0) N
Poincare.Longrun.PDE.ContinuousHeatMaximumPrincipleInterface : (ℝ → ℝ → ℝ) → ℝ → ℝ → ℝ → Prop
Poincare.Longrun.PDE.continuousHeatMaxPrinciple_affine : ∀ (c d a b T : ℝ),
  Poincare.Longrun.PDE.ContinuousHeatMaximumPrincipleInterface (fun x x_1 => c * x + d) a b T
Poincare.Longrun.PDE.continuousHeatMaxPrinciple_quadratic : ∀ (T : ℝ),
  Poincare.Longrun.PDE.ContinuousHeatMaximumPrincipleInterface (fun x t => -x ^ 2 - 2 * t) (-1) 1 T
Poincare.Longrun.PDE.continuousHeatHypotheses_quadratic : ∀ (T : ℝ),
  Poincare.Longrun.PDE.ContinuousHeatHypotheses (fun x t => -x ^ 2 - 2 * t) (-1) 1 T
