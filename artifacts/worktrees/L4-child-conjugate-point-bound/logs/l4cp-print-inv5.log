      Eq.mpr (id (congrArg (fun _a => _a) (propext mem_nhdsWithin_iff_eventually)))
        (Filter.mp_mem (IsOpen.mem_nhds isOpen_Ioi hxpos)
          (Filter.univ_mem' (id fun t ht htx => ⟨le_of_lt ht, le_trans (LT.lt.le htx) hxT⟩)));
    have htend_u :=
      ContinuousWithinAt.tendsto
        (ContinuousWithinAt.mono_of_mem_nhdsWithin (h.continuousOn_u (Real.pi / √K) hxmem) hmem);
    have htend_j :=
      Filter.Tendsto.mono_left (ContinuousAt.tendsto (Continuous.continuousAt (Poincare.D10.continuous_jacobiSol K)))
        nhdsWithin_le_nhds;
    have hev := Filter.mp_mem (Ioo_mem_nhdsLT hxpos) (Filter.univ_mem' (id fun t ht => hcompare t ht));
    have hfin := le_of_tendsto_of_tendsto htend_u htend_j hev;
    absurd
      (Eq.mp (congrArg (fun _a => u (Real.pi / √K) ≤ _a) (Poincare.D10.jacobiSolSphere_firstZero hK))
        (Eq.mp (congrArg (fun _a => u (Real.pi / √K) ≤ _a) (Poincare.D10.jacobiSol_of_pos hK (Real.pi / √K))) hfin))
      (not_le.mpr (hpos (Real.pi / √K) ⟨hxpos, hxT⟩))
