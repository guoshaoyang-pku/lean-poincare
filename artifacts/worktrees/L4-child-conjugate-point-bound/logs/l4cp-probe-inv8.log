@conjugate_point_bound : ∀ {k u du ddu : ℝ → ℝ} {T B t₀ K : ℝ},
  0 < T →
    0 ≤ B →
      0 < t₀ →
        t₀ ≤ T →
          B * t₀ ≤ 1 / 2 →
            Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu 0 T →
              ContinuousOn ddu (Icc 0 T) →
                (∀ t ∈ Ioo 0 T, |ddu t| ≤ B) →
                  u 0 = 0 →
                    du 0 = 1 →
                      (∀ t ∈ Ioc 0 T, 0 < u t) →
                        0 < K → (∀ t ∈ Ioo 0 T, K ≤ k t) → K * max (1 / √K) T * t₀ ≤ 1 / 2 → T ≤ Real.pi / √K
