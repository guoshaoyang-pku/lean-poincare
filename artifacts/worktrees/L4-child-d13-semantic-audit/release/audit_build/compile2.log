      Integrable g self.μ →
        ∫ (m : M), g m ∂self.μ =
          ∑ i,
            ∫ (x : D13.ManifoldIBP.Vec (n + 1)),
              g (self.chart i x) * Real.exp (-self.drift i x) * (self.metric i).density x
