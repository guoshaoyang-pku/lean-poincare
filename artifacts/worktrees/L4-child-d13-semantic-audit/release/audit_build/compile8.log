@D13.ManifoldIBP.SmoothOverlapAtlas.globalWeightedIBP_of_cover_partial_ae : ∀ {M : Type u_1} [inst : MeasurableSpace M]
  {n : ℕ} {A : D13.ManifoldIBP.SmoothOverlapAtlas M (n + 1)},
  (∀ (i j : ℕ) (y : Vec (n + 1)), A.chart j y ∈ A.chart i '' A.source i → A.transition i j y ∈ A.source i) →
    ∀ (b : ℕ) {ι : Type u_2} [Fintype ι] (chartOf : ι → ℕ) (f u v Du Guv : M → ℝ),
      Measurable f →
        Measurable v →
          Measurable Du →
            Measurable Guv →
              (∀ (m : M), v m ≠ 0 → m ∈ A.chart b '' A.source b) →
                (∀ (i : ℕ), ContDiff ℝ 2 fun y => f (A.chart i y)) →
                  (∀ (i : ℕ), ContDiff ℝ 2 fun y => u (A.chart i y)) →
                    (∀ (i : ℕ), ContDiff ℝ 2 fun y => v (A.chart i y)) →
                      (HasCompactSupport fun y => v (A.chart b y)) →
                        (tsupport fun y => v (A.chart b y)) ⊆ A.source b →
                          A.chart b '' A.source b ⊆ ⋃ j, A.chart (chartOf j) '' A.source (chartOf j) →
                            (∀ (i : ℕ),
                                ∀ y ∈ A.source i,
                                  Du (A.chart i y) =
                                    (A.metric i).driftLaplacian (fun z => f (A.chart i z)) (fun z => u (A.chart i z))
                                      y) →
                              (∀ (i : ℕ),
                                  ∀ y ∈ A.source i,
                                    Guv (A.chart i y) =
                                      (A.metric i).gradInnerInverse (fun z => u (A.chart i z))
                                        (fun z => v (A.chart i z)) y) →
                                (∀ (m : M), Guv m ≠ 0 → m ∈ A.chart b '' A.source b) →
                                  (∀ (i j : ℕ) (K : Set (Vec (n + 1))),
                                      IsCompact K → IsCompact (A.transition i j ⁻¹' K)) →
                                    (∀ (i : ℕ), volume (frontier (A.source i)) = 0) →
                                      ∫ (m : M), Du m * v m ∂(A.globalMeasure volume).withDensity (A.weight f) =
                                        -∫ (m : M), Guv m ∂(A.globalMeasure volume).withDensity (A.weight f)
@halfSpaceAtlas_weightedIBP_unconditional : ∀ {n : ℕ} (G : ChartMetric (n + 1)) (f u v : Vec (n + 1) → ℝ),
  ContDiff ℝ 2 f →
    ContDiff ℝ 2 u →
      ContDiff ℝ 2 v →
        HasCompactSupport v →
          tsupport v ⊆ {y | y 0 < 1} →
            ∫ (m : Vec (n + 1)),
                G.driftLaplacian f u m * v m ∂((hsAtlas G).globalMeasure volume).withDensity ((hsAtlas G).weight f) =
              -∫ (m : Vec (n + 1)),
                  G.gradInnerInverse u v m ∂((hsAtlas G).globalMeasure volume).withDensity ((hsAtlas G).weight f)
@halfSpaceAtlas_greenIdentity : ∀ {n : ℕ} (G : ChartMetric (n + 1)) (F U V : Vec (n + 1) → ℝ),
  ContDiff ℝ 2 F →
    ContDiff ℝ 2 U →
      ContDiff ℝ 2 V →
        HasCompactSupport U →
          HasCompactSupport V →
            tsupport U ⊆ {y | y 0 < 1} →
              tsupport V ⊆ {y | y 0 < 1} →
                ∫ (m : Vec (n + 1)),
                    G.driftLaplacian F U m *
                      V m ∂((hsAtlas G).globalMeasure volume).withDensity ((hsAtlas G).weight F) =
                  ∫ (m : Vec (n + 1)),
                    U m * G.driftLaplacian F V m ∂((hsAtlas G).globalMeasure volume).withDensity ((hsAtlas G).weight F)
@halfSpaceAtlas_laplacianIntegralZero : ∀ {n : ℕ} (G : ChartMetric (n + 1)) (V : Vec (n + 1) → ℝ),
  ContDiff ℝ 2 V →
    HasCompactSupport V →
      tsupport V ⊆ {y | y 0 < 1} → ∫ (m : Vec (n + 1)), G.laplacian V m ∂(hsAtlas G).globalMeasure volume = 0
@dilationAtlasTwo_weightedIBP_via_pou : ∀ {n : ℕ} (G : ChartMetric (n + 1)) (F U V : Vec (n + 1) → ℝ),
  ContDiff ℝ 2 F →
    ContDiff ℝ 2 U →
      ContDiff ℝ 2 V →
        HasCompactSupport V →
          ∀ {R : ℝ} (ψ : Fin 2 → Vec (n + 1) → ℝ),
            (∀ (i : Fin 2), ContDiff ℝ ∞ (ψ i)) →
              (∀ (i : Fin 2), tsupport (ψ i) ⊆ ball 0 (R + 1)) →
                (∀ x ∈ tsupport V, ∑ i, ψ i x = 1) →
                  (∀ (j : Fin 2),
                      Integrable (fun m => G.driftLaplacian F U m * (dilationAtlasTwoSmooth n G).pouPiece 0 V (ψ j) m)
                        (((dilationAtlasTwoSmooth n G).globalMeasure volume).withDensity
                          ((dilationAtlasTwoSmooth n G).weight F))) →
                    (∀ (j : Fin 2),
                        Integrable (fun m => (dilationAtlasTwoSmooth n G).pouPairing 0 (↑j) U V (ψ j) m)
                          (((dilationAtlasTwoSmooth n G).globalMeasure volume).withDensity
                            ((dilationAtlasTwoSmooth n G).weight F))) →
                      ∫ (m : Vec (n + 1)),
                          G.driftLaplacian F U m *
                            V
                              m ∂((dilationAtlasTwoSmooth n G).globalMeasure volume).withDensity
                            ((dilationAtlasTwoSmooth n G).weight F) =
                        -∫ (m : Vec (n + 1)),
                            G.gradInnerInverse U V
                              m ∂((dilationAtlasTwoSmooth n G).globalMeasure volume).withDensity
                              ((dilationAtlasTwoSmooth n G).weight F)
@D13.ManifoldIBP.manifoldWeightedIBP_of_atlasData : ∀ {n ι : ℕ} {M : Type u_1} [inst : MeasurableSpace M]
  (A : D13.ManifoldIBP.ManifoldAtlasData M n ι) (u v : M → ℝ),
  (∀ (i : Fin ι), ContDiff ℝ 2 (A.drift i)) →
    (∀ (i : Fin ι), ContDiff ℝ 2 fun x => u (A.chart i x)) →
      (∀ (i : Fin ι), ContDiff ℝ 2 fun x => v (A.chart i x)) →
        (∀ (i : Fin ι), HasCompactSupport fun x => v (A.chart i x)) →
          Integrable (fun m => A.driftLaplacianM u m * v m) A.μ →
            Integrable (fun m => A.gradInnerM u v m) A.μ →
              ∫ (m : M), A.driftLaplacianM u m * v m ∂A.μ = -∫ (m : M), A.gradInnerM u v m ∂A.μ
