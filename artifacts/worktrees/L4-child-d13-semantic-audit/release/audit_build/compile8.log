structure Poincare.D13.ManifoldIBP.ManifoldAtlasData.{u_1} (M : Type u_1) [MeasurableSpace M] (n ι : ℕ) : Type u_1
number of parameters: 4
fields:
  Poincare.D13.ManifoldIBP.ManifoldAtlasData.μ : Measure M
  Poincare.D13.ManifoldIBP.ManifoldAtlasData.chart : Fin ι → D13.ManifoldIBP.Vec (n + 1) → M
  Poincare.D13.ManifoldIBP.ManifoldAtlasData.metric : Fin ι → ChartMetric (n + 1)
  Poincare.D13.ManifoldIBP.ManifoldAtlasData.drift : Fin ι → D13.ManifoldIBP.Vec (n + 1) → ℝ
  Poincare.D13.ManifoldIBP.ManifoldAtlasData.integral_decomp : ∀ (g : M → ℝ),
      Integrable g self.μ →
        ∫ (m : M), g m ∂self.μ =
          ∑ i,
            ∫ (x : D13.ManifoldIBP.Vec (n + 1)),
              g (self.chart i x) * Real.exp (-self.drift i x) * (self.metric i).density x
  Poincare.D13.ManifoldIBP.ManifoldAtlasData.driftLaplacianM : (M → ℝ) → M → ℝ
  Poincare.D13.ManifoldIBP.ManifoldAtlasData.gradInnerM : (M → ℝ) → (M → ℝ) → M → ℝ
  Poincare.D13.ManifoldIBP.ManifoldAtlasData.weighted_laplacian_compat : ∀ (u : M → ℝ) (i : Fin ι)
      (x : D13.ManifoldIBP.Vec (n + 1)),
      self.driftLaplacianM u (self.chart i x) =
        (self.metric i).driftLaplacian (self.drift i) (fun y => u (self.chart i y)) x
  Poincare.D13.ManifoldIBP.ManifoldAtlasData.grad_inner_compat : ∀ (u v : M → ℝ) (i : Fin ι)
      (x : D13.ManifoldIBP.Vec (n + 1)),
      self.gradInnerM u v (self.chart i x) =
        (self.metric i).gradInnerInverse (fun y => u (self.chart i y)) (fun y => v (self.chart i y)) x
constructor:
  Poincare.D13.ManifoldIBP.ManifoldAtlasData.mk.{u_1} {M : Type u_1} [MeasurableSpace M] {n ι : ℕ} (μ : Measure M)
    (chart : Fin ι → D13.ManifoldIBP.Vec (n + 1) → M) (metric : Fin ι → ChartMetric (n + 1))
    (drift : Fin ι → D13.ManifoldIBP.Vec (n + 1) → ℝ)
    (integral_decomp :
      ∀ (g : M → ℝ),
        Integrable g μ →
          ∫ (m : M), g m ∂μ =
            ∑ i, ∫ (x : D13.ManifoldIBP.Vec (n + 1)), g (chart i x) * Real.exp (-drift i x) * (metric i).density x)
    (driftLaplacianM : (M → ℝ) → M → ℝ) (gradInnerM : (M → ℝ) → (M → ℝ) → M → ℝ)
    (weighted_laplacian_compat :
      ∀ (u : M → ℝ) (i : Fin ι) (x : D13.ManifoldIBP.Vec (n + 1)),
        driftLaplacianM u (chart i x) = (metric i).driftLaplacian (drift i) (fun y => u (chart i y)) x)
    (grad_inner_compat :
      ∀ (u v : M → ℝ) (i : Fin ι) (x : D13.ManifoldIBP.Vec (n + 1)),
        gradInnerM u v (chart i x) = (metric i).gradInnerInverse (fun y => u (chart i y)) (fun y => v (chart i y)) x) :
