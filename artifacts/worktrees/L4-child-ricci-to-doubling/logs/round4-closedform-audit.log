sinhPowIntegral : ℕ → ℝ → ℝ
sinhPowIntegral_zero : ∀ (x : ℝ), sinhPowIntegral 0 x = x
sinhPowIntegral_one : ∀ (x : ℝ), sinhPowIntegral 1 x = Real.cosh x - 1
sinhPowIntegral_add_two : ∀ (d : ℕ) (x : ℝ),
  sinhPowIntegral (d + 2) x = (Real.sinh x ^ (d + 1) * Real.cosh x - (↑d + 1) * sinhPowIntegral d x) / (↑d + 2)
sinhPowIntegral_apply_zero : ∀ (d : ℕ), sinhPowIntegral d 0 = 0
sinhPowIntegral_hasDerivAt : ∀ (d : ℕ) (x : ℝ),
  D12.ComparisonGeodesics.HasDerivAtR (fun y => sinhPowIntegral d y) (Real.sinh x ^ d) x
sinhPowIntegral_integral : ∀ (d : ℕ) (s : ℝ), ∫ (t : ℝ) in 0..s, Real.sinh t ^ d = sinhPowIntegral d s
sinhPowIntegral_two : ∀ (x : ℝ), sinhPowIntegral 2 x = (Real.sinh x * Real.cosh x - x) / 2
sinhPowIntegral_three : ∀ (x : ℝ), sinhPowIntegral 3 x = (Real.sinh x ^ 2 * Real.cosh x - 2 * (Real.cosh x - 1)) / 3
@hypModelA_volume_closedForm : ∀ {d : ℕ} {κ : ℝ},
  κ ≠ 0 → ∀ (s : ℝ), D12.ComparisonGeodesics.radialVolume (hypModelA d κ) s = κ⁻¹ ^ (d + 1) * sinhPowIntegral d (κ * s)
@hypModel_volumeRatio_closedForm : ∀ {d : ℕ} {κ r R : ℝ},
  κ ≠ 0 →
    D12.ComparisonGeodesics.radialVolume (hypModelA d κ) R / D12.ComparisonGeodesics.radialVolume (hypModelA d κ) r =
      sinhPowIntegral d (κ * R) / sinhPowIntegral d (κ * r)
hypModelA_one_one_volume_closedForm : ∀ (s : ℝ),
  D12.ComparisonGeodesics.radialVolume (hypModelA 1 1) s = Real.cosh s - 1
@hypModel_volumeRatio_d2_closedForm : ∀ {κ r R : ℝ},
  κ ≠ 0 →
    D12.ComparisonGeodesics.radialVolume (hypModelA 2 κ) R / D12.ComparisonGeodesics.radialVolume (hypModelA 2 κ) r =
      (Real.sinh (κ * R) * Real.cosh (κ * R) - κ * R) / (Real.sinh (κ * r) * Real.cosh (κ * r) - κ * r)
@hyp_volume_ratio_le_of_ricci_ge_closedForm : ∀ {d : ℕ},
  0 < d →
    ∀ {κ T C t₀ : ℝ},
      0 < κ →
        0 < T →
          0 ≤ C →
            0 < t₀ →
              t₀ ≤ T →
                ↑d * κ ≤ C →
                  ∀ {k m dm A dA : ℝ → ℝ},
                    (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → hypModelK d κ ≤ k t) →
                      (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → dm t + m t ^ 2 / ↑d + k t ≤ 0) →
                        (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → D12.ComparisonGeodesics.HasDerivAtR m (dm t) t) →
                          ContinuousOn m (Set.Ioc 0 T) →
                            D12.ComparisonGeodesics.EuclideanNormalizedOn m (↑d) C t₀ →
                              (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → D12.ComparisonGeodesics.HasDerivAtR A (dA t) t) →
                                ContinuousOn A (Set.Icc 0 T) →
                                  (∀ ⦃t : ℝ⦄, t ∈ Set.Ioc 0 T → 0 < A t) →
                                    A 0 = 0 →
                                      (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → m t = dA t / A t) →
                                        ∀ {r R : ℝ},
                                          r ∈ Set.Ioc 0 T →
                                            R ∈ Set.Ioc 0 T →
                                              r ≤ R →
                                                D12.ComparisonGeodesics.radialVolume A R ≤
                                                  sinhPowIntegral d (κ * R) / sinhPowIntegral d (κ * r) *
                                                    D12.ComparisonGeodesics.radialVolume A r
@hyp_volume_doubling_closedForm : ∀ {d : ℕ},
  0 < d →
    ∀ {κ T C t₀ : ℝ},
      0 < κ →
        0 < T →
          0 ≤ C →
            0 < t₀ →
              t₀ ≤ T →
                ↑d * κ ≤ C →
                  ∀ {k m dm A dA : ℝ → ℝ},
                    (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → hypModelK d κ ≤ k t) →
                      (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → dm t + m t ^ 2 / ↑d + k t ≤ 0) →
                        (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → D12.ComparisonGeodesics.HasDerivAtR m (dm t) t) →
                          ContinuousOn m (Set.Ioc 0 T) →
                            D12.ComparisonGeodesics.EuclideanNormalizedOn m (↑d) C t₀ →
                              (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → D12.ComparisonGeodesics.HasDerivAtR A (dA t) t) →
                                ContinuousOn A (Set.Icc 0 T) →
                                  (∀ ⦃t : ℝ⦄, t ∈ Set.Ioc 0 T → 0 < A t) →
                                    A 0 = 0 →
                                      (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → m t = dA t / A t) →
                                        ∀ {s : ℝ},
                                          0 < s →
                                            s ≤ T →
                                              2 * s ≤ T →
                                                D12.ComparisonGeodesics.radialVolume A (2 * s) ≤
                                                  sinhPowIntegral d (2 * (κ * s)) / sinhPowIntegral d (κ * s) *
                                                    D12.ComparisonGeodesics.radialVolume A s
