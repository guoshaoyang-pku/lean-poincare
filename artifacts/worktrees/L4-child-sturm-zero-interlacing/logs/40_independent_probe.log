@firstPositiveZero_le_pi_sqrt_of_horizon : ∀ {k u du ddu : ℝ → ℝ} {K H : ℝ},
  0 < K →
    (∀ t ∈ Icc 0 H, K ≤ k t) →
      JacobiSolutionOn k u du ddu 0 H → u 0 = 0 → Real.pi / √K ≤ H → firstPositiveZero u ≤ Real.pi / √K
@firstPositiveZero_mem_of_normalized : ∀ {k u du ddu : ℝ → ℝ} {K : ℝ},
  0 < K →
    (∀ t ∈ Icc 0 (Real.pi / √K), K ≤ k t) →
      JacobiSolutionOn k u du ddu 0 (Real.pi / √K) →
        u 0 = 0 →
          du 0 = 1 → u (firstPositiveZero u) = 0 ∧ 0 < firstPositiveZero u ∧ ∀ t ∈ Ioo 0 (firstPositiveZero u), u t ≠ 0
@firstPositiveZero_lt_of_curvature_lt : ∀ {k₁ k₂ u₁ du₁ ddu₁ u₂ du₂ ddu₂ : ℝ → ℝ} {b : ℝ},
  0 < b →
    (∀ t ∈ Icc 0 b, k₂ t ≤ k₁ t) →
      JacobiSolutionOn k₁ u₁ du₁ ddu₁ 0 b →
        JacobiSolutionOn k₂ u₂ du₂ ddu₂ 0 b →
          u₁ 0 = 0 →
            u₂ 0 = 0 →
              u₂ b = 0 →
                (∀ ⦃t : ℝ⦄, t ∈ Ioo 0 b → 0 < u₂ t) →
                  HasDerivAtR u₂ (du₂ b) b → (∃ t ∈ Ioo 0 b, k₂ t < k₁ t) → firstPositiveZero u₁ < b
wronskian_sin_linear_antitoneOn : AntitoneOn (wronskian Real.sin Real.cos (fun t => t) fun x => 1) (Icc 0 Real.pi)
@wronskian_deriv_sin_linear : ∀ {t : ℝ},
  t ∈ Ioo 0 Real.pi → deriv (wronskian Real.sin Real.cos (fun t => t) fun x => 1) t = -(t * Real.sin t)
