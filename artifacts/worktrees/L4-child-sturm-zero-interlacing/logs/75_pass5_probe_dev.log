theorem Poincare.L4.GeodesicComparison.no_positive_solution_past_pi_sqrt : ∀ {k u du ddu : ℝ → ℝ} {T K : ℝ},
  0 < T →
    Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k u du ddu 0 T →
      u 0 = 0 → (∀ t ∈ Ioc 0 T, 0 < u t) → 0 < K → (∀ t ∈ Ioo 0 T, K ≤ k t) → T ≤ Real.pi / √K :=
fun {k u du ddu} {T K} _hT h hu0 hpos hK hk =>
  Decidable.byContradiction fun hcon =>
    have hzT := not_le.mp hcon;
    have hzpos := div_pos Real.pi_pos (Real.sqrt_pos_of_pos hK);
    have hmono :=
      { hasDerivAt_u := fun t ht => h.hasDerivAt_u ⟨ht.left, lt_of_lt_of_le ht.right (LT.lt.le hzT)⟩,
        hasDerivAt_du := fun t ht => h.hasDerivAt_du ⟨ht.left, lt_of_lt_of_le ht.right (LT.lt.le hzT)⟩,
        eq_secondDeriv := fun t ht => h.eq_secondDeriv ⟨ht.left, lt_of_lt_of_le ht.right (LT.lt.le hzT)⟩,
        continuousOn_u := ContinuousOn.mono h.continuousOn_u (Icc_subset_Icc_right (LT.lt.le hzT)),
        continuousOn_du := ContinuousOn.mono h.continuousOn_du (Icc_subset_Icc_right (LT.lt.le hzT)) };
    Or.casesOn
      (Poincare.L4.GeodesicComparison.sturm_dichotomy_of_interior_bound hzpos
        (fun t ht => hk t ⟨ht.left, lt_trans ht.right hzT⟩) hmono
        (Poincare.L4.GeodesicComparison.modelJacobiSolutionOn K (Real.pi / √K)) hu0 (Poincare.D10.jacobiSol_zero K)
        (Poincare.L4.GeodesicComparison.modelJacobiSol_firstZero hK)
        (Poincare.L4.GeodesicComparison.modelJacobiSol_pos hK) (Poincare.D10.hasDerivAt_jacobiSol K (Real.pi / √K)))
      (fun hzero =>
        Exists.casesOn hzero fun c h =>
          And.casesOn h fun hc hcz =>
            absurd hcz (ne_of_gt (hpos c ⟨hc.left, LT.lt.le (lt_of_lt_of_le hc.right (LT.lt.le hzT))⟩)))
      fun heq =>
      have hend := Poincare.L4.GeodesicComparison.eq_zero_at_pi_sqrt_of_curvature_eq hK hmono hu0 fun t ht => heq ht;
      absurd hend (ne_of_gt (hpos (Real.pi / √K) ⟨hzpos, LT.lt.le hzT⟩))
