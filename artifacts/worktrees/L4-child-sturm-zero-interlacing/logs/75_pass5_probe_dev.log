  Or.casesOn (Poincare.D12.ComparisonGeodesics.sturm_zero_comparison hab hk h1 h2 hu1a hu2a hu2b hu2pos hdu2b)
    (fun hzero => hzero) fun heq =>
    Exists.casesOn hstrict fun t h => And.casesOn h fun ht hlt => absurd (heq ht) (ne_of_gt hlt)
