@Poincare.L4.GeodesicComparison.exists_zero_of_curvature_lt : ∀ {k₁ k₂ u₁ du₁ ddu₁ u₂ du₂ ddu₂ : ℝ → ℝ} {a b : ℝ},
  a < b →
    (∀ t ∈ Icc a b, k₂ t ≤ k₁ t) →
      Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k₁ u₁ du₁ ddu₁ a b →
        Poincare.D12.ComparisonGeodesics.JacobiSolutionOn k₂ u₂ du₂ ddu₂ a b →
          u₁ a = 0 →
            u₂ a = 0 →
              u₂ b = 0 →
                (∀ ⦃t : ℝ⦄, t ∈ Ioo a b → 0 < u₂ t) →
                  Poincare.D12.ComparisonGeodesics.HasDerivAtR u₂ (du₂ b) b →
                    (∃ t ∈ Ioo a b, k₂ t < k₁ t) → ∃ c ∈ Ioo a b, u₁ c = 0
