/-!
# Poincare.D7.HeatKernel.Grid

**D7 heat-kernel layer, part 2: finite-grid heat kernels and their uniqueness.**

A finite-grid heat kernel is a one-parameter family of matrices `K n` (`n : ℕ` is the discrete
time) satisfying

* the initial condition `K 0 = 1` (the identity kernel, i.e. the discrete Dirac delta),
* the generator condition `K 1 = step`, where `step` is the one-step transition matrix,
* the **semigroup property** `K (m + n) = K m * K n`,
* the **stated Gaussian upper and lower bounds** with a grid distance `d`.

The main results are:

* `FiniteGridHeatKernel.eq_pow` — any such kernel is the matrix power `step ^ n`;
* `FiniteGridHeatKernel.unique` — **uniqueness**: two finite-grid heat kernels with the same
  generator, distance and bound constants have the same kernel. In particular, a heat kernel
  satisfying the stated bounds on a finite grid is unique;
* `GridHeatSolution.unique` — uniqueness of a bounded solution of the discrete heat equation with
  prescribed initial data and prescribed bounds;
* `gridKernel` — the canonical kernel `step ^ n`, whose bounds are supplied as explicit
  hypotheses, so the structure is inhabited exactly when the bounds can be certified.

All proofs are complete: no `sorry`, `axiom`, `unsafe`, `native_decide`, or `proof_wanted`.
-/

namespace Poincare.D7.HeatKernel

/-- **One step of the discrete heat flow** generated by a transition matrix `P`:
`heatStep P u x = ∑ y, P x y * u y`. -/
def heatStep {X : Type*} [Fintype X] (P : Matrix X X ℝ) (u : X → ℝ) : X → ℝ :=
  fun x => ∑ y, P x y * u y

variable {X : Type*} [Fintype X] [DecidableEq X]

@[simp]
theorem heatStep_apply (P : Matrix X X ℝ) (u : X → ℝ) (x : X) :
    heatStep P u x = ∑ y, P x y * u y := rfl

/-- The identity matrix acts as the identity on temperature fields. -/
theorem heatStep_one (u : X → ℝ) : heatStep (1 : Matrix X X ℝ) u = u := by
  funext x
  simp [heatStep, Matrix.one_apply]

/-- **Matrix–vector associativity of the heat step**:
`heatStep (P * Q) u = heatStep P (heatStep Q u)`. -/
theorem heatStep_mul (P Q : Matrix X X ℝ) (u : X → ℝ) :
    heatStep (P * Q) u = heatStep P (heatStep Q u) := by
  funext x
  simp only [heatStep, Matrix.mul_apply, Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl (fun z _ => Finset.sum_congr rfl (fun y _ => by ring))

/-- **A finite-grid heat kernel satisfying stated Gaussian bounds.** The fields are the initial
condition, the generator, the semigroup property, and the Gaussian upper and lower bounds. -/
structure FiniteGridHeatKernel {X : Type*} [Fintype X] [DecidableEq X] (step : Matrix X X ℝ)
    (d : X → X → ℝ) (dim C_up c_up C_lo c_lo : ℝ) where
  /-- The kernel at discrete time `n`. -/
  K : ℕ → Matrix X X ℝ
  /-- Initial condition: the identity kernel (discrete Dirac delta). -/
  initial : K 0 = 1
  /-- Generator: the one-step matrix. -/
  generator : K 1 = step
  /-- Semigroup property (Chapman–Kolmogorov). -/
  semigroup : ∀ m n : ℕ, K (m + n) = K m * K n
  /-- Stated Gaussian upper bound. -/
  upperBound : ∀ n : ℕ, 0 < n → ∀ x y : X,
    K n x y ≤ C_up * (n : ℝ) ^ (-(dim / 2)) * Real.exp (-(d x y) ^ 2 / (c_up * n))
  /-- Stated Gaussian lower bound. -/
  lowerBound : ∀ n : ℕ, 0 < n → ∀ x y : X, d x y ≤ 1 →
    C_lo * (n : ℝ) ^ (-(dim / 2)) * Real.exp (-(d x y) ^ 2 / (c_lo * n)) ≤ K n x y

namespace FiniteGridHeatKernel

variable {step : Matrix X X ℝ} {d : X → X → ℝ} {dim C_up c_up C_lo c_lo : ℝ}

/-- A family of matrices satisfying the initial condition, the generator condition and the semigroup
law is the power of its generator. -/
theorem eq_pow_of (K : ℕ → Matrix X X ℝ) (h0 : K 0 = 1) (h1 : K 1 = step)
    (hs : ∀ m n : ℕ, K (m + n) = K m * K n) : K = fun n => step ^ n := by
  funext n
  induction n with
  | zero => simpa using h0
  | succ n ih =>
      have h : K (n + 1) = K n * K 1 := by simpa using hs n 1
      rw [h, h1, ih, pow_succ]

/-- **Every finite-grid heat kernel is the power of its generator.** -/
theorem eq_pow (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) :
    K.K = fun n => step ^ n :=
  eq_pow_of K.K K.initial K.generator K.semigroup

/-- **Uniqueness of a heat kernel satisfying the stated bounds on a finite grid.** Two finite-grid
heat kernels with the same generator, distance, dimension and bound constants have the same kernel:
the bounds are part of the datum, and the generator together with the semigroup and initial
conditions determines the kernel. -/
theorem unique (K₁ K₂ : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) : K₁.K = K₂.K := by
  rw [K₁.eq_pow, K₂.eq_pow]

/-- The value of the unique finite-grid heat kernel at time `n` is `step ^ n`. -/
theorem apply_unique (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) (n : ℕ) :
    K.K n = step ^ n := by
  rw [K.eq_pow]

end FiniteGridHeatKernel

/-- **The finite-grid heat-kernel properties as a plain predicate** on a candidate kernel family
`K : ℕ → Matrix X X ℝ`: the initial condition, the generator condition, the semigroup law, and the
stated Gaussian upper and lower bounds. -/
def IsFiniteGridHeatKernel (step : Matrix X X ℝ) (d : X → X → ℝ)
    (dim C_up c_up C_lo c_lo : ℝ) (K : ℕ → Matrix X X ℝ) : Prop :=
  K 0 = 1 ∧ K 1 = step ∧ (∀ m n : ℕ, K (m + n) = K m * K n) ∧
  (∀ n : ℕ, 0 < n → ∀ x y : X,
    K n x y ≤ C_up * (n : ℝ) ^ (-(dim / 2)) * Real.exp (-(d x y) ^ 2 / (c_up * n))) ∧
  (∀ n : ℕ, 0 < n → ∀ x y : X, d x y ≤ 1 →
    C_lo * (n : ℝ) ^ (-(dim / 2)) * Real.exp (-(d x y) ^ 2 / (c_lo * n)) ≤ K n x y)

/-- **Uniqueness of a heat kernel satisfying the stated bounds on a finite grid**, in hypothesis
form: any two families of matrices that both satisfy the initial condition, the same generator, the
semigroup law and the same stated Gaussian bounds are equal. -/
theorem finiteGrid_heatKernel_unique {step : Matrix X X ℝ} {d : X → X → ℝ}
    {dim C_up c_up C_lo c_lo : ℝ} {K₁ K₂ : ℕ → Matrix X X ℝ}
    (h₁ : IsFiniteGridHeatKernel step d dim C_up c_up C_lo c_lo K₁)
    (h₂ : IsFiniteGridHeatKernel step d dim C_up c_up C_lo c_lo K₂) : K₁ = K₂ := by
  have e₁ : K₁ = fun n => step ^ n :=
    FiniteGridHeatKernel.eq_pow_of K₁ h₁.1 h₁.2.1 h₁.2.2.1
  have e₂ : K₂ = fun n => step ^ n :=
    FiniteGridHeatKernel.eq_pow_of K₂ h₂.1 h₂.2.1 h₂.2.2.1
  rw [e₁, e₂]

/-- **The canonical finite-grid heat kernel** `step ^ n`, with the stated Gaussian bounds supplied
as explicit hypotheses. This is the unique kernel with generator `step`. -/
def gridKernel (step : Matrix X X ℝ) (d : X → X → ℝ) (dim C_up c_up C_lo c_lo : ℝ)
    (hupper : ∀ n : ℕ, 0 < n → ∀ x y : X,
      (step ^ n) x y ≤ C_up * (n : ℝ) ^ (-(dim / 2)) * Real.exp (-(d x y) ^ 2 / (c_up * n)))
    (hlower : ∀ n : ℕ, 0 < n → ∀ x y : X, d x y ≤ 1 →
      C_lo * (n : ℝ) ^ (-(dim / 2)) * Real.exp (-(d x y) ^ 2 / (c_lo * n)) ≤ (step ^ n) x y) :
    FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo where
  K := fun n => step ^ n
  initial := pow_zero step
  generator := pow_one step
  semigroup := fun m n => pow_add step m n
  upperBound := hupper
  lowerBound := hlower

@[simp]
theorem gridKernel_K (step : Matrix X X ℝ) (d : X → X → ℝ) (dim C_up c_up C_lo c_lo : ℝ)
    (hupper : ∀ n : ℕ, 0 < n → ∀ x y : X,
      (step ^ n) x y ≤ C_up * (n : ℝ) ^ (-(dim / 2)) * Real.exp (-(d x y) ^ 2 / (c_up * n)))
    (hlower : ∀ n : ℕ, 0 < n → ∀ x y : X, d x y ≤ 1 →
      C_lo * (n : ℝ) ^ (-(dim / 2)) * Real.exp (-(d x y) ^ 2 / (c_lo * n)) ≤ (step ^ n) x y) :
    (gridKernel step d dim C_up c_up C_lo c_lo hupper hlower).K = fun n => step ^ n := rfl

/-- **A bounded solution of the discrete heat equation on a finite grid.** The `u n` satisfy the
one-step recursion `u (n+1) = heatStep step (u n)`, start at the prescribed initial datum `f`, and
satisfy the prescribed pointwise bound `|u n x| ≤ B n x`. -/
structure GridHeatSolution {X : Type*} [Fintype X] (step : Matrix X X ℝ) (f : X → ℝ)
    (B : ℕ → X → ℝ) where
  /-- The temperature field at discrete time `n`. -/
  u : ℕ → X → ℝ
  /-- Initial datum. -/
  initial : u 0 = f
  /-- The discrete heat equation. -/
  step_eq : ∀ n : ℕ, u (n + 1) = heatStep step (u n)
  /-- The stated pointwise bound. -/
  bounded : ∀ n x, |u n x| ≤ B n x

namespace GridHeatSolution

variable {step : Matrix X X ℝ} {f : X → ℝ} {B : ℕ → X → ℝ}

/-- **Uniqueness of a bounded discrete heat-equation solution.** Two solutions with the same initial
datum, the same generator and the same prescribed bounds agree at every time. -/
theorem unique (u v : GridHeatSolution step f B) : u.u = v.u := by
  funext n
  induction n with
  | zero => rw [u.initial, v.initial]
  | succ n ih =>
      funext x
      rw [u.step_eq n, v.step_eq n, ih]

end GridHeatSolution

/-- The temperature field obtained by applying the finite-grid kernel `K` to an initial datum `f`. -/
def gridFlow {step : Matrix X X ℝ} {d : X → X → ℝ} {dim C_up c_up C_lo c_lo : ℝ}
    (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) (f : X → ℝ) (n : ℕ) : X → ℝ :=
  heatStep (K.K n) f

/-- **The grid flow satisfies the discrete heat equation** with generator `step`. -/
theorem gridFlow_succ {step : Matrix X X ℝ} {d : X → X → ℝ} {dim C_up c_up C_lo c_lo : ℝ}
    (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) (f : X → ℝ)
    (n : ℕ) : gridFlow K f (n + 1) = heatStep step (gridFlow K f n) := by
  unfold gridFlow
  have h : K.K (n + 1) = step * K.K n := by
    have hs := K.semigroup 1 n
    rw [K.generator] at hs
    simpa [Nat.add_comm] using hs
  rw [h, heatStep_mul]

/-- Nonnegativity of the grid flow is preserved when the generator and the initial datum are
nonnegative. -/
theorem gridFlow_nonneg {step : Matrix X X ℝ} {d : X → X → ℝ} {dim C_up c_up C_lo c_lo : ℝ}
    (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) (f : X → ℝ)
    (hf : ∀ x, 0 ≤ f x) (hstep : ∀ x y, 0 ≤ step x y) : ∀ n x, 0 ≤ gridFlow K f n x := by
  intro n
  induction n with
  | zero =>
      intro x
      rw [gridFlow, K.initial, heatStep_one]
      exact hf x
  | succ n ih =>
      intro x
      rw [gridFlow_succ K f n, heatStep]
      exact Finset.sum_nonneg (fun y _ => mul_nonneg (hstep x y) (ih y))

end Poincare.D7.HeatKernel
