fun {t} =>
  Poincare.L3.HeatTimeDeriv.mildToClassicalBridge_holds
    3 : ∀ {t : ℝ},
  0 < t →
    ∀ (f : Poincare.D12.ParabolicLocal.BUCn 3),
      HasDerivAt (fun s x => (Poincare.D12.ParabolicLocal.heatConv 3 s f.val) x)
        (fun x =>
          ∫ (y : EuclideanSpace ℝ (Fin 3)),
            Poincare.D10.HeatKernelEuclidean.gaussianKernel 3 t (x - y) * (‖x - y‖ ^ 2 / (4 * t ^ 2) - ↑3 / (2 * t)) *
              f.val y)
        t
fun f =>
  (Poincare.L3.HeatTimeDeriv.heatConv_classicalHeatSolution 2
      f).isSolution : ∀ (f : Poincare.D12.ParabolicLocal.BUCn 2),
  ∀ t ∈ Set.Ioo 0 (Poincare.L3.HeatTimeDeriv.heatConv_classicalHeatSolution 2 f).T,
    ∀ (x : EuclideanSpace ℝ (Fin 2)),
      HasDerivAt (fun s => ((Poincare.L3.HeatTimeDeriv.heatConv_classicalHeatSolution 2 f).u s) x)
        (∫ (y : EuclideanSpace ℝ (Fin 2)),
          Laplacian.laplacian (Poincare.D10.HeatKernelEuclidean.gaussianKernel 2 t) (x - y) *
            (Poincare.L3.HeatTimeDeriv.heatConv_classicalHeatSolution 2 f).u₀ y)
        t
fun f x =>
  Poincare.L3.HeatTimeDeriv.hasDerivAt_heatConv_apply 1
    (Mathlib.Meta.NormNum.isNat_lt_true (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_zero)
      (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one) (Eq.refl false))
    f
    x : ∀ (f : Poincare.D12.ParabolicLocal.BUCn 1) (x : EuclideanSpace ℝ (Fin 1)),
  HasDerivAt (fun s => (Poincare.D12.ParabolicLocal.heatConv 1 s f.val) x)
    (Poincare.L3.HeatTimeDeriv.timeDerivIntegral 1 1 (⇑f.val) x) 1
fun n =>
  Poincare.L3.HeatTimeDeriv.mildToClassicalBridge_of_uniform n fun {t} =>
    Poincare.L3.HeatTimeDeriv.uniformMildToClassicalBridge_holds
      n : ∀ (n : ℕ),
  0 < ?m.3 n →
    ∀ (f : Poincare.D12.ParabolicLocal.BUCn n),
      HasDerivAt (fun s x => (Poincare.D12.ParabolicLocal.heatConv n s f.val) x)
