SEMREV-DECL|Poincare.L3.HeatTimeDeriv.timeDerivKernel.eq_1|theorem
Poincare.L3.HeatTimeDeriv.timeDerivKernel.eq_1 (n : ℕ) (t : ℝ) (z : EuclideanSpace ℝ (Fin n)) :
  Poincare.L3.HeatTimeDeriv.timeDerivKernel n t z =
    Poincare.D10.HeatKernelEuclidean.gaussianKernel n t z * Poincare.L3.HeatTimeDeriv.timeCoeff n t z
SEMREV-DECL|Poincare.L3.HeatTimeDeriv.norm_timeDerivKernel_le|theorem
Poincare.L3.HeatTimeDeriv.norm_timeDerivKernel_le (n : ℕ) {t u : ℝ} (ht : 0 < t) (hu : u ∈ Set.Ioo (t / 2) (3 * t / 2))
  (z : EuclideanSpace ℝ (Fin n)) :
  ‖Poincare.L3.HeatTimeDeriv.timeDerivKernel n u z‖ ≤
    (2 * Real.pi * t) ^ (-↑n / 2) * (‖z‖ ^ 2 / t ^ 2 + ↑n / t) * Real.exp (-‖z‖ ^ 2 / (6 * t))
SEMREV-DECL|Poincare.L3.HeatTimeDeriv.norm_timeDerivKernel_le_normalized|theorem
Poincare.L3.HeatTimeDeriv.norm_timeDerivKernel_le_normalized (n : ℕ) {t u : ℝ} (ht : 0 < t)
  (hu : u ∈ Set.Ioo (t / 2) (3 * t / 2)) (z : EuclideanSpace ℝ (Fin n)) :
  ‖Poincare.L3.HeatTimeDeriv.timeDerivKernel n u z‖ ≤ Poincare.L3.HeatTimeDeriv.timeDerivBound n t 1 z
SEMREV-DECL|Poincare.L3.HeatTimeDeriv.timeDerivBound.eq_1|theorem
Poincare.L3.HeatTimeDeriv.timeDerivBound.eq_1 (n : ℕ) (t M : ℝ) (z : EuclideanSpace ℝ (Fin n)) :
  Poincare.L3.HeatTimeDeriv.timeDerivBound n t M z =
    (2 * Real.pi * t) ^ (-↑n / 2) * (‖z‖ ^ 2 / t ^ 2 + ↑n / t) * Real.exp (-‖z‖ ^ 2 / (6 * t)) * M
SEMREV-DECL|Poincare.L3.HeatTimeDeriv.heatConv_classicalHeatSolution._proof_2|theorem
Poincare.L3.HeatTimeDeriv.heatConv_classicalHeatSolution._proof_2 : ContinuousSMul ℝ ℝ
SEMREV-DECL|Poincare.L3.HeatTimeDeriv.exists_slope_eq_timeDerivIntegral|theorem
Poincare.L3.HeatTimeDeriv.exists_slope_eq_timeDerivIntegral (n : ℕ) {t h : ℝ} (_ht : 0 < t) (hh : 0 < |h|)
  (hht : |h| < t / 2) (f : Poincare.D12.ParabolicLocal.BUCn n) (x : EuclideanSpace ℝ (Fin n)) :
  ∃ ξ,
    |ξ - t| < |h| ∧
      ((Poincare.D12.ParabolicLocal.heatConv n (t + h) f.val) x - (Poincare.D12.ParabolicLocal.heatConv n t f.val) x) /
          h =
        Poincare.L3.HeatTimeDeriv.timeDerivIntegral n ξ (⇑f.val) x
