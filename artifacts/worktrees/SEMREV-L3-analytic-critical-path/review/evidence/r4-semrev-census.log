SEMREV-DECL|Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution.mk.noConfusion|def
Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution.mk.noConfusion.{u} {n : ℕ} {P : Sort u} {T : ℝ} {T_pos : 0 < T}
  {u : ℝ → Poincare.D12.ParabolicLocal.BCFn n} {u₀ : Poincare.D12.ParabolicLocal.BCFn n}
  {initial : Filter.Tendsto u (nhdsWithin 0 (Set.Ioi 0)) (nhds u₀)}
  {isSolution :
    ∀ t ∈ Set.Ioo 0 T,
      ∀ (x : EuclideanSpace ℝ (Fin n)),
        HasDerivAt (fun s => (u s) x)
          (∫ (y : EuclideanSpace ℝ (Fin n)),
            Laplacian.laplacian (Poincare.D10.HeatKernelEuclidean.gaussianKernel n t) (x - y) * u₀ y)
          t}
  {T' : ℝ} {T_pos' : 0 < T'} {u' : ℝ → Poincare.D12.ParabolicLocal.BCFn n} {u₀' : Poincare.D12.ParabolicLocal.BCFn n}
  {initial' : Filter.Tendsto u' (nhdsWithin 0 (Set.Ioi 0)) (nhds u₀')}
  {isSolution' :
    ∀ t ∈ Set.Ioo 0 T',
      ∀ (x : EuclideanSpace ℝ (Fin n)),
        HasDerivAt (fun s => (u' s) x)
          (∫ (y : EuclideanSpace ℝ (Fin n)),
            Laplacian.laplacian (Poincare.D10.HeatKernelEuclidean.gaussianKernel n t) (x - y) * u₀' y)
          t}
  (eq :
    { T := T, T_pos := T_pos, u := u, u₀ := u₀, initial := initial, isSolution := isSolution } =
      { T := T', T_pos := T_pos', u := u', u₀ := u₀', initial := initial', isSolution := isSolution' })
  (k : T = T' → u ≍ u' → u₀ ≍ u₀' → P) : P
SEMREV-DECL|Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution.recOn|def
Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution.recOn.{u} {n : ℕ}
  {motive : Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution n → Sort u}
  (t : Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution n)
  (mk :
    (T : ℝ) →
      (T_pos : 0 < T) →
        (u : ℝ → Poincare.D12.ParabolicLocal.BCFn n) →
          (u₀ : Poincare.D12.ParabolicLocal.BCFn n) →
            (initial : Filter.Tendsto u (nhdsWithin 0 (Set.Ioi 0)) (nhds u₀)) →
              (isSolution :
                  ∀ t ∈ Set.Ioo 0 T,
                    ∀ (x : EuclideanSpace ℝ (Fin n)),
                      HasDerivAt (fun s => (u s) x)
                        (∫ (y : EuclideanSpace ℝ (Fin n)),
                          Laplacian.laplacian (Poincare.D10.HeatKernelEuclidean.gaussianKernel n t) (x - y) * u₀ y)
                        t) →
                motive { T := T, T_pos := T_pos, u := u, u₀ := u₀, initial := initial, isSolution := isSolution }) :
  motive t
