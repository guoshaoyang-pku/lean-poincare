Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution.isSolution {n : ℕ}
  (self : Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution n) (t : ℝ) :
  t ∈ Set.Ioo 0 self.T →
    ∀ (x : EuclideanSpace ℝ (Fin n)),
      HasDerivAt (fun s => (self.u s) x)
        (∫ (y : EuclideanSpace ℝ (Fin n)),
          Laplacian.laplacian (Poincare.D10.HeatKernelEuclidean.gaussianKernel n t) (x - y) * self.u₀ y)
        t
