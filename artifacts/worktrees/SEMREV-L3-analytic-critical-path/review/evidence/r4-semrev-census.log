  0 < t →
    ∀ (f : Poincare.D12.ParabolicLocal.BUCn n),
      HasDerivAt (fun s x => (Poincare.D12.ParabolicLocal.heatConv n s f.val) x)
        (fun x => Poincare.L3.HeatTimeDeriv.timeDerivIntegral n t (⇑f.val) x) t
