SEMREV-DECL|Poincare.L3.HeatTimeDeriv.abs_timeDerivIntegral_sub_le|theorem
Poincare.L3.HeatTimeDeriv.abs_timeDerivIntegral_sub_le (n : ℕ) {t u : ℝ} (ht : 0 < t)
  (hu : u ∈ Set.Ioo (t / 2) (3 * t / 2)) (f : Poincare.D12.ParabolicLocal.BUCn n) (x : EuclideanSpace ℝ (Fin n)) :
  |Poincare.L3.HeatTimeDeriv.timeDerivIntegral n u (⇑f.val) x -
        Poincare.L3.HeatTimeDeriv.timeDerivIntegral n t (⇑f.val) x| ≤
    ‖f.val‖ *
      ∫ (z : EuclideanSpace ℝ (Fin n)),
        |Poincare.L3.HeatTimeDeriv.timeDerivKernel n u z - Poincare.L3.HeatTimeDeriv.timeDerivKernel n t z|
SEMREV-DECL|Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution.mk.sizeOf_spec|theorem
Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution.mk.sizeOf_spec {n : ℕ} (T : ℝ) (T_pos : 0 < T)
  (u : ℝ → Poincare.D12.ParabolicLocal.BCFn n) (u₀ : Poincare.D12.ParabolicLocal.BCFn n)
  (initial : Filter.Tendsto u (nhdsWithin 0 (Set.Ioi 0)) (nhds u₀))
  (isSolution :
    ∀ t ∈ Set.Ioo 0 T,
      ∀ (x : EuclideanSpace ℝ (Fin n)),
        HasDerivAt (fun s => (u s) x)
          (∫ (y : EuclideanSpace ℝ (Fin n)),
            Laplacian.laplacian (Poincare.D10.HeatKernelEuclidean.gaussianKernel n t) (x - y) * u₀ y)
          t) :
  sizeOf { T := T, T_pos := T_pos, u := u, u₀ := u₀, initial := initial, isSolution := isSolution } =
    1 + sizeOf T + sizeOf T_pos + sizeOf u₀
