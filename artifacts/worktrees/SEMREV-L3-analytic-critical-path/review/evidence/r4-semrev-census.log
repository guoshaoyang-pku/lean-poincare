SEMREV-DECL|Poincare.L3.HeatTimeDeriv.hasDerivAt_heatOperator|theorem
Poincare.L3.HeatTimeDeriv.hasDerivAt_heatOperator (n : ℕ) {t : ℝ} (ht : 0 < t) {f : EuclideanSpace ℝ (Fin n) → ℝ}
  (hfm : MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume) {M : ℝ} (hM : 0 ≤ M)
  (hf : ∀ (y : EuclideanSpace ℝ (Fin n)), ‖f y‖ ≤ M) (x : EuclideanSpace ℝ (Fin n)) :
  HasDerivAt (fun s => Poincare.D12.HeatSemigroup.heatOperator n s f x)
    (∫ (y : EuclideanSpace ℝ (Fin n)),
      Poincare.D10.HeatKernelEuclidean.gaussianKernel n t (x - y) * Poincare.L3.HeatTimeDeriv.timeCoeff n t (x - y) *
        f y)
    t
SEMREV-DECL|Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution.mk.injEq|theorem
Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution.mk.injEq {n : ℕ} (T : ℝ) (T_pos : 0 < T)
  (u : ℝ → Poincare.D12.ParabolicLocal.BCFn n) (u₀ : Poincare.D12.ParabolicLocal.BCFn n)
  (initial : Filter.Tendsto u (nhdsWithin 0 (Set.Ioi 0)) (nhds u₀))
  (isSolution :
    ∀ t ∈ Set.Ioo 0 T,
      ∀ (x : EuclideanSpace ℝ (Fin n)),
        HasDerivAt (fun s => (u s) x)
          (∫ (y : EuclideanSpace ℝ (Fin n)),
            Laplacian.laplacian (Poincare.D10.HeatKernelEuclidean.gaussianKernel n t) (x - y) * u₀ y)
          t)
  (T✝ : ℝ) (T_pos✝ : 0 < T✝) (u✝ : ℝ → Poincare.D12.ParabolicLocal.BCFn n) (u₀✝ : Poincare.D12.ParabolicLocal.BCFn n)
  (initial✝ : Filter.Tendsto u✝ (nhdsWithin 0 (Set.Ioi 0)) (nhds u₀✝))
  (isSolution✝ :
    ∀ t ∈ Set.Ioo 0 T✝,
      ∀ (x : EuclideanSpace ℝ (Fin n)),
        HasDerivAt (fun s => (u✝ s) x)
          (∫ (y : EuclideanSpace ℝ (Fin n)),
            Laplacian.laplacian (Poincare.D10.HeatKernelEuclidean.gaussianKernel n t) (x - y) * u₀✝ y)
          t) :
  ({ T := T, T_pos := T_pos, u := u, u₀ := u₀, initial := initial, isSolution := isSolution } =
      { T := T✝, T_pos := T_pos✝, u := u✝, u₀ := u₀✝, initial := initial✝, isSolution := isSolution✝ }) =
    (T = T✝ ∧ u = u✝ ∧ u₀ = u₀✝)
