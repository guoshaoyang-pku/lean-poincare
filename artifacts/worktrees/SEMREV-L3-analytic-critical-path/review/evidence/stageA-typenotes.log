def Poincare.L3.HeatTimeDeriv.UniformMildToClassicalBridge : ℕ → Prop :=
fun n =>
  ∀ {t : ℝ},
    0 < t →
      ∀ (f : Poincare.D12.ParabolicLocal.BUCn n) (ε : ℝ),
        0 < ε →
          ∃ δ,
            0 < δ ∧
              ∀ (h : ℝ),
                0 < |h| →
                  |h| < δ →
                    ∀ (x : EuclideanSpace ℝ (Fin n)),
                      |((Poincare.D12.ParabolicLocal.heatConv n (t + h) f.val) x -
                                (Poincare.D12.ParabolicLocal.heatConv n t f.val) x) /
                              h -
                            Poincare.L3.HeatTimeDeriv.timeDerivIntegral n t (⇑f.val) x| <
                        ε
def Poincare.L3.HeatTimeDeriv.SpatialLaplacianBridge : ℕ → Prop :=
fun n =>
  ∀ {t : ℝ},
    0 < t →
      ∀ (f : Poincare.D12.ParabolicLocal.BUCn n) (x : EuclideanSpace ℝ (Fin n)),
        Δ (fun z => (Poincare.D12.ParabolicLocal.heatConv n t f.val) z) x =
          ∫ (y : EuclideanSpace ℝ (Fin n)), Δ (Poincare.D10.HeatKernelEuclidean.gaussianKernel n t) (x - y) * f.val y
def Poincare.D12.ParabolicLocal.mildToClassicalBridge : ℕ → Prop :=
fun n =>
  ∀ {t : ℝ},
    0 < t →
      ∀ (f : Poincare.D12.ParabolicLocal.BUCn n),
        HasDerivAt (fun s x => (Poincare.D12.ParabolicLocal.heatConv n s f.val) x)
          (fun x =>
            ∫ (y : EuclideanSpace ℝ (Fin n)),
              Poincare.D10.HeatKernelEuclidean.gaussianKernel n t (x - y) * (‖x - y‖ ^ 2 / (4 * t ^ 2) - ↑n / (2 * t)) *
                f.val y)
          t
