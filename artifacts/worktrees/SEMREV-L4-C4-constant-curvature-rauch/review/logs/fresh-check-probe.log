=== #check probe ===
@sin_sub_mul_cos_nonneg : ∀ {x : ℝ}, 0 ≤ x → x ≤ Real.pi → 0 ≤ Real.sin x - x * Real.cos x
@sin_sub_mul_cos_le_cube : ∀ {x : ℝ}, 0 ≤ x → Real.sin x - x * Real.cos x ≤ x ^ 3 / 3
@sphere_logDeriv_bound : ∀ {a t : ℝ},
  0 < a → 0 < t → a * t ≤ 1 → |Real.cos (a * t) / (Real.sin (a * t) / a) - 1 / t| ≤ a ^ 2 * t
@jacobiSolSphere_abs_le : ∀ {K t : ℝ}, 0 < K → |jacobiSolSphere K t| ≤ 1 / √K
@jacobiSolSphere_logDeriv_bound : ∀ {K t : ℝ},
  0 < K → 0 < t → K * t ^ 2 ≤ 1 → |Real.cos (√K * t) / jacobiSolSphere K t - 1 / t| ≤ K * t
@jacobiSol_logDeriv_bound : ∀ {K t : ℝ},
  0 ≤ K → 0 < t → K * t ^ 2 ≤ 1 → |jacobiDeriv K t / jacobiSol K t - 1 / t| ≤ K * t
@jacobiSol_logDeriv_normalized : ∀ {K t₀ : ℝ},
  0 ≤ K → 0 < t₀ → K * t₀ ^ 2 ≤ 1 → EuclideanNormalizedOn (fun t => jacobiDeriv K t / jacobiSol K t) 1 (K * t₀) t₀
@jacobiSol_pos_of_nonneg : ∀ {K t : ℝ}, 0 ≤ K → 0 < t → K = 0 ∨ √K * t < Real.pi → 0 < jacobiSol K t
@jacobiSol_pos_of_nonneg_Ioc : ∀ {K T : ℝ}, 0 ≤ K → K = 0 ∨ √K * T < Real.pi → ∀ t ∈ Set.Ioc 0 T, 0 < jacobiSol K t
@jacobiSol_riccati_identity : ∀ {K T : ℝ},
  (∀ t ∈ Set.Ioc 0 T, 0 < jacobiSol K t) →
    (∀ t ∈ Set.Ioo 0 T,
        HasDerivAtR (fun s => jacobiDeriv K s / jacobiSol K s)
          ((-(K * jacobiSol K t) * jacobiSol K t - jacobiDeriv K t ^ 2) / jacobiSol K t ^ 2) t) ∧
      ∀ t ∈ Set.Ioo 0 T,
        (-(K * jacobiSol K t) * jacobiSol K t - jacobiDeriv K t ^ 2) / jacobiSol K t ^ 2 +
              (jacobiDeriv K t / jacobiSol K t) ^ 2 / 1 +
            K =
          0
@abs_sub_le_of_deriv_bound : ∀ {f f' : ℝ → ℝ} {a b C : ℝ},
  a ≤ b →
    ContinuousOn f (Set.Icc a b) →
      ContinuousOn f' (Set.Icc a b) →
        (∀ t ∈ Set.Ioo a b, HasDerivAtR f (f' t) t) → (∀ t ∈ Set.Ioo a b, |f' t| ≤ C) → |f b - f a| ≤ C * (b - a)
@jacobi_linear_bounds : ∀ {k u du ddu : ℝ → ℝ} {T B : ℝ},
  JacobiSolutionOn k u du ddu 0 T →
    ContinuousOn ddu (Set.Icc 0 T) →
      0 ≤ B →
        (∀ t ∈ Set.Ioo 0 T, |ddu t| ≤ B) →
          u 0 = 0 → du 0 = 1 → (∀ t ∈ Set.Ioo 0 T, |du t - 1| ≤ B * t) ∧ ∀ t ∈ Set.Ioo 0 T, |u t - t| ≤ B * t ^ 2
@jacobi_pos_and_ratio_bound : ∀ {k u du ddu : ℝ → ℝ} {T B : ℝ},
  JacobiSolutionOn k u du ddu 0 T →
    ContinuousOn ddu (Set.Icc 0 T) →
      0 ≤ B →
        (∀ t ∈ Set.Ioo 0 T, |ddu t| ≤ B) →
          u 0 = 0 → du 0 = 1 → ∀ {t : ℝ}, t ∈ Set.Ioo 0 T → B * t ≤ 1 / 2 → 0 < u t ∧ |du t / u t - 1 / t| ≤ 4 * B
@euclideanNormalizedOn_of_jacobi : ∀ {k u du ddu : ℝ → ℝ} {T B t₀ : ℝ},
  JacobiSolutionOn k u du ddu 0 T →
    ContinuousOn ddu (Set.Icc 0 T) →
      0 ≤ B →
        (∀ t ∈ Set.Ioo 0 T, |ddu t| ≤ B) →
          u 0 = 0 →
            du 0 = 1 → 0 < t₀ → t₀ ≤ T → B * t₀ ≤ 1 / 2 → EuclideanNormalizedOn (fun t => du t / u t) 1 (4 * B) t₀
@jacobi_riccati_identity : ∀ {k u du ddu : ℝ → ℝ} {T : ℝ},
  JacobiSolutionOn k u du ddu 0 T →
    (∀ t ∈ Set.Ioc 0 T, 0 < u t) →
      (∀ t ∈ Set.Ioo 0 T, HasDerivAtR (fun s => du s / u s) ((ddu t * u t - du t ^ 2) / u t ^ 2) t) ∧
        ∀ t ∈ Set.Ioo 0 T, (ddu t * u t - du t ^ 2) / u t ^ 2 + (du t / u t) ^ 2 / 1 + k t = 0
@logDeriv_continuousOn : ∀ {k u du ddu : ℝ → ℝ} {T : ℝ},
  JacobiSolutionOn k u du ddu 0 T → (∀ t ∈ Set.Ioc 0 T, 0 < u t) → ContinuousOn (fun t => du t / u t) (Set.Ioc 0 T)
@logDeriv_continuousOn_jacobi : ∀ {K T : ℝ},
  (∀ t ∈ Set.Ioc 0 T, 0 < jacobiSol K t) → ContinuousOn (fun t => jacobiDeriv K t / jacobiSol K t) (Set.Ioc 0 T)
@rauch_upper_of_constCurv : ∀ {k u du ddu : ℝ → ℝ} {T Cu t₀ K : ℝ},
  0 < T →
    0 < t₀ →
      t₀ ≤ T →
        0 ≤ Cu →
          0 ≤ K →
            K * t₀ ^ 2 ≤ 1 →
              K = 0 ∨ √K * T < Real.pi →
                JacobiSolutionOn k u du ddu 0 T →
                  (∀ t ∈ Set.Ioc 0 T, 0 < u t) →
                    (∀ t ∈ Set.Ioo 0 T, K ≤ k t) →
                      EuclideanNormalizedOn (fun t => du t / u t) 1 Cu t₀ →
                        ∀ t ∈ Set.Ioo 0 T, du t / u t ≤ jacobiDeriv K t / jacobiSol K t
@rauch_upper_of_constCurv_jacobi : ∀ {k u du ddu : ℝ → ℝ} {T B t₀ K : ℝ},
  0 < T →
    0 ≤ B →
      0 < t₀ →
        t₀ ≤ T →
          B * t₀ ≤ 1 / 2 →
            JacobiSolutionOn k u du ddu 0 T →
              ContinuousOn ddu (Set.Icc 0 T) →
                (∀ t ∈ Set.Ioo 0 T, |ddu t| ≤ B) →
                  u 0 = 0 →
                    du 0 = 1 →
                      (∀ t ∈ Set.Ioc 0 T, 0 < u t) →
                        0 ≤ K →
                          K * t₀ ^ 2 ≤ 1 →
                            K = 0 ∨ √K * T < Real.pi →
                              (∀ t ∈ Set.Ioo 0 T, K ≤ k t) →
                                ∀ t ∈ Set.Ioo 0 T, du t / u t ≤ jacobiDeriv K t / jacobiSol K t
@rauch_upper_flat_of_jacobi : ∀ {k u du ddu : ℝ → ℝ} {T B t₀ : ℝ},
  0 < T →
    0 ≤ B →
      0 < t₀ →
        t₀ ≤ T →
          B * t₀ ≤ 1 / 2 →
            JacobiSolutionOn k u du ddu 0 T →
              ContinuousOn ddu (Set.Icc 0 T) →
                (∀ t ∈ Set.Ioo 0 T, |ddu t| ≤ B) →
                  u 0 = 0 →
                    du 0 = 1 →
                      (∀ t ∈ Set.Ioc 0 T, 0 < u t) →
                        (∀ t ∈ Set.Ioo 0 T, 0 ≤ k t) → ∀ t ∈ Set.Ioo 0 T, du t / u t ≤ 1 / t
sphere_jacobiSolutionOn_four_oneHalf : JacobiSolutionOn (fun x => 4) (jacobiSol 4) (jacobiDeriv 4)
  (fun t => -(4 * jacobiSol 4 t)) 0 (1 / 2)
spherical_rauch_witness : ∀ t ∈ Set.Ioo 0 (1 / 2), jacobiDeriv 4 t / jacobiSol 4 t ≤ jacobiDeriv 1 t / jacobiSol 1 t
spherical_rauch_witness_cot : ∀ t ∈ Set.Ioo 0 (1 / 2),
  2 * (Real.cos (2 * t) / Real.sin (2 * t)) ≤ Real.cos t / Real.sin t
jacobiSolOne_normalization_witness : ∀ t ∈ Set.Ioo 0 (1 / 2), |jacobiDeriv 1 t / jacobiSol 1 t - 1 / t| ≤ t
jacobiSolOne_normalized : EuclideanNormalizedOn (fun t => jacobiDeriv 1 t / jacobiSol 1 t) 1 (1 / 2) (1 / 2)
flat_model_normalized : EuclideanNormalizedOn (fun t => jacobiDeriv 0 t / jacobiSol 0 t) 1 0 1
EuclideanNormalizedOn : (ℝ → ℝ) → ℝ → ℝ → ℝ → Prop
JacobiSolutionOn : (ℝ → ℝ) → (ℝ → ℝ) → (ℝ → ℝ) → (ℝ → ℝ) → ℝ → ℝ → Prop
RiccatiLeOn : (ℝ → ℝ) → (ℝ → ℝ) → (ℝ → ℝ) → (ℝ → ℝ) → ℝ → ℝ → Prop
RiccatiEqOn : (ℝ → ℝ) → (ℝ → ℝ) → (ℝ → ℝ) → (ℝ → ℝ) → ℝ → ℝ → Prop
@riccati_le_of_singular_normalization : ∀ {d T C t₀ : ℝ} {k kbar m dm mbar dmbar : ℝ → ℝ},
  0 < d →
    0 < T →
      0 ≤ C →
        0 < t₀ →
          t₀ ≤ T →
            (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → dm t + m t ^ 2 / d + k t ≤ 0) →
              (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → dmbar t + mbar t ^ 2 / d + kbar t = 0) →
                (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → kbar t ≤ k t) →
                  (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → HasDerivAtR m (dm t) t) →
                    (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → HasDerivAtR mbar (dmbar t) t) →
                      ContinuousOn m (Set.Ioc 0 T) →
                        ContinuousOn mbar (Set.Ioc 0 T) →
                          EuclideanNormalizedOn m d C t₀ →
                            EuclideanNormalizedOn mbar d C t₀ → ∀ ⦃t : ℝ⦄, t ∈ Set.Ioo 0 T → m t ≤ mbar t
@riccati_le_of_initial : ∀ {d : ℝ} {k kbar m dm mbar dmbar : ℝ → ℝ} {a b : ℝ},
  a ≤ b →
    d ≠ 0 →
      (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo a b → dm t + m t ^ 2 / d + k t ≤ 0) →
        (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo a b → dmbar t + mbar t ^ 2 / d + kbar t = 0) →
          (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo a b → kbar t ≤ k t) →
            (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo a b → HasDerivAtR m (dm t) t) →
              (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo a b → HasDerivAtR mbar (dmbar t) t) →
                ContinuousOn m (Set.Icc a b) →
                  ContinuousOn mbar (Set.Icc a b) → m a ≤ mbar a → ∀ ⦃t : ℝ⦄, t ∈ Set.Icc a b → m t ≤ mbar t
@riccati_delta_le_exp : ∀ {d : ℝ} {k kbar m dm mbar dmbar : ℝ → ℝ} {a b : ℝ},
  a ≤ b →
    d ≠ 0 →
      (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo a b → dm t + m t ^ 2 / d + k t ≤ 0) →
        (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo a b → dmbar t + mbar t ^ 2 / d + kbar t = 0) →
          (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo a b → kbar t ≤ k t) →
            (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo a b → HasDerivAtR m (dm t) t) →
              (∀ ⦃t : ℝ⦄, t ∈ Set.Ioo a b → HasDerivAtR mbar (dmbar t) t) →
                ContinuousOn m (Set.Icc a b) →
                  ContinuousOn mbar (Set.Icc a b) →
                    ∀ ⦃t : ℝ⦄,
                      t ∈ Set.Icc a b →
                        m t - mbar t ≤ (m a - mbar a) * Real.exp (-∫ (x : ℝ) in a..t, (m x + mbar x) / d)
jacobiSol : ℝ → ℝ → ℝ
jacobiDeriv : ℝ → ℝ → ℝ
jacobiSolSphere : ℝ → ℝ → ℝ
jacobiSol_ode : ∀ (K t : ℝ), deriv (deriv (jacobiSol K)) t + K * jacobiSol K t = 0
hasDerivAt_jacobiSol : ∀ (K t : ℝ), HasDerivAt (jacobiSol K) (jacobiDeriv K t) t
hasDerivAt_jacobiDeriv : ∀ (K t : ℝ), HasDerivAt (jacobiDeriv K) (-(K * jacobiSol K t)) t
@jacobiSolSphere_pos : ∀ {K t : ℝ}, 0 < K → 0 < t → √K * t < Real.pi → 0 < jacobiSolSphere K t
continuous_jacobiSol : ∀ (K : ℝ), Continuous (jacobiSol K)
jacobiSol_zero : ∀ (K : ℝ), jacobiSol K 0 = 0
jacobiDeriv_zero : ∀ (K : ℝ), jacobiDeriv K 0 = 1
@jacobiSol_of_pos : ∀ {K : ℝ}, 0 < K → ∀ (t : ℝ), jacobiSol K t = jacobiSolSphere K t
jacobiSol_of_zero : ∀ (t : ℝ), jacobiSol 0 t = jacobiSolFlat t
@jacobiDeriv_of_pos : ∀ {K : ℝ}, 0 < K → ∀ (t : ℝ), jacobiDeriv K t = Real.cos (√K * t)
jacobiSolSphere : ℝ → ℝ → ℝ
@jacobiSolSphere_nonneg : ∀ {K t : ℝ}, 0 < K → 0 ≤ t → √K * t ≤ Real.pi → 0 ≤ jacobiSolSphere K t
@jacobiSolSphere_firstZero : ∀ {K : ℝ}, 0 < K → jacobiSolSphere K (Real.pi / √K) = 0
EXIT=0
