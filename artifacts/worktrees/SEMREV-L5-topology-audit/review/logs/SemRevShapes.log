def Poincare.D7.Limit.HeatMeshConvergence : {u : ℝ → ℝ → ℝ} →
  {a b T : ℝ} → Poincare.D7.Limit.HeatMeshSequence u a b T → Prop :=
fun {u} {a b T} S =>
  Filter.Tendsto (fun n => S.h n) Filter.atTop (nhds 0) ∧
    ∀ x ∈ Set.Icc a b,
      ∀ t ∈ Set.Icc 0 T,
        ∀ (i k : ℕ → ℕ),
          (∀ (n : ℕ), i n ≤ S.N n + 1) →
            Filter.Tendsto (fun n => (S.mesh n).x (i n)) Filter.atTop (nhds x) →
              Filter.Tendsto (fun n => (S.timeMesh n).time (k n)) Filter.atTop (nhds t) →
                Filter.Tendsto (fun n => (S.grid n).v (k n) (i n)) Filter.atTop (nhds (u x t))
def Poincare.D7.Limit.HeatMeshConvergenceTheorem : ℝ → ℝ → ℝ → Prop :=
fun a b T =>
  ∀ (u : ℝ → ℝ → ℝ),
    Poincare.Longrun.PDE.ContinuousHeatHypotheses u a b T →
      ∀ (S : Poincare.D7.Limit.HeatMeshSequence u a b T),
        Poincare.D7.Limit.IsRefiningMesh S → Poincare.D7.Limit.HeatMeshConvergence S
