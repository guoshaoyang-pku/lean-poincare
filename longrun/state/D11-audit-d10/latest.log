theorem probe_sharp {T : ℝ} (hT : 0 < T) :
    (∀ p ∈ parabolicCylinder unitBall1 T, probeU p ≤ 1) ∧
      sSup (probeU '' parabolicBoundary unitBall1 T) = 1 :=
