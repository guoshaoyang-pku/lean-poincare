Comment stripping: nested block comments `/- ... -/` (nesting supported in Lean 4), line comments `--`. String literals: `"..."` with escapes. Implementation: a small state machine. Let me write it robustly:

```python
def strip_comments_and_strings(text):
    out = []
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if text.startswith("/-", i):
            depth = 1
            i += 2
            while i < n and depth > 0:
                if text.startswith("/-", i):
                    depth += 1; i += 2
                elif text.startswith("-/", i):
                    depth -= 1; i += 2
                else:
                    i += 1
            continue
        if text.startswith("--", i):
            while i < n and text[i] != "\n":
                i += 1
            continue
        if c == '"':
            i += 1
            while i < n:
                if text[i] == '\\' and i + 1 < n:
                    i += 2
                    continue
                if text[i] == '"':
                    i += 1
                    break
                i += 1
            continue
        out.append(c)
        i += 1
    return "".join(out)
```

