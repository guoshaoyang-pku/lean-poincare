theorem hasFDerivAt_shrinkerFpot (τ : ℝ) (hτ : τ ≠ 0) (x : Euc n) :
    HasFDerivAt (fun y : Euc n => ‖y‖ ^ 2 / (4 * τ)) ((1 / (2 * τ)) • (innerCLM (Euc n)) x) x := by
