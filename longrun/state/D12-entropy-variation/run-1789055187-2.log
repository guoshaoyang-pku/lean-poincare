noncomputable def shrinkerRiccHess (n : ℕ) (τ : ℝ) : ℝ := (n : ℝ) / (4 * τ ^ 2)

noncomputable def shrinkerEntropyData (n : ℕ) (τ : ℝ) (hτ : 0 < τ) : EntropyData (Euc n) volume where
  R := 0
  gradSq := shrinkerGradSq τ
  f := shrinkerFpot τ
  ρ := gaussianKernel n τ
  τ := τ
