    (hderiv : ∀ᵐ x ∂μ, ∀ t ∈ s, HasDerivAt (fun u => g u x) (g' t x) t)
    (hdom : ∀ᵐ x ∂μ, ∀ t ∈ s, ‖g' t x‖ ≤ bound x)
    (hbound : Integrable bound μ) :
