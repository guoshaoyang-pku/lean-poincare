```lean
theorem fflow_F_strictMonoOn (n : ℕ) (τ₀ : ℝ) (hτ₀ : 0 < τ₀) (hn : 0 < n) :
    StrictMonoOn (fun u => (fflowEntropyData n τ₀ hτ₀ u).F) (Iio τ₀) := by
  intro s hs t ht hst
  have hsτ : s < τ₀ := hs
  have htτ : t < τ₀ := ht
  have hF_s : F(E s) = n/(2(τ₀-s)) := fflow_F_value n τ₀ hτ₀ (ne_of_gt (sub_pos.mpr hsτ))
  ...
  rw [hF_s, hF_t]
  -- n/(2(τ₀-s)) < n/(2(τ₀-t))
  have h0 : 0 < τ₀ - t := sub_pos.mpr htτ
  have hts : τ₀ - t < τ₀ - s := by linarith
  have hinv : 1 / (τ₀ - s) < 1 / (τ₀ - t) := one_div_lt_one_div_of_lt h0 hts
  -- multiply by n/2:
  have hdiv : (n:ℝ)/2 * (1/(τ₀-s)) < (n:ℝ)/2 * (1/(τ₀-t)) := mul_lt_mul_of_pos_left hinv (by positivity)
  -- rewrite to n/(2·a) form:
  have h1 : (n:ℝ)/2 * (1/(τ₀-s)) = (n:ℝ)/(2*(τ₀-s)) := by field_simp [ne_of_gt (sub_pos.mpr hsτ)]
  have h2 : (n:ℝ)/2 * (1/(τ₀-t)) = (n:ℝ)/(2*(τ₀-t)) := by field_simp [ne_of_gt h0]
  rwa [h1, h2] at hdiv
```

