    (hu : ∀ n, u n ∈ K) :
    ∃ (a : GHSpace) (φ : ℕ → ℕ), a ∈ K ∧ StrictMono φ ∧
      Tendsto (u ∘ φ) atTop (𝓝 a) ∧
      Tendsto (fun n => ghDist (GHSpace.Rep (u (φ n))) (GHSpace.Rep a)) atTop (𝓝 0) := by
