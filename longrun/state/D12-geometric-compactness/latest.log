/-- If two compact metric spaces are within Gromov–Hausdorff distance `r`, a cover of one by
δ-balls transfers to a cover of the other by (2r+δ)-balls, with the same number of centers. -/
theorem cover_transfer_of_ghDist {X : Type u} [MetricSpace X] [CompactSpace X] [Nonempty X]
    {Y : Type v} [MetricSpace Y] [CompactSpace Y] [Nonempty Y] {ι : Type w} [Fintype ι]
    {c : ι → Y} {δ r ε : ℝ} (hr : ghDist X Y < r) (hcov : ∀ y : Y, ∃ i : ι, dist y (c i) < δ)
