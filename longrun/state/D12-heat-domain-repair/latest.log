```lean
namespace Poincare.D12.HeatDomain

/-- A **versioned admissible test-function class** (HeatDomain v1) ... -/
structure AdmissibleTestClass (X : Type*) [TopologicalSpace X] [MeasurableSpace X]
    (μ : Measure X) where
  cls : (X → ℝ) → Prop
  cls_continuous : ∀ ⦃f : X → ℝ⦄, cls f → Continuous f
  cls_integrable : ∀ ⦃f : X → ℝ⦄, cls f → Integrable f μ

namespace AdmissibleTestClass

/-- continuous compactly supported (C_c) class -/
def ccClass (μ : Measure X) [OpensMeasurableSpace X] [IsFiniteMeasureOnCompacts μ] :
    AdmissibleTestClass X μ :=
  { cls := fun f => Continuous f ∧ HasCompactSupport f
    cls_continuous := fun f hf => hf.1
    cls_integrable := fun f hf => hf.1.integrable_of_hasCompactSupport hf.2 }

/-- continuous integrable class -/
def integrableClass (μ : Measure X) : AdmissibleTestClass X μ :=
  { cls := fun f => Continuous f ∧ Integrable f μ
    cls_continuous := fun f hf => hf.1
    cls_integrable := fun f hf => hf.2 }

/-- C_c is contained in the integrable class -/
theorem ccClass_subset_integrableClass ... : (ccClass μ).cls f → (integrableClass μ).cls f :=
  fun h => ⟨h.1, h.1.integrable_of_hasCompactSupport h.2⟩

-- the weak initial condition for a class
