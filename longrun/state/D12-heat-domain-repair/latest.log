namespace Poincare.D12.HeatDomain

/-- Every continuous function on a compact space is bounded and hence integrable for finite measures. -/
theorem continuous_integrable_of_compactSpace_finiteMeasure {X : Type*} [TopologicalSpace X]
    [CompactSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    (μ : Measure X) [IsFiniteMeasure μ] {f : X → ℝ} (hf : Continuous f) : Integrable f μ :=
  BoundedContinuousFunction.integrable μ (BoundedContinuousFunction.mkOfCompact ⟨f, hf⟩)

theorem weakInitialCondition_iff_full_of_compact_finiteMeasure {X : Type*}
    [TopologicalSpace X] [CompactSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    {D : HeatKernelCore X} [IsFiniteMeasure D.volume] :
    D.WeakInitialCondition ↔ D.FullInitialCondition :=
  ⟨WeakInitialCondition.of_full, fun h x f hf => h x f hf (continuous_integrable_of_compactSpace_finiteMeasure D.volume hf)⟩

theorem weakInitialConditionFor_iff_full_of_compact_finiteMeasure {X} [...] {D} [IsFiniteMeasure D.volume] :
    WeakInitialConditionFor D (integrableClass D.volume) ↔ D.FullInitialCondition :=
  by rw [← weakInitialCondition_iff_of_integrableClass, weakInitialCondition_iff_full_of_compact_finiteMeasure]

-- On compact spaces the C_c class is all continuous functions:
theorem ccClass_cls_iff_continuous_of_compactSpace ... :
    (ccClass μ).cls f ↔ Continuous f :=
  ⟨fun h => h.1, fun hf => ⟨hf, isCompact_univ ...⟩⟩
```
