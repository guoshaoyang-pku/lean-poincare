-- D12 HeatDomain.Admissible
namespace Poincare.D12.HeatDomain

/-- Versioned admissible test-function interface for heat-kernel initial conditions (v1).
An admissible test function is continuous with compact support (the classical test-function
class), or more generally continuous and integrable w.r.t. the reference measure. -/
structure AdmissibleTestFunction (X : Type*) [TopologicalSpace X] [MeasurableSpace X] (μ : Measure X) (f : X → ℝ) : Prop where
  continuous : Continuous f
  integrable : Integrable f μ

/-- The v1 initial-condition predicate for a core datum: convergence against every admissible
test function. -/
def AdmissibleInitialCondition (D : HeatKernelCore X) : Prop :=
  ∀ x f, AdmissibleTestFunction D.volume f → Tendsto (fun t => ∫ y, D.kernel x y t * f y ∂D.volume) (𝓝[>] 0) (𝓝 (f x))
```

