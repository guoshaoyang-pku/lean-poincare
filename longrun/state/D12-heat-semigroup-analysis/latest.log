/-- Translation invariance of the kernel cross-integral: `∫ y, K_s(x-y) K_t(y-z) = ∫ y, K_s y K_t(x-z-y)`. -/
private theorem integral_kernel_cross_sub_left (n : ℕ) {s t : ℝ} (x z : E) :
    ∫ y : E, gaussianKernel n s (x - y) * gaussianKernel n t (y - z)
      = ∫ y : E, gaussianKernel n s y * gaussianKernel n t (x - z - y) := by
  have hfun : (fun y : E => gaussianKernel n s (x - y) * gaussianKernel n t (y - z))
      = fun y => (fun w : E => gaussianKernel n s w * gaussianKernel n t (x - z - w)) (x - y) := by
    funext y
    change gaussianKernel n s (x - y) * gaussianKernel n t (y - z) =
      gaussianKernel n s (x - y) * gaussianKernel n t (x - z - (x - y))
    congr 1
    abel
  rw [hfun, integral_sub_left_eq_self (fun w : E => gaussianKernel n s w * gaussianKernel n t (x - z - w)) volume x]
```

