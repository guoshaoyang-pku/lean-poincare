```
theorem heatOperator_gaussianKernel (n : ℕ) {s t : ℝ} (hs : 0 < s) (ht : 0 < t)
    (a x : EuclideanSpace ℝ (Fin n)) :
    heatOperator n t (fun y => gaussianKernel n s (y - a)) x = gaussianKernel n (t + s) (x - a) := by
  unfold heatOperator
  -- ∫ y, K_t(x - y) K_s(y - a) dy = K_{t+s}(x - a)
  -- substitution z := y - a: ∫ z, K_t(x - a - z) K_s z dz
  have hfun : (fun y : EuclideanSpace ℝ (Fin n) => gaussianKernel n t (x - y) * gaussianKernel n s (y - a))
      = fun y => (fun z => gaussianKernel n t (x - a - z) * gaussianKernel n s z) (y - a) := by
    funext y
    rw [show x - y = x - a - (y - a) by abel]  -- hmm — x - y = (x-a) - (y-a) ✓ abel
  rw [hfun, integral_sub_right_eq_self (fun z => gaussianKernel n t (x - a - z) * gaussianKernel n s z) a]
  -- ∫ z, K_t((x-a) - z)·K_s z dz = gaussianKernel_convolution n ht hs (x - a)
  rw [show (∫ z, gaussianKernel n t (x - a - z) * gaussianKernel n s z)
      = ∫ z, gaussianKernel n s z * gaussianKernel n t (x - a - z) by
        refine integral_congr_ae (Eventually.of_forall fun z => mul_comm _ _)]
  exact gaussianKernel_convolution n hs ht (x - a)
```
