theorem heatOperator_integral_norm_le (n) {t} (ht) {f} (hfi : Integrable f volume) :
    ∫ x, ‖heatOperator n t f x‖ ∂volume ≤ ∫ y, ‖f y‖ ∂volume := by
  have hP : Integrable (heatOperator n t f) volume := heatOperator_integrable n ht hfi
  have hlenorm := heatOperator_lintegral_enorm_le n ht hfi.aestronglyMeasurable
  have hltf : ∫⁻ y, ‖f y‖ₑ ∂volume < ⊤ := hasFiniteIntegral_iff_enorm.mp hfi.hasFiniteIntegral
  have htoReal := ENNReal.toReal_le_toReal (ne_top_of_lt hltf) hlenorm
  have hleft : ∫ x, ‖heatOperator n t f x‖ ∂volume
      = (∫⁻ x, ‖heatOperator n t f x‖ₑ ∂volume).toReal := by
    rw [integral_eq_lintegral_of_nonneg_ae (f := fun x => ‖heatOperator n t f x‖)
      (Eventually.of_forall fun x => norm_nonneg _) hP.aestronglyMeasurable]
    congr 1
    refine lintegral_congr_ae (Eventually.of_forall fun x => ?_)
    rw [enorm_eq_ofReal (norm_nonneg _)]
  have hright : ∫ y, ‖f y‖ ∂volume = (∫⁻ y, ‖f y‖ₑ ∂volume).toReal := by
    rw [integral_eq_lintegral_of_nonneg_ae (f := fun y => ‖f y‖)
      (Eventually.of_forall fun y => norm_nonneg _) hfi.aestronglyMeasurable]
    congr 1
    refine lintegral_congr_ae (Eventually.of_forall fun y => ?_)
    rw [enorm_eq_ofReal (norm_nonneg _)]
  rw [hleft, hright]
  exact htoReal
```
