  continuous_curve := by
    change ContinuousOn (fun σ : ℝ => (Real.sqrt σ / Real.sqrt τ) • q) (Set.Icc 0 τ)
    exact ContinuousOn.smul ((Real.continuous_sqrt.continuousOn).div_const (Real.sqrt τ))
      continuousOn_const
  hasDerivAt := fun σ hσ => gaussianPath_hasDerivAt q hσ.1
  integrable_energy := by
    simpa [constantCurvatureFlow] using (gaussianLPath q hτ).integrable_energy
  integrable_cross := fun c => by
    simpa [constantCurvatureFlow] using (gaussianLPath q hτ).integrable_cross c
