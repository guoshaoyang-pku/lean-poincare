      rw [Real.sqrt_eq_rpow, ← Real.rpow_one τ, ← Real.rpow_add hτ.le]
      congr 1
      norm_num
    rw [hpow]
    field_simp [ne_of_gt (Real.sqrt_pos.2 hτ)]
    rw [Real.sq_sqrt hτ.le]
    ring
  simpa [hlhs] using hmul
```
