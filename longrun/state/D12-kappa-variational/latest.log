def constantCurvatureLPath (n : ℕ) (R0 : ℝ) (q : EuclideanSpace ℝ (Fin n)) {τ : ℝ}
    (hτ : 0 < τ) : LPath (constantCurvatureFlow n R0) 0 q τ where
  curve := gaussianPath q τ
