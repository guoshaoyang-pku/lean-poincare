theorem kernelMoment_const (n : ℕ) {t m : ℝ} (ht : 0 < t) (hm : 0 < m) :
    (1 / (2 * t)) * (4 * π * t) ^ (-(n : ℝ) / 2) *
        (π ^ ((n : ℝ) / 2) / (2 * (m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1)))
      = (4 * m * t + 1) ^ (-((n : ℝ) / 2 + 1)) := by
  have h4pt : 0 < 4 * π * t := by positivity
  have h4t : 0 < 4 * t := by positivity
  have hbm : 0 < m + 1 / (4 * t) := by positivity
  have h4mt1 : 0 < 4 * m * t + 1 := by positivity
  have h1 : (4 * π * t) ^ (-(n : ℝ) / 2) * π ^ ((n : ℝ) / 2) = (4 * t) ^ (-(n : ℝ) / 2) := by
    rw [Real.mul_rpow (by positivity : (0 : ℝ) ≤ 4 * π) (le_of_lt ht)]
    rw [Real.mul_rpow (by positivity : (0 : ℝ) ≤ 4) (le_of_lt (by positivity : 0 < π))]
    -- (4πt)^{-n/2} = 4^{-n/2}π^{-n/2}t^{-n/2}
    rw [← Real.rpow_add (by positivity : 0 < π)]
    -- π^{-n/2}·π^{n/2} = π^0 = 1
    rw [show -(n : ℝ) / 2 + (n : ℝ) / 2 = 0 by ring, Real.rpow_zero]
    -- 4^{-n/2}·t^{-n/2} = (4t)^{-n/2}
    rw [← Real.mul_rpow (by positivity : (0 : ℝ) ≤ 4) (le_of_lt ht)]
    ring
  have h2 : (m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1) = (4 * m * t + 1) ^ ((n : ℝ) / 2 + 1) / (4 * t) ^ ((n : ℝ) / 2 + 1) := by
    have hm4 : m + 1 / (4 * t) = (4 * m * t + 1) / (4 * t) := by field_simp [ne_of_gt h4t]; ring
    rw [hm4]
    rw [div_eq_mul_inv, Real.mul_rpow (by positivity : 0 ≤ 4 * m * t + 1) (by positivity : 0 ≤ (4*t)⁻¹)]
    rw [Real.inv_rpow (le_of_lt h4t), Real.rpow_neg_one]  -- (4t)⁻¹ = (4t)^{-1}: inv_rpow: x⁻¹^y = (x^y)⁻¹ — hmm I need (4t)⁻¹^z = (4t)^{-z}: inv_rpow gives (x⁻¹)^z = (x^z)⁻¹ = x^{-z} via rpow_neg: (x^z)⁻¹ = x^{-z} ✓ rw [Real.inv_rpow (le_of_lt h4t), Real.rpow_neg (le_of_lt h4t)]
    rw [← div_eq_mul_inv] — hmm, let me instead state it as: = (4mt+1)^{z}·(4t)^{-z} — then in the assembly use the multiplicative form. I'll write:
    -- target: (4mt+1)^z · (4t)^{-z}
  ...assembly:
  calc (1 / (2 * t)) * (4 * π * t) ^ (-(n : ℝ) / 2) * (π ^ ((n : ℝ) / 2) / (2 * (m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1)))
      = (1 / (2 * t)) * ((4 * π * t) ^ (-(n : ℝ) / 2) * π ^ ((n : ℝ) / 2)) / (2 * (m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1)) := by ring
      _ = (1 / (2 * t)) * (4 * t) ^ (-(n : ℝ) / 2) / (2 * (m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1)) := by rw [h1]
      _ = (1 / (2 * t)) * (4 * t) ^ (-(n : ℝ) / 2) * (2 * (m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1))⁻¹ := by ring
      _ = (1 / (2 * t)) * (4 * t) ^ (-(n : ℝ) / 2) * (2⁻¹ * ((m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1))⁻¹) := by ring
      _ = (1 / (2 * t)) * (1 / 2) * (4 * t) ^ (-(n : ℝ) / 2) * ((m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1))⁻¹ := by ring
      _ = (1 / (4 * t)) * (4 * t) ^ (-(n : ℝ) / 2) * ((m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1))⁻¹ := by ring
      _ = (4 * t)⁻¹ * (4 * t) ^ (-(n : ℝ) / 2) * ((m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1))⁻¹ := by ring
      _ = (4 * t) ^ (-1 - (n : ℝ) / 2) * ((m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1))⁻¹ := by
            rw [Real.rpow_neg_one, ← Real.rpow_add (le_of_lt h4t)]
            congr 1
            ring
      _ = (4 * t) ^ (-(1 + (n : ℝ) / 2)) * ((m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1))⁻¹ := by ring_nf
      _ = (4 * t) ^ (-((n : ℝ) / 2 + 1)) * ((m + 1 / (4 * t)) ^ ((n : ℝ) / 2 + 1))⁻¹ := by congr 1; ring
      _ = (4 * t) ^ (-((n : ℝ) / 2 + 1)) * (m + 1 / (4 * t)) ^ (-((n : ℝ) / 2 + 1)) := by
            rw [Real.rpow_neg (le_of_lt hbm)]
      _ = ((4 * t) * (m + 1 / (4 * t))) ^ (-((n : ℝ) / 2 + 1)) := by
            rw [Real.mul_rpow (le_of_lt h4t) (le_of_lt hbm)]
      _ = (4 * m * t + 1) ^ (-((n : ℝ) / 2 + 1)) := by
            congr 1
            field_simp [ne_of_gt h4t]
            ring
