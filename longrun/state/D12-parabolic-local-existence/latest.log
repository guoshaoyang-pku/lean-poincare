theorem derivativeLossBarrier_discharged (n : ℕ) (hn : 0 < n) : derivativeLossBarrier n := by
  intro hbad
  rcases hbad with ⟨C, hC0, hC⟩
  -- choose i : Fin n, m : ℕ with m > C²·5^{n+2}/4, m > 0
  let i : Fin n := ⟨0, hn⟩
  obtain ⟨m, hm⟩ : ∃ m : ℕ, C ^ 2 * (5 : ℝ) ^ ((n : ℕ) + 2) / 4 < (m : ℝ) := exists_nat_gt _
  have hmpos : 0 < m := ... (since C²·5^{n+2}/4 ≥ 0, if m = 0 then 0 > nonneg — contradiction... actually exists_nat_gt (x := that) gives m with x < m — m could be 0 if x < 0, but x ≥ 0 so m > 0 ✓.)
  let f := testF n i (m : ℝ)
  have hfDiff : Differentiable ℝ (fun x => (f : BCFn n) x) := ...
  specialize hC (1 / (m : ℝ)) (one_div_pos.mpr (by exact_mod_cast hmpos)) f hfDiff
  -- LHS lower bound
  have hlower : (5 : ℝ) ^ (-((n : ℝ) / 2 + 1)) ≤ ‖fderiv ℝ (fun x => (heatConv n (1/(m:ℝ)) f) x) 0‖ := by
    -- ‖L‖ ≥ |L (basis i)| = 5^{-(n/2+1)}
  have hupper : ‖fderiv ... 0‖ ≤ C * ‖f‖ := hC
  have hfbound : ‖f‖ ≤ 1 / (2 * sqrt (m : ℝ)) := ...
  have hcontra : (5 : ℝ) ^ (-((n : ℝ) / 2 + 1)) ≤ C * (1 / (2 * sqrt (m : ℝ))) := le_trans hlower (le_trans hupper (mul_le_mul_of_nonneg_left hfbound hC0))
  -- from m > C²·5^{n+2}/4: get C·5^{(n/2+1)}/2 < sqrt m, i.e. C/(2√m) < 5^{-(n/2+1)}
  have hstrict : C * (1 / (2 * sqrt (m : ℝ))) < (5 : ℝ) ^ (-((n : ℝ) / 2 + 1)) := ...
  exact not_le_of_gt hstrict hcontra
```

