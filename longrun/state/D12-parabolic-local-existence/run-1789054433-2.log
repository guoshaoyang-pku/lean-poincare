theorem extendToInterval_norm_le (T) (hT) (u : SolutionSpace D T) (s : ℝ) :
    ‖(extendToInterval D T hT u) s‖ ≤ ‖u‖ := by
  rw [extendToInterval_apply]
  exact BoundedContinuousFunction.norm_coe_le_norm u ⟨clamp T s, clamp_mem T hT⟩
