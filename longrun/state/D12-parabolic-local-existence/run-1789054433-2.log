open MeasureTheory Set
open scoped Topology Interval BoundedContinuousFunction

namespace Poincare.D12.ParabolicLocal

/-! ## The abstract semilinear parabolic setup -/

/-- ... -/
structure DuhamelSetup (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] (L : ℝ≥0) where
  /-- the evolution family / linear semigroup -/
  S : ℝ → (E →L[ℝ] E)
  /-- the nonlinearity -/
  F : E → E
  /-- the initial datum -/
  u₀ : E
  /-- the operator-norm bound of S on the nonnegative time axis -/
  M : ℝ
  /-- nonnegativity of the bound -/
  hM : 0 ≤ M
  /-- joint continuity of the evaluation map -/
  smap_continuous : Continuous fun p : ℝ × E => S p.1 p.2
  /-- norm bound on nonnegative times -/
  smap_norm_le : ∀ t : ℝ, 0 ≤ t → ‖S t‖ ≤ M
  /-- global Lipschitz continuity of F -/
  F_lipschitz : LipschitzWith L F
