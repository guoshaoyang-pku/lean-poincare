/-- The Duhamel map Φ(u)(t) = S t u₀ + ∫₀ᵗ S(t-s) F(u s) on the solution space. -/
def duhamelMap (T : ℝ) (hT : 0 ≤ T) (u : SolutionSpace D T) : SolutionSpace D T :=
  BoundedContinuousFunction.mkOfCompact
    ⟨fun t : Icc (0 : ℝ) T =>
      D.S t D.u₀ + ∫ s in (0 : ℝ)..t, D.S (t - s) (D.F ((extendToInterval D T hT u) s)),
    by
      -- continuity on the subtype: the ℝ-function is continuous, compose with the inclusion
      have hfun : Continuous fun t : ℝ =>
          D.S t D.u₀ + ∫ s in (0 : ℝ)..t, D.S (t - s) (D.F ((extendToInterval D T hT u) s)) := by
        exact (D.smap_continuous.comp₂ continuous_id continuous_const).add
          (continuous_parametric_intervalIntegral (E := E)
            (fun t s => D.S (t - s) (D.F ((extendToInterval D T hT u) s)))
            (duhamelIntegrand_continuous D T hT u))
      exact hfun.comp continuous_subtype_val⟩
