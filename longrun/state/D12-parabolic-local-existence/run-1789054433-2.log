/-- **Short-time existence and uniqueness of the mild solution of the semilinear parabolic
equation ∂ₜu = S-operator + F(u).** If K = M·L·T < 1 the Duhamel map is a contraction and has
a unique fixed point. -/
theorem existsUnique_mildSolution {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] {L : ℝ≥0} (D : DuhamelSetup E L) {T : ℝ} (hT : 0 ≤ T)
    (hK : D.M * L * T < 1) :
    ∃! u : D.SolutionSpace T, D.duhamelMap T hT u = u := by
  let K : ℝ≥0 := (Real.toNNReal D.M) * L * (Real.toNNReal T)
  have hKval : (K : ℝ) = D.M * L * T := by
    simp [K, Real.toNNReal_of_nonneg D.hM, Real.toNNReal_of_nonneg hT]
  have hcontr : ContractingWith K (D.duhamelMap T hT) := by
    constructor
    · -- K < 1
      rwa [hKval]
    · exact D.duhamelMap_lipschitzWith T hT
  letI : Nonempty (D.SolutionSpace T) := solutionSpaceNonempty D T
  have hfp := hcontr.fixedPoint (f := D.duhamelMap T hT) -- the fixedPoint def
  refine ⟨hfp, hcontr.fixedPoint_isFixedPt, ?_⟩
  intro w hw
  exact hcontr.fixedPoint_unique hw
```
