namespace DuhamelSetup

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {L : ℝ≥0}
variable (D : DuhamelSetup E L)

/-- The solution space on [0, T]: bounded continuous functions Icc 0 T → E (complete Banach space). -/
def SolutionSpace (T : ℝ) : Type* := (Icc (0 : ℝ) T) →ᵇ E

/-! ## Clamping and extension of solution-space functions to ℝ -/

/-- Clamp a real number into the interval [0, T]. -/
def clamp (T : ℝ) (s : ℝ) : ℝ := max 0 (min T s)

theorem clamp_continuous (T : ℝ) : Continuous (clamp T) := continuous_const.max (continuous_const.min continuous_id)

theorem clamp_mem (T : ℝ) {s : ℝ} (hT : 0 ≤ T) : clamp T s ∈ Icc (0 : ℝ) T := ⟨le_max_left _ _, min_le_left _ _⟩

theorem clamp_eq_self (T : ℝ) {s : ℝ} (hs : s ∈ Icc (0 : ℝ) T) : clamp T s = s := by
  -- max 0 (min T s) = s for 0 ≤ s ≤ T
  have hmin : min T s = s := min_eq_right hs.2
  have hmax : max 0 s = s := max_eq_right hs.1
  simp [clamp, hmin, hmax]
```
