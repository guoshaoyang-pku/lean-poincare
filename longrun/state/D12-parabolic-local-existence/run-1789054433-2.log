```lean
/-- The clamped embedding ℝ → Icc 0 T. -/
def clampSubtype (T : ℝ) (hT : 0 ≤ T) : C(ℝ, Icc (0 : ℝ) T) :=
  ⟨fun s : ℝ => ⟨clamp T s, clamp_mem T hT⟩, Continuous.subtype_mk (clamp_continuous T) (fun s => clamp_mem T hT)⟩

/-- Extend u : (Icc 0 T) →ᵇ E to all of ℝ by clamping the argument: ext u s = u ⟨clamp s, ·⟩. -/
def extendToInterval (T : ℝ) (hT : 0 ≤ T) (u : SolutionSpace D T) : ℝ →ᵇ E :=
  u.compContinuous (clampSubtype T hT)

theorem extendToInterval_apply (T) (hT) (u : SolutionSpace D T) (s : ℝ) :
    (extendToInterval D T hT u) s = u ⟨clamp T s, clamp_mem T hT⟩ := rfl

theorem extendToInterval_eq_of_mem (T) (hT) (u : SolutionSpace D T) {s : ℝ} (hs : s ∈ Icc (0 : ℝ) T) :
    (extendToInterval D T hT u) s = u ⟨s, hs⟩ := by
  rw [extendToInterval_apply]
  congr 1
  -- clamp T s = s — then subtype ext
  ext
  exact clamp_eq_self T hs
```
