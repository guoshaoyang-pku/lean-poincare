Piece 1: pow_mul_exp_neg_le.

```lean
/-- The elementary exponential decay bound `x^m * e^(-x) ≤ m^m * e^(-m)` for `x ≥ 0`,
attained at `x = m`. -/
theorem pow_mul_exp_neg_le (m : ℕ) {x : ℝ} (hx : 0 ≤ x) :
    x ^ m * Real.exp (-x) ≤ (m : ℝ) ^ m * Real.exp (-(m : ℝ)) := by
  by_cases hm : m = 0
  · subst hm
    simp
    exact Real.exp_le_one_iff.2 (neg_nonpos.mpr hx)
  have hmpos : 0 < m := Nat.pos_of_ne_zero hm
  let g : ℝ → ℝ := fun x => (m : ℝ) ^ m * Real.exp (-(m : ℝ)) - x ^ m * Real.exp (-x)
  have hg0 : 0 ≤ g 0 := by
    have hpos : 0 < (m : ℝ) ^ m * Real.exp (-(m : ℝ)) := by positivity
    simpa [g] using hpos.le
  have hgm : g m = 0 := by
    simp [g]
  have hderiv : ∀ x : ℝ, HasDerivAt g (x ^ (m - 1) * Real.exp (-x) * (x - (m : ℝ))) x := by
    intro x
    have h1 : HasDerivAt (fun x : ℝ => x ^ m) ((m : ℝ) * x ^ (m - 1)) x := by
      simpa using hasDerivAt_pow (m := m) (x := x)
    have h2 : HasDerivAt (fun x : ℝ => Real.exp (-x)) (-Real.exp (-x)) x := by
      simpa using (hasDerivAt_id x |>.neg).exp  -- hmm: HasDerivAt (fun y => -y) (-1) x := hasDerivAt_id x |>.neg; then .exp: HasDerivAt (fun y => exp(-y)) (exp(-x) * -1) x ✓ = -exp(-x)
    have hmain : HasDerivAt (fun x => x ^ m * Real.exp (-x))
        (x ^ (m - 1) * Real.exp (-x) * ((m : ℝ) - x)) x := by
      simpa [mul_add, mul_comm, mul_left_comm, mul_assoc, sub_eq_add_neg] using h1.mul h2
    have hconst : HasDerivAt (fun _ : ℝ => (m : ℝ) ^ m * Real.exp (-(m : ℝ))) 0 x := hasDerivAt_const _ _
    simpa [g, sub_eq_add_neg, mul_comm, mul_left_comm, mul_assoc] using hconst.sub hmain
  have hcont : Continuous g := by fun_prop  -- continuous on all of ℝ
  have hmono1 : AntitoneOn g (Icc (0 : ℝ) m) := by
    apply antitoneOn_of_deriv_nonpos (convex_Icc _ _) hcont.continuousOn
    · -- DifferentiableOn: from hderiv
      intro x hx
      exact (hderiv x).differentiableAt.differentiableWithinAt
    · intro x hx
      rw [(hderiv x).deriv]
      -- x^(m-1) e^{-x} (x - m) ≤ 0: x ≥ 0 ✓, e^{-x} > 0, x ≤ m ✓
      have hx0 : 0 ≤ x := hx.1
      have hxm : x - (m : ℝ) ≤ 0 := sub_nonpos.mpr hx.2
      have h1 : 0 ≤ x ^ (m - 1) := by positivity
      have h2 : 0 ≤ Real.exp (-x) := le_of_lt (Real.exp_pos _)
      have h3 : x ^ (m - 1) * Real.exp (-x) * (x - (m : ℝ)) ≤ 0 := by
        exact mul_nonpos_of_nonneg_of_nonpos (mul_nonneg h1 h2) hxm
      exact h3
  have hmono2 : MonotoneOn g (Ici (m : ℝ)) := by
    apply monotoneOn_of_deriv_nonneg (convex_Ici _) hcont.continuousOn
    · intro x hx
      exact (hderiv x).differentiableAt.differentiableWithinAt
    · intro x hx
      rw [(hderiv x).deriv]
      have hxm : 0 ≤ x - (m : ℝ) := sub_nonneg.mpr hx
      have h1 : 0 ≤ x ^ (m - 1) := by positivity
      have h2 : 0 ≤ Real.exp (-x) := le_of_lt (Real.exp_pos _)
      exact mul_nonneg (mul_nonneg h1 h2) hxm
  -- combine
  have hg : 0 ≤ g x := by
    by_cases hxm : x ≤ (m : ℝ)
    · have hle := hmono1 hx hxm  -- hmono1 : ∀ {a b}, a ∈ Icc → b ∈ Icc → a ≤ b → g b ≤ g a — antitone: x ≤ m → g m ≤ g x → g x ≥ 0 ✓
      have hh : g m ≤ g x := hle hx (by simp) hxm  -- hmm argument order: AntitoneOn f s : ∀ ⦃a⦄, a ∈ s → ∀ ⦃b⦄, b ∈ s → a ≤ b → f b ≤ f a ✓
      rwa [hgm] at hh
    · have hxm' : (m : ℝ) ≤ x := le_of_not_ge hxm
      have hh : g m ≤ g x := hmono2 (by simp) hx hxm'  -- MonotoneOn: a ≤ b → f a ≤ f b ✓
      rwa [hgm] at hh
  -- g x ≥ 0 → conclusion
  have : x ^ m * Real.exp (-x) ≤ (m : ℝ) ^ m * Real.exp (-(m : ℝ)) := by
    simpa [g, sub_eq_add_neg] using hg
  exact this
```

