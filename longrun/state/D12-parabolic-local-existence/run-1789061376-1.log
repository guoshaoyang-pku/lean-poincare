/-! ## The Gaussian semigroup on BUCn -/

/-- The positive-time heat operator on `BUCn n`: the heat convolution preserves uniform
continuity (`heatConv_uniformContinuous`), so the BCF-level operator restricts to a linear map
of the BUC space. -/
def bucHeatOperator (n : ℕ) (t : ℝ) (ht : 0 < t) : BUCn n →ₗ[ℝ] BUCn n where
  toFun f := ⟨heatConv n t f.val, heatConv_uniformContinuous n ht f.uniformContinuous_val⟩
  map_add' := by
    intro f g
    apply BUCf.ext
    change heatConv n t (f.val + g.val) = heatConv n t f.val + heatConv n t g.val
    -- heatConv = heatOperator: (heatOperator n t).map_add
    have := (heatOperator n t).map_add f.val g.val
    simpa [heatOperator_apply] using this
  map_smul' := by
    intro c f
    apply BUCf.ext
    change heatConv n t (c • f.val) = c • heatConv n t f.val
    have := (heatOperator n t).map_smul c f.val
    simpa [heatOperator_apply] using this
```
