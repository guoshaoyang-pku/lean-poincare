/-
Copyright ...
# The spatial Banach space BUCn: bounded uniformly continuous functions on ℝⁿ
-/
module

public import Poincare.D12.ParabolicLocal.GaussianConv
public import Mathlib.Topology.UniformSpace.Cauchy
public import Mathlib.Topology.Algebra.UniformMulAction

@[expose] public section

noncomputable section

open MeasureTheory Set
open scoped Topology BoundedContinuousFunction

namespace Poincare.D12.ParabolicLocal

/-- Bounded uniformly continuous functions on ℝⁿ ... -/
structure BUCf (n : ℕ) where
  val : BCFn n
  uniformContinuous_val : UniformContinuous (fun x : EuclideanSpace ℝ (Fin n) => val x)

abbrev BUCn (n : ℕ) := BUCf n

namespace BUCf

variable {n : ℕ}

instance : CoeFun (BUCn n) (fun _ => EuclideanSpace ℝ (Fin n) → ℝ) where
  coe f x := f.val x

@[simp] theorem coe_apply (f : BUCn n) (x) : f x = f.val x := rfl

@[simp] theorem norm_val (f : BUCn n) : ‖f.val‖ = ‖f‖ := rfl

-- equality
@[ext] theorem ext {f g : BUCn n} (h : f.val = g.val) : f = g := by
  cases f; cases g; simp at h; subst h; rfl
```

