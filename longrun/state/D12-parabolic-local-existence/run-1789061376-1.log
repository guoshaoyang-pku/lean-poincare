So:
```
def bucSet (n : ℕ) : Set (BCFn n) := {f | UniformContinuous f}
def bucSubmodule (n : ℕ) : Submodule ℝ (BCFn n) where
  carrier := bucSet n
  zero_mem' := uniformContinuous_const
  add_mem' := fun hf hg => hf.add hg
  smul_mem' := fun c f hf => hf.const_smul c
abbrev BUCn (n : ℕ) := bucSubmodule n
```
