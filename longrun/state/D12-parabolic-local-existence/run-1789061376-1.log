```lean
theorem gaussianS_add (n : ℕ) (t : ℝ) (ht : 0 ≤ t) (s : ℝ) (hs : 0 ≤ s) :
    gaussianS n (t + s) = (gaussianS n t).comp (gaussianS n s) := by
  by_cases ht0 : t = 0
  · subst ht0; ext f; simp [gaussianS]  -- S s = (1).comp (S s) = S s ✓
  by_cases hs0 : s = 0
  · subst hs0; ext f; simp [gaussianS]  -- S t = (S t).comp 1 = S t ✓
  -- both > 0: function-level law via heatConv_semigroup
  have htp : 0 < t := lt_of_le_of_ne ht (Ne.symm ht0)
  have hsp : 0 < s := lt_of_le_of_ne hs (Ne.symm hs0)
  ext f
  ext1  -- to val: (gaussianS n (t+s) f).val = ((gaussianS n t).comp (gaussianS n s) f).val
  -- LHS: gaussianS n (t+s) f = ⟨heatConv n (t+s) f.val, _⟩; RHS: gaussianS n t (gaussianS n s f) = ⟨heatConv n t (heatConv n s f).val, _⟩
  change heatConv n (t + s) f.val = heatConv n t (heatConv n s f.val)
  exact congrArg BUCf.val (heatConv_semigroup n htp hsp f.val)  -- hmm heatConv_semigroup gives BCF equality; congrArg val of the BUC-level law... 
```
