```lean
/-! ## Joint continuity from strong continuity (abstract) -/

theorem jointContinuous_of_absSemigroup {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {M : ℝ} {S : ℝ → (E →L[ℝ] E)}
    (hzero : S 0 = 1)
    (habs : ∀ t : ℝ, S t = S |t|)
    (hadd : ∀ t : ℝ, 0 ≤ t → ∀ s : ℝ, 0 ≤ s → S (t + s) = (S t).comp (S s))
    (hnorm : ∀ t : ℝ, 0 ≤ t → ‖S t‖ ≤ M)
    (hcont0 : ∀ f : E, Tendsto (fun t : ℝ => S t f) (𝓝[≥] (0 : ℝ)) (𝓝 f)) :
    Continuous fun p : ℝ × E => S p.1 p.2 := by
  rw [continuous_iff_continuousAt]
  intro p
  rw [Metric.continuousAt_iff]
  intro ε hε
  -- M ≥ 1 from hnorm 0
  have hMge : 1 ≤ M := by
    have h0 := hnorm 0 le_rfl
    simpa [hzero] using h0
  have hMpos : 0 < M + 1 := by linarith
  have hε' : 0 < ε / (3 * (M + 1)) := div_pos hε (by positivity)
  rcases Metric.tendsto_nhdsWithin_nhds.mp (hcont0 p.2) (ε / (3 * (M + 1))) hε' with ⟨δ₁, hδ₁, hc⟩
  refine ⟨min (δ₁ / 2) (ε / (3 * (M + 1))), by positivity, ?_⟩
  intro q hq
  have hqt : dist q.1 p.1 < δ₁ / 2 := by
    -- dist q p < min(δ₁/2)(ε/(3(M+1))) → componentwise
    have hle : dist q.1 p.1 ≤ dist q p := by
      rw [Prod.dist_eq]
      exact le_max_left _ _
    exact lt_of_le_of_lt hle hq
  have hqf : dist q.2 p.2 < ε / (3 * (M + 1)) := by
    have hle : dist q.2 p.2 ≤ dist q p := by
      rw [Prod.dist_eq]
      exact le_max_right _ _
    exact lt_of_le_of_lt hle hq
  have hfirst : dist (S q.1 q.2) (S q.1 p.2) ≤ ε / 3 := by
    calc dist (S q.1 q.2) (S q.1 p.2)
        = ‖S q.1 q.2 - S q.1 p.2‖ := rfl
      _ = ‖S q.1 (q.2 - p.2)‖ := by rw [map_sub]
      _ ≤ ‖S q.1‖ * ‖q.2 - p.2‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ M * ‖q.2 - p.2‖ := by
          have hnormq : ‖S q.1‖ ≤ M := by
            rw [habs q.1]
            exact hnorm |q.1| (abs_nonneg q.1)
          exact mul_le_mul hnormq le_rfl (norm_nonneg _) hMge... hmm — ‖S q.1‖·‖q.2 - p.2‖ ≤ M·‖q.2-p.2‖: mul_le_mul hnormq le_rfl (norm_nonneg _) (by positivity) ✓
      _ = M * dist q.2 p.2 := by rw [dist_eq_norm]
      _ ≤ M * (ε / (3 * (M + 1))) := mul_le_mul_of_nonneg_left hqf.le hMge — hmm M ≥ 1 ≥ 0 ✓ hMge.trans? M ≥ 1 → M ≥ 0: le_trans zero_le_one hMge ✓
      _ ≤ ε / 3 := by
          -- M·ε/(3(M+1)) ≤ ε/3 ⟺ M/(M+1)·ε ≤ ε ✓ since M/(M+1) ≤ 1 and ε ≥ 0
          have hfrac : M / (M + 1) ≤ 1 := by
            rw [div_le_one hMpos]
            linarith
          nlinarith [hfrac, hε.le] — hmm: M * (ε / (3 * (M + 1))) ≤ ε / 3 ⟺ M ε ≤ ε (M+1) ✓ nlinarith with hε.le ✓ (nonlinear ok)
  have hsecond : dist (S q.1 p.2) (S p.1 p.2) ≤ ε / 3 := by
    -- diff = ||q.1| - |p.1||
    have hdifflt : ||q.1| - |p.1|| < δ₁ := by
      calc ||q.1| - |p.1|| ≤ |q.1 - p.1| := abs_abs_sub_abs_le_abs_sub _ _
        _ = dist q.1 p.1 := by rw [Real.dist_eq]
        _ < δ₁ / 2 := hqt
        _ < δ₁ := by linarith
    rcases le_total (|p.1|) (|q.1|) with hle | hle'
    · -- |q.1| ≥ |p.1|: S |q.1| p.2 - S |p.1| p.2 = S |p.1| (S diff p.2 - p.2)
      have hdiffnonneg : 0 ≤ |q.1| - |p.1| := sub_nonneg.mpr hle
      have hqval : S q.1 p.2 = S |p.1| (S (|q.1| - |p.1|) p.2) := by
        have hadd' := hadd |p.1| (abs_nonneg _) (|q.1| - |p.1|) hdiffnonneg
        -- S (|p.1| + (|q.1| - |p.1|)) = S |p.1| ∘ S (|q.1| - |p.1|)
        have hsum : |p.1| + (|q.1| - |p.1|) = |q.1| := by abel
        rw [← hsum, hadd']
        rfl
      rw [habs q.1, hqval] — hmm: S q.1 p.2 → S |q.1| p.2 (habs) → S |p.1| (S diff p.2) via hqval... careful: habs q.1 : S q.1 = S |q.1|; hqval : S q.1 p.2 = S |p.1| (S diff p.2) — use hqval directly since LHS S q.1 ✓.
      have hdiff : dist (S (|q.1| - |p.1|) p.2) p.2 < ε / (3 * (M + 1)) := by
        exact hc (show |q.1| - |p.1| ∈ Ici (0 : ℝ) from hdiffnonneg) (by
          -- dist (|q.1| - |p.1|) 0 < δ₁: = ||q.1| - |p.1|| < δ₁ ✓
          rwa [Real.dist_eq, sub_zero, abs_of_nonneg hdiffnonneg])
      calc dist (S q.1 p.2) (S p.1 p.2)
          = dist (S |p.1| (S (|q.1| - |p.1|) p.2)) (S |p.1| p.2) := by
              rw [hqval, habs p.1]
        _ = ‖S |p.1| (S (|q.1| - |p.1|) p.2) - S |p.1| p.2‖ := rfl
        _ = ‖S |p.1| (S (|q.1| - |p.1|) p.2 - p.2)‖ := by rw [map_sub]
        _ ≤ ‖S |p.1|‖ * ‖S (|q.1| - |p.1|) p.2 - p.2‖ := ContinuousLinearMap.le_opNorm _ _
        _ ≤ M * (ε / (3 * (M + 1))) := by
            exact mul_le_mul (hnorm |p.1| (abs_nonneg _)) hdiff.le (norm_nonneg _) hMge... (0 ≤ M from hMge)
        _ ≤ ε / 3 := by nlinarith [hfrac, hε.le]
    · -- |q.1| ≤ |p.1|: symmetric: S |p.1| p.2 - S |q.1| p.2 = S |q.1| (S diff p.2 - p.2)
      ... symmetric with hle' : |p.1| ≤ |q.1|, diff = |p.1| - |q.1|
  calc dist (S q.1 q.2) (S p.1 p.2)
