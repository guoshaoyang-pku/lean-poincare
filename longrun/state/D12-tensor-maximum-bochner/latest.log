Then:
```python
def forbidden_scan() -> list[str]:
    errs = []
    for rel in FILES:
        text = (RELEASE / rel).read_text(encoding="utf-8")
        code = strip_comments(text)
        hits = sorted(set(re.findall(r"\b(sorry|admit|axiom|unsafe|native_decide|proof_wanted)\b", code)))
        if hits:
            errs.append(f"{rel}: forbidden token(s) in code: {hits}")
    if not errs:
        print("OK   forbidden-token scan: no sorry/admit/axiom/unsafe/native_decide/proof_wanted in any task file")
    return errs
```
