theorem feasibleDirection_of_strictKernelTangent {n : Type*} [Fintype n] [DecidableEq n]
    {A N : Matrix n n ℝ} (hA : A.PosSemidef) (hN : N.IsHermitian)
    (h : StrictKernelTangent A N) : FeasibleDirection A N := by
  obtain ⟨c, hc, hcond⟩ := h
  by_contra hnot
  -- extract a sequence
  have hex : ∀ k : ℕ, ∃ s ∈ Set.Ioc (0:ℝ) (1/(k+1)), ∃ v : n → ℝ, ‖v‖ = 1 ∧
      star v ⬝ᵥ ((A + s • N) *ᵥ v) < 0 := by
    intro k
    have hε : (0:ℝ) < 1/(k+1) := by positivity
    have hnot' : ¬ ∀ s ∈ Set.Icc 0 (1/(k+1)), (A + s • N).PosSemidef := by
      intro hh; exact hnot ⟨1/(k+1), hε, hh⟩
    push_neg at hnot'
    obtain ⟨s, hs, hpsd⟩ := hnot'
    have hs0 : s ≠ 0 := by
      rintro rfl
      exact hpsd (by simpa using hA)
    have hspos : 0 < s := lt_of_le_of_ne hs.1 (Ne.symm hs0)
    -- non-PSD ⇒ negative quadratic form
    have hHerm : (A + s • N).IsHermitian := hA.1.add (hN.smul s)  -- hmm: (s • N).IsHermitian
    have hneg : ∃ v, star v ⬝ᵥ ((A + s • N) *ᵥ v) < 0 := by
      by_contra hcon
      push_neg at hcon
      exact hpsd (Matrix.posSemidef_iff_dotProduct_mulVec.mpr ⟨hHerm, hcon⟩)
    obtain ⟨v, hv⟩ := hneg
    have hvne : v ≠ 0 := by rintro rfl; simp at hv
    refine ⟨s, ⟨hspos, hs.2⟩, (‖v‖)⁻¹ • v, ?_, ?_⟩
    · rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hvne)]
