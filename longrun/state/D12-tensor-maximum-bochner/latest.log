import Mathlib.Analysis.Matrix.PosDef
import Mathlib.Topology.Instances.Matrix
import Mathlib.LinearAlgebra.Matrix.Adjugate
import Poincare.D12.TensorMaximumBochner.PositivityPreservation

open scoped BigOperators Matrix
open Filter Set
open scoped Topology

namespace Poincare / D12 / TensorMaximumBochner

/-- Hamilton's null-eigenvector (tangent-cone) condition ... -/
def KernelTangent {n : Type*} [Fintype n] (A N : Matrix n n ℝ) : Prop :=
  ∀ v : n → ℝ, A *ᵥ v = 0 → 0 ≤ star v ⬝ᵥ (N *ᵥ v)

def FeasibleDirection {n} [Fintype n] (A N : Matrix n n ℝ) : Prop :=
  ∃ ε : ℝ, 0 < ε ∧ ∀ s ∈ Set.Icc 0 ε, (A + s • N).PosSemidef

def StrictKernelTangent {n} [Fintype n] (A N) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∀ v, A *ᵥ v = 0 → c * (star v ⬝ᵥ v) ≤ star v ⬝ᵥ (N *ᵥ v)
```

