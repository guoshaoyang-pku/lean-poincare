```lean
open Lean Elab Command

namespace Poincare.D13.CriticalPathReview

/-- Declarations whose expanded statements carry the critical-path hypotheses. -/
def mainChainDecls : List Name := [...]

/-- Required type-level constants per declaration (the exact residual inputs). -/
def requiredInType : List (Name × List Name) := [...]

/-- Constants that must NOT occur in the type (eliminated inputs). -/
def forbiddenInType : List (Name × List Name) := [...]

/-- Claimed closure pairs: (constructor, downstream). -/
def closurePairs : List (Name × Name) := [...]

def usedConstantsOf (env : Environment) (n : Name) : Array Name :=
  match env.find? n with
  | some ci => ci.type.getUsedConstants
  | none => #[]

def proofConstantsOf (env : Environment) (n : Name) : Array Name :=
  match env.find? n with
  | some ci => (ci.value? true).elim #[] Expr.getUsedConstants
  | none => #[]
```

