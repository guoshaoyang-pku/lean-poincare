```lean
-- A3 round-13 independent axiom probe (generated)
import <modules...>

open Lean Elab Command

namespace A3R13

axiom a3r13FakeAxiom : True

opaque a3r13FakeOpaque : True

theorem a3r13UsesFakeAxiom : True := a3r13FakeAxiom

theorem a3r13UsesFakeOpaque : True := a3r13FakeOpaque

def allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]

/-- Full-namespace sweep: every constant under the roots, kernel axiom cone. -/
def sweep (roots : List Name) (skip : List Name) : CommandElabM Unit := do
  let env ← getEnv
  let mut count := 0
  let mut bad : Array (Name × List Name) := #[]
  let mut skipped : Array Name := #[]
  let mut axiomDecls : Array Name := #[]
  for (n, ci) in env.constants.toList do
    if roots.any (·.isPrefixOf n) then
      if skip.contains n then
        skipped := skipped.push n
      else
        count := count + 1
        match ci with
        | .axiomInfo _ => axiomDecls := axiomDecls.push n
        | .opaqueInfo _ => axiomDecls := axiomDecls.push n
        | _ => pure ()
        let axs ← Lean.collectAxioms n
        let unapproved := axs.toList.filter (fun a => !allowed.contains a)
        if !unapproved.isEmpty then
          bad := bad.push (n, unapproved)
  logInfo m!"A3R13|SWEEP|count={count}|axiomdecls={axiomDecls.toList.map toString}|bad={bad.size}"
  for (n,u) in bad do logError m!"A3R13|BAD|{n}|{u.toList.map toString}"
  for n in axiomDecls do logInfo m!"A3R13|AXIOMDECL|{n}"

/-- Per-name #print-axioms under the same checker. -/
def checkNames (names : List Name) : CommandElabM Unit := do
  for n in names do
    let axs ← Lean.collectAxioms n
    let axs := axs.toList.map toString
    logInfo m!"A3R13|NAME|{n}|{axs}"

end A3R13

run_cmd A3R13.sweep [<roots>] [<skips>]
run_cmd A3R13.checkNames [<names>]

-- negative controls: must be flagged
#print axioms A3R13.a3r13UsesFakeAxiom
#print axioms A3R13.a3r13UsesFakeOpaque
```

