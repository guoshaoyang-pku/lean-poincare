```lean
have h1 : c.cert.lowerBound ≤ (E t).F := c.cert.lower_le t ht0
have h2 : (E t).F ≤ (E 0).F - c.rate * t := c.decay t ht0
have h3 : t * c.rate ≤ (E 0).F - c.cert.lowerBound := by linarith
have h4 : c.rate * t ≤ (E 0).F - c.cert.lowerBound := by linarith
-- t = C+1 with C*rate = (E0.F - lowerBound)
have : c.rate * t = c.rate * C + c.rate := by ring
...
```
