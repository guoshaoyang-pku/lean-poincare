namespace A3Taut
/-- 'assumption-like' proof bodies: after stripping lambdas, the body is a bound
variable, possibly applied only to bound variables (projection/assumption). -/
partial def isAssumptionTerm (e : Expr) (depth : Nat) : Bool :=
  match e with
  | .bvar i => i < depth
  | .mdata _ b => isAssumptionTerm b depth
  | .app f a => isAssumptionTerm f depth && isAssumptionTerm a depth
