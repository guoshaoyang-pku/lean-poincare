```lean
/-- Direct constant references of a declaration (type + value, plus ctor names for inductives). -/
def directRefs (env : Environment) (n : Name) : Array Name := Id.run do
  let mut s : Std.HashSet Name := {}
  match env.find? n with
  | none => pure ()
  | some ci =>
    s := constsOf ci.type s
    match ci.value? (allowOpaque := true) with
    | some v => s := constsOf v s
    | none => pure ()
    match ci with
    | .inductInfo v => for c in v.ctors do s := s.insert c
    | _ => pure ()
  return s.toArray
```

