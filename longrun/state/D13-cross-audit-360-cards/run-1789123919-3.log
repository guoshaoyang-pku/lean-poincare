```lean
structure ConeResult where
  decl : Name
  axioms : Array Name
  missing : Array Name

partial def transitiveCone (env : Environment) (root : Name) : Array Name × Array Name := Id.run do
  let mut seen : Std.HashSet Name := {}
  let mut work : Array Name := #[root]
  let mut axioms : Std.HashSet Name := {}
  let mut missing : Array Name := #[]
  while !work.isEmpty do
    let cur := work.back!
    work := work.pop
    if seen.contains cur then continue
    seen := seen.insert cur
    match env.find? cur with
    | none => missing := missing.push cur
    | some ci =>
      let mut exprs : Array Expr := #[ci.type]
      if let some v := ci.value? (allowOpaque := true) then exprs := exprs.push v
      for e in exprs do
        for c in (constsOf e {}).toArray do
          if (env.find? c).any (fun i => i.isAxiom) then axioms := axioms.insert c
          if !seen.contains c then work := work.push c
  return (axioms.toArray.qsort (·.toString < ·.toString), missing)
```

