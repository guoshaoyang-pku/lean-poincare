`reachableFrom`:
```lean
def reachableFrom (env) (root : Name) : Std.HashSet Name := Id.run do
  let mut seen : Std.HashSet Name := {}
  let mut stack : Array Name := #[root]
  while !stack.isEmpty do
    let n := stack.back!
    stack := stack.pop
    if seen.contains n then continue
    seen := seen.insert n
    for c in directRefs env n do
      if !seen.contains c then stack := stack.push c
  return seen
```
