```lean
def usersOf (env) (root : Name) (target : Name) (valuesOnly : Bool) : Array Name := Id.run do
  -- direct refs for all root constants (cached)
  let members : Array Name := ... (root constants)
  let mut refs : Std.HashMap Name (Array Name) := {}
  for n in members do refs := refs.insert n (directRefs env n valuesOnly)
  let mut anc : Std.HashSet Name := {target}
  let mut changed := true
  while changed do
    changed := false
    for n in members do
      if anc.contains n then continue
      if (refs.getD n #[]).any (fun c => anc.contains c) then
        anc := anc.insert n
        changed := true
  return (anc.erase target).toArray
```
