```python
#!/usr/bin/env python3
"""Re-run a producer's tools/d12_axiom_audit.py against the *staged* copy in this
audit worktree.  Read-only w.r.t. the producer worktree; the only writes are the
negative-control scratch file and lean olean temp files inside this worktree."""
import importlib.util, os, sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
WT = HERE.parent.parent
PROD = Path("/data3/guoshaoyang/workdir/lean_poincare/longrun/worktrees")

def main():
    card = sys.argv[1]
    tool = PROD / card / "tools" / "d12_axiom_audit.py"
    staged = WT / "audit360" / "pkgs" / card
    spec = importlib.util.spec_from_file_location("prod_d12ax", tool)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    mod.WORKTREE = staged
    mod.RELEASE = staged
    # negative control must be written and referenced inside this worktree
    import re
    orig_nc = mod.negative_control
    scratch = HERE / "scratch"
    def negative_control():
        control = scratch / f"neg_axiom_control_{card}.lean"
        control.parent.mkdir(parents=True, exist_ok=True)
        control.write_text("import Mathlib.Tactic\naxiom fakeD12Axiom : True\ntheorem usesFakeD12Axiom : True := fakeD12Axiom\n#print axioms usesFakeD12Axiom\n", encoding="utf-8")
        proc = mod.subprocess.run(["lake","env","lean",str(control)], cwd=mod.RELEASE, capture_output=True, text=True, timeout=600)
        flagged = False
        for line in proc.stdout.splitlines():
            name, axioms = mod.parse_axioms_line(line)
            if name == "usesFakeD12Axiom" and axioms and (axioms - mod.ALLOWED):
                flagged = True
        errors=[]
        if proc.returncode != 0: errors.append("negative control: lean did not compile the control file")
        if not flagged: errors.append("negative control: fake axiom was NOT flagged by the parser (fail-open!)")
        else: print("OK   negative control: fake axiom correctly flagged")
        return errors
    mod.negative_control = negative_control
    rc = mod.main()
    print("PRODUCER-AUDIT-RERUN", card, "rc", rc)
    return rc

if __name__ == "__main__":
    sys.exit(main())
```

