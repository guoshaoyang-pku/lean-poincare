For early-exit reachability:
```
def reaches (env) (root target) (valuesOnly) : Bool := Id.run do
  if root == target then return true
  let mut seen : Std.HashSet Name := {}
  let mut stack := #[root]
  while !stack.isEmpty do
    let n := stack.back!; stack := stack.pop
    if seen.contains n then continue
    seen := seen.insert n
    for c in directRefs env n valuesOnly do
      if c == target then return true
      if !seen.contains c then stack := stack.push c
  return false
```
