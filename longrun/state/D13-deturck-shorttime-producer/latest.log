import Mathlib
import Poincare.D13.DeturckProducer.SmoothMetric

namespace Poincare.D13.DeturckProducer.SymbolMatrix

-- generic matrix lemmas (over arbitrary symmetric A with IsUnit det)
def metricSharpMat (A : Matrix (Fin n) (Fin n) ℝ) (ξ : Fin n → ℝ) : Fin n → ℝ := A⁻¹ *ᵥ ξ
def covectorNormSqMat (A) (ξ) : ℝ := dotProduct ξ (A⁻¹ *ᵥ ξ)
def bilinTraceMat (A) (h : Matrix) : ℝ := ∑ i, ∑ j, (A⁻¹) i j * h i j
def hSharpMat (A) (h) (ξ) : Fin n → ℝ := h *ᵥ (A⁻¹ *ᵥ ξ)
def ricciSymbolMat (A) (ξ) (h) : Matrix := fun i j => (1/2) * (covectorNormSqMat A ξ * h i j - ξ i * hSharpMat A h ξ j - ξ j * hSharpMat A h ξ i + ξ i * ξ j * bilinTraceMat A h)
def deTurckFieldSymbolMat (A) (ξ) (h) : Fin n → ℝ := fun k => hSharpMat A h ξ k - (1/2) * bilinTraceMat A h * ξ k
def lieSymbolMat (A) (ξ) (h) : Matrix := fun i j => -(ξ i * deTurckFieldSymbolMat A ξ h j + ξ j * deTurckFieldSymbolMat A ξ h i)
def laplacianSymbolMat (A) (ξ) (h) : Matrix := covectorNormSqMat A ξ • h
```

