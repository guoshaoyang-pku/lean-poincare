structure SmoothMetricData (n : ℕ) where
  g : (Fin n → ℝ) → Matrix (Fin n) (Fin n) ℝ
  symm : ∀ x, (g x)ᵀ = g x
  smooth : ContDiff ℝ 2 g
  lower : ℝ
