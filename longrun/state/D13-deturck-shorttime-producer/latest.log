/-- The 1-Lipschitz clamp onto `[-C, C]`. -/
def clampC (C : ℝ) (x : ℝ) : ℝ := max (-C) (min C x)

theorem clampC_mem {C : ℝ} (hC : 0 ≤ C) (x : ℝ) : -C ≤ clampC C x ∧ clampC C x ≤ C := by
  simp [clampC, le_max_left, min_le_left, neg_le_iff_add_nonneg', ...]
  -- clampC = max (-C) (min C x) — lower: -C ≤ max (-C) (min C x) ✓ le_max_left; upper: min C x ≤ C ✓ min_le_left; and -C ≤ C (from hC: 2C ≥ 0...) — max (-C) (min C x) ≤ C: need -C ≤ C ✓ (hC) and min C x ≤ C ✓ — so `constructor; exact le_max_left _ _; exact max_le (by linarith) (min_le_left _ _)`

theorem clampC_id_of_mem {C : ℝ} {x : ℝ} (hx : -C ≤ x ∧ x ≤ C) : clampC C x = x := by
  simp [clampC, min_eq_left hx.2, max_eq_right (by linarith)]  -- max (-C) x with -C ≤ x → x ✓

theorem clampC_lipschitz (C : ℝ) : LipschitzWith 1 (clampC C) := by
  -- composition of max/min: fun x => max (-C) (min C x) = (fun p : ℝ × ℝ => max p.1 p.2) ∘ (fun x => (-C, min C x))
  -- LipschitzWith.comp: lipschitzWith_max.comp (lipschitzWith_const.prodMk (lipschitzWith_min.comp ...)) hmm
  -- min C x = (fun p => min p.1 p.2) (C, x) — lipschitzWith_min : LipschitzWith 1 (fun p => min p.1 p.2)
  -- have h1 : LipschitzWith 1 (fun x : ℝ => (-C, min C x)) := LipschitzWith.const (-C) |>.prodMk (lipschitzWith_min.comp ...) hmm — simpler:
  -- fun x => min C x = lipschitzWith_min ∘ (fun x => (C, x)) — (fun x => (C, x)) is 1-Lipschitz: LipschitzWith.const C |>.prodMk LipschitzWith.id
  -- then max (-C) (that) = lipschitzWith_max ∘ (fun x => (-C, min C x)) — (fun x => (-C, min C x)) = LipschitzWith.const (-C) |>.prodMk (min-comp)
```
