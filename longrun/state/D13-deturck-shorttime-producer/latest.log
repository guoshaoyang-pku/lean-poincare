  (Finset.univ : Finset (Fin n)).sup fun i => (Finset.univ : Finset (Fin n)).sup fun j => |A i j|

def supNormOneJet (dg : Fin n → Matrix (Fin n) (Fin n) ℝ) : ℝ :=
  (Finset.univ : Finset (Fin n)).sup fun k => supNormMatrix (dg k)

def supNormTwoJet (ddg : Fin n → Fin n → Matrix (Fin n) (Fin n) ℝ) : ℝ :=
  (Finset.univ : Finset (Fin n)).sup fun k => (Finset.univ : Finset (Fin n)).sup fun l => supNormMatrix (ddg k l)

def supNormVector (w : Fin n → ℝ) : ℝ :=
  (Finset.univ : Finset (Fin n)).sup fun k => |w k|
```

