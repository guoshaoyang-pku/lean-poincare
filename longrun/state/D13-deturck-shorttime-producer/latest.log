/-- **The named mild-to-classical bridge obligation** (D12's remaining obligation): a mild
solution of the produced model that satisfies the classical DeTurck equation. -/
structure MildClassicalOutput (P : DeTurckParabolicProblem) where
  T : ℝ
  T_pos : 0 < T
  u : ℝ → P.MetricState
  u0 : u 0 = P.initial
  isClassical : P.IsDeTurckSolutionOn T u

theorem deTurckShortTimeExistence_of_classicalOutput (P) (h : MildClassicalOutput P) :
    DeTurckShortTimeExistence P := ⟨h.T, h.T_pos, h.u, h.u0, h.isClassical⟩

