  calc (4 * π * t) ^ (-(n : ℝ) / 2) * Real.exp (-(‖x - y‖ ^ 2) / (4 * t))
      ≤ (4 * π * t) ^ (-(n : ℝ) / 2) * 1 := by gcongr
    _ = (4 * π * t) ^ (-(n : ℝ) / 2) := mul_one _
