```lean
import Poincare.D13.HeatKernelBridge.PDERepair

-- WeakHeatEquation.lean

def WeakHeatKernelPDE (S : HeatSpacetime M) (C : AdmissibleTestClass M S.volume) (K : M → M → ℝ → ℝ) : Prop :=
  ∀ (φ : M → ℝ), C.cls φ → ∀ y : M, ∀ t : ℝ, 0 < t →
    HasDerivAt (fun s : ℝ => ∫ x, φ x * K x y s ∂S.volume)
      (∫ x, φ x * S.laplacian (fun z => K z y t) x ∂S.volume) t

structure WeakHeatCertificates (S) (C) (K) : Prop where
  snapshot_measurable : ∀ φ, C.cls φ → ∀ y t, 0 < t → AEStronglyMeasurable (fun x => φ x * K x y t) S.volume
