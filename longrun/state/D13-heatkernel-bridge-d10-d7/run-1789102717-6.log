  -- now D.initialConditionFor : WeakInitialConditionFor D.core (continuousIntegrableClass D.core.volume)
  exact Poincare.D12.HeatDomain.toHeatKernelData_of_weak_compact_finiteMeasure (D := D.core)
    ((WeakInitialConditionFor.iff_integrableClass (D := D.core)).mpr D.initialConditionFor)
