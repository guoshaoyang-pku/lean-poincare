```lean
namespace Poincare.D13.HeatKernelBridge

/-- Version tag for the PDE-corrected D7 predicate. -/
def IsHeatKernelPDE.v2 : ℕ := 2

/-- The D7 heat-kernel predicate with the heat-equation field repaired to the genuine PDE:
