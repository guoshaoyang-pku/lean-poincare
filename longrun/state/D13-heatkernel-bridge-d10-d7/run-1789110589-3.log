condition on an admissible class. -/
structure IsHeatKernelPDE {M} [TopologicalSpace M] [MeasurableSpace M]
    (S : HeatSpacetime M) (C : AdmissibleTestClass M S.volume) (K : M → M → ℝ → ℝ) : Prop where
