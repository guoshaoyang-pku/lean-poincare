theorem not_exists_isHeatKernelPDE_of_laplacian_eq_zero_of_indicator
    {M : Type*} [TopologicalSpace M] [MeasurableSpace M] (S : HeatSpacetime M)
    (hlapl : S.laplacian = 0) (C : AdmissibleTestClass M S.volume)
    {x y : M} (hxy : x ≠ y) {f : M → ℝ} (hcls : C.cls f)
    (hf : ∀ z, f z = if z = y then 1 else 0)
    (hint : ∀ g : M → ℝ, (∀ z, z ≠ y → g z = 0) → ∫ z, g z ∂S.volume = g y) :
    ¬ ∃ K : M → M → ℝ → ℝ, IsHeatKernelPDE S C K := ...
```

Proof:
```lean
  rintro ⟨K, hK⟩
  -- constancy in t
  have hderiv : ∀ t : ℝ, 0 < t → HasDerivAt (fun s : ℝ => K x y s) 0 t := by
    intro t ht
    have h := hK.solvesPDE x y t ht
    simpa [hlapl] using h
  have hconst : ∀ t : ℝ, 0 < t → K x y t = K x y 1 := by
    intro t ht
    refine isOpen_Ioi.is_const_of_fderiv_eq_zero isPreconnected_Ioi ?_ ?_ ht (by norm_num)
    · intro u hu
      exact (hderiv u hu).differentiableAt.differentiableWithinAt
    · intro u hu
      rw [(hderiv u hu).hasFDerivAt.fderiv]
      simp
  -- integral identity
  have hint_eq : ∀ t : ℝ, ∫ z, K x z t * f z ∂S.volume = K x y t := by
    intro t
    refine hint (fun z => K x z t * f z) ?_
    intro z hz
    rw [hf z, if_neg hz, mul_zero]
  -- limit
  have hlim : Tendsto (fun t : ℝ => K x y t) (𝓝[>] (0:ℝ)) (𝓝 0) := by
    have h := hK.dirac_limitFor f hcls x
    have hfx : f x = 0 := by rw [hf x, if_neg hxy]
    rw [hfx] at h
    simpa [hint_eq] using h
  have hlim1 : Tendsto (fun t : ℝ => K x y t) (𝓝[>] (0:ℝ)) (𝓝 (K x y 1)) := by
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact (hconst t ht).symm  -- careful direction: eventually f =ᶠ[l] const
  have hzero : K x y 1 = 0 := (tendsto_nhds_unique hlim hlim1).symm -- hlim: → 0, hlim1: → K x y 1, so 0 = K x y 1
  have hpos := hK.positive x y 1 (by norm_num)
  rw [hzero] at hpos
  exact lt_irrefl 0 hpos
```
