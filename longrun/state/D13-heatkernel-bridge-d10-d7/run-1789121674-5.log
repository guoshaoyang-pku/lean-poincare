  solvesPDE := fun x y t ht => by
    have hsub' : 0 < t₀ - t := sub_pos.mpr ht
    have hcomp := (D.core.heatEquation x y (t₀ - t) hsub').comp
      ((hasDerivAt_id t).const_sub t₀)
