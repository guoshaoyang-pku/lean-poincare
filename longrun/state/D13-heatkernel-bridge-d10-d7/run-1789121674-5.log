variable {M : Type*} [TopologicalSpace M] [MeasurableSpace M]

/-- If the conjugate-heat operator of a datum is `-Δ` (zero backward time derivative and zero
curvature term), then any kernel whose snapshots solve `□* u = 0` has vanishing snapshots whenever
the Laplacian is injective. -/
theorem conjugateHeat_eq_neg_laplacian (S : ConjugateHeatSpacetime M)
    (h∂ : S.backwardTimeDerivative = 0) (hR : S.scalarMul = 0) (u : M → ℝ) :
    S.conjugateHeat u = - S.laplacian u := by
  simp [ConjugateHeatSpacetime.conjugateHeat, h∂, hR]
```
