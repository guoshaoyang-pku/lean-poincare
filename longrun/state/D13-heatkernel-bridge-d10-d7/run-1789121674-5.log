theorem IsConjugateHeatKernelPDE.of_dataV1 {X} [TopologicalSpace X] [MeasurableSpace X]
    (D : HeatKernelDataV1 X) (t₀ : ℝ) (C : AdmissibleTestClass X D.volume)
