theorem exp_smul_mulVec_sum (G) (t : ℝ) (u : X → ℝ) :
    ∑ x, (NormedSpace.exp (t • G.L) *ᵥ u) x = ∑ x, u x := by
  simp only [Matrix.mulVec, dotProduct]
