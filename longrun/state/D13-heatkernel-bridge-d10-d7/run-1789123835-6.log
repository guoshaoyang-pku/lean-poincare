/-! ## V. The clipped heat kernel and the D7 datums -/

/-- The heat kernel of a pinned finite Laplace operator, as a total function on ℝ: ... -/
noncomputable def finiteHeatKernel (G : FiniteHeatOperator X) (x y : X) (t : ℝ) : ℝ :=
  if 0 < t then (NormedSpace.exp (t • G.L)) x y else 0

theorem finiteHeatKernel_of_pos (G) {t : ℝ} (ht : 0 < t) (x y) :
    finiteHeatKernel G x y t = (NormedSpace.exp (t • G.L)) x y := by
  simp [finiteHeatKernel, ht]

theorem finiteHeatKernel_of_nonpos (G) {t : ℝ} (ht : ¬ 0 < t) (x y) : finiteHeatKernel G x y t = 0 := by
  simp [finiteHeatKernel, ht]

theorem finiteHeatKernel_nonneg (G) (x y t) : 0 ≤ finiteHeatKernel G x y t := by
  by_cases ht : 0 < t
  · rw [finiteHeatKernel_of_pos G ht]; exact G.kernel_nonneg_of_nonneg ht.le x y
  · rw [finiteHeatKernel_of_nonpos G ht]

theorem finiteHeatKernel_pos (G) {t} (ht : 0 < t) (x y) : 0 < finiteHeatKernel G x y t := by
  rw [finiteHeatKernel_of_pos G ht]; exact G.kernel_pos ht x y

theorem finiteHeatKernel_symm (G) (x y t) : finiteHeatKernel G x y t = finiteHeatKernel G y x t := by
  by_cases ht : 0 < t
  · rw [finiteHeatKernel_of_pos G ht, finiteHeatKernel_of_pos G ht]; exact G.exp_smul_symm t x y
  · rw [finiteHeatKernel_of_nonpos G ht, finiteHeatKernel_of_nonpos G ht]

theorem finiteHeatKernel_le_one (G) {t} (ht : 0 < t) (x y) : finiteHeatKernel G x y t ≤ 1 := by
  rw [finiteHeatKernel_of_pos G ht]; exact G.exp_smul_le_one ht x y

theorem finiteHeatKernel_row_sum (G) {t} (ht : 0 < t) (x) :
    ∑ y, finiteHeatKernel G x y t = 1 := by
  rw [Finset.sum_congr rfl (fun y _ => finiteHeatKernel_of_pos G ht x y)]
  exact G.exp_smul_row_sum t x
