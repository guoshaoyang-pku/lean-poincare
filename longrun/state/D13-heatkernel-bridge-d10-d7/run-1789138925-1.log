```lean
theorem eq_of_conjugatePDE_of_tendsto (G : FiniteHeatOperator X)
    {S : ConjugateHeatSpacetime X} {t₀ : ℝ} (hL : S.laplacian = G.laplacian)
    {C : ℝ} (hR : ∀ u : X → ℝ, -(C * G.energy u) ≤ ∑ x, u x * S.scalarMul u x)
    {u v : ℝ → X → ℝ} {c : X → ℝ}
    (hu : ∀ t, t < t₀ → ∀ x,
      HasDerivAt (fun s : ℝ => u s x) (-(S.laplacian (u t) x) + S.scalarMul (u t) x) t)
    (hv : ∀ t, t < t₀ → ∀ x,
      HasDerivAt (fun s : ℝ => v s x) (-(S.laplacian (v t) x) + S.scalarMul (v t) x) t)
    (hu0 : ∀ x, Tendsto (fun t : ℝ => u t x) (𝓝[<] t₀) (𝓝 (c x)))
    (hv0 : ∀ x, Tendsto (fun t : ℝ => v t x) (𝓝[<] t₀) (𝓝 (c x))) :
    ∀ t, t < t₀ → u t = v t := by
  refine eq_of_backward_hasDerivAt_of_tendsto G ?_ ?_ ?_
  · -- hA for A := -S.laplacian + S.scalarMul
    intro u
    have h1 : ∑ x, u x * (-S.laplacian + S.scalarMul) u x
        = -(∑ x, u x * S.laplacian u x) + ∑ x, u x * S.scalarMul u x := by
      simp only [LinearMap.add_apply, LinearMap.neg_apply]
      rw [Finset.sum_add_distrib, ← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl (fun x _ => by ring)
    rw [h1]
    have h2 : ∑ x, u x * S.laplacian u x ≤ 0 := by
      rw [hL]; exact G.laplacian_quadraticForm_nonpos u
    have h3 := hR u
    linarith
  · intro t ht x
    have hsub := (hu t ht x).sub (hv t ht x)
    have hlin : (-(S.laplacian (u t) x) + S.scalarMul (u t) x) - (-(S.laplacian (v t) x) + S.scalarMul (v t) x)
        = (-S.laplacian + S.scalarMul) (u t - v t) x := by
      simp only [LinearMap.add_apply, LinearMap.neg_apply, map_sub, Pi.sub_apply]
      ring
    rw [hlin] at hsub
    exact hsub
  · intro x
    simpa only [Pi.sub_apply, sub_self] using (hu0 x).sub (hv0 x)
```
Hmm, `(-S.laplacian + S.scalarMul) (u t - v t) x`: the LinearMap addition is pointwise, `-S.laplacian` is the negated linear map. `simp only [LinearMap.add_apply, LinearMap.neg_apply, map_sub, Pi.sub_apply]` should unfold everything to `-(S.laplacian (u t) x - S.laplacian (v t) x) + (S.scalarMul (u t) x - S.scalarMul (v t) x)`; then `ring`. Good.

Then Part IV: the finite conjugate model.
```
noncomputable def finiteConjugateSpacetime (G) : ConjugateHeatSpacetime X where
  volume := Measure.count
  laplacian := G.laplacian
  scalarMul := 0
  backwardTimeDerivative := 0

noncomputable def finiteConjugateKernel (G) (t₀ : ℝ) (x y : X) (t : ℝ) : ℝ :=
  finiteHeatKernel G x y (t₀ - t)

theorem finiteConjugateKernel_pos (G) {t₀ t : ℝ} (ht : t < t₀) (x y : X) :
    0 < finiteConjugateKernel G t₀ x y t :=
  finiteHeatKernel_pos G (sub_pos.mpr ht) x y

theorem finiteConjugateKernel_hasDerivAt (G) (t₀ : ℝ) (x y : X) {t : ℝ} (ht : t < t₀) :
    HasDerivAt (fun s : ℝ => finiteConjugateKernel G t₀ x y s)
      (-(G.laplacian (fun z => finiteConjugateKernel G t₀ z y t) x) + (0 : X → ℝ) x) t := by
  have hs : 0 < t₀ - t := sub_pos.mpr ht
  have h1 : HasDerivAt (fun r : ℝ => finiteHeatKernel G x y r)
      (G.laplacian (fun z => finiteHeatKernel G z y (t₀ - t)) x) (t₀ - t) :=
    finiteHeatKernel_hasDerivAt G x y hs
  have h2 : HasDerivAt (fun s : ℝ => t₀ - s) (-1) t := by
    simpa using (hasDerivAt_const t t₀).sub (hasDerivAt_id t)
  have h3 := h1.comp t h2
  -- derivative: Δ K(·,y,t₀-t) * (-1)
  have hfun : (fun z : X => finiteConjugateKernel G t₀ z y t) = fun z => finiteHeatKernel G z y (t₀ - t) := rfl
  have hder : G.laplacian (fun z => finiteHeatKernel G z y (t₀ - t)) x * (-1)
      = -(G.laplacian (fun z => finiteConjugateKernel G t₀ z y t) x) + (0 : X → ℝ) x := by
    rw [hfun]; ring
  rw [hder] at h3
  exact h3
```
Careful with `finiteConjugateKernel` unfolding: `finiteConjugateKernel G t₀ x y s = finiteHeatKernel G x y (t₀ - s)`, so the function matches.

Dirac:
