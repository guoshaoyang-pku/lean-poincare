```lean
import Poincare.D13.HeatKernelBridge.FiniteSpaceHeat
import Poincare.D13.HeatKernelBridge.PDERepair

set_option linter.style.haveILetI false
...
open MeasureTheory Filter
open scoped Topology

namespace Poincare.D13.HeatKernelBridge

open Poincare.D11.HeatKernelBridge
open Poincare.D12.HeatDomain
open Poincare.D7.HeatKernel

namespace FiniteHeatOperator
variable {X : Type*} [Fintype X] [DecidableEq X]

/-- The energy (squared ℓ² norm) of a function on the finite space. -/
def energy (u : X → ℝ) : ℝ := ∑ x, (u x)^2

theorem energy_nonneg (u : X → ℝ) : 0 ≤ energy u := Finset.sum_nonneg fun x _ => sq_nonneg _

theorem energy_eq_zero_iff {u : X → ℝ} : energy u = 0 ↔ u = 0 := by
  constructor
  · intro h
    funext x
    have hx : (u x)^2 = 0 := (Finset.sum_eq_zero_iff_of_nonneg (fun y _ => sq_nonneg (u y))).mp h x (Finset.mem_univ x)
    exact pow_eq_zero_iff (n := 2) (by norm_num) |>.mp hx  -- hmm: `sq_eq_zero_iff`
  · intro h; simp [energy, h]
```
