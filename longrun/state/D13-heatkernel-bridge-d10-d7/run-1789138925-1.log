```lean
theorem energy_antitoneOn (G : FiniteHeatOperator X) (u : ℝ → X → ℝ)
    (h : ∀ t, 0 < t → ∀ x, HasDerivAt (fun s : ℝ => u s x) (G.laplacian (u t) x) t)
    {ε T : ℝ} (hε : 0 < ε) (hεT : ε ≤ T) :
    AntitoneOn (fun t : ℝ => G.energy (u t)) (Set.Icc ε T) := by
  refine antitoneOn_of_deriv_nonpos (convex_Icc ε T) ?_ ?_ ?_
  · -- ContinuousOn
    intro t ht
    exact ((hasDerivAt_energy G u (fun x => h t (lt_of_lt_of_le hε ht.1) x)).continuousAt).continuousWithinAt
  · -- DifferentiableOn on interior
    rw [interior_Icc]
    intro t ht
    exact (hasDerivAt_energy G u (fun x => h t ht.1 x)).differentiableAt.differentiableWithinAt
  · rw [interior_Icc]
    intro t ht
    rw [(hasDerivAt_energy G u (fun x => h t ht.1 x)).deriv]
    exact mul_nonpos_of_nonneg_of_nonpos (by norm_num) (G.laplacian_quadraticForm_nonpos (u t))
```
