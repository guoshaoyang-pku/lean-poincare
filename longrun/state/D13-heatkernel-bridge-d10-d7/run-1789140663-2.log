section MatrixExpGeneral
variable {X : Type*} [Fintype X] [DecidableEq X]

/-- Shift decomposition for an arbitrary matrix. -/
theorem matrix_exp_smul_shift_eq (A : Matrix X X ℝ) (c s : ℝ) :
    NormedSpace.exp (s • A) =
      NormedSpace.exp (-(s * c)) • NormedSpace.exp (s • (A + c • (1 : Matrix X X ℝ))) := by
  have hsplit : s • A = s • (A + c • 1) + (-(s * c)) • (1 : Matrix X X ℝ) := by
    rw [smul_add, smul_smul]
    rw [add_assoc, ← add_smul, add_neg_cancel, zero_smul, add_zero]
  ...
```
