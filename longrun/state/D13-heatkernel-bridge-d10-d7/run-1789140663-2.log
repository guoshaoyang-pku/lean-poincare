/-- Pointwise multiplication by a coefficient function, as a linear map. -/
noncomputable def scalarMulLin (R : X → ℝ) : (X → ℝ) →ₗ[ℝ] (X → ℝ) where
  toFun u := fun x => R x * u x
  map_add' u v := by ext x; simp [mul_add]
  map_smul' c u := by ext x; simp [mul_comm, mul_left_comm, mul_assoc]
