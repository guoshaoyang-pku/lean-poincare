```lean
/-- The minimum off-diagonal weight ... -/
noncomputable def minWeight (G : FiniteHeatOperator X) (h : ∃ x y : X, x ≠ y) : ℝ :=
  ((Finset.univ.filter (fun p : X × X => p.1 ≠ p.2)).image (fun p : X × X => G.L p.1 p.2)).min'
    (by
      obtain ⟨x, y, hxy⟩ := h
      exact ⟨G.L x y, Finset.mem_image.mpr
        ⟨(x, y), Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxy⟩, rfl⟩⟩)
```
Note `Finset.mem_image.mpr : (∃ a ∈ s, f a = b) → b ∈ s.image f`. The witness must be `⟨(x,y), proof_mem, rfl⟩`? `mem_image : b ∈ s.image f ↔ ∃ a ∈ s, f a = b`. So `⟨(x,y), hm, rfl⟩`.

