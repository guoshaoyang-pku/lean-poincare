```lean
theorem sum_laplacian_eq_zero (G : FiniteHeatOperator X) (u : X → ℝ) :
    ∑ x, G.laplacian u x = 0 := by
  simp only [laplacian_apply, Matrix.mulVec, dotProduct]
  rw [Finset.sum_comm]
