```lean
/-- The combinatorial Dirichlet gap of the pinned operator: `card X * w` where `w` is the smallest
off-diagonal weight. -/
noncomputable def dirichletGap (G : FiniteHeatOperator X) (h : ∃ x y : X, x ≠ y) : ℝ :=
  (Fintype.card X : ℝ) * G.minWeight h

theorem dirichletGap_pos (G) (h) : 0 < G.dirichletGap h := by
  have h1 : (0 : ℝ) < (Fintype.card X : ℝ) := by exact_mod_cast Fintype.card_pos
  exact mul_pos h1 (G.minWeight_pos h)
```
