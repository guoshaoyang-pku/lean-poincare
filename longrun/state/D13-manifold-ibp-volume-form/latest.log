```lean
section Model

open OverlapAtlas

/-- **The general constructed-POU cover theorem consumed on the half-space model** ... -/
theorem halfSpaceAtlas_weightedIBP_of_cover (G : ChartMetric (n + 1))
    (f u v : Vec (n + 1) → ℝ)
    (hf : ContDiff ℝ 2 f) (hu : ContDiff ℝ 2 u) (hv : ContDiff ℝ 2 v)
    (hvc : HasCompactSupport v) (hvsupp : tsupport v ⊆ {y : Vec (n + 1) | y 0 < 1}) :
    ∫ m, G.driftLaplacian f u m * v m ∂... = -∫ m, G.gradInnerInverse u v m ∂... := by
  set A : SmoothOverlapAtlas (Vec (n+1)) (n+1) := hsAtlas (n := n) G with hA
  have hchart0 : A.chart 0 = ... := hsChart_zero
  ... (hfc huc hvc', hD, hG, support facts)
  refine A.globalWeightedIBP_of_cover_partial_ae htrans 0 (fun j : Fin 2 => (j:ℕ)) f u v
    (G.driftLaplacian f u) (G.gradInnerInverse u v) hf.continuous.measurable hv.continuous.measurable
    (G.driftLaplacian_continuous f u hf hu).measurable (G.gradInnerInverse_continuous u v hu hv).measurable
    hvsupp' hfc huc hvc' hvcc htsupp hcover hD hG hGuvsupp
    (fun i j K hK => halfSpaceAtlas_transition_preimage_isCompact G i j hK)
    (halfSpaceAtlas_frontier_volume_zero G)
```
