```lean
variable {n : ℕ}

/-- The smooth step in the first coordinate, supported in `{1/4 ≤ y 0 ≤ 1/2}`. -/
def hsStep (y : Vec (n + 1)) : ℝ := Real.smoothTransition (4 * y 0 - 1)

lemma hsStep_zero {y : Vec (n+1)} (h : y 0 ≤ 1/4) : hsStep y = 0 := by
  apply Real.smoothTransition.zero_of_nonpos
  linarith

lemma hsStep_one {y} (h : 1/2 ≤ y 0) : hsStep y = 1 := by
  apply Real.smoothTransition.one_of_one_le
  linarith

lemma contDiff_hsStep : ContDiff ℝ ∞ (hsStep (n := n)) := by
  unfold hsStep
  fun_prop   -- maybe: exact Real.smoothTransition.contDiff.comp ((contDiff_const.mul contDiff_apply).sub contDiff_const)
```
