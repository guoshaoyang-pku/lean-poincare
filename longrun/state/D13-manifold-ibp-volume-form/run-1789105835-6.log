import Poincare.D12.VolumeIBP.ChangeOfVariables
import Mathlib.Analysis.InnerProductSpace.Orientation
import Mathlib.Analysis.InnerProductSpace.PiL2  -- stdOrthonormalBasis

namespace Poincare.D13.VolumeForm

open scoped BigOperators

abbrev Vec (d : ℕ) := Poincare.D12.VolumeIBP.Vec d  -- reuse D12's

-- the standard Euclidean orientation on Vec d
noncomputable def stdOrientation (d : ℕ) : Orientation ℝ (Vec d) (Fin d) := by
  letI : Fact (Module.finrank ℝ (Vec d) = d) := ⟨by
    change Module.finrank ℝ (Fin d → ℝ) = d
    simp [Module.finrank_fintype_fun_eq_card]⟩  -- hmm, simp may need Fintype.card_fin
  exact (stdOrthonormalBasis (𝕜 := ℝ) (ι := Fin d)).toBasis.orientation

noncomputable def euclideanVolumeForm (d : ℕ) : AlternatingMap ℝ (Vec d) (Fin d) ℝ := by
  letI : Fact (Module.finrank ℝ (Vec d) = d) := ...
  exact (stdOrientation d).volumeForm

-- chart volume form of ChartMetric G: ω_G(x) = ρ_G(x) • euclideanVolumeForm
noncomputable def chartVolumeForm {d : ℕ} (G : ChartMetric d) (x : Vec d) :
    AlternatingMap ℝ (Vec d) (Fin d) ℝ :=
  G.density x • euclideanVolumeForm d

-- det formula: ω_G(x) v = ρ_G(x) * det(Matrix.of fun i j => v j i)... careful with column convention
theorem chartVolumeForm_apply (G : ChartMetric d) (x : Vec d) (v : Fin d → Vec d) :
    G.chartVolumeForm x v = G.density x * (Matrix.of (fun i j => v i j)).det := ...
```

