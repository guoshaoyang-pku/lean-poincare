```lean
import Poincare.D13.VolumeForm.Transformation

namespace Poincare.D13.VolumeForm

-- Finite partition of unity datum on the chart: weights φᵢ : Vec d → ℝ, nonneg, sum = 1
structure ChartPartitionOfUnity (d ι : ℕ) where
  phi : Fin ι → Vec d → ℝ
  nonneg : ∀ i x, 0 ≤ phi i x
  sum_eq_one : ∀ x, (∑ i, phi i x) = 1

-- Gluing theorem: chart densities rhoᵢ compatible (equal on overlaps — here on the whole chart, stated as "all equal to a common rho" or pairwise) => glued density rho = Σ φᵢ ρᵢ:
-- (a) nonneg, (b) Σᵢ ∫ f·φᵢ·ρᵢ = ∫ f·ρ when ρᵢ agree on supp φᵢ...
```

