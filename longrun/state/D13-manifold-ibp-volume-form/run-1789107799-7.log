```lean
namespace Poincare.D13.CertificateOn
open Poincare.Longrun.Entropy

structure ContinuousMonotoneCertificateOn {X} [MeasurableSpace X] {μ : Measure X}
    (E : ℝ → EntropyData X μ) (a b : ℝ) : Type where
  dissipation : ℝ → ℝ
  hasDerivAt_F : ∀ t ∈ Ioo a b, HasDerivAt (fun s => (E s).F) (dissipation t) t
  continuousOn_F : ContinuousOn (fun s => (E s).F) (Icc a b)
  dissipation_nonneg : ∀ t ∈ Ioo a b, 0 ≤ dissipation t
  upperBound : ℝ
  upper_le : ∀ t ∈ Icc a b, (E t).F ≤ upperBound

theorem ContinuousMonotoneCertificateOn.monotoneOn (c) : MonotoneOn (fun s => (E s).F) (Icc a b) := by
  apply monotoneOn_of_deriv_nonneg (convex_Icc a b) c.continuousOn_F
  · intro x hx
    exact ((c.hasDerivAt_F x (interior_subset hx)).differentiableAt).differentiableWithinAt
  · intro x hx
    rw [(c.hasDerivAt_F x (interior_subset hx)).deriv]
    exact c.dissipation_nonneg x (interior_subset hx)
```
Note `interior_Icc = Ioo a b`. 

