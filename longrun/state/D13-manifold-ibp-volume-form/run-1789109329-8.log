```lean
import Poincare.D13.ManifoldIBP.Transfer

namespace Poincare.D13.ManifoldIBP

/-- The concrete disjoint-atlas manifold model: the sigma type of charts. -/
abbrev DisjointAtlas (n ι : ℕ) := Σ i : Fin ι, Vec (n + 1)

/-- The weighted chart measure on chart `i`: Riemannian measure with the entropy weight
`e^{-f_i}`. -/
def weightedChartMeasure (D : ChartSumData n ι) (f : Fin ι → Vec (n+1) → ℝ) (i : Fin ι) :
    Measure (Vec (n+1)) :=
  (D.metric i).riemannianMeasure.withDensity (fun x => ENNReal.ofReal (Real.exp (-(f i x))))

/-- The manifold measure on the disjoint atlas: sum over charts. -/
def disjointAtlasMeasure (D) (f) : Measure (DisjointAtlas n ι) :=
  Measure.sum (fun i => (weightedChartMeasure D f i).map (fun x => Sigma.mk i x))
```

