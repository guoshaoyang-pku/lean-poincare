```
/-- **A concrete overlapping atlas with a non-trivial Jacobian**: the identity chart and a
dilation chart `x ↦ c • x` with `c ≠ 0`, both with source `univ`, carrying the pullback
metric `c² • G(c • ·)` of a chart metric `G`. The transition Jacobian is `c • 1`, so the
density transforms by the genuine factor `|c|^d`. -/
def dilationAtlas (c : ℝ) (hc : c ≠ 0) (G : ChartMetric d) : OverlapAtlas (Vec d) d where
  chart n := if n = 0 then id else fun x => c • x
  source _ := univ
  isOpen_source _ := isOpen_univ
  measurable_chart n := by
    by_cases h : n = 0
    · simp [h]
    · simp only [h, if_false]; exact (continuous_const_smul c).measurable
  injOn_chart n := by
    by_cases h : n = 0
    · simp [h]
    · simp only [h, if_false]
      intro x _ y _ hxy
      exact smul_right_injective (Vec d) hc hxy  -- or: exact (smul_left_injective ...)
  cover := by
    rw [eq_univ_iff_forall]
    intro x
    exact mem_iUnion.mpr ⟨0, ⟨x, mem_univ x, by simp⟩⟩
  measurableSet_image n := by
    by_cases h : n = 0 <;> simp [h]   -- image univ = univ
  metric n := if n = 0 then G else G.dilationMetric c
  transition i j y := if i = 0 then (if j = 0 then y else c • y) else (if j = 0 then c⁻¹ • y else y)
  transition_mem := by intro i j y hy; simp
  transition_chart := by
    intro i j y hy
    by_cases hi : i = 0 <;> by_cases hj : j = 0 <;> simp [chart, transition, hi, hj, ...]
  transition_diff := ...
  metric_transform := ...
```

