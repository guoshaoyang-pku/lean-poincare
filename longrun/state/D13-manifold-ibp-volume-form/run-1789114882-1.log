/-- **Restriction to a chart**: the global measure restricted to a chart image is the chart
measure restricted to it. This is the form used to transfer integrals of functions whose
support lies in a single chart. -/
theorem globalMeasure_restrict_eq_chartMeasure (μ : Measure (Vec d)) [μ.IsAddHaarMeasure]
    (i : ℕ) :
    (A.globalMeasure μ).restrict (A.chart i '' A.source i)
      = (A.chartMeasure μ i).restrict (A.chart i '' A.source i) := by
  apply Measure.ext
  intro s hs
  rw [Measure.restrict_apply hs, Measure.restrict_apply hs]
  exact A.globalMeasure_apply_chart μ i (hs.inter (A.measurableSet_image i))
