namespace Poincare.D13.ManifoldIBP

variable {M : Type*} [MeasurableSpace M] {d : ℕ}

/-- An overlapping atlas ... -/
structure OverlapAtlas (M : Type*) [MeasurableSpace M] (d : ℕ) where
  chart : ℕ → Vec d → M
  source : ℕ → Set (Vec d)
  isOpen_source : ∀ i, IsOpen (source i)
  measurable_chart : ∀ i, Measurable (chart i)
  injOn_chart : ∀ i, InjOn (chart i) (source i)
  cover : (⋃ i, chart i '' source i) = univ
  metric : ℕ → ChartMetric d
  transition : ℕ → ℕ → Vec d → Vec d
  transition_spec : ∀ i j y, y ∈ source j → chart j y ∈ chart i '' source i →
    transition i j y ∈ source i ∧ chart i (transition i j y) = chart j y
  transition_diff : ∀ i j y, y ∈ source j → chart j y ∈ chart i '' source i →
    DifferentiableWithinAt ℝ (transition i j) (overlap i j) y
  metric_transform : ∀ i j y (hy : y ∈ source j) (hy' : chart j y ∈ chart i '' source i),
    (metric j).matrix y =
      (LinearMap.toMatrix (Pi.basisFun ℝ (Fin d)) (Pi.basisFun ℝ (Fin d))
        (fderivWithin ℝ (transition i j) (overlap i j) y).toLinearMap)ᵀ
      * (metric i).matrix (transition i j y)
      * LinearMap.toMatrix ... 
```

