  have hmem : ∀ y ∈ S, A.chart j y ∈ s ∧ y ∈ A.source j := fun y hy => ⟨hy.2, hy.1⟩
  have hover : ∀ y ∈ S, y ∈ overlapOf A.chart A.source i j := fun y hy =>
    ⟨hy.1, hsi hy.2⟩
  have hderiv : ∀ y ∈ S, HasFDerivWithinAt τ (fderivWithin ℝ τ (overlapOf A.chart A.source i j) y) S y := by
    intro y hy
    have h := (A.transition_diff i j y (hover y hy)).hasFDerivWithinAt
    exact h.mono (fun z hz => hover z hz)
