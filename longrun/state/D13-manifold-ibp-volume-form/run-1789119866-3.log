    chartCoord B i v = B.repr v i := rfl

theorem trivializationAt_symm_eq_sum (B : Basis ι ℝ E) (α : M) (x : M) (a : E)
    (hx : x ∈ (chartAt H α).source) :
    (trivializationAt E (TangentSpace I) α).symm x a
      = ∑ i, chartCoord B i a • (trivializationAt E (TangentSpace I) α).symm x (B i) := by
  rw [← Bundle.Trivialization.coe_symmₗ (R := ℝ) (trivializationAt E (TangentSpace I) α) hx]
  conv_lhs => rw [← Module.Basis.sum_repr B a]
  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_smul]
  rfl

def chartGramMatrix (B : Basis ι ℝ E) (α : M) (x : M) : Matrix ι ι ℝ :=
  Matrix.of fun i j =>
    inner ℝ ((trivializationAt E (TangentSpace I) α).symm x (B i))
      ((trivializationAt E (TangentSpace I) α).symm x (B j))

@[simp] lemma chartGramMatrix_apply (B : Basis ι ℝ E) (α : M) (x : M) (i j : ι) : ...

def chartFrameVec (B : Basis ι ℝ E) (α : M) (i : ι) (x : M) : TangentSpace I x :=
  (trivializationAt E (TangentSpace I) α).symm x (B i)

lemma chartGramMatrix_eq_inner (B : Basis ι ℝ E) (α : M) (x : M) (i j : ι) : ...

theorem chartFrameVec_eq_symm_tangentCoordChange (B : Basis ι ℝ E) (α β : M) {x : M}
    (hxα ...) (hxβ ...) (i : ι) : chartFrameVec (I := I) B β i x = (trivializationAt ... α).symm x (tangentCoordChange I β α x (B i)) := ...

lemma chartGramMatrix_inner_eq_sum (B : Basis ι ℝ E) (α : M) (x : M) (u v : E) (hx : ...) :
    inner ℝ ((trivializationAt ... α).symm x u) ((trivializationAt ... α).symm x v)
      = ∑ a, ∑ b, chartGramMatrix (I := I) B α x a b * chartCoord B a u * chartCoord B b v := ...

theorem chartGramMatrix_change_apply (B : Basis ι ℝ E) (α β : M) {x : M} ... (i j : ι) : ...

theorem chartGramMatrix_change (B : Basis ι ℝ E) (α β : M) {x : M} ... :
