  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ (Vec d) H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
  [RiemannianBundle (TangentSpace I : M → Type _)]
  [IsContMDiffRiemannianBundle I ∞ (Vec d) (TangentSpace I : M → Type _)]

/-- the genuine chart metric coefficient, as a function of the coordinates -/
def chartMetricCoeff (α : M) (y : Vec d) (i j : Fin d) : ℝ :=
  (chartMetricMatrix (I := I) α y) i j

/-- the junk extension off the chart target (identity matrix there) -/
def chartMetricCoeffExt (α : M) (y : Vec d) (i j : Fin d) : ℝ :=
  if y ∈ (extChartAt I α).target then chartMetricCoeff (I := I) α y i j
  else if i = j then 1 else 0

lemma contDiffOn_chartMetricCoeff (α) (i j) :
    ContDiffOn ℝ ⊤ (fun y => chartMetricCoeff (I := I) α y i j) (extChartAt I α).target :=
  contDiffOn_chartGramMatrix_coord (I := I) (Pi.basisFun ℝ (Fin d)) α i j

lemma chartMetricCoeffExt_eq (α) {y} (hy : y ∈ (extChartAt I α).target) (i j) :
    chartMetricCoeffExt (I := I) α y i j = chartMetricCoeff (I := I) α y i j := by
  simp [chartMetricCoeffExt, hy]

lemma chartMetricCoeffExt_of_notMem (α) {y} (hy : y ∉ (extChartAt I α).target) (i j) :
    chartMetricCoeffExt (I := I) α y i j = if i = j then 1 else 0 := by
  simp [chartMetricCoeffExt, hy]

