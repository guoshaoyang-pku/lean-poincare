    convert h using 1
    ext i j
    simp [chartMetricCoeffExt, chartMetricCoeff, chartMetricMatrix, hy]
  · -- identity
    rw [show Matrix.of (chartMetricCoeffExt (I := I) α y) = 1 by
      ext i j; simp [chartMetricCoeffExt, hy]]
    exact Matrix.PosDef.one
```
