def halfSpaceAtlas (G : ChartMetric (n + 1)) : SmoothOverlapAtlas (Vec (n + 1)) (n + 1) where
  toOverlapAtlas :=
    { chart := hsChart
      source := hsSource
      isOpen_source i := by
