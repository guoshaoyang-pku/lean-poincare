    (hψ_sm : ∀ i, ContDiff ℝ ∞ (ψ i))
    (hψ_supp : ∀ i, tsupport (ψ i) ⊆ ball (0 : Vec (n + 1)) (R + 1))
    (hψ_sum : ∀ x ∈ tsupport V, ∑ i, ψ i x = 1)
