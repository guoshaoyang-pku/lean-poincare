-- second derivative test
lemma deriv_deriv_nonpos_of_isLocalMax {f : ℝ → ℝ} {x c : ℝ}
    (hmax : IsLocalMax f x) (hf : HasDerivAt f (deriv f x) x)
    (hdd : HasDerivAt (deriv f) c x) : c ≤ 0 := ...

-- helper: interior spatial maximizer of slab solution has nonpositive second derivative
-- the slab data over X = Icc a b as subtype
def slabW (u : ℝ → ℝ → ℝ) : Icc a b → ℝ → ℝ := fun x t => u x.1 t

-- main: for T' < T version via Topping
theorem slab_nonpos_le_T' (u a b T T') (hT' : 0 ≤ T') (hT'lt : T' < T)
    (h : ContinuousHeatHypotheses u a b T) (hab : a ≤ b)
    (hC2 : ∀ x t, x ∈ Ioo a b → t ∈ Ioo 0 T →
      HasDerivAt (fun y => u y t) (deriv (fun y => u y t) x) x ∧
      HasDerivAt (deriv (fun y => u y t)) (iteratedDeriv 2 (fun y => u y t) x) x) :
    ∀ x, x ∈ Icc a b → ∀ t, t ∈ Icc 0 T' → u x t ≤ 0 := ...

-- extension to T
theorem continuousHeatMaximumPrinciple_of_topping (u a b T)
    (hab : a ≤ b) (h : ContinuousHeatHypotheses u a b T)
    (hC2 : ...) :
    ∀ x, x ∈ Icc a b → ∀ t, t ∈ Icc 0 T, u x t ≤ 0 := ...
```

