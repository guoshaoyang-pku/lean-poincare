def SlabRegularity (u : ℝ → ℝ → ℝ) (a b T : ℝ) : Prop :=
  (∀ x t, x ∈ Icc a b → t ∈ Ioo 0 T →
    HasDerivAt (fun s => u x s) (deriv (fun s => u x s) t) t) ∧
  (∀ x t, x ∈ Ioo a b → t ∈ Ioo 0 T →
