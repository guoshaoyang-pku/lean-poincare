abbrev Euc (n : ℕ) := EuclideanSpace ℝ (Fin n)

-- upstream Soliton.lean:239
def solitonScale (lambda t : ℝ) : ℝ := 1 - 2 * lambda * t

-- upstream Soliton.lean:85-87 metricLieDerivativeAt, flat transcription:
-- L_X g (v,w) = ⟨DX(v), w⟩ + ⟨v, DX(w)⟩
def metricLieDerivativeFlat {n : ℕ} (X : Euc n → Euc n) (x v w : Euc n) : ℝ :=
  ⟪fderiv ℝ X x v, w⟫_ℝ + ⟪v, fderiv ℝ X x w⟫_ℝ

-- upstream (GSS) IsGradientShrinkerPotential (Soliton.lean:183), Euclidean transcription
def IsGradientShrinkerPotentialEuclidean (n : ℕ) (τ : ℝ) (f : Euc n → ℝ) (lambda : ℝ) : Prop :=
  ContDiff ℝ ∞ f ∧ 0 < lambda ∧
    ∀ x v w, -(0 : ℝ) = iteratedFDeriv ℝ 2 f x ![v, w] - lambda * ⟪v, w⟫_ℝ

-- upstream IsSolitonGenerator (Soliton.lean:109), Euclidean transcription
def IsSolitonGeneratorEuclidean (n : ℕ) (τ : ℝ) (X : Euc n → Euc n) (lambda : ℝ) : Prop :=
  ∀ x v w, -(0 : ℝ) = (1/2 : ℝ) * metricLieDerivativeFlat X x v w - lambda * ⟪v, w⟫_ℝ
```

