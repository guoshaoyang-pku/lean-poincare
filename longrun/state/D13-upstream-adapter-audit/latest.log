```lean
import Poincare.D7.Kappa.Basic
import Poincare.D7.Reduced.Certificate
import Mathlib.Data.Real.ENNReal
import Mathlib.Topology.MetricSpace.Pseudo.Defs

namespace Poincare.D13.UpstreamAdapter.KleinerLott

open MeasureTheory Set
open scoped Topology ENNReal

-- transcriptions
structure RicciFlowData (M : Type*) where
  dist : ℝ → M → M → ℝ
  curvatureNorm : M → ℝ → ℝ
  volume : ℝ → Set M → ℝ

namespace RicciFlowData

def ball {M : Type*} (flow : RicciFlowData M) (t : ℝ) (x₀ : M) (r : ℝ) : Set M :=
  {x | flow.dist t x₀ x < r}

def HasCurvatureBoundOnParabolicBall {M : Type*} (flow : RicciFlowData M)
    (x₀ : M) (t₀ r bound : ℝ) : Prop :=
  ∀ x ∈ flow.ball t₀ x₀ r, ∀ t ∈ Set.Icc (t₀ - r ^ 2) t₀, flow.curvatureNorm x t ≤ bound

end RicciFlowData

def IsKappaNoncollapsedOnScale {M : Type*} (flow : RicciFlowData M) (n : ℕ)
    (T kappa rho : ℝ) : Prop :=
  ∀ x₀ t₀ r, 0 < r → r < rho → r ^ 2 ≤ t₀ → t₀ < T →
    flow.HasCurvatureBoundOnParabolicBall x₀ t₀ r ((r⁻¹) ^ 2) →
      kappa * r ^ n ≤ flow.volume t₀ (flow.ball t₀ x₀ r)

def IsKappaCollapsedAt {M : Type*} (flow : RicciFlowData M) (n : ℕ)
    (kappa r t₀ : ℝ) (x₀ : M) : Prop :=
  0 < r ∧
    flow.HasCurvatureBoundOnParabolicBall x₀ t₀ r ((r⁻¹) ^ 2) ∧
      flow.volume t₀ (flow.ball t₀ x₀ r) ≤ kappa * r ^ n

-- conditional adapter
theorem isKappaNoncollapsedOnScale_to_kappaNoncollapsingCertificate
    {M : Type*} [PseudoEMetricSpace M] [MeasurableSpace M]
    (flow : RicciFlowData M) (μ : Measure M) (K : CurvatureBoundedOn M)
    {T t₀ κ ρ r₀ : ℝ} (ht₀T : t₀ < T) (hr₀ : 0 < r₀) (hr₀ρ : r₀ < ρ) (hscale : ρ ^ 2 ≤ t₀)
    (hκ : 0 < κ)
    (hvol : ∀ x r, 0 < r → flow.volume t₀ (flow.ball t₀ x r) ≤ μ (Metric.eball x (ENNReal.ofReal r)))
    (hcurv : ∀ x r, 0 < r → K x r → flow.HasCurvatureBoundOnParabolicBall x t₀ r ((r⁻¹) ^ 2))
    (hkl : IsKappaNoncollapsedOnScale flow 3 T κ ρ) :
    KappaNoncollapsingCertificate M μ K κ r₀ where
  kappa_pos := hκ
  r0_pos := hr₀
  volume_ball_lower := by
    intro x r hr hr₀le hK
    have hbound : flow.HasCurvatureBoundOnParabolicBall x t₀ r ((r⁻¹) ^ 2) := hcurv x r hr hK
    have hkl' := hkl x t₀ r hr (lt_of_le_of_lt hr₀le hr₀ρ) (by
      calc r ^ 2 ≤ ρ ^ 2 := sq_le_sq.mpr (le_of_lt (lt_of_le_of_lt hr₀le hr₀ρ))? -- hmm r ≤ ρ via r ≤ r₀ < ρ
      _ ≤ t₀ := hscale) ht₀T hbound
    have hvol' := hvol x r hr
    exact ENNReal.ofReal_le_ofReal (le_trans hkl' hvol')  -- wait: hkl' : κ * r^3 ≤ flow.volume ... (ℝ); hvol' : flow.volume ... ≤ μ (eball) (ℝ vs ENNReal!!)
