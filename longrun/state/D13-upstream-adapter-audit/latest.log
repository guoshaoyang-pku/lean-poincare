```lean
def BoundedClass (X : Type*) [TopologicalSpace X] [MeasurableSpace X] (μ : Measure X) :
    Set (X → ℝ) := {f | Continuous f ∧ ∃ M : ℝ, ∀ y, |f y| ≤ M}

-- on a finite-measure space with enough regularity, the bounded continuous class is an AdmissibleTestClass
theorem boundedClass_isAdmissible [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    (μ : Measure X) [IsFiniteMeasure μ] :
    AdmissibleTestClass X μ where
  cls := BoundedClass X μ
  cls_continuous := fun f hf => hf.1
  cls_integrable := fun f hf => by
    rcases hf with ⟨hfcont, M, hM⟩
    have hbcf : BoundedContinuousFunction X ℝ := BoundedContinuousFunction.mkOfBound hfcont M (fun y => by simpa using le_of_lt (hM y))  -- need exact signature
