/-- `1 + x₀ ≠ 0` for a point of `S3` that is not the south pole. -/
theorem one_add_firstCoord_ne_zero {x : S3} (hx : x ≠ southPole) : (1 : ℝ) + (x : R4) 0 ≠ 0 := by
  intro h
  have h0 : (x : R4) 0 = -1 := by linarith
  apply hx
  apply Subtype.ext
  change (x : R4) = (southPole : R4)
  rw [← consVec3_self_tail (x : R4)]
  rw [h0]
  -- consVec3 (-1) (tailVec (x : R4)) = consVec3 (-1) 0: need tailVec (x : R4) = 0
  congr 1
  -- ‖tailVec x‖ = 0
  have hnorm := sphere_norm_eq_one x
  have hsq : (x : R4) 0 ^ 2 + ‖tailVec (x : R4)‖ ^ 2 = 1 := by
    simpa [norm_sq_consVec3] using congrArg (fun t : ℝ => t ^ 2) hnorm
  have : ‖tailVec (x : R4)‖ ^ 2 = 0 := by nlinarith [sq_nonneg ‖tailVec (x : R4)‖]
  exact norm_eq_zero.mp (sq_eq_zero_iff.mp this)
```
