  have hk_lt : k < N := lt_of_le_of_ne hk_le hkN
  have hkm1 : k - 1 < N + 1 := by omega
  have hkp1 : k + 1 < N + 1 := by omega
  have h1 : u (k - 1) ≤ u k := hkmax (k - 1) (Finset.mem_range.mpr hkm1)
  have h2 : u (k + 1) ≤ u k := hkmax (k + 1) (Finset.mem_range.mpr hkp1)
