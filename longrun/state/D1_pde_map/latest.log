/-- Interface: a classical weak parabolic maximum principle for the heat equation on a
space-time slab. mathlib (as of the pinned revision) contains no heat-equation theory,
so this is stated as an explicit hypothesis-carrying structure rather than proved. -/
structure ParabolicMaxPrincipleInterface (u : ℝ → ℝ → ℝ) (a b T : ℝ) : Prop where
  /-- interior heat equation `u_t = u_xx` -/
  heat : ∀ x t, x ∈ Icc a b → t ∈ Ioo 0 T →
    deriv (fun s => u x s) t = iteratedDeriv 2 (fun y => u y t) x
  /-- continuity on the closed slab -/
  continuousOn : ContinuousOn (fun p : ℝ × ℝ => u p.1 p.2) (Icc a b ×ˢ Icc 0 T)
  /-- initial datum bounded by `B` -/
  initial_le : ∀ x ∈ Icc a b, u x 0 ≤ 0
  /-- lateral boundary data bounded by `0` -/
  lateral_le : ∀ t ∈ Icc 0 T, u a t ≤ 0 ∧ u b t ≤ 0
  /-- conclusion: the solution is bounded by `0` on the slab -/
  max_bound : ∀ x ∈ Icc a b, ∀ t ∈ Icc 0 T, u x t ≤ 0
```
