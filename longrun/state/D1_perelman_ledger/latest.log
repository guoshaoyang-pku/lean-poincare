theorem toyW_nonneg {α : Type*} [Fintype α] (n : ℕ) (τ : ℝ) (w R gradSq f : α → ℝ)
    (hw : ∀ x, 0 ≤ w x) (hterm : ∀ x, 0 ≤ τ * (gradSq x + R x) + f x - (n : ℝ)) :
    0 ≤ toyW n τ w R gradSq f := by
