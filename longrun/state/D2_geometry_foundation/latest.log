/-- A Riemannian metric datum on a real vector space, made explicit:
a symmetric positive-definite bilinear form together with a chosen
finite orthonormal basis (the explicit finite-dimensional assumption). -/
structure MetricData (V : Type v) [AddCommGroup V] [Module ℝ V]
    (ι : Type w) [Fintype ι] [DecidableEq ι] where
  form : V →ₗ[ℝ] V →ₗ[ℝ] ℝ
