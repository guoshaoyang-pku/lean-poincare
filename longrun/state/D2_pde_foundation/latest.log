import Mathlib

/-!
# `Poincare.Longrun.PDE.HeatGrid`

Finite-grid heat-evolution foundation for the long-run Poincaré project.

This file consumes the accepted `D1-pde-api-map` probe (see
`longrun/results/D1-pde-api-map.md`), which established that the pinned mathlib
(`leanprover/lean4:v4.34.0-rc2`, mathlib `7974e751…`) has **no** heat-equation
theory and no parabolic maximum principle, and that the finite-grid layer is the
part that can be fully checked now.

## Conventions (explicit)

* Space is the finite path `0, 1, …, N+1`; the points `0` and `N+1` are the
  Dirichlet boundary and are pinned to `0`.
* Time is discrete: `u t i` is the value at time step `t` and grid point `i`.
* The heat equation is written with the **positive** sign
  `∂ₜ u = ∂ₓ² u`; the forward-Euler (explicit) scheme is
  `u (t+1) i = u t i + α * (u t (i-1) - 2 * u t i + u t (i+1))`.
* `α ≥ 0` is the (nonnegative) time-step/space-step ratio `Δt / Δx²`.
  The stability (convexity) condition `α ≤ 1/2` is *not* a field of the
  structure; it is an explicit hypothesis of the maximum principle and of the
  energy-monotonicity theorem, so that the sign conventions are visible at every
  use site.
-/

open scoped BigOperators

namespace Poincare.Longrun.PDE

/-- Zero extension of a grid function past the right boundary. ... -/
def zeroExtend (u : ℕ → ℝ) (N : ℕ) : ℕ → ℝ := fun j => if j ≤ N + 1 then u j else 0

/-- The one-dimensional discrete Laplacian ... -/
def discreteLaplacian (w : ℕ → ℝ) (i : ℕ) : ℝ := w (i - 1) + w (i + 1) - 2 * w i

/-- One explicit-Euler heat step ... -/
def heatStep (α : ℝ) (w : ℕ → ℝ) (i : ℕ) : ℝ :=
  α * w (i - 1) + (1 - 2 * α) * w i + α * w (i + 1)

theorem heatStep_eq_discreteLaplacian (α : ℝ) (w : ℕ → ℝ) (i : ℕ) :
    heatStep α w i = w i + α * discreteLaplacian w i := by
  simp only [heatStep, discreteLaplacian]; ring

structure HeatGridEvolution (N : ℕ) (α : ℝ) where
  ...

theorem HeatGridEvolution.step_eq_discreteLaplacian ...
theorem HeatGridEvolution.step_eq_heatStep ...
theorem HeatGridEvolution.step_eq_convex ...
```

