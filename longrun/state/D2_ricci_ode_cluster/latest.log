```lean
import Poincare.Longrun.CurvatureODE.Evolution
import Mathlib.Analysis.Calculus.MeanValue
import Mathlib.Analysis.ODE.Gronwall

namespace Poincare.Longrun.CurvatureODE

section Scalar

/-- If `f` is continuous on `[a,b]`, has right derivative `f'` on `[a,b)`, and `f' ≤ 0`
there, then `f` is nonincreasing on `[a,b]`. -/
theorem le_left_of_hasDerivWithinAt_nonpos
    {f f' : ℝ → ℝ} {a b : ℝ}
    (hf : ContinuousOn f (Icc a b))
    (hf' : ∀ x ∈ Ico a b, HasDerivWithinAt f (f' x) (Ici x) x)
    (hmono : ∀ x ∈ Ico a b, f' x ≤ 0) :
    ∀ x ∈ Icc a b, f x ≤ f a := by
  have hB' : ∀ x ∈ Ico a b, HasDerivWithinAt (fun _ : ℝ => f a) (0 : ℝ) (Ici x) x :=
    fun x _ => hasDerivWithinAt_const
  exact image_le_of_deriv_right_le_deriv_boundary hf hf' (le_refl (f a)) continuousOn_const hB'
    (fun x hx => hmono x hx)

/-- Grönwall-style sign preservation: if `f a ≤ 0` and `f' ≤ c f` with `c ≥ 0`, then
`f ≤ 0` on `[a,b]`. -/
theorem le_zero_of_hasDerivWithinAt_le_mul
    {f f' : ℝ → ℝ} {c a b : ℝ} (hc : 0 ≤ c)
    (hf : ContinuousOn f (Icc a b))
    (hf' : ∀ x ∈ Ico a b, HasDerivWithinAt f (f' x) (Ici x) x)
    (ha : f a ≤ 0)
    (hbound : ∀ x ∈ Ico a b, f' x ≤ c * f x) :
    ∀ x ∈ Icc a b, f x ≤ 0 := by
  have hmain := le_gronwallBound_of_liminf_deriv_right_le (f := f) (f' := f') (δ := f a)
    (K := c) (ε := 0) (a := a) (b := b) hf
    (fun x hx r hr => by
      simpa [slope, smul_eq_mul] using (hf' x hx).liminf_right_slope_le hr)
    ha hbound
  intro x hx
  have hx' := hmain x hx
  rw [gronwallBound_ε0] at hx'
  exact hx'.trans (mul_nonpos_of_nonpos_of_nonneg ha (Real.exp_nonneg _))
```

