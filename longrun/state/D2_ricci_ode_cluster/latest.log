theorem nonneg_orthant_invariant (F : ReactionField ι) {T : ℝ}
    {traj : ℝ → ι → ℝ} (ev : EvolutionRelation F T traj)
    (h0 : ∀ i, 0 ≤ traj 0 i) :
    ∀ t ∈ Icc 0 T, ∀ i, 0 ≤ traj t i := by
  intro t ht i
  have hcont : ContinuousOn (fun s => -(traj s i)) (Icc 0 T) :=
    (ev.continuous i).neg
  have hderiv : ∀ x ∈ Ico 0 T,
      HasDerivWithinAt (fun s => -(traj s i)) (-(F.eval (traj x) i)) (Ici x) x :=
    fun x hx => (ev.hasDeriv i x hx).neg
  have hmono : ∀ x ∈ Ico 0 T, (-(F.eval (traj x) i)) ≤ 0 := by
    intro x hx
    exact neg_nonpos.mpr (F.eval_nonneg (traj x) i)
  have hle := le_left_of_hasDerivWithinAt_nonpos hcont hderiv hmono t ht
  have h0' : -(traj 0 i) ≤ 0 := neg_nonpos.mpr (h0 i)
  exact neg_nonneg.mp (hle.trans h0')
```

