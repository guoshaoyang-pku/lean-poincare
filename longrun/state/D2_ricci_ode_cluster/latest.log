import Poincare.Longrun.CurvatureODE.State

namespace Poincare.Longrun.CurvatureODE

/-- A finite-dimensional reaction field: `F_i(λ) = a_i * λ_i^2 + g_i(λ)`, with `a_i ≥ 0` and
