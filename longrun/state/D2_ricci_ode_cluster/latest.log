structure ReactionField (ι : Type w) where
  a : ι → ℝ
  g : (ι → ℝ) → ι → ℝ
  a_nonneg : ∀ i, 0 ≤ a i
  g_nonneg : ∀ λ i, 0 ≤ g λ i

namespace ReactionField

def eval (F : ReactionField ι) (λ : ι → ℝ) (i : ι) : ℝ := F.a i * (λ i)^2 + F.g λ i

theorem eval_nonneg (F : ReactionField ι) (λ : ι → ℝ) (i : ι) : 0 ≤ F.eval λ i :=
  add_nonneg (mul_nonneg (F.a_nonneg i) (sq_nonneg _)) (F.g_nonneg λ i)

/-- The canonical Ricci-flow-inspired reaction field `λ_i' = λ_i² + ∑_j λ_j²`. -/
noncomputable def hamilton : ReactionField ι where
  a := fun _ => 1
  g := fun λ _ => ∑ j, (λ j)^2
