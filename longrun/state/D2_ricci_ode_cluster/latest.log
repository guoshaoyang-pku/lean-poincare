/-- **Invariant region transferred to the tensor level.** Under the bridge, nonnegative
diagonal Ricci curvature is preserved by the Ricci flow. -/
theorem ricciDiagonal_nonneg_of_bridge {F : ReactionField ι} {T : ℝ} {traj : ℝ → ι → ℝ}
    {ManifoldRealization : Prop}
    (B : TensorRicciFlowODEBridge (V := V) F T traj ManifoldRealization)
    (h0 : ∀ i, 0 ≤ traj 0 i) :
    ∀ t ∈ Icc 0 T, ∀ i,
      0 ≤ ricci (B.curvature t) ((B.metric t).basis i) ((B.metric t).basis i) := by
  intro t ht i
  rw [← B.state_eq t ht i]
  exact nonneg_orthant_invariant F (evolutionRelation_of_bridge B) h0 t ht i

/-- **Scalar monotonicity transferred to the tensor level.** Under the bridge, the
scalar-curvature contraction is nondecreasing along the Ricci flow. -/
theorem scalarCurvature_monotone_of_bridge {F : ReactionField ι} {T : ℝ} {traj : ℝ → ι → ℝ}
    {ManifoldRealization : Prop}
    (B : TensorRicciFlowODEBridge (V := V) F T traj ManifoldRealization)
    (hT : 0 ≤ T) :
