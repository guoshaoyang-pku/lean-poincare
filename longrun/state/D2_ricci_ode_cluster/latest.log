theorem scalarFunctional_monotone (F : ReactionField ι) {w : ι → ℝ} (hw : ∀ i, 0 ≤ w i)
    {T : ℝ} {traj : ℝ → ι → ℝ} (ev : EvolutionRelation F T traj) :
