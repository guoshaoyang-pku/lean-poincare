theorem monotoneOn (c : ContinuousMonotoneCertificate E) :
    MonotoneOn (fun s : ℝ => (E s).F) (Set.Ici 0) := by
  apply monotoneOn_of_deriv_nonneg (convex_Ici 0) c.continuousOn_F
