theorem eq_on_Icc_of_eq_at (c : ContinuousMonotoneCertificate E) {t : ℝ} (ht : 0 ≤ t)
    (heq : (E t).F = (E 0).F) {s : ℝ} (hs : s ∈ Set.Icc 0 t) :
    (E s).F = (E 0).F := by
  obtain ⟨hs0, hst⟩ := Set.mem_Icc.mp hs
  have h1 : (E 0).F ≤ (E s).F :=
    c.monotoneOn (Set.mem_Ici.mpr le_rfl) (Set.mem_Ici.mpr hs0) hs0
  have h2 : (E s).F ≤ (E t).F :=
    c.monotoneOn (Set.mem_Ici.mpr hs0) (Set.mem_Ici.mpr ht) hst
