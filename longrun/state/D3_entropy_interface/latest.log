Key statements to include verbatim:

**Interface:**
```lean
structure EntropyData (X : Type u) [MeasurableSpace X] (μ : Measure X) where
  R : X → ℝ; gradSq : X → ℝ; f : X → ℝ; ρ : X → ℝ
  τ : ℝ; τ_pos : 0 < τ; n : ℝ
  riccHess : X → ℝ
  ρ_nonneg : ∀ x, 0 ≤ ρ x
  integrable_F : Integrable (fun x => (R x + gradSq x) * ρ x) μ
  integrable_W : Integrable (fun x => (τ * (gradSq x + R x) + (f x - n)) * ρ x) μ

EntropyData.F D = ∫ x, (D.R x + D.gradSq x) * D.ρ x ∂μ
EntropyData.W D = ∫ x, (D.τ * (D.gradSq x + D.R x) + (D.f x - D.n)) * D.ρ x ∂μ
EntropyData.FDissipation D = ∫ x, 2 * (D.riccHess x)^2 * D.ρ x ∂μ
EntropyData.HasConjugateWeight D := ∀ x, D.ρ x = Real.exp (-(D.f x))
```

