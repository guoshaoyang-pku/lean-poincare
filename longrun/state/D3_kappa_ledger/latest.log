```lean
theorem kappaNoncollapsing_iff_normalizedBallVolume (hκ : 0 < κ) (hr₀ : 0 < r₀) :
    KappaNoncollapsingCertificate M μ K κ r₀ ↔
      NormalizedBallVolumeLowerBound M μ K κ r₀ := by
  have key : ∀ x r, 0 < r → r ≤ r₀ → K x r →
      (ENNReal.ofReal κ ≤ normalizedBallVolume μ x r ↔
        ENNReal.ofReal (κ * r ^ 3) ≤ μ (eball x (ENNReal.ofReal r))) := by
    intro x r hr _ _
    rw [normalizedBallVolume, ENNReal.le_div_iff_mul_le
      (Or.inl (ne_of_gt (ENNReal.ofReal_pos.mpr (pow_pos hr 3))))
      (Or.inl ENNReal.ofReal_ne_top),
      ← ENNReal.ofReal_mul hκ.le]
  constructor
  · intro h
    exact ⟨hκ, hr₀, fun x r hr hr₀ hK => (key x r hr hr₀ hK).mpr (h.volume_ball_lower x r hr hr₀ hK)⟩
  · intro h
    exact ⟨hκ, hr₀, fun x r hr hr₀ hK => (key x r hr hr₀ hK).mp (h.normalized_ball_lower x r hr hr₀ hK)⟩
```

