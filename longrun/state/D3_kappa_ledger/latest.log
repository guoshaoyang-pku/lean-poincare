#### Noncollapsing.lean

Design:

```lean
import Poincare.Longrun.Topology.Basic
import Mathlib.MeasureTheory.Measure.MeasureSpace
import Mathlib.Topology.MetricSpace.Basic
import Mathlib.Data.ENNReal.Real  -- maybe not needed

open scoped Topology ENNReal
open Metric (eball)

namespace Poincare.Longrun.Topology

/-- A curvature-bound predicate: `CurvatureBoundedOn K x r` means the curvature of the
metric on the ball of radius `r` around `x` satisfies `|Rm| ≤ r⁻²`.  It is deliberately an
opaque hypothesis because mathlib has no Riemann curvature tensor. -/
abbrev CurvatureBoundedOn (M : Type*) := M → ℝ → Prop

/-- κ-non-collapsing certificate... -/
structure KappaNoncollapsingCertificate (M : Type*) [PseudoEMetricSpace M] [MeasurableSpace M]
    (μ : Measure M) (K : CurvatureBoundedOn M) (κ r₀ : ℝ) : Prop where
  kappa_pos : 0 < κ
  r0_pos : 0 < r₀
  volume_ball_lower : ∀ x : M, ∀ r : ℝ, 0 < r → r ≤ r₀ → K x r →
    ENNReal.ofReal (κ * r ^ (3 : ℕ)) ≤ μ (eball x (ENNReal.ofReal r))
```

Wait, `Metric.eball` is in `Topology.EMetricSpace.Defs`; `μ (eball x ε)` needs `MeasurableSpace M` and the ball need not be measurable (measure is outer measure by default, so fine). `Measure` is a function on sets. OK.

Consequences:
```lean
namespace KappaNoncollapsingCertificate

variable {M : Type*} [PseudoEMetricSpace M] [MeasurableSpace M]
variable {μ : Measure M} {K : CurvatureBoundedOn M} {κ r₀ : ℝ}

theorem volume_ball_pos (h : KappaNoncollapsingCertificate M μ K κ r₀)
    {x : M} {r : ℝ} (hr : 0 < r) (hr₀ : r ≤ r₀) (hK : K x r) :
    0 < μ (eball x (ENNReal.ofReal r)) := by
  have hκr : 0 < κ * r ^ 3 := mul_pos h.kappa_pos (pow_pos hr 3)
  exact lt_of_lt_of_le (ENNReal.ofReal_pos.mpr hκr) (h.volume_ball_lower x r hr hr₀ hK)

theorem volume_ball_ne_zero ... : μ (eball ...) ≠ 0 := ne_of_gt ...

theorem mono (h : KappaNoncollapsingCertificate M μ K κ r₀) {κ' : ℝ}
    (hκ' : 0 < κ') (hle : κ' ≤ κ) : KappaNoncollapsingCertificate M μ K κ' r₀ where
  kappa_pos := hκ'
  r0_pos := h.r0_pos
  volume_ball_lower := by
    intro x r hr hr₀ hK
    have hr3 : 0 ≤ r ^ 3 := pow_nonneg hr.le 3
    have : ENNReal.ofReal (κ' * r^3) ≤ ENNReal.ofReal (κ * r^3) :=
      ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right hle hr3)
    exact le_trans this (h.volume_ball_lower x r hr hr₀ hK)

theorem volume_unit_ball_lower ... (h1 : (1:ℝ) ≤ r₀) (hK : K x 1) :
    ENNReal.ofReal κ ≤ μ (eball x 1) := by
  have := h.volume_ball_lower x 1 one_pos h1 hK
  simpa using this

theorem exists_uniform_unit_ball_lower_bound (h : ...) (h1 : 1 ≤ r₀)
    (hK : ∀ x : M, K x 1) :
    ∃ c : ℝ, 0 < c ∧ ∀ x : M, ENNReal.ofReal c ≤ μ (eball x 1) :=
  ⟨κ, h.kappa_pos, fun x => h.volume_unit_ball_lower h1 (hK x)⟩

end KappaNoncollapsingCertificate
```

Wait, `volume_unit_ball_lower` uses `r = 1`: `κ * 1^3 = κ`; `simpa` should handle `1^3 = 1` and `ENNReal.ofReal 1 = 1`.

Also `mono`: since the structure is a Prop, can use `where` syntax? For a Prop structure, `refine ⟨hκ', h.r0_pos, ?_⟩` works too.

Additional consequence: `no_collapsing_at_scale` — `∃ c > 0, ∀ x, ...` (the uniform bound). Also `ball_measure_unbounded_above`? Not meaningful.

