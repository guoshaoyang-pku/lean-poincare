### Architecture

**`Poincare/Longrun/Surgery/Basic.lean`**

```lean
import Mathlib.Topology.Homeomorph.Lemmas
import Mathlib.Topology.Homotopy.Equiv
import Mathlib.AlgebraicTopology.FundamentalGroupoid.SimplyConnected

/-!
# Surgery ledger: basic interfaces
...
-/

universe u

namespace Poincare.Longrun.Surgery

/-- A bundled topological space: the carrier together with its topology.  Bundling keeps the
pre- and post-surgery carriers in one universe and lets the ledger quantify over them. -/
structure TopSpace where
  Carrier : Type u
  topology : TopologicalSpace Carrier

attribute [instance] TopSpace.topology

/-- The ledger's abstract orientability predicate. Mathlib (pinned commit ...) has no
orientability notion for topological or smooth manifolds, so the ledger does not define one:
the predicate is a parameter `Orientable : TopSpace → Prop` supplied by the user/geometer. -/
-- no class; just a parameter

/-- The three manifold properties tracked by the surgery ledger. -/
structure LedgerPredicates where
  Compact : TopSpace.{u} → Prop
  Orientable : TopSpace.{u} → Prop
  SimplyConnected : TopSpace.{u} → Prop

/-- Canonical ledger: real mathlib compactness and simple-connectivity, orientability left as
a parameter. -/
def canonicalLedger (Orientable : TopSpace.{u} → Prop) : LedgerPredicates.{u} where
  Compact := fun X => CompactSpace X.Carrier
  Orientable := Orientable
  SimplyConnected := fun X => SimplyConnectedSpace X.Carrier

/-- A surgery datum: an oriented (in the sense of "directed") relation between a pre-surgery
and a post-surgery topological space, together with the neck along which the cut is made. -/
structure SurgeryDatum (X Y : TopSpace.{u}) where
  /-- The embedded 2-sphere (neck) along which the surgery is performed. -/
  neck : TopSpace.{u}
  /-- `rel x y` holds when `y` is a post-surgery manifold obtained from `x` by cutting along
  the neck and gluing standard caps. -/
  rel : X.Carrier → Y.Carrier → Prop
  /-- The points of the pre-manifold lying on the neck. -/
  liesOnNeck : X.Carrier → Prop
  /-- The points of the post-manifold lying on the glued caps. -/
  liesOnCap : Y.Carrier → Prop

/-- A surgery certificate for `D` under a ledger `P`: the three preservation obligations. -/
structure SurgeryCertificate (P : LedgerPredicates.{u}) {X Y : TopSpace.{u}}
    (D : SurgeryDatum X Y) : Type (u + 1) where
  compact_preserved : P.Compact X → P.Compact Y
  orientable_preserved : P.Orientable X → P.Orientable Y
  simplyConnected_preserved : P.SimplyConnected X → P.SimplyConnected Y

namespace SurgeryCertificate

variable {P : LedgerPredicates.{u}} {X Y : TopSpace.{u}} {D : SurgeryDatum X Y}

theorem compact ... := C.compact_preserved
...
end
```

