/-- The continuous Perelman F-monotonicity statement... -/
def ContinuousPerelmanFMonotonicity {X} [MeasurableSpace X] {μ : Measure X}
    (E : ℝ → EntropyData X μ) (T : ℝ) : Prop :=
  ∀ t ∈ Icc 0 T, (E t).F ≤ (E 0).F

/-- The approximation boundary: the finite Perelman sum represents the continuous
entropy functional on `[0,T]`. Statement-only. -/
def FiniteRepresentsContinuousPerelman ... : Prop :=
  ∀ t ∈ Icc 0 T, (E t).F = perelmanF c (traj t)

/-- Mesh convergence... -/
def FiniteMeshConvergence {ι} (mesh : ℕ → ℝ) (state : ℕ → ι → ℝ) (limit : ι → ℝ) : Prop :=
  Tendsto mesh atTop (𝓝 0) ∧ ∀ i, Tendsto (fun n => state n i) atTop (𝓝 (limit i))

/-- Checked limit passage: the finite functional is continuous in the state. -/
theorem tendsto_perelmanF {c : ι → ℝ} {state : ℕ → ι → ℝ} {limit : ι → ℝ}
    (h : Tendsto state atTop (𝓝 limit)) :
    Tendsto (fun n => perelmanF c (state n)) atTop (𝓝 (perelmanF c limit)) :=
  (continuous_perelmanF c).tendsto limit |>.comp h
```
