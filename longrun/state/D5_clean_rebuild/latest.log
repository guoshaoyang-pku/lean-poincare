import ReleaseCheck
import Lean.Util.CollectAxioms

open Lean Elab Command

namespace D5ReleaseAudit

/-- The only axioms accepted anywhere in a dependency cone of a released declaration. -/
def approvedAxioms : List Name :=
  ["propext".toName, "Classical.choice".toName, "Quot.sound".toName]

/-- Axioms that must never appear; they are reported with a dedicated label. -/
def sorryAxiom : Name := "sorryAx".toName
def nativeAxiom : Name := "ofReduceBool".toName
def nativeAxiom' : Name := "Lean.ofReduceBool".toName

/-- Roots of the declarations owned by this release package (base skeleton + D1–D4). -/
def projectRoots : List Name :=
  ["Poincare".toName, "Probe".toName, "Ledger".toName, "Perelman".toName,
   "Audit".toName, "D4Audit".toName, "D5ReleaseCheck".toName]

def isProjectConstant (n : Name) : Bool :=
  projectRoots.any (fun r => r.isPrefixOf n)

def projectConstants (env : Environment) : Array (Name × ConstantInfo) :=
  env.constants.foldStage2 (fun acc n ci =>
    if isProjectConstant n then acc.push (n, ci) else acc) #[]

end D5ReleaseAudit

open D5ReleaseAudit in
run_cmd do
  ...
```

