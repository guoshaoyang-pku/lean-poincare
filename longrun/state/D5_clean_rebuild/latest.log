Then the audit:

```lean
/-- Collect project declarations from the environment. -/
def projectConstants (env : Environment) : Array (Name × ConstantInfo) :=
  env.constants.foldStage2 (fun acc n ci => if isProjectName n then acc.push (n, ci) else acc) #[]

run_cmd do
  let env ← getEnv
  let cs := projectConstants env
  -- 1. direct axiom declarations in project modules
  let projectAxioms := cs.filterMap fun (n, ci) => match ci with
    | .axiomInfo _ => some n
    | _ => none
  -- 2. unsafe definitions
  let unsafeDefs := cs.filterMap fun (n, ci) => match ci with
    | .defnInfo v => if v.safety == .unsafe then some n else none
    | _ => none
  -- 3. partial defs? (not in the forbidden list, but report)
  -- 4. axiom cones
  let mut badAxioms : Array (Name × Name) := #[]  -- (decl, axiom)
  let mut sorryDecls : Array Name := #[]
  let mut nativeDecls : Array Name := #[]
  let mut otherAxiomDecls : Array (Name × Name) := #[]
  for (n, _) in cs do
    let axs ← Lean.collectAxioms n
    for a in axs do
      if a == ``sorryAx then sorryDecls := sorryDecls.push n
      else if a == ``Lean.ofReduceBool then nativeDecls := nativeDecls.push n
      else if !(approvedAxioms.contains a) then otherAxiomDecls := otherAxiomDecls.push (n, a)
  ...
  -- report
  IO.println ...
  if !projectAxioms.isEmpty || !unsafeDefs.isEmpty || !sorryDecls.isEmpty || ... then
    throwError "D5 audit FAILED ..."
```

