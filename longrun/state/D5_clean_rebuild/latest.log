/-
  D5 clean-room dependency audit.
  ...
-/
import ReleaseCheck
import Lean.Util.CollectAxioms

open Lean Elab Command

namespace D5Audit

/-- Axioms that are accepted in this release: the three Lean/mathlib kernel axioms. -/
def approvedAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]

/-- Project name roots whose declarations are audited. -/
def projectRoots : List Name := [`Poincare, `Probe, `Ledger, `Perelman, `Audit, `D4Audit]

def isProjectName (n : Name) : Bool :=
  projectRoots.any fun r => r.isPrefixOf n

/-- Names forbidden in the dependency cone. -/
def forbiddenAxiomNames : List Name := [``sorryAx, ``Lean.ofReduceBool, ``Lean.trustCompiler]
```

