by_name = {d["name"]: d for d in decls}
suffix_index = defaultdict(list)
for d in decls: suffix_index[d["name"].rsplit(".",1)[-1]].append(d["name"])

def resolve(short, hint_prefixes=()):
    # if full name exists, return it
    if short in by_name: return short, "exact"
    cands = suffix_index.get(short, [])
    if not cands: return None, "unresolved"
    if len(cands)==1: return cands[0], "suffix-unique"
    # prefer hint prefix
    for p in hint_prefixes:
        pref=[c for c in cands if c.startswith(p)]
        if len(pref)==1: return pref[0], "suffix-prefixed"
    return cands[0], "suffix-ambiguous"

def decl_entry(name):
    d=by_name.get(name)
    if not d: return None
    return {"name":..., "kind":..., "file":..., "axioms":..., "module":...}
```

