theorem shift_apply (i : ι) (f : Conf ι N → ℝ) (x : Conf ι N) :
    shift i f x = f (x + Pi.single i 1) := rfl

theorem shift_add (i : ι) (f g : Conf ι N → ℝ) :
    shift i (f + g) = shift i f + shift i g := by
  funext x; rfl  -- pointwise addition, should be rfl

theorem shift_sub (i : ι) (f g) : shift i (f - g) = shift i f - shift i g := by
  funext x; rfl

theorem shift_sum (i : ι) (s : Finset α) (F : α → Conf ι N → ℝ) :
    shift i (∑ a ∈ s, F a) = ∑ a ∈ s, shift i (F a) := by
  funext x; simp [shift, Finset.sum_apply]
```

