```lean
import Poincare.D7.Bochner.Basic
import Mathlib.Data.ZMod.Basic

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

/-! docstring -/

open Finset

namespace Poincare.D7.Bochner

/-! ## The finite cyclic difference model -/

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {N : ℕ}

/-- The configuration space `ι → ZMod N` ... -/
abbrev Conf (ι : Type*) (N : ℕ) := ι → ZMod N

/-- Shift ... -/
def shift (i : ι) (f : Conf ι N → ℝ) : Conf ι N → ℝ := fun x => f (x + Pi.single i 1)

/-- Forward difference ... -/
def diff (i : ι) (f : Conf ι N → ℝ) : Conf ι N → ℝ := fun x => shift i f x - f x

theorem shift_comm ...
theorem shift_sub ...
theorem diff_sub ...
theorem shift_univ_sum ...
theorem diff_univ_sum ...
theorem diff_shift_comm ...
theorem diff_comm ...
/-- discrete Laplacian -/
def laplacian (f : Conf ι N → ℝ) : Conf ι N → ℝ := ∑ i, diff i (diff i f)

theorem laplacian_apply ...
/-- **Laplacian commutation** -/
theorem diff_laplacian_comm (j) (f) : diff j (laplacian f) = laplacian (diff j f)
```

Then the Euclidean certificate for `ι = Fin n`:

```lean
namespace Euclidean

variable {n : ℕ}

/-- The Euclidean gradient of `f` at `x` in the model. -/
def grad (f : Conf (Fin n) N → ℝ) (x : Conf (Fin n) N) : Fin n → ℝ := fun i => diff i f x

/-- The Euclidean Hessian of `f` at `x` in the model. -/
def hess (f : ...) (x : ...) : Matrix (Fin n) (Fin n) ℝ := fun i j => diff i (diff j f) x

theorem hess_symm ... : hess f x i j = hess f x j i

/-- The Hodge-side 1-form Laplacian pairing ... -/
def oneFormLaplacian (f x) : ℝ := ∑ i, laplacian (diff i f) x * diff i f x

/-- The rough-side pairing ... -/
def roughLaplacian (f x) : ℝ := ∑ i, diff i (laplacian f) x * diff i f x

/-- The Euclidean Bochner identity: with `Ric = 0` the 1-form Laplacian equals the rough Laplacian,
and this is exactly the pointwise commutation of the discrete Laplacian with the difference
operators. -/
theorem oneFormLaplacian_eq_roughLaplacian (f x) : oneFormLaplacian f x = roughLaplacian f x

/-- **The Euclidean `BochnerCertificate`** with `Ric = 0`. -/
def euclideanBochnerCertificate (f : ...) (x : ...) : BochnerCertificate where
  dim := n
  grad := grad f x
  hess := hess f x
  ric := 0
  oneFormLaplacian := oneFormLaplacian f x
  roughLaplacian := roughLaplacian f x
  ricciContraction := 0
  bochner := by
    rw [oneFormLaplacian_eq_roughLaplacian, add_zero]
  ricci_eq := by simp [ricciPairing]
  ricci_nonneg := le_refl 0

theorem euclideanBochnerCertificate_ricci_zero (f x) : (euclideanBochnerCertificate f x).ric = 0 := rfl
theorem euclideanBochnerCertificate_ricciContraction_zero ...
theorem euclideanBochnerCertificate_bochner ...
```

Also a version of the reduction theorem stated with an explicit commutation hypothesis:
```lean
theorem euclidean_oneFormLaplacian_eq_rough_of_commutation (f x)
    (h : ∀ i, laplacian (diff i f) x = diff i (laplacian f) x) :
    oneFormLaplacian f x = roughLaplacian f x := by
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [h i]
```
This makes the "reduces to commutation" explicit.

