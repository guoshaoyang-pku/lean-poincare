open Finset

namespace Poincare.D7.Bochner

variable {ι : Type*} [Fintype ι]

/-- Hilbert–Schmidt norm squared of a matrix. -/
def hessNormSq (A : Matrix ι ι ℝ) : ℝ := ∑ i, ∑ j, A i j ^ 2

/-- Pairing of a gradient with the gradient of the Laplacian: ⟨∇f, ∇(Δf)⟩. -/
def gradLaplacianDot (g h : ι → ℝ) : ℝ := ∑ i, g i * h i

/-- Ricci pairing Ric(∇f, ∇f) = ⟨∇f, R ∇f⟩. -/
def ricciPairing (R : Matrix ι ι ℝ) (g : ι → ℝ) : ℝ := ∑ i, ∑ j, g i * R i j * g j

theorem hessNormSq_nonneg (A) : 0 ≤ hessNormSq A := by
  unfold hessNormSq
  exact Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => sq_nonneg _

theorem ricciPairing_zero (g) : ricciPairing (0 : Matrix ι ι ℝ) g = 0 := by
  simp [ricciPairing]

theorem gradLaplacianDot_self_nonneg? -- no, ⟨∇f,∇Δf⟩ has no sign

/-- A Ricci-nonnegative endomorphism. -/
def IsRicciNonnegative (R : Matrix ι ι ℝ) : Prop := ∀ g : ι → ℝ, 0 ≤ ricciPairing R g

theorem ricciPairing_nonneg_of (R) (h : IsRicciNonnegative R) (g) : 0 ≤ ricciPairing R g := h g

theorem isRicciNonnegative_zero : IsRicciNonnegative (0 : Matrix ι ι ℝ) := by
  intro g; rw [ricciPairing_zero]

/-- The Bochner certificate ... -/
structure BochnerCertificate where
  dim : ℕ
  grad : Fin dim → ℝ
  hess : Matrix (Fin dim) (Fin dim) ℝ
  ric : Matrix (Fin dim) (Fin dim) ℝ
  oneFormLaplacian : ℝ
  roughLaplacian : ℝ
  ricciContraction : ℝ
  bochner : oneFormLaplacian = roughLaplacian + ricciContraction
  ricci_eq : ricciContraction = ricciPairing ric grad
  ricci_nonneg : 0 ≤ ricciContraction
```

