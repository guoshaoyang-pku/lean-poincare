def toGHConvergenceData {X : ℕ → PointedMetricSpace.{u}} {Y : PointedMetricSpace.{u}}
    (ε : ℕ → ℝ) (hε : ∀ n, 0 ≤ ε n) (h0 : Tendsto ε atTop (𝓝 0))
    (D : ∀ n, EpsilonApproximation (ε n) (X n) Y) : GHConvergenceData atTop X Y where
