/-- Energy: mass-weighted L² energy of a field. -/
def energy (m : V → ℝ) (u : V → ℝ) : ℝ := ∑ x, m x * u x ^ 2

/-- The conjugate-heat step with scalar-curvature term: u⁺ = u + R•u - Δu. -/
def conjugateHeatStep (D) (w) (m R : V → ℝ) (u : V → ℝ) : V → ℝ :=
  u + scalarMulLM R u - laplaceBeltrami D w m u

/-- One-step energy monotonicity. -/
