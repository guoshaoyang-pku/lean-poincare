```lean
theorem energy_mono_slab {n : ℕ} (D) (w) (m R) (hm) (hw) (hR) (u : Fin (n+1) → V → ℝ)
    (hstep : ∀ k : Fin n, u k.succ = conjugateHeatStep D w m R (u k.castSucc)) :
    energy m (u 0) ≤ energy m (u (Fin.last n)) := by
  have htelescope := Poincare.D7.Divergence.sum_telescope (fun k => energy m (u k))
  have hnonneg : 0 ≤ ∑ k : Fin n, (energy m (u k.succ) - energy m (u k.castSucc)) := by
