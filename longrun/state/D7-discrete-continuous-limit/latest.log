```lean
structure SlabGrid (N : ℕ) (α : ℝ) where
  v : ℕ → ℕ → ℝ
  step : ∀ t i, 0 < i → i < N + 1 →
    v (t + 1) i = α * v t (i - 1) + (1 - 2 * α) * v t i + α * v t (i + 1)
