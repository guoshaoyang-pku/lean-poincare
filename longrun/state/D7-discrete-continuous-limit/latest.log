```lean
theorem error_le_uniform (C : ...) {τ0 : ℝ} (hτ0 : 0 ≤ τ0) (hτ : ∀ n, C.τ n ≤ τ0)
    (n : ℕ) {i : ℕ} (hi : i ≤ N + 1) :
    C.error n i ≤ C.ε₀ + n * τ0 := by
  have h1 := error_le_of_certificate C n hi
  have h2 : ∑ k ∈ Finset.range n, C.τ k ≤ n * τ0 := by
    calc ∑ k ∈ Finset.range n, C.τ k ≤ ∑ _k ∈ Finset.range n, τ0 :=
          Finset.sum_le_sum (fun k _ => hτ k)
      _ = n * τ0 := by simp
  linarith
```
