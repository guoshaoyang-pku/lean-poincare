```lean
theorem perturbed_recursion_stable {N : ℕ} {α : ℝ} (hα0 : 0 ≤ α) (hα1 : α ≤ 1 / 2)
    {e : ℕ → ℕ → ℝ} {τ : ℕ → ℝ} (hτ : ∀ n, 0 ≤ τ n)
    (hstep : ∀ n i, 0 < i → i < N + 1 →
      e (n + 1) i ≤ α * e n (i - 1) + (1 - 2 * α) * e n i + α * e n (i + 1) + τ n)
    (hleft : ∀ n, e n 0 = 0) (hright : ∀ n, e n (N + 1) = 0) :
    ∀ n i, i ≤ N + 1 →
      e n i ≤ max 0 (Finset.sup' (Finset.range (N + 2))
        ⟨0, Finset.mem_range.mpr (by omega)⟩ (fun j => e 0 j)) + ∑ k ∈ Finset.range n, τ k := by
  have hq : 0 ≤ 1 - 2 * α := by linarith
  intro n
  induction n with
  | zero =>
      intro i hi
      have hsup : e 0 i ≤ Finset.sup' (Finset.range (N + 2)) ⟨0, Finset.mem_range.mpr (by omega)⟩ (fun j => e 0 j) :=
        Finset.le_sup' (fun j => e 0 j) (Finset.mem_range.mpr (by omega))
      have hmax : ... ≤ max 0 (... ) := le_max_right _ _
      simpa using hsup.trans hmax
  | succ n ih =>
      intro i hi
      set M := max 0 (Finset.sup' ...) + ∑ k ∈ Finset.range n, τ k with hMdef
      have hM0 : 0 ≤ M := by
        have h1 : 0 ≤ max 0 (Finset.sup' ...) := le_max_left _ _
        have h2 : 0 ≤ ∑ k ∈ Finset.range n, τ k := Finset.sum_nonneg (fun k _ => hτ k)
        linarith
      by_cases hi0 : i = 0
      · subst hi0
        rw [hleft (n+1)]
        have := hτ n
        -- goal: 0 ≤ max 0 sup + ∑ k ∈ range (n+1), τ k
        rw [Finset.sum_range_succ]
        linarith
      by_cases hiN : i = N + 1
      · subst hiN
        rw [hright (n+1)]
        rw [Finset.sum_range_succ]
        have := hτ n
        linarith
      · have hpos : 0 < i := Nat.pos_of_ne_zero hi0
        have hlt : i < N + 1 := lt_of_le_of_ne hi hiN
        have h1 : e n (i - 1) ≤ M := ih (i - 1) (by omega)
        have h2 : e n i ≤ M := ih i hi
        have h3 : e n (i + 1) ≤ M := ih (i + 1) (by omega)
        have hcomb : α * e n (i - 1) + (1 - 2 * α) * e n i + α * e n (i + 1) ≤ M := by
          have h1' := mul_le_mul_of_nonneg_left h1 hα0
          have h2' := mul_le_mul_of_nonneg_left h2 hq
          have h3' := mul_le_mul_of_nonneg_left h3 hα0
          have : α * M + (1 - 2 * α) * M + α * M = M := by ring
          linarith
        calc e (n + 1) i ≤ α * e n (i - 1) + (1 - 2 * α) * e n i + α * e n (i + 1) + τ n := hstep n i hpos hlt
          _ ≤ M + τ n := by linarith
          _ = max 0 (Finset.sup' ...) + ∑ k ∈ Finset.range (n + 1), τ k := by
              rw [Finset.sum_range_succ]; ring
```

The `set M` with `hMdef` may complicate `linarith` because `M` is a local definition; `linarith` should handle. Alternatively avoid `set` and write the expression inline. Let me use `set` and `linarith`.

