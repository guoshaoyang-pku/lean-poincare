```lean
namespace Poincare.D7.Limit

/-- A finite-difference slab: grid values `v t i` for `0 ≤ i ≤ N+1`, `0 ≤ t`, with
the explicit-Euler update at interior points and arbitrary boundary traces. -/
structure SlabGrid (N : ℕ) (α : ℝ) where
  v : ℕ → ℕ → ℝ
  step : ∀ t i, 0 < i → i < N + 1 →
    v (t + 1) i = α * v t (i - 1) + (1 - 2 * α) * v t i + α * v t (i + 1)
```

Hmm, but D2's `HeatGridEvolution` uses `u (t+1) i = u t i + α*(...)` which is the same as the convex form. We can provide `SlabGrid.ofHeatGridEvolution`. For our purpose, boundary data arbitrary.

Now the "continuous heat interface": `ContinuousHeatHypotheses u a b T`. The consistency certificate:

```lean
structure ConsistencyCertificate (u : ℝ → ℝ → ℝ) (a b T : ℝ) (N : ℕ) (α : ℝ) where
  /-- grid spacing -/
  h : ℝ
  h_pos : 0 < h
  /-- time step -/
  Δt : ℝ
  Δt_pos : 0 < Δt
  /-- CFL relation α = Δt / h^2 -/
  alpha_eq : α = Δt / h^2
  /-- CFL condition -/
  cfl0 : 0 ≤ α
  cfl1 : α ≤ 1/2
  /-- grid point map -/
  x : ℕ → ℝ
  x_zero : x 0 = a
  x_last : x (N+1) = b
  x_step : ∀ i, 0 < i → i ≤ N+1 → x (i-1) = x i - h   -- affine spacing
  /-- time map -/
  time : ℕ → ℝ
  time_zero : time 0 = 0
  time_step : ∀ n, time (n+1) = time n + Δt
  /-- discrete solution -/
  V : SlabGrid N α
  /-- boundary consistency with the continuous solution -/
  boundary_left : ∀ n, V.v n 0 = u a (time n)
  boundary_right : ∀ n, V.v n (N+1) = u b (time n)
  /-- initial error -/
  ε₀ : ℝ
  ε₀_nonneg : 0 ≤ ε₀
  initial_error : ∀ i ≤ N+1, |u (x i) (time 0) - V.v 0 i| ≤ ε₀
  /-- local truncation error -/
  τ : ℕ → ℝ
  τ_nonneg : ∀ n, 0 ≤ τ n
  truncation : ∀ n i, 0 < i → i < N+1 →
    |u (x i) (time (n+1)) - heatStep α (fun j => u (x j) (time n)) i| ≤ τ n
  /-- the continuous interface is inhabited -/
  continuous : ContinuousHeatHypotheses u a b T
```

