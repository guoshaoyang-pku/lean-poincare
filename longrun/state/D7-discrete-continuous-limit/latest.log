/-- A one-dimensional spatial grid on `[a,b]` with `N+1` cells. -/
structure GridMesh (a b : ℝ) (N : ℕ) where
  x : ℕ → ℝ
  x_zero : x 0 = a
  x_last : x (N + 1) = b
  x_strict : ∀ i j, i ≤ N + 1 → j ≤ N + 1 → i < j → x i < x j

/-- `fine` refines `coarse`: every coarse node is a node of the fine grid. -/
def GridMesh.Refines {a b : ℝ} {N N' : ℕ} (coarse : GridMesh a b N) (fine : GridMesh a b N') : Prop :=
  ∀ i ≤ N + 1, ∃ j ≤ N' + 1, fine.x j = coarse.x i

/-- Uniform grid: `x i = a + i * h`. -/
def GridMesh.uniform (a b : ℝ) (N : ℕ) (h : ℝ) (hN : (N + 1 : ℝ) * h = b - a) : GridMesh a b N where
  x i := a + i * h
  x_zero := by simp
  x_last := by push_cast; linarith
  x_strict := ...
```

