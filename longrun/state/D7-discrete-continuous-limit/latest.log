def quadCertificate (N : ℕ) (h Δt α T : ℝ) (hh : 0 < h) (hN : ((N+1:ℕ):ℝ)*h = 2)
    (hΔt : 0 < Δt) (hα0 : 0 ≤ α) (hα1 : α ≤ 1/2) (hα : α * h^2 = Δt) :
    ConsistencyCertificate quadSolution (-1) 1 T N α where
