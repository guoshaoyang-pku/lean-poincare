```lean
theorem tendsto_zero_of_abs_le {f : ℕ → ℝ} {g : ℕ → ℝ}
    (hg : Tendsto g atTop (𝓝 0)) (h : ∀ n, |f n| ≤ g n) :
    Tendsto f atTop (𝓝 0) := by
  rw [Metric.tendsto_atTop] at hg ⊢
  intro ε hε
  obtain ⟨N, hN⟩ := hg ε hε
  refine ⟨N, fun n hn => ?_⟩
  have h1 := h n
  have h2 := hN n hn
  rw [Real.dist_eq] at h2 ⊢
  -- h2 : |g n - 0| < ε, goal |f n - 0| < ε
  calc |f n - 0| = |f n| := by ring_nf
    _ ≤ g n := h1
    _ = |g n| := by rw [abs_of_nonneg (le_of_lt (lt_of_le_of_lt (abs_nonneg _) h2))]  -- hmm
```
