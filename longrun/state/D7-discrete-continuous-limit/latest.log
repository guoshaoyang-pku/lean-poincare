```lean
theorem error_step (C : ConsistencyCertificate u a b T N α) {n i : ℕ} (hi0 : 0 < i) (hiN : i < N + 1) :
    C.error (n + 1) i ≤
      α * C.error n (i - 1) + (1 - 2 * α) * C.error n i + α * C.error n (i + 1) + C.τ n := by
  have htrunc := C.truncation n i hi0 hiN
  have hgrid := C.grid.step n i hi0 hiN
  have hq : 0 ≤ 1 - 2 * α := by linarith [C.cfl_le_half]
  have hA : |α * (u (C.mesh.x (i-1)) (C.timeMesh.time n) - C.grid.v n (i-1))| = α * C.error n (i-1) := by
    rw [abs_mul, abs_of_nonneg C.cfl_nonneg]
  ...
  -- decomposition
  have hdec : u (C.mesh.x i) (C.timeMesh.time (n+1)) - C.grid.v (n+1) i
      = (u (C.mesh.x i) (C.timeMesh.time (n+1)) - heatStep α (fun j => u (C.mesh.x j) (C.timeMesh.time n)) i)
        + (α * (u (C.mesh.x (i-1)) (C.timeMesh.time n) - C.grid.v n (i-1))
           + (1 - 2*α) * (u (C.mesh.x i) (C.timeMesh.time n) - C.grid.v n i)
           + α * (u (C.mesh.x (i+1)) (C.timeMesh.time n) - C.grid.v n (i+1))) := by
    rw [hgrid]
    simp only [heatStep]
    ring
  calc C.error (n+1) i
      = |...| := rfl
    _ ≤ |trunc| + |inner| := by rw [hdec]; exact abs_add _ _
    _ ≤ C.τ n + (α * C.error n (i-1) + (1-2α) * C.error n i + α * C.error n (i+1)) := by
        gcongr
        · exact htrunc
        · -- triangle inequality for inner
          calc |α * A + (1-2α) * B + α * C| 
              = |(α * A + (1-2α) * B) + α * C| := by ring_nf
              _ ≤ |α * A + (1-2α) * B| + |α * C| := abs_add _ _
              _ ≤ (|α * A| + |(1-2α) * B|) + |α * C| := by gcongr; exact abs_add _ _
              _ = α * C.error n (i-1) + (1-2α) * C.error n i + α * C.error n (i+1) := by
                  rw [abs_mul, abs_of_nonneg C.cfl_nonneg, abs_mul, abs_of_nonneg hq, abs_mul, abs_of_nonneg C.cfl_nonneg]; rfl? 
    _ = ... := by ring
```

