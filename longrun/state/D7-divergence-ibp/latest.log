import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Algebra.BigOperators.Group.Finset.Piecewise
import Mathlib.Algebra.BigOperators.Group.Finset.Sigma

set_option linter.style.haveILetI false

/-!
# Poincare.D7.Divergence.Basic
...
-/

namespace Poincare.D7.Divergence

open Finset

/-- The incidence data of a finite oriented graph, i.e. the data defining a discrete divergence
operator on the graph. ... -/
structure DivergenceData (V E : Type*) [Fintype V] [Fintype E] [DecidableEq V] where
  src : E → V
  tgt : E → V

namespace DivergenceData

variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V]

/-- Outflow ... -/
def outFlow (D : DivergenceData V E) (F : E → ℝ) (v : V) : ℝ :=
  ∑ e ∈ univ.filter (fun e => D.src e = v), F e

def inFlow ... := ∑ e ∈ univ.filter (fun e => D.tgt e = v), F e

def divergence (D) (F) (v) : ℝ := D.outFlow F v - D.inFlow F v

def outFlux (D) (F) (S : Finset V) : ℝ := ∑ e ∈ univ.filter (fun e => D.src e ∈ S), F e
def inFlux (D) (F) (S) : ℝ := ∑ e ∈ univ.filter (fun e => D.tgt e ∈ S), F e
def boundaryFlux (D) (F) (S) : ℝ :=
  (∑ e ∈ univ.filter (fun e => D.src e ∈ S ∧ D.tgt e ∉ S), F e)
    - (∑ e ∈ univ.filter (fun e => D.tgt e ∈ S ∧ D.src e ∉ S), F e)

def outPairing (D) (F : E → ℝ) (φ : V → ℝ) (S) : ℝ :=
  ∑ e ∈ univ.filter (fun e => D.src e ∈ S), φ (D.src e) * F e
def inPairing ... := ∑ e ∈ univ.filter (fun e => D.tgt e ∈ S), φ (D.tgt e) * F e
def boundaryPairing := D.outPairing F φ S - D.inPairing F φ S
def gradientPairing := ∑ e ∈ univ.filter (fun e => D.src e ∈ S ∧ D.tgt e ∈ S), F e * (φ (D.tgt e) - φ (D.src e))
def divPairing := ∑ v ∈ S, φ v * D.divergence F v
```

