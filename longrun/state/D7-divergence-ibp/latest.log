import Poincare.D7.Divergence.Basic

namespace Poincare.D7.Divergence
namespace DivergenceData

variable {V E : Type*} [Fintype V] [Fintype E] [DecidableEq V] (D : DivergenceData V E)

theorem sum_divergence_eq_boundaryFlux (F : E → ℝ) (S : Finset V) :
    ∑ v ∈ S, D.divergence F v = D.boundaryFlux F S := by
  have hout := D.sum_outFlow F S
  have hin := D.sum_inFlow F S
  have hdiv : ∑ v ∈ S, D.divergence F v = D.outFlux F S - D.inFlux F S := by
    simp only [divergence]
    rw [Finset.sum_sub_distrib, hout, hin]
  rw [hdiv]
  -- split
  have hsplit_out := sum_filter_split (s := (Finset.univ : Finset E))
      (p := fun e => D.src e ∈ S) (q := fun e => D.tgt e ∈ S) F
  have hsplit_in := sum_filter_split (s := (Finset.univ : Finset E))
      (p := fun e => D.tgt e ∈ S) (q := fun e => D.src e ∈ S) F
  have hboth : (∑ e ∈ (Finset.univ : Finset E).filter (fun e => D.tgt e ∈ S ∧ D.src e ∈ S), F e)
      = ∑ e ∈ (Finset.univ : Finset E).filter (fun e => D.src e ∈ S ∧ D.tgt e ∈ S), F e := by
    refine Finset.sum_congr ?_ (fun _ _ => rfl)
    ext e; simp [and_comm]
  simp only [outFlux, inFlux] at hsplit_out hsplit_in
  rw [hsplit_out, hsplit_in, hboth, boundaryFlux]
  ring
```

