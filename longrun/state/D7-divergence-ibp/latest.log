lemma sum_src_fiber (F : E → ℝ) (S : Finset V) :
    ∑ v ∈ S, ∑ e ∈ Finset.univ.filter (fun e => D.src e = v), F e
      = ∑ e ∈ Finset.univ.filter (fun e => D.src e ∈ S), F e := by
