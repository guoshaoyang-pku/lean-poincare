```lean
calc ∑ v ∈ S, ∑ e ∈ univ.filter (fun e => D.src e = v), F e
    = ∑ v ∈ S, ∑ e ∈ univ, if D.src e = v then F e else 0 := by simp only [Finset.sum_filter]
  _ = ∑ e ∈ univ, ∑ v ∈ S, if D.src e = v then F e else 0 := Finset.sum_comm
  _ = ∑ e ∈ univ, if D.src e ∈ S then F e else 0 := by
