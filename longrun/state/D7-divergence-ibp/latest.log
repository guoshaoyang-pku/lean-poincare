/-- The divergence pairing of a potential φ with the divergence of a flow F over a region S. -/
def divPairing (D : DivergenceData V E) (F : E → ℝ) (φ : V → ℝ) (S : Finset V) : ℝ :=
  ∑ v ∈ S, φ v * D.divergence F v

/-- The gradient pairing over the interior edges of S. -/
def gradientPairing ... := ∑ e ∈ univ.filter (fun e => D.src e ∈ S ∧ D.tgt e ∈ S), F e * (φ (D.tgt e) - φ (D.src e))

/-- The boundary term: flux-weighted boundary values. -/
def boundaryPairing ... := 
  ∑ e ∈ univ.filter (fun e => D.src e ∈ S ∧ D.tgt e ∉ S), φ (D.src e) * F e
    - ∑ e ∈ univ.filter (fun e => D.tgt e ∈ S ∧ D.src e ∉ S), φ (D.tgt e) * F e
```

