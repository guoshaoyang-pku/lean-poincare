```lean
lemma sum_fiber_of_mem (s : Finset E) (g : E → V) (f : E → ℝ) (S : Finset V) :
    ∑ j ∈ S, ∑ i ∈ s.filter (fun i => g i = j), f i
      = ∑ i ∈ s.filter (fun i => g i ∈ S), f i := by
  have h1 : ∀ j, (∑ i ∈ s.filter (fun i => g i = j), f i) = ∑ i ∈ s, if g i = j then f i else 0 := by
    intro j; rw [Finset.sum_filter]
  calc ∑ j ∈ S, ∑ i ∈ s.filter (fun i => g i = j), f i
      = ∑ j ∈ S, ∑ i ∈ s, if g i = j then f i else 0 := by simp only [h1]
    _ = ∑ i ∈ s, ∑ j ∈ S, if g i = j then f i else 0 := by rw [Finset.sum_comm]
    _ = ∑ i ∈ s, if g i ∈ S then f i else 0 := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [Finset.sum_ite_eq']  -- ∑ j ∈ S, if g i = j then f i else 0 = if g i ∈ S then f i else 0
    _ = ∑ i ∈ s.filter (fun i => g i ∈ S), f i := by rw [Finset.sum_filter]
```

