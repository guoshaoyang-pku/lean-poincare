lemma slab_product_rule (u v : Fin (n+1) → ℝ) :
    (∑ i : Fin n, u i.castSucc * (v i.succ - v i.castSucc))
      + (∑ i : Fin n, (u i.succ - u i.castSucc) * v i.succ)
      = u (Fin.last n) * v (Fin.last n) - u 0 * v 0 := by
  rw [← Finset.sum_add_distrib]
  have : ∀ i : Fin n, u i.castSucc * (v i.succ - v i.castSucc) + (u i.succ - u i.castSucc) * v i.succ
      = (u i.succ * v i.succ) - (u i.castSucc * v i.castSucc) := by
    intro i; ring
  simp only [this]
  exact sum_telescope (fun i => u i * v i)
```

