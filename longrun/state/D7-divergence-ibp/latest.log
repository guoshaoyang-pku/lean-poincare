```lean
/-- Sums over a filtered finset split along a decidable predicate. -/
lemma sum_filter_split (p q : E → Prop) [DecidablePred p] [DecidablePred q] (f : E → ℝ) :
    (∑ e ∈ univ.filter (fun e => p e), f e)
      = (∑ e ∈ univ.filter (fun e => p e ∧ q e), f e)
        + (∑ e ∈ univ.filter (fun e => p e ∧ ¬ q e), f e) := by
  rw [Finset.sum_filter, Finset.sum_filter, Finset.sum_filter, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun e _ => ?_
  by_cases hp : p e <;> by_cases hq : q e <;> simp [hp, hq]
```

