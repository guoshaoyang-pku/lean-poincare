    intro v
    rw [Finset.sum_filter]
  calc ∑ v ∈ S, ∑ e ∈ Finset.univ.filter (fun e => D.src e = v), F e
      = ∑ v : V, if v ∈ S then ∑ e ∈ Finset.univ.filter (fun e => D.src e = v), F e else 0 := by
        rw [← Finset.sum_filter]
        congr 1
        ext v
        simp
