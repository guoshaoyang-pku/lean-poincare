The script:
```python
import json, os, subprocess, time, sys
WT = "/data3/.../D7-evolution-sharp-restatement"
ENV = dict(os.environ)
ENV["ELAN_HOME"] = "/data3/guoshaoyang/workdir/lean_poincare/elan"
ENV["PATH"] = ENV["ELAN_HOME"] + "/bin:" + ENV.get("PATH","")
files = []
for dirpath, dirnames, filenames in os.walk(WT):
    dirnames[:] = [d for d in dirnames if d not in (".lake",".git",".dshpkg")]
    for fn in filenames:
        if fn.endswith(".lean"):
            files.append(os.path.join(dirpath, fn))
files.sort()
results = []
for i,f in enumerate(files):
    t0=time.time()
    try:
        r = subprocess.run(["lake","env","lean",f], cwd=WT, env=ENV, capture_output=True, text=True, timeout=1800)
        rc=r.returncode; out=r.stdout[-2000:]; err=r.stderr[-4000:]
    except subprocess.TimeoutExpired:
        rc="timeout"; out=""; err=""
    dt=time.time()-t0
    results.append({"file":f,"exit":rc,"secs":round(dt,1)})
    print(f"[{i+1}/{len(files)}] {rc} {dt:.1f}s {f}", flush=True)
    if rc!=0:
        print("STDOUT:", out, flush=True)
        print("STDERR:", err, flush=True)
    json.dump(results, open(os.path.join(WT,"logs","d7_gate_replay.json"),"w"), indent=2)
print("DONE", flush=True)
```

