namespace GHPrecompactCertificate

variable {ι : Type v} {X : ι → PointedMetricSpace}

/-- The certificate gives a uniform finite covering of every `R`-ball by `netBound R ε`
balls of radius `ε`. -/
theorem exists_finset_cover_ball (C : GHPrecompactCertificate X) (i : ι) (R ε : ℝ)
    (hε : 0 < ε) :
    ∃ t : Finset (X i), t.card ≤ C.netBound R ε ∧
      ∀ x : X i, dist x (X i).base ≤ R → ∃ y ∈ t, dist x y < ε :=
  ⟨C.net i R ε, C.net_card_le i R ε, fun x hx => C.net_covers i R ε hε x hx⟩

/-- **Total-boundedness consequence.** The `R`-ball about the basepoint is totally bounded. -/
theorem totallyBounded_closedBall (C : GHPrecompactCertificate X) (i : ι) (R : ℝ) :
    TotallyBounded (Metric.closedBall (X i).base R) := by
  rw [Metric.totallyBounded_iff]
  intro ε hε
  exact ⟨C.net i R ε, fun x hx => C.net_covers i R ε hε x hx⟩
```
