/-- **Pigeonhole for finitely many values.**  Any sequence `u : ℕ → Fin n` has a value that
is attained infinitely often, and hence along a strictly monotone subsequence. -/
theorem exists_strictMono_const_of_fin {n : ℕ} (u : ℕ → Fin n) :
    ∃ i : Fin n, ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ k, u (φ k) = i := by
  have hunion : (Set.univ : Set ℕ) ⊆ ⋃ i : Fin n, u ⁻¹' {i} := by
    intro m _; exact Set.mem_iUnion.mpr ⟨u m, rfl⟩
  by_contra h
  push_neg at h
  -- h : ∀ i, (u ⁻¹' {i}).Finite
  have hfin : (Set.univ : Set ℕ).Finite :=
    (Set.finite_iUnion (fun i : Fin n => h i)).subset hunion
  exact Set.infinite_univ hfin  -- or `Set.not_finite`
```
