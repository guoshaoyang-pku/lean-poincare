Composition:
```lean
def comp {Z : PointedMetricSpace} (D₂ : GHConvergenceData l Y Z)
    (D₁ : GHConvergenceData l X Y) : GHConvergenceData l X Z where
  ε := fun i => D₁.ε i + 2 * D₂.ε i
  ε_nonneg := fun i => by have := D₁.ε_nonneg i; have := D₂.ε_nonneg i; linarith
  ε_tendsto := by
    have h2 : Tendsto (fun i => 2 * D₂.ε i) l (𝓝 (2 * 0)) :=
      D₂.ε_tendsto.const_mul 2
    simpa using D₁.ε_tendsto.add h2
  approx := fun i x => D₂.approx i (D₁.approx i x)
  distortion := by
    intro i x y
    have h₁ := abs_le.mp (D₁.distortion i x y)
    have h₂ := abs_le.mp (D₂.distortion i (D₁.approx i x) (D₁.approx i y))
    have h2u : dist (D₂.approx i (D₁.approx i x)) (D₂.approx i (D₁.approx i y))
        ≤ dist (D₁.approx i x) (D₁.approx i y) + D₂.ε i := by linarith
    have h1u : dist (D₁.approx i x) (D₁.approx i y) ≤ dist x y + D₁.ε i := by linarith
    have h1l : dist x y ≤ dist (D₁.approx i x) (D₁.approx i y) + D₁.ε i := by linarith
    rw [abs_le]
    constructor <;> linarith
  surjective := by
    intro i z
    obtain ⟨y, hy⟩ := D₂.surjective i z
    obtain ⟨x, hx⟩ := D₁.surjective i y
    refine ⟨x, ?_⟩
    have h2 := D₂.distortion_le i y (D₁.approx i x)
    linarith
  base_dist := by
    intro i
    have h₂ := D₂.base_dist i
    have h₁ := D₁.base_dist i
    have h2 := D₂.distortion_le i (D₁.approx i (X i).base) (Y.base)
    -- h2 : dist (D₂.approx i (D₁.approx i (X i).base)) (D₂.approx i (Y.base)) ≤ dist (D₁.approx i (X i).base) Y.base + D₂.ε i
    -- but base_dist needs dist (D₂.approx i (D₁.approx i (X i).base)) Z.base
    -- D₂.base_dist i : dist (D₂.approx i (Y.base)) Z.base ≤ D₂.ε i
    calc dist (D₂.approx i (D₁.approx i (X i).base)) Z.base
        ≤ dist (D₂.approx i (D₁.approx i (X i).base)) (D₂.approx i (Y.base))
            + dist (D₂.approx i (Y.base)) Z.base := dist_triangle _ _ _
      _ ≤ (dist (D₁.approx i (X i).base) Y.base + D₂.ε i) + D₂.ε i := by linarith
      _ ≤ (D₁.ε i + D₂.ε i) + D₂.ε i := by linarith [D₁.base_dist i]
      _ = D₁.ε i + 2 * D₂.ε i := by ring
```
Note `D₂.distortion_le i y (D₁.approx i x)` gives `dist (D₂.approx i y) (D₂.approx i (D₁.approx i x)) ≤ dist y (D₁.approx i x) + D₂.ε i`; and `hx : dist y (D₁.approx i x) ≤ D₁.ε i`. Then `dist z (D₂.approx i (D₁.approx i x)) ≤ dist z (D₂.approx i y) + dist (D₂.approx i y) (D₂.approx i (D₁.approx i x))` — hmm, need the triangle and symmetry. Let me write it carefully:
