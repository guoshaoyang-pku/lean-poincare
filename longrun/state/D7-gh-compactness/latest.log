calc dist z (D₂.approx i (D₁.approx i x))
    ≤ dist z (D₂.approx i y) + dist (D₂.approx i y) (D₂.approx i (D₁.approx i x)) := dist_triangle _ _ _
  _ ≤ D₂.ε i + (dist y (D₁.approx i x) + D₂.ε i) := by linarith
  _ ≤ D₂.ε i + (D₁.ε i + D₂.ε i) := by linarith
