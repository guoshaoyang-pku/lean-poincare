```lean
def mono (D : GHConvergenceData l X Y) (δ : ι → ℝ) (hδ : ∀ i, D.ε i ≤ δ i)
    (hδ0 : ∀ i, 0 ≤ δ i) (hδt : Tendsto δ l (𝓝 0)) : GHConvergenceData l X Y where
