  net_card_le : ∀ i R ε, (net i R ε).card ≤ netBound R ε
  base_mem_net : ∀ i R ε, (X i).base ∈ net i R ε
  net_covers : ∀ i R ε, 0 < ε → ∀ x : X i, dist x (X i).base ≤ R →
