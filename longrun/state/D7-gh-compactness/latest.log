theorem isCompact_closedBall_any (C : GHPrecompactCertificate X) (i : ι) (x : X i) (r : ℝ) :
    IsCompact (Metric.closedBall x r) := by
  refine IsCompact.of_isClosed_subset (C.isCompact_closedBall i (r + dist x (X i).base))
    Metric.isClosed_closedBall ?_
