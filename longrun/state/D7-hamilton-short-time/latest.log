```lean
import Poincare.D7.ShortTime.Basic

/-! ... -/

open scoped Matrix.Norms.Frobenius

namespace Poincare
namespace D7
namespace ShortTime

noncomputable section

/-- A time-dependent vector field on a normed space that is globally Lipschitz in the state
variable at every time. -/
structure LipschitzVectorField (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] where
  toFun : ℝ → E → E
  K : ℝ≥0
  lipschitz : ∀ t, LipschitzWith K (toFun t)

namespace LipschitzVectorField

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (V : LipschitzVectorField E)

theorem lipschitzOnWith (t : ℝ) : LipschitzOnWith V.K (V.toFun t) Set.univ :=
  (V.lipschitz t).lipschitzOnWith

/-- **Uniqueness of solutions of the ODE `y' = V(t, y)`.** ... -/
theorem solution_unique {f g : ℝ → E}
    (hf : ∀ t, HasDerivAt f (V.toFun t (f t)) t)
    (hg : ∀ t, HasDerivAt g (V.toFun t (g t)) t)
    (h0 : f 0 = g 0) : f = g :=
  ODE_solution_unique_univ (s := fun _ => Set.univ)
    (fun t => V.lipschitzOnWith t) (fun t => ⟨hf t, trivial⟩) (fun t => ⟨hg t, trivial⟩) h0

/-- Pointwise version. -/
theorem solution_eq {f g : ℝ → E} ... (t : ℝ) : f t = g t := congrFun (V.solution_unique hf hg h0) t
```

