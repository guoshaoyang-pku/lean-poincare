```lean
/-- **The pullback of the DeTurck flow solves the Ricci flow.** This is the algebraic DeTurck
trick: if `G` solves `G' = -2 Ric(G) - Bᵀ G - G B` and `A' = B A`, then `Aᵀ G A` solves
`H' = -2 Ric(H)`. -/
theorem pullback_hasDerivAt (t : ℝ) :
    HasDerivAt (fun s : ℝ => (C.gauge s)ᵀ * C.deturckMetric s * C.gauge s)
      ((-2 : ℝ) • D.ricci ((C.gauge t)ᵀ * C.deturckMetric t * C.gauge t)) t := by
  have hA : HasDerivAt (fun s : ℝ => (C.gauge s)ᵀ) ((C.gaugeField t * C.gauge t)ᵀ) t :=
    hasDerivAt_transpose (C.gauge_ode t)
  have h1 : HasDerivAt (fun s : ℝ => (C.gauge s)ᵀ * C.deturckMetric s)
      ((C.gaugeField t * C.gauge t)ᵀ * C.deturckMetric t +
        (C.gauge t)ᵀ * deTurckRHS D (C.gaugeField t) (C.deturckMetric t)) t :=
    hasDerivAt_mul hA (C.deturck_flow t)
  have h2 : HasDerivAt (fun s : ℝ => (C.gauge s)ᵀ * C.deturckMetric s * C.gauge s)
      (((C.gaugeField t * C.gauge t)ᵀ * C.deturckMetric t +
