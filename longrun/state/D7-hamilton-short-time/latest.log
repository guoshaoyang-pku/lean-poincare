structure RicciFlowData (n : ℕ) where
  ricci : Matrix (Fin n) (Fin n) ℝ → Matrix (Fin n) (Fin n) ℝ
  ricci_symm : ∀ G : Matrix (Fin n) (Fin n) ℝ, (ricci G)ᵀ = ricci G
  ricci_congruence : ∀ (G A : Matrix (Fin n) (Fin n) ℝ), IsUnit A.det →
