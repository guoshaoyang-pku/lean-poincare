  metric : ℝ → Matrix (Fin n) (Fin n) ℝ
  metric_symm : ∀ t : ℝ, (metric t)ᵀ = metric t
  ricci_flow : ∀ t : ℝ, HasDerivAt metric (-2 • ricci (metric t)) t
```

