```lean
import Poincare.D7.ShortTime.MatrixDeriv

namespace Poincare.D7.ShortTime

section Algebra
variable {n : ℕ}

/-- The gauge action on matrices: `G ↦ Aᵀ G A`. -/
def gaugeAction (A G : Matrix ...) := Aᵀ * G * A

theorem gaugeAction_def ...
theorem gaugeAction_transpose ...
theorem gaugeAction_inv_mul ...

/-- The key algebraic identity of the DeTurck trick: the derivative of the pullback
`Aᵀ G A` along `A' = B A` is the pullback of `Bᵀ G + G' + G B`. -/
theorem gauge_pullback_algebra (A B G G' : Matrix ...) :
    (B * A)ᵀ * G * A + Aᵀ * G' * A + Aᵀ * G * (B * A)
      = Aᵀ * (Bᵀ * G + G' + G * B) * A := by
  rw [Matrix.transpose_mul]
  noncomm_ring

/-- Adding the gauge correction to the modified right-hand side recovers the Ricci flow
right-hand side: `Bᵀ G + deTurckRHS + G B = -2 Ric G`. -/
theorem deTurckRHS_add_gauge (D : RicciFlowData n) (B G : Matrix ...) :
    Bᵀ * G + deTurckRHS D B G + G * B = -2 • D.ricci G := by
  simp only [deTurckRHS]
  abel

/-- The pullback of the modified right-hand side is the Ricci flow right-hand side of the
pullback metric, by gauge covariance. -/
theorem gauge_pullback_deTurckRHS (D : RicciFlowData n) (A B G : Matrix ...)
    (hA : IsUnit A.det) :
    (B * A)ᵀ * G * A + Aᵀ * deTurckRHS D B G * A + Aᵀ * G * (B * A)
      = -2 • D.ricci (Aᵀ * G * A) := by
  rw [gauge_pullback_algebra, deTurckRHS_add_gauge]
  rw [Matrix.mul_smul, Matrix.smul_mul, ← D.ricci_congruence G A hA]
  -- goal: (-2) • (Aᵀ * Ric G * A) = -2 • Ric (Aᵀ * G * A)
  rw [D.ricci_congruence G A hA]
```
