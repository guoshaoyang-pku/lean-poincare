import Poincare.D7.ShortTime.Equivalence

/-! ... -/

namespace Poincare.D7.ShortTime

noncomputable section

/-- **Abstract continuum data for the Ricci--DeTurck flow.** ... -/
structure DeTurckParabolicProblem where
  /-- The state space of metrics. -/
  MetricState : Type
  /-- Metric states form a normed vector space in the model (for the finite-dimensional
  instance) or are intended to be a Fréchet/Banach space of smooth metrics in the continuum
  reading. -/
  instNormedAddCommGroup : NormedAddCommGroup MetricState
  instNormedSpace : NormedSpace ℝ MetricState
  /-- The Ricci flow right-hand side `-2 Ric`. -/
  ricciOp : MetricState → MetricState
  /-- The DeTurck-modified right-hand side at time `t`, including the gauge correction. -/
  deTurckOp : ℝ → MetricState → MetricState
  /-- The initial metric. -/
  initial : MetricState
  /-- The pullback along the gauge diffeomorphism flow. -/
  gaugeTransform : (ℝ → MetricState) → ℝ → MetricState
  /-- The gauge transform fixes the initial time: `Φ_0^* = id`. -/
  gaugeTransform_zero : ∀ u : ℝ → MetricState, gaugeTransform u 0 = u 0
  /-- `IsDeTurckSolutionOn T u` means `u` solves the modified flow on `(0,T)`. -/
  IsDeTurckSolutionOn : ℝ → (ℝ → MetricState) → Prop
  /-- `IsRicciFlowOn T u` means `u` solves the Ricci flow on `(0,T)`. -/
  IsRicciFlowOn : ℝ → (ℝ → MetricState) → Prop
  /-- The solution predicates are the `HasDerivAt` equations. -/
  isDeTurckSolutionOn_iff : ∀ (T : ℝ) (u : ℝ → MetricState),
    IsDeTurckSolutionOn T u ↔ ∀ t ∈ Set.Ioo (0:ℝ) T, HasDerivAt u (deTurckOp t (u t)) t
  isRicciFlowOn_iff : ∀ (T : ℝ) (u : ℝ → MetricState),
    IsRicciFlowOn T u ↔ ∀ t ∈ Set.Ioo (0:ℝ) T, HasDerivAt u (ricciOp (u t)) t
```

