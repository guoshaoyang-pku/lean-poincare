namespace RicciLipschitzInterface
def toLipschitzVectorField (L : RicciLipschitzInterface D) : LipschitzVectorField (Matrix (Fin n) (Fin n) ℝ) where
  toFun := D.ricciVectorField
  K := L.K
  lipschitz := L.lipschitz

theorem solution_unique ... 
```

