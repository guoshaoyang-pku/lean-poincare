structure GridHeatSolution (step : Matrix X X ℝ) (f : X → ℝ) (B : ℕ → X → ℝ) where
  u : ℕ → X → ℝ
  initial : u 0 = f
  step_eq : ∀ n, u (n + 1) = step *ᵥ u n
  bounded : ∀ n x, |u n x| ≤ B n x

theorem GridHeatSolution.unique (u v : GridHeatSolution step f B) : u.u = v.u := by
  funext n x
  induction n with
  | zero => rw [u.initial, v.initial]
  | succ n ih => rw [u.step_eq n, v.step_eq n, ih]
