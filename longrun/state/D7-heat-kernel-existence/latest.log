  generator : K 1 = step
  semigroup : ∀ m n, K (m + n) = K m * K n
  upperBound : ∀ n x y, 0 < n → K n x y ≤ C_up * (n : ℝ) ^ (-(dim / 2)) * Real.exp (-(d x y)^2 / (c_up * n))
