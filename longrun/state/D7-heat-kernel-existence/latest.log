def gridKernel (step : Matrix X X ℝ)
    (hupper : ∀ n, 0 < n → ∀ x y, step^n x y ≤ ...)
    (hlower : ∀ n, 0 < n → ∀ x y, d x y ≤ 1 → ... ≤ step^n x y) :
    FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo where
  K := fun n => step ^ n
  initial := pow_zero step
  generator := pow_one step
  semigroup := fun m n => pow_add step m n
  upperBound := hupper
  lowerBound := hlower
