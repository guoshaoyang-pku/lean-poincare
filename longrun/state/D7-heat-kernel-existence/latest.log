noncomputable section
open Matrix

variable {X : Type*} [Fintype X] [DecidableEq X]

/-- The discrete heat content of a temperature field `u` with respect to a density `μ`. -/
def heatContent (μ u : X → ℝ) : ℝ := ∑ x, μ x * u x

/-- The `L²` energy of a temperature field. -/
def l2Energy (u : X → ℝ) : ℝ := ∑ x, (u x) ^ 2

/-- One step of the discrete heat flow. -/
def heatStep (P : Matrix X X ℝ) (u : X → ℝ) : X → ℝ := P *ᵥ u
```

