theorem heatContent_heatStep_le (P : Matrix X X ℝ) (μ u : X → ℝ)
    (hP : ∀ x y, 0 ≤ P x y) (hμ : ∀ x, 0 ≤ μ x) (hu : ∀ x, 0 ≤ u x)
    (hcol : ∀ y, ∑ x, μ x * P x y ≤ μ y) :
    heatContent μ (heatStep P u) ≤ heatContent μ u := by
  have expand : heatContent μ (heatStep P u) = ∑ y, (∑ x, μ x * P x y) * u y := by
    simp only [heatContent, heatStep, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun y _ => ?_)
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl (fun x _ => by ring)
  rw [expand]
  calc ∑ y, (∑ x, μ x * P x y) * u y ≤ ∑ y, μ y * u y := by
        refine Finset.sum_le_sum (fun y _ => ?_)
        exact mul_le_mul_of_nonneg_right (hcol y) (hu y)
    _ = heatContent μ u := rfl
```
