theorem FiniteGridHeatKernel.eq_pow (K : FiniteGridHeatKernel step d dim C_up c_up C_lo c_lo) :
    K.K = fun n => step ^ n := by
  funext n
  induction n with
  | zero => simpa using K.initial
  | succ n ih =>
