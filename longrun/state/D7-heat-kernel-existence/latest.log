```lean
lemma weighted_cauchy_schwarz {ι} (s : Finset ι) (a b : ι → ℝ) (ha : ∀ i ∈ s, 0 ≤ a i) :
    (∑ i ∈ s, a i * b i) ^ 2 ≤ (∑ i ∈ s, a i) * (∑ i ∈ s, a i * b i ^ 2) := by
  have key := Finset.sum_mul_sq_le_sq_mul_sq s (fun i => Real.sqrt (a i)) (fun i => Real.sqrt (a i) * b i)
  -- key : (∑ i ∈ s, sqrt (a i) * (sqrt (a i) * b i))^2 ≤ (∑ i ∈ s, sqrt (a i)^2) * (∑ i ∈ s, (sqrt (a i) * b i)^2)
  have h1 : ∀ i ∈ s, Real.sqrt (a i) * (Real.sqrt (a i) * b i) = a i * b i := by
    intro i hi
    rw [← mul_assoc, Real.sq_sqrt (ha i hi), sq]
  have h2 : ∀ i ∈ s, (Real.sqrt (a i))^2 = a i := fun i hi => Real.sq_sqrt (ha i hi)
  have h3 : ∀ i ∈ s, (Real.sqrt (a i) * b i)^2 = a i * b i^2 := by
    intro i hi
    rw [mul_pow, Real.sq_sqrt (ha i hi)]  -- (sqrt a)^2 * b^2 = a * b^2
  ... rw these in key
```
