**Basic.lean** — `HeatKernelData`:
```lean
structure HeatKernelData (X : Type*) [PseudoMetricSpace X] [MeasurableSpace X] where
  kernel : X → X → ℝ → ℝ
  n : ℝ  -- dimension
  C_up : ℝ; c_up : ℝ; C_lo : ℝ; c_lo : ℝ
  C_up_nonneg : 0 ≤ C_up
  c_up_pos : 0 < c_up
  C_lo_nonneg : 0 ≤ C_lo
  c_lo_pos : 0 < c_lo
  kernel_nonneg : ∀ x y t, 0 ≤ kernel x y t
  upper_bound : ∀ x y t, 0 < t → kernel x y t ≤ C_up * t ^ (-(n/2)) * Real.exp (-(dist x y)^2 / (c_up * t))
  lower_bound : ∀ x y t, 0 < t → dist x y ≤ 1 → C_lo * t ^ (-(n/2)) * Real.exp (-(dist x y)^2 / (c_lo * t)) ≤ kernel x y t
  symmetry : ∀ x y t, kernel x y t = kernel y x t
  semigroup : ∀ x y s t, 0 < s → 0 < t → kernel x y (s+t) = ∫ z, kernel x z s * kernel z y t ∂volume
  normalization : ∀ x t, 0 < t → ∫ y, kernel x y t ∂volume = 1
  heat_equation : ... (maybe derivative, skip)
```
