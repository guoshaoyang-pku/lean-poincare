theorem l2Energy_heatStep_le (P u) (hP : ∀ x y, 0 ≤ P x y)
    (hrow : ∀ x, ∑ y, P x y ≤ 1) (hcol : ∀ y, ∑ x, P x y ≤ 1) :
    l2Energy (heatStep P u) ≤ l2Energy u := by
  have hstep : ∀ x, (heatStep P u x)^2 ≤ (∑ y, P x y) * (∑ y, P x y * (u y)^2) :=
    fun x => weighted_cauchy_schwarz Finset.univ (fun y => P x y) u (fun y _ => hP x y)
  calc l2Energy (heatStep P u) = ∑ x, (heatStep P u x)^2 := rfl
    _ ≤ ∑ x, (∑ y, P x y) * (∑ y, P x y * (u y)^2) := Finset.sum_le_sum (fun x _ => hstep x)
    _ ≤ ∑ x, 1 * (∑ y, P x y * (u y)^2) := by
        refine Finset.sum_le_sum (fun x _ => ?_)
        exact mul_le_mul_of_nonneg_right (hrow x) (Finset.sum_nonneg (fun y _ => mul_nonneg (hP x y) (sq_nonneg _)))
    _ = ∑ y, (∑ x, P x y) * (u y)^2 := by
        simp only [one_mul]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun y _ => ?_)
        rw [Finset.sum_mul]
