    connectionCoefficient m (affineConnection a nabla₁ nabla₂) i j k =
      a * connectionCoefficient m nabla₁ i j k + (1 - a) * connectionCoefficient m nabla₂ i j k := by
  simp [connectionCoefficient, affineConnection_apply, map_add, map_smul, Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul]
