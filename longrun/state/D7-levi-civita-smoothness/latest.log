Design:
```lean
import Mathlib.Analysis.Calculus.ContDiff.Operations
import Mathlib.Analysis.Calculus.ContDiff.Comp

/-! ... -/

open scoped BigOperators

namespace Poincare
namespace D7
namespace LeviCivita

universe u w

variable {P : Type u} [NormedAddCommGroup P] [NormedSpace ℝ P]
variable {ι : Type w} [Fintype ι] [DecidableEq ι]

/-- Chart-level metric data: metric coefficients and inverse-metric coefficients in a chart,
with the inverse relation. This is the coordinate expression of a Riemannian metric. -/
structure ChartMetricData (P : Type u) (ι : Type w) [Fintype ι] where
  g : ι → ι → P → ℝ
  ginv : ι → ι → P → ℝ
  g_symm : ∀ i j x, g i j x = g j i x
  inv_left : ∀ i j x, ∑ k, ginv i k x * g k j x = if i = j then 1 else 0
  inv_right : ∀ i j x, ∑ k, g k i x * ginv k j x = if i = j then 1 else 0

/-- The Koszul formula for the Christoffel symbols ... -/
noncomputable def christoffelSymbol (G : ChartMetricData P ι) (v : ι → P)
    (m i j : ι) (x : P) : ℝ :=
  (1 / 2) * ∑ k : ι,
    G.ginv m k x *
      (fderiv ℝ (G.g j k) x (v i) + fderiv ℝ (G.g i k) x (v j) -
        fderiv ℝ (G.g i j) x (v k))

/-- The directional derivative of a chart metric coefficient is `C^n` when the coefficient is
`C^{n+1}`. -/
theorem contDiff_fderiv_coeff {n : ℕ∞} {f : P → ℝ} (hf : ContDiff ℝ (n + 1) f) (w : P) :
    ContDiff ℝ n (fun x => fderiv ℝ f x w) :=
  (hf.contDiff_fderiv_apply (m := n) (n := n + 1) le_rfl).comp
    (contDiff_id.prod contDiff_const)

theorem contDiff_christoffelSymbol (n : ℕ∞) (G : ChartMetricData P ι) (v : ι → P)
    (hg : ∀ i j, ContDiff ℝ (n + 1) (G.g i j))
    (hginv : ∀ i j, ContDiff ℝ (n + 1) (G.ginv i j)) (m i j : ι) :
    ContDiff ℝ n (G.christoffelSymbol v m i j) := by
  have hterm : ∀ k : ι, ContDiff ℝ n (fun x : P =>
      G.ginv m k x *
        (fderiv ℝ (G.g j k) x (v i) + fderiv ℝ (G.g i k) x (v j) -
          fderiv ℝ (G.g i j) x (v k))) := by
    intro k
    have h1 : ContDiff ℝ n (fun x => fderiv ℝ (G.g j k) x (v i)) :=
      contDiff_fderiv_coeff (hg j k) (v i)
    have h2 : ContDiff ℝ n (fun x => fderiv ℝ (G.g i k) x (v j)) :=
      contDiff_fderiv_coeff (hg i k) (v j)
    have h3 : ContDiff ℝ n (fun x => fderiv ℝ (G.g i j) x (v k)) :=
      contDiff_fderiv_coeff (hg i j) (v k)
    exact (hginv m k).mul ((h1.add h2).sub h3)
  have hsum : ContDiff ℝ n (fun x : P => ∑ k : ι, G.ginv m k x *
      (fderiv ℝ (G.g j k) x (v i) + fderiv ℝ (G.g i k) x (v j) -
        fderiv ℝ (G.g i j) x (v k))) :=
    ContDiff.sum Finset.univ hterm  -- check signature
  exact contDiff_const.mul hsum
```

