This is the substantive calculus theorem. Let me attempt it with `ContDiff` on normed spaces, since `ContDiff.contDiff_fderiv_apply` is clean there. I'll write it as a self-contained theorem:

```lean
variable {P : Type*} [NormedAddCommGroup P] [NormedSpace ℝ P]
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Chart-level data: metric coefficients `g i j : P → ℝ` and inverse-metric coefficients
`ginv i j : P → ℝ` in a chart, together with the inverse relation. -/
structure ChartMetricData (P : Type*) (ι : Type*) [Fintype ι] where
  g : ι → ι → P → ℝ
  ginv : ι → ι → P → ℝ
  g_symm : ∀ i j x, g i j x = g j i x
  inv_left : ∀ i j x, ∑ k, ginv i k x * g k j x = if i = j then 1 else 0
  inv_right : ∀ i j x, ∑ k, g k i x * ginv k j x = if i = j then 1 else 0

/-- The Christoffel symbols of the chart metric in the coordinate frame `v : ι → P`,
Koszul formula `Γ^m_{ij} = ½ ∑_k g^{mk} (∂_i g_{jk} + ∂_j g_{ik} - ∂_k g_{ij})`. -/
noncomputable def christoffelSymbol (G : ChartMetricData P ι) (v : ι → P)
    (m i j : ι) (x : P) : ℝ :=
  (1 / 2) * ∑ k : ι,
    G.ginv m k x *
      (fderiv ℝ (G.g j k) x (v i) + fderiv ℝ (G.g i k) x (v j) -
        fderiv ℝ (G.g i j) x (v k))

/-- **Chart-smoothness hypothesis implies smooth Christoffel symbols.** If the metric
coefficients and the inverse-metric coefficients are `C^{n+1}` in the chart, then the Koszul
Christoffel symbols are `C^n`. -/
theorem contDiff_christoffelSymbol (n : ℕ∞) (G : ChartMetricData P ι) (v : ι → P)
    (hg : ∀ i j, ContDiff ℝ (n + 1) (G.g i j))
    (hginv : ∀ i j, ContDiff ℝ (n + 1) (G.ginv i j)) (m i j : ι) :
    ContDiff ℝ n (G.christoffelSymbol v m i j)
```

