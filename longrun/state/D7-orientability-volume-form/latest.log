@[simp] theorem reverse_orientation (D) : D.reverse.orientation = -D.orientation := rfl

theorem reverse_volumeForm (D) : D.reverse.volumeForm = -D.volumeForm := by
  letI : Fact (finrank ℝ V = D.n) := ⟨D.finrank_eq⟩
