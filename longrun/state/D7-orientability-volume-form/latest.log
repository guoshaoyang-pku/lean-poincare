import Poincare.D7.Volume.Basic
import Mathlib.MeasureTheory.Measure.Lebesgue.EqHaar

namespace Poincare.D7.Volume

open MeasureTheory

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]

/-- Change of variables for the volume form under a linear endomorphism. -/
theorem volumeForm_comp_linearMap (D : VolumeFormData V)
    (b : OrthonormalBasis (Fin D.n) ℝ V) (hb : b.toBasis.orientation = D.orientation)
    (T : V →ₗ[ℝ] V) (v : Fin D.n → V) :
    D.volumeForm (T ∘ v) = LinearMap.det T * D.volumeForm v := by
  rw [D.volumeForm_eq_det b hb, Basis.det_comp]

/-- Change of variables for the Haar measure under a linear map with nonzero determinant. -/
theorem lintegral_comp_linearMap_eq {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [MeasurableSpace E] [BorelSpace E] [FiniteDimensional ℝ E]
    (μ : Measure E) [IsAddHaarMeasure μ] {T : E →ₗ[ℝ] E} (hT : LinearMap.det T ≠ 0)
    (g : E → ℝ≥0∞) (hg : Measurable g) :
    ∫⁻ x, g (T x) ∂μ = ENNReal.ofReal |(LinearMap.det T)⁻¹| * ∫⁻ y, g y ∂μ := by
  rw [← lintegral_map hg T.continuous_of_finiteDimensional.measurable]
  rw [Measure.map_linearMap_addHaar_eq_smul_addHaar μ hT]
  rw [lintegral_smul_measure]
  rfl
```

