```lean
import Poincare.D7.Volume.Basic

noncomputable section

open Module

namespace Poincare.D7.Volume

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]

/-- `(√c)⁻¹` as a unit of `ℝ`. -/
def sqrtInvUnit (c : ℝ) (hc : 0 < c) : ℝˣ :=
  Units.mk0 (Real.sqrt c)⁻¹ (inv_ne_zero (Real.sqrt_ne_zero_of_pos hc))

/-- The orthonormal basis of the metric `c • g`... -/
noncomputable def scaledBasis (D : VolumeFormData V) (b : OrthonormalBasis (Fin D.n) ℝ V)
    (c : ℝ) (hc : 0 < c) : Basis (Fin D.n) ℝ V :=
  b.toBasis.unitsSMul fun _ => sqrtInvUnit c hc
```

