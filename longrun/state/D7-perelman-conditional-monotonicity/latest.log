```
have hvol : volume (T-x) ≤ volume (T-y) := antitoneOn (T-y ∈ Ioi) (T-x ∈ Ioi) (T-y ≤ T-x)
have hlog : log (volume (T-x)) ≤ log (volume (T-y)) := Real.log_le_log (volume_pos (T-x)) hvol
have hcorr : correction x ≤ correction y := H.correction_monotone hx hy hxy
