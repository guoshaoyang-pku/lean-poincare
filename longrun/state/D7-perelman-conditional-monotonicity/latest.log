  weighted_ibp : ∀ t : ℝ, 0 < t → WeightedIBPStatement C (E t)
  weighted_laplacian_compatibility : ∀ t : ℝ, 0 < t → WeightedLaplacianStatement C (E t)
  bochner : BochnerStatement C
