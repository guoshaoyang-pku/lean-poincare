/-! ## 1. Consumption of the D7 reduced-volume certificate -/

/-- Re-export: ... -/
theorem reducedVolume_antitone_of_certificate (C : Reduced.ReducedVolumeCertificate E) :
    AntitoneOn C.volume (Set.Ioi 0) := C.antitoneOn

/-- Backward-time monotonicity ... -/
theorem reducedVolume_le_of_le (C : Reduced.ReducedVolumeCertificate E) {τ₁ τ₂ : ℝ}
    (h₁ : 0 < τ₁) (h : τ₁ ≤ τ₂) : C.volume τ₂ ≤ C.volume τ₁ := C.volume_le_of_le h₁ h

/-- -log of the reduced volume is nondecreasing in backward time. -/
theorem neg_log_reducedVolume_monotoneOn (C : Reduced.ReducedVolumeCertificate E)
    (hpos : ∀ τ, 0 < τ → 0 < C.volume τ) :
    MonotoneOn (fun τ => -Real.log (C.volume τ)) (Set.Ioi 0) :=
  C.neg_log_monotoneOn hpos

/-- log of the reduced volume is nonincreasing in backward time. -/
theorem log_reducedVolume_antitoneOn (C : Reduced.ReducedVolumeCertificate E)
    (hpos : ∀ τ, 0 < τ → 0 < C.volume τ) :
    AntitoneOn (fun τ => Real.log (C.volume τ)) (Set.Ioi 0) := by
  intro x hx y hy hxy
  exact Real.log_le_log (hpos y hy) (C.antitoneOn hx hy hxy)

