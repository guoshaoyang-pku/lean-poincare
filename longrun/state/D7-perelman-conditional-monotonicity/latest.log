structure PerelmanWKernelHypotheses {X} [MeasurableSpace X] {μ : Measure X}
    (E : ℝ → EntropyData X μ) where
  /-- The D7 conjugate-heat certificate (backward heat operator with scalar-curvature term). -/
  conjugateHeat : ConjugateHeatData ℝ
  /-- The heat jet and weight jet at each time. -/
  heatJet : ℝ → Jet ℝ
  weightJet : ℝ → Jet ℝ
  /-- The weight solves the conjugate heat equation. -/
  weight_isConjugateHeatJet : ∀ t : ℝ, 0 < t → conjugateHeat.IsConjugateHeatJet (weightJet t)
  /-- The D7 integration-by-parts certificate at every positive time, on a closed
  stationary region (vanishing boundary form and volume variation). -/
  ibp : ∀ t : ℝ, 0 < t → ConjugateHeatIBPCertificate conjugateHeat (heatJet t) (weightJet t)
  ibp_boundaryForm : ∀ t ht, (ibp t ht).boundaryForm = 0
  ibp_volumeVariation : ∀ t ht, (ibp t ht).volumeVariation = 0
  /-- The W first-variation (open analytic input). -/
  w_derivative : ∀ t : ℝ, 0 < t →
    HasDerivAt (fun s : ℝ => (E s).W) (2 * (E t).τ * EntropyData.FDissipation (E t)) t
  /-- Continuity on [0, ∞). -/
  w_continuousOn : ContinuousOn (fun s : ℝ => (E s).W) (Ici 0)
  /-- One-sided upper bound. -/
  upperBound : ℝ
  upper_le : ∀ t : ℝ, 0 ≤ t → (E t).W ≤ upperBound
```

