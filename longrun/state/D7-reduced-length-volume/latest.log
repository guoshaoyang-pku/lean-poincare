```lean
theorem integral_one_div_sqrt {τ : ℝ} (hτ : 0 ≤ τ) :
    ∫ x in (0:ℝ)..τ, 1 / Real.sqrt x = 2 * Real.sqrt τ := by
  have hrpow : ∫ x in (0:ℝ)..τ, x ^ (-(1/2) : ℝ) = (τ ^ ((-(1/2)) + 1) - 0 ^ ((-(1/2)) + 1)) / ((-(1/2)) + 1) :=
    integral_rpow (a := 0) (b := τ) (r := -(1/2)) (Or.inl (by norm_num))
  -- LHS: x^(-1/2) = 1/√x
  have hcongr : ∫ x in (0:ℝ)..τ, x ^ (-(1/2) : ℝ) = ∫ x in (0:ℝ)..τ, 1 / Real.sqrt x := by
    refine intervalIntegral.integral_congr fun x hx => ?_
    -- x ∈ Icc 0 τ so x ≥ 0
    have hx0 : 0 ≤ x := (Set.mem_uIcc.mp hx).1
    rw [show (-(1/2) : ℝ) = -(1/2) by norm_num, Real.rpow_neg hx0, Real.sqrt_eq_rpow]
    ring
  rw [← hcongr, hrpow]
  -- simplify RHS: (τ^(1/2) - 0^(1/2))/(1/2) = 2√τ
  rw [show (-(1/2) + 1 : ℝ) = 1/2 by norm_num]
  rw [Real.zero_rpow (by norm_num : (1/2 : ℝ) ≠ 0), sub_zero, div_one? ...]
  -- τ^(1/2) = √τ, and divide by 1/2 = multiply by 2
  rw [Real.sqrt_eq_rpow]
  ring
```
