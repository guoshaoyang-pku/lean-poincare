/-- A reduced-volume certificate: the volume functional Ṽ and its backward-time derivative,
with the monotonicity input as fields. -/
structure ReducedVolumeCertificate (E) [NormedAddCommGroup E] [InnerProductSpace ℝ E] where
  flow : MetricFlowInterface E
