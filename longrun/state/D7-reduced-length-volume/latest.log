open Set MeasureTheory intervalIntegral
open scoped RealInnerProductSpace

namespace Poincare
namespace D7
namespace Reduced

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Stated metric-flow interface: ... -/
structure MetricFlowInterface (E : Type*) [NormedAddCommGroup E] [InnerProductSpace ℝ E] where
  scalarCurvature : ℝ → E → ℝ
  metric : ℝ → E → E → ℝ
  metric_symm : ∀ τ x y, metric τ x y = metric τ y x
  metric_self_nonneg : ∀ τ x, 0 ≤ metric τ x x

namespace MetricFlowInterface

variable (F : MetricFlowInterface E)

/-- ... -/
def LIntegrand (γ : ℝ → E) (τ : ℝ) : ℝ :=
  Real.sqrt τ * (F.scalarCurvature τ (γ τ) + F.metric τ (deriv γ τ) (deriv γ τ))

def Llength (γ : ℝ → E) (τ₁ τ₂ : ℝ) : ℝ :=
  ∫ τ in τ₁..τ₂, F.LIntegrand γ τ

def LlengthAlong (γ γ' : ℝ → E) (τ₁ τ₂ : ℝ) : ℝ :=
  ∫ τ in τ₁..τ₂, Real.sqrt τ * (F.scalarCurvature τ (γ τ) + F.metric τ (γ' τ) (γ' τ))

theorem Llength_eq_LlengthAlong (γ γ' : ℝ → E) (h : ∀ τ, deriv γ τ = γ' τ) ... 
```
