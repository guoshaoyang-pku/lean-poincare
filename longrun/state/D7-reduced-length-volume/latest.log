def IsLMinimizerAlong (p q : E) (τ : ℝ) (γ γ' : ℝ → E) : Prop :=
  γ 0 = p ∧ γ τ = q ∧ Continuous γ' ∧ (∀ x, HasDerivAt γ (γ' x) x) ∧
