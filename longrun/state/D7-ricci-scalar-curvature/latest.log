        apply LinearMap.ext; intro Y
        apply Prod.ext <;> simp [map_add]
      map_smul' := fun a X => by
        apply LinearMap.ext; intro Y
        apply Prod.ext <;> simp [map_smul] }
  skew := fun X Y => by
    apply Prod.ext <;> simp [b₁.skew, b₂.skew]
  jacobi := fun X Y Z => by
    apply Prod.ext <;> simp [b₁.jacobi, b₂.jacobi]
