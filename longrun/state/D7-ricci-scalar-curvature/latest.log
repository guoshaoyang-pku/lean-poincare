```lean
namespace Poincare.D7.RicciScalar

/-- A path of metric-compatible torsion-free connection data with a time-independent
orthonormal frame. -/
structure FlowPath (V : Type v) [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
    (ι : Type w) [Fintype ι] [DecidableEq ι] where
  data : ℝ → RiemannCurvatureData V ι
  frame : Module.Basis ι ℝ V
  frame_basis : ∀ t, (data t).metric.basis = frame

namespace FlowPath
variable (F : FlowPath V ι)

def scal (t : ℝ) : ℝ := (F.data t).scalarCurvature
def ricci (t : ℝ) (X Y : V) : ℝ := (F.data t).ricciForm X Y
def metricForm (t : ℝ) (X Y : V) : ℝ := (F.data t).metric.form X Y
def nabla (t : ℝ) (X Y : V) : V := (F.data t).conn.nabla X Y
def bracket (t : ℝ) (X Y : V) : V := (F.data t).conn.lie.bracket X Y
```

