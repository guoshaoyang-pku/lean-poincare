def IsSurgeryAdmissible (C : CanonicalNeighborhoodCertificate ε κ r X) : Prop :=
  C.kind = CanonicalKind.neck ∨ C.kind = CanonicalKind.cap

theorem isSurgeryAdmissible_or_compactSpherical (C : ...) :
    IsSurgeryAdmissible C ∨ C.kind = CanonicalKind.compactSpherical
```
