/-! ## 3. The connected-sum decomposition and its missing bridges -/

/-- The connected-sum decomposition of `X` into the terminal pieces of the extinction
configuration. -/
structure ConnectedSumDecomposition (X : TopSpace.{0}) (pieces : List (TopSpace.{0})) :
    Type 1 where
  relation : Prop
  relation_holds : relation
  simplyConnected_pieces : @SimplyConnectedSpace X.Carrier X.topology →
    ∀ P ∈ pieces, @SimplyConnectedSpace P.Carrier P.topology
  sphere_of_spheres : (∀ P ∈ pieces, Nonempty (P.Carrier ≃ₜ SphereThree)) →
    Nonempty (X.Carrier ≃ₜ SphereThree)
```

