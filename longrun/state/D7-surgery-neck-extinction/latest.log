Section 3: extinction.

```lean
/-- **Extinction data for a finite-complexity surgery process.** -/
structure ExtinctionData where
  /-- The complexity after `n` surgery steps (number of components in the toy model). -/
  complexity : ℕ → ℕ
  /-- Opaque: a surgery occurs at stage `n`. -/
  surgeryAt : ℕ → Prop
  /-- Once a surgery fails to occur, none occurs later (the process has stopped). -/
  surgeryAt_mono : ∀ {m n : ℕ}, m ≤ n → surgeryAt n → surgeryAt m
  /-- Every surgery strictly decreases the complexity. -/
  complexity_decreases : ∀ n : ℕ, surgeryAt n → complexity (n + 1) < complexity n
  /-- Opaque: extinction (the flow has become empty). -/
