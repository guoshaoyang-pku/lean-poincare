theorem finite_steps_of_strict_decrease (step : ℕ → Prop) (complexity : ℕ → ℕ)
    (hdec : ∀ n, step n → complexity (n+1) < complexity n) :
    ∃ N, ∀ n, N ≤ n → ¬ step n := by
  by_contra h
