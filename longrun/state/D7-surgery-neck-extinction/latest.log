```lean
theorem gap_le_sub (S : SurgerySchedule T) {m n : ℕ} (hmn : m < n) :
    S.gap ≤ T n - T m := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_lt hmn
  have h := S.gap_mul_le_add m (d + 1)
  have hd : (1 : ℝ) ≤ ((d + 1 : ℕ) : ℝ) := by
    exact_mod_cast Nat.succ_le_succ (Nat.zero_le d)
  nlinarith [S.gap_pos, h, mul_le_mul_of_nonneg_right hd (le_of_lt S.gap_pos)]
```

