import Poincare.D7.SurgeryFlow.Basic
import Mathlib.Topology.DerivedSet

set_option autoImplicit false

namespace Poincare.D7.SurgeryFlow

open Filter Topology
open scoped Topology

/-! ## 1. Surgery schedules -/

structure SurgerySchedule (T : ℕ → ℝ) where
  gap : ℝ
  gap_pos : 0 < gap
  gap_le_next : ∀ n : ℕ, gap ≤ T (n + 1) - T n

namespace SurgerySchedule

variable {T : ℕ → ℝ}

theorem strictMono (S : SurgerySchedule T) : StrictMono T :=
  strictMono_nat_of_lt_succ fun n => by
    have h := S.gap_le_next n
    linarith [S.gap_pos]

theorem gap_mul_le_add (S : SurgerySchedule T) (m d : ℕ) :
    (d : ℝ) * S.gap ≤ T (m + d) - T m := by
  induction d with
  | zero => simp
  | succ d ih =>
      have h1 : S.gap ≤ T (m + d + 1) - T (m + d) := by
        have := S.gap_le_next (m + d)
        simpa [Nat.add_assoc] using this
      have h2 : (d : ℝ) * S.gap + S.gap ≤ T (m + (d + 1)) - T m := by
        have hsum : (T (m + d) - T m) + (T (m + d + 1) - T (m + d)) =
            T (m + d + 1) - T m := by ring
        calc (d : ℝ) * S.gap + S.gap
            ≤ (T (m + d) - T m) + (T (m + d + 1) - T (m + d)) := add_le_add ih h1
          _ = T (m + d + 1) - T m := hsum
          _ = T (m + (d + 1)) - T m := by rfl  -- maybe
      calc ((d + 1 : ℕ) : ℝ) * S.gap = (d : ℝ) * S.gap + S.gap := by push_cast; ring
        _ ≤ T (m + (d + 1)) - T m := h2
```

