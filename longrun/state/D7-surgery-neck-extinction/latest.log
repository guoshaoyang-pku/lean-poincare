```lean
theorem gap_le_abs_sub (S : SurgerySchedule T) {m n : ℕ} (hmn : m ≠ n) :
    S.gap ≤ |T n - T m| := by
  rcases lt_or_gt_of_ne hmn with h | h
  · have hg := S.gap_le_sub h
    rwa [abs_of_pos (by linarith)] 
  · have hg := S.gap_le_sub h  -- h : n < m, gives gap ≤ T m - T n
    rw [abs_sub_comm]
    exact hg
```
