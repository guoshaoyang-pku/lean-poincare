Evolution.lean design (final):

```lean
namespace Poincare.D7.TensorLaplacian

open Poincare.D7.Curvature

variable {V : Type v} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
variable {ι : Type w} [Fintype ι] [DecidableEq ι]

/-- The Frobenius norm squared `|Ric|²` of the Ricci form in the orthonormal frame. -/
noncomputable def ricciNormSq (D : RiemannCurvatureData V ι) : ℝ :=
  ∑ i : ι, ∑ j : ι, D.ricciForm (D.metric.basis i) (D.metric.basis j)
    * D.ricciForm (D.metric.basis i) (D.metric.basis j)

theorem ricciNormSq_nonneg (D) : 0 ≤ ricciNormSq D := ...

/-- The trace of the metric velocity `h` in the orthonormal frame. -/
noncomputable def traceH (D : RiemannCurvatureData V ι) (h : V → V → ℝ) : ℝ :=
  ∑ i : ι, h (D.metric.basis i) (D.metric.basis i)

/-- The pairing `⟨h, Ric⟩` in the orthonormal frame. -/
noncomputable def pairingH (D) (h : V → V → ℝ) : ℝ :=
  ∑ i : ι, ∑ j : ι, h (D.metric.basis i) (D.metric.basis j) * D.ricciForm (D.metric.basis i) (D.metric.basis j)

/-- The Ricci flow velocity `∂ₜ g = -2 Ric`. -/
noncomputable def ricciFlowVelocity (D) : V → V → ℝ := fun X Y => -2 * D.ricciForm X Y

theorem traceH_ricciFlowVelocity (D) : traceH D (ricciFlowVelocity D) = -2 * D.scalarCurvature := ...
theorem pairingH_ricciFlowVelocity (D) : pairingH D (ricciFlowVelocity D) = -2 * ricciNormSq D := ...
```

