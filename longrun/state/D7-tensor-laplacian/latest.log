```lean
namespace Poincare.D7.TensorLaplacian
open Poincare.D7.RicciScalar (FlowPath)

variable {V} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
variable {ι} [Fintype ι] [DecidableEq ι]

/-- Trace of the metric variation `h` in the orthonormal frame. -/
noncomputable def traceH (F : FlowPath V ι) (h : ℝ → V → V → ℝ) (t : ℝ) : ℝ :=
  ∑ i : ι, h t (F.frame i) (F.frame i)

/-- Pairing `⟨h, Ric⟩` in the orthonormal frame. -/
noncomputable def pairingH (F : FlowPath V ι) (h : ℝ → V → V → ℝ) (t : ℝ) : ℝ :=
  ∑ i : ι, ∑ j : ι, h t (F.frame i) (F.frame j) * F.ricci t (F.frame i) (F.frame j)

/-- `|Ric|²` in the orthonormal frame. -/
noncomputable def ricNormSq (F : FlowPath V ι) (t : ℝ) : ℝ :=
  ∑ i : ι, ∑ j : ι, F.ricci t (F.frame i) (F.frame j) * F.ricci t (F.frame i) (F.frame j)
```

