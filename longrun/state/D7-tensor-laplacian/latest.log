Then the main theorem by summing:
```lean
theorem roughLaplacian_commutator_general (X : V) (s : T) :
    TD.roughLaplacian (TD.nabla X s) - TD.nabla X (TD.roughLaplacian s) =
      ∑ i : ι, (TD.curvature (e i) X (TD.nabla (e i) s)
        + TD.nabla (D.conn.lie.bracket (e i) X) (TD.nabla (e i) s)
        + TD.nabla (e i) (TD.nabla (D.conn.lie.bracket (e i) X) s)
        + TD.nabla (e i) (TD.curvature (e i) X s)) := by
  have hterm : ∀ i : ι, ... = ... := TD.roughLaplacian_commutator_term i X s
  -- roughLaplacian expansion:
  simp only [roughLaplacian_apply]  -- LHS becomes ∑ i ∇i∇i(∇X s) - ∇X (∑ i ∇i∇i s)
  rw [map_sum]  -- ∇X (∑ ...) = ∑ i ∇X(...)
  rw [← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun i _ => hterm i
```
