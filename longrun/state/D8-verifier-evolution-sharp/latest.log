theorem audit_perelmanF_step_lt_of_active_support (F : ReactionField ι) {c : ι → ℝ}
    {h : ℝ} (hh : 0 < h) {traj : ℕ → ι → ℝ} (ev : DiscreteEvolution F h traj) {n : ℕ}
