theorem not_strictAnti_of_lt_one (c : ℝ) (hc : c < 1) : ¬ StrictAnti (gibbsTerm c) := by
  intro hanti
  have hs : 0 < 1 - c := sub_pos.mpr hc
  rcases le_or_lt (1 - c) 2 with h2 | h2
  · -- s := 1 - c ∈ (0, 2]
    set s := 1 - c with hsdef
    have hs0 : 0 < s := hs
    have hs2 : s ≤ 2 := h2
    -- need f(1 + s/2) > f(1)
    have hexp : 1 - s / 2 < Real.exp (-(s / 2)) := by
      -- use Real.one_sub_lt_exp_neg or add_one_lt_exp
      ...
    have hmain : 2 - s < (2 + s^2/4) * Real.exp (-(s/2)) := by
      have hpos : 0 < 2 + s^2/4 := by positivity
      have h := mul_lt_mul_of_pos_left hexp hpos
      -- h : (2+s²/4)(1-s/2) < (2+s²/4) exp(-s/2)
      have hpoly : 2 - s < (2 + s^2/4) * (1 - s/2) := by nlinarith [hs0, hs2]
      linarith
    have hval1 : gibbsTerm c (1 + s/2) = (2 + s^2/4) * Real.exp (-1) * Real.exp (-(s/2)) := by
      -- c = 1 - s; ring_nf? involves exp(-(1+s/2)) = exp(-1) * exp(-s/2)
      ...
    have hval0 : gibbsTerm c 1 = (2 - s) * Real.exp (-1) := by ...
    have hlt : gibbsTerm c 1 < gibbsTerm c (1 + s/2) := by
      rw [hval1, hval0]
      have hexp1 : 0 < Real.exp (-1) := Real.exp_pos _
      nlinarith [hmain, hexp1]
    have hx : (1:ℝ) < 1 + s/2 := by linarith
    have := hanti hx
    linarith
  · -- s > 2 i.e. c < -1
    set y := 3 - c  -- y = s + 2
    have hy1 : (1:ℝ) < y := by ...
    have hf1 : gibbsTerm c 1 < 0 := by
      -- (c+1)e^{-1} < 0 since c+1 < 0
      ...
    have hfy : 0 < gibbsTerm c y := by
      -- c + y² = c + (3-c)² = c + 9 - 6c + c² = c² -5c + 9 > 0
      ...
    have : gibbsTerm c y < gibbsTerm c 1 := hanti hy1
    linarith
```

