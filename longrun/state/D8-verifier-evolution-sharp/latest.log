def PerelmanFStepLt_c_nonneg : Prop :=
  ∀ {ι : Type} [Fintype ι] (F : ReactionField ι) {c : ι → ℝ}, (∀ i, 0 ≤ c i) →
    ∀ {h : ℝ}, 0 < h → ∀ {traj : ℕ → ι → ℝ}, DiscreteEvolution F h traj →
    ∀ {n : ℕ} {i : ι}, 0 < F.eval (traj n) i →
    perelmanF c (traj (n + 1)) < perelmanF c (traj n)

theorem perelmanF_step_lt_c_nonneg_false : ¬ PerelmanFStepLt_c_nonneg := by
  intro H
  have hstrict := H (constOneField : ReactionField (Fin 2)) (c := twoC) twoC_nonneg
    (h := 1) (by norm_num) twoTraj_evolution (n := 0) (i := 0)
    (by simp [constOneField_eval])
