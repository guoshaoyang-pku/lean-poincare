Script:
```python
import json, os, subprocess, time
wt = "/data3/guoshaoyang/workdir/lean_poincare/longrun/worktrees/D9-ancient-kappa-solutions"
ENV = dict(os.environ)
ENV["ELAN_HOME"] = "/data3/guoshaoyang/workdir/lean_poincare/elan"
ENV["PATH"] = ENV["ELAN_HOME"] + "/bin:" + ENV.get("PATH", "")
files = []
for dirpath, dirnames, filenames in os.walk(wt):
    dirnames[:] = [d for d in dirnames if d not in (".lake", ".git", ".dshpkg")]
    for fn in filenames:
        if fn.endswith(".lean"):
            files.append(os.path.join(dirpath, fn))
files.sort()
detail=[]
for f in files:
    t=time.time()
    try:
        r = subprocess.run(["lake","env","lean",f], cwd=wt, env=ENV, capture_output=True, text=True, timeout=1800)
        code=r.returncode; err=r.stderr
    except subprocess.TimeoutExpired:
        code="timeout"; err=""
    detail.append((f,code,time.time()-t,err))
    print(f, code, f"{time.time()-t:.1f}s", flush=True)
    if code!=0:
        print("STDERR:", err[:4000], flush=True)
json.dump([{"file":f,"exit":c} for f,c,_,_ in detail], open("/tmp/d9_gate_recheck.json","w"), indent=2)
print("OK" if all(c==0 for _,c,_,_ in detail) else "FAILED", len(files))
```

