import Mathlib.Tactic
import Mathlib.Data.Matrix.Notation
open Matrix

namespace Poincare.Longrun.DeTurck.NumericCheck

/-- The covector `ξ = (1,0)` on `Fin 2`, with the standard (identity) metric. -/
def xi : Fin 2 → ℝ := ![1, 0]

/-- A symmetric bilinear form as a `2×2` real matrix. -/
def H (a b c : ℝ) : Matrix (Fin 2) (Fin 2) ℝ := !![a, b; b, c]

/-- `|ξ|² = ξ_0² + ξ_1²` for `ξ = (1,0)`. -/
def normSq : ℝ := (xi 0)^2 + (xi 1)^2

/-- `tr h = h_{00} + h_{11}`. -/
def tr (h : Matrix (Fin 2) (Fin 2) ℝ) : ℝ := h 0 0 + h 1 1

/-- DeTurck symbol `Ŵ_k = ξ^p h_{pk} - (1/2) ξ_k tr h`; for `ξ=(1,0)` this is
`Ŵ_0 = h_{00} - (1/2) tr h`, `Ŵ_1 = h_{10}`. -/
def What (h : Matrix (Fin 2) (Fin 2) ℝ) (k : Fin 2) : ℝ :=
  (∑ p, xi p * h p k) - (1/2) * xi k * tr h

/-- Ricci symbol at `ξ = (1,0)`. -/
def ricciSymbol (h : Matrix (Fin 2) (Fin 2) ℝ) (i j : Fin 2) : ℝ :=
  (1/2) * (normSq * h i j - xi i * (∑ p, xi p * h p j) - xi j * (∑ p, xi p * h p i)
    + xi i * xi j * tr h)

/-- Lie symbol `-(ξ_i Ŵ_j + ξ_j Ŵ_i)`. -/
def lieSymbol (h : Matrix (Fin 2) (Fin 2) ℝ) (i j : Fin 2) : ℝ :=
  -(xi i * What h j + xi j * What h i)
```

