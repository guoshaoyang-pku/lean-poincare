```python
def compile_gate(task_id):
    gate = os.path.join(STATE, task_id, "gate.json")
    if os.path.exists(gate):
        return json.load(open(gate))
    wt = os.path.join(WORK, task_id)
    files = []
    for dirpath, dirnames, filenames in os.walk(wt):
        dirnames[:] = [d for d in dirnames if d not in (".lake", ".git", ".dshpkg")]
        for fn in filenames:
            if fn.endswith(".lean"):
                files.append(os.path.join(dirpath, fn))
    files.sort()
    ok = True
    detail = []
    for f in files:
        try:
            r = subprocess.run(["lake", "env", "lean", f], cwd=wt, env=ENV, ...)
```

