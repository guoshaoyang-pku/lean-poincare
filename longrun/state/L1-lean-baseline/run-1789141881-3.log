        let axs ← collectAxioms cname
        let extra := axs.filter (fun a => !allowedAxioms.contains a)
        let kind := kindOf ci
        ...
        rows := rows.push ...
  for r in rows do logInfo ("L1AX\t" ++ r)
  logInfo s!"L1AX-SUMMARY\t{...}"
```

