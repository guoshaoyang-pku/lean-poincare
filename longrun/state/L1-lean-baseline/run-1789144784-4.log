Let me create the v2 runner. Design:
```bash
#!/bin/bash
set -u
ROOT=...
LOGDIR=$ROOT/baseline/logs/probes
mkdir -p "$LOGDIR"
cd "$ROOT/release"
run_one() {
  local p="$1"; local base; base="$(basename "$p" .lean)"
  [ -f "$LOGDIR/$base.exit" ] && return 0
  timeout 600 lake env lean "../baseline/audit/probes/$base.lean" > "$LOGDIR/$base.log" 2>&1
  echo $? > "$LOGDIR/$base.exit.tmp" && mv "$LOGDIR/$base.exit.tmp" "$LOGDIR/$base.exit"
}
export -f run_one; export LOGDIR
ls "$ROOT"/baseline/audit/probes/[0-9]*.lean | xargs -P 8 -I{} bash -c 'run_one "$@"' _ {}
echo RUNNER_DONE
```
Note: the runner writes exits as `$base.exit`, and the summary parser reads them. Also `timeout 600` for safety.

