Comment stripper for Lean:
```python
def strip_comments(text):
    out = []
    i = 0
    n = len(text)
    depth = 0
    in_str = False
    in_line = False
    while i < n:
        c = text[i]
        nxt = text[i+1] if i+1 < n else ''
        if in_line:
            if c == '\n':
                in_line = False
                out.append('\n')
            else:
                out.append(' ')
            i += 1
            continue
        if depth > 0:
            if c == '/' and nxt == '-':
                depth += 1; out.append('  '); i += 2; continue
            if c == '-' and nxt == '/':
                depth -= 1; out.append('  '); i += 2; continue
            out.append('\n' if c == '\n' else ' ')
            i += 1
            continue
        if in_str:
            if c == '\\':
                out.append('  '); i += 2; continue
            if c == '"':
                in_str = False
            out.append('\n' if c == '\n' else ('"' if c=='"' else ' '))
            i += 1
            continue
        # normal
        if c == '-' and nxt == '-':
            in_line = True; out.append('  '); i += 2; continue
        if c == '/' and nxt == '-':
            depth = 1; out.append('  '); i += 2; continue
        if c == '"':
            in_str = True; out.append('"'); i += 1; continue
        out.append(c); i += 1
    return ''.join(out)
```
