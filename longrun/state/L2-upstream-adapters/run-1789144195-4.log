theorem euclidean_curvatureOperatorAt_eq_zero (p : Plane)
    (u v w : TangentSpace 𝓘(ℝ, Plane) p) :
    (euclideanConnection (F := Plane)).curvatureOperatorAt p u v w = 0 := by
