```python
KINDS = {"theorem","lemma","def","abbrev","instance","structure","inductive","alias","class"}
MODIFIERS = {"private","protected","noncomputable","partial","unsafe","scoped","local","@[..." ]}

def discover(root):
    decls = []  # (name, kind, relpath, line)
    for path in sorted(authored lean files):
        if path.name == "Audit.lean": continue
        code = strip_comments(read)
        stack = []  # ('ns', name) | ('sec', name)
        for lineno, line in enumerate(code.splitlines(), 1):
            # strip attributes and modifiers
            s = line.strip()
            s = re.sub(r'^@\[[^\]]*\]\s*', '', s)  # single-line attributes
            # modifiers
            while True:
                m = re.match(r'^(private|protected|noncomputable|partial|unsafe|local|scoped)\s+', s)
                if m: s = s[m.end():]
                else: break
            m = re.match(r'^(namespace|section|end)\b\s*([A-Za-z_][A-Za-z0-9_.]*)?\s*$', line.strip())
            ...
```
