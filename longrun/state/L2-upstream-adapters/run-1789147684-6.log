Script contents:
```bash
#!/bin/bash
# Round-5 consolidated verification chain for L2-upstream-adapters.
set -u
WT=...
LOG="$WT/evidence/logs/round5-final-verify.log"
run() { echo "=== $* ==="; "$@"; echo "EXIT=$?"; }
{
  echo "### round 5 verification chain $(date -u +%FT%TZ)"
  echo "--- adapter fail-closed axiom audit + coverage ---"
  bash "$WT/evidence/run-axiom-audit.sh"
  echo "AXIOM_SCRIPT_EXIT=$?"
  echo "--- authored-file check (adapter contract) ---"
  python3 "$WT/evidence/check-authored-files.py" "$WT"; echo "AUTHORED_EXIT=$?"
  echo "--- novelty check ---"
  python3 "$WT/evidence/check-novelty.py" "$WT"; echo "NOVELTY_EXIT=$?"
  echo "--- source-hash check ---"
  python3 "$WT/evidence/source-hashes.py" "$WT" "$WT/evidence/source-hashes.json"; echo "SOURCE_EXIT=$?"
  echo "--- snapshot verify ---"
  python3 "$WT/evidence/verify_frenzymath_snapshot.py"; echo ...
  echo "--- sorry ledger / check / quarantine ---"
  python3 "$WT/evidence/sorry-ledger.py" "$WT/third_party/frenzymath/Poincare-Conjecture" "$WT/evidence/sorry-ledger.json" "$WT/evidence/sorry-ledger.md"; echo ...
  python3 "$WT/evidence/sorry-ledger.py" --check "$WT/third_party/..." "$WT/evidence/sorry-ledger.json"
  python3 "$WT/evidence/sorry-ledger.py" --quarantine "$WT/adapters" "$WT/evidence/sorry-ledger.json"
  echo "--- release mirror hash check ---"
  python3 "$WT/evidence/verify-release-mirror.py" "$WT/release" <L1 manifest> "$WT/evidence/release-mirror-hashes.json"
  echo "--- release forbidden-token classification ---"
  python3 "$WT/evidence/classify-release-forbidden-hits.py" "$WT/release" "$WT/evidence/release-forbidden-classification.json"
  echo "--- release build result (recorded) ---"
  grep -E "Build completed successfully|RELEASE_BUILD_EXIT" "$WT/evidence/logs/round5-release-build.log"
} 2>&1 | tee "$LOG"
```
