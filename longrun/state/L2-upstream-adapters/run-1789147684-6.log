```python
def check_quarantine(adapter_root: Path, ledger) -> int:
    pkgs = sorted({e["package"].split("/")[-1] for e in ledger["entries"]})
    bad = []
    for p in sorted(adapter_root.rglob("*.lean")):
        if ".lake" in p.parts: continue
        code = inv.strip_comments(p.read_text(errors="replace"))
        for pkg in pkgs:
            for m in re.finditer(rf"\b{pkg}\w*", code):
                line = code[:m.start()].count("\n")+1
                bad.append(f"{p.relative_to(adapter_root)}:{line}: reference to statement-only package `{pkg}`")
    ...
```

