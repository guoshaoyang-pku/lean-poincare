```lean
section Chart
variable {E} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable {H} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
variable {M} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ∞ M]
variable [RiemannianBundle (fun x : M => TangentSpace I x)]

/-- The chart-local metric coefficients of a Riemannian manifold: pull the pinned fiber metric
back along the chart frame `D_x = mfderiv 𝓘(ℝ,E) I e.symm x`. -/
noncomputable def chartMetricForm (e : LocalHomeomorph M E) (x : E) : E →L[ℝ] E →L[ℝ] ℝ :=
  (InnerProductSpace.toDual ℝ (TangentSpace I (e.symm x))).comp
    (mfderiv 𝓘(ℝ,E) I e.symm x)

theorem chartMetricForm_apply (e) (x u v) :
    chartMetricForm e x u v = ⟪mfderiv 𝓘(ℝ,E) I e.symm x u, mfderiv 𝓘(ℝ,E) I e.symm x v⟫ := rfl

theorem chartMetricForm_symm (e) (x u v) : chartMetricForm e x u v = chartMetricForm e x v u := by
  rw [chartMetricForm_apply, chartMetricForm_apply, real_inner_comm]

theorem chartMetricForm_nonneg (e) (x u) : 0 ≤ chartMetricForm e x u u := by
  rw [chartMetricForm_apply]; exact real_inner_self_nonneg
```
