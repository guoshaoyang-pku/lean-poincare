```lean
/-! ## The geodesic spray -/

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- The second-order geodesic spray as a first-order vector field on `E × E`. -/
noncomputable def spray (G : CoordinateMetric E) : E × E → E × E :=
  fun z => (z.2, - christoffel G z.1 z.2 z.2)

theorem contDiff_spray (G : CoordinateMetric E) : ContDiff ℝ 1 (spray G) := by
  have h := contDiff_christoffel G
  show ContDiff ℝ 1 (fun z : E × E => (z.2, - christoffel G z.1 z.2 z.2))
  fun_prop   -- may need help

/-- A curve is a coordinate geodesic when it solves the second-order geodesic equation. -/
def IsCoordinateGeodesic (G : CoordinateMetric E) (x : ℝ → E) : Prop :=
  (∀ t, HasDerivAt x (deriv x t) t) ∧
    ∀ t, HasDerivAt (deriv x) (-(christoffel G (x t) (deriv x t) (deriv x t))) t

/-- A curve in `E × E` is a solution of the first-order geodesic spray system. -/
def IsSprayCurve (G : CoordinateMetric E) (z : ℝ → E × E) : Prop :=
  ∀ t, HasDerivAt z (spray G (z t)) t

theorem isCoordinateGeodesic_of_sprayCurve (G) {z} (hz : IsSprayCurve G z) :
    IsCoordinateGeodesic G (fun t => (z t).1) := by
  constructor
  · intro t
    have h1 : HasDerivAt (fun s => (z s).1) ((z t).2) t := (hz t).fst
    rw [h1.deriv]  -- deriv (fun s => (z s).1) t = (z t).2
    exact h1
  · intro t
    have h1 : HasDerivAt (fun s => (z s).2) (-christoffel G (z t).1 (z t).2 (z t).2) t := (hz t).snd
    have hderiv : deriv (fun s => (z s).1) = fun s => (z s).2 := by
      funext s; exact (hz s).fst.deriv
    rw [hderiv]
    exact h1
```
