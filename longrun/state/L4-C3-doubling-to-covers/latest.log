/-- **The ratio hypothesis of `uniformCovers_of_ratio_data` fails on the counterexample
family.**  For every `D ≥ 1`, no constants `C₁ C₃` and no uniformly locally doubling measures
on the members can satisfy the ball-ratio data of `uniformCovers_of_ratio_data` at `ε = 1/4`:
the data would give `n + 1 ≤ C₁` on the `(n+1)`-point member. -/
theorem not_uniformRatioData_discreteFamily (D : ℝ) (hD : 1 ≤ D) :
    ¬ ∃ C₁ C₃ : ℝ≥0, 1 ≤ C₁ ∧ 1 ≤ C₃ ∧
      ∀ p ∈ discreteFamily, ∃ μ : Measure (GromovHausdorff.GHSpace.Rep p),
        IsUnifLocDoublingMeasure μ ∧
        (∀ y, μ (closedBall y (2 * D)) ≤ (C₁ : ℝ≥0∞) * μ (closedBall y (1 / 8))) ∧
        (∀ y, μ (closedBall y (1 / 8)) ≤ (C₃ : ℝ≥0∞) * μ (closedBall y (1 / 24))) ∧
        (∀ x, μ (closedBall x (1 / 8)) ≠ 0) ∧
        (∀ x, μ (closedBall x (1 / 8)) ≠ ⊤) := by
  rintro ⟨C₁, C₃, hC₁, hC₃, h⟩
  let n : ℕ := ⌈(C₁ : ℝ)⌉₊ + 1
  let p : GromovHausdorff.GHSpace := GromovHausdorff.toGHSpace (Disc (n + 1))
  have hp : p ∈ discreteFamily := ⟨n, rfl⟩
  obtain ⟨μ, -, hratio, -, hpos, htop⟩ := h p hp
  obtain ⟨e⟩ := Poincare.D12.GeometricCompactness.toGHSpace_rep_isometryEquiv (Disc (n + 1))
  let ν : Measure (Disc (n + 1)) := Measure.map e μ
  have hmap : ∀ (y : Disc (n + 1)) (r : ℝ),
      ν (closedBall y r) = μ (closedBall (e.symm y) r) := by
    intro y r
    simpa [ν] using map_isometryEquiv_closedBall (e := e.symm) (μ := μ) y r
  have hratio' : ∀ y : Disc (n + 1),
      ν univ ≤ (C₁ : ℝ≥0∞) * ν ({y} : Set (Disc (n + 1))) := by
    intro y
    have h1 : ν univ ≤ ν (closedBall y (2 * D)) := by
      apply measure_mono
      intro z _
      rw [mem_closedBall]
      exact le_trans (Disc.dist_le_one z y) (by linarith)
    have h2 : ν (closedBall y (2 * D)) ≤ (C₁ : ℝ≥0∞) * ν (closedBall y (1 / 8)) := by
      rw [hmap y (2 * D), hmap y (1 / 8)]
      exact hratio (e.symm y)
    rw [Disc.closedBall_eq_singleton (x := y) (by norm_num) (by norm_num)] at h2
    exact h1.trans h2
  have hν0 : ν univ ≠ 0 := by
    have hdecomp := Disc.measure_univ_eq_sum_singleton (n + 1) ν
    set y₀ : Disc (n + 1) := ⟨0, Nat.succ_pos n⟩
    have hy₀ : ν ({y₀} : Set (Disc (n + 1))) ≠ 0 := by
      have := hpos (e.symm y₀)
      rwa [← hmap y₀ (1 / 8),
        Disc.closedBall_eq_singleton (x := y₀) (by norm_num) (by norm_num)] at this
    intro hzero
    have hle : ν ({y₀} : Set (Disc (n + 1))) ≤ ν univ := by
      rw [hdecomp]
      exact Finset.single_le_sum (fun _ _ => zero_le _) (Finset.mem_univ y₀)
    rw [hzero] at hle
    exact hy₀ (le_antisymm hle (zero_le _))
  have hνtop : ν univ ≠ ⊤ := by
    rw [Disc.measure_univ_eq_sum_singleton (n + 1) ν]
    refine WithTop.sum_ne_top.2 fun y _ => ?_
    have := htop (e.symm y)
    rwa [← hmap y (1 / 8),
      Disc.closedBall_eq_singleton (x := y) (by norm_num) (by norm_num)] at this
  have hbound := Disc.card_le_of_uniform_ratio (n + 1) ν (C₁ : ℝ≥0∞) hratio' hν0 hνtop
  have hlt : (C₁ : ℝ) < (n + 1 : ℕ) := by
    have h1 : (C₁ : ℝ) ≤ (⌈(C₁ : ℝ)⌉₊ : ℝ) := Nat.le_ceil _
    have h2 : (⌈(C₁ : ℝ)⌉₊ : ℝ) + 1 < ((⌈(C₁ : ℝ)⌉₊ + 1) + 1 : ℕ) := by
      push_cast; linarith
    simpa [n] using lt_of_le_of_lt h1 h2
  have hle : ((n + 1 : ℕ) : ℝ) ≤ (C₁ : ℝ) := by exact_mod_cast hbound
  linarith
