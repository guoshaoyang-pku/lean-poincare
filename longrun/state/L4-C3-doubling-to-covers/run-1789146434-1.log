```lean
/-
L4-C3 doubling-to-covers — per-declaration kernel axiom audit.
-/
import Poincare.L4.DoublingToCovers.Bridge
import Poincare.L4.DoublingToCovers.Counterexample
import Poincare.L4.DoublingToCovers.Consumption
import Poincare.L4.DoublingToCovers.EuclideanWitness
import Lean.Util.CollectAxioms
import Lean.Elab.Command

open Lean Elab Command

namespace L4C3AxiomAudit

def approvedAxioms : List Name := ["propext".toName, "Classical.choice".toName, "Quot.sound".toName]
def targets : List Name := [ ... all my declarations ... ]

run_cmd do
  let env ← getEnv
  let mut failures : Array String := #[]
  for n in targets do
    unless env.contains n do
      failures := failures.push s!"missing declaration: {n}"
      continue
    let axs ← liftCoreM <| Lean.collectAxioms n
    let bad := axs.filter (fun a => !(approvedAxioms.contains a))
    if !bad.isEmpty then
      failures := failures.push s!"{n}: unapproved axioms {bad.toList}"
    logInfo m!"{n}: axioms {axs.toList}"
  if failures.isEmpty then
    logInfo "L4C3 AXIOM AUDIT: PASS"
  else
    for f in failures do logError m!"{f}"
