theorem card_le_of_pairwise_dist_ge (μ : Measure α) [IsUnifLocDoublingMeasure μ]
    {K : ℝ} (hK : 0 < K) :
    ∃ R : ℝ, 0 < R ∧ ∀ (x : α) {r : ℝ}, 0 < r → r ≤ R →
      μ (closedBall x r) ≠ 0 → μ (closedBall x r) ≠ ⊤ →
      ∀ s : Finset α, (∀ y ∈ s, y ∈ closedBall x (K * r)) →
        (∀ y ∈ s, ∀ z ∈ s, y ≠ z → r ≤ dist y z) →
        (s.card : ℝ≥0∞) ≤ (IsUnifLocDoublingMeasure.scalingConstantOf μ (K + 1)) *
          (IsUnifLocDoublingMeasure.scalingConstantOf μ (K + 1)) *
          (IsUnifLocDoublingMeasure.scalingConstantOf μ 3) := by
  refine ⟨min (IsUnifLocDoublingMeasure.scalingScaleOf μ (K + 1))
      (3 * IsUnifLocDoublingMeasure.scalingScaleOf μ 3), ?_, ?_⟩
  · exact lt_min (IsUnifLocDoublingMeasure.scalingScaleOf_pos μ _) (by positivity)
  intro x r hr hrR hμ0 hμtop s hs hsep
  set C₁ := IsUnifLocDoublingMeasure.scalingConstantOf μ (K + 1) with hC₁
  set C₃ := IsUnifLocDoublingMeasure.scalingConstantOf μ 3 with hC₃
  have hr1 : r ≤ IsUnifLocDoublingMeasure.scalingScaleOf μ (K + 1) :=
    le_trans hrR (min_le_left _ _)
  have hr3 : r / 3 ≤ IsUnifLocDoublingMeasure.scalingScaleOf μ 3 := by
    have := le_trans hrR (min_le_right _ _)
    linarith
  -- each separated point carries a large ball
  have hkey : ∀ y ∈ s, μ (closedBall x r) ≤ (C₁ * C₃) * μ (closedBall y (r / 3)) := by
    intro y hy
    have hyK : dist y x ≤ K * r := by
      have := hs y hy; rwa [mem_closedBall] at this
    have hsub : closedBall x r ⊆ closedBall y ((K + 1) * r) := by
      intro z hz
      rw [mem_closedBall] at hz ⊢
      calc dist z y ≤ dist z x + dist x y := dist_triangle ..
        _ ≤ r + K * r := add_le_add hz hyK
        _ = (K + 1) * r := by ring
    calc μ (closedBall x r) ≤ μ (closedBall y ((K + 1) * r)) := measure_mono hsub
      _ ≤ C₁ * μ (closedBall y r) := by
          have := IsUnifLocDoublingMeasure.measure_mul_le_scalingConstantOf_mul μ
            (K := K + 1) (x := y) (t := K + 1) (r := r)
            (by constructor <;> linarith) hr1
          simpa [C₁] using this
      _ ≤ C₁ * (C₃ * μ (closedBall y (r / 3))) := by
          have h3 : μ (closedBall y r) ≤ C₃ * μ (closedBall y (r/3)) := by
            have := IsUnifLocDoublingMeasure.measure_mul_le_scalingConstantOf_mul μ
              (K := 3) (x := y) (t := 3) (r := r/3)
              (by constructor <;> norm_num) hr3
            convert this using 2 <;> ring
          exact mul_le_mul_left' h3 C₁
      _ = (C₁ * C₃) * μ (closedBall y (r / 3)) := by ring
  ...
```
