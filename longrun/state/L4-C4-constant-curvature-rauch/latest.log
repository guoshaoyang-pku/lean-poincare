/-- `sin x - x cos x ≥ 0` on `[0, π]`. -/
theorem sin_sub_mul_cos_nonneg {x : ℝ} (hx0 : 0 ≤ x) (hxπ : x ≤ Real.pi) :
    0 ≤ Real.sin x - x * Real.cos x
```

Proof: define g x = sin x - x cos x. g 0 = 0. g' x = cos x - (cos x - x sin x) = x sin x. On [0,π], sin ≥ 0 (Real.sin_nonneg_of_mem_Icc ⟨hx0, hxπ⟩), so g' ≥ 0, hence g monotone on [0,π]? We can use `monotoneOn_of_deriv_nonneg` on Icc 0 π with continuity and differentiability. Or use the integral/FTC bound. Simplest: `monotoneOn_of_deriv_nonneg (convex_Icc _ _) hcont hdiff hderiv`.

Actually let me write it cleanly:

```lean
theorem sin_sub_mul_cos_nonneg {x : ℝ} (hx : x ∈ Icc 0 Real.pi) :
    0 ≤ Real.sin x - x * Real.cos x := by
  have hcont : ContinuousOn (fun y => Real.sin y - y * Real.cos y) (Icc 0 Real.pi) := by fun_prop
  have hdiff : DifferentiableOn ℝ (fun y => Real.sin y - y * Real.cos y) (Ioo 0 Real.pi) := by
    intro y hy; fun_prop  -- or exact (Real.hasDerivAt_sin y).sub ... |>.differentiableAt.differentiableWithinAt
  have hmono : MonotoneOn (fun y => Real.sin y - y * Real.cos y) (Icc 0 Real.pi) := by
    refine monotoneOn_of_deriv_nonneg (convex_Icc 0 Real.pi) hcont hdiff ?_
    intro y hy
    rw [interior_Icc] at hy
    have hd : HasDerivAt (fun y => Real.sin y - y * Real.cos y) (y * Real.sin y) y := by
      have h1 : HasDerivAt (fun y => Real.sin y) (Real.cos y) y := Real.hasDerivAt_sin y
      have h2 : HasDerivAt (fun y => y * Real.cos y) (Real.cos y + y * (-Real.sin y)) y :=
        (hasDerivAt_id y).mul (Real.hasDerivAt_cos y)
      convert h1.sub h2 using 1
      ring
    rw [hd.deriv]
    exact mul_nonneg hy.1.le (Real.sin_nonneg_of_mem_Icc ⟨hy.1.le, hy.2.le⟩)
  have h0 : (0:ℝ) ∈ Icc 0 Real.pi := ⟨le_rfl, Real.pi_pos.le⟩
  have := hmono h0 hx hx.1
  simpa using this
```

