  rw [jacobiSol_of_pos h2]
  have hsin : |Real.sin (Real.sqrt 2 * t)| ≤ 1 := Real.abs_sin_le_one _
  have hsq : Real.sqrt 2 * Real.sqrt 2 = 2 := by
