  fun hT hBnn ht₀ ht₀T hBt₀ h hdducont hB hu0 hdu0 hpos hK hk hBmodel =>
    conjugate_point_bound hT hBnn ht₀ ht₀T hBt₀ h hdducont hB hu0 hdu0 hpos hK hk hBmodel
