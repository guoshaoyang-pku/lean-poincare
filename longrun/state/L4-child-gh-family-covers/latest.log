      rw [Disc.ball_half_eq_singleton, mem_singleton_iff] at hyz
      subst hyz
      exact hzs
    calc ((K + 1 : ℕ) : Cardinal) = #(univ : Set (Disc (K + 1))) := by
          rw [Cardinal.mk_univ]; simp [Disc]
      _ ≤ #s' := Cardinal.mk_le_mk_of_subset hsub
  have hle : #s' ≤ #s := hs'card
  have hfin : #s ≤ (K : Cardinal) := hscard
  have : ((K + 1 : ℕ) : Cardinal) ≤ (K : Cardinal) := hK'.trans (hle.trans hfin)
  exact Nat.not_succ_le_self K (by exact_mod_cast this)
