```lean
import Poincare.L4.Compactness.FamilyCovers

noncomputable section
open Set Metric Filter
open scoped Topology ENNReal NNReal Cardinal

namespace Poincare.L4.Compactness
open Poincare.D12.GeometricCompactness
open GromovHausdorff

/-! ## 1. The discrete model -/
def Disc (m : ℕ) : Type := Fin m
namespace Disc
  -- instances: TopologicalSpace ⊥, DiscreteTopology, DecidableEq, Fintype, Nonempty (n+1)
  -- MetricSpace ofDistTopology
  -- lemmas: dist_def, dist_eq_zero, dist_eq_one, dist_le_one, closedBall_eq_univ,
  --         ball_eq_singleton
end Disc

/-- The `m`-th discrete GHSpace point: `m + 1` points with the 0/1 metric. -/
def discGH (m : ℕ) : GHSpace := GromovHausdorff.toGHSpace (Disc (m + 1))

/-- The finite family `{discGH m | m ≤ N}` (at most `N + 1` members). -/
def finiteDiscFamily (N : ℕ) : Set GHSpace := {p | ∃ m ≤ N, p = discGH m}

/-- The infinite family of all finite discrete spaces. -/
def allDiscFamily : Set GHSpace := {p | ∃ m, p = discGH m}

/-! ## 2. Cardinality of the canonical representative -/

theorem encard_univ_rep_discGH (m : ℕ) :
    (univ : Set (GHSpace.Rep (discGH m))).encard = (m + 1 : ℕ∞) := by
  obtain ⟨e⟩ := toGHSpace_rep_isometryEquiv (Disc (m + 1))
  apply le_antisymm
  · calc (univ : Set (GHSpace.Rep (discGH m))).encard
        = (e '' (univ : Set (GHSpace.Rep (discGH m)))).encard := by
            rw [Set.image_univ, e.surjective.range_eq]
        _ ≤ (univ : Set (Disc (m+1))).encard := Set.encard_image_le e univ
        _ = (m + 1 : ℕ∞) := by simp
  · calc (m + 1 : ℕ∞) = (univ : Set (Disc (m+1))).encard := by simp
        _ = (e.symm '' (univ : Set (GHSpace.Rep (discGH m)))).encard := by
              rw [Set.image_univ, e.symm.surjective.range_eq]
        _ ≤ (univ : Set (GHSpace.Rep (discGH m))).encard := Set.encard_image_le e.symm univ
```
