/-- **The uniform scale bound alone does not give uniform covers.**  The family
`allDiscFamily` of all finite discrete spaces is uniformly bounded in diameter
(`univ ⊆ closedBall y (2 * 1)` for every member), but for `ε = 1/2` no finite
`K` bounds the number of `ε`-balls needed on all members.  Hence the uniform
doubling hypothesis of `uniformCovers_of_uniformDoubling` cannot be dropped. -/
theorem not_uniformCovers_allDiscFamily :
    ¬ (∀ ε : ℝ, 0 < ε → ∃ K : ℕ, ∀ p ∈ allDiscFamily, ∃ s : Set (GHSpace.Rep p),
        #s ≤ K ∧ univ ⊆ ⋃ x ∈ s, ball x ε) := by
  intro h
  obtain ⟨K, hK⟩ := h (1/2) (by norm_num)
  obtain ⟨s, hscard, hscov⟩ := hK (discGH K) ⟨K, rfl⟩
  obtain ⟨e⟩ := toGHSpace_rep_isometryEquiv (Disc (K + 1))
  obtain ⟨s', hs'card, hs'cov⟩ := exists_ball_cover_card_le_of_isometryEquiv e hscov
  have hK' : ((K + 1 : ℕ) : Cardinal) ≤ #s' := by
    have hsub : (univ : Set (Disc (K + 1))) ⊆ s' := by
      intro y hy
