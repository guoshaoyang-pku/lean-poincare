Proof sketch in Lean:
```lean
theorem exists_dist_optimalGHInjl_optimalGHInjr_le (x : X) :
    ∃ y : Y, dist (optimalGHInjl X Y x) (optimalGHInjr X Y y) ≤ ghDist X Y := by
  classical
  have hH : hausdorffDist (range Φ) (range Ψ) = ghDist X Y := hausdorffDist_optimal
  -- for each n, transport with rate H + 1/(n+1)
  choose y hy using fun n => exists_dist_optimalGHInjl_optimalGHInjr_lt (r := ghDist X Y + 1/((n:ℝ)+1)) (lt_add_of_pos_right _ (by positivity)) x
  -- y : ℕ → Y; the images Ψ (y n) lie in the compact range Ψ
  obtain ⟨z, hz, ψ, hψ, hzconv⟩ := IsCompact.tendsto_subseq (isCompact_range (isometry_optimalGHInjr X Y).continuous) (fun n => mem_range_self (y n))
  rcases mem_range.1 hz with ⟨y₀, rfl⟩
  refine ⟨y₀, ?_⟩
  -- dist (Φ x) (Ψ y₀) ≤ ghDist X Y  by limit
  have hdist : Tendsto (fun k => dist (optimalGHInjl X Y x) (optimalGHInjr X Y (y (ψ k)))) atTop (𝓝 (dist (optimalGHInjl X Y x) (optimalGHInjr X Y y₀))) :=
    tendsto_const_nhds.dist hzconv
  have hle : ∀ k, dist (optimalGHInjl X Y x) (optimalGHInjr X Y (y (ψ k))) ≤ ghDist X Y + 1/((ψ k : ℝ)+1) := fun k => le_of_lt (hy (ψ k))
  -- 1/(ψ k + 1) → 0
  have htend : Tendsto (fun k => 1/(((ψ k : ℕ) : ℝ) + 1)) atTop (𝓝 0) := (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).comp hψ.tendsto_atTop
  -- squeeze: limit ≤ ghDist
  have hbound : Tendsto (fun k => ghDist X Y + 1/(((ψ k:ℕ):ℝ)+1)) atTop (𝓝 (ghDist X Y + 0)) := tendsto_const_nhds.add htend
  have := le_of_tendsto_of_tendsto' hdist hbound hle  -- or le_of_tendsto_of_tendsto
  simpa using this
```
The key lemma: `le_of_tendsto_of_tendsto' : Tendsto u l (𝓝 a) → Tendsto v l (𝓝 b) → (∀ n, u n ≤ v n) → a ≤ b`. Let me check the name: in mathlib, `le_of_tendsto_of_tendsto` (requires `∀ᶠ`) and `le_of_tendsto_of_tendsto'` (requires `∀ n`). I believe both exist.

