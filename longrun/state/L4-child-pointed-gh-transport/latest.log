      Nonempty (PointedGHCoupling (fun k => X (φ k)) (fun k => x (φ k)) a.Rep x∞) := by
  classical
  -- 1. unpointed limit and subsequence from D12
  obtain ⟨a, φ, ha, hφ, _hconv, hgh⟩ := gh_subseq_of_familyBounds ht hu
  ...
