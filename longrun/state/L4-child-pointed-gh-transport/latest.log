      _ < 2 / ((n:ℝ)+1) := by
          have : 0 < 1 / ((n:ℝ)+1) := by positivity
          linarith
  basepoint_lt := fun n => by
    have : 0 < 2 / ((n : ℝ) + 1) := by positivity
    simpa [euclidx, euclidxLim] using this
