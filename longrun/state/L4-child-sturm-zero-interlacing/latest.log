/-
Independent acceptance probe for L4-child-sturm-zero-interlacing.

NOT part of the release deliverable.  Purpose: exercise the delivered theorems on data that
the deliverable itself does not use, so that the acceptance decision does not rest only on the
module's own witnesses.  Every probe theorem is new here; none is stated in the deliverable.
-/
import Poincare.L4.GeodesicComparison.SturmInterlacingConjugateCrossCheck

noncomputable section

open Set

namespace Poincare.L4.GeodesicComparison

open Poincare.D12.ComparisonGeodesics Poincare.D10

/-- Probe A: a *new* instance (k₁ = 3, k₂ = 1) of the general two-curvature interlacing:
the higher-curvature model `jacobiSol 3` has a zero strictly inside `(0, π)`, the interval
between the consecutive zeros `0`, `π` of `sin`.  The zero is exhibited at `π/√3`. -/
theorem probe_interlacing_k3_k1 : ∃ c ∈ Ioo (0 : ℝ) Real.pi, jacobiSol 3 c = 0 := by
  have hstrict : ∃ t ∈ Ioo (0 : ℝ) Real.pi, (1 : ℝ) < 3 :=
    ⟨Real.pi / 2, ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩, by norm_num⟩
  exact exists_zero_of_curvature_lt (a := 0) (b := Real.pi) Real.pi_pos
    (fun t _ => by norm_num)
    (modelJacobiSolutionOn 3 Real.pi) (sinJacobiSolutionOn 0 Real.pi)
    (jacobiSol_zero 3) Real.sin_zero Real.sin_pi
    (fun t ht => Real.sin_pos_of_pos_of_lt_pi ht.1 ht.2)
    (by simpa using Real.hasDerivAt_sin Real.pi) hstrict

/-- Probe B: the same instance in first-zero form, with closed forms: `firstPositiveZero` of
the `k = 3` model is `π/√3`, strictly below `π = firstPositiveZero sin`. -/
theorem probe_firstZero_k3_lt_sin :
    firstPositiveZero (jacobiSol 3) < firstPositiveZero Real.sin := by
  have h := firstPositiveZero_lt_of_curvature_lt (b := Real.pi) Real.pi_pos
    (fun t _ => by norm_num)
    (modelJacobiSolutionOn 3 Real.pi) (sinJacobiSolutionOn 0 Real.pi)
    (jacobiSol_zero 3) Real.sin_zero Real.sin_pi
    (fun t ht => Real.sin_pos_of_pos_of_lt_pi ht.1 ht.2)
    (by simpa using Real.hasDerivAt_sin Real.pi)
    ⟨Real.pi / 2, ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩, by norm_num⟩
  rwa [firstPositiveZero_modelJacobiSol (by norm_num : (0:ℝ) < 3), firstPositiveZero_sin] at h

/-- Probe C: the equality case `k ≡ K` of the zero-counting corollary, at `K = 4`: the
model solution vanishes in `(0, π/√4] = (0, π/2]`; this exercises the Wronskian-constancy
endpoint argument that is the new content relative to the prior art. -/
theorem probe_zero_count_equality_K4 :
    ∃ c ∈ Ioc (0 : ℝ) (Real.pi / Real.sqrt 4), jacobiSol 4 c = 0 :=
  exists_jacobi_zero_on_Ioc_pi_sqrt (K := 4) (by norm_num)
    (fun t _ => le_rfl) (modelJacobiSolutionOn 4 _) (jacobiSol_zero 4)

/-- Probe D: the sharpened positivity bound on the same model: `π/√4 = π/2`. -/
theorem probe_firstZero_bound_K4 : firstPositiveZero (jacobiSol 4) ≤ Real.pi / Real.sqrt 4 :=
  firstPositiveZero_le_pi_sqrt (K := 4) (by norm_num) (fun t _ => le_rfl)
    (modelJacobiSolutionOn 4 _) (jacobiSol_zero 4)

/-- Probe E: the acceptance's Wronskian inequality at a non-endpoint, independently of the
module's own evaluation points. -/
theorem probe_mul_cos_le_sin_at_three_pi_div_four :
    (3 * Real.pi / 4) * Real.cos (3 * Real.pi / 4) ≤ Real.sin (3 * Real.pi / 4) :=
  mul_cos_le_sin ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩

/-- Probe F: the horizon form of the zero-counting corollary, with horizon `H = 2 ≥ π/√1`. -/
theorem probe_horizon_K1 :
    ∃ c ∈ Ioc (0 : ℝ) (Real.pi / Real.sqrt 1), jacobiSol 1 c = 0 := by
  have h : (1:ℝ) ≤ 2 := by norm_num
  refine exists_jacobi_zero_of_horizon (K := 1) (H := 2) (by norm_num)
    (fun t _ => le_rfl) ?_ (jacobiSol_zero 1) (jacobiDeriv_zero 1) ?_
  · -- JacobiSolutionOn (jacobiSol 1) on (0,2)
    exact modelJacobiSolutionOn 1 2
  · -- π/√1 ≤ 2
    rw [Real.sqrt_one, div_one]
    linarith [Real.pi_lt_four]  -- hmm Real.pi_lt_four might not exist; use Real.pi_lt_314159? 
```

