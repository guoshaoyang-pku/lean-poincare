Third:
```lean
/-- **First-positive-zero interlacing.**  If `k₂ ≤ k₁` on `[0,b]`, the `k₂`-solution `u₂`
vanishes at `0` and `b` and is positive in between, the `k₁`-solution vanishes at `0`, and
`k₁` strictly exceeds `k₂` at an interior point, then the first positive zero of `u₁` is
strictly smaller than `b` — the first zero of the lower-curvature solution.  This is the
`firstPositiveZero` form of the sharper two-curvature interlacing. -/
theorem firstPositiveZero_lt_of_curvature_lt {k₁ k₂ u₁ du₁ ddu₁ u₂ du₂ ddu₂ : ℝ → ℝ} {b : ℝ}
    (hb : 0 < b) (hk : ∀ t ∈ Icc (0 : ℝ) b, k₂ t ≤ k₁ t)
    (h1 : JacobiSolutionOn k₁ u₁ du₁ ddu₁ 0 b) (h2 : JacobiSolutionOn k₂ u₂ du₂ ddu₂ 0 b)
    (hu1 : u₁ 0 = 0) (hu2 : u₂ 0 = 0) (hu2b : u₂ b = 0)
    (hu2pos : ∀ ⦃t : ℝ⦄, t ∈ Ioo (0 : ℝ) b → 0 < u₂ t)
    (hdu2b : HasDerivAtR u₂ (du₂ b) b)
    (hstrict : ∃ t ∈ Ioo (0 : ℝ) b, k₂ t < k₁ t) :
    firstPositiveZero u₁ < b := by
  obtain ⟨c, hc, hcz⟩ :=
    exists_zero_of_curvature_lt hb hk h1 h2 hu1 hu2 hu2b hu2pos hdu2b hstrict
  have hmem : c ∈ {t : ℝ | 0 < t ∧ u₁ t = 0} := ⟨hc.1, hcz⟩
  have hbdd : BddBelow {t : ℝ | 0 < t ∧ u₁ t = 0} := ⟨0, fun y hy => hy.1.le⟩
  exact lt_of_le_of_lt (csInf_le hbdd hmem) hc.2
```

Fourth:
```lean
/-- **The explicit first-zero ordering.**  The first positive zero of `sin` (curvature `1`) is
strictly smaller than the first positive zero of the model `jacobiSol (1/2)` (curvature `1/2`),
i.e. `π < √2·π`: the higher-curvature solution vanishes first.  This is the sharpest form of
the sharper two-curvature interlacing for this data. -/
theorem firstPositiveZero_sin_lt_half_model :
    firstPositiveZero Real.sin < firstPositiveZero (jacobiSol (1 / 2)) := by
  have hK₂ : (0 : ℝ) < 1 / 2 := by norm_num
  have hz : 0 < Real.pi / Real.sqrt (1 / 2) := div_pos Real.pi_pos (Real.sqrt_pos_of_pos hK₂)
  have hstrict : ∃ t ∈ Ioo (0 : ℝ) (Real.pi / Real.sqrt (1 / 2)), (1 / 2 : ℝ) < 1 :=
    ⟨Real.pi / Real.sqrt (1 / 2) / 2, ⟨by linarith, by linarith⟩, by norm_num⟩
  have hlt := firstPositiveZero_lt_of_curvature_lt hz (fun t _ => by norm_num)
    (sinJacobiSolutionOn 0 _) (modelJacobiSolutionOn (1 / 2) _)
    Real.sin_zero (jacobiSol_zero (1 / 2)) (modelJacobiSol_firstZero hK₂)
    (modelJacobiSol_pos hK₂) (hasDerivAt_jacobiSol (1 / 2) _) hstrict
  rwa [firstPositiveZero_sin, firstPositiveZero_modelJacobiSol hK₂] at hlt
```

Fifth (horizon + firstPositiveZero):
```lean
/-- **Horizon form of the first-zero bound.**  Version of `firstPositiveZero_le_pi_sqrt` for
data given only up to a horizon `H ≥ π/√K`. -/
theorem firstPositiveZero_le_pi_sqrt_of_horizon {k u du ddu : ℝ → ℝ} {K H : ℝ}
    (hK : 0 < K) (hk : ∀ t ∈ Icc (0 : ℝ) H, K ≤ k t)
    (h : JacobiSolutionOn k u du ddu 0 H) (hu0 : u 0 = 0) (hH : Real.pi / Real.sqrt K ≤ H) :
    firstPositiveZero u ≤ Real.pi / Real.sqrt K := by
  have hmono : JacobiSolutionOn k u du ddu 0 (Real.pi / Real.sqrt K) :=
    { hasDerivAt_u := fun t ht => h.hasDerivAt_u ⟨ht.1, lt_of_lt_of_le ht.2 hH⟩
      hasDerivAt_du := fun t ht => h.hasDerivAt_du ⟨ht.1, lt_of_lt_of_le ht.2 hH⟩
      eq_secondDeriv := fun t ht => h.eq_secondDeriv ⟨ht.1, lt_of_lt_of_le ht.2 hH⟩
      continuousOn_u := h.continuousOn_u.mono (Icc_subset_Icc_right hH)
      continuousOn_du := h.continuousOn_du.mono (Icc_subset_Icc_right hH) }
  exact firstPositiveZero_le_pi_sqrt hK (fun t ht => hk t ⟨ht.1, le_trans ht.2 hH⟩) hmono hu0
```

