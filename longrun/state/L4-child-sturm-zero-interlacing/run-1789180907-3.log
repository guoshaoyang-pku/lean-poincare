/-- **The first positive zero of `sin` is exactly `π`.** -/
theorem firstPositiveZero_sin : firstPositiveZero Real.sin = Real.pi := by
  have hmem : Real.pi ∈ {t : ℝ | 0 < t ∧ Real.sin t = 0} := ⟨Real.pi_pos, Real.sin_pi⟩
  have hbdd : BddBelow {t : ℝ | 0 < t ∧ Real.sin t = 0} := ⟨0, fun y hy => hy.1.le⟩
  refine le_antisymm (csInf_le hbdd hmem) (le_csInf ⟨_, hmem⟩ ?_)
  intro y hy
  by_contra hlt
  exact sin_no_zero_in_Ioo_zero_pi ⟨y, ⟨hy.1, lt_of_not_ge hlt⟩, hy.2⟩
```
