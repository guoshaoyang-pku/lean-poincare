theorem firstPositiveZero_modelJacobiSol {K} (hK : 0 < K) :
    firstPositiveZero (jacobiSol K) = Real.pi / Real.sqrt K := by
  have hz := div_pos Real.pi_pos (Real.sqrt_pos_of_pos hK)
  have hmem : Real.pi / Real.sqrt K ∈ {t | 0 < t ∧ jacobiSol K t = 0} := ⟨hz, modelJacobiSol_firstZero hK⟩
  have hbdd : BddBelow {t | 0 < t ∧ jacobiSol K t = 0} := ⟨0, fun y hy => hy.1.le⟩
  refine le_antisymm (csInf_le hbdd hmem) (le_csInf ⟨_, hmem⟩ ?_)
  intro y hy
  by_contra hlt
  have hyz : y < Real.pi / Real.sqrt K := lt_of_not_ge hlt
  exact absurd hy.2 (ne_of_gt (modelJacobiSol_pos hK y ⟨hy.1, hyz⟩))
```
