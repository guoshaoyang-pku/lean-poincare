```lean
/-! ## 3b. The first positive zero as a zero-ordering statement -/

/-- **The model's first positive zero is exactly `π/√K`.**  For `K > 0` the model `jacobiSol K`
vanishes at `π/√K`, is positive on `(0, π/√K)`, and therefore has no smaller positive zero:
its positive zero set has least element `π/√K`. -/
theorem firstPositiveZero_modelJacobiSol {K : ℝ} (hK : 0 < K) :
    firstPositiveZero (jacobiSol K) = Real.pi / Real.sqrt K := by
  have hz : 0 < Real.pi / Real.sqrt K := div_pos Real.pi_pos (Real.sqrt_pos_of_pos hK)
  have hmem : Real.pi / Real.sqrt K ∈ {t : ℝ | 0 < t ∧ jacobiSol K t = 0} :=
    ⟨hz, modelJacobiSol_firstZero hK⟩
  have hbdd : BddBelow {t : ℝ | 0 < t ∧ jacobiSol K t = 0} := ⟨0, fun y hy => hy.1.le⟩
  refine le_antisymm (csInf_le hbdd hmem) (le_csInf ⟨_, hmem⟩ ?_)
  intro y hy
  by_contra hlt
  exact absurd hy.2 (ne_of_gt (modelJacobiSol_pos hK y ⟨hy.1, lt_of_not_ge hlt⟩))
```

Careful with `csInf_le hbdd hmem`: the goal is `firstPositiveZero (jacobiSol K) ≤ π/√K`. `firstPositiveZero` is a `def` (noncomputable def), so `csInf_le` should unify `sInf {t | 0<t ∧ jacobiSol K t = 0}` with `firstPositiveZero (jacobiSol K)` by delta reduction. In `firstPositiveZero_le_pi_sqrt` the same pattern is used and compiles. Good.

`le_csInf ⟨_, hmem⟩ ?_`: goal `π/√K ≤ firstPositiveZero (jacobiSol K)`, i.e. `π/√K ≤ sInf S`. `le_csInf` needs `S.Nonempty` — `⟨_, hmem⟩` : `S.Nonempty`? `hmem : π/√K ∈ S`, so `⟨π/√K, hmem⟩`. Using `⟨_, hmem⟩` works. Then `intro y hy` gives `y ∈ S` and goal `π/√K ≤ y`. `by_contra hlt` gives `¬ π/√K ≤ y` i.e. `y < π/√K`. `lt_of_not_ge hlt : y < π/√K`. `modelJacobiSol_pos hK y ⟨hy.1, lt_of_not_ge hlt⟩ : 0 < jacobiSol K y`. `hy.2 : jacobiSol K y = 0`. `ne_of_gt (...) : jacobiSol K y ≠ 0`. `absurd hy.2 (...)`: `absurd : a → ¬a → b`; here `hy.2 : jacobiSol K y = 0` and `ne_of_gt h : jacobiSol K y ≠ 0`. Yes, `absurd hy.2 (ne_of_gt h)` works.

```lean
/-- **The first positive zero of `sin` is exactly `π`.**  `sin π = 0` and `sin` is zero-free on
`(0,π)` (the prior-art `sin_no_zero_in_Ioo_zero_pi`), so `π` is the least positive zero. -/
theorem firstPositiveZero_sin : firstPositiveZero Real.sin = Real.pi := by
  have hmem : Real.pi ∈ {t : ℝ | 0 < t ∧ Real.sin t = 0} := ⟨Real.pi_pos, Real.sin_pi⟩
  have hbdd : BddBelow {t : ℝ | 0 < t ∧ Real.sin t = 0} := ⟨0, fun y hy => hy.1.le⟩
  refine le_antisymm (csInf_le hbdd hmem) (le_csInf ⟨_, hmem⟩ ?_)
  intro y hy
  by_contra hlt
  exact sin_no_zero_in_Ioo_zero_pi ⟨y, ⟨hy.1, lt_of_not_ge hlt⟩, hy.2⟩
```

```lean
/-- **First-positive-zero interlacing.**  Let `k₂ ≤ k₁` on `[0,b]`, let the `k₂`-solution `u₂`
vanish at `0` and `b` and be positive in between, let the `k₁`-solution `u₁` vanish at `0`, and
suppose `k₁` strictly exceeds `k₂` at an interior point.  Then the first positive zero of `u₁`
is strictly smaller than `b`, the first positive zero of `u₂`: the higher-curvature solution
vanishes first.  This is the `firstPositiveZero` form of the sharper two-curvature
interlacing. -/
theorem firstPositiveZero_lt_of_curvature_lt {k₁ k₂ u₁ du₁ ddu₁ u₂ du₂ ddu₂ : ℝ → ℝ} {b : ℝ}
    (hb : 0 < b) (hk : ∀ t ∈ Icc (0 : ℝ) b, k₂ t ≤ k₁ t)
    (h1 : JacobiSolutionOn k₁ u₁ du₁ ddu₁ 0 b) (h2 : JacobiSolutionOn k₂ u₂ du₂ ddu₂ 0 b)
    (hu1 : u₁ 0 = 0) (hu2 : u₂ 0 = 0) (hu2b : u₂ b = 0)
    (hu2pos : ∀ ⦃t : ℝ⦄, t ∈ Ioo (0 : ℝ) b → 0 < u₂ t)
    (hdu2b : HasDerivAtR u₂ (du₂ b) b)
    (hstrict : ∃ t ∈ Ioo (0 : ℝ) b, k₂ t < k₁ t) :
    firstPositiveZero u₁ < b := by
  obtain ⟨c, hc, hcz⟩ :=
    exists_zero_of_curvature_lt hb hk h1 h2 hu1 hu2 hu2b hu2pos hdu2b hstrict
  have hmem : c ∈ {t : ℝ | 0 < t ∧ u₁ t = 0} := ⟨hc.1, hcz⟩
  have hbdd : BddBelow {t : ℝ | 0 < t ∧ u₁ t = 0} := ⟨0, fun y hy => hy.1.le⟩
  exact lt_of_le_of_lt (csInf_le hbdd hmem) hc.2
```

```lean
/-- **The explicit first-zero ordering `π < √2·π`.**  The first positive zero of `sin`
(curvature `1`) is strictly smaller than the first positive zero of the model
`jacobiSol (1/2)` (curvature `1/2`): the higher-curvature solution vanishes first, in the
sharpest possible form for this data. -/
theorem firstPositiveZero_sin_lt_half_model :
    firstPositiveZero Real.sin < firstPositiveZero (jacobiSol (1 / 2)) := by
  have hK₂ : (0 : ℝ) < 1 / 2 := by norm_num
  have hz : 0 < Real.pi / Real.sqrt (1 / 2) :=
    div_pos Real.pi_pos (Real.sqrt_pos_of_pos hK₂)
  have hstrict : ∃ t ∈ Ioo (0 : ℝ) (Real.pi / Real.sqrt (1 / 2)), (1 / 2 : ℝ) < 1 :=
    ⟨Real.pi / Real.sqrt (1 / 2) / 2, ⟨by linarith, by linarith⟩, by norm_num⟩
  have hlt := firstPositiveZero_lt_of_curvature_lt hz (fun t _ => by norm_num)
    (sinJacobiSolutionOn 0 _) (modelJacobiSolutionOn (1 / 2) _)
    Real.sin_zero (jacobiSol_zero (1 / 2)) (modelJacobiSol_firstZero hK₂)
    (modelJacobiSol_pos hK₂) (hasDerivAt_jacobiSol (1 / 2) _) hstrict
  rwa [firstPositiveZero_sin, firstPositiveZero_modelJacobiSol hK₂] at hlt
```

