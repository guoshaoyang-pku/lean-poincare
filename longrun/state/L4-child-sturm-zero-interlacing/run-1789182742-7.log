/-
Independent acceptance probe — second invocation, 2026-09-12.
Written from scratch against the frozen deliverable modules; evidence for
L4-child-sturm-zero-interlacing.  Nothing here is used by the deliverable.
-/
import Poincare.L4.GeodesicComparison.SturmInterlacingConjugateCrossCheck

noncomputable section

open Set Filter
open scoped Topology

namespace Poincare.L4.GeodesicComparison

open Poincare.D12.ComparisonGeodesics Poincare.D10

/-- (NA1) independent new interlacing instance: π/√3 is a zero of `jacobiSol 3` inside the
interval `(0, π/√(1/4)) = (0, 2π)` spanned by the consecutive zeros of the `k = 1/4` model. -/
theorem gs_na1_jacobiSol_three_zero_between_quarter_model :
    jacobiSol 3 (Real.pi / Real.sqrt 3) = 0 ∧
      Real.pi / Real.sqrt 3 ∈ Ioo (0 : ℝ) (Real.pi / Real.sqrt (1 / 4)) := by
