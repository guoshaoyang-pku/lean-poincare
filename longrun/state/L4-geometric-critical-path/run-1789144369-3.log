      (Abar := jacobiSol K) (dAbar := jacobiDeriv K) (m := fun t => du t/u t)
      (mbar := fun t => jacobiDeriv K t/jacobiSol K t) hT
      (fun t ht => h.hasDerivAt_u ht)
