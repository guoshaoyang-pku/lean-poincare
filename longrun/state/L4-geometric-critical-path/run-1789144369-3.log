```lean
/-- **Integrated Rauch II comparison.** ... `j_K t ≤ u t` on `(0,T)`. -/
theorem constCurvModel_le_jacobi {k u du ddu : ℝ → ℝ} {T B t₀ K : ℝ}
    (hT) (hBnn) (ht₀) (ht₀T) (hBt₀) (h) (hdducont) (hB) (hu0) (hdu0) (hpos)
    (hK : K ≤ 0) (hk : ∀ t ∈ Ioo 0 T, k t ≤ K)
    (hBmodel : (|K| * jacobiSol K T) * t₀ ≤ 1/2) :
    ∀ t ∈ Ioo 0 T, jacobiSol K t ≤ u t := by
  have hmle := rauch_lower_of_jacobi_constCurv ... -- j_K'/j_K ≤ u'/u
  have hanti := areaRatio_antitone_of_logDeriv_le (T := T) (A := jacobiSol K) (dA := jacobiDeriv K)
      (Abar := u) (dAbar := du) (m := model log deriv) (mbar := u log deriv) hT
      (fun t ht => hmodel.hasDerivAt_u ht) (fun t ht => h.hasDerivAt_u ht)
      hmodel.continuousOn_u h.continuousOn_u hmodelpos hpos
      (fun t ht => rfl) (fun t ht => rfl) hmle
  -- limits: j_K s/u s → 1
  ... (same as before, with j_K and u swapped)
  intro t ht
  have htIoc : t ∈ Ioc 0 T := ...
  have hev : ∀ᶠ s in 𝓝[>] 0, jacobiSol K t / u t ≤ jacobiSol K s / u s := ...
  have hlim_le := le_of_tendsto_of_tendsto tendsto_const_nhds hratio hev
  rwa [div_le_one (hpos t htIoc)] at hlim_le  -- careful: goal j_K t / u t ≤ 1 → j_K t ≤ u t
```
where `hratio : Tendsto (fun s => jacobiSol K s / u s) (𝓝[>] 0) (𝓝 1)`.

For hratio: `hjlim.div hulim one_ne_zero` then congr with eventual equality (needs u s ≠ 0 from hpos, s ≠ 0).

The limit lemmas `hulim` (u s/s → 1) and `hjlim` (j_K s/s → 1) can be factored into a helper lemma to avoid duplication:
```
theorem div_id_tendsto_of_jacobi {k u du ddu} {T B} (h : JacobiSolutionOn k u du ddu 0 T)
    (hdducont) (hBnn) (hB) (hu0) (hdu0) (hT : 0 < T) :
