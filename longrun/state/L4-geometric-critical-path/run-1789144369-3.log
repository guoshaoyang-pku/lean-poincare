import Poincare.D12.GeometricCompactness.Criterion
import Poincare.D12.GeometricCompactness.Frontier
import Mathlib.Topology.MetricSpace.HausdorffDistance

namespace Poincare.L4.Compactness

/-- Point transport across a Gromov–Hausdorff bound: if `ghDist X Y < r` then for every
`x : X` there is `y : Y` with `dist x y < r`. -/
theorem exists_dist_lt_of_ghDist_lt {X : Type u} [MetricSpace X] [CompactSpace X] [Nonempty X]
    {Y : Type u} [MetricSpace Y] [CompactSpace Y] [Nonempty Y] {r : ℝ}
    (h : ghDist X Y < r) (x : X) : ∃ y : Y, dist x y < r := by
  have hH : hausdorffDist (range (optimalGHInjl X Y)) (range (optimalGHInjr X Y)) < r := by
    rwa [hausdorffDist_optimal]
  have hfin : hausdorffEDist (range (optimalGHInjl X Y)) (range (optimalGHInjr X Y)) ≠ ⊤ := ...
  obtain ⟨z, hz, hdist⟩ := Metric.exists_dist_lt_of_hausdorffDist_lt (x := optimalGHInjl X Y x) (mem_range_self _) hH hfin
  obtain ⟨y, rfl⟩ := hz  -- z ∈ range (optimalGHInjr X Y)
  exact ⟨y, by simpa [Isometry.dist_eq (isometry_optimalGHInjl X Y), Isometry.dist_eq (isometry_optimalGHInjr X Y)] using hdist⟩
```
