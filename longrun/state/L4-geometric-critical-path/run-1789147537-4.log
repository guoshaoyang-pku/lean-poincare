theorem IsCover.finset_biUnion {A : Set X} {δ ε : ℝ≥0} {F : Finset X} {G : X → Finset X}
    (hF : IsCover δ A (F : Set X))
    (hG : ∀ c ∈ F, IsCover ε (closedBall c δ) (G c : Set X)) :
