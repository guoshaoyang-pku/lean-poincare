theorem exists_finset_cover_card_le_of_doubling (n : ℕ)
    (hN : ∀ (c : X) (r : ℝ≥0), Metric.coveringNumber r (closedBall c (2 * r)) ≤ (n : ℕ∞)) :
    ∀ (x : X) (R : ℝ≥0) (k : ℕ), ∃ F : Finset X,
      F.card ≤ n ^ (k + 1) ∧ IsCover (R / 2 ^ k) (closedBall x (2 * R)) (F : Set X) := by
  intro x R k
  induction k with
  | zero =>
