theorem coveringNumber_univ_le_of_subset_univ {ε : ℝ≥0} {A : Set X}
    (hA : (univ : Set X) ⊆ A) :
    Metric.coveringNumber ε (univ : Set X) ≤ Metric.coveringNumber ε A := by
  simp only [Metric.coveringNumber]
  refine le_iInf fun C => le_iInf fun hCsub => le_iInf fun hCcov => ?_
