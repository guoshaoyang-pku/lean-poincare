      ≤ Metric.coveringNumber δ (univ : Set Y) := coveringNumber_le_of_ghDist_lt hgh δ ε hε
    _ ≤ Metric.coveringNumber (R / 2^k) (univ : Set Y) := Metric.coveringNumber_anti hδ
    _ ≤ Metric.coveringNumber (R / 2^k) (closedBall y (2*R)) := ?mono
