    {X Y : Type u} [MetricSpace X] [CompactSpace X] [Nonempty X]
    [MetricSpace Y] [CompactSpace Y] [Nonempty Y]
    (n : ℕ) (hY : ∀ (c : Y) (r : ℝ≥0), Metric.coveringNumber r (closedBall c (2*r)) ≤ (n:ℕ∞))
    {y : Y} {R : ℝ≥0} (hR : (univ : Set Y) ⊆ closedBall y (2*R))
    {r : ℝ} (hr : 0 ≤ r) {δ ε : ℝ≥0} {k : ℕ}
    (hgh : GromovHausdorff.ghDist X Y < r) (hε : 2*r + (δ:ℝ) < (ε:ℝ))
