D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.divergence_integral_eq_zero_density	theorem	Poincare.D12.VolumeIBP.Divergence	∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1))   (X : Poincare.D12.VolumeIBP.Vec (n + 1) → Poincare.D12.VolumeIBP.Vec (n + 1)),   ContDiff ℝ 1 X → HasCompactSupport X → ∫ (x : Poincare.D12.VolumeIBP.Vec (n + 1)), G.divergence X x * G.density x = 0
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.driftLaplacian	def	Poincare.D12.VolumeIBP.IBP	{n : ℕ} →   Poincare.D12.VolumeIBP.ChartMetric (n + 1) →     (Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ) →       (Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ) → Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.driftLaplacian.eq_1	theorem	Poincare.D12.VolumeIBP.IBP	∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (f u : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ)   (x : Poincare.D12.VolumeIBP.Vec (n + 1)), G.driftLaplacian f u x = G.laplacian u x - G.gradInnerInverse f u x
