D13TYPE	Poincare.D12.KappaVariational.kappaVariationalRemainingDependencies	def	Poincare.D12.KappaVariational.Statements	List Poincare.D7.ShortTime.MissingDependency
D13TYPE	Poincare.D12.KappaVariational.kappaVariationalRemainingDependencies.eq_1	theorem	Poincare.D12.KappaVariational.Statements	Poincare.D12.KappaVariational.kappaVariationalRemainingDependencies =   [{ name := "KV-1 path-space compactness (general RLV-1)",       reason :=         "compactness/lower-semicontinuity for L-length minimisers on a general metric-flow interface; only the Gaussian and constant-curvature families have explicit minimisers (constantCurvatureLMinimizerExistence, gaussianLMinimizerExistence)" },     { name := "KV-2 L-geodesic equation (RLV-2)",       reason := "first variation of the L-length and the L-geodesic ODE for general curvature data" },     { name := "KV-3 minimiser regularity (RLV-3)",       reason := "smoothness of L-minimisers on (0, tau] and continuity at the base time for general flows" },     { name := "KV-4 L-exponential map (RLV-4)",       reason := "construction and differentiability of the L-exponential map" },     { name := "KV-5 second variation and index form (RLV-5)",       reason := "nonnegativity of the L-index form along minimising L-geodesics" },     { name := "KV-6 Jacobian comparison (RLV-6)",       reason := "Perelman's Jacobian bound under a Ricci lower bound for general flows" },     { name := "KV-7 reduced-length differential inequality (RLV-7)",       reason := "l_tau - Delta l + |grad l|^2 - R + n/(2 tau) >= 0 for the reduced length of a genuine Ricci flow" },     { name := "KV-8 differentiation under the integral (RLV-8)",       reason := "dominated convergence for the derivative of the continuum reduced volume" },     { name := "KV-9 manifold metric flow (RLV-9)",       reason := "manifold metrics, Ricci tensor and covariant calculus on a genuine Ricci flow" },     { name := "KV-10 ball-volume comparison (NCF-9)",       reason :=         "collapsed ball at scale r forces small reduced volume at tau = r^2 (the ballVolumeComparisonExists input)" },     { name := "KV-11 ancient-solution rigidity (NCF-10)",       reason :=         "equality case of the monotonicity: the Gaussian shrinking soliton; not inferred from any formal record" },     { name := "KV-12 no-local-collapsing compactness (NCF-11)",       reason := "blow-up/compactness extraction of the ancient limit" },     { name := "KV-13 normalisation and uniform kappa (general NCF-12)",       reason :=         "the general reduced-volume normalisation and the identification of the uniform kappa; the Gaussian model half is closed (ncf12ModelClosure)" }]
D13TYPE	Poincare.D12.KappaVariational.kappaVariationalRemainingDependencies_all_named	theorem	Poincare.D12.KappaVariational.Statements	∀ d ∈ Poincare.D12.KappaVariational.kappaVariationalRemainingDependencies, d.name ≠ "" ∧ d.reason ≠ ""
D13TYPE	Poincare.D12.KappaVariational.kappaVariationalRemainingDependencies_length	theorem	Poincare.D12.KappaVariational.Statements	Poincare.D12.KappaVariational.kappaVariationalRemainingDependencies.length = 13
