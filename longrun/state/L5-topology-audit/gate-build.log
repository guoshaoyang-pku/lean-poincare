D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.divergence.eq_1	theorem	Poincare.D12.VolumeIBP.Divergence	∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1))   (X : Poincare.D12.VolumeIBP.Vec (n + 1) → Poincare.D12.VolumeIBP.Vec (n + 1))   (x : Poincare.D12.VolumeIBP.Vec (n + 1)),   G.divergence X x = Poincare.D12.VolumeIBP.ChartMetric.weightedDivergence G.density X x / G.density x
