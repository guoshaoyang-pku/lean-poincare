info: Poincare/D7/ConjugateHeat/Probe.lean:76:0: @energy_le_energy_conjugateHeatStep : ∀ {V : Type u_1} {E : Type u_2} [inst : Fintype V] [inst_1 : Fintype E]
  [inst_2 : DecidableEq V] (D : Divergence.DivergenceData V E) (w : E → ℝ) (m R : V → ℝ),
  (∀ (x : V), 0 < m x) →
    (∀ (e : E), 0 ≤ w e) → (∀ (x : V), 0 ≤ R x) → ∀ (u : V → ℝ), energy m u ≤ energy m (conjugateHeatStep D w m R u)
info: Poincare/D7/ConjugateHeat/Probe.lean:77:0: @energy_mono_slab : ∀ {V : Type u_1} {E : Type u_2} [inst : Fintype V] [inst_1 : Fintype E] [inst_2 : DecidableEq V]
  {n : ℕ} (D : Divergence.DivergenceData V E) (w : E → ℝ) (m R : V → ℝ),
  (∀ (x : V), 0 < m x) →
    (∀ (e : E), 0 ≤ w e) →
      (∀ (x : V), 0 ≤ R x) →
        ∀ (u : Fin (n + 1) → V → ℝ),
          (∀ (k : Fin n), u k.succ = conjugateHeatStep D w m R (u k.castSucc)) →
            energy m (u 0) ≤ energy m (u (Fin.last n))
