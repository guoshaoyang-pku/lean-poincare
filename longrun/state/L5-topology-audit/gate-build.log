D13TYPE	Poincare.D12.ConnectionCurvature.nablaOf._proof_6	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaForm	∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι]   (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (X₁ X₂ : ι → ℝ),   { toFun := fun Y k => ∑ i, ∑ j, c.christoffel k i j * (X₁ + X₂) i * Y j, map_add' := ⋯, map_smul' := ⋯ } =     { toFun := fun Y k => ∑ i, ∑ j, c.christoffel k i j * X₁ i * Y j, map_add' := ⋯, map_smul' := ⋯ } +       { toFun := fun Y k => ∑ i, ∑ j, c.christoffel k i j * X₂ i * Y j, map_add' := ⋯, map_smul' := ⋯ }
D13TYPE	Poincare.D12.ConnectionCurvature.nablaOf._proof_7	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaForm	∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι]   (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (a : ℝ) (X Y₁ Y₂ : ι → ℝ),   (fun k => ∑ i, ∑ j, c.christoffel k i j * (a • X) i * (Y₁ + Y₂) j) =     (fun k => ∑ i, ∑ j, c.christoffel k i j * (a • X) i * Y₁ j) + fun k =>       ∑ i, ∑ j, c.christoffel k i j * (a • X) i * Y₂ j
D13TYPE	Poincare.D12.ConnectionCurvature.nablaOf._proof_8	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaForm	∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι]   (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (a : ℝ) (X : ι → ℝ) (a_1 : ℝ) (Y : ι → ℝ),   (fun k => ∑ i, ∑ j, c.christoffel k i j * (a • X) i * (a_1 • Y) j) =     (RingHom.id ℝ) a_1 • fun k => ∑ i, ∑ j, c.christoffel k i j * (a • X) i * Y j
D13TYPE	Poincare.D12.ConnectionCurvature.nablaOf._proof_9	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaForm	∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι]   (c : Poincare.D12.ConnectionCurvature.ChartMetricCoefficients ι) (a : ℝ) (X : ι → ℝ),   { toFun := fun Y k => ∑ i, ∑ j, c.christoffel k i j * (a • X) i * Y j, map_add' := ⋯, map_smul' := ⋯ } =     (RingHom.id ℝ) a • { toFun := fun Y k => ∑ i, ∑ j, c.christoffel k i j * X i * Y j, map_add' := ⋯, map_smul' := ⋯ }
