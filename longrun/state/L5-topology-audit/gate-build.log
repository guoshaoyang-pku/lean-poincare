D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.chart_ibp_laplacian	theorem	Poincare.D12.VolumeIBP.IBP	∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (u : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),   ContDiff ℝ ⊤ u →     HasCompactSupport u →       ∫ (x : Poincare.D12.VolumeIBP.Vec (n + 1)), u x * G.laplacian (fun y => G.laplacian u y) x * G.density x =         -∫ (x : Poincare.D12.VolumeIBP.Vec (n + 1)), G.gradInnerInverse u (fun y => G.laplacian u y) x * G.density x
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.chart_ibp_self	theorem	Poincare.D12.VolumeIBP.IBP	∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (u : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),   ContDiff ℝ 2 u →     HasCompactSupport u →       ∫ (x : Poincare.D12.VolumeIBP.Vec (n + 1)), u x * G.laplacian u x * G.density x =         -∫ (x : Poincare.D12.VolumeIBP.Vec (n + 1)), G.gradInnerInverse u u x * G.density x
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.chart_weighted_ibp	theorem	Poincare.D12.VolumeIBP.IBP	∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (f u v : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),   ContDiff ℝ 2 f →     ContDiff ℝ 2 u →       ContDiff ℝ 2 v →         HasCompactSupport v →           ∫ (x : Poincare.D12.VolumeIBP.Vec (n + 1)), G.driftLaplacian f u x * v x * Real.exp (-f x) * G.density x =             -∫ (x : Poincare.D12.VolumeIBP.Vec (n + 1)), G.gradInnerInverse u v x * Real.exp (-f x) * G.density x
