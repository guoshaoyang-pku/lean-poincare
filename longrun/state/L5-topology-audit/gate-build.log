D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.weightedDivergence	def	Poincare.D12.VolumeIBP.Divergence	{n : ℕ} →   (Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ) →     (Poincare.D12.VolumeIBP.Vec (n + 1) → Poincare.D12.VolumeIBP.Vec (n + 1)) → Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.weightedDivergence.eq_1	theorem	Poincare.D12.VolumeIBP.Divergence	∀ {n : ℕ} (ω : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ)   (X : Poincare.D12.VolumeIBP.Vec (n + 1) → Poincare.D12.VolumeIBP.Vec (n + 1))   (x : Poincare.D12.VolumeIBP.Vec (n + 1)),   Poincare.D12.VolumeIBP.ChartMetric.weightedDivergence ω X x = ∑ i, (fderiv ℝ (fun y => ω y * X y i) x) (Pi.single i 1)
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.weighted_divergence_integral_eq_zero	theorem	Poincare.D12.VolumeIBP.Divergence	∀ {n : ℕ} (ω : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),   ContDiff ℝ 1 ω →     ∀ (X : Poincare.D12.VolumeIBP.Vec (n + 1) → Poincare.D12.VolumeIBP.Vec (n + 1)),       ContDiff ℝ 1 X →         HasCompactSupport X →           ∫ (x : Poincare.D12.VolumeIBP.Vec (n + 1)), Poincare.D12.VolumeIBP.ChartMetric.weightedDivergence ω X x = 0
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.weighted_divergence_mul_exp_grad	theorem	Poincare.D12.VolumeIBP.IBP	∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (f u v : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),   ContDiff ℝ 2 f →     ContDiff ℝ 2 u →       ContDiff ℝ 2 v →         ∀ (x : Poincare.D12.VolumeIBP.Vec (n + 1)),           Poincare.D12.VolumeIBP.ChartMetric.weightedDivergence (fun y => Real.exp (-f y) * G.density y)               (fun y i => v y * G.grad u y i) x =             Real.exp (-f x) * G.density x * (v x * G.driftLaplacian f u x + G.gradInnerInverse v u x)
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.weighted_divergence_mul_grad	theorem	Poincare.D12.VolumeIBP.IBP	∀ {n : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric (n + 1)) (u v : Poincare.D12.VolumeIBP.Vec (n + 1) → ℝ),   ContDiff ℝ 2 u →     ContDiff ℝ 2 v →       ∀ (x : Poincare.D12.VolumeIBP.Vec (n + 1)),         Poincare.D12.VolumeIBP.ChartMetric.weightedDivergence G.density (fun y i => u y * G.grad v y i) x =           G.density x * (u x * G.laplacian v x + G.gradInnerInverse u v x)
