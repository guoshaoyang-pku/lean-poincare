D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.riemannianMeasure_absolutelyContinuous	theorem	Poincare.D12.VolumeIBP.Regularity	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d), G.riemannianMeasure.AbsolutelyContinuous MeasureTheory.volume
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.riemannianMeasure_def	theorem	Poincare.D12.VolumeIBP.Basic	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d),   G.riemannianMeasure = MeasureTheory.volume.withDensity fun x => ↑(G.densityNNReal x)
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.riemannianMeasure_univ	theorem	Poincare.D12.VolumeIBP.Regularity	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d),   G.riemannianMeasure Set.univ = ∫⁻ (x : Poincare.D12.VolumeIBP.Vec d), ENNReal.ofReal (G.density x)
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.setIntegral_riemannianMeasure_eq	theorem	Poincare.D12.VolumeIBP.Regularity	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d) (f : Poincare.D12.VolumeIBP.Vec d → ℝ)   {s : Set (Poincare.D12.VolumeIBP.Vec d)},   MeasurableSet s →     ∫ (x : Poincare.D12.VolumeIBP.Vec d) in s, f x ∂G.riemannianMeasure =       ∫ (x : Poincare.D12.VolumeIBP.Vec d) in s, f x * G.density x
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.smooth	theorem	Poincare.D12.VolumeIBP.Basic	∀ {d : ℕ} (self : Poincare.D12.VolumeIBP.ChartMetric d) (i j : Fin d), ContDiff ℝ ⊤ fun x => self.g x i j
