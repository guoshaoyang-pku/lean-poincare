D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.density_aemeasurable	theorem	Poincare.D12.VolumeIBP.Regularity	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d), AEMeasurable (fun x => G.density x) MeasureTheory.volume
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.density_contDiff	theorem	Poincare.D12.VolumeIBP.Regularity	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d), ContDiff ℝ ⊤ fun x => G.density x
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.density_contDiff_one	theorem	Poincare.D12.VolumeIBP.Regularity	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d), ContDiff ℝ 1 fun x => G.density x
