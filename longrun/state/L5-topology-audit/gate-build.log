D13TYPE	Poincare.D11.BochnerManifold.radial_bochner_defect	theorem	Poincare.D11.BochnerManifold.RadialBochner	∀ {u m : ℝ → ℝ} {r : ℝ} (n : ℕ),   Differentiable ℝ (deriv u) →     DifferentiableAt ℝ (deriv (deriv u)) r →       DifferentiableAt ℝ m r →         Poincare.D11.BochnerManifold.lapG n m (Poincare.D11.BochnerManifold.gradSq u) r -             (2 * Poincare.D11.BochnerManifold.hessSq n m u r +               2 * Poincare.D11.BochnerManifold.gradDot u (Poincare.D11.BochnerManifold.lapG n m u) r) =           2 * Poincare.D11.BochnerManifold.ricTerm n m u r
