D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.densityNNReal_aemeasurable	theorem	Poincare.D12.VolumeIBP.Regularity	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d), AEMeasurable (fun x => G.densityNNReal x) MeasureTheory.volume
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.densityNNReal_eq	theorem	Poincare.D12.VolumeIBP.Regularity	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d) (x : Poincare.D12.VolumeIBP.Vec d),   ↑(G.densityNNReal x) = G.density x
