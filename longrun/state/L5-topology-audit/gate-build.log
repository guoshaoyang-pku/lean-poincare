D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.densityNNReal	def	Poincare.D12.VolumeIBP.Basic	{d : ℕ} → Poincare.D12.VolumeIBP.ChartMetric d → Poincare.D12.VolumeIBP.Vec d → NNReal
