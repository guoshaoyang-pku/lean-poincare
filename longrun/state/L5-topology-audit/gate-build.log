D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.det_ne_zero	theorem	Poincare.D12.VolumeIBP.Basic	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d) (x : Poincare.D12.VolumeIBP.Vec d), (G.matrix x).det ≠ 0
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.det_pos	theorem	Poincare.D12.VolumeIBP.Basic	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d) (x : Poincare.D12.VolumeIBP.Vec d), 0 < (G.matrix x).det
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.det_pullbackMatrix	theorem	Poincare.D12.VolumeIBP.ChangeOfVariables	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d) (ψ : Poincare.D12.VolumeIBP.Vec d → Poincare.D12.VolumeIBP.Vec d)   (x : Poincare.D12.VolumeIBP.Vec d), (G.pullbackMatrix ψ x).det = (fderiv ℝ ψ x).det ^ 2 * (G.matrix (ψ x)).det
