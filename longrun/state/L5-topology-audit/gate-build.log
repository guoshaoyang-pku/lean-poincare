  [inst_2 : DecidableEq V] (D : Divergence.DivergenceData V E) (w : E → ℝ) (m R : V → ℝ) (hm : ∀ (x : V), m x ≠ 0)
  (S : Finset V) (j k : Jet (V → ℝ)),
  ((conjugateHeatData D w m R hm S).pairing ((conjugateHeatData D w m R hm S).forwardHeat j)) k.1 -
      ((conjugateHeatData D w m R hm S).pairing j.1) ((conjugateHeatData D w m R hm S).backwardHeat k) =
    (conjugateHeatData D w m R hm S).volumeVariation j k - boundaryForm D w S j.1 k.1
