info: Poincare/D10/TriangulationLowDim/Audit.lean:135:0: @Triangulates : {n : ℕ} → FiniteAbstractSimplicialComplex (Fin n) → (X : Type u_1) → [TopologicalSpace X] → Prop
info: Poincare/D10/TriangulationLowDim/Audit.lean:136:0: @GeometricRealization : {n : ℕ} → FiniteAbstractSimplicialComplex (Fin n) → Type
info: Poincare/D10/TriangulationLowDim/Audit.lean:137:0: @realizationSet : {n : ℕ} → FiniteAbstractSimplicialComplex (Fin n) → Set (Fin n → ℝ)
info: Poincare/D10/TriangulationLowDim/Audit.lean:138:0: def Poincare.D10.TriangulationLowDim.MoiseTriangulationTheorem : Prop :=
∀ (M : Type) [inst : TopologicalSpace M] [T2Space M] [CompactSpace M]
  [inst_3 : ChartedSpace Poincare.Longrun.Topology.EuclideanThree M]
  [IsManifold Poincare.Longrun.Topology.ThreeManifoldModel (↑⊤) M], AdmitsFiniteTriangulation M
info: Poincare/D10/TriangulationLowDim/Audit.lean:139:0: def Poincare.D10.TriangulationLowDim.HeawoodTorusVertexBound : Prop :=
∀ (n : ℕ) (K : FiniteAbstractSimplicialComplex (Fin n)), K.IsClosedSurface → K.eulerChar = 0 → 7 ≤ K.vertices.card
