D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.density_pos	theorem	Poincare.D12.VolumeIBP.Basic	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d) (x : Poincare.D12.VolumeIBP.Vec d), 0 < G.density x
D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.det_contDiff	theorem	Poincare.D12.VolumeIBP.Regularity	∀ {d : ℕ} (G : Poincare.D12.VolumeIBP.ChartMetric d), ContDiff ℝ ⊤ fun x => (G.matrix x).det
