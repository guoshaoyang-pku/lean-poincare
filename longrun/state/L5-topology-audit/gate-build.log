D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.mk.sizeOf_spec	theorem	Poincare.D12.VolumeIBP.Basic	∀ {d : ℕ} (g : Poincare.D12.VolumeIBP.Vec d → Fin d → Fin d → ℝ)   (smooth : ∀ (i j : Fin d), ContDiff ℝ ⊤ fun x => g x i j)   (posDef : ∀ (x : Poincare.D12.VolumeIBP.Vec d), (Matrix.of fun i j => g x i j).PosDef),   sizeOf { g := g, smooth := smooth, posDef := posDef } = 1
