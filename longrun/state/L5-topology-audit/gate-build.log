D13TYPE	Poincare.D12.KappaVariational.toGaussianPath._proof_7	theorem	Poincare.D12.KappaVariational.CurvatureEnergy	∀ {n : ℕ} (R0 : ℝ) (q : EuclideanSpace ℝ (Fin n)) {τ : ℝ}   (P : Poincare.D7.Reduced.LPath (Poincare.D12.KappaVariational.constantCurvatureFlow n R0) 0 q τ)   (c : EuclideanSpace ℝ (Fin n)),   IntervalIntegrable (fun x => (Poincare.D7.Reduced.gaussianFlow n).metric x c (P.velocity x)) MeasureTheory.volume 0 τ
