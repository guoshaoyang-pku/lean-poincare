D13TYPE	Poincare.D12.ConnectionCurvature.SmoothChartData.nabla.eq_1	theorem	Poincare.D12.ConnectionCurvature.ChartLeviCivitaSmooth	∀ {ι : Type w} [inst : Fintype ι] [inst_1 : DecidableEq ι] (c : Poincare.D12.ConnectionCurvature.SmoothChartData ι)   (X Y : Poincare.D12.ConnectionCurvature.VectorField ι) (x : Poincare.D12.ConnectionCurvature.ChartPoint ι) (k : ι),   c.nabla X Y x k = (fderiv ℝ (fun z => Y z k) x) (X x) + ∑ i, ∑ j, c.christoffelFamily x k i j * X x i * Y x j
