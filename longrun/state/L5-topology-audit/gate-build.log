D13TYPE	Poincare.D12.VolumeIBP.ChartMetric.mk.injEq	theorem	Poincare.D12.VolumeIBP.Basic	∀ {d : ℕ} (g : Poincare.D12.VolumeIBP.Vec d → Fin d → Fin d → ℝ)   (smooth : ∀ (i j : Fin d), ContDiff ℝ ⊤ fun x => g x i j)   (posDef : ∀ (x : Poincare.D12.VolumeIBP.Vec d), (Matrix.of fun i j => g x i j).PosDef)   (g_1 : Poincare.D12.VolumeIBP.Vec d → Fin d → Fin d → ℝ) (smooth_1 : ∀ (i j : Fin d), ContDiff ℝ ⊤ fun x => g_1 x i j)   (posDef_1 : ∀ (x : Poincare.D12.VolumeIBP.Vec d), (Matrix.of fun i j => g_1 x i j).PosDef),   ({ g := g, smooth := smooth, posDef := posDef } = { g := g_1, smooth := smooth_1, posDef := posDef_1 }) = (g = g_1)
