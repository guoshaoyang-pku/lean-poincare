```lean
/-
L5 topology audit — independent fail-closed kernel detector (authored by L5-topology-audit).
...
-/
import <modules>
import Lean.Util.CollectAxioms
import Lean.Elab.Command

set_option autoImplicit false
set_option maxHeartbeats 0

open Lean Elab Command Meta

namespace L5Audit

def approvedAxioms : List Name := ["propext".toName, "Classical.choice".toName, "Quot.sound".toName]
def sorryAxiom : Name := "sorryAx".toName
def nativeAxioms : List Name := ["ofReduceBool".toName, "Lean.ofReduceBool".toName]

def knownNegControls : List Name := [
  "Poincare.D12.TriangulationTopology.NegControl.d12NegControlBadAxiom".toName,
  "Poincare.D12.VolumeIBP.negativeControl".toName,
  "Poincare.D13.CriticalPathReview.negControlBadAxiom".toName]

def packageRoots : List Name := ["Poincare","Probe","Ledger","Audit","ReleaseCheck","ReleaseAudit","D6AuditReport","ReleaseClaims","D6LedgerProbe","L5NegControlFresh"]

def laneRoots : List Name := [ ... ]

def isUnder (roots : List Name) (m : Name) : Bool := roots.any (fun r => r.isPrefixOf m)

def kindOf : ConstantInfo → String
  | .axiomInfo _ => "axiom"
  | .defnInfo v => match v.safety with
    | .«unsafe» => "unsafe_def"
    | .«partial» => "partial_def"
    | .safe => "def"
  | .thmInfo _ => "theorem"
  | .opaqueInfo _ => "opaque"
  | .quotInfo _ => "quot"
  | .inductInfo _ => "induct"
  | .ctorInfo _ => "ctor"
  | .recInfo _ => "rec"

def runAudit (roots : List Name) (excluded : List Name) (annotate : Bool) : CommandElabM Unit := do
  let env ← getEnv
  let imported := env.header.moduleNames
  let moduleOf (n : Name) : Name := match env.getModuleIdxFor? n with
    | some i => imported.getD i .anonymous
    | none => .anonymous
  let rows : Array (Name × ConstantInfo × Name) := env.constants.fold (fun acc n ci => acc.push (n, ci, moduleOf n)) #[]
  -- audit
  let mut decls := 0
  let mut theorems := 0
  let mut axioms : Array Name := #[]
  let mut unsafeD : Array Name := #[]
  let mut partialD : Array Name := #[]
  let mut sorryD : Array Name := #[]
  let mut nativeD : Array Name := #[]
  let mut unapproved : Array (Name × Name) := #[]
  let mut proofWanted : Array Name := #[]
  let mut collectFail : Array (Name × String) := #[]
  let mut audited : Array (Name × String) := #[]   -- (name, cone) for lane output? 
  for (n, ci, m) in rows do
    if isUnder roots m then
      decls := decls + 1
      if n.toString.contains "proof_wanted" then proofWanted := proofWanted.push n
      match ci with
      | .axiomInfo _ => axioms := axioms.push n
      | .defnInfo v => (match v.safety with | .«unsafe» => unsafeD := ... | .«partial» => partialD := ... | _ => pure ())
      | .thmInfo _ => theorems := theorems + 1
      | _ => pure ()
      if !excluded.contains n then
        let axs ← try Lean.collectAxioms n catch _ => collectFail := collectFail.push (n,"..."); pure #[]
        for a in axs do
          if a == sorryAxiom then sorryD := sorryD.push n
          else if nativeAxioms.contains a then nativeD := nativeD.push n
          else if !approvedAxioms.contains a then unapproved := unapproved.push (n, a)
  ...print summary, details...
  let failed := !axioms.isEmpty || !unsafeD.isEmpty || !sorryD.isEmpty || !nativeD.isEmpty || !unapproved.isEmpty || !proofWanted.isEmpty || !collectFail.isEmpty
  if failed then IO.println "L5VERDICT\tFAIL" ; throwError "..."
  else IO.println "L5VERDICT\tPASS ..."
```

