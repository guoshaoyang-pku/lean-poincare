                    circular := circular + 1
                    IO.println s!"L5A3CIRC\t{n}\t{m}\t{x.fvarId!.name}"
              if ← (try Meta.isDefEq body (mkConst ``True) catch _ => pure false) then
                trivial := trivial + 1
                IO.println s!"L5A3TRIV\t{n}\t{m}"
              IO.println s!"L5A3NTYPE\t{n}\t{m}\t{hypCount}"
        catch e => IO.println s!"L5A3ERR\t{n}\t{m}\t{e.toString.take 120}"
```

