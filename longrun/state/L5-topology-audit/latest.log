Key loop:

```lean
  let mut decls := 0
  let mut theorems := 0
  let mut axiomsUnexp : Array Name := #[]
  let mut unsafeD : Array Name := #[]
  let mut partialD : Array Name := #[]
  let mut sorryUnexp : Array Name := #[]
  let mut nativeUnexp : Array Name := #[]
  let mut unapprovedUnexp : Array (Name × Name) := #[]
  let mut unapprovedAll : Array (Name × Name) := #[]
  let mut proofWanted : Array Name := #[]
  let mut collectFail : Array (Name × String) := #[]
  for (n, ci, m) in rows do
    decls := decls + 1
    if n.toString.contains "proof_wanted" then proofWanted := proofWanted.push n
    match ci with
    | .axiomInfo _ => if !excluded.contains n then axiomsUnexp := axiomsUnexp.push n
    | .defnInfo v => ...
    | .thmInfo _ => theorems := theorems + 1
    | _ => pure ()
    let axs ← try Lean.collectAxioms n catch _ => collectFail := collectFail.push (n, "..."); pure #[]
    for a in axs do
      if a == sorryAxiom then (if !excluded.contains n then sorryUnexp := sorryUnexp.push n)
      else if nativeAxioms.contains a then (if !excluded.contains n then nativeUnexp := nativeUnexp.push n)
      else if !approvedAxioms.contains a then
        unapprovedAll := unapprovedAll.push (n, a)
        if !excluded.contains n then unapprovedUnexp := unapprovedUnexp.push (n, a)
```
