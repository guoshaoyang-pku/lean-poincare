                  hypCount := hypCount + 1
                  hypotheses := hypotheses + 1
                  if !pf.hasFVar x.fvarId! then
                    unused := unused + 1
                    IO.println s!"L5A3UNUSED\t{n}\t{m}\t{x.fvarId!.name}"
                  if ← (try Meta.isDefEq ty (mkConst ``False) catch _ => pure false) then
                    vacuous := vacuous + 1
                    IO.println s!"L5A3VAC\t{n}\t{m}\t{x.fvarId!.name}"
