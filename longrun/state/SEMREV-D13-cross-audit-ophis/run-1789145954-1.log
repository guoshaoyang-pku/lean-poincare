The Lean template:
```
import ...
import Lean.Util.CollectAxioms
open Lean Elab Command
namespace NS
def existsNames : List Name := [...]
def pairs : List (Name × Name) := [...]
def reverse : List Name := [...]
end NS
open NS in
run_cmd do
  let env ← getEnv
  for n in existsNames do
    match env.find? n with
    | none => IO.println s!"EXISTS\t{n}\tfalse"
    | some ci => 
        let axs ← try Lean.collectAxioms n catch _ => pure #[]
        IO.println s!"EXISTS\t{n}\ttrue\t{kindOf ci}\t{...}"
  for (a,b) in pairs do ... inType/inValue (with value? true) ...
  for c in reverse do direct users across all env.constants ...
```

