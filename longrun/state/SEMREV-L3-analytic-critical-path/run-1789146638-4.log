```lean
def binderTypes (e : Expr) : MetaM (Array String) := do
  let mut out := #[]
  let rec go (e : Expr) : MetaM Unit := do
    match e with
    | .forallE _ d b _ =>
      let s ← ppExpr d  -- may contain bvars
      out := out.push s
      withLocalDeclD `_x d fun x => go (b.instantiate1 x)
    | _ => pure ()
  go e
  return out
```
