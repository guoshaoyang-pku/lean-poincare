### Probe A: `review/probe/SemrevConsumers.lean`

```lean
/-
SEMREV-L3 independent review — round 3, Stage E: whole-environment consumer search.

Round 2 established "no compiled consumer outside Poincare/L3/HeatTimeDeriv" by *textual grep*.
This probe replaces that with an exact environment-level search: for each L3 deliverable it walks
every constant in the compiled environment and reports those whose *type* or *value* (proof term /
definition body) mentions the deliverable.  A `#check`-style use leaves no constant, so anything
found here is a real compiled reference.
-/

import Poincare.L3.HeatTimeDeriv.All
import Lean

open Lean

namespace SemrevConsumers

def targets : List Name :=
  [ ``Poincare.L3.HeatTimeDeriv.mildToClassicalBridge_holds,
    ``Poincare.L3.HeatTimeDeriv.mildToClassicalBridge_pointwise,
    ``Poincare.L3.HeatTimeDeriv.mildToClassicalBridge_of_uniform,
    ``Poincare.L3.HeatTimeDeriv.uniformMildToClassicalBridge_holds,
    ``Poincare.L3.HeatTimeDeriv.hasDerivAt_heatConv_BCF,
    ``Poincare.L3.HeatTimeDeriv.heatConv_classicalHeatSolution,
    ``Poincare.L3.HeatTimeDeriv.KernelClassicalHeatSolution,
    ``Poincare.L3.HeatTimeDeriv.SpatialLaplacianBridge ]

partial def mentions (t : Name) : Expr → Bool
  | .const n _ => n == t
  | .app f a => mentions t f || mentions t a
  | .lam _ ty b _ => mentions t ty || mentions t b
  | .forallE _ ty b _ => mentions t ty || mentions t b
  | .letE _ ty v b _ => mentions t ty || mentions t v || mentions t b
  | .mdata _ b => mentions t b
  | .proj _ _ b => mentions t b
  | _ => false

def kindOf : ConstantInfo → String
  ...

def isAuxOf (t n : Name) : Bool :=
  n.toString.startsWith (t.toString ++ ".") ||
  (n.toString.splitOn (t.toString)).length > 1  -- names like ..._proof_1 maybe mangled

run_cmd do
  let env ← getEnv
  let mut total := 0
  let mut extTotal := 0
  for t in targets do
    let mut count := 0
    let mut ext := 0
    for (n, ci) in env.constants.toList do
      let inType := mentions t ci.type
      let inVal := match ci.value? with
        | some v => mentions t v
        | none => false
      if inType || inVal then
        count := count + 1
        let where_ := if inType && inVal then "type+value" else if inType then "type" else "value"
        let external := !(n.toString.startsWith "Poincare.L3.HeatTimeDeriv")
        if external then ext := ext + 1
        logInfo s!"SEMREV-CONSUMER|{t}|{n}|{kindOf ci}|{where_}|{if external then "EXTERNAL" else "internal"}"
    logInfo s!"SEMREV-CONSUMER-SUMMARY|{t}|{count}|external|{ext}"
    total := total + count; extTotal := extTotal + ext
  logInfo s!"SEMREV-CONSUMER-TOTAL|{total}|external|{extTotal}"
end SemrevConsumers
```

