**Part 2: FAIL-CLOSED AXIOM AUDIT** — my own meta-program:
```lean
import Lean.Util.CollectAxioms
import Lean.Elab.Command

open Lean Elab Command

namespace SemRev

def allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]

def cited : List Name := [ ... ]

-- every cited declaration must exist; its axiom cone ⊆ allowed, except registered negcontrol decls
run_cmd do
  let env ← getEnv
  let mut fails : Array String := #[]
  for n in cited do
    match env.find? n with
    | none => fails := fails.push s!"MISSING {n}"
    | some ci =>
      let safety := match ci with
        | .defnInfo v => some v.safety
        | _ => none
      ...
      let axs ← try Lean.collectAxioms n catch e => ...
      for a in axs do
        unless allowed.contains a do fails := fails.push s!"AXIOM {n} -> {a}"
  if fails.isEmpty then IO.println "SEMREV_AXIOM_AUDIT PASS" else
    for f in fails do IO.println s!"SEMREV_AXIOM_AUDIT FAIL {f}"
    throwError "semrev axiom audit failed"
```

The fail-closed aspect: if a declaration is missing or has an unapproved axiom, the file fails to compile (exit ≠ 0). This is my own implementation, independent of L5's detector.

