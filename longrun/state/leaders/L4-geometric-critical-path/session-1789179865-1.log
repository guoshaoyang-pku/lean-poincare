  · have hW := wronskian_sturmModel_eq_zero_of_pos (u := -u) (du := -du) (ddu := -ddu) hK hspan heq
      h.neg hca (by simp [hua]) (by simp [huc]) (fun t ht => neg_pos.mpr (hneg ht)) hduc.neg
    have hzero := eq_zero_of_wronskian_sturmModel_eq_zero (u := -u) (du := -du) hK hspan hac
      hmono.neg.continuousOn_u (fun t ht => hmono.neg.hasDerivAt_u ht) (by simp [huc]) hW
    have ht' : t ∈ Ioo a c := ht
    have := hzero t ht'
    exact hneg ht (by simpa using this)
```
