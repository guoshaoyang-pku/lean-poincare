  have ht₀c : t₀ < c := lt_of_not_ge hnot
  have heq := eq_curvature_of_first_jacobi_zero_of_curvature_le hK hspan hk h hca hua huc hfirst
  exact absurd (heq t₀ ⟨ht₀.1, ht₀c⟩) (ne_of_lt hdef)
```
