```lean
/-- **Equality is forced by an early zero (complementary case).** -/
theorem eq_curvature_of_first_jacobi_zero_of_curvature_le
    {k : ℝ → ℝ} {K a c : ℝ} {u du ddu : ℝ → ℝ}
    (hac : a < c) (hK : 0 < K) (hspan : Real.sqrt K * (c - a) ≤ Real.pi)
    (hk : ∀ t ∈ Icc a c, k t ≤ K)
    (h : JacobiSolutionOn k u du ddu a c) (hua : u a = 0) (huc : u c = 0)
    (hfirst : ∀ t ∈ Ioo a c, u t ≠ 0) :
    ∀ t ∈ Ioo a c, k t = K := by
  have hmodel := sturmModel_jacobiSolutionOn (K := K) (a := a) (b := c) hK.le
