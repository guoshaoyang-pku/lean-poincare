/-- **A curvature deficit pushes the first zero past the deficit point.** -/
theorem first_jacobi_zero_le_of_curvature_deficit
    {k : ℝ → ℝ} {K a b c t₀ : ℝ} {u du ddu : ℝ → ℝ}
