theorem wronskian_sturmModel_eq_zero_of_curvature_eq {k : ℝ → ℝ} {K a b c : ℝ} {u du ddu : ℝ → ℝ}
    (hK : 0 < K) (hk : ∀ t ∈ Ioo a c, k t = K)
    (h : JacobiSolutionOn k u du ddu a b) (hca : c ∈ Ioo a b) (hua : u a = 0) :
    ∀ t ∈ Icc a c, wronskian (sturmModel K a) (sturmModelDeriv K a) u du t = 0 := by
  have hac : a < c := hca.1
  have hmono : JacobiSolutionOn k u du ddu a c := jacobiSolutionOn_mono_Icc h hac.le hca.2.le
  have hmodel : JacobiSolutionOn (fun _ : ℝ => K) ... a c := sturmModel_jacobiSolutionOn hK.le
  -- W continuous on Icc a c
  have hWcont : ContinuousOn (wronskian (sturmModel K a) (sturmModelDeriv K a) u du) (Icc a c) :=
    wronskian_continuousOn hmodel.continuousOn_u hmodel.continuousOn_du hmono.continuousOn_u hmono.continuousOn_du
  have hWdiff : DifferentiableOn ℝ (wronskian ...) (Ioo a c) := wronskian_differentiableOn hmodel hmono
  have hWderiv : (Ioo a c).EqOn (deriv (wronskian ...)) 0 := by
    intro t ht
    rw [wronskian_deriv hmodel hmono ht]
    rw [hk ht]; ring
  obtain ⟨w, hw⟩ := isOpen_Ioo.exists_is_const_of_deriv_eq_zero (Convex.isPreconnected (convex_Ioo a c)) hWdiff hWderiv
  have hconst : Set.EqOn (wronskian ...) (fun _ => w) (Icc a c) :=
    Set.EqOn.of_subset_closure hw hWcont continuous_const.continuousOn Ioo_subset_Icc_self
      (by rw [closure_Ioo (ne_of_lt hac)])
  have hwa : wronskian ... a = 0 := by simp [wronskian, hua, sturmModel]
  have hw0 : w = 0 := by
    have := hconst (left_mem_Icc.mpr hac.le)
    rw [hwa] at this
    exact this.symm
  intro t ht
  rw [hconst ht, hw0]
```
