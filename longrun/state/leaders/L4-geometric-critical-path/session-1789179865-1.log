```lean
theorem eq_curvature_of_first_jacobi_zero_of_curvature_le
    {k : ℝ → ℝ} {K a b c : ℝ} {u du ddu : ℝ → ℝ}
    (hK : 0 < K) (hspan : Real.sqrt K * (c - a) ≤ Real.pi)
    (hk : ∀ t ∈ Icc a c, k t ≤ K)
    (h : JacobiSolutionOn k u du ddu a b) (hca : c ∈ Ioo a b)
    (hua : u a = 0) (huc : u c = 0)
    (hfirst : ∀ t ∈ Ioo a c, u t ≠ 0) :
    ∀ t ∈ Ioo a c, k t = K := by
  have hac : a < c := hca.1
  have hc_sub : Ioo a c ⊆ Ioo a b := fun t ht => ⟨ht.1, lt_trans ht.2 hca.2⟩
  have hcont : ContinuousOn u (Ioo a c) := h.continuousOn_u.mono (fun t ht => ⟨ht.1.le, ht.2.le⟩)
  have hsign := sign_constant_of_no_zero hcont hfirst
  have hderivc : HasDerivAtR u (du c) c := h.hasDerivAt_u hca
  -- model facts
  have hmodel := (sturmModel_jacobiSolutionOn (K := K) (a := a) (b := c) hK.le)
  have hmodelpos : ∀ ⦃t : ℝ⦄, t ∈ Ioo a c → 0 < sturmModel K a t :=
    fun t ht => sturmModel_pos_of_le hK hspan ht
  have hmodela : sturmModel K a a = 0 := by simp [sturmModel]
  have hmodelc_ne : sturmModel K a c ≠ 0 := ne_of_gt (hmodelpos ?) -- no, c ∉ Ioo a c
  rcases hsign with hpos | hneg
  · -- positive case
    have hcmp := sturm_zero_comparison (k₁ := fun _ : ℝ => K) (k₂ := k)
      (u₁ := sturmModel K a) (du₁ := sturmModelDeriv K a) (ddu₁ := sturmModelSecondDeriv K a)
      (u₂ := u) (du₂ := du) (ddu₂ := ddu) hac
      (fun t ht => hk t (Ioo_subset_Icc_self ht))
      hmodel (h.mono hca.2.le) hmodela hua huc
      (fun t ht => hpos ht) hderivc
    rcases hcmp with ⟨z, hz, hzm⟩ | heq
    · exact absurd hzm (ne_of_gt (hmodelpos hz))
    · intro t ht; exact (heq ht).symm
  · -- negative case: use -u
    have hnegpos : ∀ ⦃t : ℝ⦄, t ∈ Ioo a c → 0 < -u t := fun t ht => neg_pos.mpr (hneg ht)
    have hcmp := sturm_zero_comparison (k₁ := fun _ : ℝ => K) (k₂ := k)
      (u₁ := sturmModel K a) (du₁ := sturmModelDeriv K a) (ddu₁ := sturmModelSecondDeriv K a)
      (u₂ := -u) (du₂ := -du) (ddu₂ := -ddu) hac
      (fun t ht => hk t (Ioo_subset_Icc_self ht))
      hmodel (h.neg.mono hca.2.le)
      hmodela (by simp [hua]) (by simp [huc])
      (fun t ht => hnegpos ht) hderivc.neg
    rcases hcmp with ⟨z, hz, hzm⟩ | heq
    · exact absurd hzm (ne_of_gt (hmodelpos hz))
    · intro t ht; exact (heq ht).symm
```

