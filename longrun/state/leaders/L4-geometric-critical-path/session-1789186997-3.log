```lean
namespace Poincare.L4.GeodesicComparison
open Set Metric MeasureTheory
open scoped Topology

section FlatModel
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

def geodesicLine (x v : E) (t : ℝ) : E := x + t • v

theorem geodesicLine_zero (x v) : geodesicLine x v 0 = x
theorem geodesicLine_flow (x v s t) : geodesicLine (geodesicLine x v s) v t = geodesicLine x v (s+t)
theorem dist_geodesicLine (x v s t) : dist (geodesicLine x v s) (geodesicLine x v t) = |s - t| * ‖v‖
theorem geodesicLine_continuous (x v) : Continuous (geodesicLine x v)   -- not needed

def expMap (x v : E) : E := geodesicLine x v 1
theorem expMap_eq (x v) : expMap x v = x + v
theorem expMap_injective (x) : Function.Injective (expMap x)
theorem expMap_surjective (x) : Function.Surjective (expMap x)

-- radial Jacobi field
def radialJacobi (v : E) (t : ℝ) : E := t • v
theorem radialJacobi_zero (v) : radialJacobi v 0 = 0
theorem radialJacobi_eq_zero_iff {v} (hv : v ≠ 0) (t) : radialJacobi v t = 0 ↔ t = 0
-- no conjugate points: a nontrivial Jacobi field with J 0 = 0 does not vanish again

-- second derivative zero (scalar + vector form)
