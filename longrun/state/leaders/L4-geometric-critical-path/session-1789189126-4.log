```lean
/-- Atlas-based scale-uniform growth data for a single compact member `p` of `GHSpace`.  Every
field except `doubling` is explicit data; the `doubling` field of the produced
`UniformMeasureGrowth` is *derived* by `AtlasBallGrowth.doubling`. -/
structure AtlasMemberGrowth (p : GHSpace) (d : ℕ) where
  atlas : OverlapAtlas (GHSpace.Rep p) d
  μchart : Measure (Vec d)
  hadd : μchart.IsAddHaarMeasure
  growth : AtlasBallGrowth atlas μchart
  C : ℝ≥0
  D : ℝ≥0
  c : ℝ≥0
  hc : 0 < c
  Cbound : growth.C ≤ C
  Dbound : ∀ x r, 0 < r → growth.D x r ≤ D
  cbound : ∀ x r, 0 < r → c ≤ growth.c x r
  K : ℝ≥0
  m : ℝ → ℝ≥0
  m_pos : ∀ s, 0 < s → 0 < m s
  noncollapse : ∀ x (s : ℝ), 0 < s → (m s : ℝ≥0∞) ≤ atlas.globalMeasure μchart (closedBall x s)
  compare : ∀ x (s : ℝ), 0 < s → atlas.globalMeasure μchart (closedBall x s) ≤ (K : ℝ≥0∞) * m s
  R : ℝ≥0
  exhaust : ∃ y : GHSpace.Rep p, (univ : Set (GHSpace.Rep p)) ⊆ closedBall y (2 * (R : ℝ))
```
