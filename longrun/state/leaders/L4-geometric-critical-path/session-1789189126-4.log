    A.globalMeasure μ (closedBall x r) ≤
      (((G.D x r / G.c x (r / 2)) * G.C : ℝ≥0) : ℝ≥0∞) *
        A.globalMeasure μ (closedBall x (r / 2)) := by
  have hr2 : 0 < r / 2 := by positivity
  have hmeas : MeasurableSet (closedBall x r) := isClosed_closedBall.measurableSet
  have hmeash : MeasurableSet (closedBall x (r / 2)) := isClosed_closedBall.measurableSet
