/-- The one-chart atlas on `Vec d` with the standard Euclidean metric: chart `0` is the identity
on the whole space, all transitions are the identity. -/
def euclidAtlas (d : ℕ) : OverlapAtlas (Vec d) d where
  chart := fun _ => id
  source := fun _ => univ
  isOpen_source := fun _ => isOpen_univ
  measurable_chart := fun _ => measurable_id
