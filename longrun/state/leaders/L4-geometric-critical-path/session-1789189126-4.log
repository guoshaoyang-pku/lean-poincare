theorem globalMeasure_le_of_density_le {D : ℝ} (i : ℕ) {s : Set M}
    (hs : MeasurableSet s) (hsi : s ⊆ A.chart i '' A.source i)
    (hD : ∀ y ∈ A.chartPreimage i s, A.density i y ≤ D) :
    A.globalMeasure μ s ≤ ENNReal.ofReal D * μ (A.chartPreimage i s) := by
  rw [A.globalMeasure_apply_chart μ i hs hsi]
  calc ∫⁻ y in A.chartPreimage i s, ENNReal.ofReal (A.density i y) ∂μ
      ≤ ∫⁻ _ in A.chartPreimage i s, ENNReal.ofReal D ∂μ :=
        setLIntegral_mono measurable_const fun y hy => ENNReal.ofReal_le_ofReal (hD y hy)
    _ = ENNReal.ofReal D * μ (A.chartPreimage i s) := setLIntegral_const _ _
```

