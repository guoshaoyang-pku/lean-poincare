structure AtlasBallGrowth (A : OverlapAtlas M d) (μ : Measure (Vec d)) [μ.IsAddHaarMeasure] where
  chartOf : M → ℕ
  C : ℝ≥0
  D : M → ℝ → ℝ≥0
  c : M → ℝ → ℝ≥0
  c_pos : ∀ x r, 0 < r → 0 < c x r
  density_le : ∀ x r, 0 < r → ∀ y ∈ A.chartPreimage (chartOf x) (closedBall x r),
      A.density (chartOf x) y ≤ D x r
  density_ge : ∀ x r, 0 < r → ∀ y ∈ A.chartPreimage (chartOf x) (closedBall x r),
      c x r ≤ A.density (chartOf x) y
  ball_subset : ∀ x r, 0 < r → closedBall x r ⊆ A.chart (chartOf x) '' A.source (chartOf x)
  chart_doubling : ∀ x r, 0 < r →
      μ (A.chartPreimage (chartOf x) (closedBall x r)) ≤
        (C : ℝ≥0∞) * μ (A.chartPreimage (chartOf x) (closedBall x (r / 2)))
```

