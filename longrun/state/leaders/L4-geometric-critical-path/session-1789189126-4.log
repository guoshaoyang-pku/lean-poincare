  have hc0 : ((G.c x (r / 2) : ℝ≥0) : ℝ≥0∞) ≠ 0 := by exact_mod_cast hcpos.ne'
  have hct : ((G.c x (r / 2) : ℝ≥0) : ℝ≥0∞) ≠ ∞ := ENNReal.coe_ne_top
  have h1 : A.globalMeasure μ (closedBall x r) ≤
