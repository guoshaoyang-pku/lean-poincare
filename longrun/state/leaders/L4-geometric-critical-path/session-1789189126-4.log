```lean
lemma conformalChartMetric_density (ρ hρ hρpos) (y) :
    (conformalChartMetric ρ hρ hρpos).density y = (ρ y)^d := by
  have hmat : (conformalChartMetric ρ hρ hρpos).matrix y = (ρ y)^2 • (1 : Matrix (Fin d) (Fin d) ℝ) := by
    ext i j; by_cases h : i = j <;> simp [ChartMetric.matrix, conformalChartMetric, Matrix.smul_apply, h]
  rw [ChartMetric.density, hmat, Matrix.det_smul, Matrix.det_one, mul_one, Fintype.card_fin]
  -- sqrt ((ρ y)^(2*d)) = (ρ y)^d
  have h2 : (ρ y) ^ (2 * d) = ((ρ y) ^ d) ^ 2 := by rw [← pow_mul]; ring_nf
  rw [h2, Real.sqrt_sq (pow_nonneg (le_of_lt (hρpos y)) d)]
```
