  have h2 : ((G.c x (r / 2) : ℝ≥0) : ℝ≥0∞) *
      μ (A.chartPreimage (G.chartOf x) (closedBall x (r / 2))) ≤
      A.globalMeasure μ (closedBall x (r / 2)) := by
    simpa only [ENNReal.ofReal_coe_nnreal] using
      le_globalMeasure_of_density_ge A μ (G.chartOf x) hmeash (G.ball_subset x (r / 2) hr2) (G.density_ge x (r / 2) hr2)
  ...
```
