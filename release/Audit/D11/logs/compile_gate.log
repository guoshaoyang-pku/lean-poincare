MoiseTriangulationTheorem : Prop
HeawoodTorusVertexBound : Prop
AdmitsFiniteTriangulation : (X : Type u_1) → [TopologicalSpace X] → Prop
@Triangulates : {n : ℕ} → FiniteAbstractSimplicialComplex (Fin n) → (X : Type u_1) → [TopologicalSpace X] → Prop
@GeometricRealization : {n : ℕ} → FiniteAbstractSimplicialComplex (Fin n) → Type
@realizationSet : {n : ℕ} → FiniteAbstractSimplicialComplex (Fin n) → Set (Fin n → ℝ)
def Poincare.D10.TriangulationLowDim.MoiseTriangulationTheorem : Prop :=
∀ (M : Type) [inst : TopologicalSpace M] [T2Space M] [CompactSpace M]
  [inst_3 : ChartedSpace Poincare.Longrun.Topology.EuclideanThree M]
  [IsManifold Poincare.Longrun.Topology.ThreeManifoldModel (↑⊤) M], AdmitsFiniteTriangulation M
def Poincare.D10.TriangulationLowDim.HeawoodTorusVertexBound : Prop :=
∀ (n : ℕ) (K : FiniteAbstractSimplicialComplex (Fin n)), K.IsClosedSurface → K.eulerChar = 0 → 7 ≤ K.vertices.card
