@Probe.PdeApi.strict_finite_grid_max_principle : ∀ {N : ℕ} (u : ℕ → ℝ),
  (∀ (i : ℕ), 0 < i → i < N → u i < (u (i - 1) + u (i + 1)) / 2) → ∀ (i : ℕ), 0 < i → i < N → u i < max (u 0) (u N)
@Probe.PdeApi.strict_finite_grid_max_principle_max : ∀ {N : ℕ} (u : ℕ → ℝ),
  (∀ (i : ℕ), 0 < i → i < N → u i < max (u (i - 1)) (u (i + 1))) → ∀ (i : ℕ), 0 < i → i < N → u i < max (u 0) (u N)
@Probe.inner_self_nonneg_toy : ∀ {V : Type u_1} [inst : NormedAddCommGroup V] [inst_1 : InnerProductSpace ℝ V] (v : V),
  0 ≤ inner ℝ v v
@Probe.leviCivita_isLeviCivita_toy : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  [inst_2 : FiniteDimensional ℝ E] {H : Type u_2} [inst_3 : TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type u_3} [inst_4 : TopologicalSpace M] [inst_5 : ChartedSpace H M] [inst_6 : IsManifold I 2 M]
  [inst_7 : Bundle.RiemannianBundle fun x => TangentSpace I x]
  [inst_8 : IsContMDiffRiemannianBundle I 1 E fun x => TangentSpace I x],
  CovariantDerivative.IsLeviCivitaConnection I (CovariantDerivative.leviCivitaConnection I M)
@Probe.leviCivita_uniqueness_toy : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  [inst_2 : FiniteDimensional ℝ E] {H : Type u_2} [inst_3 : TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type u_3} [inst_4 : TopologicalSpace M] [inst_5 : ChartedSpace H M] [inst_6 : IsManifold I 2 M]
  [inst_7 : Bundle.RiemannianBundle fun x => TangentSpace I x]
  [inst_8 : IsContMDiffRiemannianBundle I 1 E fun x => TangentSpace I x]
  (cov : CovariantDerivative I E (TangentSpace I)),
  CovariantDerivative.IsLeviCivitaConnection I cov →
    ∀ (Y : (x : M) → TangentSpace I x) (x : M),
      (MDiffAt fun x => ⟨x, Y x⟩) x →
        ∀ (X₀ : TangentSpace I x), (↑cov Y x) X₀ = (↑(CovariantDerivative.leviCivitaConnection I M) Y x) X₀
@Probe.torsion_antisymm_toy : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] {H : Type u_2}
  [inst_2 : TopologicalSpace H] {I : ModelWithCorners ℝ E H} {M : Type u_3} [inst_3 : TopologicalSpace M]
  [inst_4 : ChartedSpace H M] [inst_5 : IsManifold I 2 M] [inst_6 : CompleteSpace E] [inst_7 : FiniteDimensional ℝ E]
  (cov : CovariantDerivative I E (TangentSpace I)) (x : M) (X₀ Y₀ : TangentSpace I x),
  ((cov.torsion x) X₀) Y₀ = -((cov.torsion x) Y₀) X₀
Probe.trace_id_toy : ∀ (R : Type u_1) [inst : CommRing R] (V : Type u_2) [inst_1 : AddCommGroup V] [inst_2 : Module R V]
  [Module.Free R V] [Module.Finite R V], (LinearMap.trace R V) LinearMap.id = ↑(Module.finrank R V)
