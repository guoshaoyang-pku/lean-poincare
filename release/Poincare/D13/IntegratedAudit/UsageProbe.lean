/-- Names generated by the equation compiler / structure projection machinery; genuine
consumers are reported separately from these. -/
def isGenerated (n : Name) : Bool :=
  let s := n.toString
  ["._proof_", "._simp_", "._unsafe_rec", ".eq_", ".match_", "._f", "._sunfold",
   "._congr_simp", ".ctorIdx", ".casesOn", ".rec", ".noConfusion", "._flat_ctor",
   ".mk.inj", ".sizeOf", "._sizeOf", "._abel_", "._sparse_", "._elab", "._macro"]
    |>.any (fun p => s.contains p)

/-- Direct users map restricted to declarations *declared in* snapshot-internal modules
(this includes anonymous `example`/`_uniq` declarations, which are genuine kernel-checked
uses even though they are not reusable named theorems). -/
def buildUsers (env : Environment) : Std.HashMap Name (Array Name) := Id.run do
  let mods := env.header.moduleNames
  let isInternal (n : Name) : Bool :=
    match env.getModuleIdxFor? n with
    | some midx => (mods.getD midx .anonymous).toString.contains "Poincare"
    | none => false
  let mut users : Std.HashMap Name (Array Name) := {}
  for (n, ci) in env.constants.toList do
    if !isInternal n then continue
    let used := match ci.value? true with
      | some v => v.getUsedConstants
      | none => ci.type.getUsedConstants
    for u in used do
      if isInternal u then
        users := users.insert u ((users.getD u #[]).push n)
  return users

/-- Transitive reverse closure of `c` in the internal user graph. -/
partial def transUsers (users : Std.HashMap Name (Array Name)) (seen : Array Name)
    (todo : List Name) : Array Name :=
  match todo with
  | [] => seen
  | c :: rest =>
    if seen.contains c then transUsers users seen rest
    else
      let seen := seen.push c
      let next := (users.getD c #[]).toList.filter (fun n => !seen.contains n)
      transUsers users seen (next ++ rest)

end Poincare.D13.IntegratedAudit

open Poincare.D13.IntegratedAudit in
run_cmd do
  let env ← getEnv
  let users := buildUsers env
  for c in keyInputs do
    if (env.find? c).isNone then
      IO.println s!"D13USEMISSING\t{c}"
    else
      let all := transUsers users #[] [c]
      let others := all.filter (fun n => n != c)
      let genuine := others.filter (fun n => !isGenerated n && !n.toString.contains "_example" && !n.toString.contains "_uniq")
      let anon := others.filter (fun n => n.toString.contains "_example" || n.toString.contains "_uniq")
      let sample := (genuine.qsort (fun a b => a.toString < b.toString)).toList.take 6
      IO.println s!"D13USE\t{c}\t{others.size}\t{genuine.size}\t{anon.size}\t{";".intercalate (sample.map Name.toString)}"
